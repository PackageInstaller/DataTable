      "StartBgmFileName": "MUSIC_CUTSCENE_01.mp3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…단장.",
      "UnitTalk_JPN": "…団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "드디어 여기까지 왔네.",
      "UnitTalk_JPN": "いよいよここまで来たのね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "나는 고개를 끄덕였다.",
      "UnitTalk_JPN": "私はうなずいた。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "드디어 이 <color=#F7BE45>[여정]</color>의 끝이 눈앞에 다가왔다.",
      "UnitTalk_JPN": "ついにこの<color=#F7BE45>「救援の旅」</color>の終わりが、目前に迫っている。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "길다면 길고, 짧다면 짧은 시간이었지.",
      "UnitTalk_JPN": "長いようで短いような、そんな時間だった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "하지만 내 삶에서 절대 잊을 수 없는 시간이었던 건 분명해.",
      "UnitTalk_JPN": "でも、人生で絶対に忘れられない時間になったってことは確かよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "아마 이곳에서 단장을 만나지 않았다면… 내 인생은 전혀 달랐을 거야.",
      "UnitTalk_JPN": "ここで団長に出会えてなかったら…わたしはまったく違う人生を送っていたはず。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "난 고향에서, 혹은 세상을 떠돌며 그저 응석을 부리기만 했겠지.",
      "UnitTalk_JPN": "故郷や、この世界を転々としながら…周りに甘えてばかりだったと思う。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "동화 속 초인을 언제까지고 선망하면서.",
      "UnitTalk_JPN": "絵本の中の完璧な英雄にいつまでも憧れながらね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "하지만… 단장을 만나서 겨우 알게 되었어.",
      "UnitTalk_JPN": "でも…団長に出会ってようやく分かったの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "꿈을 향해 나아간다는 게 어떤 의미인지…",
      "UnitTalk_JPN": "夢に向かって進むっていうことが、どういうことなのか…",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "나아가다가 부딪히고 넘어졌을 때 어떻게 해야 하는지.",
      "UnitTalk_JPN": "前に進みながら、ぶつかって転んだ時にどうすればいいのか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그리고 가장 중요한-",
      "UnitTalk_JPN": "そして一番大切なのは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "멀리 가고 싶다면-",
          "JumpAnchorStringId_JPN": "遠くまで行きたければ—"
        }
      ]
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "함께 가라!",
      "UnitTalk_JPN": "共に進め！",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "후후, 여정을 시작할 때까지만 해도, 별의 구원자를 만나는 게 꿈이었는데…",
      "UnitTalk_JPN": "ふふっ。旅を始めた頃は、星の救援者に会うのが夢だったけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "별의 구원자를 만나지 못한다고 해도 좋아.",
      "UnitTalk_JPN": "もし星の救援者に会えなくても、わたしは大丈夫。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "왜냐하면… 단장을 만났으니까.",
      "UnitTalk_JPN": "だって…団長に出会えたんだもの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나도… 아세라를 만나서 다행이야.",
          "JumpAnchorStringId_JPN": "私も…アセラに出会えて良かった。"
        }
      ]
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…준비되셨나요 단장님?",
      "UnitTalk_JPN": "…準備はできましたか、団長？",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "시간이 되었나?",
          "JumpAnchorStringId_JPN": "もう時間かな？"
        }
      ]
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "네, 지금부터 별의 구원자 계승 시험 <color=#F7BE45>[여정]</color>",
      "UnitTalk_JPN": "はい。ただいまより星の救援者・継承試験<color=#F7BE45>「救援の旅」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그 최종시험을 시작하겠습니다.",
      "UnitTalk_JPN": "最終試験を開始します。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "상대는 <color=#F7BE45>[알데바란의 집행자]</color>.",
      "UnitTalk_JPN": "対戦相手は<color=#F7BE45>「アルデバランの執行者」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "<color=#F7BE45>[디랙의 우물]</color>이 투영을 개시합니다.",
      "UnitTalk_JPN": "<color=#F7BE45>「ディラックの井戸」</color>が投影を開始します。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SURPRISE"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "…저기, 단장.",
      "UnitTalk_JPN": "…ねえ、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "단장은 이번 시험이 끝나면 뭘 할 거야?",
      "UnitTalk_JPN": "団長はこの試験が終わったらどうするつもり？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "혹시 괜찮으면… 저기… 우리 고향에 가보지 않을래?",
      "UnitTalk_JPN": "もしよかったら…えっと…わたしの故郷に一緒に行ってみない？",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "조금 낡긴 했지만 예쁜 저택에 푸른 초원도 있고 시원한 바다도 있는 곳인데…",
      "UnitTalk_JPN": "少し古いけど…綺麗なお屋敷に青い草原もあって、爽やかな海も見えるんだけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…꼭 가볼게.",
          "JumpAnchorStringId_JPN": "…必ず行くよ。"
        }
      ]
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "저, 정말?",
      "UnitTalk_JPN": "ほ、本当に？",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "정말이지? 약속한 거다!",
      "UnitTalk_JPN": "本当よね？約束よ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "응. 네가 잊지 않는다면.",
          "JumpAnchorStringId_JPN": "うん。アセラが覚えていてくれたらな。"
        }
      ]
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "그야 당연하지!",
      "UnitTalk_JPN": "それはもちろんよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "내가 단장을 잊을 리가 없잖아.",
      "UnitTalk_JPN": "わたしが団長のことを忘れるはずないじゃない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그럼… 이만 가볼까?",
      "UnitTalk_JPN": "それじゃ…行きましょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "<color=#F7BE45>[여정]</color>을 끝내러.",
      "UnitTalk_JPN": "<color=#F7BE45>「救援の旅」</color>を終わらせに。",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true
    }
  ]
