      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "<color=#F7BE45>[PLAYER_NAME]</color>.",
      "UnitTalk_JPN": "<color=#F7BE45>[PLAYER_NAME]</color>。",
