    },
    {
      "Uid": 43,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.4,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "저, 정말?! <color=#F7BE45>[PLAYER_NAME]</color>님이세요?",
      "UnitTalk_JPN": "ほ、本当ですか！？<color=#F7BE45>[PLAYER_NAME]</color>様ですか？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_025.wav"
    },
    {
      "Uid": 44,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "NOA에 있는 관측사 전부가 단장님을 찾는다고 뒤집어졌었는데…",
      "UnitTalk_JPN": "NOAにいる観測士全員が、団長のことを探していたんですが…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_026.wav"
    },
    {
      "Uid": 45,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "여기 계셨군요, 단장님!",
      "UnitTalk_JPN": "ここにいらっしゃったんですね、団長！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_027.wav"
    },
    {
      "Uid": 46,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "제가 회수 임무를 완료하고, 거기에 단장님까지 찾아서 돌아가게 되면…!",
      "UnitTalk_JPN": "回収任務を無事完了して、しかも行方不明になった団長を発見したとなれば…！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_028.wav"
    },
    {
      "Uid": 47,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "어쩌면 이번에야말로…! 정식 발령이 날지도!",
      "UnitTalk_JPN": "もしかすると今度こそ…！救援団に配属してもらえるかも…！？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_029.wav"
    },
    {
      "Uid": 48,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.5,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "단장님! 단장님을 만난 건 제 일생일대의 행운이에요!",
      "UnitTalk_JPN": "団長！団長に出会えたのは、一世一代の幸運です！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_030.wav"
    },
    {
      "Uid": 49,
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "<color=#F7BE45>[단장]</color>. 모르는 얘기가 또 하나 나왔다.",
      "UnitTalk_JPN": "<color=#F7BE45>団長</color>。 また知らない言葉が出てきた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 50,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 나를 찾는다는 사람을 만나보면 뭔가 정보를 얻을 수 있을 것 같은 기분이 든다.",
      "UnitTalk_JPN": "だが、私のことを探している人に会えば、何らかの情報を得られるかもしれない。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 51,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "일단 물건부터 회수하자.",
          "JumpAnchorStringId_JPN": "まずは、私に渡すべき重要な物とやらを回収しよう。"
        }
      ]
    },
    {
      "Uid": 52,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "네! 잠시만요!",
      "UnitTalk_JPN": "はい、お待ちください！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_031.wav"
    },
    {
      "Uid": 53,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이쪽에 있다고 들었는데… 아, 여기 있네요.",
      "UnitTalk_JPN": "ここにあるって聞いたんですが…あっ、これじゃないですか？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_032.wav"
    },
    {
      "Uid": 54,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이건… 뭐지?",
          "JumpAnchorStringId_JPN": "これは…なんだ？"
        }
      ]
    },
    {
      "Uid": 55,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "잘은 모르겠지만 무기의 일종이라고 들었어요.",
      "UnitTalk_JPN": "よく分かりませんが、武器の一種だと聞いています。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_033.wav"
    },
    {
      "Uid": 56,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "단장님이라면 분명 잘 아실 거라고…",
      "UnitTalk_JPN": "団長なら、詳しくご存じかと…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_034.wav"
    },
    {
      "Uid": 57,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "분명 처음 보는 물건이다.",
      "UnitTalk_JPN": "初めて見る物のはずだった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 58,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_SWORD_DRAW_10.wav",
      "UnitTalk_KOR": "하지만 나는 마치 익숙한 물건을 받은 것처럼 <color=#F7BE45>[잠금]</color>을 해제하고 검을 뽑아낼 수 있었다.",
      "UnitTalk_JPN": "しかし、私はまるで慣れ親しんだ道具を扱うかのように…<color=#F7BE45>「ロック」</color>を解除し、剣を引き抜いた。",
      "TalkTime": 0.03,
