      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "최고 기밀 지역…",
          "JumpAnchorStringId_JPN": "トップシークレットエリア…"
        }
      ]
    },
    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후, 영광인 줄 아세요.",
      "UnitTalk_JPN": "ふふっ、光栄に思ってください。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_005.wav"
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "어지간한 베테랑 구원자들도 여기에 오기는커녕 이런 장소가 있는 줄도 몰라요.",
      "UnitTalk_JPN": "高位の救援者でも足を踏み入れることはおろか、こんな場所が存在することすら知らないんですよ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_006.wav"
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그런 최고 기밀 지역에…",
          "JumpAnchorStringId_JPN": "そんなところに…"
        }
      ]
    },
    {
      "Uid": 13,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "우리가 들어와도 돼?",
          "JumpAnchorStringId_JPN": "私たちが入ってもいいのか？"
        }
      ]
    },
    {
      "Uid": 14,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "무, 물론이죠! 제가 호위를 요청 드린 거니까…!",
      "UnitTalk_JPN": "も、もちろんです！私が護衛をお願いしたんですから…！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_007.wav"
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_008.wav"
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…괜찮을 거예요, 아마도.",
      "UnitTalk_JPN": "…大丈夫です。たぶん。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_009.wav"
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitMotion": "USN_UI_REST",
      "UnitPos": "POS2",
      "UnitTalk_KOR": "…음, 3급 관측사라고 하지 않았어?",
      "UnitTalk_JPN": "…あなた、3級観測士だって言ってなかったっけ？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_UNIT_S_VOYAGER_STRANIS_004.wav"
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "분명 그 정도까지의 권한은-",
      "UnitTalk_JPN": "トップシークレットエリアに入れる権限があるとは思えな―",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_UNIT_S_VOYAGER_STRANIS_005.wav"
    },
    {
      "Uid": 165,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SURPRISE"
    },
    {
      "Uid": 19,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.4,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "아아-! <color=#F7BE45>[3급]</color>을 꼬박꼬박 붙이지 마세요!",
      "UnitTalk_JPN": "あぁーっ！ <color=#F7BE45>「3級」</color>っていちいち言わないでください！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_010.wav"
    },
    {
      "Uid": 20,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "3급 관측사가 뭐 어때서!",
      "UnitTalk_JPN": "3級観測士の何が悪いって言うんですか！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_011.wav"
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "나도 나름대로 열심히 노력해서 딴 거라고!!",
      "UnitTalk_JPN": "私だって一生懸命努力して試験に合格したのに！！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_012.wav"
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "미안…",
          "JumpAnchorStringId_JPN": "すまない…"
        }
      ]
    },
    {
      "Uid": 23,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "후우… 후우… 진정하자 리사.",
      "UnitTalk_JPN": "はぁ…はぁ…落ち着くのよ、リサ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_013.wav"
    },
    {
      "Uid": 24,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "넌 꼭 돈 많고 할 일은 별로 없는 멋진 구원단에 발령받아서, 편하게 놀고먹다가, 서른 살 전에 부자가 되어서 은퇴할 거야.",
      "UnitTalk_JPN": "私はお金持ちで仕事の少ない素敵な救援団に入って…のんびり遊び惚けながら、30歳までには大富豪になってアーリーリタイアするんだから。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_014.wav"
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "응, 그렇고말고.",
      "UnitTalk_JPN": "うん、きっとそうなるはずよ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_015.wav"
    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…",
          "JumpAnchorStringId_JPN": "…"
        }
      ]
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아무튼 저도 이런 곳이 있다는 건 이번에 처음 알았어요.",
      "UnitTalk_JPN": "とにかく、私もこんな場所があることは、今回初めて知りました。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_016.wav"
    },
    {
      "Uid": 28,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "<color=#F7BE45>[알리시아]</color> 님이 직접 하달한 임무가 없었다면 이런 음침한 곳에 올 일도 없었겠죠.",
      "UnitTalk_JPN": "<color=#F7BE45>「アリシア」</color>様から命令された任務がなければ、こんなどんよりとした場所に来ることもなかったでしょう。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_017.wav"
    },
    {
      "Uid": 29,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래서? 여기서 뭘 해야 하는데?",
      "UnitTalk_JPN": "それで？ここで何をすればいいの？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_UNIT_S_VOYAGER_STRANIS_006.wav"
    },
    {
      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그게… 이번에 NOA에 새로운 <color=#F7BE45>[여정 단장]</color>으로 오실 분이 있다고 하더라고요.",
      "UnitTalk_JPN": "今回NOAに新しく<color=#F7BE45>「旅の団長」</color>としてお越しになる方がいらっしゃいまして。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_018.wav"
    },
    {
      "Uid": 31,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그 분께 전달 드릴 중요한 물건이 여기에 있다고 하셨어요.",
      "UnitTalk_JPN": "その方にお渡しする重要な物が、ここにあるそうです。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_019.wav"
    },
    {
      "Uid": 32,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "원래라면 단장님이 도착하신 후에 가지러 와도 될 텐데…",
      "UnitTalk_JPN": "本来なら、団長が到着してから取りに来てもよかったのですが…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_020.wav"
    },
    {
      "Uid": 33,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그 분이 갑자기 행방불명이 되었다지 뭐예요?",
      "UnitTalk_JPN": "その方が突然、行方不明になってしまったそうです。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_021.wav"
    },
    {
      "Uid": 34,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "캔들 스퀘어 쪽에도 행방불명된 단장님을 찾아달라는 공문을 보내긴 했는데…",
      "UnitTalk_JPN": "キャンドル・スクエアの方にも、行方不明になった団長を探すようにと公文書をお送りしたのですが…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_022.wav"
    },
    {
      "Uid": 194,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SURPRISE"
    },
    {
      "Uid": 35,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "알리시아님이 아무래도 불길한 일이 생길 것 같다며 일단 물건부터 미리 확보해 두라고 하셔서-",
      "UnitTalk_JPN": "アリシア様が、何か良くないことが起きたのかもしれないと仰いまして、まずはお渡しする物を確保するようにと―",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_023.wav"
    },
    {
      "Uid": 36,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "ONE_2",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "어… 그거 혹시…",
      "UnitTalk_JPN": "あー…もしかして、その<color=#F7BE45>「旅の団長」</color>って…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_UNIT_S_VOYAGER_STRANIS_007.wav"
    },
    {
      "Uid": 37,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "네 이야기 아냐?",
      "UnitTalk_JPN": "あなたのことじゃない？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_UNIT_S_VOYAGER_STRANIS_008.wav"
    },
    {
      "Uid": 38,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나…?",
          "JumpAnchorStringId_JPN": "私…？"
        }
      ]
    },
    {
      "Uid": 39,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "네? 그게 무슨 소리죠?",
      "UnitTalk_JPN": "はい？どういうことでしょうか？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_04_NPC_NOA_LISA_024.wav"
    },
    {
      "Uid": 40,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "여기 오기 전에 캔들 스퀘어에서 들었어.",
      "UnitTalk_JPN": "ここに来る前に、キャンドル・スクエアで聞いたわ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_UNIT_S_VOYAGER_STRANIS_009.wav"
    },
    {
