    },
    {
      "Uid": 59,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "통계학적으로 봤을 때 애완동물은 인간에게 즐거움의 감정을 유발.",
      "UnitTalk_JPN": "統計学的に見た時、ペットは人間の嬉しいという感情を誘発。",
