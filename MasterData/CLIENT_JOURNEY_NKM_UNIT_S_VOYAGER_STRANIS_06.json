      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "집에서 보낸 사람들이 쫓아왔을 때는 이미 여정 등록을 완료한 뒤였어, 하하.",
      "UnitTalk_JPN": "家の使いの者が追いついた頃には、すでに旅の登録を終えた後だったのよ、あははっ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아세라다운 행동력이었군.",
          "JumpAnchorStringId_JPN": "アセラらしい行動力だ。"
        }
      ]
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…",
