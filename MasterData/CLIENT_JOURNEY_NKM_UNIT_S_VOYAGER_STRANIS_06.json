      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "지금의 아세라에게 도움이 될 만한 말이 뭐가 있을까.",
      "UnitTalk_JPN": "今のアセラのためになるような言葉は…何があるだろうか。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
