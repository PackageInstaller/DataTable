      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "정말? 좋아!",
      "UnitTalk_JPN": "本当？やったー！",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "단장 티켓값까지 내가 내줄게!",
      "UnitTalk_JPN": "団長のチケット代も、わたしが払うわ！",
      "TalkTime": 0.03
    },
    {
