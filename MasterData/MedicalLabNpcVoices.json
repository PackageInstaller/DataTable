[
  {
    "Id": 125001,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25001",
    "Message": "うーん、被験者が足りないなぁ…",
    "NpcId": 9
  },
  {
    "Id": 125002,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25002",
    "Message": "実験されてもいいよーって人ー？",
    "NpcId": 9
  },
  {
    "Id": 125003,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25003",
    "Message": "運命くんにしか頼めないことがあるの\nママのお願い、聞いてくれる…？",
    "NpcId": 9
  },
  {
    "Id": 125004,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25004",
    "Message": "ねぇねぇ運命くん、\nあっちでママとお話しない…？",
    "NpcId": 9
  },
  {
    "Id": 125005,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25005",
    "Message": "協力してくれる皇帝陛下、いないかなー？",
    "NpcId": 9
  },
  {
    "Id": 125006,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/25006",
    "Message": "ごめんね、運命くん\n今日も騎士をひとり、実験に貸してほしいの",
    "NpcId": 9
  },
  {
    "Id": 125007,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/25007",
    "Message": "ねぇ、ママと裏取引しない？\nひとり、騎士を貸してほしいんだ",
    "NpcId": 9
  },
  {
    "Id": 125008,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/25008",
    "Message": "騎士に実験する許可をくれないかなぁ？\n人類の未来のために、力を貸してほしいの",
    "NpcId": 9
  },
  {
    "Id": 125009,
    "VoicePlayType": 3,
    "VoiceAssetId": "uniq/25009",
    "Message": "取引、成立♪",
    "NpcId": 9
  },
  {
    "Id": 125010,
    "VoicePlayType": 3,
    "VoiceAssetId": "uniq/25010",
    "Message": "みんなには内緒だからね♪",
    "NpcId": 9
  },
  {
    "Id": 125011,
    "VoicePlayType": 3,
    "VoiceAssetId": "uniq/25011",
    "Message": "ママ、信じてたよ♪",
    "NpcId": 9
  },
  {
    "Id": 125012,
    "VoicePlayType": 3,
    "VoiceAssetId": "uniq/25012",
    "Message": "わるい子だなぁ♪",
    "NpcId": 9
  },
  {
    "Id": 125013,
    "VoicePlayType": 3,
    "VoiceAssetId": "uniq/25013",
    "Message": "共犯者だね♪",
    "NpcId": 9
  },
  {
    "Id": 125014,
    "VoicePlayType": 4,
    "VoiceAssetId": "uniq/25014",
    "Message": "心の準備、待ってるね♪",
    "NpcId": 9
  },
  {
    "Id": 125015,
    "VoicePlayType": 4,
    "VoiceAssetId": "uniq/25015",
    "Message": "いつでも声かけてねー♪",
    "NpcId": 9
  },
  {
    "Id": 125016,
    "VoicePlayType": 4,
    "VoiceAssetId": "uniq/25016",
    "Message": "そっかぁ…",
    "NpcId": 9
  },
  {
    "Id": 125024,
    "VoicePlayType": 5,
    "VoiceAssetId": "uniq/25024",
    "Message": "協力してくれたご褒美だよ\n明日もママと取引しようね♪",
    "NpcId": 9
  },
  {
    "Id": 125025,
    "VoicePlayType": 5,
    "VoiceAssetId": "uniq/25025",
    "Message": "はーい、約束のブツだよ\nみんなにバレないようにしてね♪",
    "NpcId": 9
  },
  {
    "Id": 125026,
    "VoicePlayType": 5,
    "VoiceAssetId": "uniq/25026",
    "Message": "約束のご褒美だよ♪\n協力してくれて、ママ本当にうれしい！",
    "NpcId": 9
  },
  {
    "Id": 125027,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25027",
    "Message": "大丈夫、ママにまかせてねー",
    "NpcId": 9
  },
  {
    "Id": 125028,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25028",
    "Message": "はいはい、暴れないのー",
    "NpcId": 9
  },
  {
    "Id": 125029,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25029",
    "Message": "よしよし、怖くないよー",
    "NpcId": 9
  },
  {
    "Id": 125030,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25030",
    "Message": "ここをこうして、ほいっと…",
    "NpcId": 9
  },
  {
    "Id": 125031,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25031",
    "Message": "うんうん、なるほどなるほど…",
    "NpcId": 9
  },
  {
    "Id": 125032,
    "VoicePlayType": 7,
    "VoiceAssetId": "uniq/25032",
    "Message": "いつもありがとう♪",
    "NpcId": 9
  },
  {
    "Id": 125033,
    "VoicePlayType": 7,
    "VoiceAssetId": "uniq/25033",
    "Message": "明日も手伝ってくれると嬉しいな…♪",
    "NpcId": 9
  },
  {
    "Id": 125034,
    "VoicePlayType": 7,
    "VoiceAssetId": "uniq/25034",
    "Message": "このことは、みんなに内緒だからね♪",
    "NpcId": 9
  },
  {
    "Id": 125035,
    "VoicePlayType": 8,
    "VoiceAssetId": "uniq/25035",
    "Message": "もう大丈夫だよー♪",
    "NpcId": 9
  },
  {
    "Id": 125036,
    "VoicePlayType": 8,
    "VoiceAssetId": "uniq/25036",
    "Message": "はい、おつかれさまぁー♪",
    "NpcId": 9
  },
  {
    "Id": 125037,
    "VoicePlayType": 8,
    "VoiceAssetId": "uniq/25037",
    "Message": "よし、おーるおっけー♪",
    "NpcId": 9
  },
  {
    "Id": 125038,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25038",
    "Message": "素敵なデータは取れたかなぁー…♪",
    "NpcId": 9
  },
  {
    "Id": 125039,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25039",
    "Message": "次の実験は明日だよ\nまた会いに来てくれるかな？",
    "NpcId": 9
  },
  {
    "Id": 125040,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25040",
    "Message": "裏取引、ありがとうね♪うふふ♪",
    "NpcId": 9
  },
  {
    "Id": 125041,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25041",
    "Message": "怖かったかなぁ？\nでも、がんばれてえらかったね♪",
    "NpcId": 9
  },
  {
    "Id": 125042,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25042",
    "Message": "今日の実験はおわったよー\nみんなお疲れさま♪\nあ、メイズラボのみんなは\nまだまだやることたくさんあるからねー♪",
    "NpcId": 9
  },
  {
    "Id": 225001,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25001",
    "Message": "あとは「アレ」があればー…",
    "NpcId": 10
  },
  {
    "Id": 225002,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25002",
    "Message": "試作から治験、製薬、販売まで\n全自動でやってくれる案件ないかなー",
    "NpcId": 10
  },
  {
    "Id": 225003,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25003",
    "Message": "キーティ、そっちじゃなくて、\nあっちあっち！",
    "NpcId": 10
  },
  {
    "Id": 225004,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25004",
    "Message": "ママ―、こっちは準備おっけー案件ー",
    "NpcId": 10
  },
  {
    "Id": 225005,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25005",
    "Message": "ちびー、エルちゃんと遊んでないで、\nそこの薬品よろしく案件ねー",
    "NpcId": 10
  },
  {
    "Id": 225017,
    "VoicePlayType": 10,
    "VoiceAssetId": "uniq/25017",
    "Message": "これも仕事だもんでー",
    "NpcId": 10
  },
  {
    "Id": 225018,
    "VoicePlayType": 10,
    "VoiceAssetId": "uniq/25018",
    "Message": "いつも申し訳ないっす",
    "NpcId": 10
  },
  {
    "Id": 225019,
    "VoicePlayType": 10,
    "VoiceAssetId": "uniq/25019",
    "Message": "訴訟もじさなめ案件かなー…",
    "NpcId": 10
  },
  {
    "Id": 225020,
    "VoicePlayType": 10,
    "VoiceAssetId": "uniq/25020",
    "Message": "いけいけキーティー♪",
    "NpcId": 10
  },
  {
    "Id": 225021,
    "VoicePlayType": 10,
    "VoiceAssetId": "uniq/25021",
    "Message": "よいしょ、よいしょっ♪",
    "NpcId": 10
  },
  {
    "Id": 225027,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25027",
    "Message": "ねぇ見た見た？いまのすごくない？",
    "NpcId": 10
  },
  {
    "Id": 225028,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25028",
    "Message": "流石にこれは、\n訴えられてもおかしくない案件…",
    "NpcId": 10
  },
  {
    "Id": 225029,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25029",
    "Message": "ママ、容赦ないなー…\n人の心とか、ないんかな…",
    "NpcId": 10
  },
  {
    "Id": 225030,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25030",
    "Message": "んふー、我ながらいいマシンを作った…",
    "NpcId": 10
  },
  {
    "Id": 225031,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25031",
    "Message": "キミが、売ったんだよ\n仲間を",
    "NpcId": 10
  },
  {
    "Id": 225038,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25038",
    "Message": "さてさて、新しいデータは出たかなぁー？",
    "NpcId": 10
  },
  {
    "Id": 225039,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25039",
    "Message": "お！これは面白い案件きたかも！",
    "NpcId": 10
  },
  {
    "Id": 225040,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25040",
    "Message": "なかなかいい取引だったよ、陛下♪",
    "NpcId": 10
  },
  {
    "Id": 225041,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25041",
    "Message": "ほほー…、興味深い…\n人類はまた一歩進んじゃう案件かもだねぇー",
    "NpcId": 10
  },
  {
    "Id": 225042,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25042",
    "Message": "鬼？悪魔？\nキミたちには言われたくない案件だね！",
    "NpcId": 10
  },
  {
    "Id": 325001,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25001",
    "Message": "今は薬剤師のアズライトです\nみなさん、お薬の準備は万全です\nちょっとやり過ぎちゃっても大丈夫です",
    "NpcId": 11
  },
  {
    "Id": 325002,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25002",
    "Message": "まじめモードのアズライトです\n今日の調合比率には自信があります\n被験者さん、お覚悟を",
    "NpcId": 11
  },
  {
    "Id": 325003,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25003",
    "Message": "各種設備と機材の洗浄を完了\nママ、いつでもいけるよ\nみなさん、よろしくお願いします",
    "NpcId": 11
  },
  {
    "Id": 325004,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25004",
    "Message": "ママ、今日のR霊子密度はどのくらいにする？\nうん、なるほど\n自分で試した感じだと、ここまで上げた方がいいと思う\nうん、うん\n了解、まかせて",
    "NpcId": 11
  },
  {
    "Id": 325005,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25005",
    "Message": "……いい結果がでてほしいです\n少しでも、1人でも多くの人を救って\nあげたいですから\nそのためなら……",
    "NpcId": 11
  },
  {
    "Id": 325027,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25027",
    "Message": "大興奮です\nアズライトです",
    "NpcId": 11
  },
  {
    "Id": 325028,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25028",
    "Message": "ママ、やはり天才…",
    "NpcId": 11
  },
  {
    "Id": 325029,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25029",
    "Message": "ああ、お薬があんなに、ああ、ああ…",
    "NpcId": 11
  },
  {
    "Id": 325030,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25030",
    "Message": "陛下のご協力に感謝します\n心が痛まなくなるお薬、いりますか？",
    "NpcId": 11
  },
  {
    "Id": 325031,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25031",
    "Message": "陛下、もし訴えられたら\n一緒に謝ってください",
    "NpcId": 11
  },
  {
    "Id": 325038,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25038",
    "Message": "どもどもどうも、アズライトです\nこうみえて天才薬剤師（自称）ですから\nアフターケアも万全です\nいいお薬、出しておきますね",
    "NpcId": 11
  },
  {
    "Id": 325039,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25039",
    "Message": "自分に使うときと違う効果がでましたね\n天才美少女薬剤師として見逃せません\n調子に乗りました\nアズライトです",
    "NpcId": 11
  },
  {
    "Id": 325040,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25040",
    "Message": "協力ありがとうございました\nおかげで10年ほど科学が進みました\nあとでお礼のお薬を差し上げます",
    "NpcId": 11
  },
  {
    "Id": 325041,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25041",
    "Message": "はろはろー、アズライトです\n被験者さん、聞こえてますか？\nふむ、この反応ならこっちのお薬が\nいいかもですね",
    "NpcId": 11
  },
  {
    "Id": 325042,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25042",
    "Message": "お薬のませ師、免許皆伝アズライトです\n被験者さん、これ持って\nなーんで持ってるの？なーんで持ってるの？\nお薬飲みたいから持ってるの\nさ、飲んで飲んで\nぐいぐい飲んで\nあ、被験者の、ちょっといいとこ見てみたい",
    "NpcId": 11
  },
  {
    "Id": 425001,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25001",
    "Message": "私が担当の日だなんて、\n随分と運の悪い被験者ね、おめでとう",
    "NpcId": 12
  },
  {
    "Id": 425002,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25002",
    "Message": "恨まれることすら楽しむものよ、\n研究者というのはね",
    "NpcId": 12
  },
  {
    "Id": 425003,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25003",
    "Message": "私に寝てほしい？ハッ、寝言は寝て言って\n寝てる間に実験してあげるわ",
    "NpcId": 12
  },
  {
    "Id": 425004,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25004",
    "Message": "ママ、準備はできてるわ\n始めましょう\nハリー、ハリー、ハリー",
    "NpcId": 12
  },
  {
    "Id": 425005,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25005",
    "Message": "さぁ、実験の時間よ",
    "NpcId": 12
  },
  {
    "Id": 425027,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25027",
    "Message": "いい実験になりそうね",
    "NpcId": 12
  },
  {
    "Id": 425028,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25028",
    "Message": "私はママや舞護のような天才ではないわ\n寝ないで2倍、努力して3倍、ブーストかけてやっと4倍\nまだまだ、まだまだよ",
    "NpcId": 12
  },
  {
    "Id": 425029,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25029",
    "Message": "ママ、今日は調子いいわね\nイヤなことでもあったのかな",
    "NpcId": 12
  },
  {
    "Id": 425030,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25030",
    "Message": "実験はまだまだこれから、\nお楽しみはこれからが本番よ",
    "NpcId": 12
  },
  {
    "Id": 425031,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25031",
    "Message": "どう思う？どう感じる？\n自らが売った仲間の叫び声は、\n陛下の心にどう作用しているの？",
    "NpcId": 12
  },
  {
    "Id": 425038,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25038",
    "Message": "ママ、このデータどう思う？\nバイオ屋の見解としては――…",
    "NpcId": 12
  },
  {
    "Id": 425039,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25039",
    "Message": "体調が悪そう？\nアズー、お薬だしておいてー",
    "NpcId": 12
  },
  {
    "Id": 425040,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25040",
    "Message": "陛下、いつもながら協力に感謝ね",
    "NpcId": 12
  },
  {
    "Id": 425041,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25041",
    "Message": "悪人のようだとよく言われる\nでは、その恩恵に預かり生き延びる人類は\nすべからく悪人かしら？",
    "NpcId": 12
  },
  {
    "Id": 425042,
    "VoicePlayType": 9,
    "VoiceAssetId": "uniq/25042",
    "Message": "…臭う？\nそう、それと実験とどっちが大事？",
    "NpcId": 12
  },
  {
    "Id": 525001,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25001",
    "Message": "んーー！ママ先生の匂いがするっすー！",
    "NpcId": 13
  },
  {
    "Id": 525002,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25002",
    "Message": "被験者運ぶ用のダンボール、\nオッターさんからもらってきたっす！",
    "NpcId": 13
  },
  {
    "Id": 525003,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25003",
    "Message": "今日の実験内容は――…\nほほう！なるほどっすね！",
    "NpcId": 13
  },
  {
    "Id": 525004,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25004",
    "Message": "ママ先生！実験準備は完璧っす！",
    "NpcId": 13
  },
  {
    "Id": 525005,
    "VoicePlayType": 1,
    "VoiceAssetId": "uniq/25005",
    "Message": "アズさんほどじゃないっすけど、\n調薬できるんで、何かあったら\n任せてくださいっす！",
    "NpcId": 13
  },
  {
    "Id": 525027,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25027",
    "Message": "おおー！今日はいつもよりすごいっす！",
    "NpcId": 13
  },
  {
    "Id": 525028,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25028",
    "Message": "被験者さん、訴えたくなったら\nとりあえず舞護を訴えてくださいっす！",
    "NpcId": 13
  },
  {
    "Id": 525029,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25029",
    "Message": "ママ先生の手さばき、いつみても\n宇宙一っすね…！",
    "NpcId": 13
  },
  {
    "Id": 525030,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25030",
    "Message": "さてさて、あとの工程の準備を\nしなくちゃっすね！",
    "NpcId": 13
  },
  {
    "Id": 525031,
    "VoicePlayType": 6,
    "VoiceAssetId": "uniq/25031",
    "Message": "舞護の予想では、\nこのあと被験者さんは立てなくなるっす！",
