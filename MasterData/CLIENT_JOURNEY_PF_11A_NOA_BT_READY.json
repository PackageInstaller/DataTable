      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_TOWNGUARD"
      ],
      "UnitTalk_KOR": "작전 브리핑 곧 시작하겠습니다!",
      "UnitTalk_JPN": "作戦会議、まもなく開始します！",
      "TalkTime": 0.03,
