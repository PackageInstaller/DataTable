    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "또 채소만 골라내고 있냐?! 대단하다, 진짜!",
      "UnitTalk_JPN": "また野菜だけ残してんのか！？いい根性してんじゃねぇか！",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "고기 말고 야채랑 채소도 골고루 먹으라니까?!",
      "UnitTalk_JPN": "肉だけじゃなく、野菜もちゃんと食えって言ってんだろ！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitPos": "POS2",
      "UnitTalk_KOR": "풀, 맛없어.",
      "UnitTalk_JPN": "草、まずい。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "고기만 먹으면 안 돼?",
      "UnitTalk_JPN": "肉だけ食べたらダメ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "안돼! 내가 이유 없이 골고루 먹으라 하겠냐?",
      "UnitTalk_JPN": "ダメだ！理由もなく、野菜を食えって言ってるわけじゃねぇんだよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "잘 들어.",
      "UnitTalk_JPN": "いいか、よく聞くんだぞ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitTalk_KOR": "고기랑 기름은 말이야. 맛있지만 건강에 안 좋아.",
      "UnitTalk_JPN": "肉と油はな、うめぇが健康にはよくねぇんだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "채소와 야채를 먹지 않으면 피가 끈적해져. 언제 쓰러져도 모른다, 너?",
      "UnitTalk_JPN": "野菜を食わなきゃ、血がドロドロになっちまう。お前だって倒れたくねぇだろ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "…흥.",
      "UnitTalk_JPN": "…ふん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "흥…?",
      "UnitTalk_JPN": "ふん…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "흐으으으으응…?!! 이게 머리만 굵어 가지고…!",
      "UnitTalk_JPN": "ふん、だとぉぉぉぉぉ…！？態度だけは一丁前じゃねぇか…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "냐하하~ 현장반장. 진정해.",
      "UnitTalk_JPN": "にゃはは～。まぁまぁ班長、落ち着いてよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "CameraOffset": "ONE_4",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "모처럼 함께 하는 아침 식사잖아? 느긋하게 즐기자구~",
      "UnitTalk_JPN": "朝ごはんを一緒に食べるなんて、久しぶりでしょー？せっかくなんだし、もっと楽しく食べようよ～。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "어이! 뭘 멋대로 남의 음식을 집어 가냐!",
      "UnitTalk_JPN": "おい！勝手に人のもん食べんじゃねぇ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "TRIPLE_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아무튼 채소랑 야채도 남기지 말고 먹어.",
      "UnitTalk_JPN": "とにかく、野菜も残さず食べろよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "POS3_2X",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "안 그러면 튀김은 금지야!",
      "UnitTalk_JPN": "じゃねぇと、天ぷら禁止にするからな！",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "POS2_2X",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "금지…!?",
      "UnitTalk_JPN": "禁止…！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "ONE_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "안돼…! 튀김만큼은, 안돼…!",
      "UnitTalk_JPN": "ダメ…！天ぷらだけは、絶対ダメ…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "알겠으면 빨리 먹어. 하여간 이렇게라도 하지 않으면…",
      "UnitTalk_JPN": "分かったら早く食え。ったく、こうでもしねぇと食わねぇんだから…",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "응~? 그런데 페트라, 이상한 점 발견했어.",
      "UnitTalk_JPN": "あれれ～？ペトラ、おかしなことに気づいちゃったかも。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "UnitMotion": "SMILE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "편식하는 건 현장반장도 마찬가지 아닌가~?",
      "UnitTalk_JPN": "そういう班長だって、偏食してるじゃ～ん？",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아앙…?! 무슨…!",
      "UnitTalk_JPN": "あぁん…！？てめぇ、なに言ってんだ…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "마르실도 툭하면 고기를 남기잖아?",
      "UnitTalk_JPN": "マルシルだって、お肉残してるよね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "CameraOffset": "ONE_4",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "뭐라 그랬더라~? 무슨 핑계였지~?",
      "UnitTalk_JPN": "いつもの言い訳、なんだったっけ～？",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "핑계가 아니라 위장이 약해서 고기를 못 받아들인다고 했잖냐!",
      "UnitTalk_JPN": "言い訳じゃなく、胃腸が弱ぇから身体が肉を受け付けねぇんだよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그리고 몸만 멀쩡하면 됐지, 뭘 억지로 고기를 먹어?",
      "UnitTalk_JPN": "それに、ワシは健康そのものだからな。無理して肉を食う必要はねぇだろ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그래~? 그렇단 말이지~?",
      "UnitTalk_JPN": "ふ～ん、そうなの～？",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "그럼 타냐도 건강하니까 고기만 먹어도 되지 않을까? 페트라는 그렇게 생각해!",
      "UnitTalk_JPN": "だったら、健康なターニャも肉だけ食べたらよくなーい？ペトラはそう思うなっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "윽…! 그, 그건…",
      "UnitTalk_JPN": "うっ…！そ、それは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "이야기가 다르지! 고기만 먹으면 영양이 부족해지잖냐!",
      "UnitTalk_JPN": "また話がちげぇだろ！肉だけ食べてたら、栄養不足になるって言ってんだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "애초에 싫은 녀석한테는 싫은 소리도 안 해.",
      "UnitTalk_JPN": "そもそもワシは…気に入らねぇやつには、わざわざこんなこと言わねぇんだよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitTalk_KOR": "관짝에 누우라고 내버려두지, 뭐 하러 조언해? 오래 볼 사이니까 충고하지.",
      "UnitTalk_JPN": "ワシはどうなっても知らねぇからな。ターニャには長生きしてほしいから言ってんだよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "ONE_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "마르실…",
      "UnitTalk_JPN": "マルシル…",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "마르실도 고기 먹어.",
      "UnitTalk_JPN": "マルシルも、肉たべて。",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "…아앙?!",
      "UnitTalk_JPN": "…あぁん！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitTalk_KOR": "나, 야채 먹을게. 대신 마르실도 고기 먹어.",
      "UnitTalk_JPN": "わたし、野菜たべる。だから、マルシルは肉たべよう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "솔선수범. 마르실이 그랬어.",
      "UnitTalk_JPN": "まずは自分がお手本を見せること。マルシルが教えてくれた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "SAD",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "윽…!? 내가 했던 말을…!",
      "UnitTalk_JPN": "うっ…！ワシが言ったことを…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "CameraOffset": "TRIPLE_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "냐하하~ 타냐가 제대로 한 방 먹였네.",
      "UnitTalk_JPN": "にゃはは～！ターニャに一本取られちゃったね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "자, 현장반장~ 고기 먹어야겠지?",
      "UnitTalk_JPN": "さぁさぁ～！お肉、食べよっか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "응, 응.",
      "UnitTalk_JPN": "うん、うん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "윽…!",
      "UnitTalk_JPN": "うっ…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "작업하기 전인데 고기는 조금… 부담이 되는데… 크윽…!",
      "UnitTalk_JPN": "仕事前に肉は…キツすぎる…んぐぐ…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…타냐!",
      "UnitTalk_JPN": "…ターニャ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "응?",
      "UnitTalk_JPN": "うん？",
      "TalkTime": 0.03
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "…너, 고기 좋아하지?",
      "UnitTalk_JPN": "…お前、肉好きだろ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "내 것도 먹을래? 양보할게.",
      "UnitTalk_JPN": "ワシの分も食うか？譲ってやるよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "ONE_2",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "싫어.",
      "UnitTalk_JPN": "やだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "TWIN_2",
      "UnitTalk_KOR": "그래, 그럼 나눠… 뭐?",
      "UnitTalk_JPN": "よし、じゃあ分けてや…あぁん？",
      "TalkTime": 0.03
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "SURPRISE",
      "TalkAppend": true
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitTalk_KOR": "싫어. 마르실, 나빠.",
      "UnitTalk_JPN": "やだ。マルシル、悪いことした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitTalk_KOR": "자기도 고기 못 먹으면서. 나한테 야채 안 먹는다고 혼냈어.",
      "UnitTalk_JPN": "自分も肉が食べられないのに。わたしに野菜を食べろって怒った。",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "빨리 먹어.",
      "UnitTalk_JPN": "早く食べて。",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "CameraOffset": "ONE_4",
      "UnitMotion": "SAD",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "냐하하~ 흥미진진하네. 페트라, 두근두근…!",
      "UnitTalk_JPN": "にゃはは～！ペトラ、ワクワクドキドキ…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "어떡할 거야? 현.장.반.장.?",
      "UnitTalk_JPN": "どうするの？班・長・さ・ん？",
      "TalkTime": 0.03
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "TRIPLE_2",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "그… 윽…!",
      "UnitTalk_JPN": "うっ…んぐぐっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "미, 미안하다… 내가 잘못했어. 앞으로 뭐라고 안 할게.",
      "UnitTalk_JPN": "ワ、ワシが悪かった…もう野菜を食べろとか言わねぇよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "응. 알았어.",
      "UnitTalk_JPN": "うん。分かった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "마르실, 솔직해. 자신이 잘못했으면 바로 사과해.",
      "UnitTalk_JPN": "マルシルは、正直。自分が間違ってると思ったら、すぐに謝ってくれる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitTalk_KOR": "그런 점이 좋아. 응.",
      "UnitTalk_JPN": "そういうところが好き。うん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "켁…! 쓰, 쓸데없는 소리 하고 있어!",
      "UnitTalk_JPN": "けっ…！バ、バカみてぇなこと言いやがって！",
      "TalkTime": 0.03
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "UnitTalk_KOR": "돼, 됐으니까 빨리 먹기나 해! 집합 시간까지 얼마 안 남았으니까.",
      "UnitTalk_JPN": "もういいから早く食えよ！集合時間まであと少しだぞ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "ONE_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "고기, 가져갈게.",
      "UnitTalk_JPN": "肉、食べてあげる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "CameraOffset": "ONE_4",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아! 블랙 올리브다. 페트라는 블랙 올리브가 싫은데~",
      "UnitTalk_JPN": "あっ！ブラックオリーブだ。ペトラ、これきらーい！",
      "TalkTime": 0.03
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_BOMB",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "냐하하~ 여기에다 빼놔야지~",
      "UnitTalk_JPN": "にゃはは～！ここに置いちゃお～っと！",
      "TalkTime": 0.03
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_WRENCH",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "어이! 뭘 자연스럽게 남의 그릇에다 옮겨 담고 있냐? 접시에 얼굴 박고 싶냐?!",
      "UnitTalk_JPN": "おい！しれっとワシの皿にのせてんじゃねぇ！ぶっ飛ばされてぇのか！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "ONE_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "우물우물…",
      "UnitTalk_JPN": "もぐもぐ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "POS2_2X",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "고기, 맛있어!",
      "UnitTalk_JPN": "肉、美味しい！",
      "TalkTime": 0.03
    },
    {
      "Uid": 77,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_CONSTRUCT_GADGET_03",
      "WaitClick": true,
