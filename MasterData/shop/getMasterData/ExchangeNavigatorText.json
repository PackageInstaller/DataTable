[
 {
  "textGroupId": 1,
  "text": "やぁダディ……欲しいもんがあるなら言ってみろよ。",
  "voiceFile": "sho205401_01"
 },
 {
  "textGroupId": 1,
  "text": "汚れた金貨を洗うならここさ……さぁ、何を持ってきたんだい?",
