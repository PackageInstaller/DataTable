  },
  {
    "Id": 82300601,
    "VoicePlayType": 20001,
    "VoiceAssetId": "uniq/23006",
    "Message": "いまのエルちゃんは\nいつもどおりのエルちゃんです！",
    "NpcId": 8
  },
  {
    "Id": 82300701,
    "VoicePlayType": 20001,
    "VoiceAssetId": "uniq/23007",
    "Message": "エルちゃん、特に不満とかは\nないみたいです",
    "NpcId": 8
  },
  {
    "Id": 82300801,
    "VoicePlayType": 20001,
    "VoiceAssetId": "uniq/23008",
    "Message": "エルちゃんの様子は、\nほどよく可もなく不可もなく！",
    "NpcId": 8
  },
  {
    "Id": 82300901,
    "VoicePlayType": 20002,
    "VoiceAssetId": "uniq/23009",
    "Message": "エルちゃんはとっても\nとってもご機嫌ですっ♪",
    "NpcId": 8
  },
  {
    "Id": 82301001,
    "VoicePlayType": 20002,
    "VoiceAssetId": "uniq/23010",
    "Message": "見ての通り、エルちゃんは\n元気いっぱいですよ！",
    "NpcId": 8
  },
  {
    "Id": 82301101,
    "VoicePlayType": 20002,
    "VoiceAssetId": "uniq/23011",
    "Message": "エルちゃんのしっぽは\nブンブンです！\n大満足みたいですよ！",
    "NpcId": 8
  },
  {
    "Id": 82301201,
    "VoicePlayType": 20003,
    "VoiceAssetId": "uniq/23012",
    "Message": "エルちゃん、\n少しごきげん斜めみたいです",
    "NpcId": 8
  },
  {
    "Id": 82301301,
    "VoicePlayType": 20003,
    "VoiceAssetId": "uniq/23013",
    "Message": "なにか不満があるみたいです\nエルちゃん……",
    "NpcId": 8
  },
  {
    "Id": 82301401,
    "VoicePlayType": 20003,
    "VoiceAssetId": "uniq/23014",
    "Message": "エルちゃん、少し元気がなくて\nメモリーが足りないのかなぁ？",
    "NpcId": 8
  },
  {
    "Id": 82301501,
    "VoicePlayType": 20004,
    "VoiceAssetId": "uniq/23015",
    "Message": "あわわ…！大変です！\nエルちゃん怒ってます…",
    "NpcId": 8
  },
  {
    "Id": 82301601,
    "VoicePlayType": 20004,
    "VoiceAssetId": "uniq/23016",
    "Message": "いまのエルちゃんは、\n不満が爆発してて\n鋭いナイフみたいです",
    "NpcId": 8
  },
  {
    "Id": 82301701,
    "VoicePlayType": 20004,
    "VoiceAssetId": "uniq/23017",
    "Message": "エルちゃん、何かが\n足りてないみたいで\nすごく不機嫌です…",
    "NpcId": 8
  },
  {
    "Id": 82301801,
    "VoicePlayType": 20005,
    "VoiceAssetId": "uniq/23018",
    "Message": "キャンペーン開催中ですっ♪\nいいこと色々ですよ！",
    "NpcId": 8
  },
  {
    "Id": 82301901,
    "VoicePlayType": 20005,
    "VoiceAssetId": "uniq/23019",
    "Message": "お世話するなら今がチャンスです！\nエルちゃんもそう言ってますっ",
    "NpcId": 8
  },
  {
    "Id": 82302001,
    "VoicePlayType": 20005,
    "VoiceAssetId": "uniq/23020",
    "Message": "いまだけ、ちょっと良いこと\nご用意してますっ♪",
    "NpcId": 8
  },
  {
    "Id": 82302101,
    "VoicePlayType": 30001,
    "VoiceAssetId": "uniq/23021",
    "Message": "大変です陛下っ！\nエルちゃんが、脱走しました…！",
    "NpcId": 8
  },
  {
    "Id": 82302201,
    "VoicePlayType": 30001,
    "VoiceAssetId": "uniq/23022",
    "Message": "陛下ぁ、エルちゃんに\n何か変なことしませんでしたぁ？",
    "NpcId": 8
  },
  {
    "Id": 82302301,
    "VoicePlayType": 30001,
    "VoiceAssetId": "uniq/23023",
    "Message": "陛下がいじわるするから、\nエルちゃんがスネて\nどっか行っちゃいました…",
    "NpcId": 8
  },
