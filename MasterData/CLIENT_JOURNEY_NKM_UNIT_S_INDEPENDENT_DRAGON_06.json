      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "으윽… 정론을 꺼내 들다니… 제법이로구나.",
      "UnitTalk_JPN": "ううっ…正論を振りかざすとは…童もやりおるのう。",
      "TalkTime": 0.03
