      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_TEENAGER_FEMALE",
      "UnitNameString": [
        "SI_GIRL"
      ],
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "아, 설마…!",
      "UnitTalk_JPN": "あっ、まさか…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "기억이 난 모양인 게로구나.",
      "UnitTalk_JPN": "思い出したようじゃのう。",
