      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래, 그동안 탈 없이 잘 지내었느냐?",
