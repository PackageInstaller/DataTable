  "_Version": 4,
  "Data": [
    {
      "Uid": 45,
      "WaitClick": false,
      "WaitTime": 1.0,
      "EndBgmFileName": "MUSIC_BATTLE_BOSS_01.mp3",
      "BgFileName": "ILLUST_BG_NOA_DOWNTOWN_DESTROYED.png",
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_MOVEMENT_FOOT_STEP_CHASE.wav"
    },
    {
      "Uid": 1,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아세라와 함께 거리로 달려 나왔다.",
      "UnitTalk_JPN": "アセラと共に、急いで街へと向かった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 2,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "평화로웠던 아까의 모습이 거짓말처럼, 도심 곳곳에서 연기가 피어오르고 있었다.",
      "UnitTalk_JPN": "先ほどまで平和だった街の様子は一転し、至る所から煙が上がっている。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "혹시나 해서 물어보는데… 가지고 있는 무기는 없는 거지?",
      "UnitTalk_JPN": "一応聞いておこうと思うんだけど…武器は持ってないわよね？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_02_UNIT_S_VOYAGER_STRANIS_001.wav"
    },
    {
      "Uid": 4,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "…그야 당연히 없다.",
      "UnitTalk_JPN": "…もちろんないが。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 5,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그럴 것 같아서 내가 하나 가져왔어.",
      "UnitTalk_JPN": "そうだと思って、剣を一振り持ってきたわ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_02_UNIT_S_VOYAGER_STRANIS_002.wav"
    },
    {
      "Uid": 6,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "특별한 능력은 없지만 튼튼한 검이니까 호신용으로는 쓸만할 거야.",
      "UnitTalk_JPN": "特別な能力はないけど、かなり丈夫だから護身用には使えるわ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_02_UNIT_S_VOYAGER_STRANIS_003.wav"
    },
    {
      "Uid": 7,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "…고맙긴 하지만, 난 검 같은 걸 다뤄본 적도 없는데 이걸 받아봤자-",
      "UnitTalk_JPN": "…気持ちは嬉しいが、私は剣を扱ったことがないー",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 8,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "라고 생각하며, 아세라가 준 검을 손에 쥔 순간.",
      "UnitTalk_JPN": "そう思いながら、アセラから剣を受け取った瞬間。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 9,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…어?",
          "JumpAnchorStringId_JPN": "…おっ？"
        }
      ]
    },
    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "응? 왜 그래?",
      "UnitTalk_JPN": "どうしたの？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_02_UNIT_S_VOYAGER_STRANIS_004.wav"
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아, 아무것도 아냐.",
          "JumpAnchorStringId_JPN": "な、何でもない。"
        }
      ]
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "분명 검을 만져본 건 이번이 처음이라고 생각했는데, 기묘할 정도로 익숙한 감각이 손끝에서 느껴졌다.",
      "UnitTalk_JPN": "触れるのはこれが初めてのはずだが…奇妙なほど手に馴染んだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 13,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "마치 평생 다뤄온 도구처럼.",
      "UnitTalk_JPN": "まるで、一生を共にしてきた武器かのように。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 14,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…",
          "JumpAnchorStringId_JPN": "…"
        }
      ]
    },
    {
      "Uid": 46,
      "WaitClick": false,
      "WaitTime": 0.3,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_SWOOSH_16.wav"
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_SWOOSH_20.wav",
      "UnitTalk_KOR": "손에 쥔 검을 몇 번 휘둘러보았다.",
      "UnitTalk_JPN": "握った剣を、何度か振ってみた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "…스스로도 놀랄 정도로 능숙한 느낌으로 검을 다룰 수 있었다.",
      "UnitTalk_JPN": "…自分でも驚くほどに、鮮やかな剣捌きだった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "음! 폼이 예사롭지 않은데?",
      "UnitTalk_JPN": "すごい！初心者とは思えないわね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_02_UNIT_S_VOYAGER_STRANIS_005.wav"
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래도 위험하게 앞으로 나설 필요는 없어.",
      "UnitTalk_JPN": "でも、危険を冒してまで前に出る必要はないわ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_02_UNIT_S_VOYAGER_STRANIS_006.wav"
    },
    {
      "Uid": 19,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "아직 몸 상태가 덜 회복되었을 수도 있으니까.",
      "UnitTalk_JPN": "身体もまだ本調子じゃないだろうし。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_02_UNIT_S_VOYAGER_STRANIS_007.wav"
    },
    {
      "Uid": 20,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "직접적인 전투는 내가 맡을 테니까, 넌 전체적인 전황을 보고 지시를 해 줘.",
      "UnitTalk_JPN": "あなたは戦況を把握して指示をしてくれる？戦闘はわたしに任せてちょうだい。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_02_UNIT_S_VOYAGER_STRANIS_008.wav"
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "괜찮겠어? 혼자?",
          "JumpAnchorStringId_JPN": "一人で戦うのか？大丈夫？"
        }
      ]
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "물론! 검술이라면 누구에게도 밀리지 않을 자신이 있어!",
      "UnitTalk_JPN": "もちろん！剣術なら、誰にも負けない自信があるの！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_02_UNIT_S_VOYAGER_STRANIS_009.wav"
    },
    {
      "Uid": 23,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "그리고 우리의 목표는 관측사 구출이니까, 전투는 최대한 피해서-",
      "UnitTalk_JPN": "それに、わたしたちの目標は観測士の救出だから、戦闘はできるだけ避けてー",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_02_UNIT_S_VOYAGER_STRANIS_010.wav"
    },
    {
      "Uid": 47,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "ANGRY"
    },
    {
      "Uid": 24,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "말을 하던 아세라가 내 뒤쪽을 보더니 굳은 얼굴로 변했다.",
      "UnitTalk_JPN": "アセラは私の背後を見ると、表情を固くした。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "아세라의 시선을 따라가자, 거리 저편에 회색빛으로 물든 공간이 보였다.",
      "UnitTalk_JPN": "アセラの視線の先を追うと、白い光に包まれた空間が見えた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "WaitClick": false,
      "WaitTime": 0.5,
      "BgFadeInStartCol": [
        "0",
