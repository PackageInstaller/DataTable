      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "<color=#F7BE45>[공허균열]</color>이잖아…!",
      "UnitTalk_JPN": "<color=#F7BE45><r=ヴォイドリフト>空虚の亀裂</r></color>ね…！",
