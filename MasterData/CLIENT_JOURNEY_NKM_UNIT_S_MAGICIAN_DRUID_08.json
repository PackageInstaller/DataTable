  "Data": [
    {
      "Uid": 1,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "RewardAnchor": "REWARD_ANCHOR_1",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_FOREST_ROAD.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_11.mp3",
      "CameraOffset": "TWIN_6"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "단장님! 여기예요, 여기!",
      "UnitTalk_JPN": "団長！ここです、ここー！",
      "UnitTalk_TWN": "團長！這裡，這裡！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_1.ogg"
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "역시 도시 사람이시군요.",
      "UnitTalk_JPN": "さすが都会の人ですね。",
      "UnitTalk_TWN": "真不愧是都市人呢。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_2.ogg"
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "숲길이라 복잡했을 텐데 약속 시간에 딱 맞춰 오셨어요!",
      "UnitTalk_JPN": "森の道は複雑だったでしょうに、約束の時間ピッタリです！",
      "UnitTalk_TWN": "雖然林間小路很複雜，但您還是準時到了！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_3.ogg"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "숲에서 만나자고 한 이유가 뭐야?",
          "JumpAnchorStringId_JPN": "なんで森に呼び出したの？",
          "JumpAnchorStringId_TWN": "為什麼約在森林裡啊？"
        }
      ]
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "어라?",
      "UnitTalk_JPN": "あれ？",
      "UnitTalk_TWN": "咦？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_4.ogg"
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "혹시 제가 설명하지 않았나요? 으으… 죄송해요.",
      "UnitTalk_JPN": "もしかして、お伝えしてなかったですか？うぅ…すみません…",
      "UnitTalk_TWN": "難道我沒解釋嗎？呃呃…對不起。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_5.ogg"
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "오늘 단장님을 이곳에 부른 이유는 바로!",
      "UnitTalk_JPN": "団長をここにお呼びした理由は、ズバリ！",
      "UnitTalk_TWN": "今天我叫團長來這裡是為了！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_6.ogg"
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.4,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "<color=#F7BE45>쿠나마타</color>예요!",
      "UnitTalk_JPN": "<color=#F7BE45>クナマタ</color>です！",
      "UnitTalk_TWN": "<color=#F7BE45>庫納馬塔</color>！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_7.ogg"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>쿠나마타</color>?",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>クナマタ</color>？",
          "JumpAnchorStringId_TWN": "<color=#F7BE45>庫納馬塔</color>？"
        }
      ]
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "DEFAULT",
      "UnitMotion": "SERIOUS"
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "땔감은 충분한가요, 단장님?",
      "UnitTalk_JPN": "薪は足りていますか？",
      "UnitTalk_TWN": "柴火還夠嗎，團長？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_8.ogg"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>쿠나마타</color>는 철저한 준비가 필요해요.",
      "UnitTalk_JPN": "<color=#F7BE45>クナマタ</color>には、入念な準備が必要です。",
      "UnitTalk_TWN": "<color=#F7BE45>庫納馬塔</color>需要做好充足的準備。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_9.ogg"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "하루 동안 먹을 음식, 안전한 수면 장소.",
      "UnitTalk_JPN": "一日分の食料に、安全な寝床…",
      "UnitTalk_TWN": "包括一天的食物，還有安全的睡覺地方。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_10.ogg"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그리고 공기 좋고 물 좋은 장소를 찾아야 하죠!",
      "UnitTalk_JPN": "そして、水と空気がきれいな場所を見つけないといけません！",
      "UnitTalk_TWN": "還要找空氣好、水質好的地方！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_11.ogg"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "어떠세요, 단장님? 제가 선정한 장소가 마음에 드시나요?",
      "UnitTalk_JPN": "どうですか、団長？わたしが選んだ場所、お気に召しましたか？",
      "UnitTalk_TWN": "怎麼樣，團長？您喜歡我選的地方嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_12.ogg"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>쿠나마타</color>는 야외 캠핑이구나.",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>クナマタ</color>って、野外キャンプのことだったのか。",
          "JumpAnchorStringId_TWN": "原來<color=#F7BE45>庫納馬塔</color>就是戶外露營啊。"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 카노푸스 경비대에서도 친구들이랑 자주 했어요.",
      "UnitTalk_JPN": "あはは！カノプス警備隊でも、友だちとよくしていたんです。",
      "UnitTalk_TWN": "啊哈哈！在卡諾普斯警備隊的時候，我常常和朋友們一起做。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_13.ogg"
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "야영도 하고, 자연도 즐길 수 있거든요.",
      "UnitTalk_JPN": "自然も楽しめますしね。",
      "UnitTalk_TWN": "既能露營又能享受大自然。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_14.ogg"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>쿠나마타</color>가 취미인 아이는 주말에 숲에서 시간을 보내기도 하죠.",
      "UnitTalk_JPN": "<color=#F7BE45>クナマタ</color>が趣味の子は、週末を森で過ごしたりするんですよ。",
      "UnitTalk_TWN": "喜歡<color=#F7BE45>庫納馬塔</color>的孩子週末會在森林裡度過時光。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_15.ogg"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그럼 먹거리를 구해볼까요?",
      "UnitTalk_JPN": "では、食料を調達しましょうか？",
      "UnitTalk_TWN": "那我們去找些食物吧？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_16.ogg"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "숲은 자연의 은혜로 가득해요. 조금만 둘러보면 먹을 걸 발견할 수 있어요.",
      "UnitTalk_JPN": "森は自然の恵みでいっぱいです。少し見回せば、すぐに食べものが見つかりますよ。",
      "UnitTalk_TWN": "森林裡充滿大自然的恩惠，稍微逛逛就能找到吃的。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_17.ogg"
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "앗! 단장님, 저기 보세요!",
      "UnitTalk_JPN": "あっ！団長、あれを見てください！",
      "UnitTalk_TWN": "啊！團長，您看那裡！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_18.ogg"
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "사과가 잔뜩 있어요!",
      "UnitTalk_JPN": "リンゴがたくさんあります！",
      "UnitTalk_TWN": "有好多蘋果！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_19.ogg"
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "높은 곳에 열렸는데?",
          "JumpAnchorStringId_JPN": "高いところにあるけど？",
          "JumpAnchorStringId_TWN": "但長在很高的地方耶？"
        }
      ]
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "괜찮아요. 저는 나무 타기를 잘하니까!",
      "UnitTalk_JPN": "大丈夫です。わたしは木登りが得意ですので！",
      "UnitTalk_TWN": "沒關係，我很會爬樹！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_20.ogg"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "잠시만 기다려주세요, 단장님! 올라가서 사과를 따올게요!",
      "UnitTalk_JPN": "少し待っててくださいね！登ってリンゴを取ってきます！",
      "UnitTalk_TWN": "請稍等一下，團長！我爬上去摘蘋果！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_21.ogg"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_SKY_BLUE.png",
      "CutsceneClear": "CLEARUNIT"
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "다나, 잠시만?!",
          "JumpAnchorStringId_JPN": "ダーナ？ちょっと！？",
          "JumpAnchorStringId_TWN": "達娜，等一下！"
        }
      ]
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitTalk_KOR": "네? 왜 그러세요, 단장님?",
      "UnitTalk_JPN": "はい？どうしましたか、団長？",
      "UnitTalk_TWN": "什麼？怎麼了，團長？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_22.ogg"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitTalk_KOR": "아! 혹시 걱정돼서 그러시나요?",
      "UnitTalk_JPN": "あっ！もしかして、心配してくださるのですか？",
      "UnitTalk_TWN": "啊！您是在擔心我嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_08_DRUID_23.ogg"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitTalk_KOR": "걱정 마세요! 이정도는 높은 것도 아니랍니다!",
      "UnitTalk_JPN": "ご心配には及びませんよ！これぐらい、高くも何ともありませんから！",
      "UnitTalk_TWN": "別擔心！這點高度根本不算什麼！",
      "TalkTime": 0.03,
