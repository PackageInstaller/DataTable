    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_15_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "리사의 안내를 받아 약속 장소에 도착하자, 기다리고 있던 구원자가 인사를 건넸다.",
      "UnitTalk_ENG": "Guided by Lisa, I arrived at the appointed place where a waiting Savior greeted me warmly.",
      "UnitTalk_JPN": "リサに案内され約束の場所に着くと、救援者に挨拶された。",
      "UnitTalk_CHN": "我在丽莎的引导下抵达约定地点，等待已久的救援者向我们打了招呼。",
      "UnitTalk_TWN": "我在麗莎的引導下抵達約定地點，等待已久的救援者向我們打了招呼。",
      "UnitTalk_FRA": "Guidé par Lisa, je suis arrivé au lieu de rendez-vous. Le Sauveur m'y attendait et m'a salué.",
      "UnitTalk_DEU": "Von Lisa geführt, erreichte ich den Treffpunkt, wo mich ein wartender Retter begrüßte.",
      "UnitTalk_ESP": "Guiado por Lisa, llegué al lugar acordado donde el Salvador que me esperaba me saludó cordialmente.",
      "UnitTalk_PRT": "Cheguei ao local de encontro de Lyra e o salvador apareceu.",
      "UnitTalk_THA": "เมื่อมาถึงสถานที่นัดหมายตามคำแนะนำของลิซ่า ผู้กอบกู้ที่รออยู่ก็ทักทาย",
      "UnitTalk_IND": "Dipandu Lisa, aku tiba di tempat yang telah ditentukan, dan sang Penyelamat yang menunggu menyapaku.",
      "UnitTalk_VIE": "Được Lisa hướng dẫn, tôi đến điểm hẹn và được Cứu tinh đang chờ sẵn chào đón.",
      "UnitTalk_HIN": "लिसा के मार्गदर्शन में, मैं तयशुदा जगह पर पहुँचा, जहाँ एक इंतज़ार कर रहे उद्धारकर्ता ने मेरा अभिवादन किया।",
      "TalkTime": 0.03
    },
