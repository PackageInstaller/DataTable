      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_EASTERN_OWL_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "UnitTalk_KOR": "풍월당에 있던 사형도 항상 이야기했었어.",
      "UnitTalk_JPN": "風月堂にいた師兄もいつも言ってたもん。",
      "TalkTime": 0.03
    },
