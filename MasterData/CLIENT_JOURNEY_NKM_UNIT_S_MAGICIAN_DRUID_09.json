  "_Version": 4,
  "Data": [
    {
      "Uid": 1,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_WELL_DIRAC.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_01.mp3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "아하하! 뭔가… 떨리네요.",
      "UnitTalk_JPN": "あはは！なんだか…震えちゃいますね。",
      "UnitTalk_TWN": "啊哈哈！有點…緊張呢。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_1.ogg"
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "한 번도 이런 적 없었는데. 마지막이라 그런 걸까요?",
      "UnitTalk_JPN": "こんなこと、今まで一度もなかったのに。最後だからでしょうか？",
      "UnitTalk_TWN": "我以前從沒這樣過，是因為這是最後了嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_2.ogg"
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "다나라면 반드시 통과할 거야.",
          "JumpAnchorStringId_JPN": "ダーナならきっと通過できるよ。"
        }
      ]
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "…아하하! 감사합니다.",
      "UnitTalk_JPN": "…あはは！ありがとうございます。",
      "UnitTalk_TWN": "…啊哈哈！謝謝團長。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_3.ogg"
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "하지만 <color=#F7BE45>최종 시험</color> 때문에 긴장한 건 아니에요.",
      "UnitTalk_JPN": "でも、<color=#F7BE45>最終試験</color>のせいで緊張している訳ではないんです。",
      "UnitTalk_TWN": "但讓我覺得緊張的不是<color=#F7BE45>最終考試</color>。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_4.ogg"
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "저를 키워준 할머니, 마을 사람들.",
      "UnitTalk_JPN": "育ててくれたおばあちゃんに、村の人たち。",
      "UnitTalk_TWN": "而是養育我的奶奶還有村民們。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_5.ogg"
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "함께 카노푸스 경비대에서 근무했던 동료.",
      "UnitTalk_JPN": "共に働いたカノプス警備隊の仲間たち。",
      "UnitTalk_TWN": "以及在卡諾普斯警備隊共事的同伴。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_6.ogg"
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "마지막으로 NOA에 온 첫날부터 지금까지 저를 이끌어준 사람.",
      "UnitTalk_JPN": "最後に…NOAに来てから、ずっとわたしのことを導いてくれた…",
      "UnitTalk_TWN": "最後是從我第一天來到NOA到現在一直引導我的人…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_7.ogg"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "단장님.",
      "UnitTalk_JPN": "団長。",
      "UnitTalk_TWN": "團長。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_8.ogg"
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "오늘 <color=#F7BE45>여정</color>을 완수하면 단장님에게 받은 <color=#F7BE45>로로카</color>를 조금이나마 돌려드릴 수 있을까요?",
      "UnitTalk_JPN": "<color=#F7BE45>救援の旅</color>を成し遂げれば、団長からの<color=#F7BE45>ロロカ</color>を少しでもお返しできますよね？",
      "UnitTalk_TWN": "今天完成<color=#F7BE45>旅行</color>之後，我能稍微回報一下團長給我的<color=#F7BE45>洛洛卡</color>嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_9.ogg"
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나도 다나에게 <color=#F7BE45>로로카</color>를 돌려줘야 하는 걸.",
          "JumpAnchorStringId_JPN": "私もダーナに、<color=#F7BE45>ロロカ</color>をお返ししないと。",
          "JumpAnchorStringId_TWN": "我也該回報達娜的<color=#F7BE45>洛洛卡</color>呢。"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "<color=#F7BE45>카파라카</color>, <color=#F7BE45>팜팜</color>, <color=#F7BE45>쿠나마타</color>를 이야기하자 다나가 웃음을 터뜨렸다.",
      "UnitTalk_JPN": "<color=#F7BE45>カパラカ</color>、<color=#F7BE45>パムパム</color>、<color=#F7BE45>クナマタ</color>の話をすると、ダーナは大きく笑った。",
      "UnitTalk_TWN": "我說起<color=#F7BE45>卡帕拉卡</color>、<color=#F7BE45>帕姆帕姆</color>和<color=#F7BE45>庫納馬塔</color>，達娜大笑了起來。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "아하하! 그런 일도 있었죠.",
      "UnitTalk_JPN": "あはは！そんなこともありましたね。",
      "UnitTalk_TWN": "啊哈哈！是有這些事呢。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_10.ogg"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…이제야 알았어요.",
      "UnitTalk_JPN": "…やっと分かりました。",
      "UnitTalk_TWN": "…現在我明白了。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_11.ogg"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "마을 사람들이 이야기한 <color=#F7BE45>로로카</color>의 진정한 의미를 깨달았어요.",
      "UnitTalk_JPN": "村の人たちが話していた、<color=#F7BE45>ロロカ</color>の本当の意味を、です。",
      "UnitTalk_TWN": "我終於懂了村民們說的<color=#F7BE45>洛洛卡</color>真正的意義。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_12.ogg"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "단장님과 저.",
      "UnitTalk_JPN": "団長とわたし…",
      "UnitTalk_TWN": "團長和我。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_13.ogg"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "그리고 모든 사람과 사람은 <color=#F7BE45>로로카</color>로 이어져 있던 거예요.",
      "UnitTalk_JPN": "すべての人は、<color=#F7BE45>ロロカ</color>で繋がっているんです。",
      "UnitTalk_TWN": "以及所有人與人之間都以<color=#F7BE45>洛洛卡</color>相連。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_14.ogg"
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "서로가 <color=#F7BE45>로로카</color>를 나눠주고 받으면서 행복한 세상이 만들어지는 거죠.",
      "UnitTalk_JPN": "そして互いに<color=#F7BE45>ロロカ</color>を分かち合うことで、幸せな世界が作られていくのです。",
      "UnitTalk_TWN": "大家互相分享<color=#F7BE45>洛洛卡</color>，共同創造幸福的世界。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_15.ogg"
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "아하하! 단장님, 환하게 웃을 준비되셨나요?",
      "UnitTalk_JPN": "あはは！団長、笑顔の準備はできましたか？",
      "UnitTalk_TWN": "啊哈哈！團長，準備好要露出燦爛的笑容了嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_16.ogg"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "오늘은 제가 단장님에게 <color=#F7BE45>로로카</color>를 나눠 드릴게요!",
      "UnitTalk_JPN": "今日はわたしが団長に、<color=#F7BE45>ロロカ</color>をお分けしますからね！",
      "UnitTalk_TWN": "今天我要分享<color=#F7BE45>洛洛卡</color>給你！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_09_DRUID_17.ogg"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "DEFAULT",
      "UnitMotion": "SERIOUS",
      "UnitQuickSet": true,
      "UnitTalk_KOR": "…준비되셨나요 단장님?",
      "UnitTalk_JPN": "…準備はできましたか、団長？",
      "UnitTalk_TWN": "…準備好了嗎，團長？",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "시간이 되었나?",
          "JumpAnchorStringId_JPN": "もう時間かな？",
          "JumpAnchorStringId_TWN": "時間到了嗎？"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "네, 지금부터 별의 구원자 계승 시험 <color=#F7BE45>[여정]</color>.",
      "UnitTalk_JPN": "では、これより星の救援者・継承試験<color=#F7BE45>「救援の旅」</color>。",
      "UnitTalk_TWN": "好的，那麼現在星之救援者繼承考試<color=#F7BE45>「旅行」</color>…",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그 최종시험을 시작하겠습니다.",
      "UnitTalk_JPN": "最終試験を開始します。",
      "UnitTalk_TWN": "最終考試即將開始。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "시험상대는 <color=#F7BE45>[알데바란의 집행자 길레]</color>.",
      "UnitTalk_JPN": "対戦相手は<color=#F7BE45>「アルデバランの執行者・ギーレ」</color>。",
      "UnitTalk_TWN": "對手是<color=#F7BE45>「畢宿五的執行者吉萊」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "DEFAULT",
      "UnitTalk_KOR": "<color=#F7BE45>[디랙의 우물]</color>이 투영을 개시합니다.",
      "UnitTalk_JPN": "<color=#F7BE45>「ディラックの井戸」</color>が投影を開始します。",
      "UnitTalk_TWN": "開始投影<color=#F7BE45>「迪拉克之井」</color>。",
      "TalkTime": 0.03
    }
  ]
}
