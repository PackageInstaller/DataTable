      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그게…",
      "UnitTalk_JPN": "それが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "기사단에서 나오는 개인 경비를 삭감 당했습니다.",
      "UnitTalk_JPN": "騎士団に、個人経費を減らされてしまいましたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "기사단에서 <color=#F7BE45>빌린</color> 자금을 회수할 때까지 50%만 지급하겠다고…",
      "UnitTalk_JPN": "騎士団から<color=#F7BE45>借りた</color>資金を回収するまで、経費は50％だけ支給すると…",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그래서 어쩔 수 없이 요 며칠간 하루 한 끼만 먹고 있죠.",
      "UnitTalk_JPN": "そこで、ここ数日は仕方なく一日一食の生活をしているのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "어제 디저트를 사 먹는 걸 본 것 같은데…",
          "JumpAnchorStringId_JPN": "昨日、スイーツを食べてなかったっけ…"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "음? 디저트는 식사가 아니지 않습니까.",
      "UnitTalk_JPN": "むむ？スイーツは食事ではないでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "<color=#F7BE45>통치학</color> 서적에 보면 국민들은 빵만으로 살 수 없는 법이라고 나와 있습니다.",
      "UnitTalk_JPN": "<color=#F7BE45>統治学</color>の書籍を見れば、国民はパンだけで生きられないと書かれております。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "<color=#F7BE45>디저트</color>의 중요함을 알려주는 경구죠.",
      "UnitTalk_JPN": "<color=#F7BE45>スイーツ</color>の重要さを教えてくれる警句なのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아닌 것 같은데…",
          "JumpAnchorStringId_JPN": "違うと思うけど…"
        }
      ]
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "말이 나와서 말인데 전 공국을 사랑하지만 공국의 디저트는 솔직히 별로입니다.",
      "UnitTalk_JPN": "ところで…わたくしは公国を愛していますが、公国のスイーツは正直イマイチです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "더구나 기사단 부단장이 만들어 주는 간식을 가장한 괴식은 정말이지 끔찍하죠.",
      "UnitTalk_JPN": "それに、騎士団の副団長が作ってくれるおやつ…を称したとんでもない食べ物は本当にひどいのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그러니 NOA에 온 지금 제가 디저트를 사 먹지 않는 건 이론적으로 <color=#F7BE45>기회비용의 낭비</color>라 할 수 있습니다.",
      "UnitTalk_JPN": "そのため…NOAに来た今、わたくしがスイーツを食べないのは理論的に<color=#F7BE45>機会損失</color>と言えるでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "벌꿀사탕 판 돈은 다 어쩌고?",
          "JumpAnchorStringId_JPN": "ミツアメを売ったお金は？"
        }
      ]
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SAD",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "아 그건…",
      "UnitTalk_JPN": "あっ、それは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "이번에 공국 농사 작황이 어렵다고 해서 전부 지원금으로 보냈습니다.",
      "UnitTalk_JPN": "公国の農業が難しい状況にあったため、すべて支援金として送りました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "국민들은 빵만으론 살 수 없지만 빵이 없어도 살 수 없으니까요.",
      "UnitTalk_JPN": "国民はパンだけでは生きられないけれど、パンがなくても生きられないからです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…대단한데? 정말 착한 일을 했는 걸.",
          "JumpAnchorStringId_JPN": "…すごい。心優しいことをしたんだな？"
        }
      ]
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "차, 착하다니!",
      "UnitTalk_JPN": "こ、心優しいですって！",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "오해 마시죠. 전 피도 눈물도 없는 차가운 사업가입니다!",
      "UnitTalk_JPN": "誤解はなさらぬように。わたくしは、血も涙もない冷たい事業家なのですっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "이번 일은… 그러니까…",
      "UnitTalk_JPN": "今回のことは…その…",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래요, 재투자! 재투자를 한 거죠!",
      "UnitTalk_JPN": "そうです、再投資！再投資をしたのですよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "브랜드 이미지 구축이랄까요?",
      "UnitTalk_JPN": "ブランドイメージの構築といいますか…",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 1.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_HUNGRY_2.wav",
      "UnitTalk_KOR": "꼬르르르륵!",
      "UnitTalk_JPN": "ぐうううぅぅ！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "프레이의 배에서 우렁찬 소리가 들려온다. ",
      "UnitTalk_JPN": "フレイのお腹から、地響きのような音が聞こえた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아무래도 이대로 훈련을 진행하는 건 무리다. ",
      "UnitTalk_JPN": "どうやら、このままトレーニングを続けるのは難しそうだ。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이쯤 하고 뭐라도 먹으러 가자.",
          "JumpAnchorStringId_JPN": "トレーニングはこれぐらいにして、何か食べに行こう。"
        }
      ]
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "지금까지 제가 한 말을 듣긴 하셨습니까?",
      "UnitTalk_JPN": "わたくしの話を聞いていなかったのですか？",
      "TalkTime": 0.03
    },
    {
