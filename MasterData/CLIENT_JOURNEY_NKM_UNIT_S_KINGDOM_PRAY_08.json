    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
