    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_04_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "공허체들이 저렇게 몰려오는 건 <color=#F7BE45>[레이븐 월]</color> 함락 때 이후로 처음 보는 것 같아.",
      "UnitTalk_JPN": "あんなにたくさんの空虚体を見たのは<color=#F7BE45>「レイヴン・ウォール」</color>がやられちゃった時以来かな。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_04_UNIT_S_VOYAGER_ORACLE_002.wav"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_04_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
