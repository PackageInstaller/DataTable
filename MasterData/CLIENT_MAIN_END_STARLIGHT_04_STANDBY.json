      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_04_UNIT_S_VOYAGER_SMILE_002.wav"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_04_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "이 정도 수의 공허체가 라비스타로 낙하한다면 버틸 가능성은 전무.",
      "UnitTalk_JPN": "あれだけの空虚体がラビスタ―に落下すれば、耐えられる可能性はゼロ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_04_UNIT_S_VOYAGER_SMILE_003.wav"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_04_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아무튼, 여기가 <color=#F7BE45>[별의 전당]</color> 이라는 거지?",
      "UnitTalk_JPN": "とにかく、ここが<color=#F7BE45>「星の殿堂」</color>ってことでいいんだよね？",
