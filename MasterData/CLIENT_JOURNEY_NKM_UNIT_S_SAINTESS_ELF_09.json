{
  "$schema": "../../../../../DataSchema/Exported.jsonc",
  "$comment": "name: JOURNEY_NKM_UNIT_S_SAINTESS_ELF_09",
  "_Version": 4,
  "Data": [
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_WELL_DIRAC.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_01.mp3"
    },
    {
      "Uid": 66,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "<color=#F7BE45>[디랙의 우물]</color>… 여정의 최종 시험대…",
      "UnitTalk_JPN": "<color=#F7BE45>「ディラックの井戸」</color>…旅の最終試練の場…",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "겨, 결국 여기까지 오고 말았어요, 단장님!",
      "UnitTalk_JPN": "つ、ついにここまで来てしまいました、団長！",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "저처럼 둔하고 하찮은 모노리스 교단의 117번 성녀가… 여, 여정의 마지막까지 온 거예요!",
      "UnitTalk_JPN": "どんくさくて取るに足らない序列117番聖女が… さ、最終試験までたどり着いたんです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "긴장했어?",
          "JumpAnchorStringId_JPN": "緊張してる？"
        }
      ]
    },
    {
      "Uid": 70,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "네… 떠, 떨려요… 지금도 이렇게… 부들부들 하고…",
      "UnitTalk_JPN": "はい…ドキドキします…こうして…震えるほどに…",
      "TalkTime": 0.03
    },
    {
      "Uid": 71,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "하지만…",
      "UnitTalk_JPN": "ですが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "마, 말하자면 이건 최종 시련…!",
      "UnitTalk_JPN": "こ、これは最後の試練…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 73,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "만약 여기서 승리한다면…",
      "UnitTalk_JPN": "もし勝利すれば…",
      "TalkTime": 0.03
    },
    {
      "Uid": 74,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "맞아, 너는 최고의 구원자가 되는 거…",
          "JumpAnchorStringId_JPN": "エリサは最高の救援者になれ──"
        }
      ]
    },
    {
      "Uid": 75,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SMILE",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "다른 사람들도… 저와 똑같은 수준이 되는 거겠죠!",
      "UnitTalk_JPN": "他の人たちも…私と同じレベルになるということですよね！",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…응?",
          "JumpAnchorStringId_JPN": "…うん？"
        }
      ]
    },
    {
      "Uid": 77,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "전에는 제가 틀렸고 세상이 옳다고 생각했어요.",
      "UnitTalk_JPN": "以前は私が間違っていて、世界が正しいと思っていました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 78,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "뮤리엘님도, 주임사제님도… 전부 제가 이해하지 못하는 깊은 뜻이 있을 거라고 믿었어요.",
      "UnitTalk_JPN": "ミュリエル様も、主任司祭様も…私には理解できない何かがあるのだと信じていました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "저는 둔하고 느린데다가 하찮은 117번 성녀니까… 다른 분들은 부, 분명히 저보다 더 잘 아실 거라고요.",
      "UnitTalk_JPN": "私は鈍くてのろまな上に、取るに足らない序列117番聖女ですから…他の方々は、私よりきっと色んな事をご存じなのだろうと。",
      "TalkTime": 0.03
    },
    {
      "Uid": 80,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그랬었지…?",
          "JumpAnchorStringId_JPN": "前はそうだったね…"
        }
      ]
    },
    {
      "Uid": 81,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "하지만 단장님이 그 때 말해주셨잖아요.",
      "UnitTalk_JPN": "ですが、団長があの時言ってくださったじゃないですか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 82,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "제가 옳았고, 세상이 틀린 거라고요.",
      "UnitTalk_JPN": "私が正しく、世の中が間違っているのだと。",
      "TalkTime": 0.03
    },
    {
      "Uid": 83,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "그리고 대성녀님도 말씀해주셨어요.",
      "UnitTalk_JPN": "そして、大聖女様も教えてくださりました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 84,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "모노리스 교단의 다른 분들도 분명히 틀릴 수 있다고.",
      "UnitTalk_JPN": "モノリス教団の方々も、誤ることがあると。",
      "TalkTime": 0.03
    },
    {
      "Uid": 85,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "오히려 그 분들은 절대 틀릴 리가 없다고 믿는 게 에라라고.",
      "UnitTalk_JPN": "むしろ、己に誤りはないと確信することこそエラの行いであると。",
      "TalkTime": 0.03
    },
    {
      "Uid": 86,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "단장님도, 대성녀님도… 같은 말을 하신 거예요, 그렇죠?",
      "UnitTalk_JPN": "団長も、大聖女様も…同じことをおっしゃりましたね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 87,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "저는 하찮지 않아요. 제 의견은, 제 감정은 하찮지 않아요.",
      "UnitTalk_JPN": "私は取るに足らない存在じゃない。私の意見は、私の感情はくだらないものじゃない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 88,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SMILE",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "최소한 나, 남들도…! 저만큼은 하찮은 거예요…!",
      "UnitTalk_JPN": "ほ、他の人たちも…！私と同じぐらい、取るに足らない存在なんです…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 89,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그게 그렇게 되나…?",
          "JumpAnchorStringId_JPN": "そういう結論になったのか…？"
        }
      ]
    },
    {
      "Uid": 90,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "네에…!",
      "UnitTalk_JPN": "はいぃ…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 91,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "단장님이, 대성녀님이 주신 제게 주신 교훈을 증명하고 싶어요!",
      "UnitTalk_JPN": "団長と大聖女様が、私に授けてくださった教訓を証明したいのです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 92,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "그러려면 우선…!",
      "UnitTalk_JPN": "そのためには、まず…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 93,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "우선?",
          "JumpAnchorStringId_JPN": "まず？"
        }
      ]
    },
    {
      "Uid": 94,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "저기서 곧 나타나실 이교도 분의 머리통부터 깨야 하지 아, 않을까… 하고요!",
      "UnitTalk_JPN": "まもなく現れる異教徒の方の頭蓋骨を叩き割らないと…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 95,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…틀린 말은 아니지만!",
          "JumpAnchorStringId_JPN": "…間違ってはないけど！"
        }
      ]
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…준비되셨나요 단장님?",
      "UnitTalk_JPN": "…準備はできましたか、団長？",
      "TalkTime": 0.03
    },
    {
      "Uid": 96,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "된… 것 같아…",
          "JumpAnchorStringId_JPN": "…できた…と思う…"
        }
      ]
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "네, 지금부터 별의 구원자 계승 시험 <color=#F7BE45>[여정]</color>.",
      "UnitTalk_JPN": "では、これより星の救援者・継承試験<color=#F7BE45>「救援の旅」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그 최종시험을 시작하겠습니다.",
      "UnitTalk_JPN": "最終試験を開始します。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "시험상대는 <color=#F7BE45>[알데바란의 집행자 길레]</color>.",
      "UnitTalk_JPN": "対戦相手は<color=#F7BE45>「アルデバランの執行者・ギーレ」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "<color=#F7BE45>[디랙의 우물]</color>이 투영을 개시합니다.",
      "UnitTalk_JPN": "<color=#F7BE45>「ディラックの井戸」</color>が投影を開始します。",
      "TalkTime": 0.03
    },
    {
      "Uid": 97,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "지켜봐 주세요, 단장님…!",
      "UnitTalk_JPN": "見守っていてください、団長…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 98,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "제가 틀리지 않았다고 얘기해주신 단장님을 위해…",
      "UnitTalk_JPN": "私は間違っていないと仰ってくださった団長のために…",
      "TalkTime": 0.03
    },
    {
      "Uid": 99,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "이 철퇴를, 이번에는 두 눈 똑바로 뜨고 휘두를게요…!",
      "UnitTalk_JPN": "この鉄槌を、今度はしっかり目を見開いて振るいます…！",
      "TalkTime": 0.03
    }
  ]
}
