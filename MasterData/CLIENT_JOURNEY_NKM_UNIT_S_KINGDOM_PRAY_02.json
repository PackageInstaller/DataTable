      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그 자리에서 바로 대량 주문을 넣어 버렸습니다.",
      "UnitTalk_JPN": "その場ですぐ、大量注文しました。",
      "TalkTime": 0.03
    },
    {
