      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "낙하산 단장 주제에 인맥이 하나도 없다는 게 말이 됩니까?",
      "UnitTalk_JPN": "コネ団長のくせに、人脈がひとつもないなんてありえるのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_02",
