      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "이건 그런 사람들을 위해 만든 최신 발명품이라고 합니다.",
      "UnitTalk_JPN": "これはそんな人たちのために作った、最新の発明品だだと。",
      "TalkTime": 0.03
    },
    {
