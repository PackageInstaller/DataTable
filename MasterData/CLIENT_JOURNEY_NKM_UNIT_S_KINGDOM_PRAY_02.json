      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그 사과 받아들이겠습니다.",
      "UnitTalk_JPN": "その謝罪、受け入れて差し上げます。",
