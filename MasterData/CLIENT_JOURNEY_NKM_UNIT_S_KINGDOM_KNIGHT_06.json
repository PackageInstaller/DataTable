      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "CameraOffset": "TWIN_6",
      "UnitMotion": "SAD"
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "…역시 전 기사단장의 자리에는… 어울리지 않는 것 같아요…",
      "UnitTalk_JPN": "…やはり私に騎士団長の任は、荷が重いと思います…",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "대체 왜?",
      "UnitTalk_JPN": "一体なぜ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "왜 저를 기사단장으로 임명했을까요?",
      "UnitTalk_JPN": "私を騎士団長に選んだのでしょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "부단장인 카르멘이 훨씬 기사단장에 어울릴 것 같은데…",
      "UnitTalk_JPN": "副団長のカルメンが、ずっと騎士団長に相応しいのに…",
      "TalkTime": 0.03
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "잘 모르겠어요…",
      "UnitTalk_JPN": "分かりません…",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "누군가에게 잘 보이기 위한 자리가 아니니까.",
          "JumpAnchorStringId_JPN": "誰かに良い姿を見せるための役職ではないからね"
        }
      ]
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "네?",
      "UnitTalk_JPN": "はい？",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "위엄있는 모습이 있다면 좋다. 언제나 모범이 된다면 더할 나위 없다.",
      "UnitTalk_JPN": "威厳のある姿でいれば良い。人の模範となればなおさら良い。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "고상하고 우아한 말로 청중을 사로잡을 수 있다면 분명 좋을 것이다.",
      "UnitTalk_JPN": "高尚で気品あふれる言葉遣いで、聴衆の心を掴むことができればもっと良い。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 그것보다 더 중요한 것이 있기 때문에, 샤를이 임명된 것이다.",
      "UnitTalk_JPN": "しかし、それらより大事なものがあるからこそ、シャルルが任命されたのだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "기사단장은, 모두가 힘들어서 쓰러질 때도-",
          "JumpAnchorStringId_JPN": "騎士団長は、他の団員たちが力尽き倒れた時も、"
        }
      ]
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "굳건히 서서 버팀목이 되어주는 사람이라고 생각해.",
          "JumpAnchorStringId_JPN": "決して屈することなく、揺るぎない支えとなる人だと思う。"
        }
      ]
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "버팀목…",
      "UnitTalk_JPN": "揺るぎない…支え…",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "우러러보는 사람이 아니라...",
          "JumpAnchorStringId_JPN": "尊敬すべき対象ではなく…"
        }
      ]
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "옆에서 지켜줄 수 있는 사람이 기사 아닐까?",
          "JumpAnchorStringId_JPN": "傍で護ってくれる人こそ騎士なのではないかな？"
        }
      ]
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "육체적으로 쓰러지거나 정신적으로 힘들어도...",
      "UnitTalk_JPN": "肉体が倒れても、精神が疲弊しても、",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "샤를은 바로바로 일어나서 다시 도전해 나간다.",
      "UnitTalk_JPN": "シャルルはすぐに立ち上がり、また挑戦する。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "자주 우는 모습을 보이지만, 그 감정에 오래 얽매이지 않고 금방 환하게 웃는다.",
      "UnitTalk_JPN": "すぐ泣きべそをかくけど、その感情に長く縛られることなく、明るく笑う。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "사람을 진심으로 대하고 자신을 숨기지도 않는다.",
      "UnitTalk_JPN": "誰とでも真摯に向き合い、自分を隠さない。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "어떤 일을 겪은 후에도 언제나 밝은 모습으로 훈련장에 오는 샤를이기에, 기사단장으로 임명된 것이리라.",
      "UnitTalk_JPN": "どんな事があっても、いつも明るい姿で訓練場に来るシャルルだから、騎士団長に任命したはず。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아직은 잘… 모르겠어요.",
      "UnitTalk_JPN": "まだ…良く分かりません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "제가 튼튼해서 뽑혔다는 이야기로 들리는데요…",
      "UnitTalk_JPN": "私が丈夫だから選ばれたとしか聞こえません…",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그 장점이 다른 무엇보다 중요하니까?",
          "JumpAnchorStringId_JPN": "それが何より大事だから？"
        }
      ]
    },
    {
      "Uid": 77,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "으으… 단장님께서 그렇게 얘기하신다면…",
      "UnitTalk_JPN": "うぅ…団長殿がそうおっしゃるのであれば…",
      "TalkTime": 0.03
    },
    {
      "Uid": 78,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "아직 납득은 잘 안 가지만! 그렇다고 생각… 해 보겠습니다…",
      "UnitTalk_JPN": "まだちょっと納得はできませんが！そうだと考える…事にします…",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "숙소로 돌아가는 샤를의 발걸음은 조금 무거워 보였다.",
      "UnitTalk_JPN": "部屋に戻るシャルルの足取りが重そうだった",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 80,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_06",
