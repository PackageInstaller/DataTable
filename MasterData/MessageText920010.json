  "records": [
    {
      "Message": "結界に護られた妖精郷に\n危機が迫る。"
    },
    {
      "Message": "エルフの隠れ里に侵入した\n魔物たちを倒せ！"
    },
    {
      "Message": "逃げ遅れたエルフたちを\n守り抜け！"
    },
    {
      "Message": "ついに始まった魔物の\n侵攻から妖精郷を守れ！"
    },
    {
      "Message": "押し寄せる無数の敵を\n食い止めろ！"
    },
    {
      "Message": "傷つけば傷つくほど\n恨みの力で力を増す\n呪われた戦士を倒せ！"
    },
    {
      "Message": "エルフの里を守る神樹を\n守り抜け！"
    },
    {
      "Message": "ダークエルフの最後の\n攻撃を退けろ！"
    },
    {
      "Message": "再び侵攻してきた\nダークエルフと魔物の大群を\n全力で撃退せよ！"
    }
  ]
}