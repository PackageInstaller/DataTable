    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "모처럼의 휴일을 맞아 느긋하게 공원에서 산책을 즐기던 중. ",
      "UnitTalk_JPN": "休日を迎え、私はのんびりと公園を散歩していた。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "어디선가 맛있는 냄새가 풍겨오고 있었다. ",
      "UnitTalk_JPN": "するとどこかから、美味しそうな香りが漂ってきた。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_1",
      "UnitNameString": [
        "SI_NOBLE_LADYA"
      ],
      "UnitTalk_KOR": "<color=#F7BE45>따뜻한 NOA, 함께 만들어가요</color>!",
      "UnitTalk_JPN": "<color=#F7BE45>温かいNOAを、共に創りあげましょう</color>！",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_1",
      "UnitNameString": [
        "SI_NOBLE_LADYA"
      ],
      "UnitTalk_KOR": "따뜻한 수프 한 그릇 받아 가세요!",
      "UnitTalk_JPN": "温かいスープはいかがですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이건, 무슨 행사인가요?",
          "JumpAnchorStringId_JPN": "何かのイベントですか？"
        }
      ]
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_1",
      "UnitNameString": [
        "SI_NOBLE_LADYA"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "안녕하세요? 이제 제법 날씨가 쌀쌀해지지 않았나요?",
      "UnitTalk_JPN": "こんにちは！最近は、ずいぶんと肌寒くなってきましたよね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_1",
      "UnitNameString": [
        "SI_NOBLE_LADYA"
      ],
      "UnitTalk_KOR": "그래서 시민분들께 따뜻한 수프를 나눠드리는 봉사활동을 하고 있어요. ",
      "UnitTalk_JPN": "そこで、市民の方々に温かいスープをお配りするイベントを行っているんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_1",
      "UnitNameString": [
        "SI_NOBLE_LADYA"
      ],
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "여기가 아무리 살기 좋은 NOA라지만…  ",
      "UnitTalk_JPN": "NOAは暮らしやすい街ですが…  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_1",
      "UnitNameString": [
        "SI_NOBLE_LADYA"
      ],
      "UnitTalk_KOR": "그래도 온기 담긴 끼니 한 번을 챙겨 드시기 힘든 분들은 있으니까요.",
      "UnitTalk_JPN": "温かい食事をすることすら、難しい方もいらっしゃいますから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_1",
      "UnitNameString": [
        "SI_NOBLE_LADYA"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아, 꼭 형편이 어려운 분들만 받을 수 있는 건 아니예요.",
      "UnitTalk_JPN": "あっ！経済的にお困りの方だけにお配りしている訳ではありませんよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_1",
      "UnitNameString": [
        "SI_NOBLE_LADYA"
      ],
      "UnitTalk_KOR": "누구든 따뜻한 수프 한 그릇이면 속도 마음도 든든해지는 법이죠.  ",
      "UnitTalk_JPN": "誰でも温かいスープを飲めば、心も身体も満たされるものですから。  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_1",
      "UnitNameString": [
        "SI_NOBLE_LADYA"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "저쪽에 있는 리디아 양 앞에 줄을 서서 기다려 주시겠어요?",
      "UnitTalk_JPN": "あちらのリディア様の列で、お待ちいただけますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…<color=#F7BE45>리디아 양</color>이요?",
          "JumpAnchorStringId_JPN": "…<color=#F7BE45>リディア様</color>？"
        }
      ]
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그곳에는… ",
      "UnitTalk_JPN": "そこには… ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitPos": "POS3"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "따뜻한 미소를 가득 띄운 리디아가 국자를 들고 있었다. ",
      "UnitTalk_JPN": "お玉を持ち、温かい笑顔を浮かべるリディアがいた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "어서 오세요~!",
      "UnitTalk_JPN": "どうぞ～！",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "따뜻한 수프 한 그릇 하고 가세요~! ",
      "UnitTalk_JPN": "温かいスープはいかがですか～！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_OLDMAN"
      ],
      "UnitTalk_KOR": "아가씨, 괜찮으면 한 그릇만 떠 주겠나…?",
      "UnitTalk_JPN": "お嬢ちゃん、一杯もらってもいいかい？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "어머, 그럼요 할머니! 잠시만 기다리세요… 자, 여기요!",
      "UnitTalk_JPN": "あら、もちろんですよ！さぁ…どうぞ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "날씨도 쌀쌀한데, 몸조심하세요!",
      "UnitTalk_JPN": "肌寒くなってきましたし、お身体に気をつけてくださいね！",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_2",
      "UnitNameString": [
        "SI_NOBLE_LADYB"
      ],
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "FA",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "리디아, 피곤하진 않아요?",
      "UnitTalk_JPN": "リディア、疲れてはいませんか？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "어머, 캐서린 님. 후후, 저는 아직 괜찮은걸요. 걱정해 주셔서 감사합니다! ",
      "UnitTalk_JPN": "あら、キャサリン様。私は大丈夫ですよ。ふふ、お気遣いありがとうございます！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "힘든 분들을 도와드리는 일에 구원자씩이나 되어서 엄살 부릴 수는 없죠.",
      "UnitTalk_JPN": "困っている人をお助けするのが、救援者の務めですから。このくらいで弱音を吐くわけにはいきませんよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_2",
      "UnitNameString": [
        "SI_NOBLE_LADYB"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "리디아는 상냥한 사람이네요. ",
      "UnitTalk_JPN": "リディアは本当に優しいのですね。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_2",
      "UnitNameString": [
        "SI_NOBLE_LADYB"
      ],
      "UnitTalk_KOR": "고향을 위해서도 그렇게 고생하시면서… 더 약한 분들을 위해 힘을 쏟다뇨.",
      "UnitTalk_JPN": "故郷のことだけでも大変でしょうに…お困りの方のために尽力されるとは。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_2",
      "UnitNameString": [
        "SI_NOBLE_LADYB"
      ],
      "UnitTalk_KOR": "부디, 서부에도 좋은 소식 있길 바랄게요. 응원하고 있답니다.",
      "UnitTalk_JPN": "どうか、西部でも良いことが起こりますように。応援していますよ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_2",
      "UnitNameString": [
        "SI_NOBLE_LADYB"
      ],
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아, 혹시 부탁할 게 있다면 언제든지 말해요. 힘닿는 데까지 도울게요.",
      "UnitTalk_JPN": "あっ！もし力になれることがあれば、いつでもおっしゃってくださいね。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "감사합니다, 캐서린 님! ",
      "UnitTalk_JPN": "ありがとうございます、キャサリン様！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_2",
      "UnitNameString": [
        "SI_NOBLE_LADYB"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하, 이젠 그냥 이름만 부르래도요. 이따 또 봐요, 리디아! ",
      "UnitTalk_JPN": "おほほ、様はつけなくてもいいのですよ。では、ごきげんよう！ ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 98,
      "WaitClick": false,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitStrId": "NPC_MODULE_RICH_FEMALE_2",
      "UnitPos": "POS4"
    },
    {
      "Uid": 99,
      "WaitClick": false,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitPos": "POS1"
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "리디아와 봉사 활동이라니, 절대 같이 놓여선 안 될 단어들이 모인 기분이 든다.\r\n",
      "UnitTalk_JPN": "リディアと、ボランティア…考えられない組み合わせだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "…설마.",
      "UnitTalk_JPN": "…まさか。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "지난번에 나의 조언에 감명을 받은 리디아가 마음을 조금 고쳐먹으려는건-",
      "UnitTalk_JPN": "私の言葉に感銘を受けて、変わろうとしているのか？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "엇… 단장님? ",
      "UnitTalk_JPN": "あら…団長さん？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "갑자기 웬 봉사활동이냐구요?",
      "UnitTalk_JPN": "どうしてボランティアをしているのか、ですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "…에에. 단장님께 받은 도움을 나누어 주고 싶어진거냐니… ",
      "UnitTalk_JPN": "…えぇ？団長さんから受けた恩を、他の人に分け与えようとしているのか、ですって…？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "당연히 그럴 리가 없잖아요.",
