      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "먼지나… 작은 돌 같은 걸…",
      "UnitTalk_JPN": "ほこりや…小さな石を…",
      "TalkTime": 0.03
    },
    {
