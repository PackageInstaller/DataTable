      "BgFileName": "ILLUST_BG_STUDY_ROOM.png"
    },
    {
      "Uid": 135,
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "엘리사와 함께 모노리스 교단의 연구실로 향했다.",
      "UnitTalk_JPN": "エリサと共に、モノリス教団の研究室へ向かった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "연구실 탁자 위에 복잡한 기계장치의 잔해가 놓여 있었다.",
      "UnitTalk_JPN": "研究室の机の上には、複雑な機械装置の残骸が置かれていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "굉장해…! 놀라와요…!",
      "UnitTalk_JPN": "すごい…！驚きです…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "역시 이전에 측정된 같은 계층의 유물과는 조금 다른 부분이 있군요…",
      "UnitTalk_JPN": "以前測定された同階層の遺物とは、少し違いますね…",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "이건 새로운 학술적 발견이 될지도 모르겠어요!",
      "UnitTalk_JPN": "これは、新たな学術的発見になるかもしれません！",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "신이 난 엘리사는 내가 알아들을 수 없는 학술적 이론들을 쏟아내기 시작했다.",
      "UnitTalk_JPN": "興奮したエリサは、私が理解できない学術的理論を次々と語り始めた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 31,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "잠시 들어보려 노력했지만, 무슨 말인지 하나도 알 수 없었다…",
      "UnitTalk_JPN": "しばらく努力して聞いてみたが、何一つ理解できなかった…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 33,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "그럼- 이제 이걸 연구하는 건가?",
          "JumpAnchorStringId_JPN": "じゃあ…これからこれを研究するってこと？"
        },
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "어떤 식으로 진행되는 거야?",
          "JumpAnchorStringId_JPN": "研究はどうやって進めるんだ？"
        }
      ]
    },
    {
      "Uid": 34,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "연구에는 여러 단계와 방법이 있지만 우선은…",
      "UnitTalk_JPN": "研究には、様々なステップや方法がありますが、まずは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "이 유물이 멀쩡할 때는 어떤 모습이었을까… 하고 스케치를 해보는 거예요.",
      "UnitTalk_JPN": "この遺物はどんな姿だったのだろう…とスケッチしてみるんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "어떤 물건이었을 것 같아?",
          "JumpAnchorStringId_JPN": "エリサはどんな物だったと思う？"
        }
      ]
    },
    {
      "Uid": 37,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "음…",
