[
  {
    "id": 0,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "レスナ",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 1,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "師匠……！",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 2,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "おめでとう、レスナ。\nあなたは、ついに果ての大陸にたどり着いた",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 3,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "錬金術の復興も進んで……\n師匠として、とても誇らしいわ",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 4,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "師匠……今まで、どこにいたんですか",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 5,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "アトリエに手紙を置いて、私たちをここに呼んだのは\nどうしてですか",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 6,
    "localized_name": "ヴァレリア",
    "romanized_name": "Valeria",
    "model_path_hash": 8455227271865371244,
    "text": "私も、聞きたいことがたくさんあるのよ",
    "voice_file": "",
    "still_path_hash": 6891392099494261238,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 7,
    "localized_name": "ヴァレリア",
    "romanized_name": "Valeria",
    "model_path_hash": 8455227271865371244,
    "text": "あんたもアウグストも初めから\n果ての大陸がどこにあるか知ってたんじゃないの",
    "voice_file": "",
    "still_path_hash": 6891392099494261238,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 8,
    "localized_name": "ヴァレリア",
    "romanized_name": "Valeria",
    "model_path_hash": 8455227271865371244,
    "text": "それなのに、レスナに伝えなかったのはどうして？",
    "voice_file": "",
    "still_path_hash": 6891392099494261238,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 9,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 2668606804942549205,
    "text": "ここに繋がる門を守っていた「案内人」ってやつも、\nパルメ族が用意したものっすよね？",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 10,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 2668606804942549205,
    "text": "……ザスキアさんも師匠も、いったい何が目的なんすか",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 11,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "せっかくの再会なのに余韻に浸らせてもくれないのね。\n今まで姿を消していたのは「観測」のためよ",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 12,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "まぁ、色々と聞かれるだろうことは分かっていたわ。\n私も話そうと思ってあなたたちを呼んだんだもの",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 13,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "……分かりました。\nすべて、聞かせてください",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 14,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "まず、「案内人」だけれど……正解！\nあれは私たちパルメ族が用意したものよ",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 15,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "どうしてですか",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 16,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "あなたたち人類のためよ",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 17,
    "localized_name": "ロマン",
    "romanized_name": "Roman",
    "model_path_hash": 2044084852602675005,
    "text": "人類のため……？",
    "voice_file": "",
    "still_path_hash": 2419706081160656678,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 18,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "ええ。レスナを果ての大陸へ導いたのも、\nすべてはあなたたち人類のためよ",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 19,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "……少し長くなるけれど、聞いてくれるかしら",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  }
]