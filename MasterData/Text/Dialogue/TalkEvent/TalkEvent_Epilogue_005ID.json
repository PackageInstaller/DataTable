[
  {
    "id": 0,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "レスナ……\n本当に、強くなったわね……",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 1,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "はぁ……はぁ……",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 2,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "それでも私は、あなたの幸せを……",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 3,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "っ！",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 4,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "レスナ",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 5,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "ア、アウグストさん……！",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 6,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 2668606804942549205,
    "text": "師匠……！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 7,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "ザスキア、大丈夫か",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 8,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "ええ、平気……",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 9,
    "localized_name": "ヴァレリア",
    "romanized_name": "Valeria",
    "model_path_hash": 8455227271865371244,
    "text": "あんたも、私たちと戦うつもり……？",
    "voice_file": "",
    "still_path_hash": 6891392099494261238,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 10,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "決着は明確に付いた。ならばもういい。\nこれ以上は不毛だ。互いの全面戦争になりかねん",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 11,
    "localized_name": "イザナ",
    "romanized_name": "Izana",
    "model_path_hash": 7061794453237574237,
    "text": "そ、それじゃあ……？",
    "voice_file": "",
    "still_path_hash": 7010833269667927555,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 12,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "――先の戦い、見させてもらった。\nお前たちの固い意志をな",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 13,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "……私たちはなんと言われようと、\nパルメ族の考えを受け入れるつもりはありません",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 14,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "これだけやりとりをした上で、その結論だ。\n何を言っても、お前の意志は変わらんのだろう",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 15,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "レスナたちは、想いの力で私に勝ったわ。\n……もう、私から言えることはないわね",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 16,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "お前たちの意志を尊重しよう。\nこの先の未来、レスナが切り開いていくがいい",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 17,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "……成長したな、レスナ",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 18,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "……師匠、アウグストさん",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 19,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "お二人が、私の生みの親ですか",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 20,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 2668606804942549205,
    "text": "……えっ！？",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 21,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "……お母さんから、私が拾われた時の話は聞きました。\n祭壇に、この子と一緒に赤ん坊が置かれていたって",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 22,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "お二人が、私を遺跡に置いていったんですか……？\n「救世主計画」のために……",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 23,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "……ええ、そうよ。あなたを産んだのも、\n祭壇に置いていったのも、私たちよ",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 24,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "計画には、錬金術に素養のある者が必要だったのだ。\nそしてそれには、パルメ族の血を引く者が最適だった",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 25,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "今の人類の手により、今の人類として育てられた\nパルメ族の子――レスナ、お前のような存在が",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 26,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "古城の石で力を得られたのもパルメ族の関係者だから。\nそして、この目の力も……",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 27,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "我々は物質の構造を理解することに優れている。\nその瞳の力は純血のパルメ族の証だ",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 28,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "かつて、青の星の人類と結ばれたパルメ族もいたが\n彼らの子に、瞳の力は受け継がれなかったからな",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 29,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "もっとも、遠い子孫が覚醒し、\n力を芽吹かせているかもしれないが",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 30,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "でも私は、パルメ族なのに\n錬金術の習得が遅かったと思うのですが",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 31,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "成長速度の違いはパルメ族にもある。早熟、晩成、\n色々な。レスナはやや遅めだった。それだけのことだ",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 32,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 3101416597918110218,
    "text": "……それじゃあ、\nレスナは計画のために生まれた子なの？",
    "voice_file": "",
    "still_path_hash": 5045460652135134961,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 33,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "それは違う。レスナが生まれた後に、\nレスナを「救世主計画」に選んだのだ",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 34,
    "localized_name": "ヴァレリア",
    "romanized_name": "Valeria",
    "model_path_hash": 8455227271865371244,
    "text": "自分たちの都合のために、娘を置いていくなんて……\nレスナのことは考えなかったの？",
    "voice_file": "",
    "still_path_hash": 6891392099494261238,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 35,
    "localized_name": "ロマン",
    "romanized_name": "Roman",
    "model_path_hash": 2044084852602675005,
    "text": "ああ。それに、レスナが錬金術と出会ったのもすべて\nパルメ族がそう仕向けたものだったということだろう？",
    "voice_file": "",
    "still_path_hash": 2419706081160656678,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 36,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "その通りよ。これも今を生きる人々を導くための、\nパルメ族の責務、そう思っていたわ",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 37,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "師匠が仕向けたことだとしても、今の私が、\n私自身の意思で行動していることに違いはありません",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 38,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "フリーゲンで幼いレスナと出会って、レスナが錬金術に\n興味を持ってくれたこと、本当に嬉しかったのよ",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 39,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "それに、友達にも恵まれて、とても幸せそうで――",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 40,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "……こんなこと、\n言い訳にしかならないかもしれないけれど――",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 41,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "あなたを祭壇に置いていったあの日から、私たち\n二人とも、あなたの幸せを願わない日はなかったわ",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 42,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "あなたの育ての親――メーヴェとユリウスに\n託して、本当によかった",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 43,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "師匠……アウグストさん……",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 44,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "レスナが望むなら、これからは母として、\nあなたに接するけれど――",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 45,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "いえ、その必要はありません。\nお二人が私の生みの親だとしても――",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 46,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "私のお母さんは、メーヴェお母さんですし、\nお父さんは、ユリウスお父さんです",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 47,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "私を生んでくれて、幸せを願ってくれて……\nありがとうございました",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 48,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "悪いが、話はまだ終わっていない",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 49,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 2668606804942549205,
    "text": "そりゃそうっすよ、異邦人の皆さんを\n元の世界に戻してもらわないと",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 50,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "それは分かっている。まずは赤のほうき星の件だ。\nレスナ、「箱船計画」を否定したが、どうする気だ？",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 51,
    "localized_name": "アウグスト",
    "romanized_name": "August",
    "model_path_hash": 4783526781539751219,
    "text": "赤のほうき星は、星々を回遊する。\nあの脅威は確実に存在し続け、いつかまたここへ来る",
    "voice_file": "",
    "still_path_hash": 4550481465929894494,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 52,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "本の中に世界を創り避難。異世界への門を開き避難。\n色々考えたわ。二度とあんな悲劇が起きないように……",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 53,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "でもどの方法も、避難させられる人数が\nあまりに少なかった",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 54,
    "localized_name": "ザスキア",
    "romanized_name": "Saskia",
    "model_path_hash": 8393915555796547279,
    "text": "異世界への門は、開くにも、開いておく状態を\n持続するにも、貴重な資源が必要で長くは持たないの",
    "voice_file": "",
    "still_path_hash": 3628130916430439847,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 55,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 3101416597918110218,
    "text": "赤のほうき星……それが私の故郷を襲ったやつの\n仲間なら……私は、この身に代えても戦う",
    "voice_file": "",
    "still_path_hash": 5045460652135134961,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 56,
    "localized_name": "ヴァレリア",
    "romanized_name": "Valeria",
    "model_path_hash": 8455227271865371244,
    "text": "でもさっきの話を聞く限りじゃ、私たち九偉人でも\n退けるのが精一杯だったみたいよね",
    "voice_file": "",
    "still_path_hash": 6891392099494261238,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 57,
    "localized_name": "ロマン",
    "romanized_name": "Roman",
    "model_path_hash": 2044084852602675005,
    "text": "そんなやつらを相手に、星全体を守る方法か……",
    "voice_file": "",
    "still_path_hash": 2419706081160656678,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 58,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "――あの",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 59,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 6823802507187778884,
    "text": "私に、考えがあるのですが……！",
    "voice_file": "",
    "still_path_hash": 2457375212832216718,
    "speech_balloon_type_id": 780292254
  }
]