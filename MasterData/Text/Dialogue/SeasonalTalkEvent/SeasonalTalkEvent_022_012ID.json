[
  {
    "id": 0,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "よし、倒した……！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 1,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "気を付けて。まだ残党がいるかもしれない――",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 2,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "っ！　アルビーナ、後ろ――！！",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 3,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "っ！？",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 4,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "はあっ！！",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 5,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "みんな、無事！？",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 6,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "ヤンネさん！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 7,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "魔物が出たって聞いて、心配したわ……\nみんなケガはなさそうね。よかった",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 8,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "うん。きっと、ヤンネさんの鍛錬のおかげよ",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 9,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "それならよかったわ。あの鍛錬は\nケガ防止のための準備運動も兼ねてるから",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 10,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "でも……どうして避難しなかったの？\n警備隊の指示に従って、彼らに任せれば――",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 11,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "それは……あそこを守りたくって",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 12,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "あそこって……あれはなに？",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 13,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "私たちで用意した、「ヤンネさんおもてなし一式」よ",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 14,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "こういう休暇は初めてって、ヤンネさん言ってたから、\n姉様と一緒に、みんなで用意したの",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 15,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "一緒に休暇を目いっぱい楽しみたくってさ。\n……だから、そのためにもあそこを守りたかったんだ",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 16,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "そうだったの……\n二人とも、ありがとう",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 17,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "せっかくの休暇なのに、私ったら鍛錬とか仕事とか、\nいつも通りのことしちゃってたわね",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 18,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "そうね、明日はあそこでくつろがせてもらおうかしら。\n休暇の過ごし方、私に教えてくれる？",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 19,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "うん！　もちろんっすわ！！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 20,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "姉様と共に、最高の休暇を約束するわ",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 21,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "ヤドヴィガ、さっきは一緒に守ってくれてありがとう。\n明日こそ、本当の休暇の過ごし方を教えてあげる！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 22,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "……それは、ここまでで十分理解できた。\n明日は三人で過ごすといい",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 23,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "誰かのためを想って行動するあなたたちを見て、\n私も……誰かのために何かをしてみたくなった",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 24,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "だから明日は、自分のしたいことをして\n休暇を過ごしてみようと思う",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 25,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "うん、分かった。\nま、お役に立てたなら何よりっすわ",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 26,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "何か困ったことがあったら力を貸すわ。\n今日のお礼よ",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 27,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "承知。感謝する",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 28,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "私からもお礼を言わせてちょうだい",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 29,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "ありがとう。\nよかったら、これからも二人と仲良くしてね",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 30,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "……はい",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  }
]