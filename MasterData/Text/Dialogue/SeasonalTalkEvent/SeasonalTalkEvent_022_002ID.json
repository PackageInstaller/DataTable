[
  {
    "id": 0,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "眩しい空",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 1,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "透き通る海",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 2,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "そして――",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 3,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "超絶かわいいアルビちゃんっ！！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 4,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "さすが姉様。最も美しく眩しいわ。\n今すぐ彫像をこしらえて、後世にこの美を残さないと",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 5,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "もう照れるやい！\nてか、ベップもすごく似合ってるじゃん！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 6,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "姉様が選んでくれた水着だもの。\n完璧に着こなしてみせるわ",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 7,
    "localized_name": "？？？",
    "romanized_name": "???",
    "model_path_hash": 2294695844032883758,
    "text": "あ、いたー！\nアルビーナもベップも、速いよー！",
    "voice_file": "",
    "still_path_hash": 7010833269667927555,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 8,
    "localized_name": "イザナ",
    "romanized_name": "Izana",
    "model_path_hash": 2294695844032883758,
    "text": "もー。到着早々迷子になったら笑えないよ～",
    "voice_file": "",
    "still_path_hash": 7010833269667927555,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 9,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "ごめーん。水着着たら気分上がっちゃった！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 10,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "みんな、待たせてごめんね。\n水着着るの、少し手間取っちゃった",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 11,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "ちょっと恥ずかしいけれど……\nみんなと一緒なら、大丈夫かしら",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 12,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "おお……！　ヤンネさん、すっごく綺麗！！\nうんうん、アタシの水着選びに狂いはなかった！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 13,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 8632999372503809361,
    "text": "ヤンネさん、とっても素敵です！\nイザナちゃんもかわいい！",
    "voice_file": "",
    "still_path_hash": 3591455468400854031,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 14,
    "localized_name": "イザナ",
    "romanized_name": "Izana",
    "model_path_hash": 2294695844032883758,
    "text": "えへへ～！　ありがとう、レスナちゃん！",
    "voice_file": "",
    "still_path_hash": 7010833269667927555,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 15,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "ふふ、みんなの着こなしには負けるわ",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 16,
    "localized_name": "ヴァレリア",
    "romanized_name": "Valeria",
    "model_path_hash": 7203201562534310700,
    "text": "……あれ？　あんたたち、水着は？",
    "voice_file": "",
    "still_path_hash": 491776654605821708,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 17,
    "localized_name": "キューン",
    "romanized_name": "Quinn",
    "model_path_hash": 913274709521753211,
    "text": "うぅ……忘れちゃったぁ……\n水着を着るっていう感覚が今までなかったから……",
    "voice_file": "",
    "still_path_hash": 7374237645965483172,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 18,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "このままでも泳げる。支障はない",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 19,
    "localized_name": "ヨハナ",
    "romanized_name": "Johanna",
    "model_path_hash": 6763523268261092223,
    "text": "馬鹿ね。水着は海で一番動きやすい装備なのよ。\nそんなんじゃ遅れをとるわ",
    "voice_file": "",
    "still_path_hash": 5625633481186064994,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 20,
    "localized_name": "キューン",
    "romanized_name": "Quinn",
    "model_path_hash": 913274709521753211,
    "text": "うーん……？\nかわいいから着るんだと思うけどな……？",
    "voice_file": "",
    "still_path_hash": 7374237645965483172,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 21,
    "localized_name": "観光客Ａ",
    "romanized_name": "",
    "model_path_hash": 0,
    "text": "――なんだか、港に警備員が多くない？",
    "voice_file": "",
    "still_path_hash": 0,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 22,
    "localized_name": "観光客Ｂ",
    "romanized_name": "",
    "model_path_hash": 0,
    "text": "近海にでっかい魔物が出たんだってさ。\nあと、諸島同盟外から偉い人が遊びに来ているとか……",
    "voice_file": "",
    "still_path_hash": 0,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 23,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "…………",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 24,
    "localized_name": "キューン",
    "romanized_name": "Quinn",
    "model_path_hash": 913274709521753211,
    "text": "――姉、ヤド姉。\n私たちも行こ！　みんな向こう行っちゃった",
    "voice_file": "",
    "still_path_hash": 7374237645965483172,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 25,
    "localized_name": "キューン",
    "romanized_name": "Quinn",
    "model_path_hash": 913274709521753211,
    "text": "こんな風に過ごす休暇、初めてだから迷っちゃうね！\nとりあえず甘いものが食べたいなぁ～",
    "voice_file": "",
    "still_path_hash": 7374237645965483172,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 26,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "諾。行こう、キューン",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 27,
    "localized_name": "イザナ・ココシュカ",
    "romanized_name": "Izana Kokoschka",
    "model_path_hash": 0,
    "text": "レスナの幼馴染で、王国騎士団に所属する獣人の少女。\nレスナたちに誘われ、一緒にゼレンタ島へ来た",
    "voice_file": "",
    "still_path_hash": 7010833269667927555,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 28,
    "localized_name": "ヨハナ",
    "romanized_name": "Johanna",
    "model_path_hash": 0,
    "text": "天才を自称する、レスナの友達の少女。\nレスナたちに誘われ、一緒にゼレンタ島へ来た",
    "voice_file": "",
    "still_path_hash": 5625633481186064994,
    "speech_balloon_type_id": 780292254
  }
]