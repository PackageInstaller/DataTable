[
  {
    "id": 0,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "魔物を発見。\n総員、警戒",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 1,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "急に曇ったと思ったら、なんだこいつ！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 2,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "もしかして、私たちの踊りにつられて……？",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 3,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "んなわけあるかい！\n……え？　いや、ないよね！？",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 4,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "近海で巨大な魔物が確認されたという噂を聞いた。\nその魔物と特徴が一致している",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 5,
    "localized_name": "鏑矢",
    "romanized_name": "Kaburaya",
    "model_path_hash": 3738120481696568459,
    "text": "もしかしたらこいつも、行楽を楽しみに\nこの島へ来たのかもしれんぞ",
    "voice_file": "",
    "still_path_hash": 3206719061125087729,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 6,
    "localized_name": "千歳",
    "romanized_name": "Chitose",
    "model_path_hash": 3924733721061764343,
    "text": "そうでしたら、なんだか、かわいいですね",
    "voice_file": "",
    "still_path_hash": 4561510886967726962,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 7,
    "localized_name": "魔物",
    "romanized_name": "",
    "model_path_hash": 0,
    "text": "グアァアアアッ！！",
    "voice_file": "",
    "still_path_hash": 0,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 8,
    "localized_name": "千歳",
    "romanized_name": "Chitose",
    "model_path_hash": 3924733721061764343,
    "text": "きゃあっ！",
    "voice_file": "",
    "still_path_hash": 4561510886967726962,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 9,
    "localized_name": "鏑矢",
    "romanized_name": "Kaburaya",
    "model_path_hash": 3738120481696568459,
    "text": "おのれっ！！　慈悲は与えんぞ！！",
    "voice_file": "",
    "still_path_hash": 3206719061125087729,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 10,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "ベップ、ヤドヴィガ……どうする？",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 11,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "島は魔物を警戒し、多くの警備隊を導入している。\n彼らがいずれここに来て対処すると思われる",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 12,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "あの魔物は、特別危険というわけではない……が、\n広範囲に攻撃してくるため、ここにいるのは危険",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 13,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "そ、そっか。\nじゃあアタシたちはいったん退避すればいいのか",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 14,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "いや、でも……",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 15,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "姉様……？",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 16,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "……ベップ。あいつ、アタシたちで倒そう",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 17,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "…………！",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 18,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "分かった。戦えるわ",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 19,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "なぜ……？　もう間もなく警備隊が来る――",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 20,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "うん、そうなんだけどさ。\nここには守りたいものがあるから",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 21,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "ヤンネさんのために用意したこの場所を守りたい。\nあいつに壊されてたまるか",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 22,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "アタシたちみんなで、絶対に絶対に\n最高の休暇を過ごしてやるんだーっ！！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 23,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "姉様とヤンネさんの笑顔のため、\n邪魔はさせない……！！",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 24,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "…………",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 25,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "……私が交戦する必要はない",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 26,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "でも――",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 27,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "加勢する",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 28,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "ヤド……！　助かるわ",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 29,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "この場所を守るため、一緒に戦おう！！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  }
]