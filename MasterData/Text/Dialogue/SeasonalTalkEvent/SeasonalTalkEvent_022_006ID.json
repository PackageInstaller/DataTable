[
  {
    "id": 0,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "休暇の楽しみ方、アタシが案内してあげる！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 1,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "それは……",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 2,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "うん、いいじゃないか。\n行っておいでよ、ヤドヴィガ",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 3,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "あれ、イェルカ。どうしてここに？",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 4,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "ヴァレリアから話を聞いてね。\n残りの兄弟も連れて遊びにきたんだ",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 5,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "イェルカ姉上。\nすみません、すぐ合流します",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 6,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "はは、大丈夫だよ。兄弟だからって、何も絶対一緒に\nいなきゃいけないって決まりはないだろう？",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 7,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "せっかく誘ってもらったんだ。星の案内人である\nアルビーの案内、満喫してくるといいよ",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 8,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "……姉上が、そう言うなら",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 9,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "二人とも、ちょっといいかい",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 10,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "ヤドヴィガに声をかけてくれてありがとね。\nよかったら、この後もあの子を気にかけてやってよ",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 11,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "あの子はこれまで、アタシたち兄弟以外と\n関わる機会がほとんどなかったんだ",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 12,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "だからか友達と呼べる存在もいなくてね……\n姉としては、少し心配というか",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 13,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "私たちも、友達と呼べる関係かどうか微妙なとこだけど",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 14,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "仲良くなれるならアタシたちも嬉しいっすわ",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 15,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "それにせっかくの休暇、楽しみ方を知らないなんて\nもったいない！　ヤドヴィガも、ヤンネさんも！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 16,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "ヤドヴィガ！　一緒に行こう！\nまずは釣りで、ごちそうのための大物を釣り上げるよ！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 17,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "承知。\n釣りの腕は、リーベ姉上にほめられたことがある",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 18,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "私の腕も姉様お墨付きよ。負けないわ",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 19,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "よし、それじゃあ、そこで並んでやろう！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 20,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "ヤドヴィガ、行ってらっしゃい。\n楽しんでおいで",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 21,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "……行ってきます",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 22,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 0,
    "text": "ヴァレリアの姉で、９人兄弟の３番目。\n「粋」を信条とする、いなせな風来坊",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  }
]