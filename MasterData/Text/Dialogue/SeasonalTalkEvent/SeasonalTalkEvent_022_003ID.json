[
  {
    "id": 0,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "みんなー、いっくよー！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 1,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "そーれっ！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 2,
    "localized_name": "イザナ",
    "romanized_name": "Izana",
    "model_path_hash": 2294695844032883758,
    "text": "よっと！",
    "voice_file": "",
    "still_path_hash": 7010833269667927555,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 3,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 8632999372503809361,
    "text": "ヨハナちゃん！　お願い！",
    "voice_file": "",
    "still_path_hash": 3591455468400854031,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 4,
    "localized_name": "ヨハナ",
    "romanized_name": "Johanna",
    "model_path_hash": 6763523268261092223,
    "text": "ふふん、任せなさい！",
    "voice_file": "",
    "still_path_hash": 5625633481186064994,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 5,
    "localized_name": "ヨハナ",
    "romanized_name": "Johanna",
    "model_path_hash": 6763523268261092223,
    "text": "やーっ！！",
    "voice_file": "",
    "still_path_hash": 5625633481186064994,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 6,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "っと。ベップちゃん！",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 7,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "いくわ！！",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 8,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "たあーっ！！",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 9,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "よっしゃあ！　いい感じ！！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 10,
    "localized_name": "ヨハナ",
    "romanized_name": "Johanna",
    "model_path_hash": 6763523268261092223,
    "text": "くーっ！！　もう１回よ！！",
    "voice_file": "",
    "still_path_hash": 5625633481186064994,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 11,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "はーっ！　楽しい～！！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 12,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 8632999372503809361,
    "text": "たくさん遊んだね。\nふふ、結構疲れちゃったかも",
    "voice_file": "",
    "still_path_hash": 3591455468400854031,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 13,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "アタシも～。でも、まだまだ遊ぶんだから！\nね、ベップ！　ヤンネさん！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 14,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "あれ？　ヤンネさんは？",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 15,
    "localized_name": "子ども",
    "romanized_name": "",
    "model_path_hash": 0,
    "text": "うわーん！　お母さん、どこー！",
    "voice_file": "",
    "still_path_hash": 0,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 16,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "君、一人？　……お母さんがいなくなっちゃったの？\n……うん、それじゃあ一緒に探しましょうか",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 17,
    "localized_name": "ベップ",
    "romanized_name": "Bepp",
    "model_path_hash": 2719129412126717307,
    "text": "ヤンネさんなら、さっきからああやって\n迷子の子とか沖に流されそうな子を助けてあげてるわ",
    "voice_file": "",
    "still_path_hash": 4522117749578412567,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 18,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "さすがヤンネさん……周りをよく見てるんだなぁ。\nもう根っこから聖戦士",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 19,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "でもせっかくの休暇だし、そういうのは\n係の人に任せてもいいのに",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 20,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "そうなんだけど……癖になってるのよね。\nそれに、ただ休暇を楽しむのはそわそわしちゃって――",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 21,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "って、やだ、今日の鍛錬がまだだったわ。\nもう時間は遅いけど……日課は欠かさずやらなくちゃ",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 22,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 8632999372503809361,
    "text": "今から鍛錬ですか？\nたくさん遊んで、へとへとじゃ……",
    "voice_file": "",
    "still_path_hash": 3591455468400854031,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 23,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "ふふ、あれくらい大したことないわ。\nそれに、運動後の柔軟は身体にいいのよ",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 24,
    "localized_name": "ヤンネ",
    "romanized_name": "Janne",
    "model_path_hash": 2318022885960174855,
    "text": "せっかくだし、みんなでやりましょっか。\nイザナさんたちも呼んでくるわね",
    "voice_file": "",
    "still_path_hash": 3552163027021623318,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 25,
    "localized_name": "レスナ",
    "romanized_name": "Resna",
    "model_path_hash": 8632999372503809361,
    "text": "聖戦士の鍛錬、どんなことするんだろう……\n私にもできるかな？",
    "voice_file": "",
    "still_path_hash": 3591455468400854031,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 26,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "レスナ……覚悟したほうがいい",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 27,
    "localized_name": "アルビーナ",
    "romanized_name": "Alvina",
    "model_path_hash": 8589968507503775476,
    "text": "ヤンネさんの鍛錬は「ガチ」だから……！",
    "voice_file": "",
    "still_path_hash": 8874763601186801212,
    "speech_balloon_type_id": 780292254
  }
]