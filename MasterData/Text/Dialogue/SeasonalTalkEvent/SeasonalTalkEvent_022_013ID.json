[
  {
    "id": 0,
    "localized_name": "（システム）",
    "romanized_name": "",
    "model_path_hash": 0,
    "text": "翌日――",
    "voice_file": "",
    "still_path_hash": 0,
    "speech_balloon_type_id": 965274698
  },
  {
    "id": 1,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "ヤドヴィガ！　こんなにたくさんの魚……\nいったいどうしたんだい？",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 2,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "釣ってきました",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 3,
    "localized_name": "シトリン",
    "romanized_name": "Citrine",
    "model_path_hash": 6017129171503572683,
    "text": "あれ、誰かヤドヴィガに命令したの？",
    "voice_file": "",
    "still_path_hash": 924100309011770274,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 4,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "否……私の独断。\nみんなに、喜んでもらえるかと思って",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 5,
    "localized_name": "シトリン",
    "romanized_name": "Citrine",
    "model_path_hash": 6017129171503572683,
    "text": "え！？　あのヤドヴィガが自分で！？",
    "voice_file": "",
    "still_path_hash": 924100309011770274,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 6,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "そうかいそうかい……それは粋だねぇ！\nありがとう、今夜はこれでごちそうだ！",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 7,
    "localized_name": "ヴァレリア",
    "romanized_name": "Valeria",
    "model_path_hash": 7203201562534310700,
    "text": "やったわ！　ふふ、休暇って最高ね！",
    "voice_file": "",
    "still_path_hash": 491776654605821708,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 8,
    "localized_name": "キューン",
    "romanized_name": "Quinn",
    "model_path_hash": 913274709521753211,
    "text": "ヤド姉、これ全部一人で釣ったの……？\n兄弟全員分だからかな、ほんとにすごい量……",
    "voice_file": "",
    "still_path_hash": 7374237645965483172,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 9,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "キューンには肉と果物も用意した。\n骨がある魚は得意ではなかったと思って",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 10,
    "localized_name": "キューン",
    "romanized_name": "Quinn",
    "model_path_hash": 913274709521753211,
    "text": "えっ！　ヤド姉、ありがとう……！！",
    "voice_file": "",
    "still_path_hash": 7374237645965483172,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 11,
    "localized_name": "シトリン",
    "romanized_name": "Citrine",
    "model_path_hash": 6017129171503572683,
    "text": "ちょっと。キューンが末っ子だからって\n甘やかしすぎないでよね",
    "voice_file": "",
    "still_path_hash": 924100309011770274,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 12,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "ヤドヴィガの成長になると思って、\nアルビーたちに同行させたけれど――",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 13,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "まさか、こんなにも影響があるとはね。\nはは、いい誤算だったよ",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 14,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "ヤドヴィガ、アルビーたちとは仲良くなれたかい？",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 15,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "恐らくは……",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 16,
    "localized_name": "イェルカ",
    "romanized_name": "Jelka",
    "model_path_hash": 7989768780593008340,
    "text": "あの子らは明日もまだいるんだろう？\nもっと一緒に遊んでみるといいさ",
    "voice_file": "",
    "still_path_hash": 8715905000688515801,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 17,
    "localized_name": "ヤドヴィガ",
    "romanized_name": "Jadwiga",
    "model_path_hash": 2111970354351478659,
    "text": "……はい。きっと、一緒に",
    "voice_file": "",
    "still_path_hash": 6170794110252514656,
    "speech_balloon_type_id": 780292254
  },
  {
    "id": 18,
    "localized_name": "シトリン",
    "romanized_name": "Citrine",
    "model_path_hash": 0,
    "text": "ヴァレリアの兄姉で、９人兄弟の４番目。\n飄々とした性格で、要領よく立ち回る",
    "voice_file": "",
    "still_path_hash": 924100309011770274,
    "speech_balloon_type_id": 780292254
  }
]