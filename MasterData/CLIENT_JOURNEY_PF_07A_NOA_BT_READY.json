      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "흥, 역시. 저 도마뱀을 믿는 게 아니었어.",
      "UnitTalk_JPN": "ふん、やっぱりね。トカゲの言うことなんて信じるんじゃなかった。",
      "TalkTime": 0.03
    },
