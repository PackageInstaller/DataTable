      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그리고 벨님.",
