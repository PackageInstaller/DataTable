        }
      ]
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_SAINTESS_DEMON_10",
      "WaitClick": true,
      "WaitTime": 0.0,
