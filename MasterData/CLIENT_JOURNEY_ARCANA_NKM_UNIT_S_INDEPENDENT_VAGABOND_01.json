    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "후우…! 배부르군.",
      "UnitTalk_JPN": "ふう…！お腹いっぱいだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitTalk_KOR": "이 음식이 뭐라고 그랬지?",
      "UnitTalk_JPN": "この料理は何と言った？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! <color=#F7BE45>팜팜</color>이요. 저희 마을의 비법으로 만든 특별한 야채 절임이죠.",
      "UnitTalk_JPN": "あはは！<color=#F7BE45>パムパム</color>ですよ。うちの村の秘伝で作った特別な野菜漬けです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "그런데… 어쩐 일로 여기 쓰러져 계셨나요?",
      "UnitTalk_JPN": "ところで…どうしてここに倒れていらっしゃったんですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "하하하! 수행을 하느라 말이지.",
      "UnitTalk_JPN": "ははは！修行をしていたのでな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitTalk_KOR": "시간 가는 줄도 모르고 몇 날 며칠을 명상했거든.",
      "UnitTalk_JPN": "時間の経つのも忘れて何日も何日も瞑想していたんだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitTalk_KOR": "눈을 떴을 때는 손가락 하나 움직일 힘도 남아있지 않았지…",
      "UnitTalk_JPN": "目を開けた時には指一本動かす力も残っていなかったぞ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아무튼 그대는 내 생명의 은인이다.",
      "UnitTalk_JPN": "とにかくお主は妾の命の恩人だ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "도움이 필요한 일이 있나? 뭐든 말해도 좋다.",
      "UnitTalk_JPN": "何か助けが必要なことは無いか？何でもいいぞ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "나, 페이. 은혜와 원한은 평생이 걸려도 반드시 갚으니까!",
      "UnitTalk_JPN": "妾、フェイ。恩義も恨みも、一生かかっても必ず返すたちでな！",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 괜찮아요. 저는 사람들의 웃는 모습을 좋아하거든요.",
      "UnitTalk_JPN": "あはは！大丈夫ですよ。私は人の笑顔を見るのが好きなんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "맛있게 드시는 모습만으로도 충분히 보답 됐어요.",
      "UnitTalk_JPN": "美味しく召し上がっている姿だけで十分お返しになりました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "…훗.",
      "UnitTalk_JPN": "…ふっ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "하하, 하하하하하!",
      "UnitTalk_JPN": "はは、ははははは！",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "어라? 제가 혹시 말실수라도 했나요?",
      "UnitTalk_JPN": "あれ？私が何か言い間違えたかな？",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitTalk_KOR": "하하하! 아니, 아니다!",
      "UnitTalk_JPN": "ははは！いや、違う！",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아는 사람이 떠올라서 그랬다.",
      "UnitTalk_JPN": "知り合いを思い出したからだよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitTalk_KOR": "다른 사람이 기뻐하는 모습을 보면 본인이 더 기뻐하던 사매가 있었거든.",
      "UnitTalk_JPN": "他人が喜ぶ姿を見ると、本人がもっと喜んでいた妹弟子がいたんだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitTalk_KOR": "그대와 닮았지.",
      "UnitTalk_JPN": "お主と似ておる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "괭이를 가져온 걸 보니 밭을 만들려고 그러나?",
      "UnitTalk_JPN": "クワを持ってる様子からすると、畑を作ろうとしておったのか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INDEPENDENT_VAGABOND_01",
      "WaitClick": true,
      "WaitTime": 0.0,
