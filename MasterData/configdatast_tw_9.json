  {
    "ID": 26202,
    "Value": "使用的『兵刃淬火材料』會被浪費！"
  },
  {
    "ID": 26207,
    "Value": "阿良、依依，我們走！"
  },
  {
    "ID": 26208,
    "Value": "阿良、依依！切記我等第一要務乃是保護百姓！"
  },
  {
    "ID": 26209,
    "Value": "<size=70>啊啊啊啊——！！！</size>"
  },
  {
    "ID": 26212,
    "Value": "爾等來此，怕是觀幻預見之事，當真發生了？那我時輪宮，怕也應在劫數中了吧？"
  },
  {
    "ID": 26221,
    "Value": "煞就要釋放法術了！千萬注意躲避！\\n<color=#e4462c>不要停留在預警區域內</color>！"
  },
  {
    "ID": 26222,
    "Value": "呼……怕是又有什麼詭事發生了。"
  },
  {
    "ID": 26224,
    "Value": "阿良，你……一會兒若『不動尊者』問起你的這印記，你切莫提——"
  },
  {
    "ID": 26225,
    "Value": "不動尊者應該就在這瀑布上面吧？我們這就上去吧。"
  },
  {
    "ID": 26226,
    "Value": "阿良！切莫提你手臂上的印記此番會有異象！"
  },
  {
    "ID": 26242,
    "Value": "江湖後搖落，亦恐歲蹉跎。"
  },
  {
    "ID": 26243,
    "Value": "今來古往，物是人非；天地裡，唯有江山不老。"
  },
  {
    "ID": 26244,
    "Value": "時輪流轉——"
  },
  {
    "ID": 26245,
    "Value": "真正的旅途才剛剛開始！"
  },
  {
    "ID": 26246,
    "Value": "咩，看你這兒的『時之印』不錯，不如——"
  },
  {
    "ID": 26247,
    "Value": "哎，等等，我這兒正好有枚『時之印』，就當是給你們的謝禮了！"
  },
  {
    "ID": 26266,
    "Value": "古法陣就在那處了！"
  },
  {
    "ID": 26268,
    "Value": "嗯？看來，又有人來送死了……\\n正好，再過半刻鐘異變發生，藥人都不用找了。"
  },
  {
    "ID": 26269,
    "Value": "你們倆到底算哪邊的人啊喂！？"
  },
  {
    "ID": 26270,
    "Value": "今日相逢有緣，不如，就讓我們煉藥人吧。"
  },
  {
    "ID": 26272,
    "Value": "你們兩人到底是什麼打算！？藏頭露尾——"
  },
  {
    "ID": 26273,
    "Value": "虞兮？你來得可正好！我們小宮主遠行未歸，我也不知道該怎麼辦……"
  },
  {
    "ID": 26274,
    "Value": "此處山壁懸棺突生異變，出來好些屍鬼，污染了這兒的法陣，你們既是路過此處，還請順道護送我前往查探。"
  },
  {
    "ID": 26276,
    "Value": "金兵斥候偽裝成鏢局人，深入我關隘內，請務必助我截下他們！"
  },
  {
    "ID": 26277,
    "Value": "哎喲喂！各位爺，你們倒給評評理！我們這可說故事抵酒錢，但這一點紅忒不講理了，給說了個怪裡怪氣的古墓故事就想不給錢！"
  },
  {
    "ID": 26278,
    "Value": "求求各位替我討要酒錢啊！"
  },
  {
    "ID": 26279,
    "Value": "呵呵，這能讓你拿到江湖市坊用的江湖重寶，那兒的供貨可不受朝廷限制。"
  },
  {
    "ID": 26283,
    "Value": "呼……總算走了！對了，多謝兩位俠士，在下尉遲良，敢問二位——"
  },
  {
    "ID": 26286,
    "Value": "呵，是嗎？\\n我早該料到的，我既能回來，別人自然也能，只是沒想到啊，居然和時輪有關……"
  },
  {
    "ID": 26287,
    "Value": "奇怪，怎麼會這樣呢？通常殺死一隻夜魑，剩餘的便會四散而逃……"
  },
  {
    "ID": 26288,
    "Value": "夜魑被我們殺死前，似往這處看過。\\n是我們闖入了夜魑撫養幼崽的巢穴……"
  },
  {
    "ID": 26302,
    "Value": "不會有問題的……兵主之靈當會庇護他的子民！\\n你們快到依依身邊來，讓依依保護你們吧！"
  },
  {
    "ID": 26303,
    "Value": "哦？你們不是來瞧那天降異火的？看來你們都不曉得這三天內傳遍江湖南北的事兒啊？"
  },
  {
    "ID": 26305,
    "Value": "這前幾日啊，聽聞天降異火，正落在川北<color=#6cf1d0>『浣花劍派』</color>的地界，好多江湖人都趕去瞧熱鬧了！"
  },
  {
    "ID": 26307,
    "Value": "我們……正有事要去浣花劍派，只是對此處道路不熟，若是方便還得有勞殷公子帶路。"
  },
  {
    "ID": 26309,
    "Value": "聖女啊，羅睺創造了你，不是用造人偶的辦法，這叫你有了長大這一過程。\\n嘖，真不知是不是失策……"
  },
  {
    "ID": 26310,
    "Value": "虞兮，那黑衣人闖入禁地，搶走的『刻盤』到底有什麼作用？她說……物歸原主？"
  },
  {
    "ID": 26311,
    "Value": "那些人的話哪裡可信，怎能當真？！"
  },
  {
    "ID": 26312,
    "Value": "那……她還似乎提了一句，說什麼時輪宮是為了什麼緣故，才把刻盤藏在時輪儀軌裡面？他們這些人又是誰？"
  },
  {
    "ID": 26313,
    "Value": "我知道的也不多。\\n反正星晷刻盤事關天下萬千性命，一旦……反正，他們搶奪刻盤，定然不懷好意。"
  },
  {
    "ID": 26314,
    "Value": "欸！？但黑衣人說，星晷刻盤是他們的聖物，那怎麼會出現在時輪宮？時輪宮……其實也是因為這東西，才有了禁地？"
  },
  {
    "ID": 26316,
    "Value": "……我睡不著，你快去休息，我來守夜就好，免得夜間生出變故——"
  },
  {
    "ID": 26317,
    "Value": "你是在想觀幻尊者？"
  },
  {
    "ID": 26321,
    "Value": "再說，生者為過客，死者為歸人。何況，時輪宮還有繼魂轉世之法，他，終究還是會回到人世間的。"
  },
  {
    "ID": 26324,
    "Value": "？*？"
  },
  {
    "ID": 26325,
    "Value": "不動尊者繼魂出了問題……\\n哎？這事兒似乎從沒發生過……"
  },
  {
    "ID": 26326,
    "Value": "虞兮……你要是有事兒就和我說。\\n我還是以前的那個阿良——你說什麼都無妨，我不會告訴別人的。"
  },
  {
    "ID": 26329,
    "Value": "啊！你喚我？這樣吧，吾將先去蘭州探查，也好知曉<color=#e4462c>『羅睺眷族』</color>為何能離開幽界到得此處，若是……"
  },
  {
    "ID": 26330,
    "Value": "哎，暫且罷了，你們且去追蹤那些搶奪刻盤的面具客們吧，吾，會在蘭州等你們。"
  },
  {
    "ID": 26331,
    "Value": "哎哎！總算找到你們了！\\n你們跑得倒快……可憐我一個人啊——"
  },
  {
    "ID": 26342,
    "Value": "合理運用屬性相剋是制勝的關鍵。"
  },
  {
    "ID": 26344,
    "Value": "戰場中存在各類機關和地形，合理運用。"
  },
  {
    "ID": 26345,
    "Value": "成功達成條件，觸發“連擊”，“追擊”，“先攻”，“閃避”，會使戰鬥更為有利。"
  },
  {
    "ID": 26346,
    "Value": "遠端單位在臨近格普通攻擊近戰單位時，會被近戰單位發動“先攻”。所以需要儘量保持距離。"
  },
  {
    "ID": 26347,
    "Value": "自身攻擊增加30%"
  },
  {
    "ID": 26348,
    "Value": "敵方攻擊降低25%"
  },
  {
    "ID": 26351,
    "Value": "赤淵"
  },
  {
    "ID": 26353,
    "Value": "浣花門人"
  },
  {
    "ID": 26355,
    "Value": "營地中"
  },
  {
    "ID": 26356,
    "Value": "收割"
  },
  {
    "ID": 26364,
    "Value": "擁有護衛能力的英靈，能夠保護身邊的隊友！"
  },
  {
    "ID": 26365,
    "Value": "主線"
  },
  {
    "ID": 26368,
    "Value": "咳！咳咳——沒所求的人不拜佛。但有了所求，拜的，便是魔。"
  },
  {
    "ID": 26374,
    "Value": "紫雲大師兄"
  },
  {
    "ID": 26375,
    "Value": "豪俠小頭目"
  },
  {
    "ID": 26376,
    "Value": "碎石塊"
  },
  {
    "ID": 26377,
    "Value": "碎冰塊"
  },
  {
    "ID": 26380,
    "Value": "巨大的石塊，無法通過。"
  },
  {
    "ID": 26381,
    "Value": "巨大的冰塊，無法通過。"
  },
  {
    "ID": 26387,
    "Value": "阿良，你拿這刻盤碎片時……可千萬要當心！"
  },
  {
    "ID": 26388,
    "Value": "劫鏢的就是那夥兒人？\\n啊！找到那帶了貨的傢伙了！這下他可跑不掉了！"
  },
  {
    "ID": 26389,
    "Value": "媽的，荒山野嶺，居然被那押鏢的找到幫手了！就娘的不該留活口！"
  },
  {
    "ID": 26391,
    "Value": "主上，九陰回來了，九陰發現了蝕之源的——"
  },
  {
    "ID": 26393,
    "Value": "唔……主上，那些法陣是上古之物，九陰未找到起源，但……九陰發現蝕之源需地脈靈氣才能凝出。"
  },
  {
    "ID": 26396,
    "Value": "讓吾來看看你的印記……唔，你居然掌握了時輪的力量？看來，也就你才能去探查過往的歷史了……"
  },
  {
    "ID": 26397,
    "Value": "通過這印記，<color=#e4462c>時輪</color>會將你帶入<color=#e4462c>蝕之隙</color>中，那裡藏著過去的時光。"
  },
  {
    "ID": 26398,
    "Value": "你且好好去過去中尋找吧，<color=#e4462c>刻盤的秘密</color>……應當也在其中。"
  },
  {
    "ID": 26399,
    "Value": "蘭州嗎？這個地方啊……\\n不動尊者忘了這些藏在歲月中的細枝末節，是因<color=#e4462c>繼魂秘法</color>出了意外……"
  },
  {
    "ID": 26400,
    "Value": "但吾當年，到底又忽略了什麼呢？\\n那傢伙啊，到底把那種力量藏到哪裡去了呢？"
  },
  {
    "ID": 26403,
    "Value": "聲望不足，無法購買"
  },
  {
    "ID": 26405,
    "Value": "真、真的成功了。"
  },
  {
    "ID": 26406,
    "Value": "大人……蝕之源似乎氣力用盡了……"
  },
  {
    "ID": 26407,
    "Value": "咦！？紙鳶、紙鳶怎麼燒掉了？"
  },
  {
    "ID": 26410,
    "Value": "嗯？什麼、什麼怎麼了？啊——好、好困……"
  },
  {
    "ID": 26415,
    "Value": "少跟這娘們兒囉唆，這地方邪門得緊，我可不想在這裡待太久。咱們趕快動手吧！"
  },
  {
    "ID": 26416,
    "Value": "合成材料不足"
  },
  {
    "ID": 26417,
    "Value": "<size=65>轟——轟——</size>"
  },
  {
    "ID": 26419,
    "Value": "需地脈靈氣嘛……呵，有意思……\\n三岩法陣之變，或許還真的和『蝕』這『幽垠』化物，有些關係啊……"
  },
  {
    "ID": 26421,
    "Value": "奇怪，虞兮好像很留意這個依依姑娘……"
  },
  {
    "ID": 26424,
    "Value": "黑龍解臾"
  },
  {
    "ID": 26432,
    "Value": "你是那個人嗎？"
  },
  {
    "ID": 26433,
    "Value": "小子，這天下可還是我大宋的天下？"
  },
  {
    "ID": 26434,
    "Value": "你好呀，我叫慕容璇璣。"
  },
  {
    "ID": 26435,
    "Value": "小妹妹，怎用這副表情看著姐姐。"
  },
  {
    "ID": 26436,
    "Value": "喂"
  },
  {
    "ID": 26437,
    "Value": "小友找我可是有意……"
  },
  {
    "ID": 26438,
    "Value": "你等小輩如此怠慢於我，可知吾乃何人？！"
  },
  {
    "ID": 26439,
    "Value": "完了完了完了完了完了！"
  },
  {
    "ID": 26440,
    "Value": "一枝紅豔露凝香，雲雨巫山枉斷腸……"
  },
  {
    "ID": 26441,
    "Value": "因果劫業果真還是無法抗拒的糾葛在了一起。"
  },
  {
    "ID": 26442,
    "Value": "你為何要將我喚醒？！"
  },
  {
    "ID": 26443,
    "Value": "你總看我幹什麼？是不是惦記我的聖槍？"
  },
  {
    "ID": 26444,
    "Value": "嘿嘿，多謝小友將老夫召回人間。"
  },
  {
    "ID": 26445,
    "Value": "你是誰？你要做什麼？"
  },
  {
    "ID": 26446,
    "Value": "謝謝你們！"
  },
  {
    "ID": 26447,
    "Value": "小弟弟，靠的近點兒，姐姐教你些有趣的事情。"
  },
  {
    "ID": 26448,
    "Value": "你聽說過河州鎮嗎？"
  },
  {
    "ID": 26449,
    "Value": "初識殷劍平"
  },
  {
    "ID": 26450,
    "Value": "初識冰璃"
  },
  {
    "ID": 26451,
    "Value": "初識上官遠"
  },
  {
    "ID": 26452,
    "Value": "初識慕容璇璣"
  },
  {
    "ID": 26453,
    "Value": "初識封鈴笙"
  },
  {
    "ID": 26454,
    "Value": "初識阿爾泰巴"
  },
  {
    "ID": 26455,
    "Value": "初識赫蘭鐵罕"
  },
  {
    "ID": 26456,
    "Value": "初識慕容箏"
  },
  {
    "ID": 26457,
    "Value": "初識青蘿"
  },
  {
    "ID": 26458,
    "Value": "初識紫蘊"
  },
  {
    "ID": 26459,
    "Value": "初識葛雲衣"
  },
  {
    "ID": 26460,
    "Value": "初識皇甫申"
  },
  {
    "ID": 26461,
    "Value": "初識古倫德"
  },
  {
    "ID": 26462,
    "Value": "初識常逸風"
  },
  {
    "ID": 26463,
    "Value": "初識李盈鳳"
  },
  {
    "ID": 26464,
    "Value": "初識楊雲佐"
  },
  {
    "ID": 26466,
    "Value": "初識韓無砂"
  },
  {
    "ID": 26467,
    "Value": "初識夏侯儀"
  },
  {
    "ID": 26468,
    "Value": "這……晚輩未曾聽過。"
  },
  {
    "ID": 26469,
    "Value": "唔，那倒有些可惜，那可是這世上最美的地方。"
  },
  {
    "ID": 26470,
    "Value": "我每晚都在夢中夢見，但可惜，再也回不去了。"
  },
  {
    "ID": 26471,
    "Value": "前輩……"
  },
  {
    "ID": 26472,
    "Value": "我記得，我曾說要守護在一人身前，將他的敵人盡數屠滅於劍下。"
  },
  {
    "ID": 26473,
    "Value": "可我卻忘了，那人是誰。"
  },
  {
    "ID": 26474,
    "Value": "你，是那個人嗎？"
  },
  {
    "ID": 26475,
    "Value": "這……是，卻也不是。"
  },
  {
    "ID": 26476,
    "Value": "哪來的吞吞吐吐，說清楚些！"
  },
  {
    "ID": 26477,
    "Value": "仍延大宋國祚，但卻丟了半壁江山。"
  },
  {
    "ID": 26478,
    "Value": "娘的！八十萬禁軍連個汴京都守不住！一群廢物！"
  },
  {
    "ID": 26479,
    "Value": "前輩！前輩你別激動呀！"
  },
  {
    "ID": 26480,
    "Value": "晚輩，尉遲良。"
  },
  {
    "ID": 26481,
    "Value": "什麼前輩晚輩的？叫我慕容璇璣！"
  },
  {
    "ID": 26482,
    "Value": "如果……你是覺得這名字太拗口，叫我木木也行！"
  },
  {
    "ID": 26483,
    "Value": "好吧，前……"
  },
  {
    "ID": 26484,
    "Value": "好的，木木。"
  },
  {
    "ID": 26485,
    "Value": "虞兮冒犯了。"
  },
  {
    "ID": 26486,
    "Value": "呵呵，你不說我也明白，那眼神我前世總是見得。"
  },
  {
    "ID": 26488,
    "Value": "只是你們這些人都不明白一個道理。"
  },
  {
    "ID": 26489,
    "Value": "即是心甘情願，又何來錯付終生？"
  },
  {
    "ID": 26490,
    "Value": "前輩叫我？"
  },
  {
    "ID": 26491,
    "Value": "是你把我召回人世？"
  },
  {
    "ID": 26492,
    "Value": "……是的"
  },
  {
    "ID": 26494,
    "Value": "有意？有什麼意？"
  },
  {
    "ID": 26495,
    "Value": "我與那白毛小子說，只要放我自由，我便予他無盡榮華富貴。"
  },
  {
    "ID": 26496,
    "Value": "他不甘願，那你可甘願？"
  },
  {
    "ID": 26497,
    "Value": "唔……聽起來就不太靠譜……"
  },
  {
    "ID": 26498,
    "Value": "我赫蘭鐵罕金口玉言！童叟無欺！"
  },
  {
    "ID": 26499,
    "Value": "唔……我不信。"
  },
  {
    "ID": 26500,
    "Value": "神武觀主！"
  },
  {
    "ID": 26501,
    "Value": "江湖盟主！"
  },
  {
    "ID": 26502,
    "Value": "惹人厭煩的傢伙！"
  },
  {
    "ID": 26503,
    "Value": "你……你……你們！"
  },
  {
    "ID": 26504,
    "Value": "前輩您怎麼了？"
  },
  {
    "ID": 26505,
    "Value": "我找不到小宮主贈我的香包了！"
  },
  {
    "ID": 26506,
    "Value": "誒！對了！白頭髮！你不是會法術嗎？"
  },
  {
    "ID": 26508,
    "Value": "這……晚輩無能為力。"
  },
  {
    "ID": 26509,
    "Value": "前輩此言何意？"
  },
  {
    "ID": 26510,
    "Value": "沒什麼特殊的涵義，只是想起了一位故人。"
  },
  {
    "ID": 26511,
    "Value": "一個和你一樣被宿命糾纏著的可憐人。"
  },
  {
    "ID": 26512,
    "Value": "唉……希望這次能有所不同吧。"
  },
  {
    "ID": 26513,
    "Value": "在這污濁人世停留的每一刻都讓我感到噁心！"
  },
  {
    "ID": 26514,
    "Value": "前輩，我——"
  },
  {
    "ID": 26515,
    "Value": "你？！"
  },
  {
    "ID": 26516,
    "Value": "哈哈哈哈，原來是這樣……"
  },
  {
    "ID": 26517,
    "Value": "？？？？？"
  },
  {
    "ID": 26518,
    "Value": "這可沒門！雖然你將我召回人世，但這槍可不能給你！"
  },
  {
    "ID": 26519,
    "Value": "最多！最多讓你摸一下！"
  },
  {
    "ID": 26520,
    "Value": "不過，你要是放了我，讓我去復仇，我可以考慮讓你比劃幾下！"
  },
  {
    "ID": 26521,
    "Value": "晚輩絕無此意！"
  },
  {
    "ID": 26522,
    "Value": "小友放心！老夫定會好好照看於你！"
  },
  {
    "ID": 26523,
    "Value": "多謝前輩！前輩大可不必！"
  },
  {
    "ID": 26524,
    "Value": "晚輩尉遲良，無意掌握這時輪靈力因而喚出前輩。"
  },
  {
    "ID": 26525,
    "Value": "如此驚擾，晚輩萬分抱歉。"
  },
  {
    "ID": 26526,
    "Value": "晚輩……我已經睡了很久嗎……"
  },
  {
    "ID": 26527,
    "Value": "不過，還是謝謝你，讓我能再聽一聽林間的鳥聲。"
  },
  {
    "ID": 26528,
    "Value": "前輩為何盯著我不說話？"
  },
  {
    "ID": 26529,
    "Value": "我只是在揣摩娘娘的心意。"
  },
  {
    "ID": 26530,
    "Value": "娘娘？哪位娘娘？"
  },
  {
    "ID": 26531,
    "Value": "這世間除了她，還有誰能讓我稱之為娘娘？"
  },
  {
    "ID": 26534,
    "Value": "小問題！不客氣！"
  },
  {
    "ID": 26535,
    "Value": "……這和你有什麼關係嗎。"
  },
  {
    "ID": 26536,
    "Value": "多謝前輩，他資質愚鈍學不會什麼有趣的事情。"
  },
  {
    "ID": 26537,
    "Value": "嘖嘖，好吧好吧。"
  },
  {
    "ID": 26538,
    "Value": "<小聲>別擔心，下次就剩咱們兩個的時候姐姐再教你哦~"
  },
  {
    "ID": 26539,
    "Value": "在下，天玄門殷劍平。"
  },
  {
    "ID": 26540,
    "Value": "月兒……"
  },
  {
    "ID": 26541,
    "Value": "？*？"
  },
  {
    "ID": 26542,
    "Value": "月兒……是誰？"
  },
  {
    "ID": 26543,
    "Value": "他的劍匣跟殷的……"
  },
  {
    "ID": 26544,
    "Value": "姑娘……為何一直盯著在下的劍匣？"
  },
  {
    "ID": 26545,
    "Value": "前輩可是想起了什麼？"
  },
  {
    "ID": 26546,
    "Value": "只是一些支離破碎的片段。"
  },
  {
    "ID": 26547,
    "Value": "不知為何意，但每每想起便心亂如麻。"
  },
  {
    "ID": 26548,
    "Value": "或許，是未竟之事吧。"
  },
  {
    "ID": 26551,
    "Value": "就是認識一下嘛。\\n依依叫鹿昭依，多謝兩位恩人剛才出手相助！"
  },
  {
    "ID": 26552,
    "Value": "呃……我復姓尉遲，單名良。\\n那位姑娘是虞兮。"
  },
  {
    "ID": 26554,
    "Value": "哼！你、你別不識好人心！"
  },
  {
    "ID": 26557,
    "Value": "這……\\n姑娘，<color=#6cf1d0>「明清心法」</color>乃時輪秘法之一，恕不外傳。"
  },
  {
    "ID": 26566,
    "Value": "好！就叫<color=#79cbff>#username#</color>！\\n咱們現在可算自己人啦，這就出發吧！"
  },
  {
    "ID": 26578,
    "Value": "？*？"
  },
  {
    "ID": 26712,
    "Value": "似乎有神秘的力量在召喚我……！？發生了什麼奇怪的事情啊……"
  },
  {
    "ID": 26714,
    "Value": "我方任意角色抵達石塔門口\n或敵方全滅"
  },
  {
    "ID": 26720,
    "Value": "第八幕"
  },
  {
    "ID": 26721,
    "Value": "第九幕"
  },
  {
    "ID": 26722,
    "Value": "初窺玄冥事"
  },
  {
    "ID": 26728,
    "Value": "此處是通往<color=#6cf1d0>『地界的通道』</color>！但應早被<color=#6cf1d0>『天玄門』</color>封印了，怎會——"
  },
  {
    "ID": 26729,
    "Value": "看來只能先消滅這些魔物再設法<color=#6cf1d0>封印</color>這處<color=#6cf1d0>『地界的通道』</color>了。"
  },
  {
    "ID": 26735,
    "Value": "少年夏侯儀來到蘭州城為高老丈購藥材，卻不料城門重兵把守，城中更是風聲鶴唳、人人自危……"
  },
  {
    "ID": 26736,
    "Value": "三座皆承一球，但不知其序。擇一試之而魂體崩\\n創，雖知其誤，然已晚矣……"
  },
  {
    "ID": 26737,
    "Value": "荒漠之境、妖魔橫行……"
  },
  {
    "ID": 26739,
    "Value": "途徑沙漠，眾人在烽火台處遭到妖魔的糾纏……"
  },
  {
    "ID": 26741,
    "Value": "眾人發現藏於暗處的慕容璇璣，就在此時，綁走齋女的刺青大漢突然出現……"
  },
  {
    "ID": 26745,
    "Value": "老者的秘密，幻城的力量，究竟所言為何……"
  },
  {
    "ID": 26747,
    "Value": "此地是磐沙堡演武廳，依倫哲羅到底在何處……"
  },
  {
    "ID": 26748,
    "Value": "尋到磐沙堡大殿，夏侯儀一眾終於見到了被劫持的齋女和磐沙堡堡主依倫哲羅……"
  },
  {
    "ID": 26749,
    "Value": "救出齋女，夏侯儀等人離開磐沙堡，卻遭到紫雲\\n派、崆峒派的阻撓，眾人性命危在旦夕……"
  },
  {
    "ID": 26750,
    "Value": "得知家中生變後夏侯儀趕回河州鎮，卻發現西夏兵在鎮上挾持村民、濫殺無辜……"
  },
  {
    "ID": 26751,
    "Value": "在涼州打探到阿玲的消息後，夏侯儀趕往沙漠，沒想到綁架阿玲的老太婆竟然是……"
  },
  {
    "ID": 26752,
    "Value": "肅州之行，險象環生……"
  },
  {
    "ID": 26754,
    "Value": "毒物襲擾，夏侯儀一眾與之展開較量。"
  },
  {
    "ID": 26755,
    "Value": "眾人裝扮成公主侍從，卻在肅州城門受阻，夏侯儀一行勇闖石塔……"
  },
  {
    "ID": 26756,
    "Value": "在甘州城打探到消息後，夏侯儀等人重回到沙漠，腳印？火銅？究竟發生了何事？"
  },
  {
    "ID": 26757,
    "Value": "夏侯儀一行趕往高昌古城，卻在城外陷入了沙漠之陣……"
  },
  {
    "ID": 26758,
    "Value": "穿過重重迷陣，夏侯儀來到高昌古城，重遇中原五派，新仇舊怨，一時爭執難分……"
  },
  {
    "ID": 26759,
    "Value": "眾人循著地脈流向尋找敵人，卻被高昌妖魔\\n纏住……"
  },
  {
    "ID": 26760,
    "Value": "身負重傷的皇甫堡主、象徵羅睺印記的雙頭蛇戒，身世之謎若隱若現……"
  },
  {
    "ID": 26761,
    "Value": "思謁之間？鏡幻幽界？似乎是熟悉的地方……"
  },
  {
    "ID": 26762,
    "Value": "鏡幻幽界崩離潰解，夏侯儀等人回到古城門前，眾人精疲力盡之際，周崇朱浩率眾發起刁難……"
  },
  {
    "ID": 26763,
    "Value": "時輪尊者與夏侯儀一時爭執難下，時輪尊者使用禁法將夏侯儀困入心魔幻境……"
  },
  {
    "ID": 26764,
    "Value": "沙漠之陣"
  },
  {
    "ID": 26765,
    "Value": "劫持？失蹤？夏侯儀欲尋齋女和慕容璇璣，卻不料迎面遇到被追殺的商人……"
  },
  {
    "ID": 26766,
    "Value": "夏侯儀等人行蹤暴露，被沙漠賊寇團團圍住，生死難料……"
  },
  {
    "ID": 26767,
    "Value": "跟隨紙鳶，夏侯儀一路來到磐沙谷，遠遠望去，前方似是一座城堡……"
  },
  {
    "ID": 26768,
    "Value": "眾人繞道磐沙谷後山，卻發現早已有人在此等候多時……"
  },
  {
    "ID": 26769,
    "Value": "夏侯儀等人在地牢裡搜尋齋女後未果，卻無意間發現了一位囚禁於牢房之中的西方青年……"
  },
  {
    "ID": 26770,
    "Value": "為了找到依倫哲羅，眾人誤闖磐沙堡寶藏室……"
  },
  {
    "ID": 26787,
    "Value": "喲，曹大人跟著吳將軍久了，也是交友甚廣啊。"
  },
  {
    "ID": 26790,
    "Value": "絕不能把神珠給她"
  },
  {
    "ID": 26791,
    "Value": "一切以阿鈴的性命為重"
  },
  {
    "ID": 26792,
    "Value": "阿良未相助方全滅"
  },
  {
    "ID": 26793,
    "Value": "擊敗劫鏢賊"
  }
]