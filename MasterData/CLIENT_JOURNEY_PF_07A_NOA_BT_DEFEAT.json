      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "실수로 떨어뜨렸다고 접시가 멀쩡한 건 아니죠.",
      "UnitTalk_JPN": "うっかり落としたからといって、お皿が無事な訳ないでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_DEFEAT",
      "WaitClick": false,
