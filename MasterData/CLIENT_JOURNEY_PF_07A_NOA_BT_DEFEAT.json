      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_BATTLE_COMMON_CLOTH_01.wav",
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "최근 창고 정리 도중에 발견한 <color=#F7BE45>[아르카나]</color> 카드입니다.",
      "UnitTalk_JPN": "最近、倉庫整理の際に見つけた<color=#F7BE45>「アルカナ」</color>カードです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "보통 사람에게는 희귀한 수집품에 불과하겠지만… ",
      "UnitTalk_JPN": "普通の人にとっては、ただの珍しい品に過ぎないでしょうが… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "단장님이라면 분명 유용하게 쓰실 수 있을 거라고 믿습니다.",
      "UnitTalk_JPN": "団長であれば、きっと有効活用してくださると思います。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_DEFEAT",
      "WaitClick": true,
