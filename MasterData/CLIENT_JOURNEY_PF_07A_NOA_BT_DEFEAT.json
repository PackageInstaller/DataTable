      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장님, 그리고 여정 단원님. 두 분 모두 수고하셨습니다. ",
