    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT2_MALE_N",
      "UnitNameString": [
        "SI_SHOP_OWNER"
      ],
      "UnitMotion": "NORMAL",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "구원자를 위한 모든 장비! 빅-세이비어 장비점에 오신 것을 환영합…",
      "UnitTalk_JPN": "救援者のための装備を揃えております！ビッグ・セイヴァーショップへいらっしゃ…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitQuickSet": true,
      "UnitTalk_KOR": "이봐, 주인장! 나야! 쇼핑하러 왔어!",
      "UnitTalk_JPN": "おい、店長！オレだ！ショッピングしに来たぞ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT2_MALE_N",
      "UnitNameString": [
        "SI_SHOP_OWNER"
      ],
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "오옷! 우리 가게 최우수 호개- ",
      "UnitTalk_JPN": "おおっ！当店最高のカモ── ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT2_MALE_N",
      "UnitNameString": [
        "SI_SHOP_OWNER"
      ],
      "UnitMotion": "SMILE",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "아니… 고객이신 트리쉬님 아니십니까? 오늘은 어떤 상품을 찾으십니까?",
      "UnitTalk_JPN": "ではなく…お客様であるトリッシュ様でしたか。本日はどのようなものをお探しですか？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitTalk_KOR": "오늘은 내가 아니라 우리 단장을 위한 쇼핑이야.",
      "UnitTalk_JPN": "今日はオレじゃなく、団長のショッピングに来たんだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "일단 저기 장식장 안에 들어있는 건 뭐야? ",
      "UnitTalk_JPN": "まず、あの棚に飾られてるのはなんだ？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT2_MALE_N",
      "UnitNameString": [
        "SI_SHOP_OWNER"
      ],
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "후후. 역시 트리쉬님이십니다. 보는 안목이 정말 대단하시군요.",
      "UnitTalk_JPN": "ふふ、さすがトリッシュ様です。お目が高いですね。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT2_MALE_N",
      "UnitNameString": [
        "SI_SHOP_OWNER"
      ],
      "UnitTalk_KOR": "이건 <color=#F7BE45>최신식 마도공학 보호대</color>로, 설정 한도 이상의 충격을 받으면 자동으로 충격을 흡수하는 장비입죠. ",
      "UnitTalk_JPN": "これは<color=#F7BE45>最新式の魔工学プロテクター</color>で、設定より高い衝撃を受けると、その衝撃を吸収してくれます。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT2_MALE_N",
      "UnitNameString": [
        "SI_SHOP_OWNER"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "케메트 인더스트리가 자신 있게 새로 내놓은 명품 중의 명품!",
      "UnitTalk_JPN": "ケメット・インダストリーが自信を持って送り出した、名品の中の名品！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitTalk_KOR": "일단 그거 하나 줘. 단장, 사이즈 맞지?",
      "UnitTalk_JPN": "じゃ、とりあえず一つな。団長、サイズ合うだろ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나 쓰라고…?",
          "JumpAnchorStringId_JPN": "私が使うの…？"
        }
      ]
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "당연하지. 단장 때문에 온 건데. 그리고…",
      "UnitTalk_JPN": "当たり前だろ、団長のもん買いに来たんだから。あとは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitTalk_KOR": "주인장. 요즘 제일 잘 나가는 건 뭐야?",
      "UnitTalk_JPN": "店長。最近、一番人気なのはどれだ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT2_MALE_N",
      "UnitNameString": [
        "SI_SHOP_OWNER"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "음… 최근에는 요 프레스티지 안장이 제일 잘나갑니다. ",
      "UnitTalk_JPN": "そうですね…最近はこの高級な鞍が一番人気です。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT2_MALE_N",
      "UnitNameString": [
        "SI_SHOP_OWNER"
      ],
      "UnitTalk_KOR": "착용감은 기본이고, 말, 바이크 호그 어느쪽 에도 얹을 수 있는 범용성까지. ",
      "UnitTalk_JPN": "着用感はもちろん…馬、バイクホッグどちらにもご使用いただけます。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT2_MALE_N",
      "UnitNameString": [
        "SI_SHOP_OWNER"
      ],
      "UnitTalk_KOR": "열선이랑 통풍 기능도 있습죠.",
      "UnitTalk_JPN": "ヒーターに、クーラー機能まで付いていますよ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "오케이! 그것도 담지 뭐.",
      "UnitTalk_JPN": "オッケー！それも買うぜ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "말도 없고 호그도 없는데 이걸 왜 사… ",
          "JumpAnchorStringId_JPN": "馬もホッグもいないのに、なんで買うんだ… "
        }
      ]
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "후후후. 일류 헌터 특! 미래에 철저히 대비함!",
      "UnitTalk_JPN": "ふふふ。一流ハンターたる者！未来への準備も怠らない！",
