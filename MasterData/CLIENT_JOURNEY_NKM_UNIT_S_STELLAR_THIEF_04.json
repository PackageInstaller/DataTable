      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_NOA_DOWNTOWN.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_19.mp3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "갑자기 뭐야? 진지한 표정을 하고 앉아선.",
      "UnitTalk_JPN": "突然なんだよ？真剣な顔してさ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitTalk_KOR": "잠깐, 또 잔소리하려고 그러지? ",
      "UnitTalk_JPN": "待て、また小言を言うつもりか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "후우… 단장이 잔소리 좀 한다고 해서 바뀌지는 않는다고?",
      "UnitTalk_JPN": "ふぅ…団長が小言を言ったからって、何も変わらないぞ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그래. 넌 <color=#F7BE45>멋있게</color> 살고 싶다고 했지.",
          "JumpAnchorStringId_JPN": "トリッシュは<color=#F7BE45>クール</color>に生きたいんだよね？"
        }
      ]
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "응. 그런데?",
      "UnitTalk_JPN": "おう。それがどうした？",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "하지만, 꼭 돈을 펑펑 써야만-",
          "JumpAnchorStringId_JPN": "散財することこそが──"
        }
      ]
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitTalk_KOR": "멋있는 건 아니라고? ",
      "UnitTalk_JPN": "クールな訳じゃないって？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후후! 알아. 하지만 돈 만큼 손쉽게 폼나는 삶을 살 수 있게 해주는 건 없지.",
      "UnitTalk_JPN": "ふっふっふ！分かってる。だが金ほど楽に、クールな人生を手に入れられるものはないだろ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "아! 이참에 단장도 한번 직접 경험해보는 게 어때?",
      "UnitTalk_JPN": "そうだ！この際、団長も経験してみるのはどうだ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitTalk_KOR": "생각이 싹 바뀔걸?",
      "UnitTalk_JPN": "考えが変わるはずだぜ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그러니까 내 말은-",
          "JumpAnchorStringId_JPN": "だから、私が言いたいのは──"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "아아! 안 들려!",
      "UnitTalk_JPN": "あぁ！聞こえねぇ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitTalk_KOR": "그냥 오늘은 나를 한번 따라와 보라고.",
      "UnitTalk_JPN": "今日は黙ってオレについてきてよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "특별히 단장을 위한 <color=#F7BE45>풀 코스</color>로 달려보자. ",
      "UnitTalk_JPN": "特別に、団長のための<color=#F7BE45>フルコース</color>を用意するぜ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "자자, 한번 사는 인생인데. 멋있게 살아봐야지 안 그래?",
      "UnitTalk_JPN": "さぁさぁ、人生一度っきりなんだから。クールに生きないとな？",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "트리쉬는 내 말을 한 귀로 완전히 흘려버리며 내 손을 잡아끌었다. ",
      "UnitTalk_JPN": "トリッシュは全く耳を貸さず、私の手を引いた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_04",
