      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "좋아. 이제 좀 기백이 느껴지는군.",
      "UnitTalk_JPN": "よっしゃあ！その意気込みだぜ。",
      "TalkTime": 0.03
    },
    {
