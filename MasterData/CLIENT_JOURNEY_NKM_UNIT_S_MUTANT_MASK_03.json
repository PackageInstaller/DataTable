      "TalkTime": 0.03
    },
    {
      "Uid": 98,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_19.mp3",
      "UnitTalk_KOR": "산산이 흩어져 날리는 <color=#F7BE45>꽃이었던 것</color> 사이로 키라는 활짝 웃고 있었다.",
      "UnitTalk_JPN": "粉々になり舞い散る<color=#F7BE45>花だったもの</color>の後ろで、キラは満面の笑顔を浮かべていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 99,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…억지 아니야?!",
          "JumpAnchorStringId_JPN": "…無理やり過ぎない！？"
        }
      ]
    },
    {
      "Uid": 100,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "…억지? ",
      "UnitTalk_JPN": "…無理やり？",
      "TalkTime": 0.03
    },
    {
      "Uid": 101,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "단장은 키라랑 운명으로 엮이는 게 싫은 거야? ",
      "UnitTalk_JPN": "団長は、キラと運命で結ばれるのがイヤなの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 102,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "역시… 기분 나쁜 아이라고 생각했지?",
      "UnitTalk_JPN": "やっぱり…気持ち悪い子だと思った？",
      "TalkTime": 0.03
    },
    {
