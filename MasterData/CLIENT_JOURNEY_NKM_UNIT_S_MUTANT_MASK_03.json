      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "응? 싫어하지 않아? ",
      "UnitTalk_JPN": "うん？嫌いじゃないの？",
      "TalkTime": 0.03
