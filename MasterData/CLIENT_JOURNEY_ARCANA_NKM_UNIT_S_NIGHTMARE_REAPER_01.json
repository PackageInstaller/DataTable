        }
      ]
    },
    {
      "Uid": 105,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "…몸이 안 움직인다.",
      "UnitTalk_JPN": "…体が動かない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 106,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "숨 쉬는 것도 조금 불편한데…",
      "UnitTalk_JPN": "少しの息苦しさもある…",
      "TalkTime": 0.03
    },
    {
      "Uid": 107,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "설마, 가위에 눌린 건가…?",
      "UnitTalk_JPN": "まさか、金縛りにあったのか…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 108,
      "WaitClick": true,
      "WaitTime": 0.0,
