    },
    {
      "Uid": 137,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이렇게…",
      "UnitTalk_JPN": "こうして…",
      "TalkTime": 0.03
    },
    {
      "Uid": 138,
      "WaitClick": true,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "세이라가 손바닥으로 내 몸을 지그시 눌러가며 천천히 짚어 내려가기 시작했다.",
