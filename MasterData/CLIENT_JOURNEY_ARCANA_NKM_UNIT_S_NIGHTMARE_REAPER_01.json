      "UnitTalk_JPN": "コツコツ──",
      "TalkTime": 0.03
    },
    {
      "Uid": 109,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "창밖으로 발소리가 들린다. 누구지…?",
