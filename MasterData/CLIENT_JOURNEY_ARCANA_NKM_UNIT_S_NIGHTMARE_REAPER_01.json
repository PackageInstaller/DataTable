      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "제가 편하게 해드릴게요.",
      "UnitTalk_JPN": "わたしが楽にして差し上げますね。",
