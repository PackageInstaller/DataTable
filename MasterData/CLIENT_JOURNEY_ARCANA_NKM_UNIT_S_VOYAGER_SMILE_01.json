    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "꺄아아악~! 귀여워!!",
      "UnitTalk_JPN": "キャーーーッ！かわいい！！",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "이 고양이 좀 봐! 예뻐, 깜찍해!",
      "UnitTalk_JPN": "見てみて！小さくて愛おしすぎるわ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "데려가서 키울까? 어떡하지? 사료는 많이 비싼가?",
      "UnitTalk_JPN": "連れて帰って飼おうかしら？うーん、キャットフードって高いのかな？",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "안돼.",
      "UnitTalk_JPN": "ダメ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "어? 왜?",
      "UnitTalk_JPN": "えっ？どうして？",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "스마일, 너도 고양이 좋아하지 않아?",
      "UnitTalk_JPN": "スマイルも猫、好きでしょ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "첫 번째 질문에 대한 대답.",
      "UnitTalk_JPN": "一つ目の質問に対する回答。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "이 고양이랑 비슷한 어른 고양이 둘을 봤어. 엄마와 아빠 고양이일 확률이 높음.",
      "UnitTalk_JPN": "この猫に似た大人の猫2匹を見た。父猫と母猫の可能性が高い。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "우리가 데려가면 얘는 가족과 헤어지게 돼.",
      "UnitTalk_JPN": "私たちが連れて行けば、家族と離れ離れ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "두 번째 질문에 대한 대답.",
      "UnitTalk_JPN": "二つ目の質問に対する回答。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "나는 고양이를 좋아하지 않아.",
      "UnitTalk_JPN": "私は猫が好きじゃない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "…정말?!",
      "UnitTalk_JPN": "…本当に！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "의문. 왜 그렇게 놀라?",
      "UnitTalk_JPN": "疑問。なんでそんなに驚くの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "아니… 옷도 그렇고 전투할 때 튀어나오는 고양이도 그렇고…",
      "UnitTalk_JPN": "だって…服もそうだし、戦闘中に飛び出してくる猫もそうだし…",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "당연히 좋아한다고 생각했는데, 아니었어?",
      "UnitTalk_JPN": "当然好きなんだって思ってたけど、違った？",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "긍정. 정확히는 고양이라는 종의 진화 방식이 호감.",
      "UnitTalk_JPN": "肯定。正確には、猫という種の進化過程には好感。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "진화 방식?",
      "UnitTalk_JPN": "進化過程？",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "고양이가 귀여운 이유에 대해 생각해 본 적 있어?",
      "UnitTalk_JPN": "猫が可愛い理由について、考えたことはある？",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "고양이의 외형은 인간 아기와 닮았어. 보호욕을 자극하지.",
      "UnitTalk_JPN": "猫の見た目は、人間の赤ん坊に似てる。そして庇護欲を刺激する。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "모든 고양이가 그런 건 아니었을 거야. 몇몇 개체의 특이성이었겠지.",
      "UnitTalk_JPN": "すべての猫がそういうわけじゃなかったはず。一部の個体の特異性だった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "ONE_7",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "하지만 귀여운 고양이를 인간들이 사육. 개체 수의 증가.",
      "UnitTalk_JPN": "でも、かわいい猫を人間が飼育。個体数の増加。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "동일한 유전적 특질을 지닌 개체가 불어나서 종을 대표하게 됐지.",
      "UnitTalk_JPN": "同一の遺伝的特性を持った個体が増え、種を代表するようになった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "즉, 고양이는 자연선택 전 진화의 결정체. 진화생물학의 정점.",
      "UnitTalk_JPN": "つまり、猫は自然淘汰による進化が生み出した傑作。進化生物学の頂点。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "으~ 너는 간단한 이야기도 어렵게 설명하는 재주가 있더라.",
      "UnitTalk_JPN": "うぅ～、スマイルは何でも難しく説明する才能があるんだから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "어쨌든 좋아한다는 거지?",
      "UnitTalk_JPN": "とにかく、好きってことでしょ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "부정. 진화 방식을 좋아할 뿐.",
      "UnitTalk_JPN": "否定。進化の過程が好きなだけ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "인간 친화적인 진화 방식이 나랑 전혀 달라. 나는 인간과 다르게 진화했으니까.",
      "UnitTalk_JPN": "人間が好むような進化の過程は、私からかけ離れたもの。私は人間とは違う進化をしてきたから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "또 <color=#F7BE45>나는 인간이 아니다</color>, <color=#F7BE45>다른 생물체</color>다. 그런 소리 하려고?",
      "UnitTalk_JPN": "また<color=#F7BE45>自分は人間じゃない</color>、<color=#F7BE45>他の生命体</color>だって言ってるの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
