      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아아! 와 버렸다…! 정말 와 버렸잖아!",
      "UnitTalk_JPN": "あぁ！来ちゃったわね…！本当に来ちゃったわよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_SAINTESS_DEMON_09",
