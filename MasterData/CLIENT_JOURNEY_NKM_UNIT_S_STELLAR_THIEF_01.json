      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_STELLAR_THIEF_01",
