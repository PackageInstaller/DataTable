{
  "10301": {
    "Id": 10301,
    "Character": 103,
    "Type": 1,
    "voResource": "vo_103_ui_gachaNew_001",
    "Lines": "我，琥珀。\n……鸢尾替我写了一份自我介绍，我稍后发邮件给你。"
  },
  "10302": {
    "Id": 10302,
    "Character": 103,
    "Type": 2,
    "voResource": "vo_103_ui_gacha_001",
    "Lines": "我们已经这么熟了，所以……不用再自我介绍了吧？"
  },
  "10303": {
    "Id": 10303,
    "Character": 103,
    "Type": 3,
    "voResource": "vo_103_ui_unlockLook_001",
    "Lines": "魔王，我有成长吗？"
  },
  "10304": {
    "Id": 10304,
    "Character": 103,
    "Type": 4,
    "voResource": "vo_103_ui_unlockCG_001",
    "Lines": "来抱抱……啊，我说的是这只猫。"
  },
  "10305": {
    "Id": 10305,
    "Character": 103,
    "Type": 5,
    "SkinId": 10303,
    "Lines": "锦绣织就流火，金饰点缀祥云。不怒自威、顾盼神飞。\n嘎呜——"
  },
  "10306": {
    "Id": 10306,
    "Character": 103,
    "Type": 5,
    "SkinId": 10304,
    "Lines": "顺着炙热的海风，捉住那狂欢的隙间，悠悠然望向你的视线。"
  },
  "10701": {
    "Id": 10701,
    "Character": 107,
    "Type": 1,
    "voResource": "vo_107_ui_gachaNew_001",
    "Lines": "报告！我是代表正义的骑士侍从缇莉娅。来成为我的伙伴一起伸张正义吧！"
  },
  "10702": {
    "Id": 10702,
    "Character": 107,
    "Type": 2,
    "voResource": "vo_107_ui_gacha_001",
    "Lines": "又见面啦，正义的伙伴！"
  },
  "10703": {
    "Id": 10703,
    "Character": 107,
    "Type": 3,
    "voResource": "vo_107_ui_unlockLook_001",
    "Lines": "咦……骏鹰号的声音怎么有点不对劲……哇哇哇——！"
  },
  "10704": {
    "Id": 10704,
    "Character": 107,
    "Type": 4,
    "voResource": "vo_107_ui_unlockCG_001",
    "Lines": "谢谢你，来见证我踏上英雄之路。"
  },
  "10705": {
    "Id": 10705,
    "Character": 107,
    "Type": 5,
    "SkinId": 10703,
    "Lines": "系紧腰带，利落变身，斗志如烈阳般炽热！\u000b披上正义的战衣，以骑士之姿守护每一条街道——\u000b此即吾之正义！"
  },
  "10706": {
    "Id": 10706,
    "Character": 107,
    "Type": 5,
    "SkinId": 10704,
    "Lines": "太阳色的女孩正在应援准备中~\u000b拿出最棒的微笑和状态，迎接下一场挑战吧！"
  },
  "10801": {
    "Id": 10801,
    "Character": 108,
    "Type": 1,
    "voResource": "vo_108_ui_gachaNew_001",
    "Lines": "白猫剧团第三小队队长，卡西米拉。这是我们的合作协议，请在上面签名吧。"
  },
  "10802": {
    "Id": 10802,
    "Character": 108,
    "Type": 2,
    "voResource": "vo_108_ui_gacha_001",
    "Lines": "你是个不错的雇主。能继续与你合作……我很高兴。"
  },
  "10803": {
    "Id": 10803,
    "Character": 108,
    "Type": 3,
    "voResource": "vo_108_ui_unlockLook_001",
    "Lines": "这是补充协议，请。"
  },
  "10804": {
    "Id": 10804,
    "Character": 108,
    "Type": 4,
    "voResource": "vo_108_ui_unlockCG_001",
    "Lines": "我终于意识到，原来你才是我最灵验的幸运护符。"
  },
  "11001": {
    "Id": 11001,
    "Character": 110,
    "Type": 1,
    "voResource": "vo_110_ui_gachaNew_001",
    "Lines": "翡冷翠，你的盟友。我会向你展现我的价值，也请你不要令我失望。"
  },
  "11002": {
    "Id": 11002,
    "Character": 110,
    "Type": 2,
    "voResource": "vo_110_ui_gacha_001",
    "Lines": "聪明人之间，就不必重复客套话了——说出你特地找我的理由吧，我都会奉陪。"
  },
  "11003": {
    "Id": 11003,
    "Character": 110,
    "Type": 3,
    "voResource": "vo_110_ui_unlockLook_001",
    "Lines": "……是时候签个新契约了，让我们的合作……更进一步吧……！"
  },
  "11004": {
    "Id": 11004,
    "Character": 110,
    "Type": 4,
    "voResource": "vo_110_ui_unlockCG_001",
    "Lines": "既然选择了与我一起……就意味着，你已经逃不出我的掌心了喔……"
  },
  "11005": {
    "Id": 11005,
    "Character": 110,
    "Type": 5,
    "SkinId": 11003,
    "Lines": "借用不属于自己的力量，是需要付出相应的代价的。\n您在害怕什么？我又不是恶魔。"
  },
  "11101": {
    "Id": 11101,
    "Character": 111,
    "Type": 1,
    "voResource": "vo_111_ui_gachaNew_001",
    "Lines": "我叫鸢尾，那个……有什么做的不好的地方，请多多指教。"
  },
  "11102": {
    "Id": 11102,
    "Character": 111,
    "Type": 2,
    "voResource": "vo_111_ui_gacha_001",
    "Lines": "我回来了，==PLAYER_NAME==。这是打工的收入，请帮我存起来，作为旅团的风险准备金吧。"
  },
  "11103": {
    "Id": 11103,
    "Character": 111,
    "Type": 3,
    "voResource": "vo_111_ui_unlockLook_001",
    "Lines": "我的手提包可是很沉的，别小看知识的重量！"
  },
  "11104": {
    "Id": 11104,
    "Character": 111,
    "Type": 4,
    "voResource": "vo_111_ui_unlockCG_001",
    "Lines": "谢谢你给我买的曲奇，很好吃……真是的，要是之后再也吃不到这么好吃的曲奇，我一定会难过的。你要负起责任来啊，约好了。"
  },
  "11105": {
    "Id": 11105,
    "Character": 111,
    "Type": 5,
    "SkinId": 11103,
    "Lines": "冬日清冷阳光下的你，捧着热饮呼出白气的你，自诩平凡普通的你，却构成了这个日子全部的意义。"
  },
  "11106": {
    "Id": 11106,
    "Character": 111,
    "Type": 5,
    "SkinId": 11104,
    "Lines": "那个……我会尽量稳住这个充气玩偶，但上来时还是请小心一些。\u000b——当，当然，如果你不小心落水了，我肯定也会拉住你的！"
  },
  "11201": {
    "Id": 11201,
    "Character": 112,
    "Type": 1,
    "voResource": "vo_112_ui_gachaNew_001",
    "Lines": "我们走吧，魔王大人，有很多很多星塔在等着我们！"
  },
  "11202": {
    "Id": 11202,
    "Character": 112,
    "Type": 2,
    "voResource": "vo_112_ui_gacha_001",
    "Lines": "对旅人来说，相逢即是有缘，再遇便是命运……不像我说的话吗？"
  },
  "11203": {
    "Id": 11203,
    "Character": 112,
    "Type": 3,
    "voResource": "vo_112_ui_unlockLook_001",
    "Lines": "接下来的旅程，大家还要继续在一起！"
  },
  "11204": {
    "Id": 11204,
    "Character": 112,
    "Type": 4,
    "voResource": "vo_112_ui_unlockCG_001",
    "Lines": "等小绿修好之后，我可以带魔王大人去个很适合观赏星塔的地方哦。\n就我们两个人。"
  },
  "11205": {
    "Id": 11205,
    "Character": 112,
    "Type": 5,
    "SkinId": 11203,
    "Lines": "来到大海，来到沙滩，当然得换上泳衣。\u000b怀抱热情的太阳，享受海浪的轻拍——与夏天的亲密接触，得务必注意防晒！"
  },
  "11207": {
    "Id": 11207,
    "Character": 112,
    "Type": 5,
    "SkinId": 11205,
    "Lines": "今天的委托是陪着人家休息一整天~\n没有异议的话就快换上睡衣吧，旁边的空位是预留给你的哦~"
  },
  "11301": {
    "Id": 11301,
    "Character": 113,
    "Type": 1,
    "voResource": "vo_113_ui_gachaNew_001",
    "Lines": "我是白泽公署的师渺，今后由我来接手与贵旅团的相关合作事宜，还望合作愉快。"
  },
  "11302": {
    "Id": 11302,
    "Character": 113,
    "Type": 2,
    "voResource": "vo_113_ui_gacha_001",
    "Lines": "又见面了魔王。有个紧急委托需要你的帮助，具体内容我会在路上告知。"
  },
  "11303": {
    "Id": 11303,
    "Character": 113,
    "Type": 3,
    "voResource": "vo_113_ui_unlockLook_001",
    "Lines": "水，以不变呈万态。"
  },
  "11304": {
    "Id": 11304,
    "Character": 113,
    "Type": 4,
    "voResource": "vo_113_ui_unlockCG_001",
    "Lines": "又、又是火锅吗？！没有不满，我只是想纠正一下大家对龙裔喜欢吃火锅的刻板印象。"
  },
  "11305": {
    "Id": 11305,
    "Character": 113,
    "Type": 5,
    "SkinId": 11303,
    "Lines": "苍梧城内严禁辣椒成精！\u000b为、为了守护苍梧的和平，坚、坚持爱与正义的魔法少女，师渺命令你！快点变回原来的样子！"
  },
  "11401": {
    "Id": 11401,
    "Character": 114,
    "Type": 1,
    "voResource": "vo_114_ui_gachaNew_001",
    "Lines": "汝即是传说中的魔王？既然汝身怀黑暗之力，那吾便回应汝之召唤。咳……做好觉悟吧！我会助你走上黑暗的巅峰，再狠狠击溃你！喵哈哈哈哈！"
  },
  "11402": {
    "Id": 11402,
    "Character": 114,
    "Type": 2,
    "voResource": "vo_114_ui_gacha_001",
    "Lines": "呼……看来我们之间的羁绊又加深了。不用急着道谢，这不过是汝之黑暗力量的必然回响！喵哈哈哈哈！"
  },
  "11403": {
    "Id": 11403,
    "Character": 114,
    "Type": 3,
    "voResource": "vo_114_ui_unlockLook_001",
    "Lines": "黑暗之力，封印解除——！喵哈哈哈哈哈哈哈哈哈哈哈！"
  },
  "11404": {
    "Id": 11404,
    "Character": 114,
    "Type": 4,
    "voResource": "vo_114_ui_unlockCG_001",
    "Lines": "完美！厉害吧~这就是黑暗之王的实力！魔王，快夸我快夸我~"
  },
  "11501": {
    "Id": 11501,
    "Character": 115,
    "Type": 1,
    "voResource": "vo_115_ui_gachaNew_001",
    "Lines": "你也是来抓我回学院的吗？\n……原来不是啊，那来陪火垂玩吧！"
  },
  "11502": {
    "Id": 11502,
    "Character": 115,
    "Type": 2,
    "voResource": "vo_115_ui_gacha_001",
    "Lines": "能……再玩一会吗？我会跟你回去的。"
  },
  "11503": {
    "Id": 11503,
    "Character": 115,
    "Type": 3,
    "voResource": "vo_115_ui_unlockLook_001",
    "Lines": "魔王，我不是小孩子，我也是可以保护你的。"
  },
  "11504": {
    "Id": 11504,
    "Character": 115,
    "Type": 4,
    "voResource": "vo_115_ui_unlockCG_001",
    "Lines": "可以请你……跟我一起创造回忆吗？"
  },
  "11601": {
    "Id": 11601,
    "Character": 116,
    "Type": 1,
    "voResource": "vo_116_ui_gachaNew_001",
    "Lines": "我是联合种业的温室管理员岭川，初次见面，请、请多指教……"
  },
  "11602": {
    "Id": 11602,
    "Character": 116,
    "Type": 2,
    "voResource": "vo_116_ui_gacha_001",
    "Lines": "这次……我给你带了一点礼物！是我种的蔬菜，刚从地里摘的，很新鲜很好吃哦。"
  },
  "11603": {
    "Id": 11603,
    "Character": 116,
    "Type": 3,
    "voResource": "vo_116_ui_unlockLook_001",
    "Lines": "总有一天，我会拥有属于自己的超大田地，想种什么种什么。"
  },
  "11604": {
    "Id": 11604,
    "Character": 116,
    "Type": 4,
    "voResource": "vo_116_ui_unlockCG_001",
    "Lines": "呜呜……怎么会变成这样……魔王，快帮帮我……我一个人没办法……！"
  },
  "11605": {
    "Id": 11605,
    "Character": 116,
    "Type": 5,
    "SkinId": 11603,
    "Lines": "我能想到最幸福的时刻，就是在午后的温暖中小憩。醒来时阳光晒过窗脚，而花朵仍在等你。"
  },
  "11701": {
    "Id": 11701,
    "Character": 117,
    "Type": 1,
    "voResource": "vo_117_ui_gachaNew_001",
    "Lines": "魔王好！我是怀璟食府的璟麟，今后请多多照顾我们家的生意呀！"
  },
  "11702": {
    "Id": 11702,
    "Character": 117,
    "Type": 2,
    "voResource": "vo_117_ui_gacha_001",
    "Lines": "我让后厨给魔王开个小灶吧。嘿嘿，不麻烦不麻烦，你可是我们家的熟客呀！"
  },
  "11703": {
    "Id": 11703,
    "Character": 117,
    "Type": 3,
    "voResource": "vo_117_ui_unlockLook_001",
    "Lines": "璟麟，威风凛凛！\u000b——拍好了吗？脚、脚有点酸了……"
  },
  "11704": {
    "Id": 11704,
    "Character": 117,
    "Type": 4,
    "voResource": "vo_117_ui_unlockCG_001",
    "Lines": "科学麻雀牌才是唯一出路！魔王，你也认同这一点吧？唔唔，不愧是我的牌搭子！"
  },
  "11705": {
    "Id": 11705,
    "Character": 117,
    "Type": 5,
    "SkinId": 11703,
    "Lines": "鼓乐迎宾，食来运转！\n欢迎各位来宾今日莅临怀璟食府，美味与好运的巡礼正式开场！"
  },
  "11801": {
    "Id": 11801,
    "Character": 118,
    "Type": 1,
    "voResource": "vo_118_ui_gachaNew_001",
    "Lines": "你就是魔王大人吗？久仰大名，请务必让我替你做个“全身检查”。"
  },
  "11802": {
    "Id": 11802,
    "Character": 118,
    "Type": 2,
    "voResource": "vo_118_ui_gacha_001",
    "Lines": "看来我们还挺有缘的，要不来我诊所坐坐？"
  },
  "11803": {
    "Id": 11803,
    "Character": 118,
    "Type": 3,
    "voResource": "vo_118_ui_unlockLook_001",
    "Lines": "镰刀在低吟，它也很喜欢这份力量。"
  },
  "11804": {
    "Id": 11804,
    "Character": 118,
    "Type": 4,
    "voResource": "vo_118_ui_unlockCG_001",
    "Lines": "摸一摸它，我烦躁的内心就能平静下来……"
  },
  "11901": {
    "Id": 11901,
    "Character": 119,
    "Type": 1,
    "voResource": "vo_119_ui_gachaNew_001",
    "Lines": "谷风家政，满足您日常生活的一切需求。初次见面，我是女仆花原，请多关照。"
  },
  "11902": {
    "Id": 11902,
    "Character": 119,
    "Type": 2,
    "voResource": "vo_119_ui_gacha_001",
    "Lines": "很高兴又和您见面，这次需要哪些服务？"
  },
  "11903": {
    "Id": 11903,
    "Character": 119,
    "Type": 3,
    "voResource": "vo_119_ui_unlockLook_001",
    "Lines": "如真似幻，如影随形。"
  },
  "11904": {
    "Id": 11904,
    "Character": 119,
    "Type": 4,
    "voResource": "vo_119_ui_unlockCG_001",
    "Lines": "这份特别的礼物……我会好好珍藏。"
  },
  "11905": {
    "Id": 11905,
    "Character": 119,
    "Type": 5,
    "SkinId": 11903,
    "Lines": "风摇云影间，曦光舞沙尘。与君共度时，唯有花窥见。"
  },
  "12001": {
    "Id": 12001,
    "Character": 120,
    "Type": 1,
    "voResource": "vo_120_ui_gachaNew_001",
    "Lines": "初次见面，我是星辉附属大学的老师，叫我卡娜丝就好，你就是传说中的魔王啊……呵呵，很期待与你接下来的合作。"
  },
  "12002": {
    "Id": 12002,
    "Character": 120,
    "Type": 2,
    "voResource": "vo_120_ui_gacha_001",
    "Lines": "又见面了！如何，旅途中有没有新的发现？"
  },
  "12003": {
    "Id": 12003,
    "Character": 120,
    "Type": 3,
    "voResource": "vo_120_ui_unlockLook_001",
    "Lines": "看来我得拿出真正的实力来回应你了。"
  },
  "12004": {
    "Id": 12004,
    "Character": 120,
    "Type": 4,
    "voResource": "vo_120_ui_unlockCG_001",
    "Lines": "和你在一起能学到不少东西，当了老师之后，这样的感觉还是头一次。"
  },
  "12005": {
    "Id": 12005,
    "Character": 120,
    "Type": 5,
    "SkinId": 12003,
    "Lines": "思维缜密，计算严谨，动作标准。\u000b冲刺，起跳，扣杀，一切都如计划执行，可身体却跟不上思考。\u000b——嗯？人气榜第一又是什么意思啦！？"
  },
  "12301": {
    "Id": 12301,
    "Character": 123,
    "Type": 1,
    "voResource": "vo_123_ui_gachaNew_001",
    "Lines": "魔魔王~杏子终于见到你啦，诶嘿，能带杏子一起去冒险吗~"
  },
  "12302": {
    "Id": 12302,
    "Character": 123,
    "Type": 2,
    "voResource": "vo_123_ui_gacha_001",
    "Lines": "哇~魔魔王又找到杏子啦~那下次轮到杏子来找你啦~"
  },
  "12303": {
    "Id": 12303,
    "Character": 123,
    "Type": 3,
    "voResource": "vo_123_ui_unlockLook_001",
    "Lines": "杏子和可可泡泡都变得更厉害啦~魔魔王快跟上，我们要去打坏人啦！"
  },
  "12304": {
    "Id": 12304,
    "Character": 123,
    "Type": 4,
    "voResource": "vo_123_ui_unlockCG_001",
    "Lines": "呼……杏子，要和大家一起，永远都不要分开……"
  },
  "12305": {
    "Id": 12305,
    "Character": 123,
    "Type": 5,
    "SkinId": 12303,
    "Lines": "从古老的树洞跌入奇境，误入时间迷宫的小小公主啊，不必急于寻找出口，因为最棒的风景就藏在那些看似荒诞的梦里。"
  },
  "12501": {
    "Id": 12501,
    "Character": 125,
    "Type": 1,
    "voResource": "vo_125_ui_gachaNew_001",
    "Lines": "很荣幸与您同行，请多指教。"
  },
  "12502": {
    "Id": 12502,
    "Character": 125,
    "Type": 2,
    "voResource": "vo_125_ui_gacha_001",
    "Lines": "人们都说“重逢令人欣喜”……魔王，您是怎么看的呢？"
  },
  "12503": {
    "Id": 12503,
    "Character": 125,
    "Type": 3,
    "voResource": "vo_125_ui_unlockLook_001",
    "Lines": "我将铲除妨碍您的一切。"
  },
  "12504": {
    "Id": 12504,
    "Character": 125,
    "Type": 4,
    "voResource": "vo_125_ui_unlockCG_001",
    "Lines": "我好像……开始喜欢下雨天了。"
  },
  "12505": {
    "Id": 12505,
    "Character": 125,
    "Type": 5,
    "SkinId": 12503,
    "Lines": "她所期盼的雪愿节，是一炉温暖的火焰，一杯香甜的果酿，亲密好友的笑语，以及一份来自你的、独一无二的礼物。"
  },
  "12601": {
    "Id": 12601,
    "Character": 126,
    "Type": 1,
    "voResource": "vo_126_ui_gachaNew_001",
    "Lines": "初次见面，我是魔术师紫槿，也许你曾听过有关我的各种传闻……呵呵，很在意？但对于魔术来说，是真是假，又有什么关系呢？"
  },
  "12602": {
    "Id": 12602,
    "Character": 126,
    "Type": 2,
    "voResource": "vo_126_ui_gacha_001",
    "Lines": "同样的手法我不会演示两遍，这一次，请仔细看清楚了~"
  },
  "12603": {
    "Id": 12603,
    "Character": 126,
    "Type": 3,
    "voResource": "vo_126_ui_unlockLook_001",
    "Lines": "盛大的演出就要开始了，将这份奇迹牢记于心吧！"
  },
  "12604": {
    "Id": 12604,
    "Character": 126,
    "Type": 4,
    "voResource": "vo_126_ui_unlockCG_001",
    "Lines": "看入迷了？好啦，快点来帮忙吧，演出就要开始了。"
  },
  "12605": {
    "Id": 12605,
    "Character": 126,
    "Type": 5,
    "SkinId": 12603,
    "Lines": "聚光灯就位——\n来吧，这一次要让全世界看到，我的舞台由我自己照耀。"
  },
  "12701": {
    "Id": 12701,
    "Character": 127,
    "Type": 1,
    "voResource": "vo_127_ui_gachaNew_001",
    "Lines": "喔~又发现一条新航道！\n哼哼~我是万送屋的特丽莎，想寄信时，您和我说一声就行。"
  },
  "12702": {
    "Id": 12702,
    "Character": 127,
    "Type": 2,
    "voResource": "vo_127_ui_gacha_001",
    "Lines": "又见面了，魔王，万送屋的服务您还满意吗？"
  },
  "12703": {
    "Id": 12703,
    "Character": 127,
    "Type": 3,
    "voResource": "vo_127_ui_unlockLook_001",
    "Lines": "现在的我，说不定连传说中的龙也能打倒呢！"
  },
  "12704": {
    "Id": 12704,
    "Character": 127,
    "Type": 4,
    "voResource": "vo_127_ui_unlockCG_001",
    "Lines": "真是的……好像什么都瞒不住你呢……"
  },
  "12705": {
    "Id": 12705,
    "Character": 127,
    "Type": 5,
    "SkinId": 12703,
    "Lines": "拿起村里最好的宝剑，踏上勇者特丽莎的传奇冒险！欸~金光闪闪的宝箱？让我打开看看——呜哇——这是什么东西？！"
  },
  "13001": {
    "Id": 13001,
    "Character": 130,
    "Type": 1,
    "voResource": "vo_130_ui_gachaNew_001",
    "Lines": "初次见面，万送屋为您服务。\n无论是雪山还是雨林，\n你邮我寄，让信件平安传递！"
  },
  "13002": {
    "Id": 13002,
    "Character": 130,
    "Type": 2,
    "voResource": "vo_130_ui_gacha_001",
    "Lines": "诶？又见面了？\n啊哈哈，我才没有迷路！我是故意跟着你的。"
  },
  "13003": {
    "Id": 13003,
    "Character": 130,
    "Type": 3,
    "voResource": "vo_130_ui_unlockLook_001",
    "Lines": "哇呜，我是不是变得更可爱了？"
  },
  "13004": {
    "Id": 13004,
    "Character": 130,
    "Type": 4,
    "voResource": "vo_130_ui_unlockCG_001",
    "Lines": "多娜~可爱变身！"
  },
  "13201": {
    "Id": 13201,
    "Character": 132,
    "Type": 1,
    "voResource": "vo_132_ui_gachaNew_001",
    "Lines": "魔王，第一次正式合作，灰风不会辜负你的期望。"
  },
  "13202": {
    "Id": 13202,
    "Character": 132,
    "Type": 2,
    "voResource": "vo_132_ui_gacha_001",
    "Lines": "魔王，又见面了，我们的默契又多了一些。"
  },
  "13203": {
    "Id": 13203,
    "Character": 132,
    "Type": 3,
    "voResource": "vo_132_ui_unlockLook_001",
    "Lines": "只要和伙伴在一起就没什么好怕的。魔王，我们一起前进吧。"
  },
  "13204": {
    "Id": 13204,
    "Character": 132,
    "Type": 4,
    "voResource": "vo_132_ui_unlockCG_001",
    "Lines": "别光看我啊……你也坐过来挑本漫画看吧。会很开心的。"
  },
  "13205": {
    "Id": 13205,
    "Character": 132,
    "Type": 5,
    "SkinId": 13203,
    "Lines": "手臂传来课桌板的清凉，后背感知洒落阳光的温暖。\u000b书本的芬芳令人陶醉——这是一场微醺的白日梦。"
  },
  "13206": {
    "Id": 13206,
    "Character": 132,
    "Type": 5,
    "SkinId": 13204,
    "Lines": "对着镜子练习第一百零一次的冷酷表情，却在转头瞬间看到了你。于是所有伪装都崩溃，只剩下羞意。"
  },
  "13301": {
    "Id": 13301,
    "Character": 133,
    "Type": 1,
    "voResource": "vo_133_ui_gachaNew_001",
    "Lines": "你好，我是夏花。希望我能在未来的旅程中帮上你的忙，也希望你能给予我信赖，以后请多指教。"
  },
  "13302": {
    "Id": 13302,
    "Character": 133,
    "Type": 2,
    "voResource": "vo_133_ui_gacha_001",
    "Lines": "又见面了，感觉如何？\n……呵呵，我还挺开心的。"
  },
  "13303": {
    "Id": 13303,
    "Character": 133,
    "Type": 3,
    "voResource": "vo_133_ui_unlockLook_001",
    "Lines": "风与我同在。"
  },
  "13304": {
    "Id": 13304,
    "Character": 133,
    "Type": 4,
    "voResource": "vo_133_ui_unlockCG_001",
    "Lines": "下次有机会的话，我们再一起去哪里逛逛吧？"
  },
  "13305": {
    "Id": 13305,
    "Character": 133,
    "Type": 5,
    "SkinId": 13303,
    "Lines": "一缕气息，初夏的花朵悄然绽放。一种触感，就像与你一同握住风车的那只手。"
  },
  "13401": {
    "Id": 13401,
    "Character": 134,
    "Type": 1,
    "voResource": "vo_134_ui_gachaNew_001",
    "Lines": "师父您好！我……我我、我是冬香！\n……呜呜，怎么会这样，明明私下里练习了那么久，却还是咬到舌头了……"
  },
  "13402": {
    "Id": 13402,
    "Character": 134,
    "Type": 2,
    "voResource": "vo_134_ui_gacha_001",
    "Lines": "又、又见面了，如果您还需要我和花令旅团的力量，那就太好了……"
  },
  "13403": {
    "Id": 13403,
    "Character": 134,
    "Type": 3,
    "voResource": "vo_134_ui_unlockLook_001",
    "Lines": "为了回报您的信任，我一定会加倍努力！"
  },
  "13404": {
    "Id": 13404,
    "Character": 134,
    "Type": 4,
    "voResource": "vo_134_ui_unlockCG_001",
    "Lines": "呜，请、请不要盯着我看……"
  },
  "13405": {
    "Id": 13405,
    "Character": 134,
    "Type": 5,
    "SkinId": 13403,
    "Lines": "按时打卡不迟到，材料认真准备好。勤勤恳恳，战战兢兢。哎呦喂——扑通，怎么还是搞砸了？"
  },
  "13501": {
    "Id": 13501,
    "Character": 135,
    "Type": 1,
    "voResource": "vo_135_ui_gachaNew_001",
    "Lines": "找到你了！最近很火的那位魔王大人!\n我叫雾语……既是天才的魔女也是敏锐的记者！接受我的采访吧！"
  },
  "13502": {
    "Id": 13502,
    "Character": 135,
    "Type": 2,
    "voResource": "vo_135_ui_gacha_001",
    "Lines": "茄子！我又来拜访了！\n诶~这是啥表情？让我多收集收集！"
  },
  "13503": {
    "Id": 13503,
    "Character": 135,
    "Type": 3,
    "voResource": "vo_135_ui_unlockLook_001",
    "Lines": "和魔女一起，窥探世界的秘密吧！"
  },
  "13504": {
    "Id": 13504,
    "Character": 135,
    "Type": 4,
    "voResource": "vo_135_ui_unlockCG_001",
    "Lines": "我的秘密，你已经尽收眼底了！你的秘密，也快点呈上来吧！"
  },
  "13505": {
    "Id": 13505,
    "Character": 135,
    "Type": 5,
    "SkinId": 13503,
    "Lines": "沉醉于可可的甜蜜，扫帚划过星空，将烦恼抛之脑后——这是只属于你们的浪漫冒险。"
  },
  "13506": {
    "Id": 13506,
    "Character": 135,
    "Type": 5,
    "SkinId": 13504,
    "Lines": "哪怕是以真相为食的魔女，也偶尔需要一段时间的悠闲假日。\u000b伸着懒腰，看着夕阳，能有什么比这更悠闲的呢？"
  },
  "13701": {
    "Id": 13701,
    "Character": 137,
    "Type": 1,
    "voResource": "vo_137_ui_gachaNew_001",
    "Lines": "我已经等不及和前辈一起去冒险了！可以给我讲讲和星塔有关的故事吗？"
  },
  "13702": {
    "Id": 13702,
    "Character": 137,
    "Type": 2,
    "voResource": "vo_137_ui_gacha_001",
    "Lines": "《旅人好运手册》说得没错，只要一直想着某个人，就可以再次相遇……我和前辈一定是最完美的冒险搭档！"
  },
  "13703": {
    "Id": 13703,
    "Character": 137,
    "Type": 3,
    "voResource": "vo_137_ui_unlockLook_001",
    "Lines": "前辈，你会为我感到骄傲吗？"
  },
  "13704": {
    "Id": 13704,
    "Character": 137,
    "Type": 4,
    "voResource": "vo_137_ui_unlockCG_001",
    "Lines": "来，前辈，请牵住我的手。呵呵，没错，就是这样……前辈的手心，很温暖呢。"
  },
  "14001": {
    "Id": 14001,
    "Character": 140,
    "Type": 1,
    "voResource": "vo_140_ui_gachaNew_001",
    "Lines": "欢迎来到斯帕克拉的移动工坊……等等，这张脸可爱超标了……兔子派，超级行动派，快来打个招呼，之后这位就是我们的新朋友了~"
  },
  "14002": {
    "Id": 14002,
    "Character": 140,
    "Type": 2,
    "voResource": "vo_140_ui_gacha_001",
    "Lines": "你是决定……亲自参与魔王派的测试了吗？呵呵，对魔王派的发明者来说，这可真是一个好消息!"
  },
  "14003": {
    "Id": 14003,
    "Character": 140,
    "Type": 3,
    "voResource": "vo_140_ui_unlockLook_001",
    "Lines": "兔子派，冲呀！我们的童话冒险，正式启程~"
  },
  "14004": {
    "Id": 14004,
    "Character": 140,
    "Type": 4,
    "voResource": "vo_140_ui_unlockCG_001",
    "Lines": "呵呵，自从上次用这样的姿势敲开了灵感的大门后，我就发现……\n只要保持这样的姿势，就能促进大脑血液循环提高思考效率有助于我更好地进行头脑风暴。不过，要是太过专注的话，会不会感冒呢……？"
  },
  "14101": {
    "Id": 14101,
    "Character": 141,
    "Type": 1,
    "voResource": "vo_141_ui_gachaNew_001",
    "Lines": "我乃赤霞，云笈道场的正统玄师。初来乍到，愿以玄之法理……呃，这开场白好难背。总之，要给你画几张符吗？绝对灵验，不灵包售后。"
  },
  "14102": {
    "Id": 14102,
    "Character": 141,
    "Type": 2,
    "voResource": "vo_141_ui_gacha_001",
    "Lines": "又见面啦，看你气色不错，甚好甚好~怎么样，上次给你的符效果不错吧，要回购些不？"
  },
  "14103": {
    "Id": 14103,
    "Character": 141,
    "Type": 3,
    "voResource": "vo_141_ui_unlockLook_001",
    "Lines": "炎符天降，火德显彰。火符闪耀，赤焰昭昭。邪魅消散，万祸不殃。"
  },
  "14104": {
    "Id": 14104,
    "Character": 141,
    "Type": 4,
    "voResource": "vo_141_ui_unlockCG_001",
    "Lines": "那、那你现在就发誓，说你哪儿都不去，就呆在我旁边……动一下也不行！"
  },
  "14105": {
    "Id": 14105,
    "Character": 141,
    "Type": 5,
    "SkinId": 14103,
    "Lines": "谁说镜中的世界就是虚幻？\u000b当她戴上皇后的冠冕，主角与反派位置对调，荒诞成了律法，舞台中心向她转移。\u000b——欢迎来到属于红皇后的奇境。"
  },
  "14201": {
    "Id": 14201,
    "Character": 142,
    "Type": 1,
    "voResource": "vo_142_ui_gachaNew_001",
    "Lines": "我是珂赛特，永夜的清道夫。你……欸？魔王？不好，竟然这么轻易就在魔王面前暴露长相了……"
  },
  "14202": {
    "Id": 14202,
    "Character": 142,
    "Type": 2,
    "voResource": "vo_142_ui_gacha_001",
    "Lines": "啊哈哈……又、又见面啦？我明明藏得很好啊……"
  },
  "14203": {
    "Id": 14203,
    "Character": 142,
    "Type": 3,
    "voResource": "vo_142_ui_unlockLook_001",
    "Lines": "再怎么说，我也是永夜的清道夫，可不要小瞧我啊！"
  },
  "14204": {
    "Id": 14204,
    "Character": 142,
    "Type": 4,
    "voResource": "vo_142_ui_unlockCG_001",
    "Lines": "饮料好像卡住了，拿不出来，怎么办？摇一摇有用吗？"
  },
  "14205": {
    "Id": 14205,
    "Character": 142,
    "Type": 5,
    "SkinId": 14203,
    "Lines": "夏日的海边不过是阳光海水和沙滩，也并没有什么特别的——\u000b什么？！你说有海岛特供的清凉饮料？！那我也要去！"
  },
  "14301": {
    "Id": 14301,
    "Character": 143,
    "Type": 1,
    "voResource": "vo_143_ui_gachaNew_001",
    "Lines": "风影，即日起与你展开合作。目标是什么，直说就行。"
  },
  "14302": {
    "Id": 14302,
    "Character": 143,
    "Type": 2,
    "voResource": "vo_143_ui_gacha_001",
    "Lines": "又见面了，上次我们的合作得不错，之后也期待与你一起行动。"
  },
  "14303": {
    "Id": 14303,
    "Character": 143,
    "Type": 3,
    "voResource": "vo_143_ui_unlockLook_001",
    "Lines": "做好觉悟吧！你们无路可逃！"
  },
  "14304": {
    "Id": 14304,
    "Character": 143,
    "Type": 4,
    "voResource": "vo_143_ui_unlockCG_001",
    "Lines": "我可不是笨蛋。\n只有在信赖的人面前，才会暴露出这副毫无防备的样子。"
  },
  "14401": {
    "Id": 14401,
    "Character": 144,
    "Type": 1,
    "voResource": "vo_144_ui_gachaNew_001",
    "Lines": "妾身乃风息岛上精心锻造的利刃，名为千都世。为守护主公，妾身必将以至诚之心，竭力侍奉。"
  },
  "14402": {
    "Id": 14402,
    "Character": 144,
    "Type": 2,
    "voResource": "vo_144_ui_gacha_001",
    "Lines": "“纵然梦里常幽会，怎比真如见一回。”主公，又见到您真是太好了。"
  },
  "14403": {
    "Id": 14403,
    "Character": 144,
    "Type": 3,
    "voResource": "vo_144_ui_unlockLook_001",
    "Lines": "此刃此心，已不再迟疑。"
  },
  "14404": {
    "Id": 14404,
    "Character": 144,
    "Type": 4,
    "voResource": "vo_144_ui_unlockCG_001",
    "Lines": "主公，让我一直为您所用，好吗？"
  },
  "14405": {
    "Id": 14405,
    "Character": 144,
    "Type": 5,
    "SkinId": 14403,
    "Lines": "养在水里的牵牛花——它的鲜亮和淡香，能保持多久呢？"
  },
  "14501": {
    "Id": 14501,
    "Character": 145,
    "Type": 1,
    "voResource": "vo_145_ui_gachaNew_001",
    "Lines": "让我想想，第一次见面，该用哪种身份才能让你更加信任我呢？不过首先，请你记住“乙叶”这个名字。"
  },
  "14502": {
    "Id": 14502,
    "Character": 145,
    "Type": 2,
    "voResource": "vo_145_ui_gacha_001",
    "Lines": "初次见面，请多关照……呵呵，我当然记得你，这只是个用来调节气氛的小玩笑。"
  },
  "14503": {
    "Id": 14503,
    "Character": 145,
    "Type": 3,
    "voResource": "vo_145_ui_unlockLook_001",
    "Lines": "黑夜不仅适合掩藏秘密，也是清理垃圾的绝佳时刻。"
  },
  "14504": {
    "Id": 14504,
    "Character": 145,
    "Type": 4,
    "voResource": "vo_145_ui_unlockCG_001",
    "Lines": "即使是最完美的伪装，也需要一点“破绽”才显得真实。"
  },
  "14701": {
    "Id": 14701,
    "Character": 147,
    "Type": 1,
    "voResource": "vo_147_ui_gachaNew_001",
    "Lines": "自由贝斯手——焦糖！是名用琴弦连接星塔之音的乐手∼"
  },
  "14702": {
    "Id": 14702,
    "Character": 147,
    "Type": 2,
    "voResource": "vo_147_ui_gacha_001",
    "Lines": "您又来听我演奏啦~难道说……制作人喜欢上我的贝斯了？！这次想听什么曲子呢？"
  },
  "14703": {
    "Id": 14703,
    "Character": 147,
    "Type": 3,
    "voResource": "vo_147_ui_unlockLook_001",
    "Lines": "我，即是那迫近的风暴！"
  },
  "14704": {
    "Id": 14704,
    "Character": 147,
    "Type": 4,
    "voResource": "vo_147_ui_unlockCG_001",
    "Lines": "我的心声，有成功传达给你吗，制作人？"
  },
  "14705": {
    "Id": 14705,
    "Character": 147,
    "Type": 5,
    "SkinId": 14703,
    "Lines": "滴滴嘟滴嘟，让一让！演出马上就要开始啦——\n请听——梦梦萌萌，软软咚咚，叮叮当当的贝斯梦境！"
  },
  "14901": {
    "Id": 14901,
    "Character": 149,
    "Type": 1,
    "voResource": "vo_149_ui_gachaNew_001",
    "Lines": "我是恩赐意志的格芮，只要你能满足我心底的渴望，我就会为你展示更多“特别”的东西……呵呵，请不要让我等得太久哦。"
  },
  "14902": {
    "Id": 14902,
    "Character": 149,
    "Type": 2,
    "voResource": "vo_149_ui_gacha_001",
    "Lines": "魔王大人，只有您才能让我感受到满足……请给予我更多吧，我会把渴望与沉沦……全部奉献给您！"
  },
  "14903": {
    "Id": 14903,
    "Character": 149,
    "Type": 3,
    "voResource": "vo_149_ui_unlockLook_001",
    "Lines": "你不打算牵住我的项圈吗？可是……我的灵魂已经忍耐不住震颤了……不要欺负人嘛……"
  },
  "14904": {
    "Id": 14904,
    "Character": 149,
    "Type": 4,
    "voResource": "vo_149_ui_unlockCG_001",
    "Lines": "呵呵~握住别人的灵魂，感觉如何？"
  },
  "14905": {
    "Id": 14905,
    "Character": 149,
    "Type": 5,
    "SkinId": 14903,
    "Lines": "咖啡的酸涩，蔷薇的芳香，想将一切新奇的体验都与你分享。融雪后，来一场约会吧？"
  },
  "15001": {
    "Id": 15001,
    "Character": 150,
    "Type": 1,
    "voResource": "vo_150_ui_gachaNew_001",
    "Lines": "感到荣幸吧！在你面前的可是恩赐意志的精英——菈露大人！等会……我先接个通话。\n啊~老大！您讲，我在听。我……我现在正在出差，是是，那件事今天一定搞定，哪怕熬夜也会搞定。"
  },
  "15002": {
    "Id": 15002,
    "Character": 150,
    "Type": 2,
    "voResource": "vo_150_ui_gacha_001",
    "Lines": "哦，又见面了。有什么需求？先说说看吧。"
  },
  "15003": {
    "Id": 15003,
    "Character": 150,
    "Type": 3,
    "voResource": "vo_150_ui_unlockLook_001",
    "Lines": "休息得差不多了，下面就让你见识见识我的真本事吧。"
  },
  "15004": {
    "Id": 15004,
    "Character": 150,
    "Type": 4,
    "voResource": "vo_150_ui_unlockCG_001",
    "Lines": "对不起嘛~下次绝不会再犯了，我保证~\n——学会了吗？菈露大人的职场求生技。"
  },
  "15501": {
    "Id": 15501,
    "Character": 155,
    "Type": 1,
    "voResource": "vo_155_ui_gachaNew_001",
    "Lines": "正式自我介绍一下，我是希娅。你的身上，有着可以信任的气味呢。"
  },
  "15502": {
    "Id": 15502,
    "Character": 155,
    "Type": 2,
    "voResource": "vo_155_ui_gacha_001",
    "Lines": "又见面了~看来我们之间的缘分，比帆船的缆绳还要坚固呢。"
  },
  "15503": {
    "Id": 15503,
    "Character": 155,
    "Type": 3,
    "voResource": "vo_155_ui_unlockLook_001",
    "Lines": "一起来感受冲浪的魅力吧！"
  },
  "15504": {
    "Id": 15504,
    "Character": 155,
    "Type": 4,
    "voResource": "vo_155_ui_unlockCG_001",
    "Lines": "那一晚的月光与海浪，想必你也无法忘怀吧。"
  },
  "15505": {
    "Id": 15505,
    "Character": 155,
    "Type": 5,
    "SkinId": 15503,
    "Lines": "海水中洋溢着的，有珊瑚的味道，也有你的味道。闭上眼，仿佛被这一切温柔地拥入怀中。"
  },
  "15601": {
    "Id": 15601,
    "Character": 156,
    "Type": 1,
    "voResource": "vo_156_ui_gachaNew_001",
    "Lines": "我是花令旅团的小禾。说实话，我不太擅长努力啦……但是跟你在一起的话，稍稍努力一下也不是不行……"
  },
  "15602": {
    "Id": 15602,
    "Character": 156,
    "Type": 2,
    "voResource": "vo_156_ui_gacha_001",
    "Lines": "又见面啦……\n你先忙着，不用在意我。\n我们都放松一点就好啦。"
  },
  "15603": {
    "Id": 15603,
    "Character": 156,
    "Type": 3,
    "voResource": "vo_156_ui_unlockLook_001",
    "Lines": "咻咻咻！超绝厉害版小禾登场！"
  },
  "15604": {
    "Id": 15604,
    "Character": 156,
    "Type": 4,
    "voResource": "vo_156_ui_unlockCG_001",
    "Lines": "哇！嘿嘿，被吓到了吧~"
  },
  "15605": {
    "Id": 15605,
    "Character": 156,
    "Type": 5,
    "SkinId": 15603,
    "Lines": "生活不过是如此吧：吃一块歌剧院，再沏一壶红茶。梦想正在膨胀，直至茶壶吐出蒸汽泡泡。"
  },
  "15701": {
    "Id": 15701,
    "Character": 157,
    "Type": 1,
    "voResource": "vo_157_ui_gachaNew_001",
    "Lines": "我是花铃。先说好，我总有一天会成为名垂青史的航海旅人！不准因为我个子小就小看我哦！"
  },
  "15702": {
    "Id": 15702,
    "Character": 157,
    "Type": 2,
    "voResource": "vo_157_ui_gacha_001",
    "Lines": "又来找我了？哼，算你还有眼光……我就再帮你一次吧。"
  },
  "15703": {
    "Id": 15703,
    "Character": 157,
    "Type": 3,
    "voResource": "vo_157_ui_unlockLook_001",
    "Lines": "浪潮的声音，我听得一清二楚！"
  },
  "15704": {
    "Id": 15704,
    "Character": 157,
    "Type": 4,
    "voResource": "vo_157_ui_unlockCG_001",
    "Lines": "别看我啦……赶紧吃吧，冰沙要化掉了哦。"
  },
  "15801": {
    "Id": 15801,
    "Character": 158,
    "Type": 1,
    "voResource": "vo_158_ui_gachaNew_001",
    "Lines": "感到荣幸吧！在你面前的可是恩赐意志的精英——菈露大人！\n ……你那是什么表情？这只是恩赐意志发的雪愿节制服！"
  },
  "15802": {
    "Id": 15802,
    "Character": 158,
    "Type": 2,
    "voResource": "vo_158_ui_gacha_001",
    "Lines": "又见面啦，要跟我一起去发礼物吗？"
  },
  "15803": {
    "Id": 15803,
    "Character": 158,
    "Type": 3,
    "voResource": "vo_158_ui_unlockLook_001",
    "Lines": "礼物从天而降，这还不算惊喜吗？"
  },
  "15804": {
    "Id": 15804,
    "Character": 158,
    "Type": 4,
    "voResource": "vo_158_ui_unlockCG_001",
    "Lines": "唔……我怎么睡着了？"
  },
  "15901": {
    "Id": 15901,
    "Character": 159,
    "Type": 1,
    "voResource": "vo_159_ui_gachaNew_001",
    "Lines": "没想到会在这里相遇，看来我们缘分不浅。为了顺应节日氛围，我特意挑了这身装束，你觉得怎么样？"
  },
  "15902": {
    "Id": 15902,
    "Character": 159,
    "Type": 2,
    "voResource": "vo_159_ui_gacha_001",
    "Lines": "又见面了，看来你对我的针剂还是念念不忘。"
  },
  "15903": {
    "Id": 15903,
    "Character": 159,
    "Type": 3,
    "voResource": "vo_159_ui_unlockLook_001",
    "Lines": "你那颗躁动不安的心，就让我来让它鼓动得更加激烈吧。"
  },
  "15904": {
    "Id": 15904,
    "Character": 159,
    "Type": 4,
    "voResource": "vo_159_ui_unlockCG_001",
    "Lines": "这次换你来诊疗我，感觉怎么样？呵呵，手别停啊……"
  },
  "16001": {
    "Id": 16001,
    "Character": 160,
    "Type": 1,
    "voResource": "vo_160_ui_gachaNew_001",
    "Lines": "能和你们一起来海边真的很难得，希望大家能度过一个开心的假日。啊，但如果做了危险的事，我会“温柔警告”的哦~"
  },
  "16002": {
    "Id": 16002,
    "Character": 160,
    "Type": 2,
    "voResource": "vo_160_ui_gacha_001",
    "Lines": "看样子，这片海暂时还离不开我呢，那就让我继续陪着大家吧~"
  },
  "16003": {
    "Id": 16003,
    "Character": 160,
    "Type": 3,
    "voResource": "vo_160_ui_unlockLook_001",
    "Lines": "口头警告无效的话，就别怪我不客气了。"
  },
  "16004": {
    "Id": 16004,
    "Character": 160,
    "Type": 4,
    "voResource": "vo_160_ui_unlockCG_001",
    "Lines": "已经到了该回去的时间了，不过……\n夕阳真美啊，我们再多待一会儿吧。"
  },
  "16201": {
    "Id": 16201,
    "Character": 162,
    "Type": 1,
    "voResource": "vo_162_ui_gachaNew_001",
    "Lines": "菲兰尼斯守夜人队长，应召而来。虽然我不擅长魔法，但剑术还算可靠。我会与你并肩作战，用这把剑，守护你珍视的一切。"
  },
  "16202": {
    "Id": 16202,
    "Character": 162,
    "Type": 2,
    "voResource": "vo_162_ui_gacha_001",
    "Lines": "“相逢即是有缘，再遇便是命运”……我们能再次相遇，或许真的是命运吧？"
  },
  "16203": {
    "Id": 16203,
    "Character": 162,
    "Type": 3,
    "voResource": "vo_162_ui_unlockLook_001",
    "Lines": "无论命运将你带向何方，我都会守在你身边，为你扫清前路的阻碍。"
  },
  "16204": {
    "Id": 16204,
    "Character": 162,
    "Type": 4,
    "voResource": "vo_162_ui_unlockCG_001",
    "Lines": "怎么了？不快点去清洗身体的话，会着凉的。"
  },
  "13901": {
    "Id": 13901,
    "Character": 139,
    "Type": 1,
    "voResource": "vo_139_ui_gachaNew_001",
    "Lines": "我是艾蕾，雏菊孤儿院的院长。如果你愿意，可以把这里当作暂时歇脚的地方。要是能陪孩子们一起玩一会儿，大家一定会很高兴的。"
  },
  "13902": {
    "Id": 13902,
    "Character": 139,
    "Type": 2,
    "voResource": "vo_139_ui_gacha_001",
    "Lines": "又见面了，这段时间你过得怎么样？有按时吃饭吗？"
  },
  "13903": {
    "Id": 13903,
    "Character": 139,
    "Type": 3,
    "voResource": "vo_139_ui_unlockLook_001",
    "Lines": "孤儿院的孩子们……还有魔王，就由我来守护！"
  },
  "13904": {
    "Id": 13904,
    "Character": 139,
    "Type": 4,
    "voResource": "vo_139_ui_unlockCG_001",
    "Lines": "现在这样……就像是在掀开新娘的头纱……"
  }
}