[
  {
    "id": 433791697152,
    "value": "jp角湖湖畔"
  },
  {
    "id": 433791697408,
    "value": "jp因形似犄角而得名的水域，也是距离夏露露村最近的垂钓之地。夏露露村合全村之力在此地建起渔屋，方便村民们使用。"
  },
  {
    "id": 438086664448,
    "value": "jp浮叶川沿岸"
  },
  {
    "id": 438086664704,
    "value": "jp流经倚风林地的主要河流，弯道众多，河底坑洞密布，各类游鱼在随水流漂浮的落叶掩映下自由穿梭。"
  },
  {
    "id": 442381631744,
    "value": "jp谧影溪支流"
  },
  {
    "id": 442381632000,
    "value": "jp蜿蜒于圣地花园的隐秘静溪，林间影影绰绰的雾气丝毫不影响溪水清澈见底，游鱼灵巧地游走在溪底的石缝之间。"
  },
  {
    "id": 446676599040,
    "value": "jp落羽湖"
  },
  {
    "id": 446676599296,
    "value": "jp位于山崖之下的湖泊，得名于翼人成长过程中必须经历的飞行试炼。落羽湖面积不大，却有着丰富的渔类资源。"
  },
  {
    "id": 450971566336,
    "value": "jp派卡栈桥"
  },
  {
    "id": 450971566592,
    "value": "jp派卡栈桥延伸向水面，附近的湖水温暖而富含养分，吸引了众多鱼类聚集。村民们在这里搭建的渔场简易却实用，成为村中的钓鱼圣地。"
  },
  {
    "id": 4290672328960,
    "value": "jp雪山钓鱼点"
  },
  {
    "id": 4290672329216,
    "value": "jp测试用雪山钓鱼点，钓鱼点，点点点，点点点点点……"
  },
