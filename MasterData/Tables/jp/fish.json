  },
  {
    "id": 12884902144,
    "value": "jp大目鱼"
  },
  {
    "id": 12884902656,
    "value": "jp新芽山谷地区常见的淡水鱼，由于一双大眼睛非常醒目，得名大目鱼。成年后的个体间差异不大，经常作为衡量其他鱼类大小的标准。"
  },
  {
    "id": 12884904704,
    "value": "jp尚未发现"
  },
  {
    "id": 17179869440,
    "value": "jp快行鱼"
  },
  {
    "id": 17179869952,
    "value": "jp常见于新芽山谷急流中的淡水鱼，鱼身有着很强的流线感，也得益于这样的身体结构，它们能在水中极为快速地游动。"
  },
  {
    "id": 17179872000,
    "value": "jp尚未发现"
  },
  {
    "id": 21474836736,
    "value": "jp雀尾鱼"
  },
  {
    "id": 21474837248,
    "value": "jp角湖常见的鱼类品种，体型中等，游速中等，口感中等，但尾鳍如同鸟雀，非常美丽，会被作为观赏鱼饲养。"
  },
  {
    "id": 21474839296,
    "value": "jp尚未发现"
  },
  {
    "id": 25769804032,
    "value": "jp圆鲶"
  },
  {
    "id": 25769804544,
    "value": "jp常见的鲶鱼品种，一般夜间活动，生长迅速，肉质细嫩多脂、营养丰富。"
  },
  {
    "id": 25769806592,
    "value": "jp尚未发现"
  },
  {
    "id": 30064771328,
    "value": "jp流纹斗鱼"
  },
  {
    "id": 30064771840,
    "value": "jp性格如其名的鱼类，张扬好斗，溢彩流光的鱼鳍和鱼尾十分美丽。"
  },
  {
    "id": 30064773888,
    "value": "jp尚未发现"
  },
  {
    "id": 34359738624,
    "value": "jp银星鲈"
  },
  {
    "id": 34359739136,
    "value": "jp常见的鲈鱼品种，体侧有零散分布的银色斑点，因此而得名。以浮游动物和水草为食，常见于浅水。"
  },
  {
    "id": 34359741184,
    "value": "jp尚未发现"
  },
  {
    "id": 38654705920,
    "value": "jp骨尾鱼"
  },
  {
    "id": 38654706432,
    "value": "jp分布于淡水水域的鱼类，尾鳍有硬骨支撑，摆动有力，上钩时容易挣脱。"
  },
  {
    "id": 38654708480,
    "value": "jp尚未发现"
  },
  {
    "id": 42949673216,
    "value": "jp条纹刀鲚"
  },
  {
    "id": 42949673728,
    "value": "jp一种小型淡水鱼，不过除了淡水水域之外，在混有海水的入海口地区也可以生存。"
  },
  {
    "id": 42949675776,
    "value": "jp尚未发现"
  },
  {
    "id": 47244640512,
    "value": "jp气球鱼"
  },
  {
    "id": 47244641024,
    "value": "jp分布于淡水水域的鱼类品种，体型圆滚，行动较为迟缓，易于捕捉，肉质十分鲜美。"
  },
  {
    "id": 47244643072,
    "value": "jp尚未发现"
  },
  {
    "id": 51539607808,
    "value": "jp雾叶鱼"
  },
  {
    "id": 51539608320,
    "value": "jp原产于雾叶密林的鱼类，体色会随温度而发生变化，通常栖息在江河底层，个体不大。"
  },
  {
    "id": 51539610368,
    "value": "jp尚未发现"
  },
  {
    "id": 55834575104,
    "value": "jp玻璃猫鱼"
  },
  {
    "id": 55834575616,
    "value": "jp罕见的全身透明的鱼类，鱼骨清晰可见，形似玻璃制成。又因嘴角长着两根长长的触须如同小猫，因而得名。"
  },
  {
    "id": 55834577664,
    "value": "jp尚未发现"
  },
  {
    "id": 60129542400,
    "value": "jp攀瀑鱼"
  },
  {
    "id": 60129542912,
    "value": "jp体型小而狭长的鱼类，行动灵活，韧性强筋，甚至能沿着水道逆流而上，因此常生活在山崖瀑布附近。"
  },
  {
    "id": 60129544960,
    "value": "jp尚未发现"
  },
  {
    "id": 64424509696,
    "value": "jp蜜蜂鱼"
  },
  {
    "id": 64424510208,
    "value": "jp体型较小、性格温和的鱼类，多栖息于温暖的净水之中，黄黑相间的外表十分可爱。"
  },
  {
    "id": 64424512256,
    "value": "jp尚未发现"
  },
  {
    "id": 68719476992,
    "value": "jp蓝灯罗非鱼"
  },
  {
    "id": 68719477504,
    "value": "jp栖息于湖泊与深潭的罗非鱼，因蓝色的眼睛非常明亮，被称作蓝灯罗非鱼，是新芽山谷地区少见的鱼类品种。"
  },
