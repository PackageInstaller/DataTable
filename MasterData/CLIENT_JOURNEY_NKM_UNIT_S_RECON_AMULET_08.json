    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "소동을 일으킨 테러리스트들은 모두 검거되었습니다.",
      "UnitTalk_JPN": "騒ぎを起こしたテロリストは皆、検挙されました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "다만, 그것으로 이들이 자칭한 <color=#F7BE45>쇼가스</color>라는 단체가 궤멸한 것인지는… 아직 수사 중에 있습니다.",
      "UnitTalk_JPN": "ただし、彼らが名乗る<color=#F7BE45>ショッカーンズ</color>という組織が壊滅したのかどうかは…まだ調査中です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "미래에 대해 막연한 불안감을 갖고 있던 사람들을 꼬드겨서, 선전 및 파괴 활동을 하면 자금을 대주던 세력이 있던 것 같습니다.",
      "UnitTalk_JPN": "未来に漠然とした不安を抱く人々をそそのかし、宣伝や破壊活動の見返りに資金を援助する勢力がいたようです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아마도 이번에 검거된 것은 수많은 꼬리 조직 중 하나… ",
      "UnitTalk_JPN": "恐らく今回検挙されたのは、末端組織の一つに過ぎないでしょう。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "정말로 <color=#F7BE45>악의 조직</color>이 있는 것인지는 모르겠습니다만, 반드시 뿌리까지 찾아내어 뽑아내겠습니다.",
      "UnitTalk_JPN": "本当に<color=#F7BE45>悪の組織</color>がいるのかどうかは分かりませんが、必ず元凶を突き止め、排除してみせます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 94,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "그것이…",
      "UnitTalk_JPN": "それが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "스텔라 레인저의 사명이니까?",
          "JumpAnchorStringId_JPN": "ステラーレンジャーの使命だから？"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "…짓궂으십니다, 단장님.",
      "UnitTalk_JPN": "…団長は意地悪ですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "사건과 관련된 이야기는 여기서 끝입니다.",
      "UnitTalk_JPN": "事件に関する話はここまでです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "목이 마르거나 배가 고프시지는 않으십니까? 마음껏 드십시오.",
      "UnitTalk_JPN": "喉が乾いていたり、お腹が減ってはいませんか？どうぞ、遠慮なくお召し上がりください。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "제가 사는 겁니다.",
      "UnitTalk_JPN": "私のおごりです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "워터 젤리와 초코바밖에 안 보여…",
          "JumpAnchorStringId_JPN": "ゼリー飲料とチョコバーしかないけど…"
        }
      ]
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "영화 감상에 방해가 되지 않는 음식들로 준비했습니다.",
      "UnitTalk_JPN": "映画鑑賞の邪魔にならないものだけを用意しましたから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "곧 시작하는군요.",
      "UnitTalk_JPN": "まもなく始まります。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "스크린 화면에서 <color=#F7BE45>스텔라 레인저 : 별과 별의 탈환 작전</color>이라는 글자가 떠올랐다.",
      "UnitTalk_JPN": "スクリーンには、<color=#F7BE45>ステラーレンジャー : 星と星の奪還作戦</color>という文字が浮かんでいる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "영화에 집중하려는 순간, 옆에서 루그가 말을 걸어왔다.",
      "UnitTalk_JPN": "映画に集中しようとしていると、横からルーが声をかけてきた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "단장님. 본론입니다.",
      "UnitTalk_JPN": "団長。本論です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "제가 중요한 이야기가 있다고 말씀드리지 않았습니까?",
      "UnitTalk_JPN": "大事なお話があるとお伝えしたでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "아까 이야기도 중요하지만, 사실 지금 이야기가 제일 중요합니다.",
      "UnitTalk_JPN": "先ほどの話もそうですが、これからお話することの方が大事です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "누구에게도 알리고 싶지 않은…",
      "UnitTalk_JPN": "誰にも知られたくない…",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "오직 단장님에게만 전하고 싶은 이야기.",
      "UnitTalk_JPN": "団長にだけお伝えしたいお話です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "제가 스텔라 레인저에 끌렸던 이유… 여정에 참여한 이유…",
      "UnitTalk_JPN": "私がステラーレンジャーに惹かれる理由も…旅に参加した理由も…",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "제가 찾은 답은 바로.",
      "UnitTalk_JPN": "見つけた答えはー",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_15.mp3",
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "<color=#F7BE45>동경</color>이었습니다.",
      "UnitTalk_JPN": "<color=#F7BE45>憧れ</color>です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "동경?",
          "JumpAnchorStringId_JPN": "憧れ？"
        }
      ]
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "그렇습니다.",
      "UnitTalk_JPN": "はい。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "단장님. 저는 어릴 때부터 고통을 느끼지 못했습니다.",
      "UnitTalk_JPN": "団長。私は幼い頃から、痛みを感じませんでした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "그래서 사람들을 이해하지 못했습니다.",
      "UnitTalk_JPN": "そのため、人々を理解できませんでした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "왜 다치면 우는지, 슬퍼하는지…",
      "UnitTalk_JPN": "どうして怪我をすれば泣くのか、悲しがるのか…",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
