      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "후후! 알고 있다! ",
      "UnitTalk_JPN": "ふふ！知ってるのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitTalk_KOR": "다 알고 있으면서도 한번 물어봤다! ",
      "UnitTalk_JPN": "知ってるけど、聞いてみたのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "나중에 딴 소리를 하면 안 되니까 말이야! ",
      "UnitTalk_JPN": "後でそうでなかった、と言われても困るからな！",
