    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "누가 소매를 당겨서 뒤를 돌아보니…",
      "UnitTalk_JPN": "誰かに袖を引っ張られ、振り返ると…",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "정지.",
      "UnitTalk_JPN": "停止。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "설문조사 중이야. 참여할래?",
      "UnitTalk_JPN": "アンケート実施中。参加する？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "지금이라면 내가 만든 줄자를 줄 수도 있어. 유용한 도구.",
      "UnitTalk_JPN": "今なら、手作りのメジャーをプレゼント。便利な道具。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "길이도 재고, 과일도 깎아 먹을 수 있어. 알람과 녹음도 가능.",
      "UnitTalk_JPN": "長さも測れるし、果物もむける。アラームも録音も可能。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "뭘 조사하는데?",
          "JumpAnchorStringId_JPN": "何のアンケート？"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "참여자들의 웃음을 조사하고 있어.",
      "UnitTalk_JPN": "参加者たちの笑いについて調査中。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "나는 웃는 게 서투르니까. 다른 사람의 웃음을 참고하고 연구하고 분석해서 재현하려 해.",
      "UnitTalk_JPN": "私は笑うのが苦手。他の人の笑いを参考に、分析したり研究して再現しようとしてる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그럼 첫 번째 질문.",
      "UnitTalk_JPN": "じゃあ、一つ目の質問。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "하루에 몇 번 웃어?",
      "UnitTalk_JPN": "一日に何回笑う？",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "세 본 적 없는데...",
          "JumpAnchorStringId_JPN": "数えたことないよ…"
        }
      ]
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…답변으로서의 상대 정확도 부적합. 구체적인 수치를 요구.",
      "UnitTalk_JPN": "…回答としての相対精度が低い。具体的な数値を要求。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "설문조사가 끝나면 절대기준에 따라 점수를 측정. 기준치를 만족시키지 못하면 사은품은 줄 수 없어.",
      "UnitTalk_JPN": "アンケートが終われば、絶対基準に基づいて点数を測定。基準値に満たない場合、プレゼントはなし。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "물론 반대 사례도 존재. 최고 점수를 기록하면 특제 줄자를 줄게.",
      "UnitTalk_JPN": "逆に、謝礼もあり。最高点を記録すれば、特製メジャーをプレゼント。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "카본 재질이라 가볍고 튼튼. 최대 시속 144.17km까지 달릴 수 있어.",
      "UnitTalk_JPN": "カーボン素材により、軽くて丈夫。最大時速144.17kmで走行可能。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "줄자랑 거리가 멀어지고 있는데.",
          "JumpAnchorStringId_JPN": "何か、本来の用途から脱線してない？"
        }
      ]
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "비유는 해석이 필요하니 직관적인 단어로 표현 요청.",
      "UnitTalk_JPN": "比喩には解釈が必要。直感的な単語での表現を要請。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "지금까지의 답변으로는 줄자를 줄 수 없어. 정밀성을 높여.",
      "UnitTalk_JPN": "今までの回答だと、メジャーはあげられない。精密性の向上を要求。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "계속해서 두 번째 질문.",
      "UnitTalk_JPN": "次、二つ目の質問。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": false,
      "WaitTime": 0.8,
      "BgFadeInStartCol": [
        "0",
        "0",
        "0",
        "0"
      ],
      "BgFadeInCol": [
        "0",
        "0",
        "0",
        "1"
      ],
      "BgFadeInTime": 0.8
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이어지는 스마일의 질문에 하나씩 답변했다.",
      "UnitTalk_JPN": "続くスマイルの質問に、私はひとつずつ答えた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARTEXT",
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": false,
      "WaitTime": 0.8,
      "BgFadeOutCol": [
        "0",
        "0",
        "0",
        "0"
      ],
      "BgFadeOutTime": 0.8
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "점수 측정 중… 대기…",
      "UnitTalk_JPN": "点数を測定中…待機…",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "ONE_3",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "채점 완료. 아쉽지만 기준치 미달이야.",
      "UnitTalk_JPN": "採点完了。残念ながら、基準値未達。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "줄자는 줄 수 없게 됐지만 아차상으로 캔 뱃지를 줄게.",
      "UnitTalk_JPN": "メジャーはあげられないけど、残念賞の缶バッチを贈呈。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "다음엔 더 나아진 모습을 보여 달라고 응원하며 미량의 사회 생활 첨가.",
      "UnitTalk_JPN": "次はうまく行くよと応援し、社会適応力アップ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "터무니없이 솔직하구나.",
          "JumpAnchorStringId_JPN": "とんでもなく正直だね。"
        }
      ]
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "나중에 또 협조해 주면 세로토닌 분비가 촉진될 것 같아.",
      "UnitTalk_JPN": "また協力してくれたら、セロトニンの分泌が促進されそう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아, 참고로.",
      "UnitTalk_JPN": "あ、参考までに。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "그 캔 뱃지. 직사광선 및 열에 노출시키면 안 돼. 저온 저습한 곳에 보관. 보호장치가 손상될 수 있는 고전압 환경에서 착용하는 건 절대 금지.",
      "UnitTalk_JPN": "その缶バッチ。直射日光および熱は避けること。低温低湿な場所で保管。保護装置が損傷するおそれのある高電圧環境での着用は絶対禁止。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이상, 취급 시 주의사항 전달 완료.",
      "UnitTalk_JPN": "以上、取り扱い時の注意事項、伝達完了。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "사양할게.",
          "JumpAnchorStringId_JPN": "遠慮しとくよ。"
        }
      ]
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "……? 사고 정지.",
      "UnitTalk_JPN": "……？思考停止。",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_SMILE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
