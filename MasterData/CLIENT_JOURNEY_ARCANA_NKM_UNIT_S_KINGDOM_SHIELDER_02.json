    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "NOA의 거리를 거닐던 중, 누군가 큰소리를 내며 실랑이를 벌이고 있기에 구경하러 갔다.",
      "UnitTalk_JPN": "NOAの街を散歩中…誰かが大声で言い争っていたため、見に行ってみた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": false,
      "WaitTime": -1.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitPos": "POS2"
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "ANGRY",
      "UnitPos": "POS1",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "다시 한번 말하지만, 그건 안 됩니다!",
      "UnitTalk_JPN": "もう一度言いますが、それは駄目です！",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "왜 안돼?! 내가 하겠다는데 뭐가 문제야?",
      "UnitTalk_JPN": "なによ！なんで駄目なのよ！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "도대체 제정신으로 하는 소리세요?",
      "UnitTalk_JPN": "一体、何をおっしゃっているのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "NOA에서 사람을 빼 와서 공국의 신하로 만들겠다니, 말이 됩니까?",
      "UnitTalk_JPN": "NOAから人を連れ出して、公国の臣下にするなんてありえません！",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "왜 말이 안 돼?",
      "UnitTalk_JPN": "何がありえないの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "요즘 능력 있는 녀석들은 여기에 다 모이고 있잖아.",
      "UnitTalk_JPN": "最近、有能な人はみんなここに集まってるのよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "검증된 인재들이 모이는 장소인데, 그냥 놔둘 이유가 있어?",
      "UnitTalk_JPN": "能力が証明された人材が集まる場所なのに、放っておく理由があるって言うの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SAD",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "…아이디어는 나쁘지 않습니다. 하지만 방법이 한참 잘못됐어요.",
      "UnitTalk_JPN": "…アイデアは悪くありませんが…やり方が根本的に間違っています。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "다짜고짜 뇌물로 사람을 흔들면 안 되는 겁니다!",
      "UnitTalk_JPN": "いきなり賄賂を差し出して、人を揺さぶるなんていけません！",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "뇌물이 아니라 <color=#F7BE45>경제적 옵션</color>이라고.",
      "UnitTalk_JPN": "賄賂じゃなくって、<color=#F7BE45>経済的なオプション</color>だってば。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "원래 <color=#F7BE45>막대한 돈</color>으로 사람 꼬시는 건 전통적인 비즈니스 방법이야!",
      "UnitTalk_JPN": "そもそも<color=#F7BE45>巨額のお金</color>で人を誘惑するのは、伝統的なビジネスのやり方なのよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "굉장히 이상한 대화들이 오가는데…",
          "JumpAnchorStringId_JPN": "かなりおかしな会話が行き交っている。"
        }
      ]
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "TWIN_4",
      "UnitMotion": "NORMAL",
      "UnitPos": "POS9",
      "UnitTalk_KOR": "프레이님, 샤를님. 길 한복판에서 이런 걸로 다투지 말고…",
      "UnitTalk_JPN": "フレイ様、シャルル様。道の真ん中でこんな言い争いをするのは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "어? 카르멘이었어?",
          "JumpAnchorStringId_JPN": "あれ？カルメン？"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "앗? 단장님?",
      "UnitTalk_JPN": "あら？団長さん？",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그런데 무슨 일이야?",
          "JumpAnchorStringId_JPN": "えっと、何が起こってるの？"
        }
      ]
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "아~ 네. 일행끼리 조금 의견 차이가 있어서요.",
      "UnitTalk_JPN": "仲間内で、意見が分かれてしまって。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "너무 신경 쓰지 마세요. 종종 있는 일인데…",
      "UnitTalk_JPN": "でも、あまり気になさらないでくださいね。よくあることですので…",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그런가…? 아무튼 도움이 필요하면 말해줘.",
          "JumpAnchorStringId_JPN": "そうなのか…？私にできることがあれば言ってくれ。"
        }
      ]
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후, 감사해요.",
      "UnitTalk_JPN": "ふふっ、ありがとうございます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "역시 좋은 사람이신 것 같아요 단장님은.",
      "UnitTalk_JPN": "やはり良い人ですね、団長さんは。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "CameraOffset": "TWIN_1",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "카르멘! 먼저 갈게! ",
      "UnitTalk_JPN": "カルメン！先に戻ってるから！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "우리 보급관님이 더 이상한 말을 하기 전에 빨리 어디든 데려가야겠어!",
      "UnitTalk_JPN": "この補給官殿がもっとおかしなことを言い出す前に、早く連れて行かないと！",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 1.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "이거 놓으라니까! ",
      "UnitTalk_JPN": "放しなさいってば！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "기사단장이 공녀를 이렇게 질질 끌고 가도 되는 거야?!",
      "UnitTalk_JPN": "騎士団長が、こうやって公女を引きずって行ってもいいと思ってるの！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "언제는 그냥 평범한 보급관이라면서요?!",
      "UnitTalk_JPN": "前は平凡な補給官だと言っていたでしょう！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "둘 중 하나만 하시죠!",
      "UnitTalk_JPN": "どちらか一つにしてください！",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "TWIN_4",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "아… 하하. 먼저 가 있으세요. 전 나중에 따라갈게요.",
      "UnitTalk_JPN": "あ…ははっ。お先にどうぞ。私は後で追いかけますね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "꽤 피곤해 보이네.",
          "JumpAnchorStringId_JPN": "大変だね。"
        }
      ]
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "뭐 그래도, 보기보다 사이가 나쁘진 않은 편이에요.",
      "UnitTalk_JPN": "でも、意外と仲が悪いわけではないのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "친할수록 더 싸운다는 말도 있잖아요?",
      "UnitTalk_JPN": "喧嘩するほど仲がいいという言葉もあるでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그런가?",
          "JumpAnchorStringId_JPN": "そうなのか？"
        }
      ]
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "네, 그래도 이번엔 공... 아니, 보급관님의 아이디어가 심상치가 않네요.",
      "UnitTalk_JPN": "はい。でも今回は、公…ではなくて、補給官さまがただならぬアイデアを出されましたね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
