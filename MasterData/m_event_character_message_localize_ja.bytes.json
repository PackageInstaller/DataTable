[
    {
        "character_message_id": 10001001,
        "message": "良き素材を集められるよう、\n任務に励んでまいりましょう！",
        "created_at": "2026-02-20 20:41:00",
        "updated_at": "2026-02-20 20:41:00",
        "deleted_at": null
    },
    {
        "character_message_id": 10001002,
        "message": "いらっしゃい、お安くしときますよ～",
        "created_at": "2026-02-20 20:41:00",
        "updated_at": "2026-02-20 20:41:00",
        "deleted_at": null
    },
    {
        "character_message_id": 10001003,
        "message": "何でもご用命ください。\nどんな手を使ってでも仕入れてみせますよ！",
        "created_at": "2026-02-20 20:41:00",
        "updated_at": "2026-02-20 20:41:00",
        "deleted_at": null
    },
    {
        "character_message_id": 10001004,
        "message": "稼いだ分、御自らにご褒美を\n差し上げても良いのでは？",
        "created_at": "2026-02-20 20:41:00",
        "updated_at": "2026-02-20 20:41:00",
        "deleted_at": null
    },
    {
        "character_message_id": 10001005,
        "message": "いつでもどこでも、\n貴方のシメフナが承ります",
        "created_at": "2026-02-20 20:41:00",
        "updated_at": "2026-02-20 20:41:00",
        "deleted_at": null
    },
    {
        "character_message_id": 10001006,
        "message": "見ていかれるだけでも構いませんよ～！\nいつか買ってくだされば！",
        "created_at": "2026-02-20 20:41:00",
        "updated_at": "2026-02-20 20:41:00",
        "deleted_at": null
    },
    {
        "character_message_id": 10001007,
        "message": "入口です",
        "created_at": "2026-02-20 20:41:00",
        "updated_at": "2026-02-20 20:41:00",
        "deleted_at": null
    },
    {
        "character_message_id": 11301001,
        "message": "遣島隊の技の見せ所ですね。\nお役目を共に果たしましょう！",
        "created_at": "2026-02-20 20:41:00",
        "updated_at": "2026-02-20 20:41:00",
        "deleted_at": null
    }
]