      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "훈련 계획서를 고치고 있었거든.",
          "JumpAnchorStringId_JPN": "旅の計画書を修正してたんだ。"
        }
      ]
