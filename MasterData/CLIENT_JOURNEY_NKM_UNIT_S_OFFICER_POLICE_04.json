    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "으와, 피곤하지 않으세요?",
      "UnitTalk_JPN": "うわぁ、大丈夫ですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "안 그래도 오늘 훈련 때도 몸을 엄청 많이 쓰셨는데!",
      "UnitTalk_JPN": "今日のトレーニングだけでも、相当疲れてるはずなのに！",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "내 몸보다 훈련과 단원이 무조건 먼저… 라고요.",
      "UnitTalk_JPN": "自分の体よりも、団員とトレーニングが優先…ですか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…응, 역시. 성실하셔. 성실하셔.",
      "UnitTalk_JPN": "…うん、やっぱり。団長って真面目ですよね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "안나는 왜 안 쉬고?",
          "JumpAnchorStringId_JPN": "アンナは寝ずに何してたの？"
        }
      ]
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "아, 저도 급하게 타운가드 지원을 다녀오는 길이예요. 현장 신고 대응이죠.",
      "UnitTalk_JPN": "あたしも、緊急でタウンガードの応援に行ってきたところなんです。現場の通報対応でした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "휴직 중이긴 하지만, 역시 본업은 본업이니까- 라는 느낌!",
      "UnitTalk_JPN": "休職中とはいえ、やっぱ本職はタウンガードですから！",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그런데 돌아오는 길에 보니, 이 방만 불이 켜져 있는 게 아니겠어요?",
      "UnitTalk_JPN": "それで…帰り道に通りかかったら、この部屋だけ明かりがついてたんですよー？",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "SMILE_LOOP",
      "UnitTalk_KOR": "긴급 지원이 필요한 밤샘 동지인가 했는데, 역시 맞았네요!",
      "UnitTalk_JPN": "応援が必要な徹夜仲間かな～と思って見に来たら、大正解でしたね！",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "안나는 생글생글 웃으며 품에 안은 종이봉투를 내밀었다.",
      "UnitTalk_JPN": "アンナはそう言うと、抱えていた紙袋を笑顔で差し出した。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "긴급 지원?",
          "JumpAnchorStringId_JPN": "応援？"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "네! 달콤한 향기가 종이 너머로도 솔솔 나지 않나요?",
      "UnitTalk_JPN": "はい！紙袋の中から、甘い香りが漂ってきませんか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "먹을 수 있을 때 미리 먹어두는 게 좋아요.",
      "UnitTalk_JPN": "食べられる時に食べておいた方がいいですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "밤샘은 체력 싸움이니까요! ",
      "UnitTalk_JPN": "徹夜は体力勝負ですから！",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_04",
      "WaitClick": true,
