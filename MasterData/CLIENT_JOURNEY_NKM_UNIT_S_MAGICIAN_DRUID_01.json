    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitTalk_KOR": "죄송해요. 밑에 사람이 있는 줄 모르고 그만...",
      "UnitTalk_JPN": "すみません。下に人がいるとは知らずに…",
      "UnitTalk_TWN": "對不起，我不知道下面有人，就不小心…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_5.ogg"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitTalk_KOR": "프랜시스! 으아아앙, 걱정했잖아~!",
      "UnitTalk_JPN": "フランシス！うわーん、心配したじゃない～！",
      "UnitTalk_TWN": "法蘭西斯！嗚嗚嗚，我好擔心你啊～！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_ANIMAL_CAT.wav",
      "UnitNameString": [
        "SI_TABBYCAT"
      ],
      "UnitTalk_KOR": "냐앙~!",
      "UnitTalk_JPN": "ニャ～ン！",
      "UnitTalk_TWN": "喵～！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitTalk_KOR": "프랜시스를 구해줘서 고마워, 언니!",
      "UnitTalk_JPN": "フランシスを助けてくれてありがとう、おねえちゃん！",
      "UnitTalk_TWN": "姊姊，謝謝你救了法蘭西斯！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 뭘 이런 걸 가지고.",
      "UnitTalk_JPN": "あはは！これくらい、どうってことないよ。",
      "UnitTalk_TWN": "啊哈哈！這點小事算什麼。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_6.ogg"
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "프랜시스는 호기심이 많은 아이 같아. 다음부터는 놓치지 않게 주의해야 돼?",
      "UnitTalk_JPN": "フランシスは好奇心が強い子みたいだね。次からは離しちゃダメだよ？",
      "UnitTalk_TWN": "法蘭西斯看起來充滿了好奇心，下次要注意別讓牠走丟哦？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_7.ogg"
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitTalk_KOR": "응! 알았어. 조심할게.",
      "UnitTalk_JPN": "うん！気をつけるね。",
      "UnitTalk_TWN": "嗯！知道了，我會小心的。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitTalk_KOR": "고마워, 언니. 나중에 또 봐!",
      "UnitTalk_JPN": "ありがとう、おねえちゃん。またね！",
      "UnitTalk_TWN": "姊姊謝謝你，下次再見！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그래, 나중에 봐~",
      "UnitTalk_JPN": "うん、またね～。",
      "UnitTalk_TWN": "好，下次見～",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_8.ogg"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…슬슬 내려와줄래?",
          "JumpAnchorStringId_JPN": "…そろそろ降りてもらってもいい？",
          "JumpAnchorStringId_TWN": "…可以請你從我身上下來嗎？"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아아앗! 맞다!",
      "UnitTalk_JPN": "あああっ！そうでした！",
      "UnitTalk_TWN": "啊啊啊！對吼！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_9.ogg"
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitTalk_KOR": "죄, 죄, 죄송해요! 많이 무거우셨죠?",
      "UnitTalk_JPN": "す、す、すみません！重かったですよね？",
      "UnitTalk_TWN": "對、對、對不起！很重吧？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_10.ogg"
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitTalk_KOR": "네? 여러가지 의미로 괜찮다고요?",
      "UnitTalk_JPN": "はい？色んな意味で大丈夫…ですか？",
      "UnitTalk_TWN": "什麼？你說以各方面來說都沒事嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_11.ogg"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitTalk_KOR": "그, 그렇다면 다행이지만…",
      "UnitTalk_JPN": "そ、それなら良いんですが…",
      "UnitTalk_TWN": "那、那就好…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_12.ogg"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
