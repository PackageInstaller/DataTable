    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "그런데 어디서 본 것 같은데요?",
      "UnitTalk_JPN": "ところで、どこかでお見かけしたような…？",
      "UnitTalk_TWN": "但是您看起來好眼熟…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_13.ogg"
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "앗! 설마!",
      "UnitTalk_JPN": "あっ！まさか！",
      "UnitTalk_TWN": "啊！難道！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_14.ogg"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "유명한 분인가요? 몰라 봬서 죄송해요!",
      "UnitTalk_JPN": "有名な方ですか？気づかなくてすみません！",
      "UnitTalk_TWN": "您是名人嗎？真抱歉沒能認出來！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_15.ogg"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "사실 제가 고향에서만 살다가 NOA에는 어제 처음 왔거든요.",
      "UnitTalk_JPN": "実はわたし、ずっと故郷で暮らしていて…NOAには昨日初めて来たんです。",
      "UnitTalk_TWN": "其實我一直住在家鄉，昨天才第一次來到NOA。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_16.ogg"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "고향이 NOA랑 먼 곳에 있나 보네?",
          "JumpAnchorStringId_JPN": "なら、故郷はNOAから離れた所にあるんだね？",
          "JumpAnchorStringId_TWN": "看來你的家鄉離NOA很遠吧？"
        }
      ]
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 네, 저 멀리 카노푸스 산맥 산골짜기에 있어요.",
      "UnitTalk_JPN": "あはは！そうなんです。あの遠くに見えるカノプス山脈の、そのまた奥にあります。",
      "UnitTalk_TWN": "啊哈哈！是啊，在遙遠的卡諾普斯山脈的山谷裡。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_17.ogg"
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "전기는 물론, 수도도 안 들어오는 시골 마을이죠.",
      "UnitTalk_JPN": "電気はもちろん、水道も通らない田舎の村です。",
      "UnitTalk_TWN": "是連電力和自來水都沒有的鄉下小村莊。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_18.ogg"
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그런데 어디서 봤을까요…? 잡지? 전단지? 아니면 현수막이었나?",
      "UnitTalk_JPN": "しかし、どこでお見かけしたのでしょうか…？雑誌？チラシ？それとも垂れ幕とか？",
      "UnitTalk_TWN": "但我到底在哪見過您呢…？雜誌？傳單？還是布條？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_19.ogg"
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "뭔가 오해가 있는 것 같은데…",
          "JumpAnchorStringId_JPN": "何か誤解してるみたいだけど…",
          "JumpAnchorStringId_TWN": "你好像有什麼誤會…"
        }
      ]
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
