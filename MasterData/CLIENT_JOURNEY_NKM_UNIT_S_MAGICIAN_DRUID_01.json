      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_DANA"
      ],
      "UnitTalk_KOR": "아야야…!",
      "UnitTalk_JPN": "あいたた…！",
      "UnitTalk_TWN": "好痛…！",
