    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_6",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "단장님이셨군요!",
      "UnitTalk_JPN": "団長だったんですね！",
      "UnitTalk_TWN": "原來您是團長啊！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_21.ogg"
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "캔들 스퀘어에서 들은 모습 그대로예요. 어쩐지 어디서 본 것 같더라니.",
      "UnitTalk_JPN": "キャンドル・スクエアでお聞きしたとおりの方ですね。どうりで見覚えがあると思いました。",
      "UnitTalk_TWN": "您跟我在燭光廣場聽到的樣子一模一樣，難怪我覺得眼熟。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_22.ogg"
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>여정 단원</color>, 맞지?",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>旅の団員</color>、だよね？",
          "JumpAnchorStringId_TWN": "你是<color=#F7BE45>旅行團員</color>，對吧？"
        }
      ]
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "네! 제가 <color=#F7BE45>여정 단원</color>, 카노푸스 경비대의 다나랍니다.",
      "UnitTalk_JPN": "はい！わたしが<color=#F7BE45>旅の団員</color>、カノプス警備隊のダーナです。",
      "UnitTalk_TWN": "對！我是<color=#F7BE45>旅行團員</color>，卡諾普斯警備隊的達娜。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_23.ogg"
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "NOA에는 어제 막 도착했어요.",
      "UnitTalk_JPN": "NOAには、昨日着いたばかりなんです。",
      "UnitTalk_TWN": "我昨天才剛到NOA。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_24.ogg"
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "도시도, <color=#F7BE45>여정</color>도 처음이라 많이 서툴겠죠.",
      "UnitTalk_JPN": "都会も<color=#F7BE45>救援の旅</color>も初めてなので、至らないところもあるかと思いますが…",
      "UnitTalk_TWN": "城市和<color=#F7BE45>旅行</color>對我來說都是第一次，所以我肯定會很生疏。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_25.ogg"
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "하지만 최선을 다하겠습니다!",
      "UnitTalk_JPN": "精一杯がんばります！",
      "UnitTalk_TWN": "但我會全力以赴！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_26.ogg"
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "높은 산도 꾸준히 걸어가면 언젠가는 정상에 다다를 수 있으니까요!",
      "UnitTalk_JPN": "どんなに高い山でも…一歩ずつ登っていけば、必ず頂上に辿りつけるものですから！",
      "UnitTalk_TWN": "因為只要持續向上爬，即使是再高的山峰，總有一天也能到達頂端！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_27.ogg"
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>여정</color>에 참가한 목적이 뭐야?",
          "JumpAnchorStringId_JPN": "どうして<color=#F7BE45>救援の旅</color>に参加したの？",
          "JumpAnchorStringId_TWN": "你參加<color=#F7BE45>旅行</color>的目的是什麼？"
        }
      ]
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "제가 <color=#F7BE45>여정</color>에 참가한 목적… 그건 바로!",
      "UnitTalk_JPN": "わたしが<color=#F7BE45>救援の旅</color>に参加した理由…それはズバリ！",
      "UnitTalk_TWN": "我參加<color=#F7BE45>旅行</color>的目的…就是！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_28.ogg"
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "<color=#F7BE45>사람들의 웃는 모습</color>이 보고 싶어서요!",
      "UnitTalk_JPN": "<color=#F7BE45>みんなの笑顔</color>が見たいからです！",
      "UnitTalk_TWN": "想看到<color=#F7BE45>人們歡笑的樣子</color>！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_29.ogg"
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…웃는 모습?",
          "JumpAnchorStringId_JPN": "…笑顔？",
          "JumpAnchorStringId_TWN": "…歡笑的樣子？"
        }
      ]
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "아하하! 네, 웃는 모습이요.",
      "UnitTalk_JPN": "あはは！そうなんです。",
      "UnitTalk_TWN": "啊哈哈！是的，歡笑的樣子。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_30.ogg"
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "다른 사람이 웃는 모습을 보면, 보는 사람도 기분이 좋아지잖아요?",
      "UnitTalk_JPN": "笑顔って、見ている人までいい気分になりますよね？",
      "UnitTalk_TWN": "看到別人笑，連看的人也會心情變好不是嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_31.ogg"
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "드루이드 사이에는 <color=#F7BE45>로로카</color>라는 말이 있어요.",
      "UnitTalk_JPN": "ドルイドには、<color=#F7BE45>ロロカ</color>という言葉があります。",
      "UnitTalk_TWN": "我們德魯伊人之間有<color=#F7BE45>洛洛卡</color>這個詞。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_32.ogg"
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>선행을 베풀면 세상이 행복해진다</color>, <color=#F7BE45>선행은 언젠가 되돌아온다</color>",
      "UnitTalk_JPN": "<color=#F7BE45>善を行うと世界が幸せになる</color>、<color=#F7BE45>めぐり巡って自分に返ってくる</color>。",
      "UnitTalk_TWN": "意思是<color=#F7BE45>行善會讓世界變幸福</color>，<color=#F7BE45>善行總有一天會有回報</color>。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_33.ogg"
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "그 밖에 많은 의미가 있지만, 중요한 의미는 <color=#F7BE45>서로 도와 행복해진다</color>는 거죠!",
      "UnitTalk_JPN": "他にも色んな意味がありますが、大事なのは<color=#F7BE45>助け合い幸せになる</color>ということです！",
      "UnitTalk_TWN": "雖然還有很多其他意思，但最重要的意思是大家<color=#F7BE45>互相幫助才會變得幸福</color>！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_34.ogg"
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그래서 다른 사람을 <color=#F7BE45>로로카</color>하는 게 제 취미예요. 사람들의 미소가 좋으니까!",
      "UnitTalk_JPN": "だから他の人を<color=#F7BE45>ロロカ</color>するのが、わたしの趣味なんです。みんなの笑顔が好きだから！",
      "UnitTalk_TWN": "所以我的興趣就是讓別人<color=#F7BE45>洛洛卡</color>。因為我喜歡看到人們的笑容！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_35.ogg"
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>여정</color>을 통과하면 더 많은 사람을 도울 수 있다고 들었어요.",
      "UnitTalk_JPN": "<color=#F7BE45>救援の旅</color>を成し遂げることができれば、より多くの人の力になれるのでしょう？",
      "UnitTalk_TWN": "我聽說通過<color=#F7BE45>旅行</color>後就能幫助更多人。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_36.ogg"
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "그 옛날 암흑시대에 <color=#F7BE45>별의 구원자</color>님이 사람들을 미소 짓게 만든 것처럼요!",
      "UnitTalk_JPN": "遠い昔の暗黒時代に、<color=#F7BE45>星の救援者</color>さまがみんなを笑顔にしたように！",
      "UnitTalk_TWN": "就像古時候黑暗時代的<color=#F7BE45>星之救援者</color>讓人們展露笑容那樣！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_37.ogg"
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK"
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT_FEMALE_4",
      "UnitNameString": [
        "SI_SHYVOICEWOMAN"
      ],
      "CameraOffset": "TWIN_3",
      "UnitMotion": "SAD",
      "UnitQuickSet": true,
      "UnitPos": "POS8",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "어떡하지?! 시간 내에 배달해야 되는데.",
      "UnitTalk_JPN": "どうしよう！？時間内に届けないといけないのに。",
      "UnitTalk_TWN": "該怎麼辦？！必須在時間內送達的說。",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT_FEMALE_4",
      "UnitNameString": [
        "SI_SHYVOICEWOMAN"
      ],
      "UnitTalk_KOR": "혼자서 가능할까?",
      "UnitTalk_JPN": "一人でできるかしら？",
      "UnitTalk_TWN": "我一個人行嗎？",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "TWIN_1",
      "UnitMotion": "SPECIAL",
      "UnitPos": "POS6",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "앗! 혹시 도움이 필요하시나요?",
      "UnitTalk_JPN": "あっ！何かお困りですか？",
      "UnitTalk_TWN": "啊！請問您需要幫忙嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_01_DRUID_38.ogg"
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_MOVEMENT_FOOT_STEP_04.wav",
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "곤란해하는 사람의 목소리가 들려오자 다나는 망설임 없이 뛰어갔다.",
      "UnitTalk_JPN": "困っている様子を見ると、ダーナは迷いなく走って行った。",
      "UnitTalk_TWN": "一聽到有人感到為難的聲音，達娜便毫不猶豫地跑了過去。",
      "TalkTime": 0.03
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "<color=#F7BE45>사람들의 웃는 모습</color>이 좋다. 사람을 돕는 게 취미.",
      "UnitTalk_JPN": "<color=#F7BE45>みんなの笑顔</color>が好き。人助けするのが趣味。",
      "UnitTalk_TWN": "她喜歡看到<color=#F7BE45>人們歡笑的樣子</color>，興趣是幫助別人。",
      "TalkTime": 0.03
    },
