{
  "$schema": "../../../../../DataSchema/Exported.jsonc",
  "$comment": "name: JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
  "_Version": 4,
  "Data": [
    {
      "Uid": 1,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "RewardAnchor": "REWARD_ANCHOR_1",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_CANDLE_MAIN.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_10.mp3",
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "NORMAL",
      "UnitPos": "POS3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "그때는 정말 다들 어떻게 해야 할지 몰라서 발만 동동 구르고 있었죠.",
      "UnitTalk_JPN": "あの時は皆、どうすればいいのかも分からずただ途方に暮れていました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "하지만 그 순간 카넬리아 님이 등장하셨습니다.",
      "UnitTalk_JPN": "しかしその時、カネリア様が現れました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "그리고 엄한 표정으로 말씀하셨죠.",
      "UnitTalk_JPN": "そして、厳しい表情でおっしゃったのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "<color=#F7BE45>지금 이 순간에도 밤낮으로 세계를 구하기 위해 힘쓰고 계신 구원자님들이 계십니다.</color>",
      "UnitTalk_JPN": "<color=#F7BE45>今この瞬間にも、救援者様たちは昼夜を問わず奮闘してくださっています。</color>",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "<color=#F7BE45>그분들을 도와 더 많은 사람을 구하도록 보좌하는 것. 그것이 저희 메이드들이 이곳에 있는 이유.</color>",
      "UnitTalk_JPN": "<color=#F7BE45>あの方々をサポートし、より多くの人々を救えるように支えること。それが私たちメイドの使命です。</color>",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "<color=#F7BE45>그런 저희가 겨우 이 정도의 어려움을 극복하지 못하고 허둥대는 일은 있을 수 없습니다.</color> 라고 하시더군요.",
      "UnitTalk_JPN": "<color=#F7BE45>我々がこの程度の困難を乗り越えられずに狼狽えることなど、あってはなりません。</color>と。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그 뒤로 카넬리아 님은 직접 저희를 지휘하셨고, 그러자 정말 모든 문제가 잡음 하나 없이…",
      "UnitTalk_JPN": "その後…カネリア様が直々に指揮を執ると、すべての問題がスムーズに解決され…",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "…단장님? 주무시나요?",
      "UnitTalk_JPN": "…団長？寝ていらっしゃるのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "음? 아! 응. 듣고 있어.",
          "JumpAnchorStringId_JPN": "ん？あっ！うん。聞いてるよ。"
        }
      ]
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "크흠… 제가 너무 흥분했나 봅니다.",
      "UnitTalk_JPN": "くっ…少し興奮しすぎたようです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "카넬리아 님을 존경하는 마음에 그만 지나쳤군요.",
      "UnitTalk_JPN": "カネリア様を尊敬するあまり、取り乱してしまいましたね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그러니까 요지는, 재난에 휩쓸려 죽을 뻔했던 당시 카넬리아 님이 저를 구해주셨다는 사실입니다.",
      "UnitTalk_JPN": "要するに…災害に巻き込まれ命を落としかけていた私を、カネリア様が救ってくださったということです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "저는 그 이후로 삶의 목표를 얻었습니다. ",
      "UnitTalk_JPN": "私はそれ以降、人生の目標ができました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "카넬리아 님 같은 메이드장이 되어 사람들을 구하겠다는 목표를 말입니다.",
      "UnitTalk_JPN": "カネリア様のようなメイド長になり、人々を救うという目標です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그분이 아니었다면 저는 아마 그때 죽었거나…",
      "UnitTalk_JPN": "あのお方がいらっしゃらなければ、私は命を落としていたか…",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "아니면… 음. ",
      "UnitTalk_JPN": "もしくは…うーん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그전까지는 뭘 했는데?",
          "JumpAnchorStringId_JPN": "それまでは何をしてたんだ？"
        }
      ]
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "그 전… 말씀이십니까?",
      "UnitTalk_JPN": "その前…ですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "응. 메이드가 되기 전.",
          "JumpAnchorStringId_JPN": "うん、メイドになる前。"
        }
      ]
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "프라이버시입니다. ",
      "UnitTalk_JPN": "プライバシーの侵害です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "단장님, 여성의 과거는 묻지 않는 게 예의라는 걸 모르십니까?",
      "UnitTalk_JPN": "団長。女性の過去を詮索するのはマナー違反だということをご存じないのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "여태 잘 이야기 해놓고…",
          "JumpAnchorStringId_JPN": "今まで散々話してたくせに…"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…제 과거는 별것 없습니다.",
      "UnitTalk_JPN": "…私の過去など、大したことありません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "중요한 건 카넬리아 님이 제 인생을 옳은 길로 이끌어 주셨다는 거죠.",
      "UnitTalk_JPN": "重要なのは、カネリア様が私の人生を正しい道へと導いてくださったことです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그 사람은 지금 어디 있는데? 캔들 스퀘어?",
          "JumpAnchorStringId_JPN": "その人は、今どこにいるの？キャンドル・スクエア？"
        }
      ]
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…카넬리아 님은 현재 부재중이십니다. ",
      "UnitTalk_JPN": "…カネリア様は現在、不在です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "몇 년 전, 아무 말씀도 없이 홀연히 캔들 스퀘어를 떠나셨거든요. ",
      "UnitTalk_JPN": "数年前、何もおっしゃらずに突然キャンドル・スクエアを出ていかれました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래서 부득이하게 최선임인 제가 대신 메이드장의 역할을 맡고 있습니다. ",
      "UnitTalk_JPN": "そのため、やむをえずノーブルメイドである私がメイド長の代理を務めています。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "최대한 그 분을 닮으려 노력하고 있습니다만… 아직 많이 부족하네요.",
      "UnitTalk_JPN": "カネリア様に近づけるようにと、懸命に努力はしていますが…まだまだです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "워낙 훌륭하셨던 분이니까요.",
      "UnitTalk_JPN": "本当に素晴らしい方でしたので。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그래도 막 이곳에 왔을 때보다는 할 만합니다.",
      "UnitTalk_JPN": "それでも、ここに来たばかりの頃よりは成長できました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "그것도 역시 카넬리아 님이 주신 이 책 덕분이에요.",
      "UnitTalk_JPN": "それもやはり、カネリア様がくださったこの本のおかげです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "클레어는 상당한 두께의 책을 하나 꺼내 들며 자랑스러운 표정으로 바라보았다.",
      "UnitTalk_JPN": "クレアはかなり分厚い本を取り出すと、自慢気に見つめた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "<color=#F7BE45>캔들 스퀘어의 초보 컨시어지 메이드를 위한 상세한 참고 사항과 추천 행동양식에 대한 간략한 선택지를 제시하는 가이드북</color>.",
      "UnitTalk_JPN": "<color=#F7BE45>キャンドル・スクエアの初心者コンシェルジュメイドのための詳細な参考事項と、振る舞いに関する簡略な選択肢を提示するガイドブック。</color>",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "길어…!",
          "JumpAnchorStringId_JPN": "ながっ…！"
        }
      ]
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "줄여서 <color=#F7BE45>초보자 가이드북</color>이죠.",
      "UnitTalk_JPN": "略して<color=#F7BE45>初心者ガイドブック</color>です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
