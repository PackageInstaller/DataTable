[
  {
    "id": 4397167685918740,
    "key": "BuddyTalk_BadgeUnlock",
    "value": "隊長さん！<color=#e78800><b>『サポートバッジ』</b></color>をゲットしましたね！\n今日はサポートバッジの使い方を紹介させてください！"
  },
  {
    "id": 4397167685918741,
    "key": "BuddyTalk_BadgeExplain",
    "value": "サポートバッジは装備することで、\nバディに<color=#e78800><b>『アビリティを付与』</b></color>できますよ！\n 早速装備してみましょう！"
  },
  {
    "id": 6668561035550723,
    "key": "BuddyTalk_BattleTutorial_FinishRushMode",
    "value": "まだまだ……\nもう一度です！\n一気に畳み掛けましょう！"
  },
  {
    "id": 6668561035550724,
    "key": "BuddyTalk_BattleTutorial_ReturnHome",
    "value": "お疲れ様です。隊長さん！素晴らしい指揮でした！\nしかし、まだ事件は解決しておりません。\n早速、次の捜査に向かいましょう！"
  },
  {
    "id": 7056342538772481,
    "key": "BuddyTalk_BattleTutorial_Token",
    "value": "状態異常を駆使することで\n戦いをより有利に進めることができます！"
  },
  {
    "id": 7056342538772484,
    "key": "BuddyTalk_BattleTutorial_ChargeAttack_1",
    "value": "一部のエネミーはガードの効かない\n<color=#e78800><b>『チャージアタック』</b></color>をしてくることがあります"
  },
  {
    "id": 7056342538772485,
    "key": "BuddyTalk_BattleTutorial_ChargeAttack_2",
    "value": "<color=#e78800><b>『チャージアタック』</b></color>は攻撃の前に\n敵に一定以上のダメージを与えることで\n止めることができます"
  },
  {
    "id": 31958806664568835,
    "key": "BuddyTalk_BattleTutorial_ColorCombo_2",
    "value": "リンクコンボが繋がるカードは枠が光ります\n手札で光っている<color=#e78800><b>『赤カード』</b></color>を使ってみましょう！"
  },
  {
    "id": 32015928317341697,
    "key": "BuddyTalk_BadgeExplain_2",
    "value": "<color=#e78800><b>『バッジ』</b></color>に付与されるアビリティはランダムです"
  },
  {
    "id": 36998616571699200,
    "key": "BuddyTalk_BattleTutorial_Start",
    "value": "通報にあった暴走ワークロイドを発見！\n隊長さん！\n<color=#e78800><b>『カード』</b></color>で私に指示をお願いします！"
  },
  {
    "id": 32016677583613952,
    "key": "BuddyTalk_BattleTutorial_ColorCombo_1",
    "value": "同じ色の<color=#e78800><b>『カード』</b></color>を連続で使うと<color=#e78800><b>『リンクコンボ』</b></color>となり\n隊長さんと私のリンクが深まります！\n実際にやってみましょう"
  },
  {
    "id": 32019279750787072,
    "key": "BuddyTalk_BattleTutorial_ColorCombo_3",
    "value": "<color=#e78800><b>『リンクコンボ』</b></color>をしたことで私とのリンクが深まり\n<color=#e78800><b>『リンクゲージ』</b></color>が溜まりました！"
  },
  {
    "id": 32019279792730112,
    "key": "BuddyTalk_BattleTutorial_ColorCombo_4",
    "value": "次は、どの色とも繋がる特別な\n<color=#e78800><b>『ワイルドカード』</b></color>を使ってみましょう！"
  },
  {
    "id": 34567118891507712,
    "key": "BuddyTalk_Tutorial11_Home01",
    "value": "隊長さん！待ってください！\n今の装備のまま、捜査に向かうのは危険です"
  },
  {
    "id": 34567118899896320,
    "key": "BuddyTalk_Tutorial11_Home02_1",
    "value": "こちらを見てください！\nここの<color=#e78800><b>『推奨戦闘力』</b></color>は\n事件で遭遇する敵の強さを表しています"
  },
  {
    "id": 34567118899896321,
    "key": "BuddyTalk_Tutorial11_Home02_2",
    "value": "そして、こちらの<color=#e78800><b>『戦闘力』</b></color>は\n私たちバディの強さを表しています"
  },
  {
    "id": 34567118899896322,
    "key": "BuddyTalk_Tutorial11_Home02_3",
    "value": "私たちの<color=#e78800><b>『戦闘力』</b></color>が<color=#e78800><b>『推奨戦闘力』</b></color>より低いと\n敵の強さが大幅に上がります。\nこのままでは負けてしまうかもしれません…"
  },
  {
    "id": 34567118899896323,
    "key": "BuddyTalk_Tutorial11_Home02_4",
    "value": "そこで！\n今からショップに向かい、\n新たな<color=#e78800><b>『カード』</b></color>を手に入れましょう！"
  },
  {
    "id": 34567118899896324,
    "key": "BuddyTalk_Tutorial11_ShopGacha01_1",
    "value": "<color=#e78800><b>『ガチャ』</b></color>を回す事で<color=#e78800><b>『カード』</b></color>を入手することができますよ！\n沢山回して強いカードをゲットしてくださいね！"
  },
  {
    "id": 34567118899896325,
    "key": "BuddyTalk_Tutorial11_ShopGacha01_2",
    "value": "さらに！<color=#e78800><b>『ピックアップガチャ』</b></color>を回す事で、\n<color=#e78800><b>『バディガチャチケット』</b></color>がもらえますよ！\n沢山回したくなっちゃいますね！"
  },
  {
    "id": 34567118899896326,
    "key": "BuddyTalk_Tutorial11_ShopGacha01_3",
    "value": "それでは早速、手に入れた<color=#e78800><b>『カード』</b></color>を\n<color=#e78800><b>『デッキ』</b></color>に組み込みましょう！"
  },
  {
    "id": 35186185495109632,
    "key": "BuddyTalk_Tutorial10_Home01",
    "value": "隊長さん、初任務お疲れ様でした！さすが隊長さんです…！\n訓練の時から変わらず的確な判断で、見事に事件解決です！"
  },
  {
    "id": 35186185499303936,
    "key": "BuddyTalk_Tutorial10_Home02",
    "value": "（……それにしても、誰が『ワークロイド』のハッキングなんか…この街で何が起きてるというの…？）"
  },
  {
    "id": 35186185499303937,
    "key": "BuddyTalk_Tutorial11_Defeat01",
    "value": "ごめんなさい…　失敗しちゃいましたね\nでも　あと少しでした！"
  },
  {
    "id": 35533598298726400,
    "key": "BuddyTalk_Tutorial12_Home01",
    "value": "隊長さん！\n先ほどの事件現場で\n<color=#e78800><b>『強化パーツ』</b></color>を見つけましたね？"
  },
  {
    "id": 35533598298726404,
    "key": "BuddyTalk_Tutorial12_HomeAfter01",
    "value": "カードの強化で少しだけ強くなりました！\nこれで次の捜査も何とかなりそうですね！"
  },
  {
    "id": 35533598298726405,
    "key": "BuddyTalk_Tutorial13_Home01_1",
    "value": "先ほど<color=#e78800><b>『カード』</b></color>を手に入れましたね？\n今度はカードを<color=#e78800><b>『合成』</b></color>して、\nより強力なカードにしちゃいましょう！"
  },
  {
    "id": 35533598302920704,
    "key": "BuddyTalk_Tutorial13_CardSynthesis01_1",
    "value": "カードを合成して<color=#e78800><b>『グレードアップ』</b></color>させると\nカードの<color=#e78800><b>『ステータス』</b></color>が上がります！"
  },
  {
    "id": 35533598302920705,
    "key": "BuddyTalk_Tutorial13_CardSynthesis01_2",
    "value": "<color=#e78800><b>『合成』</b></color>を繰り返すことで、\nカードの<color=#e78800><b>『グレード』</b></color>を上げて、\n強くしていきましょう！"
  },
  {
    "id": 35533598302920706,
    "key": "BuddyTalk_Tutorial13_CardSynthesis01_3",
    "value": "また、低いグレードのカードはまとめて\n<color=#e78800><b>『クイック合成』</b></color>でグレードアップできます。\n便利ですね！"
  },
  {
    "id": 35533598302920707,
    "key": "BuddyTalk_Tutorial13_CardSynthesis01_4",
    "value": "それでは、<color=#e78800><b>『クイック合成』</b></color>をやってみましょう！"
  },
  {
    "id": 35590564039614464,
    "key": "BuddyTalk_Tutorial14_Home01",
    "value": "格納庫が解放されたので、私達、<color=#e78800><b>『バディ』</b></color>の変更や強化が出来るようになりました。\n早速、行ってみましょう！"
  },
  {
    "id": 35590564039614465,
    "key": "BuddyTalk_Tutorial14_Buddy01",
    "value": "まずは私達バディを<color=#e78800><b>『育成』</b></color>する方法を\nお教えしますね"
  },
  {
    "id": 35590564039614466,
    "key": "BuddyTalk_Tutorial14_BuddyBuild01",
    "value": "残念ながら今は私しか配備されていないので…\n今回は私を<color=#e78800><b>『育成』</b></color>してみてください！"
  },
  {
    "id": 35590564039614467,
    "key": "BuddyTalk_Tutorial14_BuddyAfter01_1",
    "value": "隊長さん！レベルアップしてくださって\nありがとうございます！"
  },
  {
    "id": 35590564039614468,
    "key": "BuddyTalk_Tutorial14_BuddyAfter01_2",
    "value": "格納庫ではレベルアップ以外にもバディコアを\n消費することで、バディの<color=#e78800><b>『チューンアップ』</b></color>や\n<color=#e78800><b>『加入申請』</b></color>をすることもできますよ！"
  },
  {
    "id": 35590564043808768,
    "key": "BuddyTalk_Tutorial14_BuddyAfter01_3",
    "value": "バディコアは<color=#e78800><b>『バディガチャ』</b></color>や<color=#e78800><b>『シーズンパス』</b></color>等で\n獲得できますよ！"
  },
  {
    "id": 35590564043808769,
    "key": "BuddyTalk_Tutorial15_Home01_1",
    "value": "隊長さん！\n街の治安を守るためにも\n<color=#e78800><b>『パトロール』</b></color>にいきましょう！"
  },
  {
    "id": 35590564043808770,
    "key": "BuddyTalk_Tutorial15_Home01_2",
    "value": "<color=#e78800><b>『パトロール』</b></color>は時間経過で報酬が貯まり\n最大12時間分まで蓄積できます\n街の治安は私たちにお任せください！"
  },
  {
    "id": 35590564043808771,
    "key": "BuddyTalk_Tutorial15_Patrol01_1",
    "value": "<color=#e78800><b>『クイックパトロール』</b></color>を行い\nスタミナを消費することで\n報酬をすぐに入手することもできますよ！"
  },
  {
    "id": 35590564043808772,
    "key": "BuddyTalk_Tutorial15_Patrol01_2",
    "value": "さらに<color=#e78800><b>『事件』</b></color>を解決していく事で、\n得られる報酬の量が増えていきます。\n頑張りましょうね！"
  },
  {
    "id": 35590564043808773,
    "key": "BuddyTalk_Tutorial15_Patrol01_3",
    "value": "<color=#e78800><b>『クイックパトロール』</b></color>を行い\nスタミナを消費することで\n報酬をすぐに入手することもできますよ！"
  },
  {
    "id": 35590564043808774,
    "key": "BuddyTalk_Tutorial15_Patrol01_4",
    "value": "それでは！\n一度<color=#e78800><b>『ホーム』</b></color>に戻りましょう！"
  },
  {
    "id": 35590564043808775,
    "key": "BuddyTalk_Tutorial15_Home02",
    "value": "さらに<color=#e78800><b>『ラボ』</b></color>の利用許可が降りました！\n詳細はラボに行かれたときにご紹介しますね！"
  },
  {
    "id": 35590564043808776,
    "key": "BuddyTalk_Tutorial15_Lab01_1",
    "value": "ラボへようこそ！\nこちらでは、バディを<color=#e78800><b>『アップデート』</b></color>し、\n強くすることができますよ！"
  },
  {
    "id": 35590564043808777,
    "key": "BuddyTalk_Tutorial15_Lab01_2",
    "value": "アップデートありがとうございます！\nアップデートは<color=#e78800><b>『全バディ』</b></color>に効果があります。\nお得ですね！"
  },
  {
    "id": 35617075471835136,
    "key": "BuddyTalk_Tutorial16_Home01",
    "value": "<color=#e78800><b>『事件簿』</b></color>の閲覧許可が降りました。\nこれで、様々な事件を捜査しに行くことができます。\n早速行ってみましょう！"
  },
  {
    "id": 35617075476029440,
    "key": "BuddyTalk_Tutorial16_EventQuest01_1",
    "value": "<color=#e78800><b>『事件簿』</b></color>へようこそ！\nこちらでは、様々な<color=#e78800><b>『事件』</b></color>に挑戦することが\nできるようになっています！"
  },
  {
    "id": 35617075476029441,
    "key": "BuddyTalk_Tutorial16_EventQuest01_2",
    "value": "現在は<color=#e78800><b>『強盗追跡』</b></color>、<color=#e78800><b>『密輸取締』</b></color>、<color=#e78800><b>『定期巡回』</b></color>に関する\n事件簿の閲覧権限を持っていますね…。"
  },
  {
    "id": 35617075476029442,
    "key": "BuddyTalk_Tutorial16_EventQuest01_3",
    "value": "それぞれ上記のような報酬を獲得できますよ！\n<color=#e78800><b>『1日1回』</b></color>ずつ挑戦できますので、毎日挑戦しましょう！\nよかったら挑戦してみてくださいね！"
  },
  {
    "id": 35617075476029443,
    "key": "BuddyTalk_Tutorial16_EventQuest01_4",
    "value": "積極的に挑戦してみてください！"
  },
  {
    "id": 35617075476029444,
    "key": "BuddyTalk_Tutorial17_Mission01_1",
    "value": "隊長さん！\n今度は<color=#e78800><b>『ミッション』</b></color>が解放されましたので\n行ってみましょう！"
  },
  {
    "id": 35617075476029446,
    "key": "BuddyTalk_Tutorial17_MissionDaily01",
    "value": "<color=#e78800><b>『ログインボーナス』</b></color>では\n毎日報酬が入手できますよ"
  },
  {
    "id": 35617075476029447,
    "key": "BuddyTalk_Tutorial17_MissionDaily02_1",
    "value": "ミッションを達成すると\n報酬を受け取ることができます。\nこまめに覗いてみましょう！"
  },
  {
    "id": 35617075476029448,
    "key": "BuddyTalk_Tutorial17_MissionDaily02_2",
    "value": "<color=#e78800><b>『デイリーポイント』</b></color>を入手すると\n報酬が受け取れます"
  },
  {
    "id": 35617075476029449,
    "key": "BuddyTalk_Tutorial17_Home01",
    "value": "今回の説明は以上になります！\n<color=#e78800><b>『ホーム』</b></color>に戻りましょう！"
  },
  {
    "id": 36621863751770112,
    "key": "BuddyTalk_Tutorial1_10_Home01",
    "value": "隊長さん！\n<color=#e78800><b>『特別捜査』</b></color>及び<color=#e78800><b>『専従捜査』</b></color>への\n出撃許可が下りました！"
  },
  {
    "id": 36621863751770113,
    "key": "BuddyTalk_Tutorial1_10_EventQuest01_1",
    "value": "<color=#e78800><b>『特別捜査』</b></color>と<color=#e78800><b>『専従捜査』</b></color>は\n事件を解決するたびに新たな難易度が解放され、\n特殊なルールが追加されます"
  },
  {
    "id": 36621863751770114,
    "key": "BuddyTalk_Tutorial1_10_EventQuest01_2",
    "value": "まずは<color=#e78800><b>『特別捜査』</b></color>に挑戦してみましょう！"
  },
  {
    "id": 36621863751770115,
    "key": "BuddyTalk_Tutorial1_10_Result01_1",
    "value": "今までの事件よりも難易度が高く、危険ですが…\n事件を解決することができれば\n２つの<color=#e78800><b>『特殊な育成素材』</b></color>が入手できます。"
  },
  {
    "id": 36621863751770116,
    "key": "BuddyTalk_Tutorial1_10_Result01_2",
    "value": "<color=#e78800><b>『特別捜査』</b></color>と<color=#e78800><b>『専従捜査』</b></color>は\nしっかり準備してから挑みましょう。\n…腕がなりますね！"
  },
  {
    "id": 36621863751770117,
    "key": "BuddyTalk_Tutorial1_10_Result02_1",
    "value": "難易度が上がると\n特殊なルールが追加されていきます"
  },
  {
    "id": 36621863751770118,
    "key": "BuddyTalk_Tutorial1_10_Result02_2",
    "value": "また　指定されたバディで挑戦する\n<color=#e78800><b>『専従捜査』</b></color>も解放されています"
  },
  {
    "id": 36621863751770119,
    "key": "BuddyTalk_Tutorial1_10_HomeAfter01",
    "value": "今回の説明は以上になります！\n<color=#e78800><b>『ホーム』</b></color>に戻りましょう！"
  },
  {
    "id": 36621863751770120,
    "key": "BuddyTalk_Tutorial2_5_Home01",
    "value": "隊長さん、ついに私たちの力を試す場所…\n<color=#e78800><b>『極限試練』</b></color>への出撃許可が降りました！"
  },
  {
    "id": 36621863751770121,
    "key": "BuddyTalk_Tutorial2_5_EventQuest01_1",
    "value": "<color=#e78800><b>『極限試練』</b></color>では特別な事件に挑戦して、\n他の部隊とスコアを競います。\n<color=#e78800><b>『リスク』</b></color>を選んで、よりハイスコアを目指しましょう！"
  },
  {
    "id": 36621863751770122,
    "key": "BuddyTalk_Tutorial2_5_EventQuest01_2",
    "value": "遭遇するエネミーの数も多いので\nうまくコントロールしていきましょう！"
  },
  {
    "id": 36621863768547328,
    "key": "BuddyTalk_Tutorial2_5_Ranking01_1",
    "value": "極限試練では<color=#e78800><b>『リスクゲージ』</b></color>を溜めれば溜めるほど、\n高いスコアを狙うことができます！\nここは隊長さんの腕の見せ所ですね"
  },
  {
    "id": 36621863768547329,
    "key": "BuddyTalk_Tutorial2_5_Ranking02_1",
    "value": "もし、ランキングの上位に入ることが出来れば\n特別な報酬を得ることができますよ！\n他の部隊の人達に負けないよう、頑張りましょう！"
  },
  {
    "id": 36621863768547330,
    "key": "BuddyTalk_Tutorial2_5_Ranking03_1",
    "value": "また　ランキング制度があって\n同じ階級の100人で　順位を競い合います！"
  },
  {
    "id": 36621863768547331,
    "key": "BuddyTalk_Tutorial2_5_HomeAfter01",
    "value": "上の階級に行くほど豪華な報酬が貰えます！\nぜひ！上位を目指しましょう！"
  },
  {
    "id": 36664082076524544,
    "key": "BuddyTalk_Tutorial11_Home02_5",
    "value": "カードは<color=#e78800><b>『ガチャ』</b></color>から入手できます\n行ってみましょう！"
  },
  {
    "id": 36664082080718850,
    "key": "BuddyTalk_Tutorial1_10_Result02_3",
    "value": "どちらもクリアすると　ラボで使える\n<color=#e78800><b>『ラボチップ』</b></color>が入手できます！"
  },
  {
    "id": 36664082080718851,
    "key": "BuddyTalk_Tutorial1_10_Result02_4",
    "value": "積極的に挑戦してみてください！"
  },
  {
    "id": 36664082080718852,
    "key": "BuddyTalk_Tutorial2_5_EventQuest01_3",
    "value": "1日3回まで出撃できて　クリアすると\n<color=#e78800><b>『バッジ』</b></color>を獲得できることがあります！"
  },
  {
    "id": 36664082080718853,
    "key": "BuddyTalk_Tutorial2_5_EventQuest01_4",
    "value": "早速　挑戦してみましょう！"
  },
  {
    "id": 36664082084913152,
    "key": "BuddyTalk_BadgeEquipGuide_1",
    "value": "装備完了です！バッジは<color=#e78800><b>『最大5個』</b></color>まで装備できます。\n 極限試練で上のクラスを目指すほど、<color=#e78800><b>『強力なバッジ』</b></color>が手に入りやすくなります。"
  },
  {
    "id": 36664082084913153,
    "key": "BuddyTalk_BadgeEquipGuide_2",
    "value": "使わないバッジは売却してクレジットに変換できます。 \n<color=#e78800><b>『自動売却機能』</b></color>もあるので、活用してみてくださいね！ "
  },
  {
    "id": 36664082084913154,
    "key": "BuddyTalk_BadgeExplain_3",
    "value": "高レアなバッジほどアビリティの数や\n効果が高くなっていきますよ！"
  },
  {
    "id": 36664082084913155,
    "key": "BuddyTalk_BadgeExplain_4",
    "value": "不要な<color=#e78800><b>『バッジ』</b></color>は売却して<color=#e78800><b>『クレジット』</b></color>に\n変換可能です！"
  },
  {
    "id": 36664082084913156,
    "key": "BuddyTalk_BadgeExplain_5",
    "value": "ぜひ！\n<color=#e78800><b>『バッジ』</b></color>を有効活用してください！"
  },
  {
    "id": 36682596267057152,
    "key": "BuddyTalk_Tutorial11_Defeat02",
    "value": "もう一度　挑戦してみましょう！"
  },
  {
    "id": 36740285969981440,
    "key": "BuddyTalk_Tutorial14_BuddyAfter01_4",
    "value": "それでは、次の事件の捜査に向かいましょう。\n強くなった私をお見せしますよー！"
  },
  {
    "id": 36759731111452672,
    "key": "BuddyTalk_Tutorial15_Home03_1",
    "value": "無事　アップグレードできましたね！"
  },
  {
    "id": 36759731111452673,
    "key": "BuddyTalk_Tutorial15_Home03_2",
    "value": "今回の説明は以上になります！\n<color=#e78800><b>『ホーム』</b></color>に戻りましょう！"
  },
  {
    "id": 36759731111452674,
    "key": "BuddyTalk_Tutorial17_MissionDaily02",
    "value": "続いて<color=#e78800><b>『デイリーミッション』</b></color>を\n見に行きましょう！"
  },
  {
    "id": 38056611771740160,
    "key": "BuddyTalk_Tutorial12_Home02",
    "value": "<color=#e78800><b>『強化パーツ』</b></color>を使えば、\n<color=#e78800><b>『カード』</b></color>を強化することができます！\n早速、やってみましょう！"
  },
  {
    "id": 40715663631450112,
    "key": "BuddyTalk_Tutorial11_Equipment01",
    "value": "カードをデッキに組み込んだことで、\n<color=#e78800><b>『戦闘力』</b></color>が<color=#e78800><b>『推奨戦闘力』</b></color>以上になりましたね！"
  },
  {
    "id": 40715663631450113,
    "key": "BuddyTalk_Tutorial11_Equipment01_2",
    "value": "さぁ、準備万端です！\n隊長さん！出撃しましょう！"
  },
  {
    "id": 40780816930570240,
    "key": "BuddyTalk_Tutorial11_Equipment00",
    "value": "カードをデッキに組み込めましたね！\nデッキに組み込まないと<color=#e78800><b>『バトルで使用できない』</b></color>ので、\n気を付けてくださいね？隊長さん！"
  },
  {
    "id": 64880064603348992,
    "key": "ImageTalkSequential_1_1_1",
    "value": "…こち…BR…1G …………す。\n…はい！…はい、了……す！"
  },
  {
    "id": 64880064607543296,
    "key": "ImageTalkSequential_1_1_2",
    "value": "目的…変…、10分程…で…着予定です。\n………隊長と… 現場…急行し…す！"
  },
  {
    "id": 64880064607543297,
    "key": "ImageTalkSequential_2_1_1",
    "value": "今、緊急出動要請がありました。\n本部に向かう予定でしたが、時間がありません！"
  },
  {
    "id": 64880064607543298,
    "key": "ImageTalkSequential_2_1_2",
    "value": " このまま直接現場に向かい、\n即時任務を開始します！"
  },
  {
    "id": 64880064607543299,
    "key": "ImageTalkSequential_2_2_1",
    "value": "ある程度は隊長さんも把握していると思いますが\n私たちが今向かっている『シンクシティ』は…"
  },
  {
    "id": 64880064607543300,
    "key": "ImageTalkSequential_2_3_1",
    "value": "その『ワークロイド』が何者かによってハッキングされ、\n暴走化し、街を襲う事件が多発しているという状況です。"
  },
  {
    "id": 64880064607543301,
    "key": "ImageTalkSequential_2_4_1",
    "value": "暴走化した『ワークロイド』は日々増えていて、\n中でも『大型ワークロイド』はとても危険な存在です。"
  },
  {
    "id": 64880064607543302,
    "key": "ImageTalkSequential_2_4_2",
    "value": "一部の地域は『大型ワークロイド』によって占領され、\n立入禁止区域となっています。"
  },
  {
    "id": 64880064607543303,
    "key": "ImageTalkSequential_2_5_1",
    "value": "本日始動の隊長さんが率いる私たち『R.U.S.H』部隊は\n対ワークロイドに特化した精鋭部隊です。"
  },
  {
    "id": 64880064607543304,
    "key": "ImageTalkSequential_2_5_2",
    "value": "隊長さん！これからは訓練ではなく実戦です…！"
  },
  {
    "id": 64880064607543305,
    "key": "ImageTalkSequential_2_6_1",
    "value": "……すみません、つい胸が熱くなってしまいました。"
  },
  {
    "id": 64880064607543306,
    "key": "ImageTalkSequential_2_6_2",
    "value": "あっ、通報のあった暴走化『ワークロイド』の\n事件現場はもうすぐみたいです。"
  },
  {
    "id": 70758704234881024,
    "key": "BuddyTalk_BadgeGuideComplete",
    "value": "今回の紹介は以上となります！しっかりと準備をしてから\n次の捜査に出撃してくださいね！"
  },
  {
    "id": 71149380311179264,
    "key": "BuddyTalk_BattleTutorial_Link_1",
    "value": "リンクゲージが3本溜まりました！\nさらに4本目を溜めると\n<color=#e78800><b>『リンクレベル』</b></color>が上がります！\nリンクレベルは、このエネミーとの戦闘中、維持されます"
  },
  {
    "id": 71149380315373568,
    "key": "BuddyTalk_BattleTutorial_Link_2",
    "value": "リンクレベルを上げるときに<color=#e78800><b>『リンクカード』</b></color>を\n使うと、強力な<color=#e78800><b>『リンクアタック』</b></color>が発生します！\nさっそく使ってみましょう！"
  },
  {
    "id": 71149380315373569,
    "key": "BuddyTalk_BattleTutorial_Link_3",
    "value": "<color=#e78800><b>『リンクカード』</b></color>がより強力になり\n大きなダメージを与えることができました！\nタイミング良く使って、戦闘を有利に進めていきしょう"
  },
  {
    "id": 71149380315373570,
    "key": "BuddyTalk_BattleTutorial_Link_4",
    "value": "<color=#e78800><b>『リンクレベル』</b></color>を上げたことで、攻撃力がアップし\n<color=#e78800><b>『RUSHゲージ』</b></color>が溜まりました"
  },
  {
    "id": 71149380315373571,
    "key": "BuddyTalk_BattleTutorial_Link_5",
    "value": "<color=#e78800><b>『RUSHゲージ』</b></color>を溜めることで\n私たちバディの潜在能力を解放する<color=#e78800><b>『RUSHモード』</b></color>が\n使えるようになるので、頑張って溜めましょう！"
  },
  {
    "id": 71149380315373572,
    "key": "BuddyTalk_BattleTutorial_Counter_1",
    "value": "敵の攻撃がきそうです！\nそのまま受けると危険です。<color=#e78800><b>『カウンター』</b></color>しましょう！"
  },
  {
    "id": 71149380315373573,
    "key": "BuddyTalk_BattleTutorial_Counter_2",
    "value": "<color=#e78800><b>『カウンター』</b></color>しないとリンクレベルが下がってしまうので\nしっかりと狙いましょう！　中にはカウンターできない\n強力な攻撃もあるので注意してください。"
  },
  {
    "id": 71149380315373574,
    "key": "BuddyTalk_BattleTutorial_RushMode_1",
    "value": "新しいエネミーです！\n手強そうな相手ですが、<color=#e78800><b>『RUSHモード』</b></color>を使えば\nきっと倒せます！　まずはリンクゲージを溜めましょう"
  },
  {
    "id": 71149380315373575,
    "key": "BuddyTalk_BattleTutorial_RushMode_2",
    "value": "隊長さん！\n強力な敵を倒すための私たちの切り札…\n<color=#e78800><b>『RUSHモード』</b></color>で一気に決めましょう！\n今回は特別に支給されたエネルギーを使用できますよ"
  },
  {
    "id": 71149380315373576,
    "key": "BuddyTalk_BattleTutorial_RushMode_3",
    "value": "RUSHモード　オンライン！\n\nこれで<color=#e78800><b>『RUSHモード』</b></color>を使うことができます！"
  },
  {
    "id": 71149380315373577,
    "key": "BuddyTalk_BattleTutorial_RushMode_4",
    "value": "<color=#e78800><b>『RUSHモード』</b></color>中は、潜在能力が解放されて\n攻撃力がアップします！"
  },
  {
    "id": 78096703286935552,
    "key": "BuddyTalk_Tutorial10_Home03",
    "value": "こうしては居られません隊長さん…！\n早速、次の現場から出動要請がきてますよ！"
  },
  {
    "id": 80845540253921280,
    "key": "Story_Yell_Ep1_1001",
    "value": "隊長さん！！"
  },
  {
    "id": 80845540300058624,
    "key": "Story_Yell_Ep1_1002",
    "value": "私のこと…捨てないですよね…？"
  },
  {
    "id": 80845540300058625,
    "key": "Story_Yell_Ep1_1003",
    "value": "ご…ごめんなさい！\n隊長さんのお力になりたくてつい！"
  },
  {
    "id": 80845540300058626,
    "key": "Story_Yell_Ep1_1004",
    "value": "ご安心ください！\nこのエール　頑張ってお役に立ちます！"
  },
  {
    "id": 80845540300058627,
    "key": "Story_Yell_Ep1_1005",
    "value": "なので！ 現場に到着したら\n私から目を離さないでくださいね！"
  },
  {
    "id": 80845540300058628,
    "key": "Story_Yell_Ep1_3001",
    "value": "隊長さん！お怪我はありませんか？"
  },
  {
    "id": 80845540300058629,
    "key": "Story_Yell_Ep1_3002",
    "value": "お顔…よし…お手々…よし…"
  },
  {
    "id": 80845540300058630,
    "key": "Story_Yell_Ep1_3003",
    "value": "隊長さんの手…温かい…"
  },
  {
    "id": 80845540300058631,
    "key": "Story_Yell_Ep1_3004",
    "value": "あの…今日は……\n握ったままでもいいですか…？"
  },
  {
    "id": 80845540300058632,
    "key": "Story_Flare_Ep1_1001",
    "value": "オラァァア！どけどけどけぇ！\nあたしは誰にも止められねえ！"
  },
  {
    "id": 80845540300058633,
    "key": "Story_Flare_Ep1_1002",
    "value": "ドンッ！"
  },
  {
    "id": 80845540300058634,
    "key": "Story_Flare_Ep1_1003",
    "value": "いってぇ！ どこに目ぇ付けてんだ！"
  },
  {
    "id": 80845540300058635,
    "key": "Story_Flare_Ep1_1004",
    "value": "って 相棒じゃねぇか！\nよくもあたしを止めやがったな……"
  },
  {
    "id": 80845540300058636,
    "key": "Story_Flare_Ep1_1005",
    "value": "って違えよ！\nぶつかったのはあたしじゃねえか！"
  },
  {
    "id": 80845540300058637,
    "key": "Story_Flare_Ep1_1006",
    "value": "あぁ！もうわかんねえ！\n身体を動かしてスッキリするか！"
  },
  {
    "id": 80845540300058638,
    "key": "Story_Flare_Ep1_1007",
    "value": "おい！ 相棒！\nぶつかった詫びパトロールだ！行くぞ！"
  },
  {
    "id": 80845540300058639,
    "key": "Story_Flare_Ep1_3001",
    "value": "よし！ パトロール完了だぜ！"
  },
  {
    "id": 80845540300058640,
    "key": "Story_Flare_Ep1_3002",
    "value": "おい！相棒！\n怪我とかしてねえだろうな？"
  },
  {
    "id": 80845540300058641,
    "key": "Story_Flare_Ep1_3003",
    "value": "あたし？ こんなの掠り傷程度だ……"
  },
  {
    "id": 80845540300058642,
    "key": "Story_Flare_Ep1_3004",
    "value": "ひゃぁん！？"
  },
  {
    "id": 80845540308447232,
    "key": "Story_Flare_Ep1_3005",
    "value": "おい！どこ触ってんだ！\n次やったらぶっ飛ばすからな！"
  },
  {
    "id": 80845540308447233,
    "key": "Story_GritHeart_Ep1_1001",
    "value": "突然だが　隊長\n俺のボディについてどう思う？"
  },
  {
    "id": 80845540308447234,
    "key": "Story_GritHeart_Ep1_1002",
    "value": "あぁ　興味があるなら触っていいぞ"
  },
  {
    "id": 80845540308447235,
    "key": "Story_GritHeart_Ep1_1003",
    "value": "いい触り心地だろう？\n毎日トレーニングしているからな"
  },
  {
    "id": 80845540308447236,
    "key": "Story_GritHeart_Ep1_1004",
    "value": "……触っていいとは言ったが\n手つきがいやらしいぞ"
  },
  {
    "id": 80845540308447237,
    "key": "Story_GritHeart_Ep1_1005",
    "value": "それだけ気に入ったということか？\nははは！ ならよかった"
  },
  {
    "id": 80845540308447238,
    "key": "Story_GritHeart_Ep1_1006",
    "value": "トレーニングの成果を見せるとするか\n行くぞ！"
  },
  {
    "id": 80845540308447244,
    "key": "Story_Luminol_Ep1_1001",
    "value": "つ・か・ま・え・た♡"
  },
  {
    "id": 80845540308447245,
    "key": "Story_Luminol_Ep1_1002",
    "value": "もうすぐあそこなんだから\nぼ～っとしちゃだめよ？"
  },
  {
    "id": 80845540308447246,
    "key": "Story_Luminol_Ep1_1003",
    "value": "わる～いワークロイドにつかまって\nめちゃくちゃにされちゃうかもしれないわ"
  },
  {
    "id": 80845540308447247,
    "key": "Story_Luminol_Ep1_1004",
    "value": "そ・れ・と・も♡\nワタシにめちゃくちゃにされたい？"
  },
  {
    "id": 80845540308447248,
    "key": "Story_Luminol_Ep1_1005",
    "value": "な～んてウソよ　期待しちゃった？"
  },
  {
    "id": 80845540308447249,
    "key": "Story_Luminol_Ep1_1006",
    "value": "でもぉ　この任務をい～っぱい頑張れたら\nご褒美上げちゃうかもしれないわぁ♡"
  },
  {
    "id": 80845540308447250,
    "key": "Story_Luminol_Ep1_1007",
    "value": "頑張ってね？ ア・ナ・タ♡"
  },
  {
    "id": 80845540308447256,
    "key": "Story_Mini_Ep1_1001",
    "value": "ミニ　マスターに手錠はめてあげるね"
  },
  {
    "id": 80845540308447257,
    "key": "Story_Mini_Ep1_1002",
    "value": "だって　マスターざこざこだし\nひとりで　勝手にいっちゃう"
  },
  {
    "id": 80845540308447258,
    "key": "Story_Mini_Ep1_1003",
    "value": "迷子にならないように\nマスターのことは　ミニが管理してあげる"
  },
  {
    "id": 80845540308447259,
    "key": "Story_Mini_Ep1_1004",
    "value": "マスターのマスター…\nふふっ　ちょっとカッコいいかも"
  },
  {
    "id": 80845540308447260,
    "key": "Story_Mini_Ep1_1005",
    "value": "え？ 手錠してたほうが危ない？"
  },
  {
    "id": 80845540308447261,
    "key": "Story_Mini_Ep1_1006",
    "value": "じゃあ　今回の任務で\nマスターが　大人ってとこ見せて"
  },
  {
    "id": 80855670970281984,
    "key": "ImageTalkSequential_2_2_2",
    "value": "『ワークロイド』と呼ばれる所謂『お手伝いロボット』が\n生活基盤に組み込まれています。"
  },
  {
    "id": 80855671117082624,
    "key": "Story_Yell_Ep1_1006",
    "value": "よそ見したら…めっ！ですよ！"
  },
  {
    "id": 80855671121276928,
    "key": "Story_GritHeart_Ep1_3001",
    "value": "どうだ！これがトレーニングの成果だ！"
  },
  {
    "id": 80855671121276929,
    "key": "Story_GritHeart_Ep1_3002",
    "value": "鍛えられたボディがあれば\nどんな脅威からも守り抜けるからな"
  },
  {
    "id": 80855671121276930,
    "key": "Story_GritHeart_Ep1_3003",
    "value": "なんだ？　疲れて歩けないだと？"
  },
  {
    "id": 80855671121276931,
    "key": "Story_GritHeart_Ep1_3004",
    "value": "仕方ない\n持ちあげて連れて帰ってやる"
  },
  {
    "id": 80855671121276932,
    "key": "Story_GritHeart_Ep1_3005",
    "value": "おい！暴れるな！\n赤ん坊じゃないんだから！"
  },
  {
    "id": 80855671125471232,
    "key": "Story_Luminol_Ep1_3001",
    "value": "はい　おしまい♡\nよく頑張ったわねぇ"
  },
  {
    "id": 80855671125471233,
    "key": "Story_Luminol_Ep1_3002",
    "value": "ん～？ ご褒美？\nなんのことだったかしらぁ"
  },
  {
    "id": 80855671125471234,
    "key": "Story_Luminol_Ep1_3003",
    "value": "うふふ　冗談よ\n頑張ってくれた子にはあげないとね"
  },
  {
    "id": 80855671125471235,
    "key": "Story_Luminol_Ep1_3004",
    "value": "おいで"
  },
  {
    "id": 80855671125471236,
    "key": "Story_Luminol_Ep1_3005",
    "value": "い～っぱい甘やかして　ア・ゲ・ルぅ♡"
  },
  {
    "id": 80855671125471237,
    "key": "Story_Mini_Ep1_3001",
    "value": "マスターの指示　すごくよかった"
  },
  {
    "id": 80855671125471238,
    "key": "Story_Mini_Ep1_3002",
    "value": "……悔しいけど　認めてあげる\nマスターは大人だね"
  },
  {
    "id": 80855671125471239,
    "key": "Story_Mini_Ep1_3003",
    "value": "勘違いしないで\nまだミニの方が強いから"
  },
  {
    "id": 80899094838669312,
    "key": "Story_Mini_Ep1_3004",
    "value": "次はミニが　リードしてあげる"
  },
  {
    "id": 82414733583933440,
    "key": "BuddyTalk_BattleTutorial_Link_6",
    "value": "ここからは自由に戦ってみましょう\n私は隊長さんの指示に従います！"
  },
  {
    "id": 82414733621682176,
    "key": "BuddyTalk_BattleTutorial_RushMode_5",
    "value": "さらにRUSHモード中のみ使える\n強力な<color=#e78800><b>『専用カード』</b></color>がデッキに追加されます！\n上手く使って、敵を倒しましょう！"
  },
  {
    "id": 82689030235840512,
    "key": "BuddyTalk_BattleTutorial_UpdateProgram",
    "value": "戦闘に役立つ<color=#e78800><b>『強化プログラム』</b></color>が選択できますよ！\nどれにするか迷っちゃいますね"
  },
  {
    "id": 82787778968936448,
    "key": "BuddyTalk_BattleTutorial_BuddyHp0",
    "value": "まだまだ……\nもう一度です！\n一気に畳み掛けましょう！"
  },
  {
    "id": 82815870275682304,
    "key": "BuddyTalk_Tutorial10_Home04",
    "value": "…隊長さんとならどんな事件も解決できそうです。\n改めて、これからもよろしくお願いしますね…！"
  },
  {
    "id": 82815870305042432,
    "key": "ImageTalkSequential_1_1_3",
    "value": "…隊長さん！隊長さん！\nお休みの所すみません…！"
  },
  {
    "id": 82815870309236736,
    "key": "ImageTalkSequential_2_1_3",
    "value": "着任初日なのにバタバタしてしまってすみません…！\n本部から事件の概要が届いたのでお伝えします！"
  },
  {
    "id": 82815870309236737,
    "key": "ImageTalkSequential_2_4_3",
    "value": "…私たちの任務は、これらの『ワークロイド』を鎮圧し\n警察としてこの街を護る事。"
  },
  {
    "id": 82815870309236738,
    "key": "ImageTalkSequential_2_5_3",
    "value": "私たちで暴走した『ワークロイド』を鎮圧し\n『シンクシティ』の平和を取り戻しましょう！！"
  },
  {
    "id": 82815870309236739,
    "key": "ImageTalkSequential_2_6_3",
    "value": "現場についたら即時『ワークロイド』との戦闘になります！\n隊長さん、ご指示をお願いしますね…！！"
  }
]
