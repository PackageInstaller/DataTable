    "AnimationName": "04_unique"
  },
  {
    "Id": 22003,
    "MessageType": 10001,
    "VoiceAssetId": "uniq/22003",
    "Message": "はーい、いらっしゃいま――…\nへぇかぁぁ！へーか！へーか！\nあ！…こほん、勤務中でした……",
    "AnimationName": "09_unique"
  },
  {
    "Id": 22004,
    "MessageType": 10002,
    "VoiceAssetId": "uniq/22004",
    "Message": "いらっしゃいませ陛下！\nなななんと！ただいまセール中です!!\n出血大サービス！買ってください！切実に！",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22005,
    "MessageType": 10002,
    "VoiceAssetId": "uniq/22005",
    "Message": "いらっしゃいませ！待ってましたぁ♪\n陛下は超ラッキーです！なんとなんと、\nセールやってるんです!!ぜひぜひー♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22006,
    "MessageType": 10002,
    "VoiceAssetId": "uniq/22006",
    "Message": "いらっしゃいませ陛下！\n限定セールは期間限定！\nお買い逃しのないようにーー♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22007,
    "MessageType": 10002,
    "VoiceAssetId": "uniq/22007",
    "Message": "来てくれると思ってました！陛下なら！\n限定セール中ですよ！お見逃しなくっ♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22008,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22008",
    "Message": "神出鬼没のスーパー雑用アルバイター\nちびりすがご案内しますっ♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22009,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22009",
    "Message": "今日は何をお求めですか？\nおすすめはこちらですよっ♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22010,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22010",
    "Message": "いろんなものがあるので、\nゆぅーーーっくり見てってくださいね♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22011,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22011",
    "Message": "もしかして、見てるだけ…？\nオトナって卑怯ですよね",
    "AnimationName": "03_stare"
  },
  {
    "Id": 22012,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22012",
    "Message": "陛下、もしかしてちびりすのこと\n騙そうとしてませんか…？",
    "AnimationName": "03_stare"
  },
  {
    "Id": 22013,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22013",
    "Message": "どうせちびりすは借金まみれの\nへっぽこスーパー美少女ですしー",
    "AnimationName": "03_stare"
  },
  {
    "Id": 22014,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22014",
    "Message": "お値段が高い？\nよ、よくわかんないですねー\nちびりす小さいのでー",
    "AnimationName": "05_unique"
  },
  {
    "Id": 22015,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22015",
    "Message": "陛下はちびりすと遊んでて、\n怒られないんですか…？",
    "AnimationName": "01_wait"
  },
  {
    "Id": 22016,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22016",
    "Message": "さっきラビリスお姉ちゃんが\nお店に変なもの置いていったんです\nこれ、売っていいのかなぁ…？",
    "AnimationName": "01_wait"
  },
  {
    "Id": 22017,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22017",
    "Message": "わぁっ！びっくりしたぁ…\n急につっつかないでくださいーっ",
    "AnimationName": "06_unique"
  },
  {
    "Id": 22018,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22018",
    "Message": "あうっ！あ、あ、あ、あぶない…\n転んで商品だめにするところだった…",
    "AnimationName": "07_unique"
  },
  {
    "Id": 22019,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22019",
    "Message": "ひゃあんっ♥ ……。うぅー！\n陛下が驚かすから変な声がでました…！",
    "AnimationName": "08_unique"
  },
  {
    "Id": 22020,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22020",
    "Message": "陛下が来てくれたので、\n今日のご飯代は勝ち確ですよっ！ふふん！",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22021,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22021",
    "Message": "たーくさん入荷、というか押し付けられて\nきてますよ！見てってください！",
    "AnimationName": "01_wait"
  },
  {
    "Id": 22022,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22022",
    "Message": "陛下へのおすすめはこちらです！\nちびりすが選んでみました♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22023,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22023",
    "Message": "メイズママのお手伝い中に、\nまた薬品をこぼしてしまって…\n装置が故障して、借金が……",
    "AnimationName": "04_unique"
  },
  {
    "Id": 22024,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22024",
    "Message": "借金の総額ですか…？\n……聞かない方が、いいと思います……",
    "AnimationName": "04_unique"
  },
  {
    "Id": 22025,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22025",
    "Message": "あの、遊んでくれるのは嬉しいんですが\nえっと、何か、買ってほしい…、かなぁ…",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22026,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22026",
    "Message": "あんまり頭を撫でないでください\nもっとちっちゃくなっちゃいますっ",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22027,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22027",
    "Message": "へ、陛下！ちびりすじゃなくて\n商品の方を見てくださいっ",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22028,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22028",
    "Message": "こんな小さな子に借金を背負わすなんて\nどうかしてると思いませんかっ！",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22029,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22029",
    "Message": "聞いてくださいよ陛下ぁぁぁ…\n借金、また増えちゃったんですよぉぉ…",
    "AnimationName": "04_unique"
  },
  {
    "Id": 22030,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22030",
    "Message": "たﾞすﾞけﾞてﾞくﾞだﾞさﾞいﾞーー！\nたくさん売らないと晩ごはんがぁぁ…",
    "AnimationName": "04_unique"
  },
  {
    "Id": 22031,
    "MessageType": 30001,
    "VoiceAssetId": "uniq/22031",
    "Message": "一生のお願いですぅぅ…\nなんか買ってくださいぃぃぃ…",
    "AnimationName": "04_unique"
  },
  {
    "Id": 22032,
    "MessageType": 30002,
    "VoiceAssetId": "uniq/22032",
    "Message": "へいか！へいか！大セール中ですよ！\nおすすめ沢山ありますよっ♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22033,
    "MessageType": 30002,
    "VoiceAssetId": "uniq/22033",
    "Message": "大セール開催中ですぅー\n店内お安くなっておりますぅー",
    "AnimationName": "01_wait"
  },
  {
    "Id": 22034,
    "MessageType": 30002,
    "VoiceAssetId": "uniq/22034",
    "Message": "セールですけど、品質は保証しますよ！\n安くていいもの、もっとお安くっ♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22035,
    "MessageType": 30002,
    "VoiceAssetId": "uniq/22035",
    "Message": "へいか！限定セールですよ！\nげ・ん・て・い！いい響きですよね…",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22036,
    "MessageType": 30002,
    "VoiceAssetId": "uniq/22036",
    "Message": "限定セール開催中ですっ♪\nなんでこんな安いのか\nちびりすにもわかりませんっ！",
    "AnimationName": "01_wait"
  },
  {
    "Id": 22068,
    "MessageType": 20001,
    "VoiceAssetId": "uniq/22068",
    "Message": "へーかっ！準備はちゃんとしないと\nダメだって、メイズママが言ってました！\nそこで！当店でばっちり準備ですよっ♪\n……まさか、ちびりす以外のお店で\n準備をしてたりしませんよねぇ…？",
    "AnimationName": "01_wait"
  },
  {
    "Id": 22069,
    "MessageType": 20001,
    "VoiceAssetId": "uniq/22069",
    "Message": "陛下、へーか！聞いてくださいよぉ！\nこの間、カハルさんに騙されて\nアズアズさんのお薬の実験台にされてぇ！\n…お駄賃はすごくよかったんですけど、\n人間としての尊厳とか、そいうものを\n全て失いました……",
    "AnimationName": "04_unique"
  },
  {
    "Id": 22070,
    "MessageType": 20001,
    "VoiceAssetId": "uniq/22070",
    "Message": "お店以外のアルバイトですか？\nお掃除、お洗濯、実験台…、\nキッチン、ドリンク、フロアに品出し、\n物資輸送に、アーティファクトの管理…！\nお願いされたら、基本ちびりすは\n何でもやりますよっ♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22071,
    "MessageType": 20001,
    "VoiceAssetId": "uniq/22071",
    "Message": "えへへー、陛下聞いてくださいー♪\nこの前ラビリスお姉ちゃんが、\n絶対100倍にして返すから、お金貸して案件！\nって言ってて！すごくないですか！\n100倍ですよっ！ひゃーくっ♪\nいつ返してくれるかなぁ？たのしみー♪",
    "AnimationName": "02_smile"
  },
  {
    "Id": 22072,
    "MessageType": 20001,
    "VoiceAssetId": "uniq/22072",
    "Message": "む！今お店の中に迷ちゃんいませんでした？\nんー？んむむー？…あれぇ？\n何か用だったのかなぁ？…あ！机にお代が！\nあー！商品が一個へってる！\nもう！ちゃんとレジ通してくださいよぉっ！",
    "AnimationName": "04_unique"
  }
]