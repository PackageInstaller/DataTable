  },
  {
    "Id": 100101,
    "Title": "1章1節",
    "SubTitle": "まだ見えない星の光",
    "Order": 1,
    "EventMasterId": 1,
    "AssetId": "1001",
    "Overview": "「次の公式試合で負ければ退学」\nそんな条件を言い渡されたシリウスシュガー。\n危機感のない彼女たちとの学園生活の中で\n指揮官であるあなたはシリウスシュガーに\n必要な『足りないもの』を見つけ……",
    "ChapterGroupMasterId": 1001,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100102,
    "Title": "1章2節",
    "SubTitle": "夜明け前の彼女たち",
    "Order": 2,
    "EventMasterId": 1,
    "AssetId": "1002",
    "Overview": "同じ校舎のチーム『カラフルブーケ』との\n演習で惨敗し、後がないことを自覚した\nシリウスシュガーのメンバーたち。\n彼女たちを鍛えるために主人公は、\n理不尽とも見えるような訓練をさせる。\n限界を迎え不満が溜まる彼女たちだが、\n訓練の成果としてメイズに潜り……",
    "ChapterGroupMasterId": 1001,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100103,
    "Title": "1章3節",
    "SubTitle": "エースとして煌めいて",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1003",
    "Overview": "ついに訓練を終えたシリウスシュガー。\n成果を披露するものの、不安を隠す事の\n出来ないめると共に敵情視察へ向かう。\nそこで目の当たりにしたのはカオスメイデン\nという圧倒的な実力を持ったチームの姿。\nチームの命運を賭けた試合の結果は――",
    "ChapterGroupMasterId": 1001,
    "Interlude": "桃園めるルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100104,
    "Title": "1章3節",
    "SubTitle": "周りを照らし輝いて",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1004",
    "Overview": "辛い特訓乗り越えたシリウスシュガー。\nだが、楽観視できない現状に危機感を抱く\n七彩と共に向かったのはスカラ校舎。\nそこで彼女たちが目撃したのは常識外の\n才能を持つユリア・バーンズの実力だった。\nチームの命運を賭けた試合の結果は――",
    "ChapterGroupMasterId": 1001,
    "Interlude": "鳴滝七彩ルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100201,
    "Title": "2章1節",
    "SubTitle": "未知なる領域への挑戦",
    "Order": 1,
    "EventMasterId": 1,
    "AssetId": "1005",
    "Overview": "退学の危機を乗り越えたシリウスシュガー。\nしかし、次なる危機が待ち受ける。\nそれは……チームの資金難だった！\nお金を稼ぐために本格的なメイズの探索へと\n準備をする彼女たちにアドバイザーとして、\n良く知る二人の少女がやってきたのだった。",
    "ChapterGroupMasterId": 1002,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100202,
    "Title": "2章2節",
    "SubTitle": "深層を覗き込むとき",
    "Order": 2,
    "EventMasterId": 1,
    "AssetId": "1006",
    "Overview": "順調に進んでいくメイズの探索だったが、\n『メイズシンドローム』という現象による\n体調不良で足止めを食らってしまう\nしかし、その現象によってメイズ適正が\n高まり、さらなる奥を目指して進行する。\nだが、新たなルートを見つけた彼女たちは……",
    "ChapterGroupMasterId": 1002,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100203,
    "Title": "2章3節",
    "SubTitle": "暗闇に差し込むのは希望",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1007",
    "Overview": "メイズの未知なる領域へと落ち、危機に陥る\nシリウスシュガーのメンバー。\n極限の中で生意気で負けず嫌いなラミが\n指揮官へと語る彼女の思いとは。\n果たして、絶体絶命の状況で彼女たちは、\nメイズから無事に脱出できるのか――",
    "ChapterGroupMasterId": 1002,
    "Interlude": "朽葉ラミルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100204,
    "Title": "2章3節",
    "SubTitle": "暗闇を照らす白い光",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1008",
    "Overview": "新ルート開拓に失敗して、メイズの奥底へと\n落ちていったシリウスシュガー。\nそんな不安な状況でも実力を信頼されて、\nチームの支えとなっている白奈。\nしかし、指揮官だけが気付く彼女の姿は……？\n果たして、メイズから脱出できるのか――",
    "ChapterGroupMasterId": 1002,
    "Interlude": "一条白奈ルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100301,
    "Title": "3章1節",
    "SubTitle": "星が導く雛鳥たち",
    "Order": 1,
    "EventMasterId": 1,
    "AssetId": "1009",
    "Overview": "メイズの深層から脱出という危機を乗り越えた\nシリウスシュガー。そんな彼女たちに予想外の\n依頼が舞い込む。それは、パイロット訓練生の\n『プレ・クラス－Ａ』を鍛える内容だった。\n教わる立場から一転、教える立場になった彼女\nたちは無事に鍛え上げられるのか？",
    "ChapterGroupMasterId": 1003,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100302,
    "Title": "3章2節",
    "SubTitle": "天才を狙う者たち",
    "Order": 2,
    "EventMasterId": 1,
    "AssetId": "1010",
    "Overview": "大きな陰謀に巻き込まれたシリウスシュガー。\nそのターゲットは『月ヶ瀬ちゆる』という天才\nの存在だった。\n彼女を巡って他校のチームと試合で奪い合う事\nになったシリウスシュガー。ちゆるを巡る闘い\nの中で、正体不明の謎の存在が乱入する……",
    "ChapterGroupMasterId": 1003,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100303,
    "Title": "3章3節",
    "SubTitle": "姿を現した闇",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1011",
    "Overview": "ちゆるを巡るバトルロイヤルに\n突如乱入してきた違法パイロット集団――\n『双頭の斧』。\n彼女たちの狙いもまた、ちゆるだった。\n様々な思惑が交錯する第３章、\nいよいよクライマックスへ……！",
    "ChapterGroupMasterId": 1003,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100401,
    "Title": "4章1節",
    "SubTitle": "イマチュア・アイドル",
    "Order": 1,
    "EventMasterId": 1,
    "AssetId": "1012",
    "Overview": "ＬＯＣ所属『トレブルクインテット』からの\n依頼で、新型ジェネレーターの\n評価プロジェクトをサポートすることに\nなった指揮官。そんな彼らの前に、ライバル\nチーム『トリニティ・ジュエル』の３人が\n立ちはだかる！",
    "ChapterGroupMasterId": 1004,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100402,
    "Title": "4章2節",
    "SubTitle": "トゥインクル ・ステップ",
    "Order": 2,
    "EventMasterId": 1,
    "AssetId": "1013",
    "Overview": "１勝１敗で迎えた次なる試験は、\nメイズでの実地試験。\nトリニティ・ジュエルとの\n負けらない勝負の中で、\n一人悩みを抱えるエヴィの姿が。\n様々な不安や想いを抱えて挑む、\nメイズ探索勝負の行方は……",
    "ChapterGroupMasterId": 1004,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100403,
    "Title": "4章3節",
    "SubTitle": "トゥワーズ・ア・シャイニング",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1014",
    "Overview": "情報窃取の疑いで捕まったトリニティ・\nジュエル。リリーの呼びかけもあり、\n指揮官やフルートは無実を証明するため、\nＬＯＣ近辺で怪しい人物がいないか、\n聞き込み調査に動き始める。\nその中で、ある意外な人物の名前が\n挙がるのだった。",
    "ChapterGroupMasterId": 1004,
    "Interlude": "フルート・メルヴィルルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100404,
    "Title": "4章3節",
    "SubTitle": "オーバーカミング・ザ・パスト",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1015",
    "Overview": "情報窃取の疑いで捕まったトリニティ・\nジュエル。リリーの呼びかけもあり、\n指揮官やエヴィ達は不正アクセスの痕跡を\n追う。そのさなか、エヴィはかつての\nハッキングの師匠『ファルファッラ』が\nこの件に関わっている可能性に気づき――",
    "ChapterGroupMasterId": 1004,
    "Interlude": "エヴィ・レーナルトルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100501,
    "Title": "5章1節",
    "SubTitle": "崩壊のプリモニション",
    "Order": 1,
    "EventMasterId": 1,
    "AssetId": "1016",
    "Overview": "ＬＯＣでの依頼を終えた指揮官は、突如として\nＭＧ集団に誘拐されてしまう。その正体はスランプに陥ったカオスメイデンだった。\n一方、指揮官を待っていためるたちに、\n『とある人物』からの依頼が舞い込む。",
    "ChapterGroupMasterId": 1005,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100502,
    "Title": "5章2節",
    "SubTitle": "混乱のスレッショルド",
    "Order": 2,
    "EventMasterId": 1,
    "AssetId": "1017",
    "Overview": "生徒会長が企画した競技、メイズラッシュ。\n参加を要請されるカオスメイデンだが、\nまだ彼女たちは重度のスランプに陥っていた。\n果たして指揮官は彼女たちを導けるのか――",
    "ChapterGroupMasterId": 1005,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100503,
    "Title": "5章3節",
    "SubTitle": "忘我混沌のリバイバル",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1018",
    "Overview": "突如として現れた巨大穿光属種によって、\n分断されたふたつのチーム。\n未だに受け止められない感情に戸惑うユリア。\nそんな彼女たちへ、穿光属種の集団が襲い掛かる。",
    "ChapterGroupMasterId": 1005,
    "Interlude": "ユリア・バーンズルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100504,
    "Title": "5章3節",
    "SubTitle": "忘我没頭のニルヴァーナ",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1019",
    "Overview": "突如として現れた巨大穿光属種によって、\n分断されたふたつのチーム。\n未だに己の答えを見つけられない沙耶。\nそんな彼女たちへ、新たなメイズシフターが襲い掛かる。",
    "ChapterGroupMasterId": 1005,
    "Interlude": "紫雲沙耶ルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100601,
    "Title": "6章1節",
    "SubTitle": "色褪せるは白百合の園",
    "Order": 1,
    "EventMasterId": 1,
    "AssetId": "1020",
    "Overview": "ユーロ・タワーに新チーム『アークトゥルス』\nが発足。このチームにドロテアがリーダー\nとして引き抜かれ、ピクシス・マスールは\n解散の運命に。ドロテアと一緒に\nいたいミリアム達はメンバー選考会に\n勝つため、指揮官を招いて特訓に臨む。",
    "ChapterGroupMasterId": 1006,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100602,
    "Title": "6章2節",
    "SubTitle": "花咲くは白百合の蕾",
    "Order": 2,
    "EventMasterId": 1,
    "AssetId": "1021",
    "Overview": "ユニティエッジに勝利したミリアム達。\nだが、その後リュシーから告げられたのは、\nそもそもミリアム、ハリエット、ケイトは\n選考会に出ることができないという\n衝撃の事実だった。\nそれを知ったミリアム達は――",
    "ChapterGroupMasterId": 1006,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100603,
    "Title": "6章3節",
    "SubTitle": "煌めくは白百合の剣",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1022",
    "Overview": "コード９９１――大規模敵性存在の出現。\n学園中の生徒達はＭＧを駆り、\n次々と戦いの場へと赴く。\n指揮官も学園に迫る脅威を\n駆逐するため、ドロテア達を率いて\n出撃するのだった。",
    "ChapterGroupMasterId": 1006,
    "Interlude": "ドロテア・カークランドルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100604,
    "Title": "6章3節",
    "SubTitle": "結びつくは白百合の絆",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1023",
    "Overview": "コード９９１――大規模敵性存在の出現。\nそれは人工的に引き起こされた可能性が\nあるという……\nその元凶らしき双頭の斧を追うため、\n指揮官はドロテア達を率いて、\n煌晶帯まで潜るのだった――",
    "ChapterGroupMasterId": 1006,
    "Interlude": "リュシー・ムーアクロフトルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100701,
    "Title": "7章1節",
    "SubTitle": "導かれしプレリュード",
    "Order": 1,
    "EventMasterId": 1,
    "AssetId": "1024",
    "Overview": "人工的にスタンピードを発生させている\n『双頭の斧』。\n学園は彼女達を一斉検挙するため、\n大規模作戦を企図する。\nそのため、シリウスシュガーには\n新たな機体が与えられ――",
    "ChapterGroupMasterId": 1007,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100702,
    "Title": "7章2節",
    "SubTitle": "紐解かれしマトリックス",
    "Order": 2,
    "EventMasterId": 1,
    "AssetId": "1025",
    "Overview": "神楽とコトハが、実は仲間だった……\nその事実に動揺する一同。\nそこにさらに神楽達は衝撃の真実を告げる。\nそれはこの世界の根幹に関わる内容で、\n同時にこの世界で今起こっている危機に\nついてだった――",
    "ChapterGroupMasterId": 1007,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100703,
    "Title": "7章3節",
    "SubTitle": "立ち上がりしプロメテウス",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1026",
    "Overview": "イザナミによって大事な仲間を奪われた\n指揮官とコトハ。そんなふたりを救ったのは、\nチーム『クラスナ』。\nオルガ・ヴォルコワ率いる\nゾリャー校舎のチームだった。コトハは\n彼女達から、神楽の『希望』を託されて――",
    "ChapterGroupMasterId": 1007,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100801,
    "Title": "8章1節",
    "SubTitle": "奪われし絆の銃口",
    "Order": 1,
    "EventMasterId": 1,
    "AssetId": "1027",
    "Overview": "暗示にかかった仲間たちを救うため、\n一行は４つのサブノードの破壊に動き始める。\n第１目標はもっとも近いＬＯＣ校区の\n『Ｎｏｄｅ－Ａ』。\nそこに待ち受けていたのは、\nかつての学園の仲間たちだった――",
    "ChapterGroupMasterId": 1008,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100802,
    "Title": "8章2節",
    "SubTitle": "阻まれし混沌の道",
    "Order": 2,
    "EventMasterId": 1,
    "AssetId": "1028",
    "Overview": "トレブルクインテットやトリニティ・ジュエル\nを打ち破り、さらにイザナミの防御網を抜けて\nＮｏｄｅ－Ａの破壊に成功した指揮官たち。\n第２目標はスカラ校区『Ｎｏｄｅ－Ｓ』。\n指揮官はコトハやクラスナのみんなと交流を\n深めながら、次の戦いに備えるのだった。",
    "ChapterGroupMasterId": 1008,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100803,
    "Title": "8章3節",
    "SubTitle": "秘められし母の覚悟",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1029",
    "Overview": "カオスメイデン戦での予想以上の消耗から、\n指揮官たちは残り２つのサブノードを\n二手に分かれて攻略することに。\n指揮官とコトハはオルガやエレーナとともに、\n『Ｎｏｄｅ－Ｎ』を目指す。\nそこで待ち受けていたのは――",
    "ChapterGroupMasterId": 1008,
    "Interlude": "オルガ・ヴォルコワルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100804,
    "Title": "8章3節",
    "SubTitle": "受け継がれし娘の技",
    "Order": 3,
    "EventMasterId": 1,
    "AssetId": "1030",
    "Overview": "カオスメイデン戦での予想以上の消耗から、\n指揮官たちは残り２つのサブノードを\n二手に分かれて攻略することに。\n指揮官とコトハはナージャやエレーナとともに、\n『Ｎｏｄｅ－Ｋ』を目指す。\nそこで待ち受けていたのは――",
    "ChapterGroupMasterId": 1008,
    "Interlude": "ナージャ・ヴォルコワルート",
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100901,
    "Title": "9章1節",
    "SubTitle": "心想解放",
    "Order": 1,
    "EventMasterId": 1,
    "AssetId": "1031",
    "Overview": "指揮官を排除するため、行動を開始した\n戦略機動要塞『八咫烏』。\n強大すぎる敵を前に、一行は直接戦闘を避け、\nイザナミのメインサーバーを叩く作戦を取る。\nドローンによる包囲を突破しようとした時、\nそこに５機の天穹が現れ――",
    "ChapterGroupMasterId": 1009,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100902,
    "Title": "9章2節",
    "SubTitle": "乙女帰還",
    "Order": 2,
    "EventMasterId": 1,
    "AssetId": "1032",
    "Overview": "指揮官の演説を引き金として、\nザルトゥームの生徒達は洗脳から解放された。\nしかし狂乱するイザナミは、演説範囲を\n浄化対象として攻撃を開始する。\n洗脳の解けた各チームは人々を守るべく、\n指揮官と合流して共に戦い始めるのだった。",
    "ChapterGroupMasterId": 1009,
    "Interlude": null,
    "LoggedInActivateMasterId": null
  },
  {
    "Id": 100903,
    "Title": "9章3節",
