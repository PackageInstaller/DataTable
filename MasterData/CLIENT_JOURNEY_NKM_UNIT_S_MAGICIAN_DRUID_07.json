      "UnitTalk_TWN": "什麼？等等！您要空手而歸嗎？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "괜찮아요. 대가를 바라고 한 일이 아니니까.",
      "UnitTalk_JPN": "大丈夫です。見返りを望んでお手伝いした訳ではないので。",
