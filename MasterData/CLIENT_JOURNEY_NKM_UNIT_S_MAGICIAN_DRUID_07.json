      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "한정 디저트!",
      "UnitTalk_JPN": "限定スイーツです！",
      "UnitTalk_TWN": "限定甜點！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_1.ogg"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "<color=#F7BE45>카페 스트레가</color>에서 새해 한정 디저트를 판매합니다! 많이들 찾아주세요!",
      "UnitTalk_JPN": "<color=#F7BE45>カフェ・ストレガ</color>で、新年限定のスイーツが販売されます！ぜひお立ち寄りください！",
      "UnitTalk_TWN": "<color=#F7BE45>斯特雷加咖啡廳</color>推出新年限定甜點！歡迎光臨！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_2.ogg"
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": false,
      "WaitTime": 0.4,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "EMARK"
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "단장님! 오셨어요?",
      "UnitTalk_JPN": "あっ、団長！いらっしゃいましたね！",
      "UnitTalk_TWN": "團長！您來啦？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_3.ogg"
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아르바이트 중이야?",
          "JumpAnchorStringId_JPN": "バイト中だった？",
          "JumpAnchorStringId_TWN": "你在打工嗎？"
        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 아뇨, 그건 아니에요.",
      "UnitTalk_JPN": "あはは！いえ、そういう訳ではないんです。",
      "UnitTalk_TWN": "啊哈哈！不是那樣的。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_4.ogg"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "직원분이 혼자 나눠주고 있어서 도와드리는 중이에요.",
      "UnitTalk_JPN": "店員の方が一人で配っていたので、お手伝いしていました。",
      "UnitTalk_TWN": "我看到店員一個人在發，就幫了一下忙。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_5.ogg"
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "절반은 나한테 맡겨.",
          "JumpAnchorStringId_JPN": "半分ちょうだい。手伝うよ。",
          "JumpAnchorStringId_TWN": "一半給我吧。"
        }
      ]
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "앗! 괜찮아요.",
      "UnitTalk_JPN": "あっ！大丈夫です。",
      "UnitTalk_TWN": "啊！不用了。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_6.ogg"
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "휴일에도 단장님을 일하게 할 수는 없죠.",
      "UnitTalk_JPN": "団長を、休日にまで働かせる訳にはいきません。",
      "UnitTalk_TWN": "我不能讓團長在休息日工作。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_7.ogg"
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "금방 나눠줄 테니까 조금만 기다려 주시겠어요?",
      "UnitTalk_JPN": "すぐに配り終えますから、少しだけお待ちいただけますか？",
      "UnitTalk_TWN": "我很快就發完了，稍微等我一下好嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_8.ogg"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "다나랑 <color=#F7BE45>로로카</color>를 하고 싶어.",
          "JumpAnchorStringId_JPN": "ダーナと<color=#F7BE45>ロロカ</color>したい。",
          "JumpAnchorStringId_TWN": "我想和達娜一起<color=#F7BE45>洛洛卡</color>。"
        }
      ]
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "안 돼?",
          "JumpAnchorStringId_JPN": "ダメかな？",
          "JumpAnchorStringId_TWN": "不行嗎？"
        }
      ]
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…그렇게 말씀하신다면 어쩔 수 없네요.",
      "UnitTalk_JPN": "…そう言われると、仕方ありませんね。",
      "UnitTalk_TWN": "…既然您這麼說，那就沒辦法了。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_9.ogg"
    },
    {
