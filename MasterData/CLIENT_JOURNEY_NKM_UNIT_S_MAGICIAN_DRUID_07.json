      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "다나는 정말 다른 사람을 돕는 걸 좋아하는구나.",
          "JumpAnchorStringId_JPN": "ダーナは、本当に人助けが好きなんだな。",
          "JumpAnchorStringId_TWN": "達娜真的很喜歡幫助別人呢。"
        }
      ]
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 물론이죠.",
      "UnitTalk_JPN": "あはは！もちろんです。",
      "UnitTalk_TWN": "啊哈哈！當然啦。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_21.ogg"
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "저는 사람들이 웃는 모습을 좋아하니까요.",
      "UnitTalk_JPN": "わたしは、みんなの笑顔が好きなので。",
      "UnitTalk_TWN": "我喜歡看到人們的笑容嘛。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_22.ogg"
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그런데 NOA에 원래 사람이 이렇게 많았나요? 아니면 신년 축제라 많은 걸까요?",
      "UnitTalk_JPN": "ところで、NOAってこんなに人が多かったですっけ？それとも新年祭だからですかね？",
      "UnitTalk_TWN": "不過NOA原本就這麼多人嗎？還是因為新年慶典才這麼多？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_23.ogg"
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "둘 다 아닐까?",
          "JumpAnchorStringId_JPN": "両方だと思う。",
          "JumpAnchorStringId_TWN": "應該都有關係吧？"
        }
      ]
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 당연한 질문이었네요.",
      "UnitTalk_JPN": "あはは！当たり前のことをお聞きしてしまいましたね。",
      "UnitTalk_TWN": "啊哈哈！我似乎問了個笨問題。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_24.ogg"
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_05.mp3",
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "예쁘네요…",
      "UnitTalk_JPN": "それにしても、綺麗です…",
      "UnitTalk_TWN": "好漂亮啊…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_25.ogg"
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "알록달록한 조명… 활기 넘치는 거리…",
      "UnitTalk_JPN": "キラキラした夜景に…にぎわう街…",
      "UnitTalk_TWN": "五彩繽紛的燈光…充滿活力的街道…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_26.ogg"
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>도시는 아름답지만 가시가 돋친 장미</color>라고 말씀드렸었죠.",
      "UnitTalk_JPN": "<color=#F7BE45>都会は美しいけど、トゲがある薔薇</color>。前に、そう言いましたよね。",
      "UnitTalk_TWN": "我不是說過<color=#F7BE45>城市雖美但像帶刺的玫瑰</color>嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_27.ogg"
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "하지만 지금은 <color=#F7BE45>도시가 아름다운 별</color>처럼 느껴져요.",
      "UnitTalk_JPN": "でも今は、<color=#F7BE45>都会が美しい星</color>のように感じられます。",
      "UnitTalk_TWN": "但現在城市感覺像<color=#F7BE45>美麗的星星</color>。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_28.ogg"
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "축제에 가자고 제안해 주셔서 감사해요, 단장님.",
      "UnitTalk_JPN": "団長。新年祭に誘ってくださって、ありがとうございます。",
      "UnitTalk_TWN": "謝謝您邀請我來參加慶典，團長。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_29.ogg"
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "그러고 보니 도시 구경도 단장님과 함께 했었죠.",
      "UnitTalk_JPN": "そういえば…以前、都会見物のお手伝いをしてくださったことがありましたよね。",
      "UnitTalk_TWN": "話說回來，城市觀光也是和團長一起的。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_30.ogg"
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그때부터 지금까지, 단장님은 항상 저를 도와주시는군요.",
      "UnitTalk_JPN": "団長は、その時からずっと…わたしのことを助けてくださいました。",
      "UnitTalk_TWN": "從那時到現在，團長總是在幫助我呢。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_31.ogg"
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>카파라카</color>에 걸렸을 때 다나도 도와줬잖아.",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>カパラカ</color>にかかった時、ダーナも助けてくれたよ。",
          "JumpAnchorStringId_TWN": "達娜在我得<color=#F7BE45>卡帕拉卡</color>時也幫助過我啊。"
        }
      ]
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 맞아요. 하지만 부족한 걸요.",
      "UnitTalk_JPN": "あはは！そうでしたね。でも、まだ足りませんよ。",
      "UnitTalk_TWN": "啊哈哈！沒錯，但還不夠。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_32.ogg"
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장님에게 받은 <color=#F7BE45>로로카</color>가 너무 커서 어떻게 갚아야 할지 모르겠어요.",
      "UnitTalk_JPN": "団長からいただいた<color=#F7BE45>ロロカ</color>が大きすぎて、どうお返しすればいいのか…",
      "UnitTalk_TWN": "我從團長那裡得到的<color=#F7BE45>洛洛卡</color>太多了，不知道該怎麼報答才好。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_33.ogg"
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "그러니 지금은 <color=#F7BE45>여정</color>에 집중할래요.",
      "UnitTalk_JPN": "だから今は、<color=#F7BE45>救援の旅</color>に集中しようと思います。",
      "UnitTalk_TWN": "所以現在我想專注在<color=#F7BE45>旅行</color>上。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_34.ogg"
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "단장님과 저의 목표, <color=#F7BE45>여정</color>을 통과해서!",
      "UnitTalk_JPN": "団長とわたしの目標である、<color=#F7BE45>救援の旅</color>を通過して！",
      "UnitTalk_TWN": "團長和我的目標，就是通過<color=#F7BE45>旅行</color>！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_35.ogg"
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "단장님이 환하게 웃는 모습을 보고 싶거든요.",
      "UnitTalk_JPN": "団長の明るい笑顔が見たいのです。",
      "UnitTalk_TWN": "我想看到團長燦爛的笑容。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_07_DRUID_36.ogg"
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": false,
      "WaitTime": 0.8,
      "BgFadeInStartCol": [
        "0",
        "0",
        "0",
        "0"
      ],
      "BgFadeInCol": [
        "0",
        "0",
        "0",
        "1"
      ],
      "BgFadeInTime": 0.8
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_15.mp3",
      "UnitTalk_KOR": "그때, <color=#F7BE45>로켓 점화식</color>을 가까이서 보기 위해 몰려든 사람들에게 휩쓸리고 말았다.",
      "UnitTalk_JPN": "その時、<color=#F7BE45>ロケットの打ち上げ</color>を近くで見ようとする人の波にのまれてしまった。",
      "UnitTalk_TWN": "此時，為了近距離看<color=#F7BE45>火箭點火儀式</color>而擁擠的人群把我們沖散了。",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이런…!",
          "JumpAnchorStringId_JPN": "しまった…！",
          "JumpAnchorStringId_TWN": "糟了…！"
        }
      ]
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "ONE_3",
      "UnitTalk_KOR": "하지만 사람들 사이에서 뻗어 나온 손이 내 손을 붙잡았다.",
      "UnitTalk_JPN": "しかし、人混みから伸びた手が、私の手を掴んだ。",
      "UnitTalk_TWN": "但在人群中伸出的手抓住了我的手。",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_07",
