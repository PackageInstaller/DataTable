      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "당신은!! 어, 어쩌면 틀렸을 가능성이 있을지도 없을지도...",
