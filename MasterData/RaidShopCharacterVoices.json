[
  {
    "Id": 10060701,
    "Message": "戦果と物資を整理しておきました！\n他に手伝えることはありますか！",
    "VoiceAssetId": "tvilliris/uniq/22100",
    "VoicePlayType": 1,
    "ExpressionType": "02_csm",
    "RaidId": 100607,
    "NpcAssetId": 8002
  },
  {
    "Id": 10060702,
    "Message": "おつかれさまです、陛下。\n陛下のがんばりを見ていると、\nもっとがんばらなきゃって思います！",
    "VoiceAssetId": "tvilliris/uniq/22202",
    "VoicePlayType": 1,
    "ExpressionType": "10_like",
    "RaidId": 100607,
    "NpcAssetId": 8001
  },
  {
    "Id": 10060703,
    "Message": "つい陛下に期待して、負担ばかりかけて…\nでも！みんな陛下が大好きで、応援してて！\nちびりすも、応援してますから…！",
    "VoiceAssetId": "tvilliris/uniq/22101",
    "VoicePlayType": 2,
    "ExpressionType": "02_csm",
    "RaidId": 100607,
    "NpcAssetId": 8001
  },
  {
    "Id": 10060704,
    "Message": "大丈夫！陛下は絶対に負けませんっ！\nGARDENランヴィリズマに栄光を！",
    "VoiceAssetId": "tvilliris/uniq/22102",
    "VoicePlayType": 2,
    "ExpressionType": "01_osm",
    "RaidId": 100607,
    "NpcAssetId": 8002
  },
  {
    "Id": 10060705,
    "Message": "はわわ！ごめんなさい、物資はもうなくて…\nでもでも！それは陛下がすーーーっごく\nがんばったって証なんです！すごいですっ♪",
    "VoiceAssetId": "tvilliris/uniq/22103",
    "VoicePlayType": 4,
    "ExpressionType": "05_sad",
    "RaidId": 100607,
    "NpcAssetId": 8002
  },
  {
    "Id": 10060706,
    "Message": "物資はもう、全部なくなっちゃって……\n陛下のがんばりに、お応えできなくて…\n本当にごめんだざいﾞいﾞいﾞいﾞ",
    "VoiceAssetId": "tvilliris/uniq/22204",
    "VoicePlayType": 4,
    "ExpressionType": "16_cry",
    "RaidId": 100607,
    "NpcAssetId": 8001
  },
  {
    "Id": 10060707,
    "Message": "全部達成ですっ♪やったー！ぱちぱちぱちー！\n陛下はやっぱりすごいですねっ♪\nメイズママみたいには出来ないですけど、\nよしよしとか、し、します…？",
    "VoiceAssetId": "tvilliris/uniq/22209",
    "VoicePlayType": 3,
    "ExpressionType": "02_csm",
    "RaidId": 100607,
    "NpcAssetId": 8001
  },
  {
    "Id": 10060708,
    "Message": "やったやったぁ♪陛下すごーいっ!!\n目標全部達成なんて、すごすぎますっ♪\nみんなに自慢してもいいですか？\n陛下はすごいんだよって！えへんっ♪",
    "VoiceAssetId": "tvilliris/uniq/22218",
    "VoicePlayType": 3,
    "ExpressionType": "01_osm",
    "RaidId": 100607,
    "NpcAssetId": 8002
  },
  {
    "Id": 10060709,
    "Message": "おつかれさまです、陛下。\n陛下のがんばりを見ていると、\nもっとがんばらなきゃって思います！",
    "VoiceAssetId": "tvilliris/uniq/22202",
    "VoicePlayType": 5,
    "ExpressionType": "10_like",
    "RaidId": 100607,
    "NpcAssetId": 8001
  },
  {
    "Id": 10060710,
    "Message": "陛下、へーかっ！大変ですよ！\n期限…、せまってます！\n忘れたら一大事ですよっ！",
    "VoiceAssetId": "tvilliris/uniq/22203",
    "VoicePlayType": 6,
    "ExpressionType": "02_csm",
    "RaidId": 100607,
    "NpcAssetId": 8002
  },
  {
    "Id": 10060711,
    "Message": "どうぞこちらですっ♪",
    "VoiceAssetId": "tvilliris/uniq/22063",
    "VoicePlayType": 7,
    "ExpressionType": "02_csm",
    "RaidId": 100607,
    "NpcAssetId": 8001
  },
  {
    "Id": 10060712,
    "Message": "ありがとうございますー♪",
    "VoiceAssetId": "tvilliris/uniq/22061",
    "VoicePlayType": 7,
    "ExpressionType": "01_osm",
    "RaidId": 100607,
    "NpcAssetId": 8002
  },
  {
    "Id": 10060713,
    "Message": "目標を整理しておきました。\n少しでも、陛下のお力にならせてください",
    "VoiceAssetId": "tvilliris/uniq/22216",
    "VoicePlayType": 5,
    "ExpressionType": "01_osm",
    "RaidId": 100607,
    "NpcAssetId": 8001
