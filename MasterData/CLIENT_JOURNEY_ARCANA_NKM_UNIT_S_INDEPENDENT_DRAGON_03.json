      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "여의 깊은 곳에 고이 잠재워 놓은, 어두운 과거 중… 하나이니라.",
      "UnitTalk_JPN": "余の心の奥深くにしまっておいた…暗い過去の一つじゃ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "흑역사인가…",
