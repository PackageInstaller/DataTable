      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "혹시 표지에 그려진 찌그려진 용도…",
