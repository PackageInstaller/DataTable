      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_LPU_POST_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_LPU_POST",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "…하, 한 번쯤 도전해보는 정도라면…",
      "UnitTalk_JPN": "…い、一回やってみるくらいなら…",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_LPU_POST_02",
      "WaitClick": true,
