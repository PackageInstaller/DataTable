[
  {
    "id": "1001",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1001",
    "tipsLanText": "【轻锐】职业可以跨越单位1的地形障碍。"
  },
  {
    "id": "1002",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1002",
    "tipsLanText": "攻击带有【护盾】的单位，物理攻击的效果远高于构素攻击。"
  },
  {
    "id": "1003",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1003",
    "tipsLanText": "【远击】职业在进入瞄准状态后，能够获得距离3-7的十字射程范围。"
  },
  {
    "id": "1004",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1004",
    "tipsLanText": "【宿卫】职业拥有更强的生存力，防御力和生命值往往比其他器者更高"
  },
  {
    "id": "1005",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1005",
    "tipsLanText": "【战略】职业可以构筑警戒圈，并自动攻击进入范围内的敌人"
  },
  {
    "id": "1006",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1006",
    "tipsLanText": "【构术】职业的器者可以通过消耗能量，来施展独特的个人技能。"
  },
  {
    "id": "1007",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1007",
    "tipsLanText": "在缺乏保护的情况下，【远击/构术/战略】职业生存力会比较差。"
  },
  {
    "id": "1008",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1008",
    "tipsLanText": "有治疗类型的器者在场，会让整支队伍的续航性提升不少。"
  },
  {
    "id": "1009",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1009",
    "tipsLanText": "轻锐虽然有着很强的机动力，但是孤军深入仍然是大忌。"
  },
  {
    "id": "1010",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1010",
    "tipsLanText": "在有的地图里，远击所具有的长射程会带来出乎预料的先手优势。"
  },
  {
    "id": "1011",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1011",
    "tipsLanText": "围绕着战略器者，利用警戒范围来进行防御战也同样是一种战术。"
  },
  {
    "id": "1012",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1012",
    "tipsLanText": "部分敌人具有很高的物理防御力，构术器者的攻击或许会有不错的效果。"
  },
  {
    "id": "1013",
    "group": "Tips01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1013",
    "tipsLanText": "一位优秀的宿卫总是能站在队友们的前方，为他们挡下大量火力。"
  },
  {
    "id": "1014",
    "group": "Tips02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1014",
    "tipsLanText": "一件适合的装备，能够有效提升器者的强度。"
  },
  {
    "id": "1015",
    "group": "Tips02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1015",
    "tipsLanText": "致知等级提升到一定阶段后，会将器者的技能大幅度强化。"
  },
  {
    "id": "1016",
    "group": "Tips02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1016",
    "tipsLanText": "通过考核，可以提升器者的等级上限。"
  },
  {
    "id": "1017",
    "group": "Tips02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1017",
    "tipsLanText": "可在考核界面中查看器者的写照衣装所需的解锁条件。"
  },
  {
    "id": "1018",
    "group": "Tips02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1018",
    "tipsLanText": "鎏金骑士在战斗中承伤能力会越来越强。"
  },
  {
    "id": "1019",
    "group": "Tips02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1019",
    "tipsLanText": "装备武器能强化器者属性，并且自带一个武器技能。"
  },
  {
    "id": "1020",
    "group": "Tips02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1020",
    "tipsLanText": "每日任务中可以领取奖励。"
  },
  {
    "id": "1021",
    "group": "Tips02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1021",
    "tipsLanText": "器者们的一部分故事，可以在【器者档案】中进行查看。"
  },
  {
    "id": "1022",
    "group": "Tips02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1022",
    "tipsLanText": "在【演训-基础训练-装备】关卡，能获取特定的装备和其养成材料。"
  },
  {
    "id": "1023",
    "group": "huazhao",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1023",
    "tipsLanText": "花朝节，简称花朝，俗称“花神节”、“百花生日”、“花神生日”。"
  },
  {
    "id": "1024",
    "group": "huazhao",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1024",
    "tipsLanText": "百花生日是良辰，未到花朝一半春；万紫千红披锦绣，尚劳点缀贺花神。"
  },
  {
    "id": "1025",
    "group": "huazhao",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1025",
    "tipsLanText": "【四时花朝夜】活动将会在1月4日到1月7日期间开放。"
  },
  {
    "id": "1026",
    "group": "huazhao",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1026",
    "tipsLanText": "【四时花朝夜】将会开启新的关卡与剧情。"
  },
  {
    "id": "1027",
    "group": "huazhao",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1027",
    "tipsLanText": "一般北方以二月十五为花朝，而南方则以二月十二为百花生日。"
  },
  {
    "id": "1028",
    "group": "Story",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1028",
    "tipsLanText": "基金会的四个部门，每个部门有单独的评级系统，根据不同评级给收藏家和器者不同的执照权限。"
  },
  {
    "id": "1029",
    "group": "Story",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1029",
    "tipsLanText": "中秋祀当境土神，与二月二日同，访秋报也。四境歌吹相闻，为之社戏。"
  },
  {
    "id": "1030",
    "group": "Story",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1030",
    "tipsLanText": "光明并非光明，黑暗实乃黑暗，江海大地悲鸣，世代蚕食蛀空。建立在梦境和虚空之中，无根无凭的灾难来客啊，你的灾难来临……享受吧。"
  },
  {
    "id": "1031",
    "group": "Story",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1031",
    "tipsLanText": "基金会的四个部门，每个部门有单独的评级系统，根据不同评级给收藏家和器者不同的执照权限。"
  },
  {
    "id": "1032",
    "group": "Boss01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1032",
    "tipsLanText": "【地土】拥有较高的防御性能和近战能力，可以尝试对其进行远程攻击。"
  },
  {
    "id": "1033",
    "group": "Boss01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1033",
    "tipsLanText": "在面对【地土】的范围攻击时，太过密集的站位会使战局陷入劣势。"
  },
  {
    "id": "1034",
    "group": "Boss01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1034",
    "tipsLanText": "【地土】拥有摧毁地面的能力，当见到地面出现皲裂时，请注意回避。"
  },
  {
    "id": "1035",
    "group": "Boss01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1035",
    "tipsLanText": "当【地土】蓄力完成后，会生成抵抗伤害的护盾。需要多次攻击才能将其击破。"
  },
  {
    "id": "1036",
    "group": "Boss01",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1036",
    "tipsLanText": "【地土】能召唤出会爆破的岩柱，请尽快将其击毁。"
  },
  {
    "id": "1037",
    "group": "Boss02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1037",
    "tipsLanText": "【天月】所召唤的眷属会携带神秘力量。若未能正确时机击杀眷属，天月将会获得强化效果。"
  },
  {
    "id": "1038",
    "group": "Boss02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1038",
    "tipsLanText": "注意避开【天月】的淹没技能。"
  },
  {
    "id": "1039",
    "group": "Boss02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1039",
    "tipsLanText": "注意【天月】的状态，不同状态下她将享有不同类型的属性抗性。"
  },
  {
    "id": "1040",
    "group": "Boss02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1040",
    "tipsLanText": "【天月】会在战斗过程中向着远处撤离。"
  },
  {
    "id": "1041",
    "group": "Boss02",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1041",
    "tipsLanText": "每一个阶段【天月】都会向着远处撤离。"
  },
  {
    "id": "1042",
    "group": "Boss03",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1042",
    "tipsLanText": "【火婴】具有很高的输出能力。"
  },
  {
    "id": "1043",
    "group": "Boss03",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1043",
    "tipsLanText": "【火婴】能够召唤出名为【烈焰之乘】的敌人。"
  },
  {
    "id": "1044",
    "group": "Boss03",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1044",
    "tipsLanText": "若【火婴】的烈焰之矛未能击中目标，则会向所有人释放三昧真火。"
  },
  {
    "id": "1045",
    "group": "Boss03",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1045",
    "tipsLanText": "召唤出【烈焰之乘】后，【火婴】会暂时离开战场。"
  },
  {
    "id": "1046",
    "group": "Boss03",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1046",
    "tipsLanText": "【烈焰之乘】到达目标点时，会对所有器者造成伤害。"
  },
  {
    "id": "1051",
    "group": "Boss04",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1051",
    "tipsLanText": "处于【流失】中时，移动会损失大量生命值。"
  },
  {
    "id": "1052",
    "group": "Boss04",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1052",
    "tipsLanText": "骨刻持有3层“幻相”，每层都会给与骨刻一个强化效果。每受到3次攻击都会破坏1层“幻相”。"
  },
  {
    "id": "1053",
    "group": "Boss04",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1053",
    "tipsLanText": "骨刻未持有“幻相”时，攻击会变成范围型。"
  },
  {
    "id": "1054",
    "group": "Boss04",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1054",
    "tipsLanText": "其召唤的“骨化阵列”拥有召唤狂风和释放导弹的能力，可以利用其导弹的残骸来躲避狂风。"
  },
  {
    "id": "1055",
    "group": "Boss04",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1055",
    "tipsLanText": "若是被“骨化阵列”吹至地形下，器者会受到大量伤害。"
  },
  {
    "id": "1061",
    "group": "Boss05",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1061",
    "tipsLanText": "与【诡月】的战斗会分两个阶段进行，先进行试炼，再与【诡月】决战。"
  },
  {
    "id": "1062",
    "group": "Boss05",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1062",
    "tipsLanText": "在【试炼·阵】中，拥有高移动力的器者会拥有较大优势。"
  },
  {
    "id": "1063",
    "group": "Boss05",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1063",
    "tipsLanText": "在【试炼·守】中，宿卫或构术能更好的完成试炼。"
  },
  {
    "id": "1064",
    "group": "Boss05",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1064",
    "tipsLanText": "在【试炼·战】中，拥有大范围攻击的器者会有较大优势。"
  },
  {
    "id": "1065",
    "group": "Boss05",
    "tipsLan": "loadingdownloadlan_loadingTips_tipsLan_1065",
    "tipsLanText": "合理利用试炼中获得的祝福，能更轻松地战胜【诡月】。"
  }
]
