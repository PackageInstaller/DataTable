    "NameLan": "activeLan_lottery_namelan_93005",
    "NameLanText": "从军行七首 其五",
    "DescriptionLan": "activeLan_lottery_descriptionLan_93005",
    "DescriptionLanText": "大漠风尘日色昏，\n红旗半卷出辕门。",
    "Description1Lan": "activeLan_lottery_description1_93005",
    "Description1LanText": "<size=40>大漠风尘日色昏，红旗半卷出辕门。\n前军夜战洮河北，已报生擒吐谷浑。</size>",
    "Description2Lan": "activeLan_lottery_description2_93005",
    "Description2LanText": "《从军行七首 其五》为王昌龄采用乐府古题所作的边塞诗。大漠狂风四起，尘沙遮蔽天光，旌旗猎猎。从战场之悲凉急转至捷报频传，利落描写唐军之英姿。",
    "DynastyLan": "activeLan_lottery_dynasty_93005",
    "DynastyLanText": "唐·王昌龄",
    "Punctuation": [
      "ui_yysh_jl_dh",
      "ui_yysh_jl_jh"
    ],
    "Voice": "TangPoetry_30"
  },
  "93006": {
    "ID": "93006",
    "Type": 1,
    "Reward": [
      {
        "id": "112301",
        "count": 1
      }
    ],
    "Rate": 500,
