        "id": "3210",
        "count": 1
      }
    ],
    "Rate": 500,
    "Min": 0,
    "Icon": "ui_yysh_jz_01",
    "Point": 1,
    "NameLan": "activeLan_lottery_namelan_91001",
    "NameLanText": "峨眉山月歌",
    "DescriptionLan": "activeLan_lottery_descriptionLan_91001",
    "DescriptionLanText": "峨眉山月半轮秋，\n影入平羌江水流。",
    "Description1Lan": "activeLan_lottery_description1_91001",
    "Description1LanText": "<size=40>峨眉山月半轮秋，影入平羌江水流。\n夜发清溪向三峡，思君不见下渝州。</size>",
    "Description2Lan": "activeLan_lottery_description2_91001",
    "Description2LanText": "《峨眉山月歌》据传作于青年李白初出四川之时。秋月高悬，映照青山，舟行流水中，忆及故人。行旅蜀地，以自由之景写自由之人，广阔的时空带他进入下一程。",
    "DynastyLan": "activeLan_lottery_dynasty_91001",
    "DynastyLanText": "唐·李白",
    "Punctuation": [
      "ui_yysh_jl_dh",
      "ui_yysh_jl_jh"
    ],
    "Voice": "TangPoetry_10"
  },
  "91002": {
    "ID": "91002",
    "Type": 1,
    "Reward": [
      {
        "id": "3",
        "count": 10000
      }
    ],
    "Rate": 500,
    "Min": 1,
    "Icon": "ui_yysh_jz_02",
    "Point": 2,
    "NameLan": "activeLan_lottery_namelan_91002",
    "NameLanText": "蜀道难",
    "DescriptionLan": "activeLan_lottery_descriptionLan_91002",
    "DescriptionLanText": "剑阁峥嵘而崔嵬，\n一夫当关，万夫莫开。",
    "Description1Lan": "activeLan_lottery_description1_91002",
    "Description1LanText": "<size=28>噫吁嚱，危乎高哉！蜀道之难，难于上青天！蚕丛及鱼凫，开国何茫然！尔来四万八千岁，不与秦塞通人烟。西当太白有鸟道，可以横绝峨眉巅。地崩山摧壮士死，然后天梯石栈相钩连。上有六龙回日之高标，下有冲波逆折之回川。黄鹤之飞尚不得过，猿猱欲度愁攀援。青泥何盘盘，百步九折萦岩峦。扪参历井仰胁息，以手抚膺坐长叹。\n\n问君西游何时还？畏途巉岩不可攀。但见悲鸟号古木，雄飞雌从绕林间。又闻子规啼夜月，愁空山。蜀道之难，难于上青天，使人听此凋朱颜！连峰去天不盈尺，枯松倒挂倚绝壁。飞湍瀑流争喧豗，砯崖转石万壑雷。其险也如此，嗟尔远道之人胡为乎来哉！\n\n剑阁峥嵘而崔嵬，一夫当关，万夫莫开。所守或匪亲，化为狼与豺。朝避猛虎，夕避长蛇；磨牙吮血，杀人如麻。锦城虽云乐，不如早还家。蜀道之难，难于上青天，侧身西望长咨嗟！</size>",
    "Description2Lan": "activeLan_lottery_description2_91002",
    "Description2LanText": "《蜀道难》袭用乐府古题，全诗律体与散文间杂。李白就蜀道之景展开惊奇的想象，咏叹回旋激荡，从中得见诗歌的浪漫。笔意可谓浩浩汤汤，直抵人心。",
    "DynastyLan": "activeLan_lottery_dynasty_91002",
    "DynastyLanText": "唐·李白",
    "Punctuation": [
      "ui_yysh_jl_dh",
      "ui_yysh_jl_jh"
    ],
    "Voice": "TangPoetry_11"
  },
