    "NameLan": "activeLan_lottery_namelan_92007",
    "NameLanText": "哭晁卿衡",
    "DescriptionLan": "activeLan_lottery_descriptionLan_92007",
    "DescriptionLanText": "明月不归沉碧海，\n白云愁色满苍梧。",
    "Description1Lan": "activeLan_lottery_description1_92007",
    "Description1LanText": "<size=40>日本晁卿辞帝都，征帆一片绕蓬壶。\n明月不归沉碧海，白云愁色满苍梧。</size>",
    "Description2Lan": "activeLan_lottery_description2_92007",
    "Description2LanText": "《哭晁卿衡》据载作于李白听闻日本遣唐使阿倍仲麻吕归国途中没于海难时，虽为讹传，其间情感，深切悲痛。远归的友人啊，一如明月沉海，阴云笼青山。",
    "DynastyLan": "activeLan_lottery_dynasty_92007",
    "DynastyLanText": "唐·李白",
    "Punctuation": [
      "ui_yysh_jl_dh",
      "ui_yysh_jl_jh"
    ],
    "Voice": "TangPoetry_24"
  },
  "92008": {
    "ID": "92008",
    "Type": 1,
