    "Icon": "ui_yysh_jz_03",
    "Point": 3,
    "NameLan": "activeLan_lottery_namelan_91003",
    "NameLanText": "早发白帝城",
    "DescriptionLan": "activeLan_lottery_descriptionLan_91003",
    "DescriptionLanText": "朝辞白帝彩云间，\n千里江陵一日还。",
    "Description1Lan": "activeLan_lottery_description1_91003",
    "Description1LanText": "<size=40>朝辞白帝彩云间，千里江陵一日还。\n两岸猿声啼不住，轻舟已过万重山。</size>",
    "Description2Lan": "activeLan_lottery_description2_91003",
    "Description2LanText": "《早发白帝城》据传作于李白流放途中遇赦返还之时。写山势之高峻，写猿鸣犹在耳，写舟行流畅而飘然。诗人心情之畅快看江山之壮丽，岂不快哉！",
    "DynastyLan": "activeLan_lottery_dynasty_91003",
    "DynastyLanText": "唐·李白",
    "Punctuation": [
      "ui_yysh_jl_dh",
      "ui_yysh_jl_jh"
    ],
    "Voice": "TangPoetry_12"
  },
