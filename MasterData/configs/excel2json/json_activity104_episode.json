        [11200,1,1201101,1,"《未经塑造之人》","The Shapeless Mass","07",75,"1#2#3#4",120071,0,"问吧。即使答案将如同它的灵魂一般缺失。"],
        [11200,2,1201102,1,"《未经塑造之人》","The Shapeless Mass","07",80,"",0,0,"与舞女跳起失传久矣的戏仿节目。好处是，无人知晓舞步正确与否。"],
        [11200,3,1201103,1,"《未经塑造之人》","The Shapeless Mass","07",95,"",120472,0,"那颗泥土做成的心。它究竟，究竟如何来到这个世界上？"],
        [11200,4,1201104,2,"《福特现象》","Fortean","04",95,"",0,0,"一壶沸腾的茶，一艘终于靠岸的船。这就是全部了，这就是全部。"],
        [11200,5,1201105,2,"《福特现象》","Fortean","04",95,"",0,0,"震颤，轰鸣。那把电锯已经很久没用过了。"],
        [11200,6,1201106,2,"《福特现象》","Fortean","04",105,"9",120255,0,"在墓园起舞，以腿骨敲响脊柱。"],
        [11200,7,1201107,3,"《失落的世界》","The Lost World","02",105,"",0,0,"多数时候，它和一张无害的拼贴画也没什么不同。"],
        [11200,8,1201108,3,"《失落的世界》","The Lost World","02",105,"",0,0,"伯爵，你为何不喜爱太阳？"],
        [11200,9,1201109,3,"《失落的世界》","The Lost World","02",110,"5#6#7#8",120025,400202,"“送给你，这湖底最漂亮的鹅卵石。”\n是的，它光滑，就像一枚子弹。"],
        [11200,10,1201110,4,"《群鸟》","The Birds","01",110,"",0,0,"海鸥，知更鸟。好啦，这地方是一座鸟儿坟场。"],
        [11200,11,1201111,4,"《群鸟》","The Birds","01",110,"",0,0,"猫头鹰的脖子可以旋转一百八十度。人的脖子也一样。"],
        [11200,12,1201112,4,"《群鸟》","The Birds","01",115,"",120285,0,"不——那并非日食。而是乌鸦遮蔽了太阳。"],
        [11200,13,1201113,5,"《阴翳飞溅》","The Splashing Shadow","06",115,"",0,0,"杰森、麦克、弗莱迪。我有过一些名字，它们都是不错的名字。"],
        [11200,14,1201114,5,"《阴翳飞溅》","The Splashing Shadow","06",115,"",0,0,"出行安全，宝贝。出行安全。"],
        [11200,15,1201115,5,"《阴翳飞溅》","The Splashing Shadow","06",120,"",120275,400203,"“知道吗，只有握在手里的砍刀，和眼前破裂的血管，才最靠得住。”"],
        [11200,16,1201116,6,"《置之“死”地》","In A Death Gournd","05",120,"",0,0,"这烛光与温暖毫无关联，仅能短暂照亮新娘那白色的面庞。"],
        [11200,17,1201117,6,"《置之“死”地》","In A Death Gournd","05",120,"",0,0,"献上我的爱和一个吻，以及许多、许多的银色长针。"],
        [11200,18,1201118,6,"《置之“死”地》","In A Death Gournd","05",120,"",0,0,"又一个平凡无奇的夜晚。收音机的消息并不总是准确，对吗？"],
        [11200,19,1201119,6,"《置之“死”地》","In A Death Gournd","05",120,"",0,0,"活死人不欣赏消费主义，显而易见。"],
        [11200,20,1201120,6,"《置之“死”地》","In A Death Gournd","05",121,"",10004,400204,"坟地与化工厂可不是玩乐的好去处。"],
        [11200,21,1201121,7,"《屏住呼吸》","Hold Your Breath","03",121,"",0,0,"画布上，一缕长而崎岖的路，兀自走向某人的小屋。"],
        [11200,22,1201122,7,"《屏住呼吸》","Hold Your Breath","03",121,"",0,0,"每一刀。每一刀的下落都发生在镜头之外。"],
        [11200,23,1201123,7,"《屏住呼吸》","Hold Your Breath","03",130,"",0,0,"感受，但不要闭眼。"],
        [11200,24,1201124,7,"《屏住呼吸》","Hold Your Breath","03",130,"",0,0,"黑暗坍缩成门洞中的眼睛。血丝遍布，清晰，满溢。"],
        [11200,25,1201125,7,"《屏住呼吸》","Hold Your Breath","03",140,"",0,0,"山羊的眼睛，鲸鱼的皮毛，黑猿的肢体。人们都这样被拼凑而来，朋友。"],
        [11200,26,1201126,7,"《屏住呼吸》","Hold Your Breath","03",140,"",0,0,"放宽心。真实的利齿并不喰吸虚构的血液。"],
        [11200,27,1201127,7,"《屏住呼吸》","Hold Your Breath","03",140,"",0,0,"时间一片一片带走所有人的皮肤。"],
        [11200,28,1201128,7,"《屏住呼吸》","Hold Your Breath","03",140,"",0,0,"尖叫的凤头鹦鹉停止尖叫。"],
        [11200,29,1201129,7,"《屏住呼吸》","Hold Your Breath","03",150,"",0,0,"“我能——我能做些什么？”"],
        [11200,30,1201130,7,"《屏住呼吸》","Hold Your Breath","03",150,"",0,0,"就只是，别关掉音响，好吗？"],
        [11300,1,1301101,1,"《自火中生》","From the Fire","01",75,"1#2#3#4",130071,0,"马祠的祭礼迎来了神奶，神奶被分给了三位王妃，她们诞下了四位王子。"],
        [11300,2,1301102,1,"《自火中生》","From the Fire","01",80,"",0,0,"据传言，神子们自火焰中诞生。降生时刻，他们的眼眸中闪烁着光火。"],
        [11300,3,1301103,1,"《自火中生》","From the Fire","01",95,"",130622,0,"湿婆的神弓于选婿大会上破裂，而罗摩与悉多的爱意弥坚。"],
        [11300,4,1301104,2,"《至林中去》","To the Forest","02",95,"",0,0,"王后在战场上救下了国王的命。国王便应允了她两个愿望。"],
        [11300,5,1301105,2,"《至林中去》","To the Forest","02",95,"",0,0,"嫉妒与贪婪化作绳索，沾染了这两个愿望。\n即位大典前夕，等待王子的是一场十四年的放逐。"],
        [11300,6,1301106,2,"《至林中去》","To the Forest","02",105,"9",130595,400302,"王国被拱手相让，或是失去，或是无力守护。继位者婆罗多不愿为王，取长兄罗摩的鞋子为证，待其归来。"],
        [11300,7,1301107,3,"《化身金鹿》","The Golden Deer","03",105,"",0,0,"罗摩走上了流放之路，魔王罗波那派出罗刹阻拦，自此，危机与侵害常伴。"],
        [11300,8,1301108,3,"《化身金鹿》","The Golden Deer","03",105,"",0,0,"魔女首哩薄那迦对罗摩心生爱意，却未得回应。她欲吞下悉多的计划也落空，终被剜去耳鼻。"],
        [11300,9,1301109,3,"《化身金鹿》","The Golden Deer","03",110,"5#6#7#8",130585,0,"魔王罗波那派手下化身金鹿，引开罗摩，他便趁机劫走了悉多。"],
        [11300,10,1301110,4,"《猴国之旅》","The Monkey Kingdom","04",110,"",0,0,"无头的怪物劝说罗摩前往猴国。在那片国度，猴王须羯哩婆正经历着兄弟相残。"],
        [11300,11,1301111,4,"《猴国之旅》","The Monkey Kingdom","04",110,"",0,0,"罗摩帮助猴王须羯哩婆重获王位后，须羯哩婆沉迷美色，致使王权荒废。"],
        [11300,12,1301112,4,"《猴国之旅》","The Monkey Kingdom","04",115,"",130015,400303,"背叛与失信化作灭国之火，须羯哩婆听了妻子陀罗一席言说，终使良心不昧。"],
        [11300,13,1301113,5,"《神猴哈奴曼》","Hanuman","05",115,"",0,0,"神猴哈奴曼自此忠心相随。他一路向南，跨越大海至楞伽岛，找到了悉多的下落。"],
        [11300,14,1301114,5,"《神猴哈奴曼》","Hanuman","05",115,"",0,0,"哈奴曼将罗摩的戒指转交给悉多，表示救援之意。悉多却拒绝了与哈奴曼同行，执意等待罗摩亲至。"],
        [11300,15,1301115,5,"《神猴哈奴曼》","Hanuman","05",120,"",130575,0,"神猴大闹魔国，被捕仍威胁罗波那放走悉多。\n愤怒的魔王点燃了神猴的尾巴，神猴飞出牢笼，带着火势一路烧毁魔国的城市，返回到罗摩身旁。"],
        [11300,16,1301116,6,"《不死甘露》","The Nectar of Immortality","06",120,"",0,0,"罗摩用神兵开拓了一条跨越大海的桥梁，直通楞伽岛。"],
        [11300,17,1301117,6,"《不死甘露》","The Nectar of Immortality","06",120,"",0,0,"魔王的弟弟维毗沙那正直而刚毅，他敬佩罗摩，并视之为友。"],
        [11300,18,1301118,6,"《不死甘露》","The Nectar of Immortality","06",120,"",0,0,"维毗沙那见罗波那不听劝阻、执意开战，决心离开兄长，投奔罗摩。"],
        [11300,19,1301119,6,"《不死甘露》","The Nectar of Immortality","06",120,"",0,0,"罗摩率领大军渡桥，与魔军激战，伤亡惨重。"],
        [11300,20,1301120,6,"《不死甘露》","The Nectar of Immortality","06",121,"",10004,400304,"罗摩一箭射穿了罗波那的头颅，可魔王的头颅不断再生。十颗、百颗头颅被消灭，魔王仍然生还，直至心脏中箭。"],
        [11300,21,1301121,7,"《十颗头颅》","The Ten Heads","07",121,"",0,0,"色欲是第一颗头，罗波那因色欲拐走悉多，引发了这场战火。"],
        [11300,22,1301122,7,"《十颗头颅》","The Ten Heads","07",121,"",0,0,"愤怒是第二颗头，罗波那因愤怒而执意与罗摩开战，致使胞弟维毗沙那的背叛。"],
        [11300,23,1301123,7,"《十颗头颅》","The Ten Heads","07",130,"",0,0,"诱惑是第三颗头，罗波那受挑拨而怨恨罗摩。"],
        [11300,24,1301124,7,"《十颗头颅》","The Ten Heads","07",130,"",0,0,"贪婪是第四颗头，也是凡人的弱点，无尽的财富与权力都填不满心的窟窿。"],
        [11300,25,1301125,7,"《十颗头颅》","The Ten Heads","07",140,"",0,0,"骄傲是第五颗头，自满孕育盲目，盲目孕育倾覆，楞伽的纷乱始于此。"],
        [11300,26,1301126,7,"《十颗头颅》","The Ten Heads","07",140,"",0,0,"嫉妒是第六颗头，不曾拥有的美德与财富都令罗波那发狂，这成为了他丧失良知与理智，走向毁灭的根源。"],
        [11300,27,1301127,7,"《十颗头颅》","The Ten Heads","07",140,"",0,0,"自私是第七颗头，手下与亲人皆可利用。"],
        [11300,28,1301128,7,"《十颗头颅》","The Ten Heads","07",140,"",0,0,"不公是第八颗头，侵害无辜，酿成苦难。"],
        [11300,29,1301129,7,"《十颗头颅》","The Ten Heads","07",150,"",0,0,"残暴是第九颗头，杀戮无数生灵，天地也因此愤怒，罗波那以之为名——以暴力让人痛泣。"],
        [11300,30,1301130,7,"《十颗头颅》","The Ten Heads","07",150,"",0,0,"自我是第十颗头，“我执”拒绝了所有劝诫与悔过，向灭亡进发。"],
        [11400,1,1401101,1,"《洞窟寓言》","The Philosopher's Ideas","01",75,"1#2#3#4",140080,0,"镣铐与墙壁，犹如羊水般包裹。"],
        [11400,2,1401102,1,"《洞窟寓言》","The Philosopher's Ideas","01",80,"",140076,0,"黑暗遮蔽火光，于是乎，阴影成为仅存的真实。"],
        [11400,3,1401103,1,"《洞窟寓言》","The Philosopher's Ideas","01",95,"",140081,0,"囿于感官的人，囿于无知。"],
        [11400,4,1401104,2,"《后继者》","The Inheritors","02",95,"",140096,0,"“可那吃人的黑，从何而来？”\n他悄然叩问。"],
        [11400,5,1401105,2,"《后继者》","The Inheritors","02",95,"",140088,0,"“可那逃跑的光，又去往何处？”\n他寻索答案。"],
        [11400,6,1401106,2,"《后继者》","The Inheritors","02",105,"9",0,400402,"在一抹光来临前，智慧先行叩门；\n在一只锁解开前，意志先行挣脱。"],
        [11400,7,1401107,3,"《共筑的高歌》","Joint Achievement","03",105,"",0,0,"他们如鸟兽散，分崩离析，逃往荒原、山林、海岸，以及刺眼的太阳。"],
        [11400,8,1401108,3,"《共筑的高歌》","Joint Achievement","03",105,"",0,0,"同一处河流的人们汇聚，构成了历史；共一堆篝火的人们攀谈，铸成了传说。"],
        [11400,9,1401109,3,"《共筑的高歌》","Joint Achievement","03",110,"5#6#7#8",0,0,"寻臣服的王冠，箍住头脑；供瞻仰的雕塑，坐落而起。"],
        [11400,10,1401110,4,"《博弈集》","Confrontation","04",110,"",0,0,"执着火炬的人，与端水碗的人，握手言欢。"],
        [11400,11,1401111,4,"《博弈集》","Confrontation","04",110,"",0,0,"火，燃烧了黑夜。水亦播撒了荒原。"],
        [11400,12,1401112,4,"《博弈集》","Confrontation","04",115,"",0,400403,"“可孰弱孰优？”\n他们共处一厅，分庭抗礼。"],
        [11400,13,1401113,5,"《天幕的尺》","Origin of Astronomy","05",115,"",0,0,"火光炯炯，仍遮不住眼眸中的繁星。"],
        [11400,14,1401114,5,"《天幕的尺》","Origin of Astronomy","05",115,"",0,0,"丈量脚下的眸，开始丈量无垠的天幕。"],
        [11400,15,1401115,5,"《天幕的尺》","Origin of Astronomy","05",120,"",0,0,"繁星拥有了荣名。无垠之中，人们终于放下了船锚。"],
        [11400,16,1401116,6,"《奇迹的数》","Birth of Mathematics","06",120,"",0,0,"一片叶的脉络，一棵树的年轮……\n他们将这引人着迷的规律，置于掌心抚摸。"],
        [11400,17,1401117,6,"《奇迹的数》","Birth of Mathematics","06",120,"",0,0,"他献给神明以牛犊，方才换取来了真理。\n                          ——赫卡墓的轶闻【这个“赫卡”具体指的是哪位？】"],
        [11400,18,1401118,6,"《奇迹的数》","Birth of Mathematics","06",120,"",0,0,"几何，为视觉王国立下了秩序。"],
        [11400,19,1401119,6,"《奇迹的数》","Birth of Mathematics","06",120,"",0,0,"数字，为万物形状赋予了魂魄。"],
        [11400,20,1401120,6,"《奇迹的数》","Birth of Mathematics","06",121,"",10004,400404,"万物便有了应有的美，万物便归了应去的巢。"],
        [11400,21,1401121,7,"《致以秩序》","Order From Disciplines","07",121,"",0,0,"一、切勿吃豆子。"],
        [11400,22,1401122,7,"《致以秩序》","Order From Disciplines","07",121,"",0,0,"二、东西落下后，切勿捡起。"],
        [11400,23,1401123,7,"《致以秩序》","Order From Disciplines","07",130,"",0,0,"三、切勿触碰白公鸡。"],
        [11400,24,1401124,7,"《致以秩序》","Order From Disciplines","07",130,"",0,0,"四、禁止跳跃牛轭。"],
        [11400,25,1401125,7,"《致以秩序》","Order From Disciplines","07",140,"",0,0,"五、禁止用刀剑拨火。"],
        [11400,26,1401126,7,"《致以秩序》","Order From Disciplines","07",140,"",0,0,"六、禁止在半道上劈柴。"],
        [11400,27,1401127,7,"《致以秩序》","Order From Disciplines","07",140,"",0,0,"七、禁止穿从未穿过的新衣服进入集会厅。进入集会厅时必须从右边进入，左边离开。"],
        [11400,28,1401128,7,"《致以秩序》","Order From Disciplines","07",140,"",0,0,"八、房间里不能有燕子。"],
        [11400,29,1401129,7,"《致以秩序》","Order From Disciplines","07",150,"",0,0,"九、禁止在神圣墙垣内睡觉。"],
        [11400,30,1401130,7,"《致以秩序》","Order From Disciplines","07",150,"",0,0,"十、离开床褥时，要将它卷起，需将睡过的印迹抹平。"],
        [11500,1,1501101,1,"《起点》","","01",75,"1#2#3#4",150094,0,"这是竞技的第一日，一切的开始。"],
        [11500,2,1501102,1,"《起点》","","01",80,"",0,0,"并无开始，亦无结束。左脚，右脚，左脚，右脚。事就这样成了。"],
        [11500,3,1501103,1,"《起点》","","01",95,"",150039,0,"迈动双足，为我尚不知的终点，我在懵懂之中已瞧见它的轮廓。"],
        [11500,4,1501104,2,"《向上之上》","","02",95,"",0,0,"先是一棵树，而后是一座顶峰，四肢并用，紧紧围绕。"],
        [11500,5,1501105,2,"《向上之上》","","02",95,"",0,0,"向上看吧，这尚有更高处，不长长尾的人啊，当以手与足替代飞鸟的双翼。"],
        [11500,6,1501106,2,"《向上之上》","","02",105,"9",0,400502,"一个梦就此发端，当你站得更高，就看得更远。"],
        [11500,7,1501107,3,"《致波浪》","","03",105,"",0,0,"小渠、溪流、大海，水一直是你我可畏的友人。"],
        [11500,8,1501108,3,"《致波浪》","","03",105,"",0,0,"将你包裹，将你承托，也许你会化为游鱼，也许你是一节漂荡的枯枝。"],
        [11500,9,1501109,3,"《致波浪》","","03",110,"5#6#7#8",0,0,"与自然敌对的一课就此落幕。不被吞噬者，是浪涛的主人。"],
        [11500,10,1501110,4,"《猎手之臂》","","04",110,"",0,0,"起初，这是果腹的寒芒。而后，这是一阵可以被投掷的风。"],
        [11500,11,1501111,4,"《猎手之臂》","","04",110,"",0,0,"放出一只闪耀寒芒的鸟儿，它有最流畅的线条，以及一颗只需向着远方的心。"],
        [11500,12,1501112,4,"《猎手之臂》","","04",115,"",0,400503,"经由双手，飞吧，飞吧。撕裂血肉与革皮，越过蓝天与红土，替我接触我所渴望的一切。"],
        [11500,13,1501113,5,"《抛接球》","","05",115,"",0,0,"露西，你知道露西吗？她正是如此抛起一枚圆果。"],
        [11500,14,1501114,5,"《抛接球》","","05",115,"",0,0,"一颗黑夜里的太阳，它向我而来，我只想接住它，再将其抛出。"],
        [11500,15,1501115,5,"《抛接球》","","05",120,"",0,0,"就像是语言，也像是目光，来与往，总是如此简单。"],
        [11500,16,1501116,6,"《奔腾年代》","","06",120,"",0,0,"看那有翼的奔马，自大海涌出，奔赴竞技会，只为胜利驰骋。"],
        [11500,17,1501117,6,"《奔腾年代》","","06",120,"",0,0,"传奇由此发端，由轮毂的碰撞与嘶鸣，由国王之死，由国王的胜利。"],
        [11500,18,1501118,6,"《奔腾年代》","","06",120,"",0,0,"祭火在此点燃，于是御者登上战车，追逐青翠的桂冠。"],
        [11500,19,1501119,6,"《奔腾年代》","","06",120,"",0,0,"抓紧缰绳吧，渴望荣耀的英雄！观众向你抛撒花朵，你的骏马正昂起头颅。"],
        [11500,20,1501120,6,"《奔腾年代》","","06",121,"",10004,400504,"看哪！它咀嚼青草、烈酒与燃料，它的骨架来自良木、青铜与钢铁，它将要在尘土和血中派上用场。"],
        [11500,21,1501121,7,"《并非终点》","","07",121,"",0,0,"“为战争而跑吧，为血的流淌而驾驶吧！”传令兵高声呐喊，“这是战车与战马，这是战士与胜者。”"],
        [11500,22,1501122,7,"《并非终点》","","07",121,"",0,0,"火焰灼热，越过陆地与海洋。如此晕头转向，如此热血沸腾。"],
        [11500,23,1501123,7,"《并非终点》","","07",130,"",0,0,"精神落败于躯体，死神的黑狗在门前守候。"],
        [11500,24,1501124,7,"《并非终点》","","07",130,"",0,0,"我们错了吗？一个朋友为另一个朋友而嚎哭时如此询问。"],
        [11500,25,1501125,7,"《并非终点》","","07",140,"",0,0,"我还记得我们如何会面，我们渡过陆地也游过长河，我们在一颗球的两侧，抛与接，目光相对。"],
        [11500,26,1501126,7,"《并非终点》","","07",140,"",0,0,"让我们再一次相会，以正确的姿势。"],
        [11500,27,1501127,7,"《并非终点》","","07",140,"",0,0,"让我们放下颈上的吊索，在仇恨绞死友人之前。"],
        [11500,28,1501128,7,"《并非终点》","","07",140,"",0,0,"传令兵握紧缰绳，他的战车已然损毁，他的马儿已然跌陨。"],
        [11500,29,1501129,7,"《并非终点》","","07",150,"",0,0,"于是他再一次开始奔跑。这是竞技的第一日。\n人的口中吐出战火，也能流淌愧疚的泪。"],
        [11500,30,1501130,7,"《并非终点》","","07",150,"",0,0,"奔跑吧，梅洛斯。"],
        [11600,1,1601101,1,"《御气学概论》","","01",75,"1#2#3#4",160104,0,"“传言‘气’来自世间万物，能驱使其他物质发生意想不到的变化。”"],
        [11600,2,1601102,1,"《御气学概论》","","01",80,"",0,0,"“‘气’能一定程度代替蒸汽机的运作，笔者猜测其效能恐怕与人力推动火车并无差异。”\n<i>注：“御驾亲征”一词，或证明其统治者善于御气。</i>"],
        [11600,3,1601103,1,"《御气学概论》","","01",95,"",160105,0,"“虽然有俚语‘一屋不扫何以扫天下’，但扫帚的地位显然与剑完全不等同。”\n<i>注：我们仍在努力寻找“剑器驾驶指南”的相关古籍。</i>"],
        [11600,4,1601104,2,"《东方术杖考》","","02",95,"",0,0,"“东方术杖种类繁杂，常以稀松平常之物作为‘法器’，但往往各有其用处。”\n\n"],
        [11600,5,1601105,2,"《东方术杖考》","","02",95,"",0,0,"“‘拂尘’是将白马尾作为须，并能唤使物体变化，无所不能。”\n<i>注：有明令禁止肆意挥舞“拂尘”驱虫。 </i>"],
        [11600,6,1601106,2,"《东方术杖考》","","02",105,"9",0,400602,"“符咒纸与术杖效用相近，多普及于民间宅邸，用以驱避不洁的生物与魔精。”\n<i>注：符咒的图案仅在部分神秘学家间秘传。</i>"],
        [11600,7,1601107,3,"《金丹通史》","","03",105,"",0,0,"“东方炼金术同始于对永恒的追求，其名为‘金丹’。”"],
        [11600,8,1601108,3,"《金丹通史》","","03",105,"",0,0,"“他们痴迷于求索‘羽化登仙’，亦形成一个不具名的团体。”\n<i>注：“永恒”不止蛊惑了那群煮魔汤的巫婆。</i>"],
        [11600,9,1601109,3,"《金丹通史》","","03",110,"5#6#7#8",0,0,"“通晓炼丹的神秘学家往往受雇于宫廷，另有一些则行脚于民间。”\n<i>注：其中一部分身兼厨师、医师数职。</i>"],
        [11600,10,1601110,4,"《幽魂杂谈》","","04",110,"",10003,0,"“他们通常不认为是邪祟。民间多有敬仰魂灵，并加以供奉。”"],
        [11600,11,1601111,4,"《幽魂杂谈》","","04",110,"",10003,0,"“古东方多有传言，生者的魂魄会脱离躯体，以便赴约行事。”"],
        [11600,12,1601112,4,"《幽魂杂谈》","","04",115,"",10003,400603,"“因此常有身死却不自知的魂魄，游离于世间，叨扰生者的门扉。”"],
        [11600,13,1601113,5,"《饮食录》","","05",115,"",10003,0,"“木筷的技艺堪比绳上独轮车，但他们竟能轻易驾驭。”"],
        [11600,14,1601114,5,"《饮食录》","","05",115,"",10003,0,"“东方物产丰厚，美食琳琅。”\n<i>注：东行指南在此建议自行携带餐具。</i>"],
        [11600,15,1601115,5,"《饮食录》","","05",120,"",161011,0,"“酒坊别有风味，其酿造技艺另有诀窍，回味无穷。”\n<i>注：别小看那些米粒。</i>"],
        [11600,16,1601116,6,"《魔精地理志》","","06",120,"",161012,0,"“由栖息环境所影响，魔精在东方亦另有一番样貌。”\n<i>生物进化论仍然不过时。</i>"],
        [11600,17,1601117,6,"《魔精地理志》","","06",120,"",161003,0,"“有名为饕餮者，其形状如羊身人面，其目在腋下，虎齿人爪，其音如婴儿。”\n<i>这是撒旦在世的有力佐证！</i>"],
        [11600,18,1601118,6,"《魔精地理志》","","06",120,"",161004,0,"“有名为孰湖者，其状马身而鸟翼，人面蛇尾，是好举人。”\n<i>大陆板块漂移前，美杜莎或曾在各地繁衍生息。</i>"],
        [11600,19,1601119,6,"《魔精地理志》","","06",120,"",161007,0,"“有名为穷奇者，状如牛，蝟毛，音如嗥狗。”\n<i>狼与牛的生殖隔离有待商榷，这是生物学领域的新突破！</i>"],
        [11600,20,1601120,6,"《魔精地理志》","","06",121,"",161010,400604,"“有名为驳者，状如白马，锯牙，食虎豹。有素兽焉。”\n<i>我们猜测这是东方谚语“白马非马”的现实依据。</i>"],
        [11600,21,1601121,7,"《度朔座谈》","","07",121,"",161008,0,"“他们眼中，种族间的裂隙如同一场乌有的闹剧。”\n<i>先生们、女士们！令人讶异的共融社会。</i>"],
        [11600,22,1601122,7,"《度朔座谈》","","07",130,"",161013,0,"“奥林匹斯诸神与十三位摄提神，神在此以另一个名字现身。”"],
        [11600,23,1601123,7,"《度朔座谈》","","07",140,"",161014,0,"“传言临近新禧的时候，摄提神将轮换值年，庇佑生灵。”\n<i>祂们的闹钟想必毫厘不差。</i>"],
        [11600,24,1601124,7,"《度朔座谈》","","07",150,"",10004,0,"“值年之中，没有第十三位摄提神的席位。”\n<i>一次秘密带薪休假。</i>"],
        [11600,25,1601125,7,"《度朔座谈》","","07",150,"",10004,0,"“天上会洒落，地上会生长，这便是压胜钱的来源。”\n<i>他们的神明显然不是一位经济学家。</i>"],
        [11600,26,1601126,7,"《度朔座谈》","","07",150,"",10004,0,"“人们会捡拾压胜钱，以此获取祝福与庇佑。”\n<i>先生们，比祈祷见效的新妙方！</i>"],
        [11600,27,1601127,7,"《度朔座谈》","","07",150,"",10004,0,"“度朔之日，他们将彻夜敲响太平鼓，以驱散所有的不吉与邪物。”\n<i>他们肯定天生有一副强健的耳膜。</i>"],
        [11600,28,1601128,7,"《度朔座谈》","","07",150,"",10004,0,"“他们用春盘与酒，慰问游荡的妖、魔、鬼、怪……以防它们的骚扰。”\n<i>综上所述，东方的魔精对破烂的兴趣甚微。</i>"],
        [11600,29,1601129,7,"《度朔座谈》","","07",150,"",10004,0,"“爆竹的声音常响彻街巷，比独眼巨人的呼噜都响！”\n<i>东行指南建议常备耳塞，以防意料之外的响音。</i>"],
        [11600,30,1601130,7,"《度朔座谈》","","07",150,"",10004,0,"“妖与仙同样在庙宇受到供奉，仅有诚心者才能获得灵签。”\n<i>朋友们，至少它不吞六便士。</i>"],
        [13000,1,3001101,1,"奔向燃烧的木头","","01",75,"1#2#3#4",0,0,"这大树曾无比繁茂，树枝分叉四散留叶，蚂蚁们满怀欣喜地在它之下安了家。"],
        [13000,2,3001102,1,"奔向燃烧的木头","","01",75,"",0,0,"不知何人丢下的火种，落在了覆于腐泥之上的那厚厚枯叶中，紧跟着便是那漫漫浓烟和火啃叶子的咔嚓声。"],
        [13000,3,3001103,1,"奔向燃烧的木头","","01",75,"9",0,0,"火焰呀，火焰下是甜美的树汁！快去，快去，快去！"],
        [13000,4,3001104,2,"每只蚂蚁","","02",90,"",0,0,"第一只蚂蚁看到了，它想逃走但是却被火焰烫伤了脚。火顺着它的足节爬了上来，一下便吞了它。"],
        [13000,5,3001105,2,"每只蚂蚁","","02",90,"",0,0,"第二只蚂蚁看到了，它慌忙地逃开了大树。树汁呀，腐肉呀，还有族群呀，什么都不要了！"],
        [13000,6,3001106,2,"每只蚂蚁","","02",90,"5#6#7#8",0,0,"第三只蚂蚁看到了，好大的火，好美丽的火，照在身上是金色的，只要冲进去，那一定就永远是金色的了！"],
        [13000,7,3001107,3,"逃走至瓢泼大雨","","03",105,"",0,0,"大雨从天而降，似乎救了这参天大树。也救了这些四处乱窜的蚂蚁。"],
        [13000,8,3001108,3,"逃走至瓢泼大雨","","03",105,"",0,0,"雨落在了第一只蚂蚁的身上，焦黑的它蜷缩在那儿，被水的冲击打飞，却又因为水表面的张力被拉回。"],
        [13000,9,3001109,3,"逃走至瓢泼大雨","","03",105,"",0,0,"第二只蚂蚁看到雨落，兴奋地冲进了水中以为得了救……"],
        [13000,10,3001110,3,"逃走至瓢泼大雨","","03",105,"",0,0,"雨水浇灭了金色的火，第三只蚂蚁气急败坏，它咒骂着一切，全然忘了刚刚被炙烤的疼痛。"],
        [13000,11,3001111,4,"兜转于泥沟草间","","04",121,"",0,0,"大火烧去的只是外面，但是水真的会淹没地下。蚂蚁们都怕水。"],
        [13000,12,3001112,4,"兜转于泥沟草间","","04",121,"",0,0,"泥泞的土坑淤积着污水，蚂蚁们躲在草下，它们开始怀念起大火燃起前的下午。"],
        [13000,13,3001113,4,"兜转于泥沟草间","","04",121,"",0,0,"四周鸦雀无声，蚂蚁们都缩在蚁穴里。这时一只焦黑的蚂蚁提出，要是当时火再大一些就好了！一呼百应。"],
        [13000,14,3001114,4,"兜转于泥沟草间","","04",121,"",0,0,"蚂蚁们顶着大雨从洞中钻出，从草间钻出，它们爬上了大树，爬进了枯叶中。它们要找火。"],
        [13000,15,3001115,4,"兜转于泥沟草间","","04",121,"",0,0,"蚂蚁四处寻找，终于在缝隙中寻到了——那一丝微弱的火星。火星也在等，等这大雨过去，一切就又会熊熊燃烧。"],
        [13000,16,3001116,5,"灰色的香槟","","05",150,"",0,0,"几只蚂蚁聚在火星边，相互推诿着。它就快熄灭，没有东西给它烧。有的，有的，这里有很多不曾被雨打中的它们。"],
        [13000,17,3001117,5,"灰色的香槟","","05",150,"",0,0,"它们什么都不知道，它们没有思考，只会搬运食物，它们再合适不过了。只要大火重新燃起，它们也会有受恩泽！"],
        [13000,18,3001118,5,"灰色的香槟","","05",150,"",0,0,"第一只，第二只，第三只。火光冲天，大火顶着大雨呼啸向上。蚂蚁们庆贺，欢腾，仿佛赢了一场伟大的战争。"],
        [13000,19,3001119,5,"灰色的香槟","","05",150,"",0,0,"直到一只在水中泡了很久的蚂蚁回过神，我们不是要灭火吗？"],
        [13000,20,3001120,5,"灰色的香槟","","05",150,"",0,0,"再看看，那些已经化成了灰烬漂在坑中泥水的它们。"]
    ]
]
