[
    "college_story_dialog",
    [
        [4062001,1,"headicon_middle_4","left","安琪蕾特","波泽蒂，真难得，我听好几位学徒说，你竟然主动和他们搭话了。",1,0,""],
        [4062001,2,"headicon_middle_3","right","波泽蒂","这是有原因的……在会议上，导师们提到，要寻找被忽视的线索……",1,0,""],
        [4062001,3,"headicon_middle_3","right","波泽蒂","我想来想去，总感觉应该要问问其他人的意见。那个，我是不是……打扰到了谁？",1,0,""],
        [4062001,4,"headicon_middle_12","left","安琪蕾特","你总是爱担心这件事。放心吧，我只是好奇你的进展如何。",1,0,""],
        [4062001,5,"headicon_middle_24","right","波泽蒂","进展吗？目前为止，收集到最多的是对导师的匿名建议。",1,0,""],
        [4062001,6,"headicon_middle_13","left","安琪蕾特","哈哈哈，总感觉能猜到其中的内容。你确定是“建议”而不是“抱怨”吗？",1,0,""],
        [4062001,7,"","","","波泽蒂低头翻开笔记本。上面确实记录着各种各样的抱怨内容——",1,0,""],
        [4062001,8,"","","","毫无关联的前置课程，总是找不到人的导师，直至课程结束才被发现的上课地点……",1,0,""],
        [4062001,9,"headicon_middle_4","left","安琪蕾特","这不就是我们学会每天都在发生的事嘛。",1,0,""],
        [4062001,10,"headicon_middle_3","right","波泽蒂","……倒也是。我已经连续好几天没找到老骨头先生了。",1,0,""],
        [4062001,11,"headicon_middle_3","right","波泽蒂","不过还有比我更惨的人。比如，有一个人的导师总在午夜上课，只为了确认月亮对神秘术稳定性的影响。",1,0,""],
        [4062001,12,"headicon_middle_12","left","安琪蕾特","我知道是谁，这位可怜人肯定是戒律学威廉老师的学徒。",1,0,""],
        [4062001,13,"headicon_middle_4","left","安琪蕾特","威廉老师喜欢和月亮相关的一切，对月见草的药用价值也能讲得头头是道。我有时候真好奇，他怎么没长着狼耳朵！",1,0,""],
        [4062001,14,"headicon_middle_4","left","安琪蕾特","他最近似乎正在研究月相变化和隐匿学有什么联系，我觉得你们也可以聊聊——",1,0,""],
        [4062001,15,"headicon_middle_17","right","波泽蒂","啊我、我吗？我……最近和不熟的人说了太多话……能不能晚些再……",1,0,""],
        [4062001,16,"headicon_middle_4","left","安琪蕾特","没关系，我们可以一起，我正好把经过苦蜜井导师调配的月见草精油带给他。",1,0,""],
        [4062001,17,"headicon_middle_3","right","波泽蒂","不过……也不是所有的建议都是抱怨。",1,0,""],
        [4062001,18,"headicon_middle_13","left","安琪蕾特","哦？难道白岸学会还有什么我不知道的事儿？",1,0,""],
        [4062001,19,"headicon_middle_3","right","波泽蒂","……我想想，我记下了几个大家都提到的反常现象。",1,0,""],
        [4062001,20,"headicon_middle_3","right","波泽蒂","“最近几个月，大多数导师都变严肃了。应塔里有开不完的会，在书库里翻阅资料的人也多了很多。”",1,0,""],
        [4062001,21,"headicon_middle_4","left","安琪蕾特","嗯……这种程度的话也还好啦，毕竟在我们学会，每天都得发生几件让导师们皱眉的事情！",1,0,""],
        [4062001,22,"","","","窗外的风吹过草坪，远处传来仙境渡渡的叫声，学会和往常一样安静。",1,0,""],
        [4062001,23,"","","","波泽蒂轻轻合上笔记本，而后又重新翻开。",1,0,""],
        [4062001,24,"headicon_middle_3","right","波泽蒂","那我先接着整理资料了，你去找威廉老师的时候可以叫我一下……谢谢你，安琪！",1,0,""],
        [4062002,1,"headicon_middle_3","left","波泽蒂","这是最、最后一箱了！好重……",1,1,"0.5"],
        [4062002,2,"headicon_middle_3","left","波泽蒂","呼！珐琅眼，你该来数数你的“朋友”们有没有少了，顺便复习一下数学？",1,1,""],
        [4062002,3,"","","","高个子少女回头，却没有望见本该跟在身后、会踢着皮鞋绑带走路的同窗。",1,1,""],
        [4062002,4,"headicon_middle_17","left","波泽蒂","糟糕……！她好奇心那么强，走丢的话，该去哪儿……",1,1,""],
        [4062002,5,"","","","波泽蒂退回走廊上，有些踟蹰，但很快，她就听到一个开朗的声音。",1,1,""],
        [4062002,6,"headicon_middle_4","right","安琪蕾特","你做得对！迷路的话，就应该敲打墙壁，直到附近的学徒出来帮忙。",1,1,""],
        [4062002,7,"headicon_middle_4","right","安琪蕾特","和学会其他地方一样，随意打开陌生的门可是很危险的——",1,1,""],
        [4062002,8,"","","","两位绿眼睛的少女和波泽蒂对上了视线，正在说话的那位，咧开了一个笑容。",1,1,""],
        [4062002,9,"headicon_middle_4","right","安琪蕾特","看来我们找到你的新房间了，珐琅眼。",1,1,""],
        [4062002,10,"headicon_middle_4","right","安琪蕾特","我必须立刻看看，你究竟攒了多少“朋友”下来，真的有多到需要给你找一间新宿舍吗？",1,1,""],
        [4062002,11,"","","","她风风火火地冲了进去，几乎是立刻，房间里传出一声惊呼。",1,1,""],
        [4062002,12,"headicon_middle_15","right","安琪蕾特","哇……你真的找到了不少好玩的。你愿意介绍一下吗，珐琅眼？",1,1,""],
        [4062002,13,"rouge2_alchemy_2_10","","","",2,1,""],
        [4062002,14,"headicon_middle_4","right","安琪蕾特","我猜……这是蓍草的根茎？你把它晒干了？",1,1,""],
        [4062002,15,"headicon_middle_9","right","珐琅眼","丨ㄚ……？听不懂这个词。\n我叫它“温暖”，在冷的时候，我把自己埋在里面就不冷了，是很厉害的朋友。",1,1,""],
        [4062002,16,"headicon_middle_20","right","安琪蕾特","是可以当作被子用的干枯植物吗？我想想……",1,1,""],
        [4062002,17,"rouge2_alchemy_2_10","","","",3,1,""],
        [4062002,18,"rouge2_alchemy_2_3","","","",2,1,""],
        [4062002,19,"headicon_middle_15","right","安琪蕾特","它的花纹，有点像萨尔玛提克蜗？",1,1,""],
        [4062002,20,"headicon_middle_9","right","珐琅眼","我叫它“慢”，它很安静，而且不乱跑，很符合大人们的要求。",1,1,""],
        [4062002,21,"rouge2_alchemy_2_3","","","",3,1,""],
        [4062002,22,"rouge2_alchemy_1_3","","","",2,1,""],
        [4062002,23,"headicon_middle_17","left","波泽蒂","……！你还有这样的“朋友”，怪不得箱子这么重……",1,1,""],
        [4062002,24,"headicon_middle_9","right","珐琅眼","它有点固执，装在箱子里，就会让箱子不愿意离开原地。",1,1,""],
        [4062002,25,"rouge2_alchemy_1_3","","","",3,1,""],
        [4062002,26,"headicon_middle_9","right","珐琅眼","其实这些不是新朋友。我很小的时候，就认识它们了。",1,1,""],
        [4062002,27,"headicon_middle_9","right","珐琅眼","但那时，朋友们总被扔掉……现在没有人会扔它们了，就突然攒下了好多……",1,1,""],
        [4062002,28,"headicon_middle_4","right","安琪蕾特","原来如此，别担心，我会给你介绍新朋友的。",1,1,""],
        [4062002,29,"headicon_middle_12","right","安琪蕾特","我想到了，你应该先知道一点……我们学会真正值得体验的东西！",1,1,""],
        [4062003,1,"headicon_middle_3","left","波泽蒂","爱丝琳老师，安琪蕾特告诉我，您特别熟悉一些和仙境有关的老故事。",1,0,""],
        [4062003,2,"headicon_middle_3","left","波泽蒂","《白崖冒险家》《红龙与最后的骑士》，还有《康沃尔的尖耳朵医生》……",1,0,""],
        [4062003,3,"headicon_middle_3","left","波泽蒂","我在整理这些故事的时候，发现了一些……奇怪的巧合，所以想来问您。",1,0,""],
        [4062003,4,"headicon_middle_10","right","爱丝琳","没问题。你发现了什么？",1,0,""],
        [4062003,5,"headicon_middle_3","left","波泽蒂","您瞧……这些故事的发生地明明完全不一样。",1,0,""],
        [4062003,6,"headicon_middle_3","left","波泽蒂","但故事里的主人公……却都戴着同一顶尖帽子。",1,0,""],
        [4062003,7,"headicon_middle_3","left","波泽蒂","屠龙骑士是这样，医生也是，还有……送迷路孩子回家的仙灵也是。",1,0,""],
        [4062003,8,"headicon_middle_3","left","波泽蒂","……我想问问，您是否知道那顶帽子代表了什么？",1,0,""],
        [4062003,9,"headicon_middle_1","right","爱丝琳","一个很有品味的人。",1,0,""],
        [4062003,10,"headicon_middle_17","left","波泽蒂","……我是在认真问您！",1,0,""],
        [4062003,11,"","","","看着女孩认真等待答案的模样，爱丝琳的尖耳朵微微抖了抖。",1,0,""],
        [4062003,12,"headicon_middle_10","right","爱丝琳","事实上，传说本来就是人们共同编织出来的梦。",1,0,""],
        [4062003,13,"headicon_middle_1","right","爱丝琳","有些象征会在不同故事中反复出现，是因为人们总会想象相似的东西。",1,0,""],
        [4062003,14,"headicon_middle_1","right","爱丝琳","至于那顶帽子……或许只是因为，在许多人眼里，神秘的人就应该戴一顶尖帽子吧。",1,0,""],
        [4062003,15,"headicon_middle_3","left","波泽蒂","共同的想象……吗？",1,0,""],
        [4062003,16,"headicon_middle_3","left","波泽蒂","所以，那顶帽子……并不一定代表某个特定的人？",1,0,""],
        [4062003,17,"headicon_middle_1","right","爱丝琳","我想，大概是这样的。",1,0,""],
        [4062003,18,"headicon_middle_3","left","波泽蒂","那您房间里的那些收藏，那个柳条编织的人偶，那支笛子，还有那只锡酒壶……",1,0,""],
        [4062003,19,"headicon_middle_3","left","波泽蒂","也是您从旅行中留下的，关于那些想象的纪念吗？",1,0,""],
        [4062003,20,"headicon_middle_1","right","爱丝琳","你完全可以这么理解，波泽蒂。",1,0,""],
        [4062003,21,"headicon_middle_3","left","波泽蒂","那您桌子上的这顶帽子也是吗？",1,0,""],
        [4062003,22,"headicon_middle_10","right","爱丝琳","只是因为好看才留着的。",1,0,""],
        [4062003,23,"headicon_middle_3","left","波泽蒂","……不对，我好像在哪儿见过它。",1,0,""],
        [4062003,24,"headicon_middle_10","right","爱丝琳","你还有新的发现吗，波泽蒂？",1,0,""],
        [4062003,25,"","","","女孩从老师略显狡黠的神情中察觉到了一丝不对劲。",1,0,""],
        [4062003,26,"","","","她低头翻开手中的故事集，目光停留在某页泛黄的插画上。",1,0,""],
        [4062003,27,"headicon_middle_24","left","波泽蒂","这不是和书上的那顶帽子，一模一样嘛……？",1,0,""],
        [4062004,1,"headicon_middle_12","left","安琪蕾特","快来快来，波泽蒂！我刚刚发现了一件足以改变学院未来的大事！",1,0,""],
        [4062004,2,"headicon_middle_16","left","安琪蕾特","我认为，再生学或许能成为连接所有学科的核心。",1,0,""],
        [4062004,3,"headicon_middle_5","right","阿里安","连接所有学科，这是不是有点太夸张了？",1,0,""],
        [4062004,4,"headicon_middle_21","left","安琪蕾特","没错！比如波泽蒂最喜欢的隐匿学，就和再生学息息相关。",1,0,""],
        [4062004,5,"headicon_middle_21","left","安琪蕾特","再生学是有关物质生命的学科，而隐匿学是关于物质如何脱离感知与认知的学科。",1,0,""],
        [4062004,6,"headicon_middle_21","left","安琪蕾特","要完成隐匿可以有很多种办法，也正因为如此，不同学科之间的合作才显得尤为重要！",1,0,""],
        [4062004,7,"headicon_middle_22","left","安琪蕾特","比如，只要调配一种闻起来和雨后泥土味道相似的药剂，再喷在身上，讨厌潮湿的魔精自然会绕开你。",1,0,""],
        [4062004,8,"headicon_middle_22","left","安琪蕾特","这算不算一种应对型的神秘术？",1,0,""],
        [4062004,9,"headicon_middle_3","right","波泽蒂","呃，我想……这些魔精绕开我，并不意味着它们没发现我？",1,0,""],
        [4062004,10,"headicon_middle_5","right","阿里安","结果相同不意味着原理相同。",1,0,""],
        [4062004,11,"headicon_middle_13","left","安琪蕾特","再比如观察学！只要连续观察一株植物七天七夜，不睡觉，不眨眼……",1,0,""],
        [4062004,12,"headicon_middle_5","right","阿里安","停……如果连续七天七夜不睡觉，你最先观察到的细节，大概只会是自己的幻觉。",1,0,""],
        [4062004,13,"headicon_middle_13","left","安琪蕾特","但是，研究由自然现象引发的异常状态，也可以是观察学的一部分学习内容！",1,0,""],
        [4062004,14,"headicon_middle_4","left","安琪蕾特","还有灵智学！灵智学是研究智慧和思想的学科，有人认为智慧源自另一个维度，有人认为思考本身即能证明个体的存在。",1,0,""],
        [4062004,15,"headicon_middle_4","left","安琪蕾特","如果智慧存在于不同形式的生命之中，那我们就应该试着把各种各样的生命都纳入思考范畴。",1,0,""],
        [4062004,16,"headicon_middle_5","right","阿里安","比如……魔精？",1,0,""],
        [4062004,17,"headicon_middle_14","left","安琪蕾特","没错！你看，这不就又和再生学联系起来了吗？",1,0,""],
        [4062004,18,"headicon_middle_5","right","阿里安","……我只是随口一说。",1,0,""],
        [4062004,19,"headicon_middle_3","right","波泽蒂","魔精的智慧吗……",1,0,""],
        [4062004,20,"headicon_middle_3","right","波泽蒂","我好像，稍微理解学会为什么要分这么多学科了。",1,0,""],
        [4062004,21,"headicon_middle_5","right","阿里安","希望你理解的不是她刚才说的那些。",1,0,""],
        [4062005,1,"headicon_middle_3","left","波泽蒂","《赫恩树林的鹿角怪影》……",1,0,""],
        [4062005,2,"headicon_middle_23","right","爱丝琳","赫恩树林？那里的传闻确实很多。",1,0,""],
        [4062005,3,"headicon_middle_3","left","波泽蒂","您果然对各种传说都很了解，不只是仙境相关的，连别的也……",1,0,""],
        [4062005,4,"headicon_middle_1","right","爱丝琳","只是听过一些。",1,0,""],
        [4062005,5,"headicon_middle_3","left","波泽蒂","我刚看到这里——“凡在林间迷失方向者，都会声称……见到了一位头戴鹿角的高大旅人。”",1,0,""],
        [4062005,6,"headicon_middle_3","left","波泽蒂","“他从不多言，只会在浓雾中提起一盏灯，送迷途者走出树林。”",1,0,""],
        [4062005,7,"headicon_middle_3","left","波泽蒂","“等迷途者回过神，那道身影就已经消失了。”",1,0,""],
        [4062005,8,"headicon_middle_1","right","爱丝琳","其实这也是传统仙灵传说的一种。",1,0,""],
        [4062005,9,"headicon_middle_3","left","波泽蒂","传统仙灵传说？",1,0,""],
        [4062005,10,"headicon_middle_1","right","爱丝琳","帮助别人，却不留下名字。这样的故事，在很多地方都出现过。",1,0,""],
        [4062005,11,"headicon_middle_3","left","波泽蒂","可在我看到的资料中，有不少人认为，根本没有什么指引者。",1,0,""],
        [4062005,12,"headicon_middle_23","right","爱丝琳","那他们认为自己看见的是什么？",1,0,""],
        [4062005,13,"headicon_middle_3","left","波泽蒂","可能雾太浓了，他们把树枝的影子看作鹿角，还把手中的蜡烛当成了提灯。",1,0,""],
        [4062005,14,"headicon_middle_1","right","爱丝琳","嗯……这种解释倒是也能说得通。",1,0,""],
        [4062005,15,"headicon_middle_1","right","爱丝琳","不过，波泽蒂，你好像很在意这个故事。",1,0,""],
        [4062005,16,"headicon_middle_3","left","波泽蒂","我曾经也险些在树林中迷路，所以总会想起这个故事。",1,0,""],
        [4062005,17,"","","","爱丝琳沉默片刻，点点烛光在她眼中闪烁。",1,0,""],
        [4062005,18,"headicon_middle_23","right","爱丝琳","你也想获得帮助吗？",1,0,""],
        [4062005,19,"headicon_middle_1","right","爱丝琳","很久以前，我的确在赫恩树林遇到过一个迷路的小男孩。在分别前，我把手上的蜡烛给了他。",1,0,""],
        [4062005,20,"headicon_middle_1","right","爱丝琳","雾散开以后，山脚下刚好亮起了灯，他朝我挥了挥手，就跑回家了。",1,0,""],
        [4062005,21,"headicon_middle_3","left","波泽蒂","所以说，获得帮助的方式，其实就是……",1,0,""],
        [4062005,22,"headicon_middle_10","right","爱丝琳","对，用你的蜡烛联系我。",1,0,""],
        [4062006,1,"headicon_middle_18","left","波泽蒂","……你、你好，欢迎来到书库。我不太确定，你是新来的学徒吗？",1,1,"0.5"],
        [4062006,2,"headicon_middle_3","left","波泽蒂","如果你是来找老骨头先生的，可能暂时得等一等……因为，我也不知道他在哪儿。",1,1,""],
        [4062006,3,"headicon_middle_9","right","珐琅眼","你说的“ㄌㄠ……骨头”，是长胡子老头吗？",1,1,""],
        [4062006,4,"headicon_middle_3","left","波泽蒂","……你在哪里见到他的？！",1,1,""],
        [4062006,5,"headicon_middle_9","right","珐琅眼","他说，不能告诉一个，高个子，金色头发，身上有泥土的……",1,1,""],
        [4062006,6,"headicon_middle_9","right","珐琅眼","ㄅㄛˉ……波……我不记得名字了，但好像……",1,1,""],
        [4062006,7,"headicon_middle_3","left","波泽蒂","……就是我。我叫波泽蒂，所以，是他让你来找我的吗？",1,1,""],
        [4062006,8,"headicon_middle_9","right","珐琅眼","ㄕˋ的！有香气的大人，和他一起，他们说……",1,1,""],
        [4062006,9,"headicon_middle_9","right","珐琅眼","我力气很大，这里需要ㄨㄛˇ帮忙。",1,1,""],
        [4062006,10,"headicon_middle_3","left","波泽蒂","……不好意思，请问“有香气的大人”是谁？",1,1,""],
        [4062006,11,"","","","对面穿着蓝黑色衣服的少女眨了眨眼，似乎完全不理解这个问题。",1,1,""],
        [4062006,12,"","","","波泽蒂等待了一会儿，而眼前的少女似乎比她更擅长沉默，她不得不继续开口。",1,1,""],
        [4062006,13,"headicon_middle_3","left","波泽蒂","呃……那么，“帮忙”是要你来做什么呢？老骨头先生和……那位有香气的大人，有告诉你吗？",1,1,""],
        [4062006,14,"headicon_middle_9","right","珐琅眼","要做你在做的事。你站着，那我也站着。",1,1,""],
        [4062006,15,"headicon_middle_3","left","波泽蒂","不不不……抱歉，你在和我开玩笑吗？",1,1,""],
        [4062006,16,"","","","场面又一次陷入了沉默。波泽蒂从没想过，在一段和陌生人的对话里，她可以表现得……比对方更擅长说话。",1,1,""],
        [4062006,17,"headicon_middle_3","left","波泽蒂","……好吧，你听我说——",1,1,""],
        [4062006,18,"headicon_middle_3","left","波泽蒂","老骨头先生，只是不让你告诉我他在哪儿，但是没有不让你带我去找他吧？",1,1,""],
        [4062006,19,"","","","在这个古怪的少女面前，波泽蒂久违地在一场对话里开始主导节奏。",1,1,""],
        [4062006,20,"","","","甚至是开始……诱哄？",1,1,""],
        [4062006,21,"","","","而这位少女，如波泽蒂所愿地点了点头。",1,1,""],
        [4062006,22,"headicon_middle_3","left","波泽蒂","那太好了，他们就是这个意思，我们……我们一起去找他们吧！",1,1,""],
        [4062006,23,"headicon_middle_9","right","珐琅眼","好。有香气的大人还说，她很久没见到你了……",1,1,""],
        [4062006,24,"","","","高个子少女脚下一个踉跄。",1,1,""],
        [4062006,25,"headicon_middle_17","left","波泽蒂","真、真的假的……你到底在说谁啊……等等，其实是我骗了你，先别走，呜……",1,1,""],
        [4062007,1,"headicon_middle_3","left","波泽蒂","在开始调查前，我一直觉得，关于仙境的故事都差不多呢。",1,0,""],
        [4062007,2,"headicon_middle_1","right","爱丝琳","大家的想象力很丰富，总会把自己见过的、听过的东西，都加进故事里。",1,0,""],
        [4062007,3,"headicon_middle_3","left","波泽蒂","我在渡渡鸟协会工作的时候，也听伊莉讲过一个关于仙境的故事。",1,0,""],
        [4062007,4,"headicon_middle_15","right","安琪蕾特","伊莉？那个总是带着奇怪照相机的女孩？还是说那是阿尔菲？",1,0,""],
        [4062007,5,"headicon_middle_4","right","安琪蕾特","真抱歉，我有点分不清她们——",1,0,""],
        [4062007,6,"headicon_middle_3","left","波泽蒂","是伊莉，你没有记错。她说，渡渡鸟蛋的蛋壳上有特殊的纹路和颜色。",1,0,""],
        [4062007,7,"headicon_middle_3","left","波泽蒂","据说，那些纹路和颜色，和抵达仙境的方式有关。",1,0,""],
        [4062007,8,"headicon_middle_1","right","爱丝琳","你们当时有没有验证过？",1,0,""],
        [4062007,9,"headicon_middle_3","left","波泽蒂","当然没有，在仙境外只能找到渡渡鸟蛋壳化石……但我们小队还没遇上过。",1,0,""],
        [4062007,10,"headicon_middle_4","right","安琪蕾特","在学会生活久了，确实很容易忘记草坪上的仙境渡渡其实很不寻常。",1,0,""],
        [4062007,11,"headicon_middle_4","right","安琪蕾特","但你已经回到学会了，事不宜迟，让我们现在就来看看这些纹路……它们究竟象征着什么！",1,0,""],
        [4062007,12,"","","","少女学徒的眼睛亮了起来。",1,0,""],
        [4062007,13,"headicon_middle_4","right","安琪蕾特","我记得附近的窝里还有一颗蛋。我们走！",1,0,""],
        [4062007,14,"4_0_item_33","","","",2,0,""],
        [4062007,15,"headicon_middle_3","left","波泽蒂","……这条裂缝弯弯曲曲的，我觉得像海岸线。",1,0,""],
        [4062007,16,"headicon_middle_5","right","阿里安","不，这绝对是星图。把它倒过来看，和夏天的猎户星座几乎没有区别。",1,0,""],
        [4062007,17,"headicon_middle_16","right","安琪蕾特","才不是呢！这儿明明有一只兔子！它正在河边喝水！",1,0,""],
        [4062007,18,"headicon_middle_3","left","波泽蒂","那这条缝呢？",1,0,""],
        [4062007,19,"headicon_middle_12","right","安琪蕾特","是兔子踩出来的小路呀。",1,0,""],
        [4062007,20,"headicon_middle_5","right","阿里安","……可你刚才说那是河。",1,0,""],
        [4062007,21,"headicon_middle_16","right","安琪蕾特","河边为什么不能有路？",1,0,""],
        [4062007,22,"4_0_item_33","","","",3,0,""],
        [4062007,23,"","","","讨论持续了整整一个下午，关于渡渡鸟蛋纹路的意义，又多出了十几种全新的解释。",1,0,""],
        [4062007,24,"","","","少女学徒扬起脑袋，迟迟才注意到不知在一旁听了多久的导师。",1,0,""],
        [4062007,25,"headicon_middle_2","right","西缪斯","原来你们愿意用整个下午的时间研究鸟类魔精生态。我还以为再等一会儿，这里就会诞生一门新学科。",1,0,""],
        [4062007,26,"headicon_middle_2","right","西缪斯","不过从研究者的角度来说，这些分析各有可取之处。",1,0,""],
        [4062007,27,"headicon_middle_15","right","安琪蕾特","真的吗？西缪斯——你很久没这样肯定过我的神秘术理论了！",1,0,""],
        [4062007,28,"headicon_middle_11","right","西缪斯","实际上……",1,0,""],
        [4062007,29,"","","","他立即注意到了爱丝琳和另外两位学徒投来的视线，也明白他们正在暗示自己不要打击少女的积极性。",1,0,""],
        [4062007,30,"","","","但他一向喜欢更具挑战性的选项，即使这往往意味着自找麻烦。",1,0,""],
        [4062007,31,"headicon_middle_2","right","西缪斯","至少比我听过的大多数梦话更有逻辑。",1,0,""],
        [4062008,1,"headicon_middle_3","left","波泽蒂","按照规定，珐琅眼，你应该先了解一下宿舍守则……",1,1,"0.5"],
        [4062008,2,"","","","但应当聆听守则的那位同窗，注意力已经明显去到了别处。",1,1,""],
        [4062008,3,"headicon_middle_9","right","珐琅眼","什么是……真正值得体验的东西？",1,1,""],
        [4062008,4,"headicon_middle_19","right","安琪蕾特","比如最近最受欢迎的神秘学游戏——寻找午夜从蜡池爬出来的女人！",1,1,""],
        [4062008,5,"headicon_middle_5","right","阿里安","……严格来讲，这个游戏已经持续四十多年了。",1,1,""],
        [4062008,6,"","","","黑发少年不知何时出现在了这里，他将一片仙境渡渡的羽毛从头上取了下来，递给珐琅眼。",1,1,""],
        [4062008,7,"headicon_middle_5","right","阿里安","我猜这个也会是你的“朋友”，珐琅眼。",1,1,""],
        [4062008,8,"headicon_middle_9","right","珐琅眼","当然！这种羽毛是新朋友，我会好好对待它的。",1,1,""],
        [4062008,9,"headicon_middle_5","right","阿里安","那该说回游戏了，这个游戏我也曾“有幸参与”过。",1,1,""],
        [4062008,10,"headicon_middle_5","right","阿里安","我亲爱的老师认为，寻找只在怪谈中存在的景象，是锻炼空间认知能力的好方法。",1,1,""],
        [4062008,11,"headicon_middle_5","right","阿里安","于是我在一个伸手不见五指的黑夜，绕着蜡池走了整整三十圈。",1,1,""],
        [4062008,12,"headicon_middle_15","right","安琪蕾特","西缪斯只让你走三十圈吗？他最近是不是心情很好？",1,1,""],
        [4062008,13,"headicon_middle_5","right","阿里安","他说完这个方法就关注其他事情去了。",1,1,""],
        [4062008,14,"headicon_middle_4","right","安琪蕾特","可你现在不还好好的？没被传说中的蜡池女人暴打一顿，或者直接推下去。",1,1,""],
        [4062008,15,"headicon_middle_5","right","阿里安","……呃，那倒也是。",1,1,""],
        [4062008,16,"headicon_middle_4","right","安琪蕾特","除了神秘的蜡池传闻，最近还很流行用仙境渡渡的蛋来占卜！",1,1,""],
        [4062008,17,"headicon_middle_4","right","安琪蕾特","据说特别灵验！上周甚至有人连续猜中了好几天的晚餐菜单。",1,1,""],
        [4062008,18,"headicon_middle_5","right","阿里安","那不是因为这菜单几年来都没怎么变过吗？",1,1,""],
        [4062008,19,"headicon_middle_4","right","安琪蕾特","所以说，这正是神秘学的魅力所在！",1,1,""],
        [4062008,20,"headicon_middle_16","right","安琪蕾特","还有仙境深处的花房！苦蜜井导师曾告诉我，那里的香气可以唤醒最珍贵的童年记忆。",1,1,""],
        [4062008,21,"headicon_middle_5","right","阿里安","……真的？我可是连续三天都梦到和耗子抢掉落的煤渣。",1,1,""],
        [4062008,22,"headicon_middle_3","left","波泽蒂","我上次梦到自己变成纯血泥滩人鱼，双腿永久变成鱼尾，只好把袜子都送给了珐琅眼……",1,1,""],
        [4062008,23,"headicon_middle_9","right","珐琅眼","……袜子？",1,1,""],
        [4062008,24,"","","","少女低下头，看了看自己的脚，又认真地数了数。",1,1,""],
        [4062008,25,"headicon_middle_9","right","珐琅眼","一只、两只，可是我也只有两只脚，没有多余的脚穿你的袜子。",1,1,""],
        [4062008,26,"headicon_middle_9","right","珐琅眼","唔，你可以送给那个……蜡池女人，我们一起，今晚就去找她！",1,1,""]
    ]
]
