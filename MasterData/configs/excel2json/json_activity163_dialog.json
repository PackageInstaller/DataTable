    [
        [101,1,2,"",0,"","治安官办公室内","",""],
        [101,2,3,"阿尔古斯",2,"309711","听着，我觉得有什么误会咱们都可以通过协商解决。","",""],
        [101,3,4,"阿尔古斯",2,"309711","虽然我的确是雇佣兵，也是神秘学家，但我们并不像电视里那样总是……倚仗暴力。","",""],
        [101,4,5,"治安官",1,"628011","那你在酒馆的行动又怎么解释？","",""],
        [101,5,6,"治安官",1,"628011","你和亚当当着众人的面，起了不小的冲突。","",""],
        [101,6,7,"阿尔古斯",2,"309712","首先并不是我先招惹的他。","",""],
        [101,7,0,"",0,"","给他瞧瞧亚当先出手的线索","1#8#102",""],
        [102,1,2,"阿尔古斯",2,"309712","在你来之前，是亚当先用枪对着我。","",""],
        [102,2,3,"治安官",1,"628010","但在我到达现场时，你仍然卡着亚当先生的脖子。即使是一个女人，长时间维持这样的动作也能导致对方窒息甚至死亡。","",""],
        [102,3,4,"阿尔古斯",2,"309714","我控制了力度。在你来之前他都还能说话呢，先生。","",""],
        [102,4,5,"治安官",1,"628010","难道控制了力度就不算是暴力了吗？难道对你们而言，所谓的暴力就是要把人掐死，才勉强够得上暴力的门槛？","",""],
        [102,5,6,"阿尔古斯",2,"309714","或许你并不了解之前到底发生了什么，在你看到我“制服亚当先生”之前，他先用枪与我对峙。这完全属于正当防卫，在场的其他居民都是证人。","",""],
        [102,6,7,"治安官",1,"628011","证人？哦，没错！的确有证人。","",""],
        [102,7,8,"治安官",1,"628012","那位酒喝了一半就跑来举报你的戴蒙德先生。你应该还记得他吧？","",""],
        [102,8,9,"阿尔古斯",2,"309701","记得。所以他说了什么？","",""],
        [102,9,10,"治安官",1,"628011","据戴蒙德先生所说，当你来到了酒馆后，点了一杯没人听过的——黑杰克？但愿我没记错，因为实在是没人喝过那酒。","",""],
        [102,10,11,"治安官",1,"628012","因为那杯酒，亚当对你的身份有了一点儿怀疑。","",""],
        [102,11,12,"治安官",1,"628011","结果，也没人招惹你，你突然就把弄着你的枪，逼着亚当告诉你这个雇佣兵跟墙有关的消息。","3#3#103",""],
        [102,12,13,"治安官",1,"628010","说真的，希望你知道，我们这里不欢迎雇佣兵，也不欢迎任何人来打听那面墙。","7#1",""],
        [102,13,0,"",0,"","寻找与已有线索冲突的对话，并进行反驳","",""],
        [103,1,2,"阿尔古斯",2,"309701","先生，鉴于你毕竟还是一位治安官，所以我在此提醒你，希望你下次找的证人，是真的跟事件没有一点关系的。","",""],
        [103,2,3,"治安官",1,"628011","你和亚当的争执，难道还关戴蒙德的事？","",""],
        [103,3,4,"阿尔古斯",2,"309714","我刚坐进酒馆点了酒的时候，戴蒙德先生就已经对我出言不逊了。","",""],
        [103,4,5,"阿尔古斯",2,"309714","如果你不介意，可以现在立刻返回酒馆，找喝酒的其他人再确认确认事情究竟是什么样。","",""],
        [103,5,6,"阿尔古斯",2,"309714","我想你应该知道，不能盲目相信一面之词。","",""],
        [103,6,7,"治安官",1,"628012","是吗？","",""],
        [103,7,8,"治安官",1,"628010","但我了解到的事实是，你先是对亚当进行了口头侮辱和武力威胁，然后打听了和红墙有关的事情，是因为表现可疑，才招致了民众的怀疑。","",""],
        [103,8,9,"阿尔古斯",2,"309711","“红墙”？","","v2a1_aergusi_chat_emo4"],
        [103,9,10,"阿尔古斯",2,"309711","我甚至都不知道那是什么。","",""],
        [103,10,11,"治安官",1,"628011","……简而言之，亚当和其他人也都只是自卫。","",""],
        [103,11,12,"治安官",1,"628012","这与你的说辞相当冲突。在这种情况下，你说我该相信谁？","",""],
        [103,12,13,"阿尔古斯",2,"309717","“红墙”——还有你们这些人一直在说的那面墙——究竟是什么？","",""],
        [103,13,14,"治安官",1,"628010","现在是我在提问。","",""],
        [103,14,15,"阿尔古斯",2,"309712","鉴于这不是一场审讯……刚才我已经回答过你的问题，你是不是也该还点什么给我？","",""],
        [103,15,16,"治安官",1,"628010","我不认为这是能你来我往的事情。说真的，我完全可以把你直接交给州警，或者那些负责管教神秘学家的机构……","",""],
        [103,16,17,"治安官",1,"628011","我选择先向你了解情况，只是因为我需要给受害者一个交代。","",""],
        [103,17,18,"阿尔古斯",2,"309717","如果你都已经定性了受害者和嫌疑人，那我们还在这里做什么？","",""],
        [103,18,19,"治安官",1,"628010","我需要知道，你为什么要用枪抵着亚当的脑袋，还卡着他的脖子？","",""],
        [103,19,20,"阿尔古斯",2,"309717","我说了，那**是正当防卫！这种无效对话究竟还要重复几遍？","",""],
        [103,20,21,"治安官",1,"628010","但你们不可能都属于正当防卫。","",""],
        [103,21,22,"治安官",1,"628010","在得到其他答案之前，我只能揪住这个问题不放。","7#18",""],
        [103,22,0,"",0,"","提交线索告诉治安官，来这里的真正目的","1#2#104",""],
        [104,1,2,"阿尔古斯",2,"309717","天杀的，那你就认为我在撒谎，好吗！我只是需要知道，有没有一个棕头发、绿眼睛，中等身高的女孩来过这里——","",""],
        [104,2,3,"阿尔古斯",2,"309717","这就是我和那个亚当在动手之前问过的所有话了，我不知道我还能告诉你什么。","",""],
        [104,3,4,"阿尔古斯",2,"309717","为什么和你们说个话都这么困难？","",""],
        [104,4,5,"治安官",1,"628010","回到你的座位上。","",""],
        [104,5,6,"阿尔古斯",2,"309717","这儿到底发生了些什么陈芝麻烂谷子的事儿？那是面边境墙吗？有雇佣兵骑在墙上趁火打劫，还是你们的好镇民死在雇佣兵的手上了？","",""],
        [104,6,7,"阿尔古斯",2,"309717","因为这事，所有到这儿来的雇佣兵就都得遭殃——？！","",""],
        [104,7,8,"治安官",1,"628011","……你先坐下。","",""],
        [104,8,9,"阿尔古斯",2,"309717","听着，我完全不明白你们嘴里念叨的“红墙”究竟是什么——","",""],
        [104,9,10,"阿尔古斯",2,"309717","所以……\n我们还要该死的演这出“你我皆知的全美著名景点”的戏码到什么时候？！","",""],
        [104,10,11,"治安官",1,"628012","如果有人把那地方称作景点，我只会认为他是疯了。","",""],
        [104,11,12,"治安官",1,"628001","难道你真的不知道……？","",""],
        [104,12,13,"阿尔古斯",2,"309712","不然呢？——顺道通知你一声，治安官先生，我正打算挨家挨户敲遍这儿所有的门，直到问出一个答案来为止。","",""],
        [104,13,14,"治安官",1,"628001","……","",""],
        [104,14,15,"阿尔古斯",2,"309714","或者，你告诉我我想知道的，然后我就会麻利地滚蛋。","",""],
        [104,15,16,"阿尔古斯",2,"309716","有个雇佣兵在附近徘徊是很麻烦的，你们和我的同行打过交道，肯定知道我在说什么。","",""],
        [104,16,17,"治安官",1,"628001","好吧，我可以告诉你一些事。","",""],
        [104,17,18,"治安官",1,"628001","红墙是一面林地里的断墙。","8#4",""],
        [104,18,19,"治安官",1,"628011","曾经频繁有年轻女孩在那儿遇害。他们大都有着金色或棕色的头发，失踪侧写相对一致。","8#5",""],
        [104,19,20,"治安官",1,"628011","至于“相对”——因为最后只有极少数女孩的去向被查明了。","2#105",""],
        [104,20,0,"",0,"","尝试从治安官的话语中追问出更多信息","",""],
        [105,1,2,"阿尔古斯",2,"309716","调查结果是什么？","",""],
        [105,2,3,"治安官",1,"628010","她们都被某些四处流窜的退伍兵谋杀，放血、肢解，遗弃在树林中。","6#9",""],
