        [80002,"birthplace","90002#100002#200002",800,"临时营地","此处尚存的秩序让你稍稍安心，至少今晚，你不必再枕着风声入眠。","","","",0,0],
        [70010,"dialogue","",700,"丰茂生机","繁盛的草叶遮挡住前路，不合时宜的生机像是一道明晃晃的暗示，诱人前行。","","","",0,0],
        [200002,"shop","20000",900,"黄金集市","但这里并不售卖黄金。","","","",0,0],
        [60003,"random","",600,"荆棘暗径","两侧荆棘丛生，你或许该停下来思考穿过此处的方法。","","","",0,0],
        [49999,"enemy","1",400,"疯癫信徒","迷失于黄金国传闻中的可怜人——谁能说你又不是呢？","modules/sodache/scene/prefab/m_s08_hddt_qizi_02.prefab","0:109370150:2&1:109370150:2&2:109370150:2&3:109370150:2&4:109370150:2&5:109370150:2","",0,0],
        [10008,"container","",105,"丰饶的脑液罐","神明赐我闪电与丰饶。","modules/sodache/scene/prefab/m_s08_hddt_obj_22.prefab","","",0,0],
        [10009,"container","",105,"诡异的面具","戴上它，获取应有的奖赏。","modules/sodache/scene/prefab/m_s08_hddt_obj_25.prefab","","",0,0],
        [10205,"container","",107,"新生的树木","人形树木托起一枚水质圆球，球中沉着婴孩般的新木，安静得近乎不祥。","","","21000033:2&25000004:2",0,0],
        [10206,"container","",106,"欲望的回音","崇拜是一种索求，这份欲望被颤动的心脏敲击出了虔诚的回音。","","","21000033:2&25000004:2",0,0],
        [10207,"container","",107,"枯萎的石树","死去之后，石头也会繁荣茂盛。","","","21000033:2&25000004:2",0,0],
        [10208,"container","",107,"废弃的石雕","祂垂眸予我等，所以我们伏祂脚边。","","","21000033:2&25000004:2",0,0],
        [10209,"container","",107,"暗红的木碗","盛上水，献上血肉，当视冥神。","","","21000033:2&25000004:2",0,0],
        [10210,"container","",107,"诡异的面具","戴上它，获取应有的奖赏。","","","21000033:2&25000004:2",0,0],
        [10211,"container","",107,"墙根中的黄金","那些人就是为了它来到这里。","","","21000033:2&25000004:2",0,0],
        [10212,"container","",107,"摇摇欲坠的阁楼","树间的风如同重锤般砸向了它。","","","21000033:2&25000004:2",0,0],
        [11205,"container","",107,"新生的树木","人形树木托起一枚水质圆球，球中沉着婴孩般的新木，安静得近乎不祥。","","","21000073:2&25000012:2",0,0],
        [11206,"container","",106,"欲望的回音","崇拜是一种索求，这份欲望被颤动的心脏敲击出了虔诚的回音。","modules/sodache/scene/prefab/m_s08_hddt_obj_21.prefab","","21000073:2&25000012:2",0,0],
        [11207,"container","",107,"枯萎的石树","阁楼横梁间积满灰尘，角落里却留着被反复翻找过的痕迹。","","","21000073:2&25000012:2",0,0],
        [11208,"container","",107,"废弃的石雕","风化石雕立在林地深处，裂隙间卡着些不属于它本身的零碎残留。","","","21000073:2&25000012:2",0,0],
        [11209,"container","",107,"暗红的木碗","残破神庙半陷在藤蔓与阴影之间，石阶尽头像还替谁守着供奉。","","","21000073:2&25000012:2",0,0],
        [11210,"container","",107,"诡异的面具","屋内陈设早已朽坏，只有几处被刻意避开的角落显得过分干净。","","","21000073:2&25000012:2",0,0],
        [11211,"container","",107,"墙根中的黄金","房屋边角堆着潮湿杂物，墙根附近却像刚被谁翻动过一样凌乱。","","","21000073:2&25000012:2",0,0],
        [11212,"container","",107,"摇摇欲坠的阁楼","高脚房子离地而立，木板在风里轻轻作响，像还记得有人曾在上面来回走动。","","","21000073:2&25000012:2",0,0],
        [30006,"escape","",300,"撤离信号","撤离的念头盘旋在脑海里，若到此为止，或许还能全身而退。","modules/sodache/scene/prefab/v3a7_m_s08_soudache_jidi_qiqiu.prefab","","",0,0],
