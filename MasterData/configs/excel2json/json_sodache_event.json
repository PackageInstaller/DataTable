        [40011,"enemy","1",402,"团团草骸","水木所钟之子，雨林自愈的诀窍。","modules/sodache/scene/prefab/m_s08_hddt_qizi_05.prefab","0:109370102:2&1:109370102:2&2:109370102:2&3:109370102:2&4:109370102:2&5:109370102:2","",0,0],
        [40012,"enemy","1",402,"变异提科特勒","雨林里不该有煮沸茶壶的声音。","modules/sodache/scene/prefab/m_s08_hddt_qizi_08.prefab","0:109370103:2&1:109370103:2&2:109370103:2&3:109370103:2&4:109370103:2&5:109370103:2","",0,0],
        [40013,"enemy","1",402,"盗猎人","总之，有人意识到了你和你背包的价值。","modules/sodache/scene/prefab/m_s08_hddt_qizi_03.prefab","0:109370104:2&1:109370104:2&2:109370104:2&3:109370104:2&4:109370104:2&5:109370104:2","",0,0],
        [40014,"enemy","1",402,"“探险家”","对遗物感兴趣的，远不止你们。","modules/sodache/scene/prefab/m_s08_hddt_qizi_02.prefab","0:109370105:2&1:109370105:2&2:109370105:2&3:109370105:2&4:109370105:2&5:109370105:2","",0,0],
        [40015,"enemy","1",402,"狂热学者","旺盛的探索欲和好奇心指引着他走上一条不归路。","modules/sodache/scene/prefab/m_s08_hddt_qizi_02.prefab","0:109370106:2&1:109370106:2&2:109370106:2&3:109370106:2&4:109370106:2&5:109370106:2","",0,0],
        [40016,"enemy","1",402,"拦路人","这条未被冠名的道路合该属于所有过路人，但他们不这么认为。","modules/sodache/scene/prefab/m_s08_hddt_qizi_06.prefab","0:109370107:2&1:109370107:2&2:109370107:2&3:109370107:2&4:109370107:2&5:109370107:2","",0,0],
        [41001,"enemy","2",403,"黄金国遗骸","祂本该与过往一同死去。","modules/sodache/scene/prefab/m_s08_hddt_qizi_09.prefab","0:109371001:1&1:109371001:1&2:109371001:1&3:109371001:1&4:109371001:1&5:109371001:1","",0,0],
        [41002,"enemy","2",403,"黄金国遗骸","祂本该与过往一同死去。","modules/sodache/scene/prefab/m_s08_hddt_qizi_09.prefab","0:109371001:1&1:109371001:1&2:109371001:1&3:109371001:1&4:109371001:1&5:109371001:1","",0,0],
        [70011,"dialogue","",702,"藓壁湿岩","除了攀爬之外，你别无选择。","","","",0,0],
        [70012,"dialogue","",702,"咬人花","未确定这种生物的种类及习性，请勿用手直接触碰！","","","",0,0],
        [70013,"dialogue","",702,"枯木虬结","风声从盘根错节的枯根缝隙间穿过，隐隐夹杂着一丝断裂前的细响。","","","",0,0],
        [70014,"dialogue","",702,"囚木之屋","你很难分清树和屋二者之间的先来后到关系。","","","",0,0],
        [70016,"dialogue","",702,"断阶高台","高台上垂挂着几条藤蔓，这似乎是通过此处的唯一方法。","","","",0,0],
        [70017,"dialogue","",702,"湿滑台阶","石面上残留着不明的粘液和绝望的爪痕，足以说服你小心行事。","","","",0,0],
        [70018,"dialogue","",702,"萤光草","那附着于草丛深处的点点萤光究竟是何物？","","","",0,0],
        [70019,"dialogue","",702,"树洞交易","这是一场所有人都对规则心照不宣的交易。","","","",0,0],
        [70020,"dialogue","",702,"等价交换","很显然，它只接受等价交换。","","","",0,0],
        [70021,"dialogue","",702,"饿兽拦路","惹怒一群饥肠辘辘的野兽并非明智之举。","","","",0,0],
        [70022,"dialogue","",702,"好眠花粉","空气里飘浮着细密的花粉，疲惫交织着困意如潮水般涌来。","","","",0,0],
        [70023,"dialogue","",702,"贪食魔精","等发现时，你已经被这群贪吃鬼们包围了。","","","",0,0],
        [70024,"dialogue","",702,"林隙微光","一团温和的微光跟随着你穿梭于林隙之间，直至你终于肯停下脚步，看向它。","","","",0,0],
        [70025,"dialogue","",702,"双叶赠礼","两片树叶垂落着，等待你做出抉择。","","","",0,0],
        [70026,"dialogue","",702,"倒塌的遗迹","残垣断壁之下，旧物们重见天日。","","","",0,0],
        [70027,"dialogue","",702,"他人营地","营地内痕迹凌乱，你们似乎不是光顾此地的第一批客人。","","","",0,0],
        [70028,"dialogue","",702,"误闯争斗","野兽的嘶鸣于林间回响，当你拨开草木，发现于两侧对峙的兽群时，为时已晚。","","","",0,0],
        [70029,"dialogue","",706,"败兽余怒","一时的落败并未让野兽们就此罢休，它们仍在附近徘徊。","","","",0,0],
        [70030,"dialogue","",706,"野兽巢穴","动物们都会把战利品藏在自以为安全的地方。","","","",0,0],
        [70031,"dialogue","",702,"丛林伏影","微风拂过，湿润的草木清香中，你嗅到了一丝危险的气息。","","","",0,0],
        [70032,"dialogue","",706,"拖拽湿痕","泥泞的地面上，被拖拽的痕迹深浅不一地交错着。","","","",0,0],
        [70033,"dialogue","",706,"木制铡刀","远处传来枝条骤然合拢的铿响，让你联想到某种铡刀。","","","",0,0],
        [70034,"dialogue","",706,"雨林断头台","巨大的叶片在前方开合，斩下时全无怜悯，不屑一顾。","","","",0,0],
        [70035,"dialogue","",702,"无主腰带","一条猎手腰带。它为什么挂在树上？周围的爪痕已给出了答案。","","","",0,0],
        [70036,"dialogue","",702,"追狩","在你还未听见近在咫尺的动静前，浑身的汗毛就因察觉到危险而竖立了起来。","","","",0,0],
        [70037,"dialogue","",702,"熄灭的营火","地上凌乱的营火仍有余温，踩灭它的人还未走远。","","","",0,0],
        [70038,"dialogue","",702,"巨岩","林间横着一块开裂的岩石，缝隙深处传来游丝般的呼吸声。是幻觉吗？","","","",0,0],
        [70039,"dialogue","",702,"拦路者","一片荆棘将前路截断，尖刺上的暗色液体仍可疑地反着光。","","","",0,0],
        [70040,"dialogue","",702,"绊足者","这些盘卷的根须泥泞且湿滑，你很难找到能下脚的地方。","","","",0,0],
        [70041,"dialogue","",702,"白石圈","几块发白的石头围成圈，中央的空地干净得可疑。","","","",0,0],
        [70042,"dialogue","",702,"垂藤","藤蔓从难以看到尽头的树冠垂落，末梢将将拂过你的头顶。","","","",0,0],
        [70043,"dialogue","",702,"碎石滩","浅滩中铺满碎石，其中几粒正逆着水流滚动。","","","",0,0],
        [70044,"dialogue","",702,"穿刺者","灌木丛里突出几根刑具般的尖刺，它们泛着金属的光泽。","","","",0,0],
        [70045,"dialogue","",702,"空壳菌","脚下传来某种像是轻薄骨骼碎裂的声响，抬起鞋底，依稀可分辨出是某种菌类。","","","",0,0],
        [70046,"dialogue","",702,"孤石","坡底突兀地插着一块石头，侧面布满纵向擦痕，几片新鲜碎叶被压在下面。","","","",0,0],
        [70047,"dialogue","",702,"潮湿雾气","林间的雾气伏在地面，远处却传来干燥树木噼啪开裂的声音。","","","",0,0],
        [71001,"dialogue","",703,"受伤的同伴","你仔细辨认了一会儿，才发现这个气息奄奄、血流如注的人是自己的一位同伴。","","","",0,0],
        [71002,"dialogue","",703,"岩中宝石","宝石精妙地楔在石头缝隙里，要撬取哪一块才不会让它坍塌？","","","",0,0],
        [72001,"dialogue","",704,"倒伞菌","四周挤满倒伞状菌类，伞缘凝固着透明的，未曾落下的雨滴。","","","",0,0],
        [72002,"dialogue","",704,"困顿与萎靡","植物的枝叶逐渐茂密，你无法确认视野昏暗是因光无法抵达地面，还是由于愈发沉重的眼皮。","","","",0,0],
        [73001,"dialogue","",705,"浓雾","雾中的景象像是投在白墙上的树影，不真切地晃动着。","","","",0,0],
        [73002,"dialogue","",705,"古老的符号","石头上有几枚符号，自亘古的过去朝你投来一瞥。","","","",0,0],
        [71003,"dialogue","",703,"几何黑曜石","缝隙里嵌着一枚三角形黑曜石，边缘呈现精心计算后的锋利。","","","",0,0],
        [71004,"dialogue","",703,"流动黑曜石","它沉陷于地面的凹陷处，是光在流动，还是它在流动？","","","",0,0],
        [72003,"dialogue","",704,"祖母绿项链","藤蔓上结着未成熟的果实，凑近时才发现竟是一条祖母绿项链。","","","",0,0],
        [72004,"dialogue","",704,"红宝石心脏","长久地注视后，你意识到它的确在极缓慢地搏动。","","","",0,0],
        [73003,"dialogue","",705,"奄奄一息","火苗精疲力竭地挣动了两下，你几乎以为它要熄灭了。","","","",0,0],
        [73004,"dialogue","",705,"水晶的注视","它的切面根本无法让光折射进眼眶里，那凝望着你的两点究竟是什么？","","","",0,0],
        [71005,"dialogue","",703,"遥远的音符","石板下传来一首未曾听闻的乐曲，高音部分装饰的笛声格外抓耳。","","","",0,0],
        [71006,"dialogue","",703,"黑珍珠项链","一串珍珠悬挂在枝头，其上的黑色仿若深海的投影。","","","",0,0],
        [72005,"dialogue","",704,"火炬","以龙舌兰叶片捆扎而成的火炬，不可见的持炬者正审视着你。","","","",0,0],
        [72006,"dialogue","",704,"某枚钥匙","泥水中隐约可见一把结构精巧的钥匙。","","","",0,0],
        [73005,"dialogue","",705,"枝头摇曳的","挂坠在枝头摇晃，更远处有什么正与它的频率相应和。","","","",0,0],
        [73006,"dialogue","",705,"不歇的意志","曾需它驱动的机关早已化为齑粉，这枚发条却仍不愿停步，永不肯罢休。","","","",0,0],
        [71007,"dialogue","",703,"请君入瓮","视线移入匣中时，它讨要物资的意图强硬地挤进了你的脑海。","","","",0,0],
        [72007,"dialogue","",704,"孤独的金叶","石台上躺着一片金叶。","","","",0,0],
        [73007,"dialogue","",705,"虚位以待","弹痕将一处凹槽团团围住，那里合该被填入什么。","","","",0,0],
