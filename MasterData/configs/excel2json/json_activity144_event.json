[
    "activity144_event",
    [
        [11509,1001,"100101|100102|100103","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","你在山麓地带遇到了一位下山的登山客。\n一场暴风雪几乎夺走了他的生命。他的物资已不足以支撑他到达下一处营地。","偶遇登山客",1],
        [11509,1002,"100201|100202|100203","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","你找到了登山客提到的缆车站，这里已经被废弃许久。","废弃缆车站",1],
        [11509,1003,"100301|100302|100303","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","一个人倒在了雪地中。当你走近时，你认出了这个熟悉的背影。","倒在雪地中的登山客",1],
        [11509,1004,"100401|100402|100403","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","一团缓慢移动的绒毛吸引了你的注意。那是一只灰白的雪兔。它的后腿内侧被尖锐的植物戳伤，在冰原上拖拽出一条淡淡的血痕。","受伤的雪兔",1],
        [11509,1005,"100501|100502","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","你遇到了一位年迈的旅行家。他热情地向你打招呼，但你听不懂对方的语言，那似乎是德语。","等待救援的旅行家",1],
        [11509,1006,"100601|100602","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","你遇见了一位身着基金会外勤工作服的女士。","基金会外勤人员",1],
        [11509,1007,"100701|100702|100703","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","当你听到弓弦的声音时，箭矢已经从朝你飞来。幸运的是，箭矢落在了脚边，你并未受伤。\n你望向箭矢的源头，灌木丛中有一双警觉的眼睛。","灌木丛中的箭矢",1],
        [11509,1008,"100801|100802|100803","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","一头山羊的残骸，已经被啃食一半。刺鼻的血腥味揭露了山羊死去的大致时段，这起悲剧发生于三天内。","山羊的残骸",1],
        [11509,1009,"100901|100902","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","稚嫩的呼喊声从身后传来。你认出了他的身影，那位躲在灌木丛里的持弓牧童，你曾给予他面包。","持弓的牧童",1],
        [11509,1010,"101001|101002|101003","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","你遇到了一位拉普拉斯研究员。她已经于雪山上驻扎了一段时日。当她得知你是新任的馆长后，她表现得很兴奋。","拉普拉斯研究员",1],
        [11509,1011,"101101|101102","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","在山路的转角处，你遇到了一位蒙面的猎人，他全身都被破旧的兽皮与布条包裹着。好在，他对你似乎并无恶意。","蒙面的猎人",1],
        [11509,1012,"101201|101202","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","你途径了一处山谷，道路两旁零星分布着几棵蛇麻草树。","蛇麻草树",1],
        [11509,1013,"101301|101302","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","山洞内的一处临时营地，篝火刚熄灭不久，登山者们在此度过了相对温暖的一夜。","临时的营地",1],
        [11509,1014,"101401|101402","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","你遇见了四位结伴而行的旅者，四位已经达成本次攀登目标的旅者。他们今早从登山者栖所出发，开始下山的历程。","结伴而行的旅者",1],
        [11509,1015,"101501|101502","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_4","一位蒙面的猎人虚弱地坐在雪地上。兽皮与布条将他包裹得严严实实。血迹浸染了布条，他的左肩正负伤出血。","受伤的猎人",1],
        [11509,1016,"101601|101602","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","一位蒙面的猎人仰面躺着，怀中抱着一柄铜制手斧。胸膛并无起伏，可以确定的是，他咽下了最后一口气。","倒下的猎人",1],
        [11509,1017,"101701|101702|101703","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","一处基金会设立的研究据点。食物、植物还是情报，你的选择并不少。\n","驻扎据点",1],
        [11509,9102,"910201|910202|910203","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","走过山路的拐角，你发现了冰川融水形成的一汪湖泊。","冰川湖泊",0],
        [11509,9103,"910301|910302","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","你看到了一间废弃的登山小屋，这或许是一处临时的避难所。","登山小屋",0],
        [11509,9109,"910901|910902","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","路边丢弃着一盏登山瓦斯炉，所剩不多的燃料仍能令它维持燃烧一阵子。","登山瓦斯炉",0],
        [11509,9110,"911001|911002|911003","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","你发现了前方的一处山洞，一处躲避风雪的天然掩体。洞内传来野兽的声响，但你已感到疲惫不堪。","山洞",0],
        [11509,9111,"911101|911102|911103","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","山崖间的断裂索桥拦住了你的前路。","断裂的索桥",0],
        [11509,9112,"911201|911202|911203","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_4","你发现了一处冰雪融化形成的隧道，并不知道它将通向何处。","冰雪隧道",0],
        [11509,9113,"911301|911302|911303","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","你在雪地上发现了动物的足迹。","雪地的足迹",0],
        [11509,9107,"910701|910702|910703","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","你途径了一片高山牧场，你的出现引起了牛群的警觉，你进入了它们的活动区域。","牧场的牛群",0],
        [11509,9108,"910801|910802|910803","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_4","一群欧亚猞猁挡住了你的去路，它们翘首以盼，等来了理想的猎物。","拦路的掠食者",0],
        [11509,9114,"911401|911402|911403","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","风雪愈演愈烈，一场暴风雪很快就将来临。","临近的暴风雪",0],
        [11509,9115,"911501|911502|911503","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","一条溪流挡住了你的去路，溪流较宽，但水流并不湍急。","跨越溪流",0],
        [11509,9202,"920201|920202|920203","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","一名登山者在距你不远处休息。他与你分享了自己的见闻。据称，在前方的悬崖之上，有一株奇特的植物。","稀有植物",0],
        [11509,9203,"920301|920302","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","一匹狼躺在你前进的道路上。它毛发灰暗，后腿被捕兽夹夹住，无法动弹。","受伤的孤狼",0],
        [11509,9209,"920901|920902","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","你听见冰层破裂的声音，经验告诉你，雪崩即将来临。","雪崩的预兆",0],
        [11509,9210,"921001|921002|921003","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","一位登山者与你迎面相遇。他告诉你，他找到了一株珍贵植物，希望能与你交换物资。","真假植物",0],
        [11509,9211,"921101|921102|921103","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","你途经一处悬崖，发现崖边凸出的石块适于站立，可在此眺望风景。","高山美景",0],
        [11509,9212,"921201|921202|921203","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_4","你在途中休息时，一群羚羊从远处慌乱地奔来。","慌乱的奔逃",0],
        [11509,9213,"921301|921302|921303","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","你发现了一些埋在雪中的登山装备，看上去有些破损，但勉强还能使用。","埋藏的装备",0],
        [11509,9207,"920701|920702|920703","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","这块滑雪板倒在路旁，半埋于积雪中。尽管有些陈旧，但看起来还能使用。","简陋的滑雪板",0],
        [11509,9208,"920801|920802|920803","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_4","在前进中，你发现路旁的灌木遮掩下隐约可见一条小路。显然踏上这条道路的人并不多。","未知的路",0],
        [11509,9214,"921401|921402|921403","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","你发现前方的小补给点，一群陌生的登山者正聚集在一起有说有笑。","短暂的聚会",0],
        [11509,9215,"921501|921502|921503","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","你来到一个三岔路口前。左侧的坡度较缓，但看上去参差不齐的岩石较多，中间是陡坡，离目标点最近，右侧有一段靠近悬崖的小路。","三岔路口",0],
        [11509,9301,"930101|930102|930103","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_4","你在崎岖的山路边发现了一簇紫红色的浆果，那是你曾在肥沃的平原地区采摘过的品种。","路边的浆果",0],
        [11509,9303,"930301|930302","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","前面的湖泊已经结冰，冰层看上去不算太厚，但踏上冰面仍有一定风险。","冰湖",0],
        [11509,9306,"930601|930602|930603","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","风雪平息后，阳光穿过云层映照在雪地之上。抬头能够望见高远澄澈的天空。","晴空",0],
        [11509,9309,"930901|930902","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","路边丢弃着一盏登山瓦斯炉，所剩不多的燃料仍能令它维持燃烧一阵子。","登山瓦斯炉",0],
        [11509,9310,"931001|931002|931003","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","你在登顶的路上遇到了一位装束独特的登山者。他说他是附近的山民，对附近的登顶之路都无比熟悉。","真正的向导",0],
        [11509,9311,"931101|931102|931103","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","一只欧亚猞猁出现在不远处，警惕地注视着你。","偶然的伙伴",0],
        [11509,9312,"931201|931202|931203","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_4","你选好地点，正准备扎营休息时，大风夹杂着雪粒吹拂而来。","风暴",0],
        [11509,9313,"931301|931302|931303","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","你在雪地中前行，被某样事物绊住了脚步。刨开雪堆后，一具遗骸显露出来。","危险的旅途",0],
        [11509,9305,"930501|930502|930503","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","头晕、呼吸困难。你的身体正向你发出警报，他渴望更多的氧气。","高山症候",0],
        [11509,9308,"930801|930802|930803","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_4","一群欧亚猞猁挡住了你的去路，它们翘首以盼，等来了理想的猎物。","拦路的掠食者",0],
        [11509,9314,"931401|931402|931403","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","风雪愈演愈烈，一场暴风雪很快就将来临。","临近的暴风雪",0],
        [11509,9315,"931501|931502|931503","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","一条溪流挡住了你的去路，溪流较宽，但水流并不湍急。","跨越溪流",0],
        [11509,9403,"940301|940302","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","你看到了一间废弃的登山小屋，这或许是一处临时的避难所。","登山小屋",0],
        [11509,9406,"940601|940602|940603","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","走过山隘，你在一处冰层裂缝处发现了一支精美的登山杖，可它的主人已经不见了踪影。","遗失的登山杖",0],
        [11509,9409,"940901|940902","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","路边丢弃着一盏登山瓦斯炉，所剩不多的燃料仍能令它维持燃烧一阵子。","登山瓦斯炉",0],
        [11509,9411,"941101|941102|941103","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","你在大型补给点略作休息。在这样高的地方，群星似乎触手可及。","星空",0],
        [11509,9412,"941201|941202|941203","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_4","离山顶越来越近，遇到的冰坡也越发陡峭。你眼前的这面冰坡就是一个严峻的挑战。","大冰坡",0],
        [11509,9413,"941301|941302|941303","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","你在雪地上发现了动物的足迹。","雪地的足迹",0],
        [11509,9404,"940401|940402","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","冰川轰然倒塌，阻挡了你前进的道路。","冰川塌方",0],
        [11509,9405,"940501|940502|940503","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","越接近山顶，氧气越是稀薄。你感到呼吸越发困难。","缺氧",0],
        [11509,9414,"941401|941402|941403","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","长时间的攀登使你的登山镐不堪重负。","工具破损",0],
        [11509,9415,"941501|941502|941503","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","雪线之上，天气的变化越发不稳定，突然降临的大雨阻碍了你前行的脚步。","大雨",0]
    ]
]
