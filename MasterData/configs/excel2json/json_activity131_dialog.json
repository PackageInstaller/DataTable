[
    "activity131_dialog",
    [
        [14111,1,"tips","","",0,"","步入黑夜"],
        [14112,1,"tips","","",0,"","面对恐惧"],
        [14121,1,"title","","",0,"","探索"],
        [14122,1,"title","","",0,"","挑战"],
        [14101,1,"talk","513101#610011608","",0,"亚齐","黑暗不值得畏惧，那其中并没有危险。"],
        [14101,2,"talk","513101#0","",0,"亚齐","那些本不存在的怪物只存在于分不清想象和现实的孩子心里……"],
        [14101,3,"talk","513101#610011609","",0,"亚齐","我不是这样的孩子……对吗？"],
        [14102,5,"talk","513101#0","",0,"亚齐","呼……"],
        [14102,6,"talk","513101#0","",0,"亚齐","还好，它们并不危险。我该回家去了……"],
        [14211,1,"tips","","",0,"","沿海而行"],
        [14212,1,"tips","","",0,"","叩问"],
        [14213,1,"tips","","",0,"","第一页"],
        [14221,1,"title","","",0,"","成长"],
        [14222,1,"title","","",0,"","准备"],
        [14201,1,"dialog","","",0,"","自那之后，我疏远了我的朋友们。"],
        [14201,2,"dialog","","",0,"","这样，即使我最终变得和艾尔玛一样，他们也不会为我感到伤心。"],
        [14201,3,"dialog","","",0,"","直至少年，我都在寂静和怀疑中独自行走。"],
        [14201,4,"talk","512702#0","",0,"亚齐","知识会让我们成为毛虫与蝴蝶吗？还是蛇与蛇蜕？"],
        [14201,5,"talk","512702#0","",0,"亚齐","6在成为6之后，是被改变的，还是被丢弃的？抑或是两者皆是？"],
        [14201,6,"dialog","","",0,"","这是一条漫长的沙滩，恰好沿着海的边缘存在，我被放置在这里，寻找问题的答案。"],
        [14201,7,"dialog","","",0,"","那是一段难熬的日子。"],
        [14202,1,"dialog","","",0,"","我开始翻开第一本书——书很厚重，以至于书页显得如此轻盈。"],
        [14203,1,"talk","512701#0","",0,"亚齐","<i>《无穷分析引论》</i>……唔，不对，我应该错过了它之前的……"],
        [14204,1,"talk","512701#0","",0,"亚齐","<i>“Je pense, donc je suis.”</i>……？这是我不懂的语言……"],
        [14204,2,"talk","512701#0","",0,"亚齐","哦！没错，是的，就是这样，这样就得出了最优解，我记得之前那本书上写到了……"],
        [14204,3,"dialog","","",0,"","向后展望，在某个阶段之内，刚刚进入闭关的我是幸福的。"],
        [14204,4,"dialog","","",0,"","知识逐渐充实着我，我自由地在海岸上行走，拾起脚边的贝壳，将它装入口袋，继续前行。"],
        [14204,5,"dialog","","",0,"","比起个人的去向，我开始更多地思考那些更高、更远的问题。"],
        [14204,6,"dialog","","",0,"","那是一场启明般的拯救，沉浸的感受，我确信，真正解决问题的答案就在眼前。"],
        [14204,7,"dialog","","",0,"","在它的帮助下，我终于不再每日徘徊于那条黑暗而潮湿的海岸，身体变得轻盈，够得到天边的云彩。"],
        [14205,1,"talk","307912#0","",0,"亚齐","<i>“……现在神明送我来这里，让我继续遭不幸，我的苦难犹未了，神明们还会给我降下灾祸无穷尽……”</i>"],
        [14205,2,"talk","307912#6207914","",0,"亚齐","……"],
        [14206,1,"talk","307911#6207916","",0,"亚齐","<i>“马还没牵来，她就站在那里。再见已经说过，彼此再无话可说。”</i>"],
        [14206,2,"talk","307911#6207914","",0,"亚齐","……"],
        [14207,1,"talk","307913#6207915","",0,"亚齐","<i>“常常谈论自己的人，往往只是为了隐藏自己。”</i>"],
        [14207,2,"talk","307913#6207901","",0,"亚齐","啊……"],
        [14311,1,"","","",0,"","再会"],
        [14312,1,"","","",0,"","驻足"],
        [14321,1,"title","","",0,"","启明"],
        [14301,1,"dialog","","",0,"","那天夜里，风很轻柔。我一直站在沙滩上，任由黑夜变成黎明，金光在海上升起。"],
        [14301,2,"dialog","","",0,"","浪花向前扑着，停驻在我足尖。我想起艾尔玛，想起那之后的那段短暂的、不孤独的日子。"],
        [14301,3,"dialog","","",0,"","额头的金属有着微凉触感——那是苏菲亚和37送我的礼物，据说其中还有210的功劳。"],
        [14301,4,"dialog","","",0,"","苏菲亚呢？唔，她站在岸边，左右犹疑，她或许是在寻找木头，好做一弯小舟，追在他们的后头。"],
        [14301,5,"dialog","","",0,"","他们都是那样美丽的、有着柔软弧度的线。我知道了，我看见了。人们的命运铺陈开来，如沙滩上的漫漫行迹。"],
        [14301,6,"dialog","","",0,"","可是，仅仅如此。"],
        [14301,7,"dialog","","",0,"","我并不了解她们的心情，不懂得她们的境遇，不清楚她们在何种情况下做出的这一选择。"],
        [14301,8,"dialog","","",0,"","我只是知道了，可是我并不懂得——正如我自己的命运。"],
        [14301,9,"dialog","","",0,"","没由来地，我感到海潮的湿润覆上了我的眼眶。"],
        [14301,10,"dialog","","",0,"","视线逐渐模糊，海平面在我的眼中变得遥远。阳光照耀其上，那粼光如此柔和。"],
        [14301,11,"talk","307901#0","",0,"亚齐","啊。"],
        [14301,12,"dialog","","",0,"","<i>“……一峰灰蓝色的海浪，托起洁白的水沫，牵动底下的一片深蓝……”</i>"],
        [14301,13,"dialog","","",0,"","<i>“……海水具有恒定性，在潮汐与环流……”</i>"],
        [14301,14,"dialog","","",0,"","我踉跄了一下，足尖踏入浪花间。冰凉覆盖其上，冲刷了一切与之有关的知识和字句。"],
        [14301,15,"talk","307910#6207912","",0,"亚齐","……哈哈哈！"],
        [14301,16,"dialog","","",0,"","是的，这就是我缺失的东西。"],
        [14301,17,"dialog","","",0,"","知道不是懂得。经验不是体验。我自以为“知道”的一切都不如足尖的这片冰凉来得更为真实。"],
        [14301,18,"dialog","","",0,"","在那份“启示”真正到达之前，我永远无法断言自己已懂得了命运。"],
        [14301,19,"dialog","","",0,"","我合上了手里的绘本，感受它粗砺的封面和坚实的质感。"],
        [14301,20,"talk","307910#6207907","",0,"亚齐","……那么，我不再需要其他书了。"]
    ]
]
