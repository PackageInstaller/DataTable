        [6001101,60011,1,0,"subtype#205#1#1#0",1370003,0,1,"subtype#205#1#1#1","2:3|1:2","","","用衣物包裹皮肤","荆棘将衣物撕开，并给你的皮肤留下伤痕。",0,"","尖刺划伤了衣物，好在你的皮肉没有遭受苦痛。",0,"","荆棘只在衣料上留下浅浅的痕迹，你仍旧保持着体面。",0,""],
        [6001102,60011,1,0,"",0,0,0,"","","","","硬闯","",0,"","你成功穿过了荆棘，但也被划得伤痕累累。",0,"","",0,""],
        [6001201,60012,1,0,"subtype#204#1#1#0",1370005,0,1,"subtype#204#1#1#1","2:3|1:1","","","用工具开出窄路","工具没能帮你开路，你仍迷失于树枝织成的网。",0,"","你努力开辟了一条窄路，虽然大汗淋漓，但总算穿过了树障。",0,"","你斩开阻路的枝杈，顺便收集到一些有用汁液。",0,""],
        [6001202,60012,1,0,"",0,0,0,"","","","","绕路","你不幸选错了路线，枝桠的层层暗影将你包围。",0,"","",0,"","",0,""],
        [6001301,60013,1,0,"subtype#203#1#1#0",1370003,0,1,"subtype#203#1#1#1","2:3|2:2","","","用工具解开机关","你不慎碰碎了机关旁的水球，整个人随之跌入陷阱深处。",0,"","你拆除了机关，但却因一地的湿滑绊倒摔跤。",0,"","你完美摧毁了机关，大步通过陷阱。",0,""],
        [6001302,60013,1,0,"",0,0,0,"","","","","直接跨过机关","",0,"","你高估了自己，大跨步计划失败了。",0,"","",0,""],
        [6001401,60014,1,0,"subtype#203#1#1#0",1370003,0,1,"subtype#203#1#1#1","2:3|2:2","","","击碎水球","水雾炸开，兜头而来，灌入了你的口鼻。",0,"","你边躲避边逐个击破水球，清出一条没有阻碍的路。",0,"","你准确地击中了水球的中心，于是你没费多大力气就扫除了障碍。",0,""],
        [6001402,60014,1,0,"",0,0,0,"","","","","驱赶水球","",0,"","湿冷的水雾在你手心炸开，你不得不停下休整。",0,"","",0,""],
        [6001501,60015,1,0,"subtype#202#1#1#0",1370002,0,1,"subtype#202#1#1#1","2:1|2:1","","","递出食物安抚","它吞掉食物仍不满足，干脆钻进你的背包吃起了自助餐。",0,"","它叼着食物返回密林，没有阻碍你前行。",0,"","它接受了投喂，还回赠了你一些古怪的玩意儿。",0,""],
        [6001502,60015,1,0,"",0,0,0,"","","","","把它赶走","",0,"","它怎样都不肯离开，反倒跳上你的肩头，把你当作代步工具。",0,"","",0,""],
        [6001601,60016,1,0,"subtype#201#1#1#0",1370001,0,1,"subtype#201#1#1#1","3:1|1:2","","","拿出黄金树叶","树叶的共鸣似乎刺激到了它，鱼影挣扎了几下后，坠落在你的面前。",0,"","鱼影吸收了树叶中的能量，然后摆尾消失在水中。",0,"","鱼影在与树叶的共鸣中散发出美妙的气味，沐浴其中，你感觉周身的疲惫一扫而空。",0,""],
        [6001602,60016,1,0,"",0,0,0,"","","","","驱散幻影","",0,"","你没能将这鱼影驱散，它反而绕着你的影儿打转。",0,"","",0,""],
        [6001701,60017,1,0,"subtype#205#1#1#0",1370003,0,1,"subtype#205#1#1#1","2:3|1:2","","","避眼绕行","它的目光似乎能浸透遮蔽之物，让你感到阵阵恶寒。",0,"","你努力避开它的注视，但后背早已被汗浸湿。",0,"","你找到一条在它视线死角的通路，甚至还在角落拾取了一些有用的玩意儿。",0,""],
        [6001702,60017,1,0,"",0,0,0,"","","","","忽视它，直走","",0,"","你强迫自己忽视那道目光，可它让你如芒在背。",0,"","",0,""],
        [6001801,60018,1,0,"card#22000003#1#0",1370001,0,1,"card#22000003#1#1","2:1|2:2","","","拿出黄金树叶","石柱毫无回应，黄金树叶的微光消散无踪。",0,"","石柱与树叶短暂地共鸣，让你感觉身体轻松了些许。",0,"","共鸣的金光沿石纹弥漫，在光辉之中，你的疲惫很快被一扫而空。",0,""],
        [6001802,60018,1,0,"",0,0,0,"","","","","击碎石柱","",0,"","石柱破碎，空留一地尘埃。",0,"","",0,""],
        [6001901,60019,1,0,"subtype#204#1#1#0",1370005,0,1,"subtype#204#1#1#1","2:3|1:1","","","潜行侦察","“咔嚓”——经典的踩树枝桥段上演，你暗叫不好，但敌人已经围了上来。",0,"","你潜藏在阴影当中，数次险险与敌人擦肩而过。",0,"","你谨慎地绕行，甚至还意外收获了一批遗落的弹药。",0,""],
        [6001902,60019,1,0,"",0,0,0,"","","","","无视脚步声","",0,"","你继续前进，但敌人很快从侧面袭击了你。",0,"","",0,""],
        [6002001,60020,1,0,"card#22000027#1#0",0,0,0,"","","","","穿上高筒靴","",0,"","靴筒使你免受草叶的伤害，你得以平稳穿过这片危地。",0,"","",0,""],
        [6002002,60020,1,0,"",0,0,0,"","","","","开辟路径","",0,"","没有合适的护具，你只能选择割草开路。",0,"6002003#6002004","",0,""],
        [6002003,60020,0,0,"subtype#204#1#1#1",0,0,0,"","","","","使用工具开路","",0,"","荒草倒在两边，露出一份藏起的物资。",0,"","",0,""],
        [6002004,60020,0,0,"",0,0,0,"","","","","直接前行","",0,"","锋利的草叶割开你的皮肤，鲜血汩汩渗出。",0,"","",0,""],
        [6002101,60021,1,0,"card#22000014#1#1",0,0,0,"","","","","使用肾上腺素救助","",0,"","他的呼吸渐渐平稳，为了感谢你的救助，他将自己的物资赠送给你。",0,"","",0,""],
        [6002102,60021,1,0,"",0,0,0,"","","","","没有肾上腺素","",0,"","他看向你的弹药，提出另一个交换方案。",0,"6002103#6002104","",0,""],
        [6002103,60021,0,0,"type#3#1#1#1",0,0,0,"","","","","交出对策牌","",0,"","他收下弹药，向你透露了一处弹药的藏匿地点。",0,"","",0,""],
        [6002104,60021,0,0,"",0,0,0,"","","","","拒绝救助","",0,"","他挣扎的目光让你饱受良心的折磨，你的手脚似乎都在发僵。",0,"","",0,""],
        [6002201,60022,1,0,"subtype#202#1#1#1",0,0,0,"","","","","吃下食物","",0,"","饥饿被暂时压下，肚子也不再发出抗议之声。",0,"","",0,""],
        [6002202,60022,1,0,"",0,0,0,"","","","","强行忍耐","",0,"","空腹感影响到你的思绪，困意随之而来。",0,"","",0,""],
        [6002301,60023,1,0,"subtype#201#1#1#1",0,0,0,"","","","","尝试开箱","",0,"","树叶成功撬开箱子的嘴巴，让它吐出一份可用物资。",0,"","",0,""],
        [6002302,60023,1,0,"",0,0,0,"","","","","压下冲动","",0,"","你强行移开视线，可好奇心让你难受得抓耳挠腮。",0,"","",0,""],
        [6002401,60024,1,0,"subtype#203#1#1#1",0,0,0,"","","","","尝试治疗","",0,"","痛感渐渐减弱，异常状态被短暂清除。",0,"","",0,""],
        [6002402,60024,1,0,"",0,0,0,"","","","","任由疼痛蔓延","",0,"","疼痛反复敲击你的神经，连带着情绪都开始失控。",0,"","",0,""],
        [6002501,60025,1,0,"subtype#205#1#1#1",0,0,0,"","","","","铺上你的衣物","",0,"","衣物让这个临时床铺显得温馨舒适，现在只缺一份食物。",0,"6002503#6002504","",0,""],
        [6002502,60025,1,0,"",0,0,0,"","","","","拒绝停留","",0,"","你虽然转身离开，但想要休憩的心却落在营地。",0,"","",0,""],
        [6002503,60025,0,0,"subtype#202#1#1#1",0,0,0,"","","","","吃饭","",0,"","食物抚慰着胃部，你的体力恢复了一些。",0,"","",0,""],
        [6002504,60025,0,0,"",0,0,0,"","","","","空腹休息","",0,"","饥饿让休息的效果大打折扣，对食物的渴望让你思绪混沌。",0,"","",0,""],
        [6002601,60026,1,0,"card#22000023#1#0",0,0,0,"","","","","用兜帽们的规则进行交易","",0,"","兜帽人点了点头，把一份物资推到你面前。",0,"","",0,""],
