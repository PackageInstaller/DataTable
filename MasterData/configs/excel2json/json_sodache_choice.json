        [7001101,70011,1,70003,"",1370001,0,0,"","1:1|1:2","","","贴着岩壁攀爬","你脚下一滑，跌落高坡，脚踝严重扭伤了。",0,"","你花了很长时间才攀上高坡。",0,"","你细心沉稳地攀上了高坡，还在途中取得了岩缝中的宝物。",0,""],
        [7001102,70011,1,0,"",1370001,0,0,"","1:2|1:1","","","尝试使用神秘术","你念错了咒语，摔得一阵发麻。",0,"","你的咒语发音不太标准，但也勉强登上了高坡。",0,"","你精准念出了咒语，顺利登上了高坡。",0,""],
        [7001201,70012,1,70004,"",1370003,0,0,"","1:3|1:2","","","尝试摘取花蕊","花瓣突然合拢，划破了你的手。",0,"","你摘取了部分花蕊，但花朵开始发狂。",0,"","你顺利摘取了整簇花蕊。",0,""],
        [7001202,70012,1,0,"",0,0,0,"","","","","小心绕开","",0,"","花朵仍在熟睡，你很庆幸没有惊醒它。",0,"","",0,""],
        [7001301,70013,1,70005,"",1370001,0,0,"","1:1|1:2","","","缓步前进","错综隐秘的树根最终还是绊倒了你。",0,"","你踩着凸起的树根踉跄通过了。",0,"","你踩着平整的树根通过了，还顺利取到了藏在根系里的宝物。",0,""],
        [7001302,70013,1,0,"",1370001,0,0,"","1:2|1:1","","","用力一跃","不知哪儿来的一条树根把你绊倒在地。",0,"","你用力收起双腿，勉强跳了过去。",0,"","你顺着预想的跳跃轨迹顺利跳了过去。",0,""],
        [7001401,70014,1,70006,"",1370005,0,0,"","2:1|1:3","","","进入探查","屋内的空气让你头晕脑胀。",0,"","你快速搜集了少许物品，赶在有人察觉前撤离了。",0,"","你选择全部带走，并顺利撤离了。",0,""],
        [7001402,70014,1,0,"",0,0,0,"","","","","尝试偷看","",0,"","屋内阴森恐怖，你决定绕道离开。",0,"","",0,""],
        [7001601,70016,1,70008,"",1370001,0,0,"","2:1|1:2","","","走台阶上去","台阶突然断裂，你摔了下来。",0,"","你惊险地跳过断阶，成功登了上去。",0,"","你避开了松动的台阶，顺利登了上去。",0,""],
        [7001602,70016,1,0,"",1370001,0,0,"","1:1|1:2","","","爬墙上去","墙面忽然塌落，你摔了下来。",0,"","你小心翼翼，勉强爬了上去。",0,"","你找到了合适的着力点，顺势借力登了上去。",0,""],
        [7001701,70017,1,70009,"",1370001,0,0,"","2:1|1:2","","","徒手攀越湿阶","湿阶让你滑回原地，磕碰声在台阶间回荡。",0,"","你抓住几处凸起，艰难爬过湿滑高阶。",0,"","你找准落脚点，几乎没有停顿就越过高阶。",0,""],
        [7001702,70017,1,0,"",1370001,0,0,"","1:1|1:2","","","扶墙攀越","墙皮在手下剥落，你被迫退回下方。",0,"","你借墙面支撑，勉强通过了这一段湿滑台阶。",0,"","墙缝给了你合适的支点，你顺利爬上高处。",0,""],
        [7001801,70018,1,70010,"",1370005,0,0,"","1:3|2:1","","","一探究竟","草丛长成了一座迷宫，你迷失了方向。",0,"","光点愚弄了你，但最后为你指明了离开的道路。",0,"","光点指引你找到了一处泉眼。",0,""],
        [7001802,70018,1,0,"",0,0,0,"","","","","离开","",0,"","草丛里的光开始变得诡异起来。",0,"","",0,""],
        [7001901,70019,1,70019,"subtype#202#1#1#1",0,0,0,"","","","","放入食物","",0,"","树洞送出了可爱的礼物。",0,"","",0,""],
        [7001902,70019,1,0,"",0,0,0,"","","","","离开","",0,"","树洞悄悄闭合了。",0,"","",0,""],
        [7002001,70020,1,70020,"subtype#203#1#1#1",0,0,0,"","","","","浇灌","",0,"","树根回应了你的善意。",0,"","",0,""],
        [7002002,70020,1,0,"",0,0,0,"","","","","离开","",0,"","树根中的光点慢慢消隐了。",0,"","",0,""],
        [7002101,70021,1,70021,"subtype#202#1#1#1",0,0,0,"","","","","投喂食物","",0,"","兽群叼走食物，低吼声逐渐远去。你安全了，暂时的。",0,"","",0,""],
        [7002102,70021,1,0,"",0,0,0,"","","","0:109370121:2&1:109370121:2&2:109370121:2&3:109370121:2&4:109370121:2&5:109370121:2","尝试驱逐","武器不及獠牙锋利，兽群嘶吼着扑来，你被迫撤离。",0,"","你逼退兽群，前路归于漆黑的宁静。",0,"","",0,""],
        [7002201,70022,1,70022,"subtype#203#1#1#1",0,0,0,"","","","","驱散困意","",0,"","舌尖于齿间受难，刺痛感短暂驱散了睡意。你清醒过来。",0,"","",0,""],
        [7002202,70022,1,0,"",0,0,0,"","","","","任由困意上涌","",0,"","花粉迎面飘来，如虫卵般亲密地附上你的身体。睡吧，睡吧，它们在谵妄中朝你低语。",0,"","",0,""],
        [7002301,70023,1,70023,"subtype#202#1#1#1",0,0,0,"","","","","投喂食物","",0,"","魔精们迅速将其分食，更多眼睛从它们身体上兴奋地睁开。",0,"7002303#7002304","",0,""],
        [7002302,70023,1,0,"",0,0,0,"","","","","立刻退开","",0,"","魔精们没有追来，无数双幽亮的眼睛注视着你离开的足迹。",0,"","",0,""],
        [7002303,70023,0,0,"subtype#202#1#1#1",0,0,0,"","","","","继续投喂","",0,"","魔精们短暂安静，又把目光投向你的背包。你还有食物，它们贪婪的小眼睛都知道。",0,"7002305#7002306","",0,""],
        [7002304,70023,0,0,"",0,0,0,"","","","","停止投喂","",0,"","没吃饱的魔精们窃窃私语着，把一件东西丢到你脚边，像是某种催促。",0,"","",0,""],
        [7002305,70023,0,0,"subtype#202#1#1#1",0,0,0,"","","","","最后一次投喂","",0,"","魔精们终于心满意足，拖出一份用枝叶精心包扎的真挚谢礼。",0,"","",0,""],
        [7002306,70023,0,0,"",0,0,0,"","","","","停止投喂","",0,"","魔精们不满地散入林间，只留下一份黏糊糊的潦草回礼。",0,"","",0,""],
        [7002401,70024,1,70024,"",0,0,0,"","","","","请求休整","",0,"","一道柔和的微光将你笼罩，灵性流溢，你在前所未有的舒适里聆听到千万呓语。",0,"","",0,""],
        [7002402,70024,1,0,"",0,0,0,"","","","","索要工具","",0,"","一件小工具从光团中落下。你触碰到工具的表面，那是某种湿滑柔软的皮肤。",0,"","",0,""],
        [7002501,70025,1,70025,"",0,0,0,"","","","","摘下鲜艳叶片","",0,"","鲜艳的叶片欣喜垂落，犹如寻觅到归宿的若虫。它将成为家族的钥匙，你将成为钥匙。",0,"","",0,""],
        [7002502,70025,1,0,"",0,0,0,"","","","","摘下黯淡叶片","",0,"","黯淡的叶片缓缓垂落，它带来了一份芳香的食物。进食吧，为了植物，为了你。",0,"","",0,""],
        [7002601,70026,1,70026,"",0,0,0,"","","","","取出物品","",0,"","你取出一件衣物。它温顺不已，它滴落黏液，它尚可御寒。",0,"","",0,""],
        [7002602,70026,1,0,"",0,0,0,"","","","","进一步翻找","",0,"","你找到一份物资。它正律动，它正苏醒，它可以被使用。",0,"","",0,""],
        [7002701,70027,1,70027,"",0,0,0,"","","","","拿走匣子","",0,"","旧匣看着有些眼熟，其中残留的能量足够支撑下一段路。",0,"","",0,""],
        [7002702,70027,1,0,"",0,0,0,"","","","","拿走弹药","",0,"","几枚子弹从灰烬里滚出，弹壳完整，对发射充满期待。",0,"","",0,""],
        [7002801,70028,1,70028,"",0,0,0,"","","","","帮助左侧兽群","",0,"","它们并不领情，而且憎恨你的介入。双方目标转换，两侧的嘶吼声向你围拢。",0,"","",0,""],
        [7002802,70028,1,0,"",0,0,0,"","","","","帮助右侧兽群","",0,"","它们谦卑接受，感谢你的援手。胜利者大快朵颐，你也得到一份谢礼。",0,"","",0,""],
        [7002901,70029,1,70029,"",0,0,0,"","","","0:109370122:2&1:109370122:2&2:109370122:2&3:109370122:2&4:109370122:2&5:109370122:2","再度驱逐","败兽之怒令人胆寒，你只能退去。",0,"","饥饿与兴奋将你笼罩，你决定审判：不容败兽停留。你将它们尽数驱逐，掠夺最后的食物。",0,"","",0,""],
        [7002902,70029,1,0,"",0,0,0,"","","","","绕开兽群","",0,"","无尽饥饿中，你用最后一丝理智绕开它们。离开后，你胃部的饥渴终于失望地消散。",0,"","",0,""],
        [7003001,70030,1,70030,"subtype#204#1#1#0",1370005,0,1,"subtype#204#1#1#1","2:3|2:1","","","翻找兽巢","兽巢深处空空如也，只留有一股腥臭气息。在成为它的一部分之前，你迅速离开了。",0,"","你在浓郁的腥臭味中翻找到一份物资，物资上写着一行熟悉的字：快离开，鲜红的饥渴将夺走你。",0,"","兽巢最深处还藏着额外的物资。你拾起它，也拾起蠕动的亘古灵性。",0,""],
        [7003002,70030,1,0,"",0,0,0,"","","","","绕开兽巢","",0,"","胃部一阵紧缩。你放过了那处巢穴，也避开了可能的麻烦。",0,"","",0,""],
        [7003101,70031,1,70031,"",0,0,0,"","","","","搜寻伏影","",0,"","叶下的影子猛地后撤，不安扭动的树叶昭示着“它”仍在附近。",0,"","",0,""],
        [7003102,70031,1,0,"",0,0,0,"","","","","谨慎离开","",0,"","你没有惊动“它”，把危险推迟、再推迟，直到危险的阴影前来吮吸你杏仁核内的恐惧。",0,"","",0,""],
        [7003201,70032,1,70032,"",0,0,0,"","","","","追踪湿痕","",0,"","拖拽而成的湿痕一路延伸到更深处。灵性躁动不安，树叶露出钢铁獠牙，“它”就在深处。",0,"","",0,""],
        [7003202,70032,1,0,"",0,0,0,"","","","","停止追踪","",0,"","你抹去自己的脚印，但阴影已经记住了它们朝向的方向。你远离了危险，你背弃了“它”。",0,"","",0,""],
        [7003301,70033,1,70033,"subtype#205#1#1#0",1370003,0,1,"subtype#205#1#1#1","2:2|2:3","","","借助掩护靠近","巨大的叶刃凛然劈下，掩体当即裂开。来自远古的处刑刀林在前，你被迫狼狈退走。",0,"","你逼出了藏在叶下的威胁，与叶片对峙。你感受到强烈扭曲的渴望拧住你的内脏。你渴望献出头颅，渴望饮下断口处猩红的汁液。叶片聆听了你的渴望。",0,"","你迅速预判出锐器挥下的方位，将威胁引至明处。明处即显形，你得见远古。远古将为你的脖颈施予潮湿的铡刀。大脑是障碍，大脑是无知。舍弃大脑，回归树林。",0,""],
        [7003302,70033,1,0,"",0,0,0,"","","","","迅速离开","",0,"","逃走吧，如同每个临阵脱逃的国王，从俯瞰大地的行刑者之手逃离。你会安全的。你们会回来的。",0,"","",0,""],
        [7003401,70034,1,70034,"",0,0,0,"","","","0:109371002:1&1:109371002:1&2:109371002:1&3:109371002:1&4:109371002:1&5:109371002:1","战斗","不可抵抗的力量把你击败，你仓皇撤离已是侥幸。",0,"","巨叶轰然倒下，你的同伴找到了一批被拦截的物品。你拿到物品，你聆听到癫狂的呓语，它们诉说同情、崇敬和欢迎。你感受到被接纳的喜悦。同伴询问你脸上那不合时宜的笑容，你回答：“别担心，那只是胜利的喜悦。”",0,"","",0,""],
        [7003402,70034,1,0,"",0,0,0,"","","","","逃走","",0,"","不可抵抗、不可直面、不可言说。你带着同伴仓皇逃离，同时感知一部分记忆被从大脑内剔除。它们不属于你，它们属于扭曲黑暗的寂静。",0,"","",0,""],
        [7003501,70035,1,70035,"card#22000025#1#1",0,0,0,"","","","","系上腰带","",0,"","你摸索到腰带上的暗袋，里面藏着前任主人的遗留。你触摸它们，仿佛触摸到有些熟悉的温度。",0,"","",0,""],
        [7003502,70035,1,0,"",0,0,0,"","","","","观察四周","",0,"","迟则生变，腰带有属于它的守卫。它们低吼着靠近，你只能考虑是否用战斗夺下这份意外收获。",0,"7003503#7003504","",0,""],
        [7003503,70035,0,0,"",0,0,0,"","","","0:109370123:2&1:109370123:2&2:109370123:2&3:109370123:2&4:109370123:2&5:109370123:2","强行夺取","守卫们源源不断，一只、十只、一百只……如忠诚的工蜂一样袭来。同伴拉着你撤离。",0,"","你有些对付它们的经验，在那经验的指引下，你击退守卫，取走腰带和周围的物资。",0,"","",0,""],
        [7003504,70035,0,0,"",0,0,0,"","","","","放弃腰带","",0,"","你没有碰那条腰带，那些锋利的爪痕也没有继续靠近。它们放你逃离命运。",0,"","",0,""],
        [7003601,70036,1,70036,"",0,0,0,"","","","0:109370124:2&1:109370124:2&2:109370124:2&3:109370124:2&4:109370124:2&5:109370124:2","追踪动静","你错判了自己的身份。逃吧，猎物，不要被猎人的刀刃屠害！",0,"","你与动静狭路相逢。调动灵性，实行暴力，你成为了猎人，你将追猎。",0,"","",0,""],
        [7003602,70036,1,0,"",0,0,0,"","","","","停止追踪","",0,"","灌木很快合拢，动静消失，对方与你一样选择了后退。",0,"","",0,""],
        [7003701,70037,1,70037,"subtype#202#1#1#1",0,0,0,"","","","0:109370125:2&1:109370125:2&2:109370125:2&3:109370125:2&4:109370125:2&5:109370125:2","引出袭击者","",0,"","袭击者挥舞着错乱的肢体上前，你与同伴将他制服，不愿再多看他的眼睛们。",0,"","",0,""],
        [7003702,70037,1,0,"",0,0,0,"","","","","离开营地","",0,"","你不再停留，营地的余烬在身后慢慢熄灭。只是一处临时营地，留给昆虫们吧。",0,"","",0,""],
        [7003801,70038,1,70038,"",0,0,0,"","","","","靠近观察","",0,"","你意识到这是古遗迹的残骸，并取走其中的物资。谁放在这儿的？",0,"","",0,""],
        [7003802,70038,1,0,"",0,0,0,"","","","","原地观察","",0,"","风声消失，巨岩安静下来，你在地图上标记了这处残骸。离开时，你又听见一声沉闷的心跳。",0,"","",0,""],
        [7003901,70039,1,70039,"subtype#204#1#1#1",0,0,0,"","","","","劈开荆棘","",0,"","刺枝被劈开一道裂口，裂口似乎有自己的意志，呕出猩红的物品。",0,"","",0,""],
        [7003902,70039,1,0,"",0,0,0,"","","","","外缘绕行","",0,"","绕开后，身后传来无数节肢动物进食的声音，你没敢回头。",0,"","",0,""],
        [7004001,70040,1,70040,"card#22000027#1#1",0,0,0,"","","","","谨慎前进","",0,"","你在坡面上艰难前进，偶然得到了一份还算有用的东西。",0,"","",0,""],
        [7004002,70040,1,0,"",0,0,0,"","","","","另寻他路","",0,"","你换了条更稳的路，大地总算停止了对你的吞食。",0,"","",0,""],
        [7004101,70041,1,70041,"card#22000018#1#1",0,0,0,"","","","","借助侦查机器人","",0,"","你看到了那个东西，它被埋在土中，裸露的部分被擦拭得过于干净，更显突兀。",0,"","",0,""],
        [7004102,70041,1,0,"",0,0,0,"","","","","不作停留","",0,"","石圈等待着下一个愿意停步的人。",0,"","",0,""],
        [7004201,70042,1,70042,"subtype#205#1#1#1",0,0,0,"","","","","拨开藤蔓","",0,"","充满肉感的粘腻藤蔓欣喜地缠住了你，你艰难地取出了其后的物匣。",0,"","",0,""],
        [7004202,70042,1,0,"",0,0,0,"","","","","绕开藤蔓","",0,"","这些粗壮的藤蔓在你的余光里轻轻蠕动。",0,"","",0,""],
        [7004301,70043,1,70043,"card#22000021#1#1",0,0,0,"","","","","撬开石层","",0,"","石层下露出了被水泡过的遗留物，你感知到其上似曾相识的灵性。",0,"","",0,""],
        [7004302,70043,1,0,"",0,0,0,"","","","","离开浅滩","",0,"","更多的石子逆着水流滚动起来，将异样掩藏在浅滩。",0,"","",0,""],
        [7004401,70044,1,70044,"subtype#204#1#1#1",0,0,0,"","","","","用工具拨开","",0,"","你顺利拿到了它们所保护的东西。",0,"","",0,""],
        [7004402,70044,1,0,"",0,0,0,"","","","","径直离开","",0,"","还是不要继续刺激它们为好。",0,"","",0,""],
        [7004501,70045,1,70045,"",0,0,0,"","","","","掀起菌盖","",0,"","在菌丝长到你手上之前，你迅速取出了其中的物品。",0,"","",0,""],
        [7004502,70045,1,0,"",0,0,0,"","","","","从旁边穿过","",0,"","菌盖之下，无数菌丝相互缠绕颤抖。它们的繁殖与你无关。",0,"","",0,""],
        [7004601,70046,1,70046,"",0,0,0,"","","","","查看背面","",0,"","孤石如命运的故人般伫立，擦痕指向底部，为你显露旧日之物的踪迹。",0,"","",0,""],
        [7004602,70046,1,0,"",0,0,0,"","","","","继续赶路","",0,"","坡底很快被甩在身后，那些擦痕却还留在你的脑海。",0,"","",0,""],
        [7004701,70047,1,70047,"",0,0,0,"","","","","循声前进","",0,"","雾气逐渐凝聚成某种新生的躯体，你见证了新生。",0,"","",0,""],
        [7004702,70047,1,0,"",0,0,0,"","","","","暂时避开","",0,"","雾气徘徊在林隙之间，碎裂声被你远远抛在了身后。",0,"","",0,""],
        [7100101,71001,1,71001,"subtype#205#1#1#0",1370003,0,1,"subtype#205#1#1#1","2:2|2:3","","","为同伴处理伤口","纱布难以阻止鲜血渗流，抢救也让你筋疲力尽。",0,"","同伴恢复了意识，将带在身上的遗物交给了你。",0,"","同伴失血的态势被你彻底止住。他向你指出了另一件遗物的位置。",0,""],
        [7100102,71001,1,0,"",0,0,0,"","","","","观察后离开","",0,"","你记下他的位置，并未选择冒险上前搭救。",0,"","",0,""],
        [7100201,71002,1,71002,"subtype#204#1#1#0",1370005,0,1,"subtype#204#1#1#1","2:3|2:1","","","顺着裂缝开凿","石层松动，你惊险逃离坍塌的岩层，耗尽体力。",0,"","裂缝掉出一枚完整的宝石，现在它归你所有了。",0,"","你凭借高超的技巧，一连取出数枚宝石，岩层仍然巍然不动。",0,""],
        [7100202,71002,1,0,"",0,0,0,"","","","","放弃开凿","",0,"","宝石的微光仍然在岩壁深处闪烁。",0,"","",0,""],
        [7200101,72001,1,70007,"subtype#205#1#1#0",1370003,0,1,"subtype#205#1#1#1","2:3|2:2","","","用衣物辅助摘取","孢子瞬间炸开，你呛得无法呼吸，只能放弃。",0,"","你摘下了古怪的真菌，但菌盖边缘已然破损。",0,"","你完整地摘下了整颗蘑菇，连那些透明水滴也完好无损。",0,""],
        [7200102,72001,1,0,"",0,0,0,"","","","","绕开菌群","",0,"","你拒绝涉足菌盖下的阴影，省去了不少麻烦。",0,"","",0,""],
        [7200201,72002,1,72002,"subtype#202#1#1#0",1370002,0,1,"subtype#202#1#1#1","2:1|2:1","","","吃口面包，补充体力","你的胃永不知足，难以消退的饥饿感使你无法前进。",0,"","你的身体恢复了活力，支撑你在林地深处找到了遗物。",0,"","你充满了力量，甚至获得了一些额外的收获。",0,""],
        [7200202,72002,1,0,"",0,0,0,"","","","","离开林地","",0,"","仅剩的体力向你发出警告，你听从了身体的指示。",0,"","",0,""],
        [7300101,73001,1,73001,"subtype#205#1#1#0",1370003,0,1,"subtype#205#1#1#1","2:3|2:2","","","尝试在雾中前进","迷雾在大脑里扎根，你迷失了方向，也迷失了自我。",0,"","你摸索着前进，却在雾中拾起了倒霉前辈的遗物。",0,"","雾气逐渐消退，你甚至还获得了一些额外的遗物。",0,""],
        [7300102,73001,1,0,"",0,0,0,"","","","","逃离浓雾","",0,"","你逃离得太过坚决，浓雾也没能追上你逃离的脚步。",0,"","",0,""],
        [7300201,73002,1,73002,"subtype#203#1#1#0",1370003,0,1,"subtype#203#1#1#1","2:3|2:2","","","进行研究","奇异的印记侵蚀你的神智，疲惫感彻底压垮了你。",0,"","你排除了符号对精神的扰动，找到了石头下埋藏的遗物。",0,"","符号顺从地交待了秘密，你拿走遗物，并拓写下了印记的图样。",0,""],
        [7300202,73002,1,0,"",0,0,0,"","","","","放弃观察","",0,"","石头上的涂鸦而已，不必费劲探查。",0,"","",0,""],
        [7100301,71003,1,71003,"card#22000021#1#1",0,0,0,"","","","","拿出撬棍","",0,"","黑曜石从缝隙中脱落下来，锋利的边缘险些划破你的掌心。",0,"","",0,""],
        [7100302,71003,1,0,"",0,0,0,"","","","","放弃撬取","",0,"","它的价值不值得你冒险。",0,"","",0,""],
        [7100401,71004,1,71004,"card#22000022#1#1",0,0,0,"","","","","拿出工具箱尝试采样","",0,"","你顺着它的流向，巧妙装取了部分样本。",0,"","",0,""],
        [7100402,71004,1,0,"",0,0,0,"","","","","放弃采样","",0,"","黑色的“石流”渗入地底，消失了踪影。",0,"","",0,""],
        [7200301,72003,1,72003,"card#22000009#1#1",0,0,0,"","","","","拿出烤苦目糖","",0,"","正确的灵感。藤蔓缠向了这些苦味的糖果，项链落在你的手里。",0,"","",0,""],
        [7200302,72003,1,0,"",0,0,0,"","","","","放弃思考","",0,"","藤蔓什么也没有等到，于是将项链缠绕得更紧了。",0,"","",0,""],
        [7200401,72004,1,72004,"card#22000010#1#1",0,0,0,"","","","","拿出咸糖块","",0,"","糖加盐也能构成剧毒，红宝石的搏动停止了，你成功将它取下。",0,"","",0,""],
        [7200402,72004,1,0,"",0,0,0,"","","","","离开树洞","",0,"","树洞里的红光幽幽地注视你的离去。",0,"","",0,""],
        [7300301,73003,1,73003,"card#22000015#1#1",0,0,0,"","","","","使用药剂","",0,"","药剂真的有效……你不由得仔细地审视蜡烛……蜡烛？？",0,"","",0,""],
        [7300302,73003,1,0,"",0,0,0,"","","","","直接离开","",0,"","治疗蜡烛——发什么疯？",0,"","",0,""],
        [7300401,73004,1,73004,"card#22000006#1#1",0,0,0,"","","","","清理泥污","",0,"","你清理了头颅上的污泥，与眼窝中的光点清晰地对视。",0,"","",0,""],
        [7300402,73004,1,0,"",0,0,0,"","","","","不碰头颅","",0,"","头颅继续沉眠于地下，如过去万年一般。",0,"","",0,""],
        [7100501,71005,1,71005,"",0,0,0,"","","","0:109370126:2&1:109370126:2&2:109370126:2&3:109370126:2&4:109370126:2&5:109370126:2","迎战守卫","乐章为守卫助威，你难以抵挡。",0,"","守卫认输了，你拾得勇者的奖励——石板下残缺的乐谱。",0,"","",0,""],
        [7100502,71005,1,0,"",0,0,0,"","","","","捂住耳朵","",0,"","奇怪的乐曲，离开才是上策。",0,"","",0,""],
        [7100601,71006,1,71006,"",0,0,0,"","","","0:109370127:2&1:109370127:2&2:109370127:2&3:109370127:2&4:109370127:2&5:109370127:2","夺取项链","寄居其中的阴影吞噬了你，你失去意识。",0,"","项链中的阴影无法动摇你，你取走项链。",0,"","",0,""],
        [7100602,71006,1,0,"",0,0,0,"","","","","绕开枯枝","",0,"","你和寄居其中的阴影都对彼此失去了兴趣。",0,"","",0,""],
        [7200501,72005,1,72005,"",1370001,0,0,"","2:1|1:2","","","接受审视","火炬并未燃起，你失望离开。",0,"","火炬短暂燃起，照亮了它一旁的守卫。",0,"7200503#7200504","火焰趋于稳定，照亮了守卫的破绽。",0,"7200503#7200504"],
        [7200502,72005,1,0,"",0,0,0,"","","","","避开火炬","",0,"","干枯的叶片颤动片刻，复归沉寂。",0,"","",0,""],
        [7200503,72005,0,0,"",0,0,0,"","","","0:109370128:2&1:109370128:2&2:109370128:2&3:109370128:2&4:109370128:2&5:109370128:2","迎战守卫","你无力战胜守卫，火焰重新熄灭。",0,"","守卫落败消失，火舌剧烈跳动，似乎在引诱你继续前进。",0,"","",0,""],
        [7200504,72005,0,0,"",0,0,0,"","","","","不再深入","",0,"","玩火必自焚，你知道什么是适可而止。",0,"","",0,""],
        [7200601,72006,1,72006,"",1370001,0,0,"","2:1|1:2","","","拾取钥匙","钥匙如泡影般消失，你只捧起了一滩泥水。",0,"","你捞起了这把锈蚀的钥匙，泥泞掩盖了它的齿纹。",0,"7200603#7200604","你清除了钥匙上的污垢，钥匙焕然如新。",0,"7200603#7200604"],
        [7200602,72006,1,0,"",0,0,0,"","","","","不碰钥匙","",0,"","钥匙沉进泥土里，像是从未出现过。",0,"","",0,""],
        [7200603,72006,0,0,"",0,0,0,"","","","0:109370129:2&1:109370129:2&2:109370129:2&3:109370129:2&4:109370129:2&5:109370129:2","迎战钥匙守卫","守卫夺回了钥匙，你前功尽弃。",0,"","守卫不堪一击，你守住了探险的成果。",0,"","",0,""],
        [7200604,72006,0,0,"",0,0,0,"","","","","放弃深入","",0,"","泥水重新盖住了那仿若锁眼的缝隙。",0,"","",0,""],
        [7300501,73005,1,73005,"",0,0,0,"","","","0:109370130:2&1:109370130:2&2:109370130:2&3:109370130:2&4:109370130:2&5:109370130:2","迎战第一波守卫","打斗的动静引来更多敌人，你寡不敌众，只能撤退。",0,"","你解决了眼前的麻烦，但远处的动静提醒你这并未结束。",0,"7300503#7300504","",0,""],
        [7300502,73005,1,0,"",0,0,0,"","","","","放弃拾取挂坠","",0,"","挂坠又晃动了几下，最终静止下来。",0,"","",0,""],
