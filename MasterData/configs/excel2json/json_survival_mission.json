        [307010201,"明亮的黄昏",3070102,"","","你又一次见到了那位画家，他依然在奋力创作。只不过显得有些郁郁寡欢。",99,"survival/roles/prefab/npc_sm_guizu_c.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"还在画吗#离开",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307010301,"永无止境的书页",3070103,"","","你拾级而上，来到了一座图书馆，它造型奇特，由无数六边形的回廊构成。\n无穷多个书架以奇怪的角度倾斜，仿佛在朝某个无形的中心点弯腰致敬。",99,"survival/buiding/v3a4_survival_shu.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",2,"看看这儿都有些什么书#离开",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307010401,"“文学品鉴会”",3070104,"","","你熟悉它们，它们出现在各种地方——福特汽车、维也纳街头的咖啡馆、某份报纸的悬赏版面、以及某位声称“收藏正是为了研究艺术本质”的商人随身携带的盒子里。\n自然，它们也会出现在这儿。",99,"survival/roles/prefab/monster_elite_hulimojing.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"瞧瞧它们这次在干什么#你已经在实验室见过它们很多次了",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307010501,"“9号出口”",3070105,"","","一栋绿色的建筑，看上去不太安全。",99,"survival/buiding/v3a1_survival_fangzi_4.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",2,"进入查看#离开",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307010601,"“推销员”",3070106,"","","你来到一个帐篷前，里面传来了“沙沙”的声音。",99,"survival/buiding/v3a1_survival_fangzi_2.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"进入查看#离开",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307010701,"上帝会掷骰子吗？",3070107,"","","“你相信造物主的存在吗？”\n一位面容忧郁的男子拦在你的必经之处。“你觉不觉得我们像是生活在一个箱子里？”\n你看到他的手抚摸着一个盖着玻璃罩的东西，似乎在模仿某个有名的思想实验。",99,"survival/roles/prefab/role_sm_npc_shenggeerhao.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"瞧瞧罩子底下放了什么#他是疯子吗？",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307010801,"“光滑的大脑”",3070108,"","","一栋造型奇特的建筑，隐约散发着光芒。",99,"survival/buiding/v2a8/building_xvqiuzhongxin.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",3,"进入查看#离开",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307010901,"“水晶”",3070109,"","","“命运是某种既定的规律。”\n在永无止境的六边形地图与六边形地块间穿梭时，你瞧见了水晶的辉光。",99,"survival/buiding/v3a4_survival_shuijin.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",2,"拾起水晶#远离这个可能开始说教的东西",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307011001,"“世界的本质”",3070110,"","","某位心理学家提出的概念，你亲爱的同事们最喜欢研究的课题之一，盒子内外，“有深度”的人时常提及的，一个被用滥了的名词。\n它是一片海，一罐橙汁，你的梦，抑或全宇宙共同的梦。\n你相信它吗？一个纯净的，虚无的，一元论的乌托邦，与盒子里那座虚幻的塔，似乎别无二致。",99,"survival/buiding/v3a1_survival_fangzi_7.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",2,"相信#拒绝参加这种隐喻游戏",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307011101,"月光诡马",3070111,"","","为什么荒野里会有一座装修得如此“瑰丽”的博物馆？黄金的大门，大理石的外墙和彩绘玻璃。如果不是周围荒凉得像是无人区，你真觉得自己应该买上一张票，好好接受一下艺术的熏陶。",99,"survival/buiding/v3a1_survival_fangzi_5.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",2,"进入查看#离开",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307011201,"没有衬衫的人",3070112,"","","又是这座博物馆，但是似乎少了一些辉煌，多了一些破旧。怎么样，该再一次进入吗？",99,"survival/buiding/v3a1_survival_fangzi_5.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"进入查看#离开",0,71,"1#2#3#4#5#6","",0,1,"","","",15,""],
        [307011301,"种羔羊",3070113,"","","这是你第三次见到这座博物馆了，它的破败更加严重了。金色的大门爬满了锈蚀和藤蔓。大理石的墙上满是裂痕。整座房子摇摇欲坠。",99,"survival/buiding/v3a1_survival_fangzi_5.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"进入查看#离开",0,71,"1#2#3#4#5#6","",0,1,"","","",15,""],
        [307011401,"流浪棺材",3070114,"","","你发现一群人正围着一口棺材吵得不可开交。",99,"survival/buiding/v3a1_survival_mubei.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"旁听#离开",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
