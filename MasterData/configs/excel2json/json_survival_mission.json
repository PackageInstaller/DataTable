        [307012401,"香水的品味",3070124,"","","花朵在风中摇摆，散发出一股奇特的花香。",99,"survival/buiding/v3a1_survival_huatian.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"闻着有些刺鼻#闻着有些芬芳",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307012501,"合作",3070125,"","","拉普拉斯研究员，在这个玩具盒中似乎就是各种稀奇古怪事件的代名词——虽然在现实中也是，但是不是有点儿太被针对了？",99,"survival/roles/prefab/role_sm_npc_lapulasiyisheng_c.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"上前搭话#离开",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307012601,"反馈机制",3070126,"","","一位推销员打扮的人拦住了你，并客气地向你询问在这个玩具盒中的行动感受。",99,"survival/roles/prefab/npc_sm_guizu_b.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"还有反馈环节？#离开",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307012701,"源于生活而高于它",3070127,"","","你来到一间房间。房间里只有一位研究员，正在对着屏幕敲打着键盘。",99,"survival/buiding/v3a1_survival_terrain_lapulasi_02.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"进入查看#离开",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307021901,"大海与高脚椅",3070219,"","","海边突兀地立着一张高脚椅，有人正优雅端庄地坐在上面，他皮鞋上的沙砾被拂得干干净净，西装的袖口与下摆也显然被整理过。他拿着一本书，你看不清书名。出于好奇，你鼓足勇气走上前去。",99,"survival/roles/prefab/npc_sm_guizu_b.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"你、你好#离开",0,71,"1#2#3#4#5#6","",0,0,"","","4",15,""],
        [307022001,"高歌的诗人们",3070220,"","","面前的人们举着杯子，勾肩搭背，摇摇晃晃，语不成句地大喊着：“哭吧！痛吧……哀愁吧，高歌吧！我们……有源源不断的幸福！幸福的美酒！我需要纸，我需要笔，我需要书写这无处可去的感情……我们……嗝……呃……”",99,"survival/buiding/v3a1_survival_guizu.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",2,"上前搭话#离开",0,71,"1#2#3#4#5#6","",0,0,"","","4",15,""],
        [307022101,"城堡山魔精之王",3070221,"","","一人仰躺在地上看着天空，一人俯卧着把耳朵紧贴地面。他们的表情呆滞，不知道在做什么。你担心他们遭遇了袭击，因此你上前询问发生了什么。",99,"survival/buiding/v3a1_survival_lapulasi.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"上前搭话#离开",0,71,"1#2#3#4#5#6","",0,0,"","","4",15,""],
        [307022201,"一份“礼物”",3070222,"","","一辆“不可燃点”载具里，有人正停下来将头探到车外喝水。这辆载具在理论上可以承受2800华氏度的高温，但是却未配备对应的散热装置，是连风扇都没有的那种。一旦舱内气温过高……你不敢想象。",99,"survival/buiding/v3a1_survival_zaiju3.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"打招呼#离开",0,71,"1#2#3#4#5#6","",0,0,"","","4",15,""],
        [307022301,"一人读书会",3070223,"","","这是一场原本只有一人的读书会，但他声称自己只是出于无聊才来这里。你们都不算外向，尴尬的寒暄过后，你决定和他一起执行读书会的程序。你拿出最近十分喜爱的一本书向他介绍起来——",99,"survival/roles/prefab/npc_sm_guizu_c.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"这本书的作者才华横溢#离开",0,71,"1#2#3#4#5#6","",0,0,"","","4",15,""],
        [307022401,"毫米级修改",3070224,"","","这是我在这里的第六十三年。",99,"survival/roles/prefab/role_sm_npc_xiaozhenjumin.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"……什么？可你看起来很年轻#离开",0,71,"1#2#3#4#5#6","",0,0,"","","4",15,""],
        [307022501,"《走近神秘学》",3070225,"","","你坐在拉普拉斯电台狭小的录音间里，红色的“ON AIR”灯亮着——至少看起来是亮着的。",99,"survival/buiding/v3a1_survival_terrain_lapulasi_02.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"开始录制#离开",0,71,"1#2#3#4#5#6","",0,0,"","","5",15,""],
        [307022601,"“沟通的艺术”",3070226,"","","你路过拉普拉斯休闲区，听到几个同事正在大声争执。\n起因十分简单，价值200雨滴的药剂样品被某人误食了。",99,"survival/buiding/v3a1_survival_yindi.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"旁观#离开",0,71,"1#2#3#4#5#6","",0,0,"","","5",15,""],
        [307022701,"哼喱八世",3070227,"","","一只肥嘟嘟的卡邦克鲁邀请你上桌吃饭，桌上摆着一千道美食。",99,"survival/roles/prefab/monster_elite_hulimojing_b.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"打招呼#离开",0,71,"1#2#3#4#5#6","",0,0,"","","5",15,""],
        [307022801,"修女和七个小矮人",3070228,"","","一位修女，正在放声高歌。",99,"survival/roles/prefab/role_sm_npc_laoniannvpu.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"打招呼#离开",0,71,"1#2#3#4#5#6","",0,0,"","","5",15,""],
        [307022901,"豢养地球",3070229,"","","你发现了一个生态缸，里面安静地躺着两颗白色的卵。\n缸里死气沉沉，应该是被人废弃的生态缸。",99,"survival/buiding/v3a5_survival_building_zuoriliunian.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",2,"我最喜欢抢救生态缸了#公务繁忙，先走一步",0,71,"1#2#3#4#5#6","",0,0,"","","5",15,""],
        [307023001,"保密协议",3070230,"","","你来到了一处研究所，这里似乎是一个高度保密的地方。高大的白色围墙，严格驻守的安保人员，以及随处可见的探头和铁丝网——在这野外格外显眼，以彰显它的保密程度之高。",99,"survival/buiding/v3a1_survival_fangzi_6.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",2,"进入查看#离开",0,71,"1#2#3#4#5#6","",0,0,"","","5",15,""],
        [307023101,"缺脚高脚椅",3070231,"","","你不明白，到底是什么样的人会穿着西装，端来一张高脚椅，笔直地坐在海边看书？而且据你观察，二十五分钟过去，他的眼神空洞，书也根本没有翻页。",99,"survival/roles/prefab/npc_sm_guizu_b.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"嘿！你是有什么烦心事吗？#离开",0,71,"1#2#3#4#5#6","",0,0,"","","6",15,""],
        [307023201,"“摇滚精神”",3070232,"","","眼前这人正随着音乐摇摆着身子。",99,"survival/roles/prefab/role_protagonist_wajueyishu.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"上前搭话#离开",0,71,"1#2#3#4#5#6","",0,0,"","","6",15,""],
        [307023301,"舞蹈贝斯手",3070233,"","","他身边立着一把四弦乐器，但他却在认真学习如何倒立跳舞。",99,"survival/roles/prefab/npc_sm_liulanghan.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"等等！你这是在做什么？#离开",0,71,"1#2#3#4#5#6","",0,0,"","","6",15,""],
        [307023401,"金牌唱片销售员",3070234,"","","小姐，看你的样子，你应该也是个音乐艺术家，至少也是个音乐爱好者！",99,"survival/roles/prefab/npc_sm_guizu_b.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"的确！你知道摇滚海盗电台吗？#离开",0,71,"1#2#3#4#5#6","",0,0,"","","6",15,""],
        [307023501,"音乐展演空间",3070235,"","","我们的酒水咖啡……十万火急，十万火急……啊啊，今晚的演出可怎么办啊！",99,"survival/roles/prefab/role_sm_npc_shibing_b.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"发生什么事了？#离开",0,71,"1#2#3#4#5#6","",0,0,"","","6",15,""],
        [307023601,"砸琴高手",3070236,"","","我的梦想是带二十把吉他，找一个有篝火燃烧的空地，然后我弹一首曲子，砸一把吉他，等到二十首曲子弹完，我的人生就完满了。我是说，每个喜欢摇滚的人都应该有一个这样的梦想。",99,"survival/roles/prefab/role_sm_npc_shibing_a.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",0,"和我详细讲讲？#离开",0,71,"1#2#3#4#5#6","",0,0,"","","6",15,""]
