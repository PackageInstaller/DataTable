        [307011601,"点金池",3070116,"","","你走到了一个池塘边。\n池水清澈见底，底部有很多黄金雕像。",99,"survival/buiding/v2a8_survival_buidling_hzjl.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",2,"丢块石头#有点诡异",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
        [307011701,"谋杀那头猪",3070117,"","","你来到了一个牧棚，遇见一只会写字的蜘蛛。\n她在蛛网上写着：你好。",99,"survival/buiding/v2a8_survival_buidling_sufubi.prefab","survival/buiding/v3a1_survival_zaiju6_2.prefab","","1",2,"你好！#对别人说吧",0,71,"1#2#3#4#5#6","",0,0,"","","",15,""],
