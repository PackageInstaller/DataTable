        [30003,1,"talk","-267#310","312601","“……我方已成功协助镇压各地工人起义……”",0],
        [30003,2,"talk","-267#310","312601","“……求和派已处于全面控制之下……”",0],
        [30003,3,"talk","-267#310","312601","“……‘战争疗法’取得明显成效……神秘术与军事力量的结合……”",0],
        [30003,4,"talk","-267#310","312601","“前线士兵将以更加高昂的面目，配备更充足的火力回到战场……”",0],
        [30003,5,"talk","-267#310","312601","“……人类的王储重新拥有了继续战争的信心……”",0],
        [30003,6,"talk","-267#310","312614","他们对敌国的渗透已经那么深了……",0],
        [30003,7,"talk","-267#310","312614","这群该死的战争疯子！",0],
        [30003,8,"talk","-267#310","312614","决不能让他们得逞。",0],
        [30004,1,"talk","-267#310","526201","……你杀了我们也是无济于事。",0],
        [30004,2,"talk","-267#310","526201","你的同胞之中，渴望战争的狂热分子可不在少数。",0],
        [30004,3,"talk","-267#310","526201","他们从来没有放弃过瓦解敌国的野心。",0],
        [30004,4,"talk","-267#310","312601","……！",0],
        [30004,5,"talk","-267#310","312601","在卡罗卢斯河前线时，有位战友曾说过类似的话……",0],
        [30004,6,"talk","-267#310","526201","而我们做的，不过是给予他们些许暗示……",0],
        [30004,7,"talk","-267#310","526201","他们便自然地选择了交出理智。",0],
        [30004,8,"talk","-267#310","526201","你的长官也不是例外，我们早已达成合作——",0],
        [30004,9,"talk","-267#310","526201","和谈必然破裂，停战只是你的妄想。",0],
        [30004,10,"talk","-267#310","312614","你在撒谎！这绝不可能！",0],
        [30005,1,"talk","-267#310","312614","“……高级军事顾问已到达克洛泰尔营地……”",0],
        [30005,2,"talk","-267#310","312614","“……续战计划已获批准，合作达成……”",0],
