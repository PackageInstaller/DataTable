        [30001,3,"talk","-267#310","312601","弗朗瓦索……！",0],
        [30001,4,"talk","-267#310","562502","天呐……我的腿……我感受不到我的腿了……咳咳！",0],
        [30001,5,"talk","-267#310","312611","弗朗瓦索，再坚持一下！",0],
        [30001,6,"talk","-267#310","312611","我会把你带回营地的！我发誓！",0],
        [30001,7,"talk","-267#310","562502","啊……妈……妈妈……我想回家……",0],
        [30001,8,"talk","-267#310","312611","……！",0],
        [30001,9,"talk","-267#310","312611","神啊……",0],
        [30001,10,"talk","-267#310","312611","请您赐予我们庇护，不要抛下您的子民……",0],
        [30002,1,"talk","-267#310","519510","站住！",0],
        [30002,2,"talk","-267#310","519510","战场生活难道只教会了你成为逃兵吗！",0],
        [30002,3,"talk","-267#310","312614","我不能就这么死在这里……",0],
        [30002,4,"talk","-267#310","312614","我得回家！",0],
        [30002,5,"talk","-267#310","519510","可耻的逃兵！",0],
        [30006,1,"talk","-267#310","312615","你……怎么不开枪？",0],
        [30006,2,"talk","-267#310","527101","拿上这把枪，士兵。",0],
        [30006,3,"talk","-267#310","527101","神秘学家不该被人类丑恶的战争损耗。",0],
        [30006,4,"talk","-267#310","527101","在你身上，还有更伟大的使命需要承担。",0],
