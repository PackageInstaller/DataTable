        [305001,1,"talk","462#236","635101","什么也看不出来……艾吉奥，恐怕得借用一下你那双锐利的、能穿透一切的眼睛了。",0],
        [305001,2,"talk","462#236","312313","……",0],
        [305001,3,"talk","462#236","312313","交给我吧。",0],
        [305002,1,"talk","462#236","302804","咦，这小人有些似曾相识……",0],
        [305002,2,"talk","462#236","635101","和壁画上的一样！故事变得有趣起来了……快翻开下一页看看。",0],
        [305002,3,"talk","462#236","635001","好耶，苏芙比也想看！",0],
        [305002,4,"talk","462#236","312313","稍等。",0],
        [305003,1,"talk","462#236","635001","哇哦，抓住你了～！",0],
        [305003,2,"talk","462#236","635101","这些线条和色块的组合很眼熟，会是谁的风格呢……",0],
        [305004,1,"talk","462#236","635101","看到这些线条了吗？如果我们沿着它们缩小远处的物体，放大近处的物体，就能创造出一种真实的空间感！",0],
        [305004,2,"talk","462#236","635001","哇哦～",0],
        [305004,3,"talk","462#236","635101","接下来试着延长它们，看看能得到什么吧。",0],
        [305005,1,"talk","462#236","635101","没错。我们又叫它punto di fuga，也就是消失点。所有的线条都从它出发，或者汇聚于此。",0],
        [305005,2,"talk","462#236","635101","这幅画中可不止一个消失点，试着找找看其他的吧！",0],
        [305006,1,"talk","462#236","312313","告诉我你们的需要吧，我能看清那些线条。",0],
        [305006,2,"talk","462#236","300101","我们需要你帮忙找出那些透视线，艾吉奥先生。",0],
        [305006,3,"talk","462#236","300101","将它们向后延长，直到它们在“消隐的终点”——也就是消失点再度相遇。",0],
        [305007,1,"talk","462#236","312313","现在我们获得了四个消失点。",0],
        [305007,2,"talk","462#236","300101","接下来，我们需要将这些消失点两两连接起来，获得两条线。",0],
        [305007,3,"talk","462#236","300101","两条线在空白墙面上交叉的交点，就是……",0],
        [305007,4,"talk","462#236","302804","“在夕光中交融”！",0],
        [305007,5,"talk","462#236","300101","也是最后的答案。",0],
        [305008,1,"talk","462#236","312313","哦，唯一的交点。下一步我们应该做什么？",0],
        [305008,2,"talk","462#236","302804","维尔汀小姐之前似乎说过，需要将APPLe某放在交点的位置……",0],
        [305008,3,"talk","462#236","300101","没错。",0],
        [310001,1,"talk","440#276","566001","“感谢您，讣告人小姐。”",0],
        [310002,1,"talk","440#276","566001","“嘿！讣告人小姐，咱们要去的地方是<b>我的故乡！</b>”",0],
