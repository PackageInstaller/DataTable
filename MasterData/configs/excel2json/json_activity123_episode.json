        [11811,2,5,1801109,90,"cover_2_2","cover_2_2","自此处启程","无休止的喧闹与斗争\n自此处启程\n奔向朝思暮想之处\n奔向命运渊薮之处\n奔向线与线交汇之处","","","","",0],
        [11811,3,1,1801110,105,"cover_3_3","cover_3_3","海洋爬行类","它们历经千载，从萨满雕像演变为两栖神秘生物。\n品尝过哺乳动物那鲜活跳动的心脏后，它们便不再青睐于寻常鱼类了。","","","","",0],
        [11811,3,2,1801111,105,"cover_3_4","cover_3_4","游离者信物","它的主人在追逐猎物时走得太远，于是被困于生者与死者的边界。\n特别忠告：当看见双眼通红的任何生物时，请立刻远离。","","","","",0],
        [11811,3,3,1801112,105,"cover_3_5","cover_3_5","犬类脱毛期","脱落自巴芬岛的犬类恶灵。\n那巨大的身躯形如幻影，因受大地的诅咒而永无目的地徘徊着。","","","","",0],
        [11811,3,4,1801113,105,"cover_3_2","cover_3_2","探照帽","灯光随着工人们的动作交错闪烁着。他们一同抬头，光束便一同汇聚于前方。\n矿道照亮了，隘口照亮了，连着前方的道路一并照亮了。","","","","",0],
        [11811,3,5,1801114,105,"cover_3_1","cover_3_1","金丝雀拍档","小巧的拍档，珍贵的朋友；\n金色的啼鸣，第一声啼哭。","","","","",0],
        [11811,4,1,1801115,121,"cover_4_4","cover_4_4","原始的幻想","朋友，保有幻想是件好事，而刨根问底则对你绝无好处。","","","","",0],
        [11811,4,2,1801116,121,"cover_4_5","cover_4_5","幽灵船的真相","别问了——别问我那些船员去哪儿了。\n堵上耳朵，然后抓紧滚蛋——别怪我没提醒你！","","","","",0],
        [11811,4,3,1801117,121,"cover_4_3","cover_4_3","隐秘的罪恶","罗曼艺术的显著表现，邪恶形象的典型象征。","","","","",0],
        [11811,4,4,1801118,121,"cover_4_6","cover_4_6","花蜜水果篮","花香四溢哟，蜜糖柔情哟！\n醉在梦乡呵，葬身水乡呵！","","","","",0],
        [11811,4,5,1801119,121,"cover_4_2","cover_4_2","《鲁萨尔卡》","“她妩媚动人，一身洁白；\n她唤着僧人，柔情地呻吟。\n然后，没入透明的波浪，\n一切复又归于深深的宁静。”","","","","",0],
