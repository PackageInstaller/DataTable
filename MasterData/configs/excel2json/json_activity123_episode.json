        [11811,1,4,1801104,75,"cover_1_1","cover_1_1","巴扬，巴扬","巴扬，巴扬，你向谁歌唱？\n向郊外的群山歌唱，\n向勇敢的战士歌唱，\n向广袤的未来歌唱……","","","","1#2#3#4#9#10",0],
        [11811,2,1,1801105,90,"cover_2_1","cover_2_1","尘土飞扬时","人们愿意再次倾以注视之光吗？没人知道答案。","","","","",0],
