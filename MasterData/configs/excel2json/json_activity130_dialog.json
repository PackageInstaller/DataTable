[
    "activity130_dialog",
    [
        [14111,1,"tips","","",0,"","让参与者择选图形"],
        [14112,1,"tips","","",0,"","说明谜题的内容"],
        [14113,1,"tips","","",0,"","告知参与者对应的步骤"],
        [14114,1,"tips","","",0,"","说明自己对应的步骤"],
        [14115,1,"tips","","",0,"","准备就绪，尝试解题"],
        [14121,1,"talk","306601#610011148","",0,"37","我们需要按照题目的要求来模拟推演过程。就像这道题，经过一个白天，一个夜晚，然后就到了新的一天。"],
        [14122,1,"talk","306601#610011145","",0,"37","其中的关键在于时间的顺序，这只蜗牛总是白天向上爬，晚上才向下坠。"],
        [14131,1,"talk","307901#6207914","",0,"6","361……362……"],
        [14132,1,"talk","508314#610011667","",0,"苏菲亚","或许我会发现研究这些游戏的必要性……"],
        [14132,2,"talk","510801#610011629","",0,"负责记录的教众","应该没有遗漏什么内容吧？不行，得再检查一次……37说得太快了……"],
        [14132,3,"talk","511801#610011684","",0,"活泼的孩子","我就说37也会对游戏感兴趣！"],
        [14132,4,"talk","511801#610011683","",0,"活泼的孩子","也许下次可以邀请她来堆沙堡，她一定能想出更稳定，更不容易被海水冲垮的结构！"],
        [14101,1,"talk","306610#610011166","",0,"37","那么——我们首先来挑选各自的图形！从我左手边开始，大家挨个儿选择。"],
        [14101,2,"dialog","","",0,"","她把笔记本高高举起，展示给周围等候指示的众人。"],
        [14101,3,"talk","510701#610011618","",0,"积极的教众","从这七个几何图形里选一个，我想……那我按顺序选好了。"],
        [14101,4,"talk","510701#0","",0,"积极的教众","单子，万物的始基，一切都从它发源。我愿择选这一符号，以表示对无限定者的敬意。"],
        [14101,5,"talk","306601#610011151","",0,"37","噢，你说得对。我喜欢它的统一与普遍性。"],
        [14101,6,"talk","510801#610011628","",0,"灵巧的教众","我选择这条线段。由两点连接成，既是融合也是分裂，有无数的可能。"],
        [14101,7,"talk","306610#610011157","",0,"37","没问题，你提出的这点也很有趣。"],
        [14101,8,"talk","306601#610011150","",0,"37","还需要一个图形，一，二，三……嗯，我要这个。"],
        [14101,9,"talk","306610#610011152","",0,"37","在星形里藏着漂亮的黄金分割比，所以它还不错。"],
        [14101,10,"talk","306601#610011147","",0,"37","很好，现在我们可以立刻开始推演……"],
        [14102,1,"talk","306613#610011169","",0,"37","唔……笔记本上的第一题是：“有一口8米深的井，一只小蜗牛从井底往上爬，白天能爬3米，晚上下坠2米。”"],
        [14102,2,"talk","306613#0","",0,"37","“这只蜗牛需要几天才能从井里爬出来？”"],
        [14102,3,"talk","306610#6206604","",0,"37","题目内容就是这样。有人没听清吗？我可以再念一次！"],
        [14102,4,"dialog","","",0,"","众人十分默契地摇了摇头。"],
        [14102,5,"talk","306601#610011151","",0,"37","游戏很简单，我们只需要按正确的顺序排好队，像这样表示题目的推演过程。"],
        [14103,1,"talk","306601#610011145","",0,"37","单子代表的推演步骤是“爬升3米”。"],
        [14103,2,"talk","510712#610011619","",0,"积极的教众","好的。"],
        [14104,1,"talk","306601#610011168","",0,"37","线段代表的推演步骤是“下坠2米”。"],
        [14104,2,"talk","510801#610011627","",0,"灵巧的教众","我记住了。"],
        [14105,1,"talk","306601#610011148","",0,"37","最后是五芒星，代表的推演步骤是“增加一天”。"],
        [14105,2,"talk","306610#610011152","",0,"37","我想这样就完全没问题了……"],
        [14211,1,"tips","","",0,"","说明谜题的内容"],
        [14212,1,"tips","","",0,"","邀请苏菲亚挑选图形"],
        [14213,1,"tips","","",0,"","让其他参与者做好游戏准备"],
        [14214,1,"tips","","",0,"","自行确认最后的步骤"],
        [14215,1,"tips","","",0,"","准备就绪，尝试解题"],
        [14221,1,"talk","306601#610011148","",0,"37","应该还可以带回更多的葡萄……只要黑色小毛球没有背着葡萄，前进时就不会吃掉它们！我应该多考虑放下葡萄和返回起点这两步。"],
        [14222,1,"talk","306601#610011145","",0,"37","一次搬运6颗，那么必须在某处放下葡萄，想办法保证两次就能搬完。放下葡萄的位置非常关键……"],
        [14231,1,"talk","511801#610011685","",0,"活泼的孩子","这群海鸥成天停在礁石上听大家讨论，它们也算学派的一员吗？"],
        [14231,2,"talk","510801#610011627","",0,"负责记录的教众","为什么不呢，孩子？如果它懂得四则运算，我敢说它要比许多刚接受授课的孩子更擅长数学。"],
        [14201,1,"talk","306601#610011153","",0,"37","第二题是：“一只头上顶着漂亮几何体的毛球找到12枚葡萄，打算把它们运回6米外的岩洞。”"],
        [14201,2,"talk","306601#0","",0,"37","“毛球每次最多能背走6颗葡萄，但每前进3米就会吃掉3颗，最多能带回几颗？”"],
        [14201,3,"dialog","","",0,"","37逐字逐句地念完了题目，将期待的目光投向苏菲亚。"],
        [14202,1,"talk","306610#610011143","",0,"37","你刚才的确答应了要来玩儿，对吗？"],
        [14202,2,"talk","508314#610011659","",0,"苏菲亚","当然，我并不是随口说的。"],
        [14202,3,"dialog","","",0,"","除错师无奈地再次向37确认——她会留下来参与其中。"],
        [14202,4,"talk","306601#610011151","",0,"37","那你可以瞧瞧我手上的笔记本，从这些图形中间挑一个让你满意的！"],
        [14202,5,"talk","508301#610011668","",0,"苏菲亚","我会仔细考虑。有你认为比较好的选择吗？"],
        [14202,6,"talk","306610#610011169","",0,"37","如果让我推荐的话，我会说这个矩形很合适。"],
        [14202,7,"talk","508313#610011661","",0,"苏菲亚","是因为“4”的含义吗？正义与秩序，的确很适合一位除错师。谢谢你，37，我想就是这个了。"],
        [14202,8,"talk","306612#6206609","",0,"37","嗯，我记得你曾做过关于它的证明。虽然没有留下多少印象……但应该有过这么回事。"],
        [14202,9,"talk","306601#610011148","",0,"37","不过在这道题中，矩形代表的是“返回葡萄堆”。"],
        [14202,10,"talk","508310#610011663","",0,"苏菲亚","……我明白了。"],
        [14202,11,"talk","306611#6206601","",0,"37","说起来，210走路的时候偶尔也会掉落葡萄……但我从来没见过那些毛球跟着他。"],
        [14202,12,"talk","306614#6206603","",0,"37","题目的描述不够严谨。"],
        [14202,13,"talk","508314#610011668","",0,"苏菲亚","也许是因为他总在高声说话，魔精们不敢靠近……"],
        [14203,1,"talk","510712#610011612","",0,"积极的教众","我猜猜，这次单子代表的步骤是前进3米，还是前进6米？"],
        [14203,2,"talk","306614#610011160","",0,"37","是“背起尽量多的葡萄”。"],
        [14203,3,"talk","510712#610011613","",0,"积极的教众","好吧，我只是随便猜了猜。"],
        [14204,1,"talk","306601#610011162","",0,"37","这次线段代表着“前进3米”。"],
        [14204,2,"talk","510801#610011629","",0,"灵巧的教众","好的。"],
        [14205,1,"talk","306615#610011171","",0,"37","还剩“放下所有葡萄”这个步骤，这一步属于五芒星。"],
        [14311,1,"tips","","",0,"","回答苏菲亚的询问"],
        [14312,1,"tips","","",0,"","让活泼的孩子择选图形"],
        [14313,1,"tips","","",0,"","说明谜题的内容"],
        [14314,1,"tips","","",0,"","把笔记本展示给参与者"],
        [14315,1,"tips","","",0,"","准备就绪，尝试解题"],
        [14321,1,"talk","306601#610011148","",0,"37","应当多注意每个图形的位置关系，检查最左、最右的图形与相邻图形的位置。"],
        [14322,1,"talk","306601#610011145","",0,"37","线段与五芒星的位置总在一块儿，而单子和矩形总是不相邻……"],
        [14331,1,"talk","510801#610011621","",0,"负责记录的教众","今天的晚餐会是烤兔肉吗？或者面包与橄榄…… "],
        [14331,2,"talk","510801#610011629","",0,"负责记录的教众","还是甜食更好，我该抽时间提出增加蜜糖采购量的需求…… "],
        [14301,1,"talk","508314#610011680","",0,"苏菲亚","所以，你得到想要的结果了吗，37？"],
        [14301,2,"talk","306612#6206612","",0,"37","唔……或许还要再做几道题，我才能发现其中普遍的规律！"],
        [14301,3,"talk","508310#610011667","",0,"苏菲亚","好吧，那我们抓紧时间。在晚餐前还来得及再做一题。"],
        [14301,4,"talk","306613#6206602","",0,"37","抓紧时间？噢噢，你说得对，苏菲亚！"],
        [14301,5,"dialog","","",0,"","她翻动着手中的笔记本，似乎有了新的想法。"],
        [14301,6,"talk","508310#610011681","",0,"苏菲亚","我很高兴你同意了这个提议。那就按上面写的，继续往下……"],
        [14301,7,"talk","306610#6206615","",0,"37","不不！我们不必反复验证同样的东西，一开始我只是缩减了数列前后的3，现在这儿还有两个重复的数字，3和4……嗯……"],
        [14301,8,"talk","306601#610011164","",0,"37","好了，再跳过些多余的内容，我相信我们很快就能把剩下的事儿弄清楚！"],
        [14301,9,"talk","306610#610011166","",0,"37","——还有谁想参与游戏？"],
        [14301,10,"dialog","","",0,"","等待许久的小男孩儿率先踏入了场地。"],
        [14302,1,"talk","511801#610011683","",0,"活泼的孩子","刚刚看大家玩儿的时候我就考虑好了，我想选择六边形。"],
        [14302,2,"talk","511801#0","",0,"活泼的孩子","因为它很完满，而且与我们的领袖一样拥有“6”这个数！"],
        [14302,3,"talk","306610#6206607","",0,"37","但他几乎从来不会参与这样的游戏。在这一点上，我更认可你的行为。"],
        [14302,4,"dialog","","",0,"","37点点头，对这位积极的小孩儿予以肯定。"],
        [14302,5,"talk","511801#610011685","",0,"活泼的孩子","……非常感谢！"],
        [14303,1,"talk","306601#610011153","",0,"37","这道题和之前的有些区别……"],
        [14303,2,"talk","306601#0","",0,"37","“根据描述，找出六边形排在第几位？”"],
        [14303,3,"talk","306601#610011145","",0,"37","我会把笔记本挨个拿给你们看，只要照着说出对应的次序就好啦。"],
        [14304,1,"talk","510712#610011615","",0,"积极的教众","我右侧没有图形，倒是有一大群人站在左边儿呢。"],
        [14305,1,"talk","510801#610011628","",0,"灵巧的教众","我的位置吗……噢，我瞧清楚了。排在我右侧的不止一个图形。"],
        [14306,1,"talk","508301#610011661","",0,"苏菲亚","和我左右相邻的两个图形中里没有单子。"],
        [14307,1,"talk","511801#610011684","",0,"活泼的孩子","我既不是最左的，也不是最右的。"],
        [14308,1,"talk","306601#610011169","",0,"37","轮到我自己了，站在我左侧的是线段。"],
        [14411,1,"tips","","",0,"","听取210的发言"],
        [14412,1,"tips","","",0,"","大声而坚定地说明谜题的内容"],
        [14413,1,"tips","","",0,"","等待210与参与者沟通"],
        [14415,1,"tips","","",0,"","准备就绪，尝试解题"],
        [14421,1,"talk","306601#610011148","",0,"37","这艘船太小了，只能运载一样东西，装不下第二样了。还是需要通过来回搬运解决问题……"],
        [14422,1,"talk","306601#610011145","",0,"37","一定有某种办法可以保证没有任何东西被吃掉。需要好好选择搬运货物的顺序……"],
        [14431,1,"talk","510712#610011614","",0,"自信的教众","我敢用这整整一堆海贝打赌，最后210会取胜！我承认37的天才，但她还是个孩子，难免也有想错的时候……"],
        [14431,2,"talk","511801#610011683","",0,"谨慎的教众","那我愿赌上同样一堆贝壳——再比你多一块。就赌37会赢，在从前的许多争论里她总是胜利者。"],
        [14432,1,"talk","510701#610011618","",0,"围观的教众","……"],
        [14432,2,"dialog","","",0,"","人群压低声音讨论着所见的事物。"],
        [14433,1,"talk","511801#610011684","",0,"机敏的孩子","真希望我能像210那样擅长演说，他看起来连路过的海鸥和岛上的树木都能说服！"],
        [14433,2,"talk","510712#610011618","",0," 和蔼的教众","我只希望你在做计算的时候认真些，别费心思去跟手里头的笔聊天儿……"],
        [14434,1,"talk","510801#610011629","",0,"负责记录的教众","这些修辞也需要原封不动地记下吗？我想我可以适当缩减些内容……"],
        [14434,2,"talk","511901#610011686","",0,"好奇的孩子","唔，这一页记录里的好词汇真多，我可以借来瞧瞧，写进日记本里吗？"],
        [14435,1,"talk","511801#610011685","",0,"围观的教众","……"],
        [14435,2,"dialog","","",0,"","海浪声几乎盖去了人们的低语。"],
        [14401,1,"talk","510612#610011191","",0,"210","参与游戏的人得选一个图形？那就这个三角形吧。"],
        [14401,2,"talk","510612#610011195","",0,"210","虽然我本有些好奇你为何没有挑选它，毕竟“3”完美而和谐，理应符合你的喜好。"],
        [14401,3,"talk","510613#610011202","",0,"210","但这枚星星确实和你相称，你终于承认自己是赫尔墨斯之星——"],
        [14401,4,"talk","306611#6206606","",0,"37","这两者之间有什么关系吗？"],
        [14401,5,"talk","306611#6206613","",0,"37","你总是把那些本质完全是两回事儿的东西相关联。"],
        [14401,6,"dialog","","",0,"","37显然还有更多能用于反驳的例子。她深深吸气，像附近礁石上昂首的海鸥那样挺起背脊，似乎做好了接着抛出大段论据的准备。"],
        [14401,7,"talk","508301#610011662","",0,"苏菲亚","好了，现在不是辩论的时候。"],
        [14401,8,"dialog","","",0,"","除错师及时地阻止了双方的辩驳，避免针锋相对的气氛再次蔓延开来。"],
        [14401,9,"talk","306614#610011155","",0,"37","苏菲亚说得对，我们不能忘掉重要的事情。"],
        [14401,10,"talk","510601#610011200","",0,"210","噢，我记着呢，儿童游戏。"],
        [14401,11,"talk","510613#610011195","",0,"210","开始吧，我们自然会从中看出谁说得更正确。"],
        [14402,1,"talk","306610#610011145","",0,"37","“一位商贩要将狼、羊、菜运过河，一次只能带一样。他不在时，狼会吃掉羊，羊会吃掉菜。那么，他最少运几次货物才能过河？”"],
        [14402,2,"talk","306601#610011148","",0,"37","这道题……"],
        [14402,3,"talk","510601#610011191","",0,"210","非常简单的一题。不出所料。"],
        [14402,4,"dialog","","",0,"","210迅速地接过了话头。"],
        [14402,5,"talk","510601#610011195","",0,"210","我来帮你一一分配那些步骤，怎么样？正好我打算认真体验游戏，你也可以稍作歇息。"],
        [14402,6,"talk","510613#610011192","",0,"210","哦，看来你不太需要后者。"],
        [14402,7,"dialog","","",0,"","从37身上确实瞧不出一点儿疲惫的模样。"],
        [14402,8,"dialog","","",0,"","她正高举着笔记本，试图让它与210的视线平齐。"],
        [14402,9,"talk","306614#610011151","",0,"37","我想这样就可以看得足够清楚，记得每个词都别落下。"],
        [14403,1,"talk","510613#610011199","",0,"210","从我自己开始比较妥当。三角形，代表“将狼装上船”。"],
        [14403,2,"talk","510612#610011192","",0,"210","接下来是单子，“将羊装上船”。"],
        [14403,3,"talk","510612#610011193","",0,"210","线段，“将菜装上船”。"],
        [14403,4,"dialog","","",0,"","他快速而简短地说出了几个对应的步骤。"],
        [14403,5,"talk","510601#610011197","",0,"210","该轮到我们的赫尔墨斯之星和除错师……"],
        [14403,6,"talk","511801#610011683","",0,"活泼的孩子","还有我，请记得我这儿——"],
        [14403,7,"talk","510610#610011203","",0,"210","正六边形，不错。那么你代表的是“卸下所有货物”。"],
        [14403,8,"talk","510613#610011191","",0,"210","最后——37，赫尔墨斯之星“将船划至右岸”，而苏菲亚，循规蹈矩的矩形，“将船划回左岸”。"],
        [14403,9,"talk","510612#610011198","",0,"210","请检验我是否有任何说错或遗漏的内容。"],
        [14403,10,"dialog","","",0,"","苏菲亚从37手中接过了笔记本，逐字逐句地阅读着。"],
        [14403,11,"dialog","","",0,"","经过除错师谨慎仔细的对照，答案是没有错误。"],
        [14403,12,"talk","510601#610011194","",0,"210","不必再多加耽搁，直接开始排序吧。"],
        [14404,1,"talk","510601#610011194","",0,"210","看样子，还是按照我说的三人一组会更加迅速，过程也会更有趣。"],
        [14404,2,"talk","510601#610011193","",0,"210","如果没有一点对抗的元素，怎么能使参与者提起兴致呢？"],
        [14404,3,"talk","510601#610011201","",0,"210","你多少应该考虑我说的话，37。"],
        [14404,4,"talk","306611#610011154","",0,"37","我当然考虑过了，首先——"],
        [14404,5,"dialog","","",0,"","争辩从不会因为一时的停歇而彻底中止，只会像一条鲨鱼潜在水下缓缓游动。"],
        [14404,6,"dialog","","",0,"","现在它又抓住了好时机，趁除错师望着水面出神的时候冒出背鳍。"],
        [14511,1,"tips","","",0,"","寻找最后的参与者"],
        [14512,1,"tips","","",0,"","等待苏菲亚念出最后一道题"],
        [14513,1,"tips","","",0,"","与其他人沟通，了解座位次序"],
        [14514,1,"tips","","",0,"","感谢苏菲亚的帮助"],
        [14515,1,"tips","","",0,"","准备就绪，尝试解题"],
        [14521,1,"talk","306601#610011148","",0,"37","先确定两组相距较远的图形和一组相邻的图形的位置，就能很快找出答案……"],
        [14522,1,"talk","306601#610011145","",0,"37","三角形和五芒星需要相隔尽可能远，单子和线段的距离相同……唔，确定最远的距离是解题的关键。"],
        [14531,1,"talk","510712#610011616","",0,"自信的教众","还要加注吗？只怕最后你要忙着在海滩上捡好几天贝壳。"],
        [14531,2,"talk","511801#610011683","",0,"谨慎的教众","我对自己的推演向来很有自信。再说，捡贝壳算什么要紧事？难道我会为了这点小事儿动摇——再加两枚，不能再多了！"],
        [14532,1,"talk","511801#610011684","",0,"机敏的孩子","哎呀，我刚才真不该走神——好机会全给错过了！"],
        [14532,2,"talk","510801#610011626","",0," 和蔼的教众","没关系，也许明天，后天，海滩上还会有人玩耍……"],
        [14533,1,"talk","510801#610011628","",0,"围观的教众","……"],
        [14533,2,"dialog","","",0,"","人群压低声音讨论着所见的事物。"],
        [14534,1,"talk","510801#610011629","",0,"负责记录的教众","……"],
        [14534,2,"dialog","","",0,"","记录员认真地写下一行行工整的字迹。"],
        [14501,1,"talk","306610#610011151","",0,"37","所有事儿就像我说的那样，并没有花多少时间。"],
        [14501,2,"talk","306610#610011152","",0,"37","只差一个图形……所以还需要一个愿意来玩游戏的人！"],
        [14501,3,"dialog","","",0,"","37转向围观的人群，挥舞着手臂朝他们发出邀请。"],
        [14501,4,"dialog","","",0,"","在一旁观看许久的小姑娘被她的朋友推了一把，走上前来。"],
        [14501,5,"talk","511901#610011686","",0,"好奇的孩子","我，我可以！我很早就想好了，最后这个七边形，我想选它。“7”是个独特的，受人尊重的好数字。"],
        [14501,6,"dialog","","",0,"","教众们纷纷点头赞同。这个数字令他们颇感熟悉。"],
        [14501,7,"talk","306601#610011144","",0,"37","作为一个质数，某种角度上它的确很独特。不过现在那不重要。好了，很快——很快就能知道答案。"],
        [14501,8,"dialog","","",0,"","七位参与者已经准备就绪。37偏了偏头，并不在意周围的讨论。"],
        [14501,9,"dialog","","",0,"","她并未从苏菲亚手上拿回那本笔记。"],
        [14501,10,"talk","306610#610011143","",0,"37","我们要一块儿完成游戏，所以这道题就交给你了，苏菲亚。"],
        [14501,11,"talk","508313#610011657","",0,"苏菲亚","……我来带领大家完成最后一题吗？"],
        [14501,12,"talk","306612#610011168","",0,"37","唔，我想不出这有任何问题。210刚才也没有出错。如果他能顺利完成，你当然也一样！"],
        [14501,13,"talk","508301#610011659","",0,"苏菲亚","好的……我会尽量注意别出岔子。"],
        [14502,1,"talk","508301#610011657","",0,"苏菲亚","这一题是……“依照次序安排所有人的座位，矩形会坐在第几位”？"],
        [14502,2,"talk","508314#610011663","",0,"苏菲亚","矩形吗？那得先确认我的次序。首先，矩形位于队列左半段，但不是最左侧的……"],
        [14503,1,"talk","510712#610011616","",0,"积极的教众","按照笔记本上写的……我和线段并不相邻。"],
        [14504,1,"talk","510801#610011621","",0,"灵巧的教众","我与单子的距离就像三角形与五芒星的距离一样。"],
        [14505,1,"talk","511801#610011684","",0,"活泼的孩子","我恰好坐在与七边形相邻的位置，可以一块玩耍！"],
        [14506,1,"talk","306610#6206604","",0,"37","三角形不在与我相邻的位置，唔，所以这是个安静的座位。"],
        [14507,1,"talk","510613#610011191","",0,"210","真不幸，我离赫尔墨斯之星的距离可算遥遥无际，五芒星几乎尽可能地远离了我。"],
        [14508,1,"talk","511901#610011687","",0,"好奇的孩子","嗯，我的座位在队列的正中央。"],
        [14509,1,"talk","306601#610011172","",0,"37","谢谢你，苏菲亚！我就知道你会做得很好！"],
        [14509,2,"talk","306610#610011157","",0,"37","只剩最后排序的部分了，不用担心，这也非常容易！"],
        [14509,3,"talk","508310#610011681","",0,"苏菲亚","能帮上你的忙就好。"],
        [14509,4,"dialog","","",0,"","除错师将笔记本递回37手中，观察着沙地上的方格。"],
        [14509,5,"talk","508310#610011667","",0,"苏菲亚","也许是这样……我先试一试。"],
