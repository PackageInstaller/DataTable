        [11509,1,0,"黑湖","湖面就像黑曜石铸成的镜子，云与雾都隐去了影子。水面之下是另一个世界，踏过那些易碎的薄冰，你将跨入冰与雪的国度。","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_2","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelbg_2",0,"","DSF-1",307302,307303,"1001|1002|1003","10301|10201|10101|10102","10301#1"],
        [11509,2,1,"登山者栖所","山腰处的一处聚集地。供登山客与探险家们歇脚。当暴雪降临，人们围坐在壁炉旁，望着屋外那座镶刻着名字的黑色大理石墙。这一刻，他们仿佛能与那些登山牺牲者们对谈。","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_3","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelbg_3",0,"黑湖抵达目标海拔","DSF-2",307304,307305,"2001|2002|2003","20301|20201|20101|20102","20301#1"],
        [11509,3,2,"山崖木屋","陡峭山崖边的一座木屋。似乎下一刻便会坠入深渊。最勇敢的登山者选择在此休憩，这将是登顶前的最后一站。","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_4","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelbg_4",0,"登山者栖所抵达目标海拔","DSF-3",0,307306,"3001|3002|3003","30301|30101|30102|30103","30301#1"],
        [11509,4,3,"山峰的号角","这段长久的旅程已临近终点。连绵的山脊如海面的波浪，远处似乎有号角声吹响，在迎接攀登的勇士，在迎接归家的旅人。","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelpic_1","singlebg/v1a5_aizila_singlebg/v1a5_aizila_levelbg_1",0,"山崖木屋抵达目标海拔","DSF-4",0,307307,"4001|4002|4003","40301|40201|40101|40102","40301#1"]
