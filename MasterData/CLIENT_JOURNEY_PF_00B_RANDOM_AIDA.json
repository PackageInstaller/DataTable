      ],
      "CameraOffset": "TWIN_7",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "무후훗…. 여기 계셨군요, 단장공.",
      "UnitTalk_JPN": "ムフフ…ここにいらっしゃりましたな、団長殿。",
      "TalkTime": 0.03
    },
    {
      "Uid": 94,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "메이드들에게 신고해야겠다.",
          "JumpAnchorStringId_JPN": "メイドに報告しないと。"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "잡상인이 들어왔어.",
          "JumpAnchorStringId_JPN": "ここに怪しい物売りがいるぞ。"
        }
      ]
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EVEN_ALCHEMY",
      "UnitNameString": [
        "SI_AIDA"
      ],
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "잡상인이라니요. 저는 어엿한 연금술사입니다.",
      "UnitTalk_JPN": "怪しい物売りですと？小生は立派な錬金術師ですが。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EVEN_ALCHEMY",
      "UnitNameString": [
        "SI_AIDA"
      ],
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "다만 학계의 얼간이들과는 상종하고 싶지 않다고나 할까요.",
      "UnitTalk_JPN": "ただ、学界の愚か者どもとは関わりたくないとでも言いましょうか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 95,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EVEN_ALCHEMY",
      "UnitNameString": [
        "SI_AIDA"
      ],
      "UnitTalk_KOR": "…랄까, 작금의 학계는 소생의 발상을 수용할 능력이 없는지라.",
      "UnitTalk_JPN": "…というよりも、近頃の学界は小生の発想を受け入れる能力がないようでしてな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 96,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "누가 봐도 본인이 기피 대상인 것 같은데…",
      "UnitTalk_JPN": "どう考えても、避けられてるのはアイーダの方だと思うけど…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EVEN_ALCHEMY",
      "UnitNameString": [
        "SI_AIDA"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "시시한 이야기는 여기까지.",
      "UnitTalk_JPN": "つまらぬ話はここまでにしましょう。",
