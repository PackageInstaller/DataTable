      "BgFadeOutTime": 0.7
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "갑자기 집에 같이 가자니… ",
      "UnitTalk_JPN": "いきなりキラの部屋に行こうだなんて…",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "단장… 키라 방에서 키라한테 무슨 짓을 할 생각이야…? ",
      "UnitTalk_JPN": "団長…キラの部屋で何をするつもりなの…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "무슨 짓을 당하더라도 키라, 준비됐으니까…!",
      "UnitTalk_JPN": "キラ、何されてもいいよ。心の準備はできてるの…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_JPN": "何をされてもキラ、準備はできてるんだから…！",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아무 짓도 안 해…!",
          "JumpAnchorStringId_JPN": "何もしないよ…！"
        }
      ]
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "으응…? 그럼 왜 오자고 한 거야? ",
      "UnitTalk_JPN": "うぅん？じゃあ、どうして？",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_JPN": "うん…？　じゃあ、どうして一緒に行こうって言ったの？ ",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "가정 방문 같은 거랄까. ",
          "JumpAnchorStringId_JPN": "家庭訪問みたいなものだ。"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "키라는 하루 종일 내 뒤만 졸졸 쫓아다니는 녀석이다. ",
      "UnitTalk_JPN": "キラは一日中私の後ろをついて回っている。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "혹여 기본적인 생활 환경을 망가뜨리면서까지 무리하게 붙어있는 건 아닐까. ",
      "UnitTalk_JPN": "最低限の生活まで放棄して、私について来ているのではないだろうか。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그런 걱정에서 확인하러 온 것뿐이다. ",
      "UnitTalk_JPN": "そんな心配から、確認しようと思っただけだった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "칫… 그런거야? ",
      "UnitTalk_JPN": "ちぇっ…なんだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "키라, 조금 실망했을지도. ",
      "UnitTalk_JPN": "キラ、ちょっとガッカリしちゃったかも。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 농담이지만! ",
      "UnitTalk_JPN": "あはは！冗談なの！",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "키라는 단장한테 실망 같은 거 안 하니까!",
      "UnitTalk_JPN": "キラは、団長にガッカリなんてしないもん！",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "그럼… 열게?  ",
      "UnitTalk_JPN": "じゃあ、開けるね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_HOTEL_2.png",
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_DOOR_OPEN_1.wav"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_TOUCH",
      "UnitTalk_KOR": "짜잔…! ",
      "UnitTalk_JPN": "じゃじゃーん…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "아하하! 키라의 방에 온 걸 환영해 단장. ",
      "UnitTalk_JPN": "あはは！キラの部屋へようこそ、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장, 키라의 방을 본 소감은 어때…? ",
      "UnitTalk_JPN": "キラの部屋を見た感想は…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "솔직히… 놀랐다. ",
      "UnitTalk_JPN": "正直…驚いた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "잘 정돈된 책상과 옷장, 침대에 가지런히 놓인 캐릭터 인형들. ",
      "UnitTalk_JPN": "きちんと整頓された机とクローゼットに、ベッドに並べられたぬいぐるみ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "…솔직히 우리집 보다 깔끔하다. ",
      "UnitTalk_JPN": "…正直、私の部屋より綺麗だ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_JPN": "…正直私の家より綺麗だ。 ",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "괜히 걱정했나…?",
          "JumpAnchorStringId_JPN": "余計な心配だったかな…？"
        }
      ]
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 뭐야 단장. ",
      "UnitTalk_JPN": "あはは。どうしたの、団長？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "혹시, 키라가 집을 엉망진창으로 해놓을 줄 알았던거야? ",
      "UnitTalk_JPN": "もしかして、キラの部屋がすっごく散らかってると思ってた？",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "그렇다면 틀렸네. ",
      "UnitTalk_JPN": "それなら、残念だね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "키라, 생각보다 집안일도 열심히 하는 걸. ",
      "UnitTalk_JPN": "キラ、意外と家事も頑張ってるの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "잡동사니 같은 것도 미리 정리해서 이렇게 박스에 넣어둔-",
      "UnitTalk_JPN": "細々したものは整理して、こうやって箱に入れて──",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "으응…? 택배가 왔었네? ",
      "UnitTalk_JPN": "あれ…？宅配便が届いてるね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "키라는 문 옆에 놓여 있던 종이 상자를 들어 올렸다. ",
      "UnitTalk_JPN": "キラは、ドアの横に置かれていた段ボールを持ち上げた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "뭘 시켰었더라… ",
      "UnitTalk_JPN": "何を注文したっけ…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": false,
      "WaitTime": 0.3,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_MOVEMENT_09.wav"
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "아, 새 마스크였구나? ",
      "UnitTalk_JPN": "あ、新しいマスクなの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "상자 안에는 키라가 늘 쓰고 다니는 검정색 마스크가 여러 장 들어 있었다. ",
      "UnitTalk_JPN": "箱の中には、キラがいつもつけている黒いマスクが何枚も入っていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_JPN": "箱の中にはキラがいつもつけている黒いマスクが数枚入っていた。 ",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "똑같은 마스크가 잔뜩…",
          "JumpAnchorStringId_JPN": "同じマスクがいっぱい…"
        }
      ]
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "…똑같다고? 그게 무슨 소리야? ",
      "UnitTalk_JPN": "同じ…？ぜんぜん違うの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "잘 봐봐. 전혀 똑같지 않아. ",
      "UnitTalk_JPN": "よく見て。ほら。違うよね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이건 귀에 거는 부분에 이렇게 빨간색 포인트가 있고… ",
      "UnitTalk_JPN": "これは、耳にかける部分に赤いポイントがあって…",
      "TalkTime": 0.03
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "이건 윗 부분이 고양이 귀 모양인걸.",
      "UnitTalk_JPN": "これは上の方が猫耳の形になってるの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "이런 걸 정말 몰랐단 말이야? ",
      "UnitTalk_JPN": "この違いが本当にわからなかったの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "단장, 키라한테 너무 관심 없는 거 아니야? ",
      "UnitTalk_JPN": "団長、キラに興味がなさすぎるよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "키라, 조금 서운할지도… ",
      "UnitTalk_JPN": "キラ、ちょっと悲しくなっちゃったかも…",
      "TalkTime": 0.03
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "키라는… 단장이 오늘 새로 산 양말을 신고 온 것도 알고 있는데…! ",
      "UnitTalk_JPN": "キラは…団長が買ったばっかりの靴下を履いてきたことだって知ってるのに！",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_JPN": "キラは…団長が今日買った新しい靴下を履いてるのも知ってるのに…！ ",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그런 건 몰라도 돼…!!!",
          "JumpAnchorStringId_JPN": "そんなこと知らなくていい…！！"
        }
      ]
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "그치만 키라는 단장에 대해 전부전부 알고 싶은 걸. ",
      "UnitTalk_JPN": "でも、キラは団長のすべてを知りたいの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "키라는 박스에 담긴 마스크를 꺼내 옷장 옆의 수납장에 차곡차곡 집어넣는다. ",
      "UnitTalk_JPN": "キラは箱の中からマスクを取り出し、クローゼットの横にある引き出しにしまった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "머리핀 같은 액세서리들이 가득 담긴 수납장이다. ",
      "UnitTalk_JPN": "その引き出しには、ヘアピンのようなアクセサリーがたくさん入っていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "키라는 마스크가 담긴 옆 칸을 열어 자연스럽게 뭔가를 집어넣는다. ",
      "UnitTalk_JPN": "キラはその横の引き出しを開けると、何かをしまった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그 물건은… ",
      "UnitTalk_JPN": "あれは…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_JPN": "それは… ",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "반창고…?",
          "JumpAnchorStringId_JPN": "絆創膏…？"
        }
      ]
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "키라가 무릎에 붙어있던 초록색 반창고를 떼어 수납장에 집어넣은 것이다.",
      "UnitTalk_JPN": "キラは膝に貼っていた緑の絆創膏を剥がし、引き出しにしまったのだった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "으응…? ",
      "UnitTalk_JPN": "うぅん…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아아- 아하하! 들켜버렸네. ",
      "UnitTalk_JPN": "ああ…あはは！バレちゃった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "이거, 내 액세서리. ",
      "UnitTalk_JPN": "これは、キラのアクセサリーなの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "붙였다 뗐다 할 수 있는 거야. ",
      "UnitTalk_JPN": "貼ったり剥がしたりできるんだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_JPN": "つけたり剥がしたりできるんだよ。 ",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "다쳐서 붙인 게 아니었구나? ",
          "JumpAnchorStringId_JPN": "怪我をしてる訳じゃなかったのか。"
        }
      ]
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "으응. 이건 뭐랄까… 습관 같은 거야. ",
      "UnitTalk_JPN": "うん。これは、なんて言うか…習慣みたいなものかな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "어렸을 때… 키라, 자주 다쳤었거든. ",
      "UnitTalk_JPN": "子どもの頃…キラ、よく怪我してたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그래서 항상 반창고를 달고 다녔어. ",
      "UnitTalk_JPN": "それでいつも絆創膏をしてたんだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "그게 습관이 된 건지, 뭔가 붙여야 마음이 조금 편해지거든.",
      "UnitTalk_JPN": "それが習慣になっちゃって、何かをつけてないと落ち着かないの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "단장, 키라한테 깜빡 속았지? ",
      "UnitTalk_JPN": "団長、キラに騙されちゃったね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "키라는 한방 먹였다는 듯 눈웃음을 짓는다. ",
      "UnitTalk_JPN": "キラは、してやったりという顔で微笑んだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "다행히도, 눈으로 확인한 키라의 생활은 생각했던 것 보다 훨씬 모범적이었다. ",
      "UnitTalk_JPN": "幸いなことに、キラは予想よりもずっと模範的な生活を送っていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "어쩌면 내가 키라를 오해한 것인지도 모르겠다. ",
      "UnitTalk_JPN": "キラのことを少し誤解していたようだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_JPN": "もしかしたら、私がキラを誤解していたのかもしれない。 ",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그럼, 이제 슬슬 돌아가 볼- ",
          "JumpAnchorStringId_JPN": "じゃあ、そろそろ帰ろ──"
        }
      ]
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "<color=#F7BE45>닫혀라</color>.",
      "UnitTalk_JPN": "<color=#F7BE45>閉まれ</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgCrash": 0.7,
      "BgCrashTime": 0.5,
      "StartFxSoundName": "SFX_BATTLE_COMMON_POP.wav"
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "어… 어어? 키라…?",
          "JumpAnchorStringId_JPN": "あれ…えっと…？キラ…？"
        }
      ]
    },
    {
      "Uid": 76,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_13.mp3",
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "아하하. 단장, 설마… ",
      "UnitTalk_JPN": "あはは。団長、まさか…",
      "TalkTime": 0.03
    },
    {
      "Uid": 77,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "키라의 방에 들어와 놓고 그렇게 벌써 돌아가버리려고 했던 거야…? ",
      "UnitTalk_JPN": "キラの部屋まで来ておいて、すぐに帰れるとでも思ったの…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 78,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "들어올 땐 단장 마음대로였겠지만… ",
      "UnitTalk_JPN": "入るのは勝手だけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "나갈 땐 단장 마음대로 못 나가. ",
      "UnitTalk_JPN": "出ていく時は、そうはいかないの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 80,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "마침 내일은 훈련이 없는 날이지? ",
      "UnitTalk_JPN": "ちょうど明日はお休みだしね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 81,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "오늘 단장은… 키라랑 밤새도록 노는 거야…!  ",
      "UnitTalk_JPN": "キラと団長は…朝まで遊ぶの…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 82,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "그렇게 정했어.",
      "UnitTalk_JPN": "そう決めたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 83,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_JPN": "そう決めた。",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "바, 밤새도록?!?",
          "JumpAnchorStringId_JPN": "あ、朝まで！？！"
        }
      ]
    },
    {
      "Uid": 84,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "무서운 눈을 한 키라가 한 걸음씩 다가온다.",
      "UnitTalk_JPN": "恐ろしい目をしたキラが、一歩ずつ近づいてくる。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 85,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "이리와 단장. ",
      "UnitTalk_JPN": "おいで、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 86,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "키라랑 같이 놀자…! ",
      "UnitTalk_JPN": "キラと一緒に遊ぼう…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 87,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MUTANT_MASK_03",
      "WaitClick": true,
      "WaitTime": 0.0,
