      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "둘이 아는 사이야? ",
          "JumpAnchorStringId_JPN": "知り合いだったの？ "
        }
      ]
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아아, 일하다 보면 종종 마주치거든요. ",
      "UnitTalk_JPN": "アンナさんとは、お仕事でお会いすることがあるんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "람파디스가 사건을 해결하고 범인을 잡으면… ",
      "UnitTalk_JPN": "ランパディスが事件を解決して、犯人を捕まえれば… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "치안국의 타운가드 분들에게 범인을 넘기죠.",
      "UnitTalk_JPN": "治安局のタウンガードの方に、犯人を引き渡しますから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "그러다 보니 자연스럽게 아는 사이에요. ",
      "UnitTalk_JPN": "それで、自然とお話するようになったんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "체포는 저희 전문이니까요! ",
      "UnitTalk_JPN": "逮捕はあたしたちの専門分野ですから！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffsetTime": "NR",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "안나, 저희 앞쪽 줄에 서 계셨던 거죠? 부럽다… ",
      "UnitTalk_JPN": "アンナさん、わたしたちより前に並んでいたのでしょう？羨ましいなぁ… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "부럽다뇨? 갑자기? ",
      "UnitTalk_JPN": "んん？羨ましいって？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "저희, 한정 메뉴를 구하려고 줄을 서있었거든요. ",
      "UnitTalk_JPN": "わたしたち、限定メニューが食べたくて並んでいたんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "그런데 딱 하나가 모자라서 못 살 것 같-",
      "UnitTalk_JPN": "でも、ちょうど売り切れて買えなー",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
