    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "릴리와 함께 <color=#F7BE45>스트릿 베이커스</color>의 한정 빵을 사기 위해 기다리던 중이었다. ",
      "UnitTalk_JPN": "リリーと共に<color=#F7BE45>ストリート・ベイカース</color>の限定パンを買うために、列に並んでいた時のことだった。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "후아… 단장님, 이제 진짜 곧이에요…!",
      "UnitTalk_JPN": "ふぁ～…団長さん、あと少しですね…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "저희 앞에 서 있는 사람이 이제 다섯 명 뿐이라구요!",
      "UnitTalk_JPN": "もう、前に5人しかいませんよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이렇게 줄을 설 정도인가…?",
          "JumpAnchorStringId_JPN": "こんなに並ぶほど美味しいの…？"
        }
      ]
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "ONE_9",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "아앗…! 단장님, 그건 단장님이 안 드셔 보셔서 할 수 있는 소리예요!",
      "UnitTalk_JPN": "ああっ…！それは、団長さんが食べたことがないから言えるセリフですよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "<color=#F7BE45>스트릿 베이커스</color>의 특별 한정 메뉴는, 다른 어디에서도 먹을 수 없는 빵이라구요…!",
      "UnitTalk_JPN": "<color=#F7BE45>ストリート・ベイカース</color>の特別限定メニューは、他のどこでも味わえないパンなんです…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "하루에 딱 221개만 굽는데도 오전이면 전부 다 팔려버릴 정도로 인기라니까요? ",
      "UnitTalk_JPN": "一日にたった221個しか販売されない上に、午前中にはぜんぶ売り切れちゃうほどなんですよ？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "아앗! 토끼 씨, 호들갑이 아니란 말이야…!",
      "UnitTalk_JPN": "もう、ウサギさん！本当なんですってば…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "TWIN_4",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "한입 베어 물면 느껴지는 바삭하게 구워진 겉면…!",
      "UnitTalk_JPN": "頬張った瞬間に感じる、カリッとした表面…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그리고 이어지는 촉촉하고 폭신한 안쪽…! ",
      "UnitTalk_JPN": "中は、しっとりふわふわで…！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "속을 채운 재료와 빵 본연의 고소한 맛이 입안에서 사르르…! ",
      "UnitTalk_JPN": "たっぷり詰められた具材と、パン本来の香ばしさが口の中でほどけて…！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "다들 한 번 맛보면 잊을 수 없어서 줄을 서서 먹는 빵이라구.",
      "UnitTalk_JPN": "一度食べると、忘れられない味なんです。それで、行列ができるという訳ですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "설령 알리시아 님이 오신다고 해도 줄을 서야 할 걸?",
      "UnitTalk_JPN": "たとえアリシア様が来られたとしても、列に並ばなきゃいけないはずですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "으음… 그 정도야?",
          "JumpAnchorStringId_JPN": "うーん…そんなに美味しいんだ。"
        }
      ]
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "에헤헤. 그럼요!",
      "UnitTalk_JPN": "えへへ。もちろんです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "단장님은 아직 한 번도 맛보지 못하셨으니까 공감하지 못하시는 거에요. ",
      "UnitTalk_JPN": "団長さんはまだ味わったことがないから、共感できないだけですよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "그러니까 이번 기회에-",
      "UnitTalk_JPN": "だから、今日を機会にー",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CREAM"
      ],
      "UnitTalk_KOR": "오늘 준비된 <color=#F7BE45>한정 메뉴</color>, 다섯 개 남았습니다!",
      "UnitTalk_JPN": "今日の<color=#F7BE45>限定メニュー</color>、残り5つでーす！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "에에…?! 크림, 진짜야? ",
      "UnitTalk_JPN": "ええっ…！？クリーム、本当なの？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "우리 앞에 서 있는 사람이 다섯 명인데…",
      "UnitTalk_JPN": "わたしたちの前に5人いるのに…",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CREAM"
      ],
      "UnitTalk_KOR": "아앗! 릴리 언니…! 기다리고 있었구나? ",
      "UnitTalk_JPN": "あっ、リリーお姉ちゃん…！並んでたんだね。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CREAM"
      ],
      "UnitTalk_KOR": "미안해… 진짜 딱 다섯 개 밖에 안 남았어. ",
      "UnitTalk_JPN": "ごめんね…もう本当に5つしか残ってないの。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
