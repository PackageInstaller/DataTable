      "Uid": 90,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "수갑이 있어야 할 자리에 도넛이 걸려 있는 거… 알고 계세요? ",
      "UnitTalk_JPN": "手錠があるべき場所に、ドーナツが掛かっているの…気づいていましたか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 91,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "수갑이 걸려있어야 할 안나의 허리춤에는 핑크색 시럽을 뿌린 도넛이 걸려있다.",
      "UnitTalk_JPN": "アンナの腰には、手錠の代わりにピンク色のシロップがかかったドーナツが掛かっていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 92,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "CameraOffset": "ONE_6",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "…?!",
      "UnitTalk_JPN": "…！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 93,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
