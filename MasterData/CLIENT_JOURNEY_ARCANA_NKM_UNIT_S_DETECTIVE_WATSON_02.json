      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "수갑은 빵 봉투에 들어있잖아…?!",
      "UnitTalk_JPN": "手錠はパンの袋に入ってるし…！！",
      "TalkTime": 0.03
    },
    {
      "Uid": 95,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "다, 단장님, 릴리… 이건 그러니까…",
      "UnitTalk_JPN": "え、えっと…これはつまり…",
      "TalkTime": 0.03
    },
