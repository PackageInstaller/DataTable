      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "아, 전 도넛 사러 온 거거든요. ",
      "UnitTalk_JPN": "あっ、あたしはドーナツを買いに来ただけですから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "한정 메뉴를 놔두고 도넛만 사신다구요…?",
      "UnitTalk_JPN": "限定メニューは買わずに、ドーナツだけを…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "도넛, 엄청 좋아하시나 봐요!",
      "UnitTalk_JPN": "ドーナツ、本当にお好きなんですね！",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "CameraOffset": "ONE_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "으음… 딱히 좋아하는 건 아니고…!",
      "UnitTalk_JPN": "うーん…好きっていうわけじゃないんだけど…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "그냥 도넛이 훨씬 간편하게 먹기 좋거든요. 달달해서 기운도 나고!",
      "UnitTalk_JPN": "ただ、ドーナツは気軽にパクッと食べられますから。甘くて元気も出ますし！",
      "TalkTime": 0.03
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "바쁜 순찰 와중에는 도넛 만한 게 없죠! ",
      "UnitTalk_JPN": "忙しいパトロールにピッタリなんですよっ！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "TWIN_5",
      "CameraOffsetTime": "NR",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "어… 정말요?",
      "UnitTalk_JPN": "えっと…それは本心ですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "으응? 정말이냐니, 뭐가요? ",
      "UnitTalk_JPN": "んん？どういう意味ですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "정말… 도넛 좋아하시는 거 아니구요?",
      "UnitTalk_JPN": "本当に…ドーナツが好きじゃないんですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "토끼 씨가 그러는데… 안나는 높은 확률로 도넛을 사랑한대요! ",
      "UnitTalk_JPN": "ウサギさんが…アンナさんは高い確率でドーナツを愛していると言っています！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "사… 사랑? 제가요? 도넛을? ",
      "UnitTalk_JPN": "あ…愛してる？あたしが、ドーナツを？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 77,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "ONE_7",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "옷깃에는 슈가 파우더가 묻은 흔적이 있고…",
      "UnitTalk_JPN": "襟にはシュガーパウダーがついてるし…",
      "TalkTime": 0.03
    },
    {
      "Uid": 78,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "소매에 묻은 얼룩, 끈적한 게 묻었다가 먼지가 달라붙은 거잖아요?",
      "UnitTalk_JPN": "袖のシミは、ベタベタしたものがついた上にホコリがくっついていますね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "색을 보면 도넛 필링일테구…",
      "UnitTalk_JPN": "色からして、ドーナツのコーティングでしょう…",
      "TalkTime": 0.03
    },
    {
      "Uid": 80,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "새로 세탁한 것 같은 제복에 이런 흔적이 보인다는 건! ",
      "UnitTalk_JPN": "洗濯したであろう制服に、このような痕跡が残っているということは！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 81,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "TWIN_5",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "오늘 아침에도 도넛을 드시고도 또 사러 올 정도로 좋아한단 뜻이죠. 에헤헤. ",
      "UnitTalk_JPN": "今朝ドーナツを食べたのに、また買いに来るほど好きだってことでしょう？えへへ。 ",
      "TalkTime": 0.03
    },
    {
