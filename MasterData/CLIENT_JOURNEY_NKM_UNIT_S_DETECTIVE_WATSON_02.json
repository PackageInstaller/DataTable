    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "여기가 바로 사무실이에요. ",
      "UnitTalk_JPN": "ここが事務所です。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "<color=#F7BE45>람파디스 수사 컨설팅</color>에 오신 걸 환영해요 단장님! ",
      "UnitTalk_JPN": "<color=#F7BE45>ランパディス捜査コンサルティング</color>へようこそ、団長さん！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitPos": "POS2",
      "UnitTalk_KOR": "으음? ",
      "UnitTalk_JPN": "おや？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitTalk_KOR": "어서오세요. <color=#F7BE45>람파디스 수사 컨설팅</color>의 그웬입니다.",
      "UnitTalk_JPN": "ようこそ。私は、<color=#F7BE45>ランパディス捜査コンサルティング</color>のグウェンと申します。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitTalk_KOR": "곤란한 사건이 있으신가요? ",
      "UnitTalk_JPN": "何かお困り事ですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "걱정 마시죠. 곧 진실을 밝혀드릴게요. ",
      "UnitTalk_JPN": "心配はご無用です。すぐに真実を解き明かしてみせましょう。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitTalk_KOR": "어? 릴리, 일찍 돌아왔네? ",
      "UnitTalk_JPN": "お？リリー、帰りが早かったな？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "마침 잘됐다. 여기 의뢰인분 모시고 자리로 가줄래? ",
      "UnitTalk_JPN": "ちょうどよかった。この依頼人の方を、応接室にお連れするのだ！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "에헤헤, 사장님. 그게 아니야.  ",
      "UnitTalk_JPN": "えへへ、社長さん。違うの。  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "…아니라니? ",
      "UnitTalk_JPN": "…違うとは？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "ONE_7",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이분은 <color=#F7BE45>여정 단장</color>님이거든! ",
      "UnitTalk_JPN": "この方は<color=#F7BE45>旅の団長</color>さんなんだよ！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "아쉽지만 의뢰인이 아니랍니다~!",
      "UnitTalk_JPN": "残念だけど、依頼人じゃないんだ～！",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "<color=#F7BE45>여정 단장</color>…? 아, 그 사람이 저 사람이야? ",
      "UnitTalk_JPN": "<color=#F7BE45>旅の団長</color>…？あぁ、この人がか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "그러고 보니 외형이… 소문으로 듣던 거랑 똑같네. ",
      "UnitTalk_JPN": "そういえば、この見た目…噂どおりだな。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…의뢰인?",
          "JumpAnchorStringId_JPN": "…依頼人って？"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "아아, 저희 <color=#F7BE45>람파디스</color>에서는 곤란한 사건에 휘말린 의뢰인들에게 일을 받고 있거든요. ",
      "UnitTalk_JPN": "あっ！わたしたち<color=#F7BE45>ランパディス</color>では、困った事件に巻き込まれてしまった人から依頼を受けているんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "곤란한 사건이라면…",
          "JumpAnchorStringId_JPN": "困った事件って…"
        }
      ]
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "말 그대로 곤란한 사건이에요! ",
      "UnitTalk_JPN": "言葉通り、困った事件です！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "갑자기 사람이 사라졌다거나, 물건이 없어졌다거나… ",
      "UnitTalk_JPN": "突然人が消えたとか、物がなくなったとか… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "누군가 다쳤는데 이유를 알 수 없다거나…!",
      "UnitTalk_JPN": "誰かが怪我したのに、原因不明だとか…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "NOA 치안국에서도 파악하기 어려운 사건들의 진상을 저희가 직접 수사해요. ",
      "UnitTalk_JPN": "NOA治安局でも掴めなかった事件の真相を、わたしたちが追っているんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "말하자면… 명탐정 H같은 탐정이라고도 할 수 있는 거죠…! ",
      "UnitTalk_JPN": "つまり…名探偵Hと同じ、探偵とも言えますよね…！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "릴리는 묘하게 상기된 얼굴로 눈을 반짝거렸다. ",
      "UnitTalk_JPN": "リリーは妙に興奮した面持ちで、目を輝かせた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "릴리, 내가 <color=#F7BE45>탐정</color>이라고 하지 말라고 했지?",
      "UnitTalk_JPN": "リリー。<color=#F7BE45>探偵</color>を名乗るなと言っただろう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아, 탐정이 아니라… <color=#F7BE45>민간 조사원</color>이라고 불러주세요.",
      "UnitTalk_JPN": "あっ、探偵じゃなくって…<color=#F7BE45>民間調査員</color>と呼んでください。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitTalk_KOR": "탐정 같은 수상쩍은 호칭을 붙이고 다니는 녀석들과 한통속으로 여겨지고 싶지 않으니까!",
      "UnitTalk_JPN": "探偵なんて胡散臭い連中と、一括りにされるのは心外だっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitTalk_KOR": "그건 그렇고 릴리… ",
      "UnitTalk_JPN": "それはそうとして、リリー… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "<color=#F7BE45>여정</color>에 참여하는 건 네 자유지만 멋대로 사무실에 데려와서 노는 건 안 돼.",
      "UnitTalk_JPN": "<color=#F7BE45>救援の旅</color>に参加するのは自由だが、許可もなく事務所に連れ込むのはご法度だぞ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitTalk_KOR": "사무실은 놀이터가 아니니까 말이야. ",
      "UnitTalk_JPN": "事務所は遊び場じゃないのだからな。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "토, 토끼 씨… 본인이나 잘하라니… ",
      "UnitTalk_JPN": "ウ、ウサギさん…自分こそちゃんとやれだなんて… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "…?!",
      "UnitTalk_JPN": "…！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "아무리 그래도 사장님한테 그런 식으로 말하면 어떡해. ",
      "UnitTalk_JPN": "いくら何でも、社長さんにそんなこと言っちゃダメです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "확실히… 사장님도 할 게 없을 땐 사무실에서 뒹굴거리는 게 보통이긴 하지만… ",
      "UnitTalk_JPN": "確かに…社長さんもヒマな時は、事務所でよくゴロゴロしていますが… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "으으으! 저, 저게…!",
      "UnitTalk_JPN": "んぐぐ！こ、こいつめ…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "야앗! 너 그냥 니가 하고 싶은 말 하는 거지! ",
      "UnitTalk_JPN": "おいっ、リリー！自分が言いたいことを言ってるだけだろう！ ",
      "TalkTime": 0.03
    },
    {
