      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "…………?!",
      "UnitTalk_JPN": "…………！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "모르고 따라왔구나…",
          "JumpAnchorStringId_JPN": "分かってなかったのか…"
        }
      ]
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_01",
      "WaitClick": true,
