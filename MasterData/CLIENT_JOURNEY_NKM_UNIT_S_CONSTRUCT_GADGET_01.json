      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "으으으음…",
      "UnitTalk_JPN": "うーーーん…",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "NR",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "으으으으으으으으음…!",
      "UnitTalk_JPN": "うーーーーーーん…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "DEFAULT",
