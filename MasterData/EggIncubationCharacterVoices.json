[
  {
    "Id": 26001,
    "EggIncubationCharacterId": 1,
    "MessageType": 1,
    "Message": "待っていたわ\n待っていたわよ、陛下",
    "VoiceAssetId": "kahal/uniq/26001",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26002,
    "EggIncubationCharacterId": 1,
    "MessageType": 1,
    "Message": "楽しい楽しいところでしょう？\nゆっくりしていって",
    "VoiceAssetId": "kahal/uniq/26002",
    "AnimationName": "03_stare"
  },
  {
    "Id": 26003,
    "EggIncubationCharacterId": 1,
    "MessageType": 1,
    "Message": "エッグ培養はバイオ屋の管轄\nそこの水槽だけはアズの管轄……\nというか趣味ね",
    "VoiceAssetId": "kahal/uniq/26003",
    "AnimationName": "02_smile"
  },
  {
    "Id": 26004,
    "EggIncubationCharacterId": 1,
    "MessageType": 1,
    "Message": "ようこそ陛下\n培養かしら？\nいいわよ、いつでも声をかけて",
    "VoiceAssetId": "kahal/uniq/26004",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26005,
    "EggIncubationCharacterId": 1,
    "MessageType": 1,
    "Message": "ん？知らない草が生えてる…\nまたラビリスが勝手に育ててるわね\nあとで研究データだけ貰ってこよう",
    "VoiceAssetId": "kahal/uniq/26005",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26006,
    "EggIncubationCharacterId": 1,
    "MessageType": 4,
    "Message": "培養ボックスは全て開いているわ\nいつでも培養可能よ\nいつでもね",
    "VoiceAssetId": "kahal/uniq/26006",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26007,
    "EggIncubationCharacterId": 1,
    "MessageType": 4,
    "Message": "培養準備はできているわ\nあとはあなた次第よ、陛下？",
    "VoiceAssetId": "kahal/uniq/26007",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26008,
    "EggIncubationCharacterId": 1,
    "MessageType": 4,
    "Message": "研究を手伝ってくれる約束、\n忘れてしまったわけではないでしょう？",
    "VoiceAssetId": "kahal/uniq/26008",
    "AnimationName": "03_stare"
  },
  {
    "Id": 26009,
    "EggIncubationCharacterId": 1,
    "MessageType": 5,
    "Message": "培養ボックスに空きが出たみたいね\nさぁ、次の培養をはじめましょう",
    "VoiceAssetId": "kahal/uniq/26009",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26010,
    "EggIncubationCharacterId": 1,
    "MessageType": 5,
    "Message": "はじめましょう、さぁはじめましょう！\n培養を！今までにないような培養を！",
    "VoiceAssetId": "kahal/uniq/26010",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26011,
    "EggIncubationCharacterId": 1,
    "MessageType": 5,
    "Message": "私を眺めてもエッグは育たないわ\n空いてる培養ボックスを使うのよ",
    "VoiceAssetId": "kahal/uniq/26011",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26012,
    "EggIncubationCharacterId": 1,
    "MessageType": 6,
    "Message": "あからさまに引かないで\n私だって傷つくわ",
    "VoiceAssetId": "kahal/uniq/26012",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26013,
    "EggIncubationCharacterId": 1,
    "MessageType": 6,
    "Message": "んっんっんっ、ぷふぅーー…\n培養器の確認は任せて",
    "VoiceAssetId": "kahal/uniq/26013",
    "AnimationName": "04_unique"
  },
  {
    "Id": 26014,
    "EggIncubationCharacterId": 1,
    "MessageType": 6,
    "Message": "私ばかり見ていないで、\n培養器のエッグたちを見て上げて",
    "VoiceAssetId": "kahal/uniq/26014",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26015,
    "EggIncubationCharacterId": 1,
    "MessageType": 7,
    "Message": "培養が完了したボックスがあるわ\n開けてみましょう",
    "VoiceAssetId": "kahal/uniq/26015",
    "AnimationName": "02_smile"
  },
  {
    "Id": 26016,
    "EggIncubationCharacterId": 1,
    "MessageType": 7,
    "Message": "私たちが協力しあった成果よ\n面白い成果がでているといいわね",
    "VoiceAssetId": "kahal/uniq/26016",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26017,
    "EggIncubationCharacterId": 1,
    "MessageType": 7,
    "Message": "陛下と、私の研究成果……",
    "VoiceAssetId": "kahal/uniq/26017",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26018,
    "EggIncubationCharacterId": 1,
    "MessageType": 1,
    "Message": "いわゆるキャンペーン実施中よ\nたまにはこういうこともあるわ",
    "VoiceAssetId": "kahal/uniq/26018",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26019,
    "EggIncubationCharacterId": 1,
    "MessageType": 1,
    "Message": "培養するなら今よ、陛下\nハリー\nハリー、ハリー、ハリー",
    "VoiceAssetId": "kahal/uniq/26019",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26020,
    "EggIncubationCharacterId": 1,
    "MessageType": 1,
    "Message": "培養をしない理由がわからない、\nわからないわ、全く\nそうでしょう？",
    "VoiceAssetId": "kahal/uniq/26020",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26021,
    "EggIncubationCharacterId": 1,
    "MessageType": 2,
    "Message": "んっ…!? はぁ、やめた方がいいわよ\n髪も肌もベトベトだから",
    "VoiceAssetId": "kahal/uniq/26021",
    "AnimationName": "05_unique"
  },
  {
    "Id": 26022,
    "EggIncubationCharacterId": 1,
    "MessageType": 2,
    "Message": "私を研究したい、というわけね\nその視点はなかったわ\nふむ……",
    "VoiceAssetId": "kahal/uniq/26022",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26023,
    "EggIncubationCharacterId": 1,
    "MessageType": 2,
    "Message": "私に興味があるの？\n好都合ね、私も陛下に興味があるわ…",
    "VoiceAssetId": "kahal/uniq/26023",
    "AnimationName": "02_smile"
  },
  {
    "Id": 26024,
    "EggIncubationCharacterId": 1,
    "MessageType": 17,
    "Message": "面白い、とても面白い結果…！",
    "VoiceAssetId": "kahal/uniq/26024",
    "AnimationName": "02_smile"
  },
  {
    "Id": 26025,
    "EggIncubationCharacterId": 1,
    "MessageType": 17,
    "Message": "なるほど、これは興味深いわね…！",
    "VoiceAssetId": "kahal/uniq/26025",
    "AnimationName": "03_stare"
  },
  {
    "Id": 26026,
    "EggIncubationCharacterId": 1,
    "MessageType": 17,
    "Message": "いいデータが取れたわ\nふふ…、ありがとう、陛下",
    "VoiceAssetId": "kahal/uniq/26026",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26027,
    "EggIncubationCharacterId": 1,
    "MessageType": 18,
    "Message": "意外とせっかちね\n最高\n価値観が合うのかも",
    "VoiceAssetId": "kahal/uniq/26027",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26028,
    "EggIncubationCharacterId": 1,
    "MessageType": 18,
    "Message": "そう、急いで\n生き急いで\n「できる限り」のさらに先へ",
    "VoiceAssetId": "kahal/uniq/26028",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26029,
    "EggIncubationCharacterId": 1,
    "MessageType": 18,
    "Message": "ここで高速を選択する陛下の考え…\nそれ自体に興味があるわ",
    "VoiceAssetId": "kahal/uniq/26029",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26030,
    "EggIncubationCharacterId": 1,
    "MessageType": 8,
    "Message": "培養よ、培養の時間よ陛下\n誰も見たことのない培養をしましょう",
    "VoiceAssetId": "kahal/uniq/26030",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26031,
    "EggIncubationCharacterId": 1,
    "MessageType": 8,
    "Message": "培養液を選択して\n好きなだけ、思うがままに、思ったとおりに",
    "VoiceAssetId": "kahal/uniq/26031",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26032,
    "EggIncubationCharacterId": 1,
    "MessageType": 8,
    "Message": "培養液の濃度によってエッグの成長結果は\n大きく、大きく変化するわ",
    "VoiceAssetId": "kahal/uniq/26032",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26033,
    "EggIncubationCharacterId": 1,
    "MessageType": 16,
    "Message": "いい子に、いい子に育つのよ\nふふふふ……",
    "VoiceAssetId": "kahal/uniq/26033",
    "AnimationName": "02_smile"
  },
  {
    "Id": 26034,
    "EggIncubationCharacterId": 1,
    "MessageType": 16,
    "Message": "ボックスを閉じるわ\nいってらっしゃい、私たちの卵",
    "VoiceAssetId": "kahal/uniq/26034",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26035,
    "EggIncubationCharacterId": 1,
    "MessageType": 16,
    "Message": "ボックス閉鎖完了、培養開始…\nこの子がどんなふうに育つのか、\n一体なにが生まれるのか\n楽しみね",
    "VoiceAssetId": "kahal/uniq/26035",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26036,
    "EggIncubationCharacterId": 1,
    "MessageType": 9,
    "Message": "任せてくれるの？ふふ",
    "VoiceAssetId": "kahal/uniq/26036",
    "AnimationName": "02_smile"
  },
  {
    "Id": 26037,
    "EggIncubationCharacterId": 1,
    "MessageType": 9,
    "Message": "私ならこうするわね\nどう？",
    "VoiceAssetId": "kahal/uniq/26037",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26038,
    "EggIncubationCharacterId": 1,
    "MessageType": 9,
    "Message": "例えば、これね",
    "VoiceAssetId": "kahal/uniq/26038",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26039,
    "EggIncubationCharacterId": 1,
    "MessageType": 10,
    "Message": "計画は白紙\n私もそれがいいと思ってたわ",
    "VoiceAssetId": "kahal/uniq/26039",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26040,
    "EggIncubationCharacterId": 1,
    "MessageType": 10,
    "Message": "やり直すのね\n付き合うわ",
    "VoiceAssetId": "kahal/uniq/26040",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26041,
    "EggIncubationCharacterId": 1,
    "MessageType": 10,
    "Message": "迷うわね…\nそれが醍醐味ね",
    "VoiceAssetId": "kahal/uniq/26041",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26042,
    "EggIncubationCharacterId": 1,
    "MessageType": 11,
    "Message": "エッグが反応を見せたわ",
    "VoiceAssetId": "kahal/uniq/26042",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26043,
    "EggIncubationCharacterId": 1,
    "MessageType": 11,
    "Message": "いい濃度に仕上がっているわね",
    "VoiceAssetId": "kahal/uniq/26043",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26044,
    "EggIncubationCharacterId": 1,
    "MessageType": 11,
    "Message": "うん、計算通り",
    "VoiceAssetId": "kahal/uniq/26044",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26045,
    "EggIncubationCharacterId": 1,
    "MessageType": 12,
    "Message": "いい！いいわ！\n面白い研究成果になりそうね…！",
    "VoiceAssetId": "kahal/uniq/26045",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26046,
    "EggIncubationCharacterId": 1,
    "MessageType": 12,
    "Message": "なかなか攻めるわね\n最高よ",
    "VoiceAssetId": "kahal/uniq/26046",
    "AnimationName": "02_smile"
  },
  {
    "Id": 26047,
    "EggIncubationCharacterId": 1,
    "MessageType": 12,
    "Message": "これだから培養はやめられない\nこの反応が待ち遠しい…！",
    "VoiceAssetId": "kahal/uniq/26047",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26048,
    "EggIncubationCharacterId": 1,
    "MessageType": 13,
    "Message": "この反応、この数値…！\n面白いことが起きそうね…！",
    "VoiceAssetId": "kahal/uniq/26048",
    "AnimationName": "07_unique"
  },
  {
    "Id": 26049,
    "EggIncubationCharacterId": 1,
    "MessageType": 13,
    "Message": "来たわね！なるほど、この輝き…\n震える、震えるわ…！",
    "VoiceAssetId": "kahal/uniq/26049",
    "AnimationName": "08_unique"
  },
  {
    "Id": 26050,
    "EggIncubationCharacterId": 1,
    "MessageType": 13,
    "Message": "記録OK、ログ…とれてる\n撮影も正常ね？さぁ、行きましょう陛下…",
    "VoiceAssetId": "kahal/uniq/26050",
    "AnimationName": "06_unique"
  },
  {
    "Id": 26051,
    "EggIncubationCharacterId": 1,
    "MessageType": 14,
    "Message": "あ、あぁぁ…",
    "VoiceAssetId": "kahal/uniq/26051",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26052,
    "EggIncubationCharacterId": 1,
    "MessageType": 14,
    "Message": "えっ？ そう…、残念ね……",
    "VoiceAssetId": "kahal/uniq/26052",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26053,
    "EggIncubationCharacterId": 1,
    "MessageType": 14,
    "Message": "おお…、そういう判断も、あるわね…",
    "VoiceAssetId": "kahal/uniq/26053",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26054,
    "EggIncubationCharacterId": 1,
    "MessageType": 15,
    "Message": "帰るのね？気をつけて",
    "VoiceAssetId": "kahal/uniq/26054",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26055,
    "EggIncubationCharacterId": 1,
    "MessageType": 15,
    "Message": "あ、…また",
    "VoiceAssetId": "kahal/uniq/26055",
    "AnimationName": "01_wait"
  },
  {
    "Id": 26056,
    "EggIncubationCharacterId": 1,
    "MessageType": 15,
    "Message": "………",
    "VoiceAssetId": "kahal/uniq/26056",
    "AnimationName": "01_wait"
  }
]