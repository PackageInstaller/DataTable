{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://rw.ledo.com/status",
  "title": "ServerList",
  "description": "server list for local",
  "type": "object",
  "properties": {
    "downloadurl": {
      "description": "download URL",
      "type": "string"
    },
    "intranet": {
      "description": "intranet server list",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sdkDomain": {
            "type": "string"
          },
          "sdkPort": {
            "type": "string"
          },
          "ipServerDomain": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "ipServerPort": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "ipServerDomain",
          "ipServerPort"
        ]
      }
    },
    "internet": {
      "description": "internet server list",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sdkDomain": {
            "type": "string"
          },
          "sdkPort": {
            "type": "string"
          },
          "ipServerDomain": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "ipServerPort": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "name",
          "ipServerDomain",
          "ipServerPort"
        ]
      }
    }
  },
  "required": [
    "intranet",
    "internet"
  ]
}
