    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "흐응~ 진짜 이 평가전만 이기면 끝이란 말이죠?",
      "UnitTalk_JPN": "ふ～ん。この試験に勝てば、終わりなんですよね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "으음… 마지막이라… 그렇구나…",
      "UnitTalk_JPN": "う～ん…最後…そっか…",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "긴장했어?",
          "JumpAnchorStringId_JPN": "緊張してるのか？"
        }
      ]
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후! 긴장이요?",
      "UnitTalk_JPN": "ふふ！まさか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "단장님, 제가 겨우 이 정도로 긴장할 거라 생각하세요?",
      "UnitTalk_JPN": "団長さん。私がこの程度のことで、緊張すると思いますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "평가전에 어떤 적이 나오든, 제가 질 리가 없잖아요?",
      "UnitTalk_JPN": "試験にどんな敵が出てきたとしても、私が負ける訳ないじゃないですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "그냥, 생각했던 것보다 시간이 더 빠르게 가는 것 같은 느낌 때문-",
      "UnitTalk_JPN": "ただ、思っていたよりも時の流れが早くて──",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.7,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_BOX_RATTLE.wav"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "…쿠쿠. 내가 이야기하고 있을 땐 얌전히 굴라고 했는-",
      "UnitTalk_JPN": "…クゥクゥ。私が話してる間は、大人しくしてなさいって──",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.7,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_BOX_RATTLE.wav"
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "너어… ",
      "UnitTalk_JPN": "クゥクゥ… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "꼭 말로 할 땐 안 듣는단 말이야. ",
      "UnitTalk_JPN": "まったく、口で言っても分からないんだから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": false,
      "WaitTime": 0.5,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_HIT_17.wav"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": false,
      "WaitTime": 0.5,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_HIT_17.wav"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_HIT_17.wav"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "리디아는 <color=#F7BE45>쿠쿠</color>를 들고 무심한 표정으로 바닥을 향해 내려쳤다. ",
      "UnitTalk_JPN": "リディアは<color=#F7BE45>クゥクゥ</color>を持つと、無表情で床へと投げつけた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "조용히 하라고 했지? ",
      "UnitTalk_JPN": "静かにしてなさいって言ったでしょ？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…",
          "JumpAnchorStringId_JPN": "…"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "휴우. 이제야 좀 조용히 구네. ",
      "UnitTalk_JPN": "ふぅ。少しは大人しくなったわね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "지난 번에 광산에서 먹었던 게 소화가 덜 돼서 그런가…?",
      "UnitTalk_JPN": "鉱山で食べたごはんを、まだ消化しきれてないからかな…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "가끔씩 저렇게 말을 안 듣더라구요. ",
      "UnitTalk_JPN": "たまに、こうして言うことを聞かない時があるんですよね～。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "아무튼, 1년간 수고하셨어요. 단장님. ",
      "UnitTalk_JPN": "とにかく、団長さん。一年間お疲れさまでした。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "덕분에 좋은 먹이도 많이 구했고… ",
      "UnitTalk_JPN": "おかげで、いい獲物も捕まえられましたし… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "뭣보다 나름, 즐거웠어요. ",
      "UnitTalk_JPN": "何より、楽しかったです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나도 마찬가지야.",
          "JumpAnchorStringId_JPN": "私もだよ。"
        }
      ]
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그 보답이랄 것 까진 없지만…",
      "UnitTalk_JPN": "そのお返しっていう訳ではないですけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "여정이 끝나고 나서도 제 힘이 필요한 상황이 있다면 편하게 연락하세요.",
      "UnitTalk_JPN": "旅が終わってからでも、私の力が必要な時はいつでも連絡してください。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "어차피 서부지대, 완전히 탈환하는 건 아직 한참 멀었을 테고. ",
      "UnitTalk_JPN": "西部を完全に奪還するのは、まだまだ先になりそうですから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "진짜 긴급할 때 정도라면 잠시 자리를 비우는 것도 불가능은 아닐 거에요.",
      "UnitTalk_JPN": "よほどの緊急事態なら…少しの間、西部を離れることだってできます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "겸사겸사 지루한 서부 생활에서 도망도 칠 수 있으니까 일석이조라는 느낌?",
      "UnitTalk_JPN": "ついでに、西部での退屈な暮らしからも逃げられますしね。一石二鳥です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "특히나, <color=#F7BE45>공허의 힘</color>이랑 관련된 일이 있다면 꼭 불러 달라구요.",
      "UnitTalk_JPN": "<color=#F7BE45>空虚の力</color>に関することなら、必ず呼んでくださいよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아마 그때쯤이면 저도 쿠쿠도 지금보다 훨씬 더 강해져 있을 테니까-",
      "UnitTalk_JPN": "その頃には、私もクゥクゥもずっと強くなってるはずです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "저번보다 훨씬 안전하게 삼켜버릴 수 있을 걸요?",
      "UnitTalk_JPN": "この前よりも、もっと安全に飲み込めると思いますよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그으래…?",
          "JumpAnchorStringId_JPN": "そ、そうか…？"
        }
      ]
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "또, 또 뭔가요 그 묘한 눈빛은?",
      "UnitTalk_JPN": "もぉ～。何なんですか、その妙な目つきは。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "후우… 착각할까 봐 미리 말씀드리는 거지만-",
      "UnitTalk_JPN": "ふぅ…誤解されないように前もって言っておきますけど──",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "말이 <color=#F7BE45>도와준다</color>는 거지 사실 제일 이득을 보는 건 저라구요.",
      "UnitTalk_JPN": "<color=#F7BE45>手伝う</color>って言っても、一番得をするのは私ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "쿠쿠에게 먹일 먹이도 찾고, 외출할 핑계도 찾고 또… ",
      "UnitTalk_JPN": "クゥクゥのごはんも見つかりますし、外出する口実もできます。それに… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "여정을 성공적으로 완주한 단장이라면 금방 NOA 중앙 정계에 영향력이 커질테니까-",
      "UnitTalk_JPN": "旅を成し遂げた団長さんなら、NOAの政界でも力を持つことになるでしょうし──",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "뭐 이런저런 이유 때문에 해본 말이니까요! ",
      "UnitTalk_JPN": "まぁ、色んな理由があって言っただけですから！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "제가 뭐, 그새 멍청하게 정이라도 들어서 아무 대가도 없이 도와줄 줄 알았나요?",
      "UnitTalk_JPN": "まさか…私も情が移って、見返りもなく手を貸すようになったんだとか思いました？",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_09",
      "WaitClick": true,
      "WaitTime": 0.0,
