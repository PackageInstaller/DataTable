      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitTalk_KOR": "용족의 뿔, 역시 멋있지? 그치?",
      "UnitTalk_JPN": "竜族の角、やはりかっこいいであろう？ん？",
      "TalkTime": 0.03
    },
