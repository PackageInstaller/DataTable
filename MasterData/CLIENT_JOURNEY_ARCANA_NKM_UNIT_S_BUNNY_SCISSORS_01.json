    {
      "Uid": 33,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_BOY"
      ],
      "UnitTalk_KOR": "같이 놀자고 말해봤는데, 자기는 혼자 노는게 편하대!",
      "UnitTalk_JPN": "一緒に遊ぼうって言ったんだけど、一人で遊ぶ方が気が楽なんだって！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 34,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "으음…? 그러냐?",
      "UnitTalk_JPN": "うむ…？そうなのか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitTalk_KOR": "분명, 같이 노는 게 훨씬 재미있을 텐데…",
      "UnitTalk_JPN": "一緒に遊んだ方がずっと楽しいだろうに…",
      "TalkTime": 0.03
    },
