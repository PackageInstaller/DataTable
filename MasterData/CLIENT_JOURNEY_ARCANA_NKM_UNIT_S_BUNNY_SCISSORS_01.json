      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "거기, 처음 보는 인간 꼬마여!",
      "UnitTalk_JPN": "おい、初めて見る人間の小童よ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CHILD_FEMALE",
