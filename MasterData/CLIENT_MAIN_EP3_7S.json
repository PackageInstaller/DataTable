      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STARPIERCER_OMEGA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아빠라면 가르쳐줄 수 있었을 테니까.",
