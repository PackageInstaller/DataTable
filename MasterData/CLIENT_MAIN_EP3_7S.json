      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STARPIERCER_OMEGA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그래서 아까 오메가 엄청 신났어. 아빠 냄새인 줄 알고.",
