      "TalkVoice": "MAIN_EP3_7_UNIT_S_STARPIERCER_OMEGA_024.wav"
    },
    {
      "Uid": 47,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STARPIERCER_OMEGA",
      "UnitMotion": "SPECIAL2",
      "UnitTalk_KOR": "오메가 머리가 텅텅 비었어. 때려도 깡깡 소리밖에 안 나.",
      "UnitTalk_JPN": "オメガのあたま、空っぽになっちゃった。叩いてもカンカンって鳴るだけ。",
