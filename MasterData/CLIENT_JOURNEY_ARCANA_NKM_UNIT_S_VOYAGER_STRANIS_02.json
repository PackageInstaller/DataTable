    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "요리…를 알려달라구요?",
      "UnitTalk_JPN": "料理を教えてほしい…とおっしゃるのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "부탁할게, 클레어!",
      "UnitTalk_JPN": "お願い、クレア！",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "부탁…이라고 하셔도…",
      "UnitTalk_JPN": "お願い…と言われましても…",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "어떤 요리라도 괜찮으니까!",
      "UnitTalk_JPN": "どんな料理でもいいから！",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "캔들 스퀘어에서 나오는 식사는 언제나 맛있고 영양도 잘 맞춰져 있는걸.",
      "UnitTalk_JPN": "キャンドル・スクエアの料理は、いつも栄養満点で美味しいんだもの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "자취 이후로 식사를 제때 못 챙길 때가 많았는데, 캔들 스퀘어의 식사가 얼마나 큰 도움이 되었는지 몰라.",
      "UnitTalk_JPN": "一人暮らしを始めてから、ちゃんと食べれないことも多かったけど…キャンドル・スクエアの食事のおかげで、本当に助かってるわ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "하지만 그런 말도 있잖아? <color=#F7BE45>물고기를 잡아주지 말고 낚시를 가르쳐라</color>라는…",
      "UnitTalk_JPN": "でも、こんな言葉があるでしょう？<color=#F7BE45>魚を与えるのではなく、釣り方を教えよ</color>って…",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "남은 음식이 없는지 매번 캔들 스퀘어의 주방 앞을 서성이며 메이드들을 귀찮게 하는 일도 없도록 할 테니까…!",
      "UnitTalk_JPN": "もうキャンドル・スクエアのキッチン前をウロウロして、\n残った食べ物がないか確認したり、メイドさんたちを困らせたりしないから…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "하아… 언제나 주방 근처에서 인기척이 느껴진다고 생각했는데… 아세라님이셨던 거군요.",
      "UnitTalk_JPN": "はぁ…いつもキッチンの辺りから人の気配がすると思っていましたが…アセラ様だったのですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "하지만 저도 요리를 잘하는 건 아닙니다.",
      "UnitTalk_JPN": "ですが、私も料理が得意な訳ではありません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "캔들 스퀘어의 식사 준비를 관리 감독하긴 하지만, 요리 자체는 전문 인력이 맡고 있으니까요.",
      "UnitTalk_JPN": "キャンドル・スクエアの食事を管理・監督してはいますが、\n料理自体は専門の方にお任せしていますから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "간단한 요리법 하나라도 괜찮아!",
      "UnitTalk_JPN": "簡単なレシピひとつでもいいから！",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…알겠습니다.",
      "UnitTalk_JPN": "…分かりました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "여정 단원들이 여정을 무사히 마치기 위한 최대한의 지원을 드리는 것이 저희 캔들 스퀘어의 방침이니까요.",
      "UnitTalk_JPN": "救援の旅を無事に完遂できるよう、最大限にサポートするのが私たちキャンドル・スクエアの方針ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "정말 고마워!",
      "UnitTalk_JPN": "本当にありがとう！",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "후후, 뭘요. 그럼 주방으로 가실까요?",
      "UnitTalk_JPN": "ふふ。それでは、キッチンに向かいましょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
