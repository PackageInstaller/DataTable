    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": false,
      "WaitTime": 0.8,
      "UnitStrId": "NKM_UNIT_NPC_MAID_TWOHANDER",
      "CameraOffset": "TWIN_1",
      "CameraOffsetTime": "NR",
      "UnitPos": "POS1"
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_TWOHANDER",
      "UnitTalk_KOR": "클레어님, 여기 계셨군요.",
      "UnitTalk_JPN": "クレア殿、ここにいらっしゃったのですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "무슨 일이죠, 에밀리?",
      "UnitTalk_JPN": "エミリー、どうかしましたか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_TWOHANDER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "목록보다 훨씬 많은 양의 보급품이 배달되어서 확인을 해봐야 할 것 같습니다.",
      "UnitTalk_JPN": "補給品が、リストより遥かに多く届きました。確認が必要かと思われます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_TWOHANDER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…아마 제가 깜박하고-",
      "UnitTalk_JPN": "…おそらく、自分がうっかり注文を──",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "…하아.",
      "UnitTalk_JPN": "…はぁ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "저는 잠시 자리를 비워야 할 것 같습니다.",
