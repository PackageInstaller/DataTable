{
    "name": "mVoiceEnters",
    "data": [
        {
            "id": 1,
            "mUnitId": 1,
            "mDressId": null,
            "filePath": "vo_001_mypage_05_1",
            "text": "ソフィ、コト、クレアとはよく武器を使った戦い方について語り合います。いつも結論は出ないのですが",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 2,
            "mUnitId": 2,
            "mDressId": null,
            "filePath": "vo_002_mypage_05_1",
            "text": "聖樹教会の聖神官として、模範的な振る舞いを心掛けなくては",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 3,
            "mUnitId": 3,
            "mDressId": null,
            "filePath": "vo_003_mypage_05_1",
            "text": "料理は下拵えと段取りが８割でございます。さあ、準備準備……",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 4,
            "mUnitId": 4,
            "mDressId": null,
            "filePath": "vo_004_mypage_05_1",
            "text": "あたしの魔術が必要？　はいはい、しゃーないなー",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 5,
            "mUnitId": 5,
            "mDressId": null,
            "filePath": "vo_005_mypage_05_1",
            "text": "《アイリス》たちの教師役、エレガントに務めあげてみせましょう",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 6,
            "mUnitId": 6,
            "mDressId": null,
            "filePath": "vo_006_mypage_05_1",
            "text": "特に理由はないけど、いっつも眠いんだよねー。にーさん、一緒に寝る？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 7,
            "mUnitId": 7,
            "mDressId": null,
            "filePath": "vo_007_mypage_05_1",
            "text": "盾を磨いておこうかな……",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 8,
            "mUnitId": 8,
            "mDressId": null,
            "filePath": "vo_008_mypage_05_1",
            "text": "みんなが笑顔でいられるよう、頑張ります！",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 9,
            "mUnitId": 9,
            "mDressId": null,
            "filePath": "vo_009_mypage_05_1",
            "text": "いつか必ず、あなたを踊りで感動させてみせる。それまでは、傍にいるから",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 10,
            "mUnitId": 10,
            "mDressId": null,
            "filePath": "vo_010_mypage_05_1",
            "text": "あら、何か用かしら？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 11,
            "mUnitId": 11,
            "mDressId": null,
            "filePath": "vo_011_mypage_05_1",
            "text": "絵に描いたものが、具現化する。私の魔術って、一体どうなっているんでしょう？　自分でもよくわからないんです",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 12,
            "mUnitId": 12,
            "mDressId": null,
            "filePath": "vo_012_mypage_05_1",
            "text": "わたしにお手伝いできることはありませんか？　旦那さまのためなら、何でもいたします",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 13,
            "mUnitId": 13,
            "mDressId": null,
            "filePath": "vo_013_mypage_05_1",
            "text": "はい、お呼びですか？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 14,
            "mUnitId": 14,
            "mDressId": null,
            "filePath": "vo_014_mypage_05_1",
            "text": "うう、撃ちたい、銃が撃ちたい……はっ、自分、いま何か言っていましたか！？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 15,
            "mUnitId": 15,
            "mDressId": null,
            "filePath": "vo_015_mypage_05_1",
            "text": "はーい、ファム、何でもお手伝いします！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 16,
            "mUnitId": 16,
            "mDressId": null,
            "filePath": "vo_016_mypage_05_1",
            "text": "またたび、あれは危険。自分が自分じゃなくなる……",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 17,
            "mUnitId": 17,
            "mDressId": null,
            "filePath": "vo_017_mypage_05_1",
            "text": "クルちゃんの耳、気になります？　えへへ、触ったり撫でたりしていいですよ？",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 18,
            "mUnitId": 18,
            "mDressId": null,
            "filePath": "vo_018_mypage_05_1",
            "text": "なになに、センセー、呼んだ？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 19,
            "mUnitId": 19,
            "mDressId": null,
            "filePath": "vo_019_mypage_05_1",
            "text": "我の尻尾が気になるか？　気になるじゃろう、そうじゃろう！　触ってもよし、抱いてもよし、さあ、好きにするがいい！",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 20,
            "mUnitId": 20,
            "mDressId": null,
            "filePath": "vo_020_mypage_05_1",
            "text": "私の歌、冥王以外に聞かせたくない……でも、歌わなきゃ戦えないし、我慢する",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 21,
            "mUnitId": 21,
            "mDressId": null,
            "filePath": "vo_021_mypage_05_1",
            "text": "お姫様姉妹の姉のほう……ではなく、しっかりルージェニアという名前で覚えて頂戴ね！",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 22,
            "mUnitId": 22,
            "mDressId": null,
            "filePath": "vo_022_mypage_05_1",
            "text": "お姫様姉妹の、妹のほう、プリシラです。ふふっ、もう覚えてくれましたよね？",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 23,
            "mUnitId": 1,
            "mDressId": null,
            "filePath": "vo_001_mypage_05_2",
            "text": "剣を磨いていると、戦場でその輝きを目にしたとき、自信が湧いてくるのです。その自信が勝敗を分けることもあります",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 24,
            "mUnitId": 2,
            "mDressId": null,
            "filePath": "vo_002_mypage_05_2",
            "text": "今日も冥王様のお傍にいられて嬉し……って、いけないいけない！　はーっ！　邪念撲滅！　邪念撲滅……！",
            "faceId": 4,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 25,
            "mUnitId": 3,
            "mDressId": null,
            "filePath": "vo_003_mypage_05_2",
            "text": "さあ冥王様、こちらではリラックスなさって、ゆっくりお休みくださいませ",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 26,
            "mUnitId": 4,
            "mDressId": null,
            "filePath": "vo_004_mypage_05_2",
            "text": "あたし、栄養が全部頭に行っちゃってるんだよねー",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 27,
            "mUnitId": 5,
            "mDressId": null,
            "filePath": "vo_005_mypage_05_2",
            "text": "完璧な召使いであるわたくしは、どのようなご命令もお受けいたします",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 28,
            "mUnitId": 6,
            "mDressId": null,
            "filePath": "vo_006_mypage_05_2",
            "text": "のんびりサムライ、まどろみサムライ……いろいろ言われるけど、ま、どれも間違ってないかなー",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 29,
            "mUnitId": 7,
            "mDressId": null,
            "filePath": "vo_007_mypage_05_2",
            "text": "最強の矛と最強の盾で『矛盾』。最強の矛はどこだろう？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 30,
            "mUnitId": 8,
            "mDressId": null,
            "filePath": "vo_008_mypage_05_2",
            "text": "わたしの拳で、何だって砕いちゃいますよ！",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 31,
            "mUnitId": 9,
            "mDressId": null,
            "filePath": "vo_009_mypage_05_2",
            "text": "どうしたの？　一緒に踊る？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 32,
            "mUnitId": 10,
            "mDressId": null,
            "filePath": "vo_010_mypage_05_2",
            "text": "錬金術に興味があるの？　ふふっ、私の助手、やってみる？",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 33,
            "mUnitId": 11,
            "mDressId": null,
            "filePath": "vo_011_mypage_05_2",
            "text": "元・宮廷絵画師ですから。絵には自信がありますよ",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 34,
            "mUnitId": 12,
            "mDressId": null,
            "filePath": "vo_012_mypage_05_2",
            "text": "セシル・ライカ・エンゲル・ベルグルンド……わたしの真名を明かせるのは、旦那さまだけでございます……ふふっ",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 35,
            "mUnitId": 13,
            "mDressId": null,
            "filePath": "vo_013_mypage_05_2",
            "text": "森と違って、ここは賑やかですね。毎日楽しいです",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 36,
            "mUnitId": 14,
            "mDressId": null,
            "filePath": "vo_014_mypage_05_2",
            "text": "ドワリンだからといって、子供扱いはやめてください。まあ、頭を撫でるのは構いませんが",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 37,
            "mUnitId": 15,
            "mDressId": null,
            "filePath": "vo_015_mypage_05_2",
            "text": "ふあっ！？　もぐもぐ……ごくん、す、すみません、おやつを食べていました！",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 38,
            "mUnitId": 16,
            "mDressId": null,
            "filePath": "vo_016_mypage_05_2",
            "text": "冥王さまに撫でられるの、好きだから……尻尾とか、触っていいよ",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 39,
            "mUnitId": 17,
            "mDressId": null,
            "filePath": "vo_017_mypage_05_2",
            "text": "うふふ、そんなに見つめられるとクルちゃん、身体が熱くなっちゃいます",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 40,
            "mUnitId": 18,
            "mDressId": null,
            "filePath": "vo_018_mypage_05_2",
            "text": "毎日楽しいし、センセーにも会えるし、学園に来てよかった",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 41,
            "mUnitId": 19,
            "mDressId": null,
            "filePath": "vo_019_mypage_05_2",
            "text": "冥王に出会えて、我は嬉しいぞ！　５００年生きた甲斐があるというものじゃ！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 42,
            "mUnitId": 20,
            "mDressId": null,
            "filePath": "vo_020_mypage_05_2",
            "text": "あ、あんまり見つめないで、歌に集中できない。歌い終わったあとなら……いいから",
            "faceId": 3,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 43,
            "mUnitId": 21,
            "mDressId": null,
            "filePath": "vo_021_mypage_05_2",
            "text": "いつか必ず、世界に平和を！",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 44,
            "mUnitId": 22,
            "mDressId": null,
            "filePath": "vo_022_mypage_05_2",
            "text": "冥王さん、新しい作戦を考えたんですけど、どうでしょう？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 45,
            "mUnitId": 102,
            "mDressId": null,
            "filePath": "vo_102_mypage_05_1",
            "text": "さて冥王さま、次はどこに《種子》探しに行きましょうか？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 46,
            "mUnitId": 102,
            "mDressId": null,
            "filePath": "vo_102_mypage_05_2",
            "text": "遊んでいるのではなく、英気を養っているんです！　ぶーぶー",
            "faceId": 3,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 47,
            "mUnitId": 24,
            "mDressId": null,
            "filePath": "vo_024_mypage_05_1",
            "text": "冥界にも川が流れてるだろ？　いつかあそこに船を浮かべてみたいねえ",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 48,
            "mUnitId": 24,
            "mDressId": null,
            "filePath": "vo_024_mypage_05_2",
            "text": "冥界っていうからどんなに暗いのかと思ったら、案外楽しいところじゃないか",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 49,
            "mUnitId": 23,
            "mDressId": null,
            "filePath": "vo_023_mypage_05_1",
            "text": "ひゃっ！？　い、いきなり天使をつつくとか、大胆すぎるでしょ。うう、びっくりさせないでよ……もう",
            "faceId": 3,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 50,
            "mUnitId": 23,
            "mDressId": null,
            "filePath": "vo_023_mypage_05_2",
            "text": "なになに？　私に何か用？　ほ、本当は忙しいんだけど……仕方ないから、冥王の相手をしてあげる！",
            "faceId": 3,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 51,
            "mUnitId": 103,
            "mDressId": null,
            "filePath": "vo_103_mypage_05_1",
            "text": "はい、なんでしょう冥王さま……へ？　ただ撫でてみただけ……？　あ、ありがとうございます",
            "faceId": 3,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 52,
            "mUnitId": 103,
            "mDressId": null,
            "filePath": "vo_103_mypage_05_2",
            "text": "冥王さま、お仕事中ですか？　何かお手伝いさせてください。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 53,
            "mUnitId": 25,
            "mDressId": null,
            "filePath": "vo_025_mypage_05_1",
            "text": "何かご用ですか？　いいのですよ、あなたなら。用がなくても傍にいてください。",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 54,
            "mUnitId": 25,
            "mDressId": null,
            "filePath": "vo_025_mypage_05_2",
            "text": "お役に立つことがあれば何でも言ってください。あなたの喜ぶ顔は励みになるのです。",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 55,
            "mUnitId": 26,
            "mDressId": null,
            "filePath": "vo_026_mypage_05_1",
            "text": "みなさんの健康を守るお仕事は、とてもやりがいがあります。なんでもご相談くださいね、冥王様。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 56,
            "mUnitId": 26,
            "mDressId": null,
            "filePath": "vo_026_mypage_05_2",
            "text": "冥界に来てから、毎日が充実しています。スクールカウンセラーにしてくださり、本当にありがとうございます。",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 57,
            "mUnitId": 51,
            "mDressId": null,
            "filePath": "vo_051_mypage_05_1",
            "text": "こちらの世界にも『月』があるのは、少し不思議な気分ですね。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 58,
            "mUnitId": 51,
            "mDressId": null,
            "filePath": "vo_051_mypage_05_2",
            "text": "世界樹の存在には驚きました。あんなに大きな樹があるとは……。",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 59,
            "mUnitId": 52,
            "mDressId": null,
            "filePath": "vo_052_mypage_05_1",
            "text": "まるで映画の中に飛び込んだみたいな毎日です。こっちの世界に来て良かったです。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 60,
            "mUnitId": 52,
            "mDressId": null,
            "filePath": "vo_052_mypage_05_2",
            "text": "たらこパスタのお店、今ごろどうなってるかな？　きっと繁盛してますよね。",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 61,
            "mUnitId": 53,
            "mDressId": null,
            "filePath": "vo_053_mypage_05_1",
            "text": "図書部・アカデミー支部は今日も営業中！　冥王さんも、依頼があればいつでも部室にいらっしゃってくださいね。",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 62,
            "mUnitId": 53,
            "mDressId": null,
            "filePath": "vo_053_mypage_05_2",
            "text": "筧く……じゃなくて、冥王さん……す、すみません！　向こうの世界の知り合いに雰囲気が似てて、間違えちゃいました。",
            "faceId": 3,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 63,
            "mUnitId": 54,
            "mDressId": null,
            "filePath": "vo_054_mypage_05_1",
            "text": "冥界は不思議な場所ですよね、天気も変わらないし、魂とか浮いてるし。とりあえず、鈴木的世界遺産に認定です！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 64,
            "mUnitId": 54,
            "mDressId": null,
            "filePath": "vo_054_mypage_05_2",
            "text": "図書部ヒラ部員・鈴木佳奈！　全国の鈴木さんの思いを背負い、異世界にて奮闘中！　……っていうキャッチコピー、どうです？",
            "faceId": 5,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 65,
            "mUnitId": 27,
            "mDressId": null,
            "filePath": "vo_027_mypage_05_1",
            "text": "う……学食であれも美味しい、これも美味しい！　って食べてたら、お腹はち切れそう……",
            "faceId": 4,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 66,
            "mUnitId": 27,
            "mDressId": null,
            "filePath": "vo_027_mypage_05_2",
            "text": "さっすがハデスが作っただけあって、冥界は居心地いいね！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 67,
            "mUnitId": 55,
            "mDressId": null,
            "filePath": "vo_055_mypage_05_1",
            "text": "《アイリス》はみんなかなりの身体能力よね。私もボヤボヤしてられないわ。さーて、運動しないと。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 68,
            "mUnitId": 55,
            "mDressId": null,
            "filePath": "vo_055_mypage_05_2",
            "text": "私も吸血鬼なんだから、ヴァレリアみたいに空を飛べたら良かったな。あれ、でもあのハネってどうやってしまってるの？",
            "faceId": 3,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 69,
            "mUnitId": 56,
            "mDressId": null,
            "filePath": "vo_056_mypage_05_1",
            "text": "冥界の住人の皆さんって、傷ついた魂を癒やしているんですね。冥界は穏やかなので癒やすにはいいところだと思います。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 70,
            "mUnitId": 56,
            "mDressId": null,
            "filePath": "vo_056_mypage_05_2",
            "text": "普段は、私も千堂さんと同じ制服を着てたんですよ。この服装でずっと学園に行ってたわけじゃないんです。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 71,
            "mUnitId": 57,
            "mDressId": null,
            "filePath": "vo_057_mypage_05_1",
            "text": "時間は限られているわ。今日はビッシビシしごいてちょうだい。どこまででもついていくわ。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 72,
            "mUnitId": 57,
            "mDressId": null,
            "filePath": "vo_057_mypage_05_2",
            "text": "ずっと冥界にいられたら……なーんて言ったら皇国のみんなに怒られちゃうわね。冗談よ。",
            "faceId": 3,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 73,
            "mUnitId": 58,
            "mDressId": null,
            "filePath": "vo_058_mypage_05_1",
            "text": "冥界は素晴らしいところでございます。大変な人生を送った魂たちも心を慰められていると思います。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 74,
            "mUnitId": 58,
            "mDressId": null,
            "filePath": "vo_058_mypage_05_2",
            "text": "実は非常用の佐村屋まんじゅうを持っているのです。冥王様、お近づきの印にぜひご賞味くださいませ。",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 75,
            "mUnitId": 28,
            "mDressId": null,
            "filePath": "vo_028_mypage_05_1",
            "text": "《アイリス》の先輩方に追いつくため、勉学も鍛練も欠かすわけにはいきません。",
            "faceId": 4,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 76,
            "mUnitId": 28,
            "mDressId": null,
            "filePath": "vo_028_mypage_05_2",
            "text": "冥界はいつもほんのり暖かいです。もしやクリスの滝行はあまり修行になっていないのでは？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 77,
            "mUnitId": 1,
            "mDressId": 601101,
            "filePath": "vo_601101_mypage_05_3",
            "text": "主を守り、主の大切なものも守る。それが『主の剣である』ということです",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 78,
            "mUnitId": 29,
            "mDressId": null,
            "filePath": "vo_029_mypage_05_1",
            "text": "ポリン姉さまに、よくやったわねって言ってもらえるように、勉強も運動も頑張ってます！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 79,
            "mUnitId": 29,
            "mDressId": null,
            "filePath": "vo_029_mypage_05_2",
            "text": "しかしいつ見てもアシュリーさまの剣技はすごいですね。いつかゴーレムでもあの動きを再現したいなあ。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 80,
            "mUnitId": 2,
            "mDressId": 602301,
            "filePath": "vo_602301_mypage_05_3",
            "text": "魂の命じるまま、ここまでやってまいりました。これからも自分の気持ちに従っていこうと思います",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 81,
            "mUnitId": 12,
            "mDressId": 612401,
            "filePath": "vo_612401_mypage_05_3",
            "text": "うふふ、旦那さまがいらっしゃるのをお待ちしてました♡",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 82,
            "mUnitId": 59,
            "mDressId": null,
            "filePath": "vo_059_mypage_05_1",
            "text": "今日も元気に張り切って行きましょう！　おーっ！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 83,
            "mUnitId": 59,
            "mDressId": null,
            "filePath": "vo_059_mypage_05_2",
            "text": "わたし、頭に向日葵が咲いているような女だって言われたことがあるんです。褒められているのでしょうか？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 84,
            "mUnitId": 60,
            "mDressId": null,
            "filePath": "vo_060_mypage_05_1",
            "text": "《アイリス》のチームワークは素晴らしいな。長年一緒に暮らしている家族のようだ。これも冥王の人徳のたまものか。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 85,
            "mUnitId": 60,
            "mDressId": null,
            "filePath": "vo_060_mypage_05_2",
            "text": "人をまとめる秘訣を教えてくれないか？　なるほど、個性を尊重することか。心に留めておこう。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 86,
            "mUnitId": 14,
            "mDressId": 614101,
            "filePath": "vo_614101_mypage_05_3",
            "text": "仲間と冥王殿のために撃つ。それが自分の銃の道であります。びしっ",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 87,
            "mUnitId": 61,
            "mDressId": null,
            "filePath": "vo_061_mypage_05_1",
            "text": "初めてベロスを見たときは衝撃を受けました。頭が１つでも可愛らしいのに、３つもついているなんて！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 88,
            "mUnitId": 61,
            "mDressId": null,
            "filePath": "vo_061_mypage_05_2",
            "text": "リースには動物に好かれる才能があるようです。神よ、なぜ私に同じ才能を授けてくださらなかったのですか！（嘆き）",
            "faceId": 4,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 89,
            "mUnitId": 62,
            "mDressId": null,
            "filePath": "vo_062_mypage_05_1",
            "text": "何か喋れって言われても困る。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 90,
            "mUnitId": 62,
            "mDressId": null,
            "filePath": "vo_062_mypage_05_2",
            "text": "好きに過ごして。ワタシもそうするから。",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 91,
            "mUnitId": 6,
            "mDressId": 606201,
            "filePath": "vo_606201_mypage_05_3",
            "text": "十流皆伝、アユカワコト。冥王殿のため見参！　なんちって",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 92,
            "mUnitId": 23,
            "mDressId": 623501,
            "filePath": "vo_623501_mypage_05_3",
            "text": "で？　私は何すればいいの？　ほらほら役に立つからなんでも言ってみなさいよ",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 93,
            "mUnitId": 4,
            "mDressId": 604301,
            "filePath": "vo_604301_mypage_05_3",
            "text": "さ、今日も世界の真理を探しに行くかんね。めーおー、遅れないでよ！",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 94,
            "mUnitId": 18,
            "mDressId": 618501,
            "filePath": "vo_618501_mypage_05_3",
            "text": "何かお手伝いできることあるかな？　なんでも言ってね",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 95,
            "mUnitId": 22,
            "mDressId": 622201,
            "filePath": "vo_622201_mypage_05_3",
            "text": "聞いてください、冥王さんっ。最強の布陣を考えたんです！",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 96,
            "mUnitId": 26,
            "mDressId": 626401,
            "filePath": "vo_626401_mypage_05_3",
            "text": "こんにちは冥王様。今日はお心もお身体も健やかでしょうか？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 97,
            "mUnitId": 21,
            "mDressId": 621301,
            "filePath": "vo_621301_mypage_05_3",
            "text": "冥界は今日も平和ですわね。人間界もいつかこれくらい平和にしなくては",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 98,
            "mUnitId": 5,
            "mDressId": 605101,
            "filePath": "vo_605101_mypage_05_3",
            "text": "ご主人様、これから執務でございますか？　あるいは休憩でございますか？　どちらの準備も、完璧に整えております",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 99,
            "mUnitId": 16,
            "mDressId": 616501,
            "filePath": "vo_616501_mypage_05_3",
            "text": "いらっしゃいませ冥王さま。いろいろ面白いもの仕入れてきたから見ていって",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 100,
            "mUnitId": 30,
            "mDressId": null,
            "filePath": "vo_030_mypage_05_1",
            "text": "冥王さまの隣にわたしがいると、なんとなくしっくりきませんか？",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 101,
            "mUnitId": 30,
            "mDressId": null,
            "filePath": "vo_030_mypage_05_2",
            "text": "冥王さまがいて、わたしがいて、皆さんがいて……ふふ、今日も素敵な１日ですね",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 102,
            "mUnitId": 3,
            "mDressId": 603401,
            "filePath": "vo_603401_mypage_05_3",
            "text": "今日のご予定はお決まりですか？　まだでしたら、私と一緒にお出かけなどいかがでしょう？　お弁当を作って差し上げますよ",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 103,
            "mUnitId": 15,
            "mDressId": 615201,
            "filePath": "vo_615201_mypage_05_3",
            "text": "今日の学食では、ファムの取れたて野菜が食べられるのでご期待ください！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 104,
            "mUnitId": 20,
            "mDressId": 620101,
            "filePath": "vo_620101_mypage_05_3",
            "text": "何か歌ってほしい？　陽気な歌、悲しい歌、それに、子守歌。冥王のためなら、なんでも歌ってあげる",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 105,
            "mUnitId": 13,
            "mDressId": 613401,
            "filePath": "vo_613401_mypage_05_3",
            "text": "力と技と知恵と心の在り様。いずれも鍛えねばと思ったとき、全てを学べるこの樹理学園の素晴らしさに気づきます",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 106,
            "mUnitId": 25,
            "mDressId": 625201,
            "filePath": "vo_625201_mypage_05_3",
            "text": "こんにちは冥王。もちろん、今日の予定は空けてくれているのでしょう？　私のために……くすくす",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 107,
            "mUnitId": 9,
            "mDressId": 609501,
            "filePath": "vo_609501_mypage_05_3",
            "text": "本日はようこそお出でくださいました。世界一のダンスをお楽しみください。なんちゃって",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 108,
            "mUnitId": 19,
            "mDressId": 619301,
            "filePath": "vo_619301_mypage_05_3",
            "text": "冥王といると飽きぬのう。で、今日は何をするのだ？　種子集めか？　それとも我と模擬戦か？",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 109,
            "mUnitId": 17,
            "mDressId": 617101,
            "filePath": "vo_617101_mypage_05_3",
            "text": "時代も国も越えて大人気！（になる予定）の、超時空系アイドルクルちゃんだよ！　よろしくね～♪",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 110,
            "mUnitId": 11,
            "mDressId": 611401,
            "filePath": "vo_611401_mypage_05_3",
            "text": "新しい絵をお持ちしました。冥王さまにプレゼントしますね",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 111,
            "mUnitId": 24,
            "mDressId": 624201,
            "filePath": "vo_624201_mypage_05_3",
            "text": "お、来たね。じゃあ錨を上げて帆を張ろうじゃないか！　野郎ども、出港だよ！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 112,
            "mUnitId": 25,
            "mDressId": 628501,
            "filePath": "vo_628501_mypage_05_3",
            "text": "今日も冥王様と共に過ごせることを、世界樹に感謝しなくてはなりませんね",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 113,
            "mUnitId": 10,
            "mDressId": 610301,
            "filePath": "vo_610301_mypage_05_3",
            "text": "昨日の夜の爆発？　ちょっとした手違いだから気にしないで",
            "faceId": 3,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 114,
            "mUnitId": 7,
            "mDressId": 607101,
            "filePath": "vo_607101_mypage_05_3",
            "text": "やあ、よく来てくれたね。今日の戦場はどこだい？　もちろん私の準備は万端さ",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 115,
            "mUnitId": 8,
            "mDressId": 608501,
            "filePath": "vo_608501_mypage_05_3",
            "text": "あ、冥王様！　今日も元気に行きましょう、おー！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 116,
            "mUnitId": 27,
            "mDressId": 627301,
            "filePath": "vo_627301_mypage_05_3",
            "text": "今日は何しよっか？　わたし行きたいところあるんだけど、一緒に行かない？",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 117,
            "mUnitId": 30,
            "mDressId": 630201,
            "filePath": "vo_630201_mypage_05_3",
            "text": "いやー、やっぱりわたしの出番ってことになっちゃいますよね",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 118,
            "mUnitId": 29,
            "mDressId": 629401,
            "filePath": "vo_629401_mypage_05_3",
            "text": "聞いてください冥王さま！　わたし、新理論を発見したかもしれません！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 119,
            "mUnitId": 4,
            "mDressId": 604501,
            "filePath": "vo_604501_mypage_05_3",
            "text": "はぁ……好きなだけ真理の追及してられたら楽なんだけどな……",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 120,
            "mUnitId": 21,
            "mDressId": 621401,
            "filePath": "vo_621401_mypage_05_3",
            "text": "ごきげんよう、冥王。世界平和のため、今日もトレーニングに励みます",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 121,
            "mUnitId": 6,
            "mDressId": 606101,
            "filePath": "vo_606101_mypage_05_3",
            "text": "あ、にーさん、何してるの？　え、息してるだけ？　いいねえ。ワタシも今日は息するだけにしよっと",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 122,
            "mUnitId": 12,
            "mDressId": 612301,
            "filePath": "vo_612301_mypage_05_3",
            "text": "旦那さま。これからお出かけしましょう！　ふふっ。今日のわたしは、ぐいぐい行っちゃいますよ！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 123,
            "mUnitId": 31,
            "mDressId": null,
            "filePath": "vo_031_mypage_05_1",
            "text": "なんだか演奏したい気分。冥王、何かリクエストがあれば言って。どんな曲や楽器でも応えてあげる",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 124,
            "mUnitId": 31,
            "mDressId": null,
            "filePath": "vo_031_mypage_05_2",
            "text": "はぁ。面倒くさい面倒くさい。さっさと仕事を終わらせて冥王にくっ付こっと",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 125,
            "mUnitId": 5,
            "mDressId": 605201,
            "filePath": "vo_605201_mypage_05_3",
            "text": "本日もお目にかかることができ、この上なく幸せでございます。さあ、なんなりとお命じくださいませ",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 126,
            "mUnitId": 20,
            "mDressId": 620401,
            "filePath": "vo_620401_mypage_05_3",
            "text": "冥王、新しい歌を作ったから聞いてほしい。あなたと出会えなかった『もしも』を想像した、切ない曲なんだけど",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 127,
            "mUnitId": 16,
            "mDressId": 616201,
            "filePath": "vo_616201_mypage_05_3",
            "text": "こんにちは冥王さま。頼まれてた商品、入ってるよ",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 128,
            "mUnitId": 14,
            "mDressId": 614301,
            "filePath": "vo_614301_mypage_05_3",
            "text": "臆病であっても、武器がなくても、決して逃げ出しません。その覚悟が、自分にはあります",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 129,
            "mUnitId": 1,
            "mDressId": 601501,
            "filePath": "vo_601501_mypage_05_4",
            "text": "私はいつでも主のお傍に。この命ある限り、誠心誠意お仕えします",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 130,
            "mUnitId": 32,
            "mDressId": null,
            "filePath": "vo_032_mypage_05_1",
            "text": "今日も一日よろしくね、冥王",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 131,
            "mUnitId": 32,
            "mDressId": null,
            "filePath": "vo_032_mypage_05_2",
            "text": "学べば学ぶほど、自分の未熟さを痛感するわ。諦める理由にはならないけどね",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 132,
            "mUnitId": 19,
            "mDressId": 619101,
            "filePath": "vo_619101_mypage_05_4",
            "text": "ふふふ、血が騒ぐのう……行くぞ冥王！　討伐でも模擬戦でもどんと来いじゃ！",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 133,
            "mUnitId": 10,
            "mDressId": 610501,
            "filePath": "vo_610501_mypage_05_4",
            "text": "冥王様がそばにいると調合の成功率が上がるの。片時も離れてほしくないわ",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 134,
            "mUnitId": 31,
            "mDressId": 631101,
            "filePath": "vo_631101_mypage_05_3",
            "text": "や、冥王。１曲演奏しようと思うんだけど、リクエストとかある？",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 135,
            "mUnitId": 22,
            "mDressId": 622301,
            "filePath": "vo_622301_mypage_05_4",
            "text": "新しいコーデを考えてきたんです。さっ、こちらに着替えてみてください",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 136,
            "mUnitId": 17,
            "mDressId": 617401,
            "filePath": "vo_617401_mypage_05_4",
            "text": "いつでもどこでも、冥王さまにふさわしい癒やしをお届けしますからね",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 137,
            "mUnitId": 2,
            "mDressId": 602101,
            "filePath": "vo_602101_mypage_05_4",
            "text": "素敵な胸板……少しだけ触れてよろしいでしょうか？　冥王様の逞しさを、手のひらでゆっくりと味わわせてください",
            "faceId": 2,
            "startAt": null,
            "endAt": null
        },
        {
            "id": 138,
            "mUnitId": 13,
            "mDressId": 613301,
            "filePath": "vo_613301_mypage_05_4",
            "text": "森と同じくらい、冥界が心地よく感じます。きっと、隣に冥王様がいらっしゃるからですね",
            "faceId": 1,
            "startAt": null,
            "endAt": null
        }
    ]
}