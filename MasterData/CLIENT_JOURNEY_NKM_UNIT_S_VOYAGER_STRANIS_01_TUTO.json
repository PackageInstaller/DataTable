  "Data": [
    {
      "Uid": 1,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "RewardAnchor": "REWARD_ANCHOR_1",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_CANDLE_GROUND.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_02.mp3",
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "TRIPLE_2",
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아스트로 생텀을 나와 훈련장에 도착하자 한 소녀가 나를 기다리고 있었다.",
      "UnitTalk_JPN": "アストロ・サンクタムを出て訓練場に着くと、少女が私を待っていた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "금발 머리에 검은 갑옷을 입은 그녀에게선 어쩐지 나이에 걸맞지 않은 강인함이 느껴졌다.",
      "UnitTalk_JPN": "金髪に黒い鎧をまとった少女からは、どことなく年齢にそぐわない強さが感じられた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "그녀는 내 쪽을 보더니 망설임 없이 다가와 손을 내밀었다.",
      "UnitTalk_JPN": "少女は私を見つけるなり、迷うことなく手を差し出した。  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "안녕? 당신이 이번에 새로 왔다는 <color=#F7BE45>[여정 단장]</color>이지?",
      "UnitTalk_JPN": "こんにちは。あなたが新しく就任した<color=#F7BE45>「旅の団長」</color>よね？  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "반가워, 정식으로 소개할게. ",
      "UnitTalk_JPN": "会えてうれしいわ。早速だけど、自己紹介させてもらうわね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "난 아세라라고 해.",
      "UnitTalk_JPN": "わたしはアセラ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "사실은 깜짝 놀랐어.",
      "UnitTalk_JPN": "実はね、本当にビックリしたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "어느 날 집에서 신문을 보는데 편지가 왔거든.",
      "UnitTalk_JPN": "家で新聞を読んでいたら、手紙が届いたんだけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "열어 보니까 내가 <color=#F7BE45>여정 단원</color>으로 선발되었다지 뭐야?",
      "UnitTalk_JPN": "そこには、わたしが<color=#F7BE45>旅の団員</color>として選ばれたことが書かれていたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "특히나 이번 여정에는 새로 영입한 여정 단장이 특별 지도를 해 준다고…",
      "UnitTalk_JPN": "しかも今回の旅では、新しく就任した団長が特別指導してくれることも書いてあって…",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "초대장이 진짜가 맞는지 몇 번이나 확인했는지 몰라!",
      "UnitTalk_JPN": "同封してあった招待状が本物かどうか、何度も確認したんだから！",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "난 아직 구원자로서는 경험이 적어서… 솔직히 신출내기에 가깝거든.",
      "UnitTalk_JPN": "わたしは、救援者としては経験が浅いし…正直、まだ素人と変わりないの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "이런 기회를 늘 꿈꿨지만… 정말 현실이 될 줄은 몰랐어!",
      "UnitTalk_JPN": "だからこんなチャンス、ずっと夢見てきたけど…本当に叶うなんて思ってもなかった！",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그래, 나도 앞으로 잘 부탁해.",
          "JumpAnchorStringId_JPN": "これからよろしくな。"
        }
      ]
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "물론이야, 단장!",
      "UnitTalk_JPN": "こちらこそ、団長！",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "아, 내가 너무 떠들어댄 건가?  하하, 솔직히 좀 많이 들떠있긴 하거든!",
      "UnitTalk_JPN": "あ、わたしってば興奮しすぎ？あははっ、正直かなり浮かれてるの！",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "앗, 하지만 절대 가벼운 마음으로 여기에 온 건 아니야.",
      "UnitTalk_JPN": "あっ！でも、決して軽い気持ちでここに来たわけじゃないわ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "중간에 포기하는 사람, 시험을 통과하지 못하는 사람들이 많다는 이야기는 많이 들었으니까.",
      "UnitTalk_JPN": "途中で諦める人、試験を突破できない人がたくさんいるってことは百も承知よ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "솔직히 나 같은 풋내기가 그런 큰 일에 얼마나 도움이 될 수 있을지 모르겠어.",
      "UnitTalk_JPN": "正直、わたしみたいな素人がどれだけ役に立てるかも分からない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그래도 여정을 통과하고 싶다는 마음만큼은 누구에게도 지지 않는다고 생각해!",
      "UnitTalk_JPN": "でも救援の旅を完遂したいって気持ちだけは、誰にも負けないと思う！",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그러니까 훈련이든 뭐든 시켜만 줘.",
      "UnitTalk_JPN": "だから、トレーニングだろうと何だろうとわたしにやらせて。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "아무리 힘든 일이라고 해도 절대 포기하지 않을게.",
      "UnitTalk_JPN": "どんなに辛いことでも、絶対に途中で投げ出したりしないから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이왕 시작한 이상, 꿈을 위해 열심히 달리고 싶어.",
      "UnitTalk_JPN": "せっかく始めたからには、夢のために頑張りたいの。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "그럼 잘 부탁해 단장님!",
      "UnitTalk_JPN": "じゃあ、よろしくね。団長！",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "아세라는 그렇게 말하며 훈련장으로 달려갔다.",
      "UnitTalk_JPN": "アセラはそう言って、訓練場へと向かっていった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "달려가는 그녀의 뒷모습이 어째서인지 낯설지 않다는 생각을 하며, 나도 훈련장으로 향했다.",
      "UnitTalk_JPN": "駆け抜けていくアセラの後ろ姿に、不思議な既視感を感じながら私も訓練場へと向かった。     ",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO",
      "WaitClick": false,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARTEXT",
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL"
    }
  ]
}
