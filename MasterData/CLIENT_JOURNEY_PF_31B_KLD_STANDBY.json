    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_BULLY1_MALE_W",
      "UnitNameString": [
        "SI_THUG_MALE"
      ],
      "CameraOffset": "TWIN_1",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitPos": "POS2",
      "UnitTalk_KOR": "어이, 내가 이 기둥은 좀 더 오른쪽에 세워야 한다고 했잖아.",
      "UnitTalk_JPN": "おい、この柱はもっと右だって言っただろ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT1_MALE_S",
      "UnitNameString": [
        "SI_MUSCULAR_MALE"
      ],
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "흥, 무슨 소리. 이쪽에 세워야 사람들이 지나다닐 때 덜 걸리적거린다고.",
      "UnitTalk_JPN": "フン、何を言っているのさ。こっちに立てた方が、人が通る時に邪魔にならないだろう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_BULLY1_MALE_W",
      "UnitNameString": [
        "SI_THUG_MALE"
      ],
      "UnitTalk_KOR": "뭐라고? 지금 내 말이 틀렸다는 거냐?",
      "UnitTalk_JPN": "あぁん？オレの言ってることが間違ってるってのか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_BULLY1_MALE_W",
      "UnitNameString": [
        "SI_THUG_MALE"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그렇다면 할 수 없지! 주먹으로 결판을 내는 수밖에!",
      "UnitTalk_JPN": "それなら仕方ねぇ！拳で決着つけんぞ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT1_MALE_S",
      "UnitNameString": [
        "SI_MUSCULAR_MALE"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "하하, 좋지! 칼라이드 사람답게 누가 옳은지 한 판 겨뤄 보자고!",
      "UnitTalk_JPN": "ハハ、いいだろう！カライドの人間らしく、どちらが正しいか一戦交えてみようじゃないか！",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "저 사람들, 갑자기 왜 싸우는 거지?",
          "JumpAnchorStringId_JPN": "あの人たち、なんで喧嘩してるんだ？"
        }
      ]
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_APOCALYPSE_FEMALE_1",
      "UnitQuickSet": true,
      "UnitPos": "POS9"
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_APOCALYPSE_FEMALE_1",
      "UnitNameString": [
        "SI_KALAID_PIONEER"
      ],
      "CameraOffset": "TWIN_4",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "싸우다뇨? 저 아저씨들이요?",
      "UnitTalk_JPN": "喧嘩？あっ、あのおじさん達のことですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_APOCALYPSE_FEMALE_1",
      "UnitNameString": [
        "SI_KALAID_PIONEER"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "설마요. 칼라이드에서 저 정도는 건강한 의견 교환에 속해요.",
      "UnitTalk_JPN": "まさか。カライドでは、あの程度は健全な意見交換に過ぎませんから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_APOCALYPSE_FEMALE_1",
      "UnitNameString": [
        "SI_KALAID_PIONEER"
      ],
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "여기서 지내시는 동안에는 비슷한 광경을 자주 보실 거예요.",
      "UnitTalk_JPN": "ここで過ごされる間、同じような光景を何度も見ることになると思いますよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_APOCALYPSE_FEMALE_1",
      "UnitNameString": [
        "SI_KALAID_PIONEER"
      ],
      "UnitTalk_KOR": "축제 준비로 다들 일하느라 정신없거든요.",
      "UnitTalk_JPN": "皆、祭りの準備でバタバタしてるんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "축제?",
          "JumpAnchorStringId_JPN": "祭り？"
        }
      ]
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_APOCALYPSE_FEMALE_1",
      "UnitNameString": [
        "SI_KALAID_PIONEER"
      ],
      "CameraOffset": "ONE_9",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "네. <color=#F7BE45>[칼라이드 온천 축제]</color> 말이에요!",
      "UnitTalk_JPN": "はい。<color=#F7BE45>「カライド温泉祭」</color>です！",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_APOCALYPSE_FEMALE_1",
      "UnitNameString": [
        "SI_KALAID_PIONEER"
      ],
      "UnitTalk_KOR": "맛있는 온천 달걀도 원 없이 먹을 수 있고, 따뜻한 온천수가 채워진 커다란 노천탕에서 밤새 신나는 파티도 즐길 수 있죠.",
      "UnitTalk_JPN": "おいしい温泉卵を思う存分食べられますし、大きな露天風呂で夜通しパーティーも楽しめますよ。あっ、もちろん天然温泉です！",
      "TalkTime": 0.03
    },
