      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_APOCALYPSE_FEMALE_1",
      "UnitNameString": [
        "SI_KALAID_PIONEER"
      ],
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "네? 정말요? 축제 준비를 도와주신다고요?",
