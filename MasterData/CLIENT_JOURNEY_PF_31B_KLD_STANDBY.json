    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT1_MALE_S",
      "UnitNameString": [
        "SI_MUSCULAR_MALE"
      ],
      "UnitTalk_KOR": "하하! 기특한 친구들이군!",
      "UnitTalk_JPN": "ハハ！頼もしいね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_BULLY1_MALE_W",
      "UnitNameString": [
        "SI_THUG_MALE"
      ],
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "칼라이드에서 은인을 푸대접하는 일은 있을 수 없지! 머무는 동안 우리 집 온천을 마음껏 쓰게 해 주마!",
      "UnitTalk_JPN": "カライドでは、恩人を粗末に扱うことなんてねぇんだ！滞在中は、うちの温泉を好きなだけ使えよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT1_MALE_S",
      "UnitNameString": [
        "SI_MUSCULAR_MALE"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "우리 집에 오면 매일 저녁 따끈한 칼라이드식 식사를 대접하마!",
      "UnitTalk_JPN": "うちに来れば、毎日夕食に温かいカライド式の食事をご馳走するよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_BULLY1_MALE_W",
      "UnitNameString": [
        "SI_THUG_MALE"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "흥! 질 수 없지! 우리 집에 방문하면 곰을 탈 수 있게 해 주마!",
      "UnitTalk_JPN": "フン！負けてたまるか！うちに来たら、熊に乗せてやろう！",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "곰은 못 참지!",
          "JumpAnchorStringId_JPN": "熊！？乗るしかない！",
          "JumpAnchorId": "REWARD_ANCHOR_1"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "전통식을 즐길 기회다!",
          "JumpAnchorStringId_JPN": "伝統料理を楽しむチャンスだ！",
          "JumpAnchorId": "REWARD_ANCHOR_2"
        },
        {
          "Uid": 3,
          "JumpAnchorStringId_KOR": "지금은 숙소로 가 봐야 한다.",
          "JumpAnchorStringId_JPN": "今は宿に戻らないと。",
          "JumpAnchorId": "REWARD_ANCHOR_3"
        },
        {
          "Uid": 4,
          "JumpAnchorStringId_KOR": "일단 도망치자!",
          "JumpAnchorStringId_JPN": "この場から逃げよう！",
          "JumpAnchorId": "REWARD_ANCHOR_4"
        }
      ]
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
