        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "감기 기운인가?",
          "JumpAnchorStringId_JPN": "風邪かな？",
          "JumpAnchorStringId_TWN": "是感冒了嗎？"
        }
      ]
    },
    {
