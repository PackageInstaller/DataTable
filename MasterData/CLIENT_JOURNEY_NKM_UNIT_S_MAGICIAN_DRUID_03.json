      "StartFxSoundName": "SFX_CUTSCENE_COMMON_MOVEMENT_FOOT_STEP_05.wav",
      "UnitTalk_KOR": "새빨간 액체를 들고 나왔다.",
      "UnitTalk_JPN": "ボコボコと煮えたぎる真っ赤な液体を持ってきた。",
      "UnitTalk_TWN": "鮮紅液體回來了。",
      "TalkTime": 0.03,
      "TalkAppend": true,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…그게 뭐야?",
          "JumpAnchorStringId_JPN": "…これは何？",
          "JumpAnchorStringId_TWN": "…那是什麼？"
        }
      ]
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "각종 허브와 골든씰, 페퍼민트, 겨울 고추와 서리 고추, 폭탄 고추를 넣고 끓인 <color=#F7BE45>약차</color>예요.",
      "UnitTalk_JPN": "色んなハーブとヒドラスチス、ペパーミント、ウィンターペッパーとフロストペッパー、ボムペッパーを入れて煮込んだ<color=#F7BE45>薬茶</color>です。",
      "UnitTalk_TWN": "這是用各種藥草、金印草、薄荷、冬辣椒、霜辣椒和炸彈辣椒煮成的<color=#F7BE45>藥茶</color>。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_20.ogg"
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "한입 쭉 들이켜세요!",
      "UnitTalk_JPN": "さぁ、一気に飲んでください！",
      "UnitTalk_TWN": "請一口氣喝下去！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_21.ogg"
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "…잔 안에서 빨간 거품이 끊임없이 솟아오른다.",
      "UnitTalk_JPN": "…コップの中には、赤い泡がブクブクと湧き上がっている。",
      "UnitTalk_TWN": "…杯子裡的紅色泡沫不停冒出。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 1.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_DRINKING.wav",
      "UnitTalk_KOR": "기대하듯이 바라보는 다나의 눈앞에서 약차를 단숨에 들이켰다.",
      "UnitTalk_JPN": "期待の眼差しを向けてくるダーナの善意を断れる訳もなく、一気に飲み干した。",
      "UnitTalk_TWN": "在達娜期待的眼神下，我一口氣喝下了藥茶。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.3,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "콜록?! 콜록콜록!!",
          "JumpAnchorStringId_JPN": "がはっ！？げほっげほっ…！",
          "JumpAnchorStringId_TWN": "咳咳？！咳咳咳！！"
        }
      ]
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "어때요, 단장님?",
      "UnitTalk_JPN": "どうですか、団長？",
      "UnitTalk_TWN": "怎麼樣，團長？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_22.ogg"
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…몸이 가벼워졌어!",
          "JumpAnchorStringId_JPN": "…体が軽くなった！",
          "JumpAnchorStringId_TWN": "…我的身體變輕盈了！"
        }
      ]
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "아하하! 그렇죠?",
      "UnitTalk_JPN": "あはは！そうでしょう？",
      "UnitTalk_TWN": "啊哈哈！是吧？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_23.ogg"
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>카파라카</color> 퇴치는 제 전문이에요.",
      "UnitTalk_JPN": "<color=#F7BE45>カパラカ</color>退治は、わたしの得意分野ですから。",
      "UnitTalk_TWN": "擊退<color=#F7BE45>卡帕拉卡</color>是我的專長。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_24.ogg"
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "다음 퇴치법은 시간이 필요해요. 그동안 씻고 나오시겠어요?",
      "UnitTalk_JPN": "さぁ、次の退治には時間がかかりますよ。その間に、団長はシャワーしてきてくださいね。",
      "UnitTalk_TWN": "下一個擊退法需要一點時間。您先去洗個澡如何？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_25.ogg"
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "ANGRY",
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "따뜻한 물로 씻고 나왔더니 방안에 고소한 향기가 가득했다.",
      "UnitTalk_JPN": "温かいシャワーを浴びて戻ると、部屋には香ばしい匂いが満ちていた。",
      "UnitTalk_TWN": "用溫水洗完澡出來後，屋子裡充滿了香噴噴的氣味。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>카파라카</color>의 퇴치법, 그 두번째…",
      "UnitTalk_JPN": "<color=#F7BE45>カパラカ</color>の対処法、その二とは…",
      "UnitTalk_TWN": "<color=#F7BE45>卡帕拉卡</color>的擊退法，第二步…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_26.ogg"
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "<color=#F7BE45>깨끗이 씻은 후에 영양가 높은 음식을 먹는다</color>!",
      "UnitTalk_JPN": "<color=#F7BE45>清潔にした後に、栄養満点の食事を取ること</color>！",
      "UnitTalk_TWN": "就是<color=#F7BE45>洗淨身體後吃營養豐富的食物</color>！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_27.ogg"
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "<color=#F7BE45>카파라카</color>에 걸렸을 때는 몸이 약해지거든요. 소화가 잘 되는 죽이 좋아요.",
      "UnitTalk_JPN": "<color=#F7BE45>カパラカ</color>にかかると、体が弱ってしまいます。",
      "UnitTalk_TWN": "得<color=#F7BE45>卡帕拉卡</color>時身體會變弱，所以吃容易消化的粥最好。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_28.ogg"
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "닭을 끓여 만든 육수에 고향에서 가져온 <color=#F7BE45>해맞이꽃</color> 구근을 넣었어요.",
      "UnitTalk_JPN": "鶏を煮込んだスープに、故郷から持ってきた<color=#F7BE45>ヒノミソウ</color>の球根を入れました。",
      "UnitTalk_TWN": "我用雞煮出的高湯加上從家鄉帶來的<color=#F7BE45>迎日花</color>球莖做的。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_29.ogg"
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>해맞이꽃</color>은 불로장생의 약재라고 불릴 만큼 희귀한 약재이자 고급 식재료랍니다.",
      "UnitTalk_JPN": "<color=#F7BE45>ヒノミソウ</color>は不老不死の薬と呼ばれるほど貴重な薬草で、とっても高級なんですよ。",
      "UnitTalk_TWN": "<color=#F7BE45>迎日花</color>被稱為長生不老的藥材，是非常珍貴的藥材兼高級食材喔。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_30.ogg"
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "자, 단장님. 드셔 보세요.",
      "UnitTalk_JPN": "さあ、召し上がれ。",
      "UnitTalk_TWN": "來，團長。請嚐嚐看。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_31.ogg"
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "한입 먹어보자 닭 육수의 진한 맛, <color=#F7BE45>해맞이꽃</color> 구근의 포근한 식감이 어우러졌다.",
      "UnitTalk_JPN": "ひと口食べると…出汁の深い風味と、<color=#F7BE45>ヒノミソウ</color>のほくほくとした食感が合わさった。",
      "UnitTalk_TWN": "我嚐了一口，雞湯的濃郁味道與<color=#F7BE45>迎日花</color>球莖的柔軟口感完美融合。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…맛있어!",
          "JumpAnchorStringId_JPN": "…美味しい！",
          "JumpAnchorStringId_TWN": "…好吃！"
        }
      ]
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "아하하! 맛있다니 다행이네요.",
      "UnitTalk_JPN": "あはは！それはよかったです。",
      "UnitTalk_TWN": "啊哈哈！聽您說好吃真是太好了。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_32.ogg"
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "제 요리를 대접한 도시 사람은 단장님이 처음이거든요.",
      "UnitTalk_JPN": "都会の人に料理を振る舞うのは、今日が初めてなんです。",
      "UnitTalk_TWN": "團長是第一個吃到我料理的城市人呢。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_33.ogg"
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그럼 마지막으로 넘어갈까요!",
      "UnitTalk_JPN": "それでは、最後の退治法です！",
      "UnitTalk_TWN": "那麼我們進入最後一步吧！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_34.ogg"
    },
    {
