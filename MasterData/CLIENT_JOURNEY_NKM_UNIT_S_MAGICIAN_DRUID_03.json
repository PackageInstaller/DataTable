    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>카파라카</color>는 처음엔 버틸만해도 갈수록 증상이 심해지죠.",
      "UnitTalk_JPN": "<color=#F7BE45>カパラカ</color>は…最初は大丈夫だと思っていても、どんどん悪化していくんです。",
      "UnitTalk_TWN": "<color=#F7BE45>卡帕拉卡</color>一開始雖然還能忍受，但症狀會越來越嚴重。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_15.ogg"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.8,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "최악의 경우, 생명까지 위협해요!",
      "UnitTalk_JPN": "最悪の場合、命にも関わるんですよ！",
      "UnitTalk_TWN": "最糟的情況下，甚至還會危及生命！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_16.ogg"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그렇게 심각할 것까지야.",
          "JumpAnchorStringId_JPN": "大げさだよ。",
          "JumpAnchorStringId_TWN": "不至於那麼嚴重吧。"
        }
      ]
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "안심하세요, 단장님. 저만 믿으세요.",
      "UnitTalk_JPN": "安心してくださいね、団長。わたしを信じてください。",
      "UnitTalk_TWN": "放心，團長。相信我吧。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_17.ogg"
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "이제까지 수많은 <color=#F7BE45>카파라카</color>를 퇴치해왔거든요.",
      "UnitTalk_JPN": "これまで、数多くの<color=#F7BE45>カパラカ</color>を退治してきましたから。",
      "UnitTalk_TWN": "我已經擊退過無數的<color=#F7BE45>卡帕拉卡</color>了。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_18.ogg"
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "저희 드루이드 마을에 내려오는 <color=#F7BE45>카파라카</color>의 퇴치법, 그 첫번째!",
      "UnitTalk_JPN": "ドルイドの村に伝わる、<color=#F7BE45>カパラカ</color>の退治法、その一！",
      "UnitTalk_TWN": "我們德魯伊村流傳的<color=#F7BE45>卡帕拉卡</color>擊退法，第一步！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_19.ogg"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_MOVEMENT_FOOT_STEP_04.wav",
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "주방으로 달려간 다나는 잠시 후 부글부글 끓는 ",
      "UnitTalk_JPN": "小走りでキッチンに向かったダーナは、しばらくすると… ",
      "UnitTalk_TWN": "達娜衝進廚房，不久後端著一碗冒著泡泡的… ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
