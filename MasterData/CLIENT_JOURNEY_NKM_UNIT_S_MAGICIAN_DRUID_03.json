    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "하아… 하아…!",
      "UnitTalk_JPN": "ハァ…ハァ…！",
      "UnitTalk_TWN": "哈啊…哈啊…！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_1.ogg"
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "수고하셨어요, 단장님.",
      "UnitTalk_JPN": "お疲れ様です、団長。",
      "UnitTalk_TWN": "辛苦您了，團長。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_2.ogg"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "…그런데 무슨 일 있으세요? 얼굴색이 안 좋은데요?",
      "UnitTalk_JPN": "…ところで、どうかされましたか？顔色が悪いですよ？",
      "UnitTalk_TWN": "…不過您怎麼了嗎？您的臉色不太好耶？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_3.ogg"
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "감기 기운이 있다고 설명했더니 다나의 표정이 순식간에 진지해졌다.",
      "UnitTalk_JPN": "風邪気味だと伝えた途端、ダーナは真剣な眼差しを向けてきた。",
      "UnitTalk_TWN": "我說明感冒症狀後，達娜的表情立刻變得嚴肅。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "<color=#F7BE45>카파라카</color>예요!",
      "UnitTalk_JPN": "<color=#F7BE45>カパラカ</color>です！",
      "UnitTalk_TWN": "這是<color=#F7BE45>卡帕拉卡</color>！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_4.ogg"
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>카파라카</color>?",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>カパラカ</color>？",
          "JumpAnchorStringId_TWN": "<color=#F7BE45>卡帕拉卡</color>？"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "네! 저희 고향에서 <color=#F7BE45>카파라카</color>라고 부르는 병이에요.",
      "UnitTalk_JPN": "はい！わたしの故郷では、<color=#F7BE45>カパラカ</color>と呼ぶ病気のことです。",
      "UnitTalk_TWN": "對！在我的家鄉被稱為<color=#F7BE45>卡帕拉卡</color>的病。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_5.ogg"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "재채기, 기침, 콧물, 두통, 미열, 그리고 몸이 무거워지죠.",
      "UnitTalk_JPN": "症状としては、くしゃみ、せき、鼻水、頭痛、微熱に加え、身体のだるさがあります。",
      "UnitTalk_TWN": "症狀有打噴嚏、咳嗽、流鼻水、頭痛、微燒，而且身體沉重。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_6.ogg"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "단장님은 <color=#F7BE45>카파라카</color>에 걸린 게 틀림없어요!",
      "UnitTalk_JPN": "つまり、団長は<color=#F7BE45>カパラカ</color>にかかったということです！",
      "UnitTalk_TWN": "團長絕對是得了<color=#F7BE45>卡帕拉卡</color>！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_7.ogg"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그게 감기 아니야?",
          "JumpAnchorStringId_JPN": "風邪とはまた違うの？",
          "JumpAnchorStringId_TWN": "那不就是感冒嗎？"
        }
      ]
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "<color=#F7BE45>카파라카</color>는 잔불과 같죠.",
      "UnitTalk_JPN": "<color=#F7BE45>カパラカ</color>は、<r=ボヤ>小火</r>と同じようなものです。",
      "UnitTalk_TWN": "<color=#F7BE45>卡帕拉卡</color>就像零星的火焰。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_8.ogg"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "가만두면 산불이 돼서 단장님을 괴롭힐 거예요!",
      "UnitTalk_JPN": "放っておくと山火事になって、団長を苦しめます！",
      "UnitTalk_TWN": "要是放著不管就會變成森林大火，折磨著團長啊！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_9.ogg"
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "…한숨 자면 괜찮아질 테니까 걱정하지 않아도 된다고요?",
      "UnitTalk_JPN": "…少し寝れば良くなるから大丈夫、ですか？",
      "UnitTalk_TWN": "…您竟然說睡一覺就會好，要我別擔心？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_10.ogg"
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.1,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "세상에! 도시 사람들은 <color=#F7BE45>카파라카</color>가 얼마나 무서운지 잘 모르는군요!",
      "UnitTalk_JPN": "信じられません！都会の人は、<color=#F7BE45>カパラカ</color>の恐ろしさを分かっていないようですね！",
      "UnitTalk_TWN": "天啊！城市人都不知道<color=#F7BE45>卡帕拉卡</color>有多可怕！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_11.ogg"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "이러고 있을 때가 아니에요…!",
      "UnitTalk_JPN": "こうしてはいられません…！",
      "UnitTalk_TWN": "現在不是說這個的時候…！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_12.ogg"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "어서 가요, 단장님!",
      "UnitTalk_JPN": "はやく行きましょう！",
      "UnitTalk_TWN": "快走吧，團長！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_13.ogg"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "단장님의 집으로!",
      "UnitTalk_JPN": "団長のお部屋に！",
      "UnitTalk_TWN": "回您的住處！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_03_DRUID_14.ogg"
    },
    {
