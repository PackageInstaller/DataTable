    "records": [
        {
            "Id": 24,
            "Message1": "キミは私の戦利品なんだって、\r\nしっかり胸に刻んどいてよ？"
        },
        {
            "Id": 25,
            "Message1": "海を潜って、崖を跳んで！\r\n楽しいことぜーんぶ捕まえちゃお！"
        },
        {
            "Id": 26,
            "Message1": "夢に生き、夢に散る……\r\nそれが巫女の役目なのです。"
        },
        {
            "Id": 27,
            "Message1": "プレーンなんて退屈でしょ？\r\nもっとカオスに着飾らないと！"
        },
        {
            "Id": 28,
            "Message1": "夜風が手で掴めないように、\r\n私はそこにいるわ。"
        },
        {
            "Id": 29,
            "Message1": "ボクはどうでもいいんです。\r\nそれより遺物の美しさを語りましょう！"
        },
        {
            "Id": 30,
            "Message1": "ヒトの子は儚く、愛い。\r\nゆえにわしは、それを癒し、守ろう……。"
        },
        {
            "Id": 31,
            "Message1": "ただ一撃で焼き尽くす。\r\n誰であろうとな。"
        },
        {
            "Id": 32,
            "Message1": "どうぞご用命を。\r\nこの脚で迅速・完璧にこなしてみせます。"
        },
        {
            "Id": 33,
            "Message1": "クトゥグア様の意志を伝える。\r\nそれが私の役目。"
        },
        {
            "Id": 34,
            "Message1": "アンタは、\r\nアタシのことビリッとさせられるかしら？"
        },
        {
            "Id": 35,
            "Message1": "ウルタールには猫が一杯。\r\nだから猫の町って呼ばれてるニャ。"
        },
        {
            "Id": 36,
            "Message1": "加護の魔術、あげる。\r\nぼくのお花、咲かせて～……。"
        },
        {
            "Id": 40,
            "Message1": "こ、怖いのヤダよぉ……\r\nあっち行ってぇ～っ！"
        },
        {
            "Id": 41,
            "Message1": "これがただの炎だと思ったら……\r\n大間違いだ！"
        },
        {
            "Id": 42,
            "Message1": "おまえ、美味しそうだな……？\r\nとりこんで、わたしの力にしてやるぞ……！"
        },
        {
            "Id": 43,
            "Message1": "クトゥルフ様への信仰心が力となる！\r\nわらわは、ルルイエの化身！\r\nさあ、ひれ伏せっ！"
        },
        {
            "Id": 44,
            "Message1": "別世界の扉を開き、\r\nまだ見ぬエクスタシーを探して……！"
        },
        {
            "Id": 45,
            "Message1": "我こそが古の砂漠の女王。 \r\nその力、甘く見てもらっては困るな。"
        },
        {
            "Id": 46,
            "Message1": "もう一度、戦いたいのです。\r\n命燃やすに足る、好敵手と。"
        },
        {
            "Id": 47,
            "Message1": "さあ悦びなさい。\r\n貴方の命を\r\n最上の捧げ物にして差し上げます！"
        },
        {
            "Id": 49,
            "Message1": "アタシとローレンが揃えば\r\n無敵なんだからっ！"
        },
        {
            "Id": 50,
            "Message1": "キミのハートにキャピッとロックオン☆"
        },
        {
            "Id": 51,
            "Message1": "運命とは月が知り、星が描くもの。\r\nわたしはそれを手繰り寄せるだけ。"
        },
        {
            "Id": 52,
            "Message1": "どこまでも膨れ、どこまでも広がっていく。\r\nわたし達も、君も、その一部でしかない。\r\nそれが、宇宙。"
        },
        {
            "Id": 53,
            "Message1": "真なる闇に世界が包まれた時、\r\n混沌が溢れ出す。"
        },
        {
            "Id": 55,
            "Message1": "すべてを塵へと還すこの手で、\r\n誰かを守れるというのなら――。"
        },
        {
            "Id": 56,
            "Message1": "実験を始めよう。\r\n面白い変化を見せてくれよ？"
        },
        {
            "Id": 57,
            "Message1": "ふわふわ綿毛で\r\n安心安全お空からのプレゼント！\r\nお届け物の際は、どうぞごひいきにー！"
        },
        {
            "Id": 59,
            "Message1": "僕の願いはひとつ。\r\nシェルンの幸せだけです。"
        },
        {
            "Id": 60,
            "Message1": "ルルサルカのクール担当。\r\nあーしの歌で、あんたらトバすから。"
        },
        {
            "Id": 61,
            "Message1": "ルルサルカのカオス担当！\r\nみんなタコアゲにしちゃうよ～！"
        },
        {
            "Id": 63,
            "Message1": "少女隊の、リヴァシー。\r\n弓矢、得意。がんばる。"
        },
        {
            "Id": 65,
            "Message1": "アタシの踊り、見つめていてね？\r\n最期の瞬間まで。"
        },
        {
            "Id": 66,
            "Message1": "余の力にみなひれ伏すがよい。\r\nそして――ピカピカを献上するのじゃ！"
        }
    ]
