      "CameraOffset": "TWIN_1",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "스마일, 상황은 어때?",
      "UnitTalk_JPN": "スマイル、状況はどう？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_STRANIS_010.wav"
