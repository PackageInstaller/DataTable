      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "ONE_2",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "…알리시아님은?",
      "UnitTalk_JPN": "…アリシア様は？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_STRANIS_011.wav"
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "아직도 행방불명인가?",
      "UnitTalk_JPN": "まだ行方不明かしら？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_STRANIS_012.wav"
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "ONE_5",
      "UnitMotion": "SAD",
      "UnitEffect": "RADIOS",
      "UnitTalk_KOR": "그게… 전혀 연락이 닿지 않으세요.",
      "UnitTalk_JPN": "それが…全く連絡が取れません。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_NPC_NOA_LISA_007.wav"
    },
