    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "…도착했어.",
      "UnitTalk_JPN": "…着いたわ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_STRANIS_001.wav"
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "아, 정말이네!",
      "UnitTalk_JPN": "お、ようやっとだね！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_001.wav"
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "하아… 겨우 여기까지 오는 데 몇 번이나 죽을 고비를 넘긴 거야?",
      "UnitTalk_JPN": "はぁ…ここまでたどり着くのに、何回死にかけたことか…！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_002.wav"
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "NOA 내부까지 공허체들이 나타나다니 라비스타도 이젠 끝인가 봐.",
      "UnitTalk_JPN": "NOAの内部まで<r=ヴォイドボーン>空虚体</r>が現れるなんて、ラビスターももうおしまいなのかな？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_003.wav"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "그러고 보니 NOA 바깥 도시에서 마지막 연락이 온 게 석 달 전이라고 들었는데.",
      "UnitTalk_JPN": "そういえばさ、他の都市からの連絡も、 3か月前から途絶えちゃってるって話だけど…。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_004.wav"
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "어쩌면 이 행성에서 생존해 있는 건 이 도시 사람들뿐인지도 모르겠네.",
      "UnitTalk_JPN": "考えたくないけど…この星で生き残ってるのって、もうここの都市の人たちだけ…なんてね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_005.wav"
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "갑자기 우울해졌어. 위로해 줘, 스마일.",
      "UnitTalk_JPN": "うう、なんだか悲しくなってきちゃったよー！ 慰めて、スマイルちゃん。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_006.wav"
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "ONE_1",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "바이탈 정상, 심장 박동 수 정상, 혈압계 변동 없음.",
      "UnitTalk_JPN": "バイタル正常値、心拍数正常、血圧の変動も無し。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_SMILE_001.wav"
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "우울하다는 루나의 진술은 거짓.",
      "UnitTalk_JPN": "悲しくなったというルナの発言は嘘。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_SMILE_002.wav"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그러니까 기대지 마, 무거워.",
      "UnitTalk_JPN": "だから寄りかかるの禁止、重い。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_SMILE_003.wav"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "히잉… 스마일은 항상 냉정하다니까.",
      "UnitTalk_JPN": "ひーん…スマイルちゃんっていつもつれないんだから。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_007.wav"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아무튼 여기가 목적지인 거지? ",
      "UnitTalk_JPN": "それはさておき、ここが目的地ってことでいいんだよね？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_008.wav"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "<color=#F7BE45>[여정]</color> 시험을 치를 때 이후로는 처음 와보네.",
      "UnitTalk_JPN": "<color=#F7BE45>「救援の旅」</color>の試験以来だね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_009.wav"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "TRIPLE_1",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "맞아. 이곳, <color=#F7BE45>[디랙의 우물]</color>을 통해서 <color=#F7BE45>[별의 전당]</color>으로 진입할 거야.",
      "UnitTalk_JPN": "そう。ここ、<color=#F7BE45>「ディラックの井戸」</color>から<color=#F7BE45>「星の殿堂」</color>に進入するわ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_STRANIS_002.wav"
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "별의 전당이라…",
      "UnitTalk_JPN": "星の殿堂…ね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_010.wav"
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "기록에 따르면 그곳에 <color=#F7BE45>[별의 구원자]</color>의 유산이 잠들어 있다고 함.",
      "UnitTalk_JPN": "<color=#F7BE45>「星の救援者」</color>の遺産がそこに眠っている…と記録されている。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_SMILE_004.wav"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "<color=#F7BE45>[스텔라 아카이브]</color> 말이지?",
      "UnitTalk_JPN": "<color=#F7BE45>「ステラーアーカイブ」</color>のこと？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_011.wav"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "우리가 여정을 마쳤을 때 깃들었던 힘.",
      "UnitTalk_JPN": "<color=#F7BE45>「救援の旅」</color>でアタシたちが手に入れた力だよね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_012.wav"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "동의.",
      "UnitTalk_JPN": "肯定。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_SMILE_005.wav"
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그곳에 도착하면 더욱 강력한 <color=#F7BE45>[스텔라 아카이브]</color>의 획득 가능성이 있음.",
      "UnitTalk_JPN": "<color=#F7BE45>「星の殿堂」</color>に辿り着ければ、さらに強力な<color=#F7BE45>「ステラーアーカイブ」</color>を入手できる可能性あり。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_SMILE_006.wav"
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "상황이 계획대로 전개될 경우…",
      "UnitTalk_JPN": "計画通りに進行すれば…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_SMILE_007.wav"
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "끝내주는 힘을 얻어서 이 절망적인 전황을 뿅! 하고 바꾸겠다는 거잖아. 맞지?",
      "UnitTalk_JPN": "すっごーい力が手に入って、この絶望的な戦況をひっくり返せるってことだよね？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_013.wav"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그래.",
      "UnitTalk_JPN": "そうよ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_STRANIS_003.wav"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "라비스타에 남은 사람들에겐 우리가 마지막 희망이야.",
      "UnitTalk_JPN": "ラビスターに残る人たちにとって、わたしたちが最後の希望なの。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_STRANIS_004.wav"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그러니까 실패는 용납되지 않아.",
      "UnitTalk_JPN": "だから失敗は許されないわ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_STRANIS_005.wav"
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "CameraOffsetTime": "NR",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "후후, 사람들이 우릴 구원자라고 부르긴 하지만 평소 그 단어에 별 느낌은 없었는데. ",
      "UnitTalk_JPN": "ふふ…今まで救援者って呼ばれても全然ピンとこなかったけど。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_014.wav"
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "이젠 정말로 구원자 비슷한 게 되어 버렸네.",
      "UnitTalk_JPN": "こうなってくると、名実ともに救援者ね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_015.wav"
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "이번 일이 잘 풀리면 아세라 넌 정말 <color=#F7BE45>[별의 구원자]</color>의 재림…",
      "UnitTalk_JPN": "これがうまくいけば<color=#F7BE45>「星の救援者」</color>の再臨…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_016.wav"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "아니, 그를 뛰어넘는 사람으로 불릴지도 몰라.",
      "UnitTalk_JPN": "ううん、それ以上の存在として知られることになるかも。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_017.wav"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그러고 보니 그게 네 꿈이었지? ",
      "UnitTalk_JPN": "確か、それがキミの夢だったよね？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_END_STARLIGHT_01_UNIT_S_VOYAGER_ORACLE_018.wav"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "MAIN_END_STARLIGHT_01_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "축하해 아세라. 어쩌면 이번엔 꿈을 이룰지도 모르겠는걸?",
      "UnitTalk_JPN": "おめでとう、アセラっち。もしかしたら、夢が叶っちゃうかも知れないよ？",
