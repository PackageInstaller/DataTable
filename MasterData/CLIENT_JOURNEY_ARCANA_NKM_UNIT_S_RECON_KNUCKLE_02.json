      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "SAD",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "후아! 이거 진짜 단단히 박혀있네…  ",
      "UnitTalk_JPN": "ふぅ！これ、本当にしっかり刺さってるわね…",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "로베르타?",
