        }
      ]
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "으응? 단장이잖아. ",
      "UnitTalk_JPN": "あれ？団長じゃない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitTalk_KOR": "뭐하고 있냐고? 별 건 아니고…",
      "UnitTalk_JPN": "何してるのかって？別に…",
      "TalkTime": 0.03
    },
    {
      "Uid": 80,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그냥 스트레스가 쌓여서 잠깐 산책을 나왔다가 재미있어 보이는 걸 발견해서 말이야. ",
      "UnitTalk_JPN": "ストレス発散しようと思って散歩してたの。そしたら、面白そうなものを見つけたのよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 82,
      "WaitClick": false,
      "WaitTime": 0.0
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitPos": "POS2",
      "UnitTalk_KOR": "홀홀홀… 다음 도전자가 나타나셨구만 그래.",
      "UnitTalk_JPN": "ホッホッホ…次なる挑戦者が現れたようじゃな。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "도전자…?",
          "JumpAnchorStringId_JPN": "挑戦者…？"
        }
      ]
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "홀홀홀… 그렇다네. ",
      "UnitTalk_JPN": "ホッホッホ…その通りじゃ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitTalk_KOR": "바로 여기에 있는 <color=#F7BE45>전설의 검</color>의 도전자 말일세. ",
      "UnitTalk_JPN": "まさに、ここにある<color=#F7BE45>伝説の剣</color>への挑戦者というわけじゃ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "이 검이 바위에 꽂히게 된 건 아주 오래 전…",
      "UnitTalk_JPN": "この剣が岩に刺さったのは、遥か昔…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitTalk_KOR": "무려 <color=#F7BE45>별의 구원자</color>가 나타나기도 전의 일이지. ",
      "UnitTalk_JPN": "なんと<color=#F7BE45>星の救援者</color>が現れる以前のことなんじゃ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "오늘날에 이르러서는 이름조차 남아있지 않은 무명의 영웅이 세상-",
      "UnitTalk_JPN": "今日に至るまで、名前すら残っておらん無名の英雄が世界を──",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "구구절절 긴 설명은 그쯤 하시고. ",
      "UnitTalk_JPN": "くどい説明はそこまでよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 83,
      "WaitClick": false,
      "WaitTime": -1.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitMotion": "SAD"
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitTalk_KOR": "요약하자면, 이 검을 뽑으면 소원을 하나 들어준다는 전설이래.",
      "UnitTalk_JPN": "要するに、この剣を抜けば願いを一つ叶えてくれるって伝説らしいの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…크흠. 그 말대로일세. ",
      "UnitTalk_JPN": "…コホン。その通りじゃ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitTalk_KOR": "이 검을 뽑는 자, <color=#F7BE45>용사</color>의 자격 있으리니.",
      "UnitTalk_JPN": "この剣を抜く者こそ、<color=#F7BE45>勇者</color>たる資格あり。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitTalk_KOR": "이 노구는 마을 대대로 내려온 전설의 <color=#F7BE45>용사</color>를 찾아 방방곡곡을 유랑하고 있네.",
      "UnitTalk_JPN": "この老いぼれは、村に代々伝わる伝説の<color=#F7BE45>勇者</color>を探してあちこちを放浪しておるんじゃ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "자네도 한번 도전해볼 텐가?",
      "UnitTalk_JPN": "君も挑戦してみるかね？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아, 참고로 도전하려면 소정의 금액을 내야 하네.",
      "UnitTalk_JPN": "ああ、ちなみに挑戦するにはお金を払ってもらわんといかんのじゃ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitTalk_KOR": "<color=#F7BE45>용사 탐색</color>의 후원금이라 생각하게나. ",
      "UnitTalk_JPN": "<color=#F7BE45>勇者探索</color>への支援金だと思うことじゃのう。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "수상한 냄새가 나는데.",
          "JumpAnchorStringId_JPN": "何だか怪しいな。"
        }
      ]
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "예끼! 수, 수상하다니! ",
      "UnitTalk_JPN": "コホン！あ、怪しいと言うのかね！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…진짜인가? 구체적으로 어디가…? ",
      "UnitTalk_JPN": "…本当かの？具体的にどこがじゃ…？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "전체적으로?",
          "JumpAnchorStringId_JPN": "全体的に？"
        }
      ]
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitTalk_KOR": "저, 전체적으로라니… ",
      "UnitTalk_JPN": "ぜ、全体的にじゃと…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "어때 단장, 확실히 조금 수상하긴 해도 재미있어 보이는 게임이지?",
      "UnitTalk_JPN": "どう、団長？確かに少し怪しいけど、面白そうなゲームじゃない？",
      "TalkTime": 0.03
    },
    {
      "Uid": 81,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitTalk_KOR": "단장도 도전해보고 싶으면 줄 서. 내가 먼저 도전할 순서니까.",
      "UnitTalk_JPN": "団長も挑戦したいなら列に並んで。まずは私の番よ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OLD_MALE",
      "UnitNameString": [
        "SI_OLDMAN_SUS"
      ],
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "게임 같은 게 아닐세! <color=#F7BE45>전설의 검</color>이라니까!",
      "UnitTalk_JPN": "ゲームじゃと！<color=#F7BE45>伝説の剣</color>だと言うとるだろう！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "뭐, 아무튼 비슷한 거잖아. ",
      "UnitTalk_JPN": "まあ、とにかく似たようなものでしょ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_KNUCKLE_02",
      "WaitClick": true,
