        }
      ]
    },
    {
      "Uid": 122,
      "WaitClick": false,
      "WaitTime": 0.8,
      "BgFlashBang": 0.5,
      "BgCrash": 0.7,
      "BgCrashTime": 0.7,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_HIT_68.wav"
    },
    {
      "Uid": 123,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_SPELL_DARK_75.wav",
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "검격이 괴한을 반으로 가르자, 괴한의 형체는 순식간에 검은 안개로 화해 허공으로 사라졌다. ",
      "UnitTalk_JPN": "そして剣撃で男を真っ二つに切り裂くと…それは一瞬で黒い霧へと化し、虚空へと消えていった。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 124,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "네가 어떻게…?!",
      "UnitTalk_JPN": "お前、どうやって…！？",
      "TalkTime": 0.03,
      "AutoHighlight": "ON"
    },
    {
      "Uid": 125,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…아슬아슬했네.",
          "JumpAnchorStringId_JPN": "…危なかったな。"
        }
      ]
    },
    {
      "Uid": 126,
