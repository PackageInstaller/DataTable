    {
      "Uid": 90,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "<color=#F7BE45>알아간다</color>고? 나에 대해서?",
      "UnitTalk_JPN": "私のことが、<color=#F7BE45>分かってきた</color>だと？",
      "TalkTime": 0.03
    },
    {
      "Uid": 91,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "네가 나에 대해 뭘 아는데?",
      "UnitTalk_JPN": "お前に何が分かる？",
      "TalkTime": 0.03
    },
    {
      "Uid": 92,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "나도 나에 대해 모르는데, 네가 날 안다고?",
      "UnitTalk_JPN": "私ですら自分のことが分からないのに、お前に私のことが分かるとでも言うのか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 93,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…주제 넘지 마.",
      "UnitTalk_JPN": "…身の程を知れ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 94,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "네가 몇 번을 죽었다 깨어난다 해도-",
      "UnitTalk_JPN": "何度死んで、蘇ったとしても──",
      "TalkTime": 0.03
    },
    {
      "Uid": 95,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "너는 날 이해할 수 없어.",
      "UnitTalk_JPN": "お前には、私を理解できない。",
