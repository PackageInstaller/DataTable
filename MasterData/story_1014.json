      "logic": 6,
      "next": 0
    },
    {
      "param1": "-1",
      "param2": "这个星球上有一种可怕的灾难——月灾。是一种会让普通人随机变成怪物的灾难。我和小梅一起在灾难中保护了当地土著人的村落，人们认为我们是真的下凡神明。",
      "param3": "",
      "param4": "",
      "param5": "",
      "control": -1,
      "id": 101401016,
      "logic": 2,
      "next": 0
    },
    {
      "param1": "2026years02_cg",
