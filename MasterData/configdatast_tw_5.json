  },
  {
    "ID": 15833,
    "Value": "端倪初現"
  },
  {
    "ID": 15834,
    "Value": "肅州之行"
  },
  {
    "ID": 15835,
    "Value": "勇闖石塔"
  },
  {
    "ID": 15836,
    "Value": "危機四伏"
  },
  {
    "ID": 15838,
    "Value": "此地不似凡境，此人似是故人……"
  },
  {
    "ID": 15839,
    "Value": "月黑風高夜，流寇來襲時！"
  },
  {
    "ID": 15856,
    "Value": "數承北斗，遇奇則逆，逢偶便右，始終方違，由兌破陣……"
  },
  {
    "ID": 15863,
    "Value": "堅守五個回合"
  },
  {
    "ID": 15864,
    "Value": "盡可能擊敗更多盜寶賊"
  },
  {
    "ID": 15866,
    "Value": "歷練丹！就是那這個能增加歷練值、提升等級的：<color=#6cf1d0>歷！練！丹！</color>"
  },
  {
    "ID": 15868,
    "Value": "依依不管！依依要吃！"
  },
  {
    "ID": 15869,
    "Value": "咩！依依感覺自己變強了！"
  },
  {
    "ID": 15870,
    "Value": "阿良，如果在旅途中獲得了歷練丹！一定記得要給同伴們噢。"
  },
  {
