    },
    {
      "Uid": 121,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "원하는 게 정확히 뭐야?",
