      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…그거 아니야.",
          "JumpAnchorStringId_JPN": "…それは違うと思うけど。"
        }
      ]
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후. 아무렴 어때요. ",
      "UnitTalk_JPN": "ふふっ。そんなことはどうでもいいですよね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "중요한 건, 저희가 서로를 지켜주는 동료가 되었다는 사실이죠.",
      "UnitTalk_JPN": "重要なのは、私たちがお互いを護る仲間になったという事実ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "동료라. ",
      "UnitTalk_JPN": "仲間か。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL"
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "만약 카르멘을 잃게 된다면 어떤 느낌일지 잠시 상상해 보았다. ",
      "UnitTalk_JPN": "もしカルメンを失えば、どんな気持ちになるだろうかと想像してみた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "…아마 견딜 수 없을 정도로 아프겠지. ",
      "UnitTalk_JPN": "…きっと、耐えられないだろう。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "동료를 잃어버렸을 때, 카르멘 또한 그랬을 것이다. ",
      "UnitTalk_JPN": "仲間を失った時、カルメンも同じ気持ちだったはず。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그런 아픔을 담담히 받아들여야만 했던 그녀가 느끼고 있을 압박 또한 커다랄 것이 분명하다. ",
      "UnitTalk_JPN": "そんな痛みを受け入れるしかなかったカルメンは、かなりのプレッシャーを感じているだろう。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "나는 그 압박이 그녀를 집어삼키지 않기를 바란다. ",
      "UnitTalk_JPN": "私はこのプレッシャーが、カルメンを飲み込んでしまわないことを願った。 ",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true,
