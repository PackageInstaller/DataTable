        "1"
      ],
      "BgFadeInTime": 0.4
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "<color=#F7BE45>벌꿀주</color>가 가득 담긴 잔을 받아 한입에 털어 넣었다. ",
      "UnitTalk_JPN": "<color=#F7BE45>ハチミツ酒</color>がたっぷりと注がれたグラスを持ち、一気に飲み干した。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_6",
      "UnitTalk_KOR": "따스한 기운이 목을 타고 흘러 들어와 온몸에 스며들었다. ",
      "UnitTalk_JPN": "心地よい温かさが喉を通り、全身にじんわりと広がっていった。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "뒤이어 빈 잔에 <color=#F7BE45>벌꿀주</color>를 가득 채워 마신 카르멘은 은은한 미소를 지었다. ",
      "UnitTalk_JPN": "続いて、空になったグラスに<color=#F7BE45>ハチミツ酒</color>をたっぷり注ぎ…飲み干したカルメンは微笑んだ。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_05",
      "WaitClick": false,
      "WaitTime": 0.4,
