      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "그렇게 믿고 있습니다!",
      "UnitTalk_JPN": "そう信じております！",
      "TalkTime": 0.03
