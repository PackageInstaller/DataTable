      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "계속 고민하고 노력했지만, 아직은 모르겠네요.",
