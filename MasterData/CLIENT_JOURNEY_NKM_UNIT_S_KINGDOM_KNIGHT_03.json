      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_TOUCH",
      "UnitTalk_KOR": "그래서! 오늘도 이렇게! 최선을 다하고 있습니다!",
      "UnitTalk_JPN": "ゆえに！今日も！精一杯頑張っております！",
      "TalkTime": 0.03
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그래 그래, 샤를은 정말 잘하고 있어.",
