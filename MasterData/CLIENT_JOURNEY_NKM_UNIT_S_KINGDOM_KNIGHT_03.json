      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "좀 배가 고파진 것 같은데…",
      "UnitTalk_JPN": "少しお腹すいたのですが…",
      "TalkTime": 0.03
    },
