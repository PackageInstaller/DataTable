    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그날 이후 프레이는 약간 풀 죽은 표정으로 말이 없었다.",
      "UnitTalk_JPN": "その日以降、フレイはしょんぼりとした様子で口を開かなかった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 드디어 기운을 얻은 듯 내게 말을 걸었다. ",
      "UnitTalk_JPN": "だが…ついに元気になったのか、私に声をかけてきた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그 사기꾼에게 속은 뒤로 전 오랫동안 반성했습니다.",
      "UnitTalk_JPN": "あの詐欺師に騙されてから、わたくしはしばらく反省していましたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "확실히 이번 일은 제 실책이라 할 수 있겠지요.",
      "UnitTalk_JPN": "今回の件は確かに、わたくしの過ちでした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "하지만… 이 세상만사 나쁜 일이 있으면 좋은 일도 있는 법.",
      "UnitTalk_JPN": "ですが…世の中、悪いことがあれば良いこともあるものです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "비록 사기를 당하긴 했지만 얻은 것도 있습니다.",
      "UnitTalk_JPN": "詐欺には遭ってしまいましたが、得たものもありますの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "행동하기 전에 깊이 생각하는 습관 같은 거?",
          "JumpAnchorStringId_JPN": "行動する前に、深く考える習慣とか？"
        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.2,
      "BgCrashTime": 0.2,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "무슨 헛소리를 하는 겁니까?",
      "UnitTalk_JPN": "戯言はやめてくださいます？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "생각 따위를 하다 보면 중요한 시기를 놓친다는 건 사업의 상식입니다.",
      "UnitTalk_JPN": "あれこれ考えているうちに、重要なタイミングを逃してしまうというのは…ビジネスにおける常識なのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아무튼 <color=#F7BE45>마법 장판</color>은 사기였지만… 그것 말고도 남은 것이 하나 있습니다.",
      "UnitTalk_JPN": "とにかくっ、<color=#F7BE45>魔法のカーペット</color>は詐欺でしたが…ひとつ残ったものがあります。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "설마…",
          "JumpAnchorStringId_JPN": "まさか…"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그렇습니다.",
      "UnitTalk_JPN": "そうですとも。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "바로 <color=#F7BE45>피라미드 판매법</color>이죠.",
      "UnitTalk_JPN": "ずばり、<color=#F7BE45>ピラミッド商法</color>ですっ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "이 판매 시스템의 가진 놀라운 잠재력은 여전히 존재하고 있습니다.",
      "UnitTalk_JPN": "この販売システムは、今でも驚くべき潜在力を持っているんですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "하지만 그거 사기꾼이 알려준 거잖아.",
          "JumpAnchorStringId_JPN": "でも、詐欺師が教えてくれたことだろ？"
        }
      ]
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "후우… 아직도 모르시겠습니까?",
      "UnitTalk_JPN": "ふぅ…まだ分からないのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "시스템에는 죄가 없다는 것을요.",
      "UnitTalk_JPN": "システム自体には罪がないということを。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "저에게 그 가짜 마법 장판을 팔아 치운 놈은 용서할 수 없지만…",
      "UnitTalk_JPN": "わたくしに、偽・魔法のカーペットを売りつけた詐欺師は許せませんが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "그건 어디까지나 사람의 문제!",
      "UnitTalk_JPN": "それはあくまでも、その人が問題だっただけ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "같이 팔아서 같이 번다! 이 얼마나 정의롭고 아름다운 시스템입니까. ",
      "UnitTalk_JPN": "共に売り、共に稼ぐ！なんと真っすぐで美しいシステムなのでしょう。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "<color=#F7BE45>피라미드 판매법</color>에는 죄가 없습니다! ",
      "UnitTalk_JPN": "<color=#F7BE45>ピラミッド商法</color>には罪がありません！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "StartFxSoundName": "SFX_BATTLE_COMMON_POP.wav",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "항상 인간 놈들이 문제인 거죠!",
      "UnitTalk_JPN": "いつも人間が問題なのです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아 그래…",
          "JumpAnchorStringId_JPN": "そ、そうか…"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래서 오늘 피라미드의 첫 주춧돌이 될 파트너를 초대했습니다.",
      "UnitTalk_JPN": "そこで…今日は、ピラミッドの最初の礎となる相棒をお呼びしました。",
      "TalkTime": 0.03
    },
    {
