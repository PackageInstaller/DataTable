      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "그, 그런 걸 원하다니 당치도 않아요…!",
      "UnitTalk_JPN": "そ、そんなものを望むなんて、とんでもないです…！",
      "TalkTime": 0.03
    },
    {
