      "Uid": 84,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "엘리사, 혹시 무거운 거 많이 뽑아봤어?",
          "JumpAnchorStringId_JPN": "エリサ、よく重いものを持ち上げてたりした？"
