      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "네에?! 자, 자신을 위한 이유... 요?!",
