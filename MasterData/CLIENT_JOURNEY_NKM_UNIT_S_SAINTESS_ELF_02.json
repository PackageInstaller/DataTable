      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "다, 단장님? 왜 그러세요?",
