      "TalkTime": 0.03
    },
    {
      "Uid": 58,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "제가 조금이라도 모노리스 교단에 도움이 되는 사람이 되면… 좋겠어요.",
      "UnitTalk_JPN": "少しでも、モノリス教団のお役に立てれば…嬉しいです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
