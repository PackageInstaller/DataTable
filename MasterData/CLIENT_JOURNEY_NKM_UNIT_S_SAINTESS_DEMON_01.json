      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "사, 사이비라니! 이래 봬도 라비스타에서 가장 큰 교단 중 하나라고!",
