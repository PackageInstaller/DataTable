      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_SAINTESS_DEMON_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "미안. 지금은 바빠서.",
          "JumpAnchorStringId_JPN": "ごめん、今忙しくて。"
        }
