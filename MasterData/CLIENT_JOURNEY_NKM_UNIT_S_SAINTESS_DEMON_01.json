        }
      ]
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_SAINTESS_DEMON_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "뭐야, 처음 들어본다는 반응이네.",
      "UnitTalk_JPN": "なによ、初めて聞いたみたいな反応ね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_SAINTESS_DEMON_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "우리 모노리스 교단은 전지전능한 마신, <color=#F7BE45>가프</color>님을 섬기는 종교야.",
      "UnitTalk_JPN": "モノリス教団は、全知全能たる魔神<color=#F7BE45>ガプ</color>様を崇める宗教よ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_SAINTESS_DEMON_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitTalk_KOR": "가프님은 우리를 위해 모든 것을 마련해 두셨다고 해.",
      "UnitTalk_JPN": "ガプ様はうちらのために、すべてを用意してくださったの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_SAINTESS_DEMON_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitTalk_KOR": "시련과 보상, 그리고 성물에 담긴 지혜에 이르기까지.",
      "UnitTalk_JPN": "試練と報酬、それに聖遺物に込められた知恵まで。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_SAINTESS_DEMON_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitTalk_KOR": "그래서 헌금만 꼬박꼬박 내면 무병장수! 운수대통! 부귀영화!",
      "UnitTalk_JPN": "だからお金さえちゃんと納めておけば、無病息災！順風満帆！栄耀栄華！",
      "TalkTime": 0.03
    },
    {
