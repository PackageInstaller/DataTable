      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_SAINTESS_DEMON_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "수상쩍어서 이름은 적지 않았다…",
      "UnitTalk_JPN": "怪しかったため、名前は書かなかった…",
      "TalkTime": 0.03
    },
    {
