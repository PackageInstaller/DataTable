      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이 정도는 이제 가볍게 해내는구나.",
          "JumpAnchorStringId_JPN": "この程度はもう軽くこなせるようになったな。"
        }
      ]
    },
    {
      "Uid": 158,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "다음에는 더 높은 단계로 진행해 보자.",
          "JumpAnchorStringId_JPN": "次はもっとレベルを上げてみよう。"
        }
      ]
    },
    {
      "Uid": 159,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "네, 단장님…",
      "UnitTalk_JPN": "はい、団長さま…",
      "TalkTime": 0.03
    },
    {
      "Uid": 160,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "저… 처음 여정을 시작했을 때에 비해서…",
      "UnitTalk_JPN": "あの…わたし、旅を始めた頃に比べて…",
      "TalkTime": 0.03
    },
    {
      "Uid": 161,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitTalk_KOR": "확실히 강해졌다는 걸 느껴요…",
      "UnitTalk_JPN": "確かに強くなっているのを感じます…",
      "TalkTime": 0.03
    },
    {
      "Uid": 162,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장님 덕분이에요.",
      "UnitTalk_JPN": "団長さまのおかげです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 163,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "세이라가 잘 따라와 줬어.",
          "JumpAnchorStringId_JPN": "セイラがついて来てくれたからだ。"
        }
      ]
    },
    {
      "Uid": 164,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후… 다정하신 분…",
      "UnitTalk_JPN": "ふふ…お優しい方ですね…",
      "TalkTime": 0.03
    },
    {
      "Uid": 165,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitTalk_KOR": "…여정의 끝까지, 잘 부탁드려요, 단장님.",
      "UnitTalk_JPN": "…旅の終わりまで、どうぞよろしくお願いしますね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 236,
      "WaitClick": false,
