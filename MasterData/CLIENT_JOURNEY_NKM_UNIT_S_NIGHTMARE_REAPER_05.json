      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "ANGRY",
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 156,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "훈련이 시작되면 늘 착실하고 진지하게 임했다.",
      "UnitTalk_JPN": "トレーニングが始まるといつも真面目に、真剣に取り組んだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 235,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "NORMAL"
