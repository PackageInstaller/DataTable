      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23B_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
