      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23B_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "그, 그 정도로만 얘기하면 되는 거였어...?",
      "UnitTalk_JPN": "そ、それだけで良かったのか…?",
      "TalkTime": 0.03
    },
    {
