      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23B_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후, 그렇게 자연스러운 게 훨씬 좋다니까요?",
      "UnitTalk_JPN": "ふふっ、自然体の方がずっと良いですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "ContentsTag": "DEV_OPEN",
