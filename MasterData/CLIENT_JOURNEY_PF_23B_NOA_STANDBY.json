      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그럼 단장님, 저희는 먼저 가보겠습니다.",
      "UnitTalk_JPN": "それでは、団長さん。私たちは失礼しますね。",
      "TalkTime": 0.03
    },
