    "NpcId": 13
  },
  {
    "Id": 322302,
    "VoicePlayType": 4,
    "VoiceAssetId": "uniq/22302",
    "Message": "舞護さんは器用なので、\n合成や調合もお手の物っす♪",
    "NpcId": 13
  },
  {
    "Id": 322303,
    "VoicePlayType": 4,
    "VoiceAssetId": "uniq/22303",
    "Message": "アイテム生成のご依頼っすね？\nおまかせくださいっす！",
    "NpcId": 13
  },
  {
    "Id": 322304,
    "VoicePlayType": 5,
    "VoiceAssetId": "uniq/22304",
    "Message": "でりゃりゃりゃりゃりゃっ！",
    "NpcId": 13
  },
  {
    "Id": 322305,
    "VoicePlayType": 5,
    "VoiceAssetId": "uniq/22305",
    "Message": "ここをこうしてー…っと！",
