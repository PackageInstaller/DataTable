[
  {
    "Id": 26001,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26001",
    "Message": "通称、被検体A、アズライトです\nいいお薬が作れたので自分で試してみたら\n記憶が飛んでここにいました\nはて…",
    "NpcId": 11
  },
  {
    "Id": 26002,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26002",
    "Message": "どもどもどうも、アズライトです\nこの辺の草は薬品用に育てています\n香草として使えなくもないですが、\nたぶん後悔すると思います",
    "NpcId": 11
  },
  {
    "Id": 26003,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26003",
    "Message": "カハルに培養液を届ける人をしているアズライトです\n目を離すとすぐに培養液を飲もうとするので、\n止める人も兼任しています\nそういうのを飲むのはこちらのお仕事です",
    "NpcId": 11
  },
  {
    "Id": 26004,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26004",
    "Message": "名探偵、アズライトです\n水槽の中の生物が、たまに減っています\n犯人を探しているのですが、陛下、\nまさかラーメンの具材にしたり、\nしていませんよね？",
    "NpcId": 11
  },
  {
    "Id": 26005,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26005",
    "Message": "エッグ磨き師、アズライトです\n磨いても培養結果に影響はないらしいです\nでも、磨いた方がよいデータがとれそうな\n気がしませんか",
    "NpcId": 11
  },
  {
    "Id": 26021,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26021",
    "Message": "んっ…!? はぁ、やめた方がいいわよ\n髪も肌もベトベトだから",
    "NpcId": 12
  },
  {
    "Id": 26022,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26022",
    "Message": "私を研究したい、というわけね\nその視点はなかったわ\nふむ……",
    "NpcId": 12
  },
  {
    "Id": 26023,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26022",
    "Message": "私に興味があるの？\n好都合ね、私も陛下に興味があるわ…",
    "NpcId": 12
  },
  {
    "Id": 26101,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26001",
    "Message": "ここは空気が極きれいっすねー♪\nなんだか若返った気がするっす！",
    "NpcId": 13
  },
  {
    "Id": 26102,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26002",
    "Message": "カハルさん！それ飲んだらだめっす！\nママ先生に止められてるっすよ！",
    "NpcId": 13
  },
  {
    "Id": 26103,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26003",
    "Message": "以前、この水槽の中を掃除ついでに泳いだっすよね\nそしたら、アズアズさんに\n極おこられてしまったっす…",
    "NpcId": 13
  },
  {
    "Id": 26104,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26004",
    "Message": "舞護的には、ここで魔導まんじゅうを\n栽培したいっすね！\n知らないっすか、魔導まんじゅう！\nやばいおまんじゅうっす！",
    "NpcId": 13
  },
  {
    "Id": 26105,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26005",
    "Message": "予備用のエッグさんたち、\n全員みがきおわってるっす！\nみーんなキラキラっすよ♪",
    "NpcId": 13
  },
  {
    "Id": 26201,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26001",
    "Message": "ここでハイキングできちゃう案件だねー\nやっほー",
    "NpcId": 10
  },
  {
    "Id": 26202,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26002",
    "Message": "かーはるー、なーにしてる案件ー？",
    "NpcId": 10
  },
  {
    "Id": 26203,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26003",
    "Message": "水槽の中の謎生物さ、まじで謎らしいよ\n味も謎だったし、ラーメンの具材にどう？",
    "NpcId": 10
  },
  {
    "Id": 26204,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26004",
    "Message": "この草は食べちゃだめ案件だって\n禁止されると、暴挙もじさなめ案件だよね",
    "NpcId": 10
  },
  {
    "Id": 26205,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26005",
    "Message": "陛下も要る？限りなくコーヒー豆に近い、科学的には全くコーヒー豆ではない、知覚的にはコーヒー豆な何か",
    "NpcId": 10
  },
  {
    "Id": 126021,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26021",
    "Message": "んっ…!? はぁ、やめた方がいいわよ\n髪も肌もベトベトだから",
    "NpcId": 12
  },
  {
    "Id": 126022,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26022",
    "Message": "私を研究したい、というわけね\nその視点はなかったわ\nふむ……",
    "NpcId": 12
  },
  {
    "Id": 126023,
    "VoicePlayType": 2,
    "VoiceAssetId": "uniq/26022",
    "Message": "私に興味があるの？\n好都合ね、私も陛下に興味があるわ…",
    "NpcId": 12
  },
  {
    "Id": 222301,
    "VoicePlayType": 4,
    "VoiceAssetId": "uniq/22301",
    "Message": "このアイテムを生成します\n素材の在庫をチェック中…",
    "NpcId": 11
  },
  {
    "Id": 222302,
    "VoicePlayType": 4,
    "VoiceAssetId": "uniq/22302",
    "Message": "生成、合成、融合、調合…\nどう読んでいただいても結構ですよ",
    "NpcId": 11
  },
  {
    "Id": 222303,
    "VoicePlayType": 4,
    "VoiceAssetId": "uniq/22303",
    "Message": "メイズラボが責任をもって\n生成を実行させていただきます",
    "NpcId": 11
  },
  {
    "Id": 222304,
    "VoicePlayType": 5,
    "VoiceAssetId": "uniq/22304",
    "Message": "レッツ調合！どどーん！",
    "NpcId": 11
  },
  {
    "Id": 222305,
    "VoicePlayType": 5,
    "VoiceAssetId": "uniq/22305",
    "Message": "素材の分量さえ合っていれば\nにゃんこでも出来ちゃいます",
    "NpcId": 11
  },
  {
    "Id": 222306,
    "VoicePlayType": 5,
    "VoiceAssetId": "uniq/22306",
    "Message": "科学の力で、くるくる、ぽーん",
    "NpcId": 11
  },
