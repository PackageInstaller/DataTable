    {
        "Key": "Npc_Audrey",
        "List": [
            {
                "Text": {
                    "Korea": "에구구, 젊은이가 낀 장비가 심상치않아 보이는구먼.",
                    "English": "Ah, your Equipment doesn’t look too reassuring.",
                    "ChineseCh": "哎呀，年轻人穿戴的装备可真不简单啊。",
                    "ChineseTh": "哎呀，年輕人你身上的裝備看起來很不一般。",
                    "Japanese": "ほほう…そこの若いの、装備が普通じゃないな"
                },
                "Sound": {
                    "ChineseTh": "Npc_Audrey_01"
                }
            }
        ]
    },
    {
        "Key": "Npc_Ria",
        "List": [
            {
                "Text": {
                    "Korea": "뭐 필요한거라도 있나요?",
                    "English": "Do you need something?",
                    "ChineseCh": "请问有什么需要吗？",
                    "ChineseTh": "需要什麼嗎？",
                    "Japanese": "何か必要なものでもありますか？"
                },
                "Sound": {
                    "ChineseTh": "Npc_Ria_01"
                }
            }
        ]
    },
    {
        "Key": "Npc_Ria",
        "Type": "Building",
        "List": [
            {
                "Text": {
                    "Korea": "현재 증축이라 바쁘니 잠시 후 다시 오세요.",
                    "English": "We're currently busy expanding. Please come back later.",
                    "ChineseCh": "我现在正忙着扩建，请你一会儿再来吧。",
                    "ChineseTh": "我正忙著擴建，你晚一點再來吧。",
                    "Japanese": "現在増築中ですので、しばらくしてから再度お越しください"
                },
                "Sound": {
                    "ChineseTh": "Npc_Ria_02"
                }
            }
        ]
    },
    {
        "Key": "Npc_Talln",
        "List": [
            {
                "Text": {
                    "Korea": "뭐 필요한거라도 있나?",
                    "English": "Do you need something?",
                    "ChineseCh": "需要什么？",
                    "ChineseTh": "需要什麼嗎？",
                    "Japanese": "何か必要なものはあるか？"
                },
                "Sound": {
                    "ChineseTh": "Npc_Talln_01"
                }
            }
        ]
    },
    {
        "Key": "Npc_Talln",
        "Type": "Building",
        "List": [
            {
                "Text": {
                    "Korea": "증축이라 바쁜거 안보이나? 이따가 다시 오게.",
                    "English": "Can’t you see we’re busy with construction? Come back later.",
                    "ChineseCh": "我正忙着扩建，待会儿再来吧。",
                    "ChineseTh": "沒看到我正忙著擴建嗎？你晚點再來。",
                    "Japanese": "増築中で忙しいんだ、また今度にしてくれ"
                },
                "Sound": {
                    "ChineseTh": "Npc_Talln_02"
                }
            }
        ]
    },
    {
        "Key": "Npc_Equip",
        "List": [
            {
                "Text": {
                    "Korea": "장비 사세요~",
                    "English": "Anyone in need of new Equipment?",
                    "ChineseCh": "卖装备咯～",
                    "ChineseTh": "買點裝備吧~",
                    "Japanese": "装備販売してますよ～"
                }
            }
        ]
    },
    {
        "Key": "Npc_Scarecrow",
        "List": [
            {
                "Text": {
                    "Korea": "쳐봐, 쳐보라고",
                    "English": "Hit me. Hit me, I dare you!",
                    "ChineseCh": "来啊，来打我啊",
                    "ChineseTh": "打我啊，你打打看！",
                    "Japanese": "殴れよ、殴れって"
                }
            },
            {
                "Text": {
                    "Korea": "때릴거야?",
                    "English": "Are you going to actually hit me?",
                    "ChineseCh": "你真的要打我吗？",
                    "ChineseTh": "你要打我嗎？",
                    "Japanese": "殴るの？"
                }
            }
        ]
    },
    {
        "Key": "Npc_Scarecrow",
        "Type": "Damage",
        "List": [
            {
                "Text": {
                    "Korea": "어쭈, 좀 치네?",
                    "English": "Aah!",
                    "ChineseCh": "啊呃！",
                    "ChineseTh": "哎呦，你有兩把刷子嘛！",
                    "Japanese": "ああっ！"
                }
            }
        ]
    },
    {
        "Key": "Npc_Scarecrow",
        "List": [
            {
                "Text": {
                    "Korea": "닭들이 젠되고 있어. 2시간에 한 마리씩!",
                    "English": "Chickens are spawning—one every 2 hours!",
                    "ChineseCh": "鸡群正在刷新，每2小时一只！",
                    "ChineseTh": "雞一直不斷出現，每兩個小時就有一隻！",
                    "Japanese": "鶏は復活している。2時間に1匹ずつ！"
                }
            }
        ]
    },
    {
        "Key": "Npc_Karen",
        "List": [
            {
                "Text": {
                    "Korea": "종을 찾아오시면 재밌는거 알려드릴게요.",
                    "English": "Bring me a bell, and I'll tell you something fun!",
                    "ChineseCh": "如果您能找到铃铛，我就告诉您有趣的事情。",
                    "ChineseTh": "幫我找回我的鐘鈴，我就告訴你一件有趣的事。",
                    "Japanese": "鐘を探して持ってきたら、面白い話を聞かせてあげますよ"
                },
                "Sound": {
                    "ChineseTh": "Npc_Karen_02"
                }
            },
            {
                "Text": {
                    "Korea": "그거 아세요? 닭은 2시간 마다 한마리씩 나타나요.",
                    "English": "Did you know? A chicken appears every 2 hours!",
                    "ChineseCh": "您知道吗？每2小时就会出现一只鸡。",
                    "ChineseTh": "你知道嗎？每兩個小時會出現一隻雞。",
                    "Japanese": "知ってましたか？鶏は2時間ごとに1匹ずつ現れるんですよ"
                },
                "Sound": {
                    "ChineseTh": "Npc_Karen_03"
                }
            }
        ]
    },
    {
        "Key": "Npc_Scarlet",
        "List": [
            {
                "Text": {
                    "Korea": "닭들이 너무 많은 것 같아요. 2시간 마다 한마리씩 어디선가 나타난다구요.",
                    "English": "There are too many chickens! One appears somewhere every 2 hours.",
                    "ChineseCh": "感觉鸡太多了。每隔2小时就会从某个地方冒出来一只。",
                    "ChineseTh": "雞好像太多了，因為每兩個小時就不知道會從哪裡冒出一隻雞。",
                    "Japanese": "鶏が多いですね…でも2時間ごとにどこかで1匹ずつ現れるんですよ"
                },
                "Sound": {
                    "ChineseTh": "Npc_Scarlet_09"
                }
            }
        ]
    },
    {
        "Key": "Npc_Siri",
        "List": [
            {
                "Text": {
                    "Korea": "과일이 귀해서.. 시세가 그때그때 다를 거예요.",
                    "English": "Since fruit is scarce... the price will vary from time to time.",
                    "ChineseCh": "水果很稀缺…行情随时都会变的。",
                    "ChineseTh": "因為水果很稀有…所以每個時期的價格都會有所不同。",
                    "Japanese": "果物はとても希少なもので…相場はその都度変わります。"
                },
                "Sound": {
                    "ChineseTh": "Npc_Siri_02"
                }
            }
        ]
    },
    {
        "Key": "Npc_Karen_Before_Portal",
        "List": [
            {
                "Text": {
                    "Korea": "후훗… 몰래 열어드리는거예요?",
                    "English": "Hehe... I'll sneak it open just for you.",
                    "ChineseCh": "呵呵…要偷偷帮您打开吗？",
                    "ChineseTh": "呵呵…這是偷偷幫你打開的喔！",
                    "Japanese": "ふふっ…こっそり開けちゃいますね？"
                },
                "Sound": {
                    "ChineseTh": "Npc_Karen_05"
                }
            }
        ]
    },
    {
        "Key": "Npc_Karen_After_Portal",
        "List": [
            {
                "Text": {
                    "Korea": "자주 찾아주세요~♥",
                    "English": "Come visit often, okay?",
                    "ChineseCh": "要常来哦~",
                    "ChineseTh": "歡迎常來~♥",
                    "Japanese": "また来てくださいね〜♥"
                },
                "Sound": {
                    "ChineseTh": "Npc_Karen_07"
                }
            },
            {
                "Text": {
                    "Korea": "엄청난 걸 얻을 수 있답니다?",
                    "English": "You never know what kind of treasure you might find!",
                    "ChineseCh": "能得到很厉害的东西哦？",
                    "ChineseTh": "這裡可以得到厲害的獎勵喔！",
                    "Japanese": "とんでもないものが手に入るらしいですよ？"
                },
                "Sound": {
                    "ChineseTh": "Npc_Karen_08"
                }
            }
        ]
    }
]