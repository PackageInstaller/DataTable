    {
        "Key": "Npc_Violet",
        "List": [
            {
                "Text": {
                    "Korea": "그쪽은 사람 많죠? 여긴 한산한데.",
                    "English": "You have a lot of folks there, don’t you? It’s much quieter here in comparison.",
                    "ChineseCh": "你们那边人很多吧？这里太冷清了。",
                    "ChineseTh": "那邊人很多吧？這裡倒是很空曠。",
                    "Japanese": "そちらは混んでますよね？こっちは見ての通りです"
                },
                "Sound": {
                    "Korea": "V_바이올렛_그쪽은사람많죠",
                    "ChineseTh": "Npc_Violet_02"
                }
            },
            {
                "Text": {
                    "Korea": "여관에서 한잔 하세요.",
                    "English": "Have a drink at the inn.",
                    "ChineseCh": "去旅馆喝一杯吧。",
                    "ChineseTh": "去旅館喝一杯吧。",
                    "Japanese": "宿で一杯していってください"
                },
                "Sound": {
                    "Korea": "V_바이올렛_여관에서",
                    "ChineseTh": "Npc_Violet_03"
                }
            },
            {
                "Text": {
                    "Korea": "(무시)",
                    "English": "(Ignore)",
                    "ChineseCh": "(无视)",
                    "ChineseTh": "(無視。)",
                    "Japanese": "(無視)"
                },
                "Sound": {
                    "ChineseTh": "Npc_Violet_04"
                }
            }
        ]
    },
