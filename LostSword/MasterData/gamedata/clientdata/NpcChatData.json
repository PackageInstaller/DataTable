    {
        "Key": "Npc_Jessie",
        "List": [
            {
                "Text": {
                    "Korea": "저 남자친구 있어요.",
                    "English": "I have a boyfriend.",
                    "ChineseCh": "我已经有男朋友了。",
                    "ChineseTh": "我有男朋友了。",
                    "Japanese": "悪いね、私彼氏いるんだ"
                },
                "Sound": {
                    "Korea": "V_제시_저남자친구",
                    "ChineseTh": "Npc_Jessie_02"
                }
            },
            {
                "Text": {
                    "Korea": "죄송한데, 바쁘거든요.",
                    "English": "Sorry, but I’m busy.",
                    "ChineseCh": "不好意思，我很忙。",
                    "ChineseTh": "不好意思，但我很忙。",
                    "Japanese": "悪いけど、取込み中なんで"
                },
                "Sound": {
                    "Korea": "V_제시_죄송한데",
                    "ChineseTh": "Npc_Jessie_03"
                }
            },
            {
                "Text": {
                    "Korea": "아 네, 도 안믿어요~",
                    "English": "Uh, okay? I don’t believe you.",
                    "ChineseCh": "啊，我才不信你呢～",
                    "ChineseTh": "是是是，我不信教~",
                    "Japanese": "あはい。セミナーとか興味ないんで"
                },
                "Sound": {
                    "Korea": "V_제시_아네도",
                    "ChineseTh": "Npc_Jessie_04"
                }
            }
        ]
    },
