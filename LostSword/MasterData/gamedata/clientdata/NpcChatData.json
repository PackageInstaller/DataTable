[
    {
        "Key": "Npc_Merry",
        "List": [
            {
                "Text": {
                    "Korea": "이 마을은 왜 이렇게 손님이 없을까여?",
                    "English": "Why is this town so void of any customers?",
                    "ChineseCh": "为什么村子里都没有什么客人呢？",
                    "ChineseTh": "這個村莊怎麼都沒有客人？",
                    "Japanese": "この村はどうしてこんなにお客さんが少ないのでしょうか？"
                },
                "Sound": {
                    "ChineseTh": "Npc_Merry_02"
                }
            },
            {
                "Text": {
                    "Korea": "이렇게 한적하면 적자야 적자..",
                    "English": "The town has too few customers... At this rate, I'll be losing more money than I make...",
                    "ChineseCh": "这么冷清只有亏本的命…",
                    "ChineseTh": "生意這麼冷清，我可要虧本了…",
                    "Japanese": "こんなに暇だと赤字になっちゃいますよん…"
                },
                "Sound": {
                    "ChineseTh": "Npc_Merry_03"
                }
            },
            {
                "Text": {
                    "Korea": "저는 특산물을 팔아여!",
                    "English": "I sell special products!",
                    "ChineseCh": "正在兜售特产！",
                    "ChineseTh": "這裡有賣特產喔！",
                    "Japanese": "メリーは特産品を扱っていますよん！"
                },
                "Sound": {
                    "ChineseTh": "Npc_Merry_04"
                }
            }
        ]
    },
    {
        "Key": "Npc_Merry",
        "Type": "Damage",
        "List": [
            {
                "Text": {
                    "Korea": "아악~ 살인자가 나타났어요.",
                    "English": "Ah! The killer has appeared!",
                    "ChineseCh": "呃啊～杀人啦。",
                    "ChineseTh": "呃啊~殺人犯出現了！",
                    "Japanese": "ああっ、殺人者が現れました"
                },
                "Sound": {
                    "ChineseTh": "Npc_Merry_05"
                }
            }
        ]
    },
    {
        "Key": "Npc_Merry",
        "Type": "Thumble",
        "List": [
            {
                "Text": {
                    "Korea": "아! 아파라. 창피해 죽겠네.",
                    "English": "Ow! That hurts... how embarrassing...",
                    "ChineseCh": "啊！好痛。丢死人了。",
                    "ChineseTh": "啊！好痛，真丟臉。",
                    "Japanese": "い！痛い…恥ずかしい"
                },
                "Sound": {
                    "ChineseTh": "Npc_Merry_06"
                }
            }
        ]
    },
    {
        "Key": "Npc_Nimue",
        "List": [
            {
                "Text": {
                    "Korea": "이 마을이 생긴지는 오래되지 않았어요.",
                    "English": "It hasn’t been long since this town was established.",
                    "ChineseCh": "这个村庄建立的时间并没有很久。",
                    "ChineseTh": "這座村莊才剛建立沒多久。",
                    "Japanese": "この村ができたのは最近のことだと聞いてます"
                },
                "Sound": {
                    "ChineseTh": "Npc_Nimue_02"
                }
            },
            {
                "Text": {
                    "Korea": "길드에 가입하면 길드원들을 부를 수 있어요.",
                    "English": "If you join a Guild, you can call Guild Members to assist you.",
                    "ChineseCh": "加入公会的话，就可以召唤公会成员了。",
                    "ChineseTh": "加入公會後，就可以呼叫公會成員了。",
                    "Japanese": "ギルドに加入したらギルドメンバーを呼べますよ"
                },
                "Sound": {
                    "ChineseTh": "Npc_Nimue_03"
                }
            }
        ]
    },
    {
        "Key": "Npc_Scarlet",
        "List": [
            {
                "Text": {
                    "Korea": "어머, 다음에 얘기해요.",
                    "English": "Let’s talk next time.",
                    "ChineseCh": "哎呀，下次再说吧。",
                    "ChineseTh": "哎呀，下次再聊吧。",
                    "Japanese": "あら、また今度お話しましょう"
                },
                "Sound": {
                    "Korea": "V_스칼렛_어머다음에",
                    "ChineseTh": "Npc_Scarlet_02"
                }
            },
            {
                "Text": {
                    "Korea": "귀찮게 하지 마세요.",
                    "English": "Stop bothering me.",
                    "ChineseCh": "别来烦我。",
                    "ChineseTh": "不要煩我。",
                    "Japanese": "しつこいです"
                },
                "Sound": {
                    "Korea": "V_스칼렛_귀찮게",
                    "ChineseTh": "Npc_Scarlet_03"
                }
            },
            {
                "Text": {
                    "Korea": "매너없게 무기를 들고 다니면 어떡해요?",
                    "English": "How rude of you to carry that weapon around.",
                    "ChineseCh": "怎么能这么没礼貌地拿着武器到处走动呢？",
                    "ChineseTh": "你怎麼可以這麼沒禮貌地拿著武器閒晃？",
                    "Japanese": "ここでの武器の持ち込みはマナー違反ですよ"
                },
                "Sound": {
                    "Korea": "V_스칼렛_매너없게무기를",
                    "ChineseTh": "Npc_Scarlet_04"
                }
            }
        ]
    },
    {
        "Key": "Npc_Scarlet",
        "Type": "Damage",
        "List": [
            {
                "Text": {
                    "Korea": "뭐하는 짓이에요?!",
                    "English": "What do you think you are doing?",
                    "ChineseCh": "你在做什么啊？",
                    "ChineseTh": "你這是在做什麼？！",
                    "Japanese": "何事ですか？"
                },
                "Sound": {
                    "Korea": "V_스칼렛_뭐하는짓이에요",
                    "ChineseTh": "Npc_Scarlet_07"
                }
            }
        ]
    },
