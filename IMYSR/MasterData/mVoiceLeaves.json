{
    "name": "mVoiceLeaves",
    "data": [
        {
            "id": 1,
            "mUnitId": 1,
            "mDressId": null,
            "filePath": "vo_001_mypage_07_1",
            "faceId": 1,
            "text": "武器防具の手入れは、しすぎて損をすることはありません。どうぞ、お構いなく……ごしごし……ちらっ",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 2,
            "mUnitId": 2,
            "mDressId": null,
            "filePath": "vo_002_mypage_07_1",
            "faceId": 1,
            "text": "わたくしは聖神官。冥界の王に惹かれるなど、あってはならないこと。ですが、ですが……！",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 3,
            "mUnitId": 3,
            "mDressId": null,
            "filePath": "vo_003_mypage_07_1",
            "faceId": 1,
            "text": "どうぞ私のことはお気になさらず。お傍に控えておりますので、気が向いたらお声を掛けてくださいませ",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 4,
            "mUnitId": 4,
            "mDressId": null,
            "filePath": "vo_004_mypage_07_1",
            "faceId": 1,
            "text": "おーい、めーおー！　無視すんなー！　魔術使って、部屋ごとぶっとばすぞー！",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 5,
            "mUnitId": 5,
            "mDressId": null,
            "filePath": "vo_005_mypage_07_1",
            "faceId": 1,
            "text": "ご主人様？　もしや、わたくしの料理で気を失って……？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 6,
            "mUnitId": 6,
            "mDressId": null,
            "filePath": "vo_006_mypage_07_1",
            "faceId": 1,
            "text": "おーい、にーさん？　寝てるのー？　じゃあ、にーさんの膝でワタシも寝ちゃうからね？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 7,
            "mUnitId": 7,
            "mDressId": null,
            "filePath": "vo_007_mypage_07_1",
            "faceId": 1,
            "text": "ああ、気にしないでくれ。盾を磨いているぶんにはいくらでも待てるから",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 8,
            "mUnitId": 8,
            "mDressId": null,
            "filePath": "vo_008_mypage_07_1",
            "faceId": 1,
            "text": "あ、あれれ？　冥王様？　お疲れですか？　おーい、冥王様ー？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 9,
            "mUnitId": 9,
            "mDressId": null,
            "filePath": "vo_009_mypage_07_1",
            "faceId": 1,
            "text": "冥王、冥王ー？　私のこと、忘れてないよね？　もう、けっこう寂しいんだからね",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 10,
            "mUnitId": 10,
            "mDressId": null,
            "filePath": "vo_010_mypage_07_1",
            "faceId": 1,
            "text": "ちょっと冥王様？　私を放置するなんてどういう事かしら？　ほら、立って。一緒に錬金術の研究をしましょう！",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 11,
            "mUnitId": 11,
            "mDressId": null,
            "filePath": "vo_011_mypage_07_1",
            "faceId": 1,
            "text": "冥王さまー？　相手をしてくれないと、私、ちょっぴり泣いちゃいますよー？　面倒くさいですよー？　いいんですかー？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 12,
            "mUnitId": 12,
            "mDressId": null,
            "filePath": "vo_012_mypage_07_1",
            "faceId": 1,
            "text": "あ、あのあの、旦那さま？　うう、お忙しいのでしょうか……でも、集中している旦那さまも素敵でございます……",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 13,
            "mUnitId": 13,
            "mDressId": null,
            "filePath": "vo_013_mypage_07_1",
            "faceId": 1,
            "text": "冥王様？　もしかして、寝ていませんか？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 14,
            "mUnitId": 14,
            "mDressId": null,
            "filePath": "vo_014_mypage_07_1",
            "faceId": 1,
            "text": "冥王殿？　その、たまには話していただけないと……寂しいであります",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 15,
            "mUnitId": 15,
            "mDressId": null,
            "filePath": "vo_015_mypage_07_1",
            "faceId": 1,
            "text": "めーおーさま？　ファム、お隣にいますよ？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 16,
            "mUnitId": 16,
            "mDressId": null,
            "filePath": "vo_016_mypage_07_1",
            "faceId": 1,
            "text": "にゃー……にゃー……冥王さま、ワタシ、暇。猫じゃらしで遊んで",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 17,
            "mUnitId": 17,
            "mDressId": null,
            "filePath": "vo_017_mypage_07_1",
            "faceId": 1,
            "text": "冥王さま―……退屈してるクルちゃん、可哀相じゃないですか？　助けてくださいよー……",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 18,
            "mUnitId": 18,
            "mDressId": null,
            "filePath": "vo_018_mypage_07_1",
            "faceId": 1,
            "text": "ねー、センセー、どっか遊びに行こうよー……センセーと一緒じゃなきゃ、つまんないー！",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 19,
            "mUnitId": 19,
            "mDressId": null,
            "filePath": "vo_019_mypage_07_1",
            "faceId": 1,
            "text": "むう……待つのは苦手じゃ、寂しい！　冥王、我の相手をせよ！　でないと、延々と駄々をこねる！",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 20,
            "mUnitId": 20,
            "mDressId": null,
            "filePath": "vo_020_mypage_07_1",
            "faceId": 1,
            "text": "冥王、黙らないで、相手してよ。……私、あなたに構ってもらえないのだけは、すごく寂しい",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 21,
            "mUnitId": 21,
            "mDressId": null,
            "filePath": "vo_021_mypage_07_1",
            "faceId": 1,
            "text": "め・い・お・う？　お姫様を放置するなんて、論外ですわ。お詫びとして、私をデートに誘ってくれませんこと？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 22,
            "mUnitId": 22,
            "mDressId": null,
            "filePath": "vo_022_mypage_07_1",
            "faceId": 1,
            "text": "冥王さーん？　うう、ボクが相手じゃ退屈なのかな……冥王さーん、構ってくださいよー",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 23,
            "mUnitId": 102,
            "mDressId": null,
            "filePath": "vo_102_mypage_07_1",
            "faceId": 1,
            "text": "もしかして冥王さま、居眠り中ですか？　これはもしやイタズラしちゃうチャンス！？　そろーり、そろーり……",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 24,
            "mUnitId": 24,
            "mDressId": null,
            "filePath": "vo_024_mypage_07_1",
            "faceId": 1,
            "text": "はぁ……退屈だけはご免だねえ。冥王、なんとかしておくれよ……",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 25,
            "mUnitId": 23,
            "mDressId": null,
            "filePath": "vo_023_mypage_07_1",
            "faceId": 1,
            "text": "冥王ー、めーいーおーうー！　たーいーくーつー！　どこか連れてってー！",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 26,
            "mUnitId": 103,
            "mDressId": null,
            "filePath": "vo_103_mypage_07_1",
            "faceId": 1,
            "text": "め、冥王さまー？　お眠りでしょうか？　……では、毛布をかけておきますね",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 27,
            "mUnitId": 25,
            "mDressId": null,
            "filePath": "vo_025_mypage_07_1",
            "faceId": 1,
            "text": "退屈してきましたね。よろしければ冥界を案内してくれませんか？　まだ知らないところも多いので。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 28,
            "mUnitId": 26,
            "mDressId": null,
            "filePath": "vo_026_mypage_07_1",
            "faceId": 1,
            "text": "ふぁぁ……あ、すみません。保健室が平和すぎて、つい欠伸が。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 29,
            "mUnitId": 51,
            "mDressId": null,
            "filePath": "vo_051_mypage_07_1",
            "faceId": 1,
            "text": "こちらの世界の歴史や政治について学んでいました。様々な国があるのですね……。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 30,
            "mUnitId": 52,
            "mDressId": null,
            "filePath": "vo_052_mypage_07_1",
            "faceId": 1,
            "text": "……ん？　あれれ！？　私寝てました？　いえいえいえ、居眠りなんてしませんよ！？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 31,
            "mUnitId": 53,
            "mDressId": null,
            "filePath": "vo_053_mypage_07_1",
            "faceId": 1,
            "text": "冥王さん？　冥王さーん？　寝ちゃったのかな……？　毛布、持ってきますね。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 32,
            "mUnitId": 54,
            "mDressId": null,
            "filePath": "vo_054_mypage_07_1",
            "faceId": 1,
            "text": "冥王さん、目を閉じて考えに耽ってますね……あの、冥王さん？　もしかして寝てます？　冥王さん？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 33,
            "mUnitId": 27,
            "mDressId": null,
            "filePath": "vo_027_mypage_07_1",
            "faceId": 1,
            "text": "ふぁぁ……ねえハデス、何かしようよ、退屈だよー",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 34,
            "mUnitId": 55,
            "mDressId": null,
            "filePath": "vo_055_mypage_07_1",
            "faceId": 1,
            "text": "こっちの世界にも紅茶があるのね。しかもなかなか美味しいわ。これはポリンにもらった茶葉なの。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 35,
            "mUnitId": 56,
            "mDressId": null,
            "filePath": "vo_056_mypage_07_1",
            "faceId": 1,
            "text": "この不思議な色の空を眺めているだけで、あっと言う間に時間が過ぎて行っちゃうんです。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 36,
            "mUnitId": 57,
            "mDressId": null,
            "filePath": "vo_057_mypage_07_1",
            "faceId": 1,
            "text": "さーて、十分休んだし、そろそろ鍛錬しなくちゃ。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 37,
            "mUnitId": 58,
            "mDressId": null,
            "filePath": "vo_058_mypage_07_1",
            "faceId": 1,
            "text": "冥界はのどかでございますねえ。皇国でもこのように穏やかな時間が過ごせるようになればいいのですが。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 38,
            "mUnitId": 28,
            "mDressId": null,
            "filePath": "vo_028_mypage_07_1",
            "faceId": 1,
            "text": "冥王様はきっと、何かお考え中か、瞑想をなさっているのでしょう。お邪魔しないよう静かにしなくては。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 39,
            "mUnitId": 1,
            "mDressId": 601101,
            "filePath": "vo_601101_mypage_07_2",
            "faceId": 1,
            "text": "主の傍に常に控えておりますので、いつでもお声掛けください",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 40,
            "mUnitId": 29,
            "mDressId": null,
            "filePath": "vo_029_mypage_07_1",
            "faceId": 1,
            "text": "あ、大丈夫ですよ冥王さま。どうぞごゆっくり。わたしはわたしで、ゴーレムを改造してますので。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 41,
            "mUnitId": 2,
            "mDressId": 602301,
            "filePath": "vo_602301_mypage_07_2",
            "faceId": 1,
            "text": "竪琴で、心が落ち着く曲を弾いていますね。どうぞごゆっくりお過ごしください",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 42,
            "mUnitId": 12,
            "mDressId": 612401,
            "filePath": "vo_612401_mypage_07_2",
            "faceId": 1,
            "text": "旦那さまがお忙しいときは、じっと待つのも妻の仕事ですから",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 43,
            "mUnitId": 59,
            "mDressId": null,
            "filePath": "vo_059_mypage_07_1",
            "faceId": 1,
            "text": "うう……だんだん眠くなってきてしまいました。何か喋ってくれないと寝てしまいますよー（涙）",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 44,
            "mUnitId": 60,
            "mDressId": null,
            "filePath": "vo_060_mypage_07_1",
            "faceId": 1,
            "text": "おい、何か言ってくれ。黙ったままでいられると不安になる。なんでもいいから、頼む。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 45,
            "mUnitId": 14,
            "mDressId": 614101,
            "filePath": "vo_614101_mypage_07_2",
            "faceId": 1,
            "text": "銃は日頃の手入れが大切であります。どうぞ冥王殿はご自分のやるべきことをなさってください",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 46,
            "mUnitId": 61,
            "mDressId": null,
            "filePath": "vo_061_mypage_07_1",
            "faceId": 1,
            "text": "そわそわ、そわそわ（口に出してください）　……あの、私に不手際があったのでしょうか？　何か言っていただけると嬉しいのですが。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 47,
            "mUnitId": 62,
            "mDressId": null,
            "filePath": "vo_062_mypage_07_1",
            "faceId": 1,
            "text": "何もしないの？　なら、ワタシ帰る。やるべき事があるから。",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 48,
            "mUnitId": 6,
            "mDressId": 606201,
            "filePath": "vo_606201_mypage_07_2",
            "faceId": 1,
            "text": "ふわあぁ……あ、だいじょーぶだいじょーぶ。ワタシここで寝てるからさ。すやぁ……",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 49,
            "mUnitId": 23,
            "mDressId": 623501,
            "filePath": "vo_623501_mypage_07_2",
            "faceId": 1,
            "text": "ねーねー冥王ってば、なにしてんのー？　私暇なんだけどー",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 50,
            "mUnitId": 4,
            "mDressId": 604301,
            "filePath": "vo_604301_mypage_07_2",
            "faceId": 1,
            "text": "んー？　こっちはこっちで本読んでるから、そっちも好きにすれば",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 51,
            "mUnitId": 18,
            "mDressId": 618501,
            "filePath": "vo_618501_mypage_07_2",
            "faceId": 1,
            "text": "センセーセンセー！　えへへ、呼んだだけ～♪",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 52,
            "mUnitId": 22,
            "mDressId": 622201,
            "filePath": "vo_622201_mypage_07_2",
            "faceId": 1,
            "text": "そろそろ冥王さんが話しかけてくれると読んでたんですが……ボクが先に声かけちゃいました",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 53,
            "mUnitId": 26,
            "mDressId": 626401,
            "filePath": "vo_626401_mypage_07_2",
            "faceId": 1,
            "text": "どうぞ、為すべきことをなさってください。お互い人生は長いですもの。いつまでもお待ちしておりますよ",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 54,
            "mUnitId": 21,
            "mDressId": 621301,
            "filePath": "vo_621301_mypage_07_2",
            "faceId": 1,
            "text": "平和は１日にして成らず。慌てず焦らず、時にはしっかり休みながらまいりましょう",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 55,
            "mUnitId": 5,
            "mDressId": 605101,
            "filePath": "vo_605101_mypage_07_2",
            "faceId": 1,
            "text": "ご主人様、ゆっくりお考えください。わたくしは、常に傍におりますので",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 56,
            "mUnitId": 16,
            "mDressId": 616501,
            "filePath": "vo_616501_mypage_07_2",
            "faceId": 1,
            "text": "冥王さま忙しそうだから店番はワタシがやっておく。買い出しに行きたいから、代われそうなら言ってね",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 57,
            "mUnitId": 30,
            "mDressId": null,
            "filePath": "vo_030_mypage_07_1",
            "faceId": 1,
            "text": "冥王さまー？　冥王さまー？　せっかく一緒にいるんですから、お話ししましょうよ～",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 58,
            "mUnitId": 3,
            "mDressId": 603401,
            "filePath": "vo_603401_mypage_07_2",
            "faceId": 3,
            "text": "冥王様、冥王様？　そろそろお休みですか？　よろしければ、ベッドにお運びいたしますよ",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 59,
            "mUnitId": 15,
            "mDressId": 615201,
            "filePath": "vo_615201_mypage_07_2",
            "faceId": 1,
            "text": "あっちの畑をたがやしてきますね。そうそう、雑草取りもしないといけません",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 60,
            "mUnitId": 20,
            "mDressId": 620101,
            "filePath": "vo_620101_mypage_07_2",
            "faceId": 1,
            "text": "別に、無理に話してくれなくていい。私、冥王の顔を見てるだけで幸せだから",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 61,
            "mUnitId": 30,
            "mDressId": null,
            "filePath": "amv030_a79_04380",
            "faceId": 1,
            "text": "冥王さまっ、せっかくの冥界フェスなんですからもっと楽しまないと！　ほらほら、いっしょに回りましょう！",
            "startAt": "2023-08-01 12:00:00",
            "endAt": "2023-08-14 12:59:59"
        },
        {
            "id": 62,
            "mUnitId": 26,
            "mDressId": null,
            "filePath": "amv026_a79_00950",
            "faceId": 1,
            "text": "冥界フェスが始まってから、冥王様からの強い視線を感じます。……もう、いけない子にはあとでお仕置きですからね",
            "startAt": "2023-08-01 12:00:00",
            "endAt": "2023-08-14 12:59:59"
        },
        {
            "id": 63,
            "mUnitId": 27,
            "mDressId": null,
            "filePath": "amv027_a79_03190",
            "faceId": 1,
            "text": "冥界フェスでおいしそうな屋台みつけたよ。かき氷に串焼きに焼きもろこしだって！　ねえねえ、食べにいこうよ～",
            "startAt": "2023-08-01 12:00:00",
            "endAt": "2023-08-14 12:59:59"
        },
        {
            "id": 64,
            "mUnitId": 28,
            "mDressId": null,
            "filePath": "amv028_a79_02790",
            "faceId": 1,
            "text": "冥界フェスのお仕事お疲れ様です。あちらの木陰で少し休んでいきませんか？　私でよろしければ膝枕をいたしますよ",
            "startAt": "2023-08-01 12:00:00",
            "endAt": "2023-08-14 12:59:59"
        },
        {
            "id": 65,
            "mUnitId": 13,
            "mDressId": 613401,
            "filePath": "vo_613401_mypage_07_2",
            "faceId": 1,
            "text": "私は鍛練しておりますので、一段落ついたらお声掛けください",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 66,
            "mUnitId": 25,
            "mDressId": 625201,
            "filePath": "vo_625201_mypage_07_2",
            "faceId": 1,
            "text": "思案に耽るもの良いですが、休息も大事ですよ。私と一緒に昼寝でもしますか？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 67,
            "mUnitId": 9,
            "mDressId": 609501,
            "filePath": "vo_609501_mypage_07_2",
            "faceId": 3,
            "text": "ふああ……ちょっと寝てるね。ダンサーには適度な休息も必要だし",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 68,
            "mUnitId": 19,
            "mDressId": 619301,
            "filePath": "vo_619301_mypage_07_2",
            "faceId": 3,
            "text": "お、おお……すまんすまん、寝ておったわ。あくびで火を吹いて、その辺を燃やしたりしてないか？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 69,
            "mUnitId": 17,
            "mDressId": 617101,
            "filePath": "vo_617101_mypage_07_2",
            "faceId": 5,
            "text": "うっさうっさぴょーん、うっさうっさぴょーん……冥王さまが構ってくれなくても、１人で練習！　うっさうっさぴょーん！",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 70,
            "mUnitId": 11,
            "mDressId": 611401,
            "filePath": "vo_611401_mypage_07_2",
            "faceId": 2,
            "text": "冥王さまが見てないうちに、部屋をスライムの絵で埋め尽くしてみましょう……なんて、冗談ですよ、冗談♪",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 71,
            "mUnitId": 24,
            "mDressId": 624201,
            "filePath": "vo_624201_mypage_07_2",
            "faceId": 1,
            "text": "んー？　アタシは一人で飲んでるからさ、気にしないでそっちものんびりしなよ",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 72,
            "mUnitId": 25,
            "mDressId": 628501,
            "filePath": "vo_628501_mypage_07_2",
            "faceId": 1,
            "text": "お時間があるのでしたら、一緒に猫様を見に行きませんか？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 73,
            "mUnitId": 10,
            "mDressId": 610301,
            "filePath": "vo_610301_mypage_07_2",
            "faceId": 1,
            "text": "錬金鍋をかき混ぜるときは、余計なことは考えず、一心不乱に、一心不乱に……",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 74,
            "mUnitId": 7,
            "mDressId": 607101,
            "filePath": "vo_607101_mypage_07_2",
            "faceId": 1,
            "text": "今日は待機かな？　なら、防具の手入れでもしておこう。それともお茶でも入れるかい？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 75,
            "mUnitId": 8,
            "mDressId": 608501,
            "filePath": "vo_608501_mypage_07_2",
            "faceId": 1,
            "text": "明日はあの孤児院に行って、明後日は療養所で……やることいっぱいありますね",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 76,
            "mUnitId": 27,
            "mDressId": 627301,
            "filePath": "vo_627301_mypage_07_2",
            "faceId": 1,
            "text": "ねえハデスー、暇なんだけどー。かまってよー",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 77,
            "mUnitId": 12,
            "mDressId": null,
            "filePath": "amv012_a83_00340",
            "faceId": 1,
            "text": "その、わたし、キラキラ輝くアイドルになれていますか？　……いいえ、絶対になってみせます。見ていてくださいね旦那さまっ！",
            "startAt": "2024-07-31 12:00:00",
            "endAt": "2024-08-22 12:59:59"
        },
        {
            "id": 78,
            "mUnitId": 16,
            "mDressId": null,
            "filePath": "amv016_a83_02400",
            "faceId": 1,
            "text": "……にゃ。……にゃ。にゃ、と。うん、ステップの練習はこんなものかな。本番のダンスはワタシたちのライブで見せるから、楽しみにしてて",
            "startAt": "2024-07-31 12:00:00",
            "endAt": "2024-08-22 12:59:59"
        },
        {
            "id": 79,
            "mUnitId": 18,
            "mDressId": null,
            "filePath": "amv018_a83_00480",
            "faceId": 1,
            "text": "センセーどしたの？　あたしのことじろじろ見て。わかった！　魔術写真撮りたいんでしょ～。しょうがないな、ほらほら手と手でハートつくろ♪",
            "startAt": "2024-07-31 12:00:00",
            "endAt": "2024-08-22 12:59:59"
        },
        {
            "id": 80,
            "mUnitId": 29,
            "mDressId": null,
            "filePath": "amv029_a83_02330",
            "faceId": 1,
            "text": "アイドル活動をするなら、冥王さまに見られるくらいで恥ずかしがってはいけませんよね。《アイリス》もゴーレム使いもアイドルも。ぜんぶ頑張ります！",
            "startAt": "2024-07-31 12:00:00",
            "endAt": "2024-08-22 12:59:59"
        },
        {
            "id": 81,
            "mUnitId": 30,
            "mDressId": 630201,
            "filePath": "vo_630201_mypage_07_2",
            "faceId": 1,
            "text": "あの、冥王さま？　もうちょっと構っていただけると嬉しいんですが",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 82,
            "mUnitId": 29,
            "mDressId": 629401,
            "filePath": "vo_629401_mypage_07_2",
            "faceId": 1,
            "text": "冥王さま、聞こえてますかー？　いたずらしちゃいますよー",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 83,
            "mUnitId": 4,
            "mDressId": 604501,
            "filePath": "vo_604501_mypage_07_2",
            "faceId": 1,
            "text": "んあ？　今研究中だし、もっともっと放っといてくれていいよ",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 84,
            "mUnitId": 21,
            "mDressId": 621401,
            "filePath": "vo_621401_mypage_07_2",
            "faceId": 1,
            "text": "ああ、穏やかな時間。人間界の全ての人に、こんな時間が訪れれば最高ね",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 85,
            "mUnitId": 6,
            "mDressId": 606101,
            "filePath": "vo_606101_mypage_07_2",
            "faceId": 1,
            "text": "いいよいいよ何もしなくて。ワタシも休んでるから",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 86,
            "mUnitId": 12,
            "mDressId": 612301,
            "filePath": "vo_612301_mypage_07_2",
            "faceId": 1,
            "text": "だ、旦那さま。そんなにじっと見つめられたら……うう、身体が燃えてしまいそうです",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 87,
            "mUnitId": 31,
            "mDressId": null,
            "filePath": "vo_031_mypage_07_1",
            "faceId": 3,
            "text": "はぁ……冥王がかまってくれない。寂しい……",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 88,
            "mUnitId": 5,
            "mDressId": 605201,
            "filePath": "vo_605201_mypage_07_2",
            "faceId": 1,
            "text": "何時間放置されても、わたくしの忠誠は揺らぎません",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 89,
            "mUnitId": 20,
            "mDressId": 620401,
            "filePath": "vo_620401_mypage_07_2",
            "faceId": 1,
            "text": "冥王と一緒なら、何気ない沈黙も幸せに感じる",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 90,
            "mUnitId": 16,
            "mDressId": 616201,
            "filePath": "vo_616201_mypage_07_2",
            "faceId": 1,
            "text": "今日はお客が少ないね。冥王さまの膝で寝ててもいい？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 91,
            "mUnitId": 14,
            "mDressId": 614301,
            "filePath": "vo_614301_mypage_07_2",
            "faceId": 1,
            "text": "銃の手入れ、訓練の反省。隙間時間を有効に使って、さらに己を高めたいです",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 92,
            "mUnitId": 1,
            "mDressId": 601501,
            "filePath": "vo_601501_mypage_07_3",
            "faceId": 1,
            "text": "こんな風に、静かで穏やかな時間を過ごすのも……心地よいものですね",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 93,
            "mUnitId": 32,
            "mDressId": null,
            "filePath": "vo_032_mypage_07_1",
            "faceId": 3,
            "text": "ねえ、さっきからじっと見てるけど……言いたいことがあるなら、はっきり言ってくれないかしら？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 94,
            "mUnitId": 19,
            "mDressId": 619101,
            "filePath": "vo_619101_mypage_07_3",
            "faceId": 1,
            "text": "戦う相手はおらんのか、つまらんのう……冥王、我と勝負せんか？",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 95,
            "mUnitId": 10,
            "mDressId": 610501,
            "filePath": "vo_610501_mypage_07_3",
            "faceId": 1,
            "text": "新しいレシピ、思いついたわ！　紙とペンを貸してちょうだい！",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 96,
            "mUnitId": 23,
            "mDressId": null,
            "filePath": "amv023_a86_04140",
            "faceId": 1,
            "text": "『オーシャンテイル』で絶対優勝してみせる！　この私とアンジェリークのペアは最強無敵なんだから!!　応援よろしくね冥王っ",
            "startAt": "2025-07-31 12:00:00",
            "endAt": "2025-08-21 12:59:59"
        },
        {
            "id": 97,
            "mUnitId": 23,
            "mDressId": 623501,
            "filePath": "amv023_a86_04140",
            "faceId": 1,
            "text": "『オーシャンテイル』で絶対優勝してみせる！　この私とアンジェリークのペアは最強無敵なんだから!!　応援よろしくね冥王っ",
            "startAt": "2025-07-31 12:00:00",
            "endAt": "2025-08-21 12:59:59"
        },
        {
            "id": 98,
            "mUnitId": 31,
            "mDressId": null,
            "filePath": "amv031_a86_08930",
            "faceId": 1,
            "text": "クリスは結構やる気みたいだから、優勝狙っちゃおうかな。わたしは初めて夏フェスに参加したけど……。こういうお祭りごとはいいね。うん、気に入った",
            "startAt": "2025-07-31 12:00:00",
            "endAt": "2025-08-21 12:59:59"
        },
        {
            "id": 99,
            "mUnitId": 32,
            "mDressId": null,
            "filePath": "amv032_a86_20110",
            "faceId": 1,
            "text": "最後に勝つのは私たち２人よ。ふふっ、相手が強ければ強いほど倒し甲斐があるってものだわ。私たちの真の実力を見せてあげる",
            "startAt": "2025-07-31 12:00:00",
            "endAt": "2025-08-21 12:59:59"
        },
        {
            "id": 100,
            "mUnitId": 2,
            "mDressId": null,
            "filePath": "amv002_a86_03960",
            "faceId": 1,
            "text": "め、めめめ冥王様がわたくしを見つめて……？　これは２人でペアを組もうということでしょうか。はっ。いけませんいけません、わたくしのお相手はレーナさんですからっ！",
            "startAt": "2025-07-31 12:00:00",
            "endAt": "2025-08-21 12:59:59"
        },
        {
            "id": 101,
            "mUnitId": 2,
            "mDressId": 602301,
            "filePath": "amv002_a86_03960",
            "faceId": 1,
            "text": "め、めめめ冥王様がわたくしを見つめて……？　これは２人でペアを組もうということでしょうか。はっ。いけませんいけません、わたくしのお相手はレーナさんですからっ！",
            "startAt": "2025-07-31 12:00:00",
            "endAt": "2025-08-21 12:59:59"
        },
        {
            "id": 102,
            "mUnitId": 31,
            "mDressId": 631101,
            "filePath": "vo_631101_mypage_07_2",
            "faceId": 3,
            "text": "冥王？　……冥王？　かまってくれないとイタズラしちゃうよ",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 103,
            "mUnitId": 22,
            "mDressId": 622301,
            "filePath": "vo_622301_mypage_07_3",
            "faceId": 1,
            "text": "ボーっとしている冥王さんも素敵ですね。アンニュイな大人の魅力を感じます",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 104,
            "mUnitId": 17,
            "mDressId": 617401,
            "filePath": "vo_617401_mypage_07_3",
            "faceId": 3,
            "text": "こんな風に、静かな時間を過ごすのもいいですね。えへへ……",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 105,
            "mUnitId": 2,
            "mDressId": 602101,
            "filePath": "vo_602101_mypage_07_3",
            "faceId": 3,
            "text": "あぁ、冥王様……横顔も素敵。目が離せません",
            "startAt": null,
            "endAt": null
        },
        {
            "id": 106,
            "mUnitId": 13,
            "mDressId": 613301,
            "filePath": "vo_613301_mypage_07_3",
            "faceId": 1,
            "text": "もふ、もふもふ……はっ、失礼しました。ラウラの尻尾をもふもふする妄想に浸っていました",
            "startAt": null,
            "endAt": null
        }
    ]
}