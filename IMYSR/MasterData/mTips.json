{
    "name": "mTips",
    "data": [
        {
            "id": 1,
            "title01": "【状態異常：",
            "title02": "出血】",
            "icon": "cond_003",
            "description": "毎ターン、HPが10%ずつ減少していきます。"
        },
        {
            "id": 2,
            "title01": "【状態異常：",
            "title02": "魅了】",
            "icon": "cond_004",
            "description": "味方に攻撃するようになり、スキルや萌技の入力を受け付けなくなります。攻撃を受けると確率で解除されます。"
        },
        {
            "id": 3,
            "title01": "【状態異常：",
            "title02": "睡眠】",
            "icon": "cond_025",
            "description": "数ターンの間、行動不能になります。このとき物理攻撃を受けると必ず命中し、かつクリティカルになります。"
        },
        {
            "id": 4,
            "title01": "【状態異常：",
            "title02": "弱体】",
            "icon": "cond_007",
            "description": "攻撃・防御・魔力・敏捷・幸運のパラメータが50%減少します。"
        },
        {
            "id": 5,
            "title01": "【状態異常：",
            "title02": "スタン】",
            "icon": "cond_005",
            "description": "1ターンの間、行動不能になります。"
        },
        {
            "id": 6,
            "title01": "【補助効果：",
            "title02": "バリアー】",
            "icon": "cond_013",
            "description": "萌技・スキル・アビリティのLvに応じてダメージを軽減します。軽減可能値を使い切ると解除されます。不落の壁で上書きされます。"
        },
        {
            "id": 7,
            "title01": "【補助効果：",
            "title02": "繚乱】",
            "icon": "cond_014",
            "description": "発動中に攻撃・防御・魔力・敏捷・幸運のパラメータが25%増加します。"
        },
        {
            "id": 8,
            "title01": "【補助効果：",
            "title02": "力溜め】",
            "icon": "cond_015",
            "description": "次の攻撃ダメージが増加します。一度効果を発揮すると消滅します。"
        },
        {
            "id": 9,
            "title01": "【補助効果：",
            "title02": "再生】",
            "icon": "cond_016",
            "description": "毎ターンHPを回復します。"
        },
        {
            "id": 10,
            "title01": "【補助効果：",
            "title02": "カウンター】",
            "icon": "cond_017",
            "description": "次の自分のターンまで、反撃率が100%になります。1ターンで解除されます。カウンター・Sで上書きされます。"
        },
        {
            "id": 11,
            "title01": "【補助効果：",
            "title02": "飛行】",
            "icon": "cond_018",
            "description": "近接物理攻撃が極めて命中しにくくなります。"
        },
        {
            "id": 12,
            "title01": "【パラメータ：攻撃】",
            "title02": null,
            "icon": null,
            "description": "物理攻撃のダメージ量に影響します。"
        },
        {
            "id": 13,
            "title01": "【パラメータ：魔力】",
            "title02": null,
            "icon": null,
            "description": "魔法攻撃のダメージ量に影響します。<br>また、魔法攻撃を受けた際、ダメージの軽減度合いにも影響します。"
        },
        {
            "id": 14,
            "title01": "【パラメータ：防御】",
            "title02": null,
            "icon": null,
            "description": "物理攻撃のダメージ軽減度合いに影響します。"
        },
        {
            "id": 15,
            "title01": "【パラメータ：敏捷】",
            "title02": null,
            "icon": null,
            "description": "行動順に影響します。また、敏捷値が高いほど回避率も上昇します。"
        },
        {
            "id": 16,
            "title01": "【パラメータ：幸運】",
            "title02": null,
            "icon": null,
            "description": "自身のクリティカルの発生しやすさと敵のクリティカルの発生しにくさ、<br>状態異常のかけやすさとかかりにくさに影響します。"
        },
        {
            "id": 17,
            "title01": "【パラメータ：回避率】",
            "title02": null,
            "icon": null,
            "description": "敵の物理攻撃を一定確率で回避します。"
        },
        {
            "id": 18,
            "title01": "【パラメータ：即死率】",
            "title02": null,
            "icon": null,
            "description": "一定確率で敵の残りHPに関係なくダウンさせます。"
        },
        {
            "id": 19,
            "title01": "【パラメータ：反撃率】",
            "title02": null,
            "icon": null,
            "description": "敵の攻撃を受けた際、一定確率で攻撃し返します。"
        },
        {
            "id": 20,
            "title01": "【パラメータバフ】",
            "title02": null,
            "icon": null,
            "description": "パラメータに対してプラスの補正が加わります。<br>同一戦闘中に受けたバフは累積加算されます。"
        },
        {
            "id": 21,
            "title01": "【パラメータデバフ】",
            "title02": null,
            "icon": null,
            "description": "パラメータに対してマイナスの補正が加わります。<br>同一戦闘中に受けたデバフは累積加算されます。"
        },
        {
            "id": 22,
            "title01": "【スキルのクールタイム】",
            "title02": null,
            "icon": null,
            "description": "スキルのクールタイムは1ターン毎に1減少します。<br>強力なスキル程スキルのクールタイムが長くなる傾向にあります。"
        },
        {
            "id": 23,
            "title01": "【冥王スキルと冥王スキルLv】",
            "title02": null,
            "icon": null,
            "description": "冥王スキルは、ストーリークエストの進行と共に取得していきます。<br>習得した冥王スキルのLvは、冥王Lvに応じて上昇します。<br>冥王Lvが高い状態でストーリークエストをクリアした場合、<br>冥王スキルLvが高い状態で新たなスキルを習得する場合もあります。"
        },
        {
            "id": 24,
            "title01": "【召喚精霊】",
            "title02": null,
            "icon": null,
            "description": "セシルはアビリティに召喚精霊をセットすると、召喚精霊が代わりに<br>通常攻撃を行うようになります。<br>召喚精霊は状態異常の対象とならないなどの特性を持ちます。"
        },
        {
            "id": 25,
            "title01": "【お供のバブー】",
            "title02": null,
            "icon": null,
            "description": "ファムはお供のバブーが代わりに通常攻撃を行います。<br>バブーはダウンを含む状態異常の対象とならないなどの特性を持ちます。"
        },
        {
            "id": 26,
            "title01": "【前衛と後衛】",
            "title02": null,
            "icon": null,
            "description": "編成画面より、前衛と後衛の割り振りが可能です。<br>誰か必ず一名は前衛に配置される必要があり、前衛が一人もいない場合、<br>後衛全員が前衛となります。"
        },
        {
            "id": 27,
            "title01": "【萌具】",
            "title02": null,
            "icon": null,
            "description": "萌具はアイリスが装備することのできる武器です。<br>各武器はアイリス固有のものです。萌具にはLvが設定されており、<br>Lvが上昇するほど性能が上昇します。<br>戦闘中敵に与えるダメージや回復魔法の効果等に影響します。"
        },
        {
            "id": 28,
            "title01": "【萌具の強化と必要素材】",
            "title02": null,
            "icon": null,
            "description": "萌具を強化するためには、萌具のレアリティに対応した専用のアイテム<br>「シラズの精花」が必要です。<br>「シラズの精花」は曜日クエスト等で手に入れることができます。"
        },
        {
            "id": 29,
            "title01": "【萌具の強化と成功率】",
            "title02": null,
            "icon": null,
            "description": "萌具の強化には成功率が設定されており、失敗すると素材として<br>使用したアイテムや冥界銭は失われてしまいます。<br>成功率は萌具のレベルが上がるほど下がっていきます。<br>萌具の成功率は「シラズのまもり魂」を使用することであげられます。"
        },
        {
            "id": 30,
            "title01": "【萌具の強化と成功率】",
            "title02": null,
            "icon": null,
            "description": "萌具の強化に必要な「シラズの精花」は各種レアリティが存在しますが、<br>萌具強化画面より、上位の「シラズの精花」に錬成することが可能です。<br>素材として、下位の「シラズの精花」10個と冥界銭が必要となります。"
        },
        {
            "id": 31,
            "title01": "【学園の修練成功率】",
            "title02": null,
            "icon": null,
            "description": "学園の修練で大成功・極大成功が発生する確率は、<br>施設Lvが上がると上昇します。<br>大成功や極大成功が発生すると、獲得するスキル素材のレアリティが<br>上昇したり、もらえる親愛度が増加するなどの恩恵を得られます。"
        },
        {
            "id": 32,
            "title01": "【学園ストーリーの開放】",
            "title02": null,
            "icon": null,
            "description": "学園の修練で大成功以上が発生すると、新たな学園ストーリーが<br>開放される可能性があります。<br>学園ストーリーの開放にはアイリスの組み合わせや修練場等の<br>要素が追加条件となる場合もあります。"
        },
        {
            "id": 33,
            "title01": "【聖装の蒼片】",
            "title02": null,
            "icon": null,
            "description": "召喚時におまけで「聖装の蒼片」が手に入るものがあります。<br>また、R以上の各聖装は一定以上輝石に変換された後は自動的に<br>「聖装の蒼片」に変換されます。<br>「聖装の蒼片」はショップで聖装と交換するのに使用することができます。"
        },
        {
            "id": 34,
            "title01": "【聖片】",
            "title02": null,
            "icon": null,
            "description": "ショップにてSSR萌具の交換に必要なアイテムです。<br>イベント報酬にて獲得可能です。<br>また、一部の高難度クエストなどでも獲得できます。"
        },
        {
            "id": 35,
            "title01": "【想飾】",
            "title02": null,
            "icon": null,
            "description": "アイリスが装備することのできるアイテムの一つです。<br>想飾ごとに様々な効果を備えています。"
        },
        {
            "id": 36,
            "title01": "【補助効果：",
            "title02": "深淵】",
            "icon": "cond_026",
            "description": "4ターンの間、繚乱の効果が得られますが、その後1ターン弱体の状態になります。"
        },
        {
            "id": 37,
            "title01": "【補助効果：",
            "title02": "スゴ肉】",
            "icon": "cond_029",
            "description": "通常攻撃にクリティカル率補正と確率でスタン付与の効果がつきます。"
        },
        {
            "id": 38,
            "title01": "【親愛度ストーリー】",
            "title02": null,
            "icon": null,
            "description": "親愛度を一定値まで上げると親愛度ストーリーが開放されます。<br>また、親愛度を1000上げるごとにアイリスの基本パラメータが上昇します。"
        },
        {
            "id": 39,
            "title01": "【聖装ストーリー】",
            "title02": null,
            "icon": null,
            "description": "聖装ストーリーでは衣装姿での楽しい掛け合いもお楽しみいただけます。<br>聖装ストーリーを開放するごとに聖装の基本ステータスが上昇します。"
        },
        {
            "id": 40,
            "title01": "【ハードモード】",
            "title02": null,
            "icon": null,
            "description": "ノーマルモードのクエストをクリアすると、より強力なエネミーが出現するハードモードのクエストが開放されます。"
        },
        {
            "id": 41,
            "title01": "【BP回復】",
            "title02": null,
            "icon": null,
            "description": "時間経過によるBPの回復上限値は、現在の上限値から＋300まで回復します。"
        },
        {
            "id": 42,
            "title01": "【聖装の強化】",
            "title02": null,
            "icon": null,
            "description": "強化やLv上限開放が可能な聖装には「！」マークが表示されます。"
        },
        {
