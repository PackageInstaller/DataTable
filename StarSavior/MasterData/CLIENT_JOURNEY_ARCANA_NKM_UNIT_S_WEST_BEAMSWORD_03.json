      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "훈련이다!",
      "UnitTalk_JPN": "訓練だ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_BEAMSWORD_03",
