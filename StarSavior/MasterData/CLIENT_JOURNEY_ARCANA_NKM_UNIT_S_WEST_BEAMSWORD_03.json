      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_BEAMSWORD_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그럼 이대로 내버려둘 거냐고? 그럴 리가.",
      "UnitTalk_JPN": "このまま放っておくつもりなのか、だと？まさか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_BEAMSWORD_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitTalk_KOR": "안전하고 검증된 방법으로 해결할 거다.",
      "UnitTalk_JPN": "我は、安全かつ確実な手段を使うつもりだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_BEAMSWORD_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitTalk_KOR": "바로…",
      "UnitTalk_JPN": "それはまさに…",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_BEAMSWORD_03",
