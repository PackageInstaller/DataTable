    {
      "Uid": 5,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이후로도 훈련은 느리지만 착실하게 진행되었다.",
      "UnitTalk_JPN": "その後も…ゆっくりではあるが、着実にトレーニングを続けた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "엘리사는 심약하고 배우는 것도 느렸지만, 한번 몸에 익힌 건 절대 잊지 않았다.",
      "UnitTalk_JPN": "エリサは気が弱く、覚えも遅かったが…一度体で覚えたことは決して忘れなかった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그리고, 거기에 작은 루틴을 추가해보았다.",
      "UnitTalk_JPN": "そして、小さなルーティンも加えてみた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아, 엘리사.",
          "JumpAnchorStringId_JPN": "あっ、エリサ。"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "선반 위에 있는 책 좀 가져다줄래?",
          "JumpAnchorStringId_JPN": "棚の上にある本を取ってくれない？"
        }
      ]
    },
    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "네, 네! 단장님! 네, 잠시만요…!",
      "UnitTalk_JPN": "は、はい、団長！す、少しお待ちくださいね…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "여기, 이 책 말씀이시죠?",
      "UnitTalk_JPN": "こ、この本でしょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "고마워, 엘리사.",
          "JumpAnchorStringId_JPN": "ありがとう、エリサ。"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "역시 키가 커서 좋은걸?",
          "JumpAnchorStringId_JPN": "やっぱり背が高いっていいよね。"
        }
      ]
    },
    {
      "Uid": 14,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "네에?!",
      "UnitTalk_JPN": "はいぃ！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "그, 그, 그, 그렇지 않아요!",
      "UnitTalk_JPN": "そ、そ、そ、そんなことありません！",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "키가 커봤자 툭툭 걸리기나 하고… 여기저기 시선이나 받을 뿐인걸요…",
      "UnitTalk_JPN": "背が高いと、あちこちにぶつかったり、引っかかったり…それに目立ってしまいます…",
      "TalkTime": 0.03
    },
    {
      "Uid": 106,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "하지만 지금은 도움이 됐잖아?",
