  "_Version": 4,
  "Data": [
    {
      "Uid": 1,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_CANDLE_GROUND.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_02.mp3",
      "TalkTime": 0.03
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "TWIN_2",
      "UnitPos": "POS7",
      "UnitTalk_KOR": " 아, 오셨군요 단장님.",
      "UnitTalk_JPN": "お越しになりましたか、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "정확한 시간에 도착하셨네요.",
      "UnitTalk_JPN": "時間どおりにお越しくださいましたね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitPos": "POS8",
      "UnitTalk_KOR": " 저 녀석들이야? 이번 기초 평가전 상대인 신입이?",
      "UnitTalk_JPN": "あいつらなの？今度の基礎試験を受ける新人って。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "네, 이번 <color=#F7BE45>[여정]</color> 시험에 참가중인 보이저 구원단 분들입니다.",
      "UnitTalk_JPN": "はい、今回の<color=#F7BE45>「救援の旅」</color>試験に参加中のボイジャー救援団の皆様です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "그리고 단장님.",
      "UnitTalk_JPN": "では団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "ONE_8",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "이쪽은 저희 캔들 스퀘어의 메이드이자 묘지기이신 <color=#F7BE45>[벨 리스]</color> 님입니다.",
      "UnitTalk_JPN": "こちらは、当キャンドル・スクエアのメイド兼墓守を務める<color=#F7BE45>「ベル・リース」</color>様です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": " 벨 님은 캔들 스퀘어의 멤버들 중에서도 손에 꼽히는 강력한 저주술사죠.",
      "UnitTalk_JPN": "ベル様は、キャンドル・スクエアのメンバーの中でも指折りの強力な呪詛師です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": " <color=#F7BE45>[여정]</color>의 도전자라… 오랜만이네.",
      "UnitTalk_JPN": "<color=#F7BE45>「救援の旅」</color>の挑戦者…久しぶりね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": " 최근에는 <color=#F7BE45>[여정]</color>에 도전할 만큼 용기 있는 녀석들이 별로 없었는데 말이지.",
      "UnitTalk_JPN": "最近は<color=#F7BE45>「救援の旅」</color>に挑戦するほど勇気ある連中がいなかったのに。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 그래서 말인데 그냥 <color=#F7BE45>[여정]</color>을 포기할 생각은 없어?",
      "UnitTalk_JPN": "だからこそ言うわ。<color=#F7BE45>「救援の旅」</color>を諦める気はない？",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "TalkTime": 0.03,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…그게 무슨 말이지?",
          "JumpAnchorStringId_JPN": "…それはどういう意味だ？"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": " 오랜 세월 동안 수많은 구원자들이 도전했으나 모두 실패한 시험.",
      "UnitTalk_JPN": "幾世代にもわたり、多くの救援者が挑んだが、ことごとく失敗に終わった試練。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": " 그것이 바로 <color=#F7BE45>[여정]</color>.",
      "UnitTalk_JPN": "それが<color=#F7BE45>「救援の旅」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": " 당연히 여정에는 위험한 시험들이 가득해.",
      "UnitTalk_JPN": "当然、「救援の旅」は危険な試練で満ちている。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": " 어쩌면 목숨을 잃을 수도 있고.",
      "UnitTalk_JPN": "もしかすると命を落とすかもしれない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": " 하지만 <color=#F7BE45>[여정]</color>에 도전하는 녀석 대부분은…",
      "UnitTalk_JPN": "しかし<color=#F7BE45>「救援の旅」</color>に挑戦する連中のほとんどは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "별의 구원자의 전설에 취한 바보들뿐이지.",
      "UnitTalk_JPN": "星の救援者の伝説に酔った愚か者ばかり。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": " 그 과정의 험난함에 대해서는 전혀 생각해보지도 않고 할 수 있다는 말만 외쳐대는 멍청이들.",
      "UnitTalk_JPN": "その過程の険しさなど考えもせず、できるできると声高に叫ぶ愚か者ども。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 그런 녀석들은 반드시 좋지 않은 결말을 맞이해 왔어.",
      "UnitTalk_JPN": "そういう連中は、決まってろくな結末を迎えなかった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": " 그래서 말하는 거야.",
      "UnitTalk_JPN": "だから言うのよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": " 너와 네 단원도 아직 늦지 않았어.",
      "UnitTalk_JPN": "あんたと団員たちも、まだ遅くはない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "우리 가문이 관리하는 묘지에 그런 불쌍한 녀석들의 묘비를 추가하고 싶진 않거든.",
      "UnitTalk_JPN": "一族が管理する墓地に、そんな哀れな連中の墓石を足すつもりはないのよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "TalkTime": 0.03,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "걱정은 고맙지만 괜찮아.",
          "JumpAnchorStringId_JPN": "心配してくれてありがとう。でも、大丈夫だ。"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "흥, 다른 녀석들과 별 다를 바 없는 반응이네.",
      "UnitTalk_JPN": "ふん、他の連中と似たり寄ったりした反応ね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "좋아. 그럼 더 말릴 필요는 없겠지.",
      "UnitTalk_JPN": "いいわ、ならこれ以上止める必要もないでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "뭐, 너무 걱정하지 마.",
      "UnitTalk_JPN": "ま、あまり心配しないで。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "가문 묘지에 제법 양지바른 땅이 아직 남아 있거든.",
      "UnitTalk_JPN": "墓地にはまだ、なかなか日当たりの良い場所が残っているから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "안타까운 일이 벌어지더라도 뒤는 내가 잘 수습해 줄게.",
      "UnitTalk_JPN": "残念なことになっても、後始末は私がしてあげるわ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "…재수없어.",
      "UnitTalk_JPN": "…腹が立つわね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "음? 방금 뭐라고 했어, 클레어?",
      "UnitTalk_JPN": "ん？今何て言った、クレア？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "사람과의 대화법을 다시 배우시는 편이 좋겠다는 말이었습니다.",
      "UnitTalk_JPN": "人との話し方を学び直したほうがいい――そう申し上げたのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "벨 님의 그 삐뚤어진 말투 때문에 저희 캔들 스퀘어의 평판이 얼마나 실추되는 지 아시나요?",
      "UnitTalk_JPN": "ベル様のひねくれた口ぶりのせいで、私たちキャンドル・スクエアの名誉がどれほど損なわれているか、お分かりですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "흥, 알 게 뭐야.",
      "UnitTalk_JPN": "ふん、知らないわよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": " 난 그저 진심으로 <color=#F7BE45>[여정]</color>을 시작하는 애송이를 격려했을 뿐이야.",
      "UnitTalk_JPN": "私はただ、<color=#F7BE45>「救援の旅」</color>を始める青二才たちを心から励ましただけ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "그게 진심이라는 것이 당신의 제일 큰 문제입니다.",
      "UnitTalk_JPN": "言い方ってものを考えないのが、あなたの最大の問題です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": " 하아… 두통이야.",
      "UnitTalk_JPN": "はあ…頭が痛くなってきた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "…죄송합니다, 단장님.",
      "UnitTalk_JPN": "…申し訳ありません、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_07_NOA_BATTLE_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "더 늦기 전에, 지금부터 기초 평가전을 시작하겠습니다.",
      "UnitTalk_JPN": "遅くなる前に、今から基礎試験を開始します。",
      "TalkTime": 0.03
