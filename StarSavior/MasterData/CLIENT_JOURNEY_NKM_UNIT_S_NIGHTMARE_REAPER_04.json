    {
      "Uid": 113,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "네. 많은 사람들이 섞여 살고, 다양한 꿈들이 생겼다가 사라지는 도시…",
      "UnitTalk_JPN": "はい。たくさんの人々が混ざり合って暮らし、様々な夢が生まれては消えていく街…",
      "TalkTime": 0.03
    },
    {
      "Uid": 114,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitTalk_KOR": "언젠가 한 번쯤은… 꼭 와보고 싶었거든요.",
      "UnitTalk_JPN": "いつか一度は…必ず来てみたかったのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 115,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "제가 꿈꾸던 모습 그대로예요.",
      "UnitTalk_JPN": "わたしが夢見ていた姿そのものですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 116,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "여정 단원으로 오게 돼서 기뻐요… 데려와 주셔서 감사해요, 단장님.",
      "UnitTalk_JPN": "旅の団員として来られて嬉しいです…連れてきてくださってありがとうございます、団長さま。",
      "TalkTime": 0.03
    },
    {
      "Uid": 200,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "SMILE"
    },
    {
      "Uid": 117,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_CLOTH_92.wav",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "세이라는 정말 기쁘다는 듯이 내 손을 맞잡아왔다.",
      "UnitTalk_JPN": "セイラは本当に嬉しそうに、私の手を握ってきた。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 118,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그 손은 여전히 깃털처럼 가볍고, 적당히 시원해서 아무리 봐도 사람이라는 실감이 나지 않았다.",
      "UnitTalk_JPN": "その手は相変わらず羽のように軽く、程よく冷たくて、やはり人間だという実感は湧かなかった。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 119,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그러고 보니 그때도…",
      "UnitTalk_JPN": "そういえばあの時も…",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
