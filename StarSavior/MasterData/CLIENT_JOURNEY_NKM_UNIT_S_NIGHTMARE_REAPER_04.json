    {
      "Uid": 134,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…다른 사람과 어울리기엔… 제가 너무 약하니까요.",
