      "TalkTime": 0.03
    },
    {
      "Uid": 126,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "으음… 그건…",
      "UnitTalk_JPN": "うーん…それは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 127,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "강해질 필요가 있기 때문이에요.",
      "UnitTalk_JPN": "強くなる必要があるからです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 128,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "저에게는…",
      "UnitTalk_JPN": "わたしには…",
      "TalkTime": 0.03
    },
    {
      "Uid": 129,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitTalk_KOR": "별의 구원자의 힘이… <color=#F7BE45>필요</color>해요.",
      "UnitTalk_JPN": "星の救援者の力が… <color=#F7BE45>必要</color>なのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 130,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "<color=#F7BE45>강해지고 싶다</color>는 말이 세이라의 입에서 나올 것이라고는 생각지 못했다.",
      "UnitTalk_JPN": "<color=#F7BE45>強くなりたい</color>という言葉が、セイラの口から出てくるとは思わなかった。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 131,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그러나 단순하게 강한 힘을 갈망한다는 것이 아니라, 반드시 필요로 한다는 세이라의 말에서…",
      "UnitTalk_JPN": "しかし、単純に強い力を望んでいる訳ではなく、必要だと言うセイラの言葉から…",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 132,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "어쩐지 결연한 의지가 느껴졌다.",
      "UnitTalk_JPN": "強い意志が感じられた。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 133,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "왜 그렇게 큰 힘이 필요해?",
          "JumpAnchorStringId_JPN": "どうして力が必要なの？"
        }
      ]
