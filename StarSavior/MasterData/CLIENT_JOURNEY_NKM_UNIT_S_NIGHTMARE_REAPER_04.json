    },
    {
      "Uid": 110,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "NOA가 궁금하다는 세이라를 데리고 거리를 걷게 되었다.",
      "UnitTalk_JPN": "NOAに興味があるというセイラを連れて街を歩くことになった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 111,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NIGHTMARE_REAPER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "이곳이 NOA… 너무 신기해요.",
      "UnitTalk_JPN": "ここがNOA…すごく不思議です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 112,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그렇게 신나?",
          "JumpAnchorStringId_JPN": "そんなに嬉しい？"
        }
