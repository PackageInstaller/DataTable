    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "DRAMA_ACTIVATE_ARCANA_2.prefab",
      "StartBgmFileName": "MUSIC_CUTSCENE_06.mp3"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": false,
      "WaitTime": 2.5
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "내가 만들어지고 오랜 시간이 지난 후의 일이야.",
      "UnitTalk_JPN": "私が作られてから長い時が経った後のことだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "‘나’와 ‘다른 걸’ 구분할 줄 알게 됐어. 자아가 생겨났지.",
      "UnitTalk_JPN": "「私」と「それ以外」を区別できるようになった。自我が芽生えたのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "내 주변에는 끝없는 초원이 펼쳐져 있었어.",
      "UnitTalk_JPN": "私の周りには、果てしない草原が広がっていた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "강가에는 동물들이 뛰어다니고 새들은 지저귀었지.",
      "UnitTalk_JPN": "川辺には動物たちが跳ね回り、鳥たちはさえずっていた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "밤하늘을 아로새긴 별빛은 밤새도록 훤히 빛났어.",
      "UnitTalk_JPN": "夜空を彩る星の光は、夜通し煌々と輝いていた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "비록 움직이지는 못했지만 나는 누구보다 행복했어. 주변의 모든 것에 감사했지.",
      "UnitTalk_JPN": "動くことはできなかったが、私は誰よりも幸せだった。周りのすべてに感謝していた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그날, 별의 재앙(스타폴)이 일어나기 전까지는.",
      "UnitTalk_JPN": "あの日、<r=スターフォール>星の災厄</r>が起こるまでは。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "끝없는 초원은 불길로 뒤덮였어.",
      "UnitTalk_JPN": "果てしない草原は炎に包まれた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "새와 동물들은 먼 곳으로 도망갔지.",
      "UnitTalk_JPN": "鳥や動物たちは遠くへ逃げていった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "밝게 빛나던 별들은 불길한 색채로 일렁였고, 이제 와서 남은 건 아무것도 없어.",
      "UnitTalk_JPN": "明るく輝いていた星々は不吉な色に揺らめき、今となっては何も残っていない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "모든 게 해결된 후에도 내 주변은 잿더미만이 가득해. 그때부터 지금까지, 계속.",
      "UnitTalk_JPN": "すべてが解決した後も、私の周りには灰の山だけが広がっている。あの時から今まで、ずっと。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "내 이야기는 여기까지야. 후회와 재밖에 안 남았지.",
      "UnitTalk_JPN": "私の話はここまでだ。後悔と灰しか残らなかった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 너희들의 이야기는 지금부터야.",
      "UnitTalk_JPN": "だが、君たちの物語はこれからだ。",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_TOWER_01",
