    {
      "Uid": 7,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "CameraOffset": "ONE_3",
      "UnitPos": "POS3",
      "UnitTalk_KOR": "그러니까… 지난번에 실패한 건 정보 부족 때문이었다는 거군요?",
      "UnitTalk_JPN": "つまり…前回失敗した原因は、情報不足だったから…ということですね？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_001.wav"
    },
    {
      "Uid": 8,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitPos": "POS2",
      "UnitTalk_KOR": "그래. 우리 계획엔 아무런 문제도 없었어.",
      "UnitTalk_JPN": "そうよ。うちらの計画には何の問題もなかったの。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_001.wav"
    },
    {
      "Uid": 9,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitMotion": "ANGRY",
      "UnitPos": "POS2",
      "UnitTalk_KOR": "문제가 있었다면… 그 녀석이 <color=#F7BE45>[차가운 도시 남자]</color> 타입이라는 걸 몰랐을 뿐이지.",
      "UnitTalk_JPN": "計算外だったのは…あいつが<color=#F7BE45>「都会の悪い男」</color>タイプだったってこと。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_002.wav"
    },
    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "차가운 도시 남자!",
      "UnitTalk_JPN": "都会の悪い男！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_002.wav"
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitTalk_KOR": "그래.",
      "UnitTalk_JPN": "そうよ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_003.wav"
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "여기 모노리스 교단 성서 33장, <color=#F7BE45>[만나선 안 될 남자의 32가지 유형]</color>에 정확히 나와 있어.",
      "UnitTalk_JPN": "モノリス教団、聖書33章…<color=#F7BE45>「付き合ってはいけない男のタイプ32種」</color>に書かれてるんだから。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_004.wav"
    },
    {
      "Uid": 13,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitTalk_KOR": "27번 타입, <color=#F7BE45>[차가운 도시 남자]</color>.",
      "UnitTalk_JPN": "27番目のタイプ、<color=#F7BE45>「都会の悪い男」</color>。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_005.wav"
    },
    {
      "Uid": 14,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "오오…!",
      "UnitTalk_JPN": "あっ…！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_003.wav"
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "<color=#F7BE45>[수많은 여자들이 차가운 도시 남자의 매력에 끌리지만 그 끝은 좋지 못하다.]</color>",
      "UnitTalk_JPN": "<color=#F7BE45>「数多くの女性が都会の悪い男に惹かれるが、往々にして幸せな結末にはならない。」</color>",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_006.wav"
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitTalk_KOR": "<color=#F7BE45>[이 타입의 남자는 여자에게 쉽게 마음을 주지 않는다.]</color>",
      "UnitTalk_JPN": "<color=#F7BE45>「このタイプの男性は、なかなか女性に心を許さないのである。」</color>",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_007.wav"
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그, 그렇다면…",
      "UnitTalk_JPN": "ということは…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_004.wav"
    },
    {
      "Uid": 118,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitMotion": "SERIOUS"
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 1.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "그분은 절 쾌락의 도구로만 사용했다는 건가요?!",
      "UnitTalk_JPN": "あの方は、私を単なる快楽の道具として扱ったということですか！？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_005.wav"
    },
    {
      "Uid": 19,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "이 무슨… 지옥에서 올라온 악마조차 경악할 일인지…!",
      "UnitTalk_JPN": "なんてこと…地獄の悪魔でさえ驚愕する所業…！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_006.wav"
    },
    {
      "Uid": 20,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "뮤리엘 116번 성녀님! 저 납득했어요!",
      "UnitTalk_JPN": "序列116番聖女ことミュリエル様！私、思い知りました！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_007.wav"
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "결코 그런 분의 손에 대성물을 맡겨선 안 된다는 걸요!",
      "UnitTalk_JPN": "あのような方に、大聖遺物を預けていてはいけません！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_008.wav"
    },
    {
      "Uid": 119,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitMotion": "NORMAL"
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "하지만… 어떻게 해야 대성물을 가지고 올 수 있을까요?",
      "UnitTalk_JPN": "しかし…どうすれば大聖遺物を手にすることができるのでしょうか？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_009.wav"
    },
    {
      "Uid": 23,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그 빙하처럼 얼어붙은 마음을 녹이는 건… 저로서는 무리예요.",
      "UnitTalk_JPN": "あの方の凍り付いた心を溶かすのは…私には荷が重いです。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_010.wav"
    },
    {
      "Uid": 24,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후후, 그러니까 네가 아직 겨우 서열 117위인 거야.",
      "UnitTalk_JPN": "ふふふ、そんなだから序列117番なのよ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_008.wav"
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitTalk_KOR": "보라고! 방법은 이미 성서에 다 나와 있어.",
      "UnitTalk_JPN": "見なさい！解決策はぜんぶ聖書に載ってるんだから。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_009.wav"
    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "네? 어디에…?",
      "UnitTalk_JPN": "はい？どこに…？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_011.wav"
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "<color=#F7BE45>[차가운 도시 남자에게 사랑 따윈 하찮은 감정일 뿐이다.]</color>",
      "UnitTalk_JPN": "<color=#F7BE45>「都会の悪い男にとって、愛などくだらない感情に過ぎない。」</color>",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_010.wav"
    },
    {
      "Uid": 28,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "<color=#F7BE45>[그는 오직 일과 성공으로만 자신의 영혼을 채울 수 있다!]</color>",
      "UnitTalk_JPN": "<color=#F7BE45>「彼の魂を満たすことができるのは、仕事の成功だけである！」</color>",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_011.wav"
