      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "그렇다면… 설마?!",
      "UnitTalk_JPN": "ということは…まさか！？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_ELF_012.wav"
    },
    {
