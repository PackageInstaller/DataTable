      "CameraOffset": "POS2_2X",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후후, 기대하라고.",
      "UnitTalk_JPN": "ふふふ、信じなさい。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_3_UNIT_S_SAINTESS_DEMON_012.wav"
