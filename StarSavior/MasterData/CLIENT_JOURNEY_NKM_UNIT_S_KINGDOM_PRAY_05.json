      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_19.mp3",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아니, 아니군요.",
      "UnitTalk_JPN": "ううん、そんなこともありませんね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "그러고 보니 기사단 규정집에도 비슷한 조언이 있었던 것 같아요.",
      "UnitTalk_JPN": "そういえば…騎士団のルールブックにも、似たようなアドバイスが書かれていたような気がします。",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "천리행군도 한 걸음부터… 였나?",
      "UnitTalk_JPN": "千里の道も一歩から…だっけ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "과연, 도서관의 고서들 뿐 아니라 공국 기사단의 규정집까지 독파하고 있다니…",
      "UnitTalk_JPN": "やはり、図書館の古書だけでなく、公国騎士団のルールブックまで読破するなんて…",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "단장님에 대한 제 평가를 1점 올려 두도록 하죠.",
      "UnitTalk_JPN": "団長の評価を、1点プラスして差しあげますの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "1점… 고마워.",
          "JumpAnchorStringId_JPN": "1点か…ありがとう。"
        }
      ]
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "영광인 줄 아세요.",
      "UnitTalk_JPN": "光栄に思ってくださいね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "제게 1점을 받는 사람은 공국 전체에서도 열 명이 안되니까요.",
      "UnitTalk_JPN": "わたくしから1点をもらった人は、公国全体でも10人に満たないのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아무튼 전 가보겠습니다.",
      "UnitTalk_JPN": "では、わたくしはこれで。",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "단장님의 충고를 발판으로 새로운 사업을 구상해야 하니까요! ",
      "UnitTalk_JPN": "団長のアドバイスを踏まえて、新たなビジネスを構成しないといけませんから！ ",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true
    },
