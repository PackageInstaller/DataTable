    {
      "Uid": 2,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_STORE_GENERAL.png",
      "UnitTalk_KOR": "우리는 스마일을 따라 공방 안으로 이동해 이야기를 나누기로 했다.",
      "UnitTalk_JPN": "私たちはスマイルの工房へと移動し、話をすることにした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "WaitClick": false,
