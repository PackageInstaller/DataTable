    {
      "Uid": 5,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그러니까… 네가 의뢰인이라고?",
          "JumpAnchorStringId_JPN": "つまり…君が依頼人なんだな？"
        }
      ]
    },
    {
      "Uid": 6,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_17.mp3",
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "…긍정.",
      "UnitTalk_JPN": "…肯定。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_001.wav"
    },
    {
      "Uid": 7,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "의뢰 내용은… 사기꾼 검거?",
          "JumpAnchorStringId_JPN": "依頼内容は…ペテン師の逮捕？"
        }
      ]
    },
    {
      "Uid": 8,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "끄덕끄덕.",
      "UnitTalk_JPN": "コクコク。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_002.wav"
    },
    {
      "Uid": 9,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "사정은 이렇다.",
      "UnitTalk_JPN": "聞いたところによれば、事情はこうだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이 소녀의 이름은 스마일.",
      "UnitTalk_JPN": "この少女の名は、スマイル。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그녀의 언니가 어느 날 모습을 감췄고…",
      "UnitTalk_JPN": "ある日、彼女の姉が姿を消してしまったらしい。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그 행방을 찾기 위해 자칭 라비스타 최고의 점성술사라는 사람에게 의뢰를 넣었다.",
      "UnitTalk_JPN": "スマイルはその行方を追うため、自称ラビスターで一番の占星術師に依頼をした。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 13,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…그리고 어제, 이 편지를 수취.",
      "UnitTalk_JPN": "…そして昨日、一通の手紙が届いたのだという。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_003.wav"
    },
    {
      "Uid": 14,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_PAGE_TURN.wav",
      "UnitTalk_KOR": "나는 스마일이 내민 편지를 받아서 읽어 보았다.",
      "UnitTalk_JPN": "私はスマイルが差し出した手紙を受け取り、読んでみた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 104,
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 103,
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_LETTER_01.png",
      "CutsceneClear": "CLEARALL"
    },
    {
      "Uid": 102,
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "달님에게 영광을!",
      "UnitTalk_JPN": "月に祝福を！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_001.wav"
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "기뻐하라, 길 잃은 소녀여! 고귀한 달의 궤도가 네 언니의 행방을 알려주었노라.",
      "UnitTalk_JPN": "喜ぶがいい、道に迷える少女よ！崇高なる月の軌跡が、そなたの姉の行方を告げてくれた。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_002.wav"
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 나는 보고 만 것이다…!",
      "UnitTalk_JPN": "しかし、我は見てしまったのだ…！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_003.wav"
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "만남의 길 저편에 숨어 있는 검은 흉성의 미래를!",
      "UnitTalk_JPN": "再会の道に潜む、黒き凶星の未来を！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_004.wav"
    },
    {
      "Uid": 19,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "뭐야? 이게 무슨 뜻이야?",
          "JumpAnchorStringId_JPN": "…何だこれ？どういう意味だ？"
        }
      ]
    },
    {
      "Uid": 20,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_ASHERAH"
      ],
      "UnitTalk_KOR": "…밑에 설명이 더 있는 것 같은데?",
      "UnitTalk_JPN": "下に説明があるんじゃない？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_STRANIS_001.wav"
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하하하, 점괘나 신탁은 비유가 많아서 이해하기 어렵지?",
      "UnitTalk_JPN": "アハハッ。占いとか神託って比喩が多くて意味わかんないよね？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_005.wav"
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "쉽게 말하자면 네 언니에 대한 단서를 찾긴 했지만… 굳이 안 만나는 게 더 좋을 거란 얘기야!",
      "UnitTalk_JPN": "要するに、キミのお姉さんの手がかりは見つけたけど…会わない方がいいってコト！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_006.wav"
    },
    {
      "Uid": 23,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그러니 단서는 나만 알고 있는 걸로 할게.",
      "UnitTalk_JPN": "だから、手掛かりはアタシだけの秘密にしておきます。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_007.wav"
    },
    {
      "Uid": 24,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "응응, 무슨 생각하는지 알아. ",
      "UnitTalk_JPN": "うんうん、気持ちは分かるよ？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_008.wav"
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 세상을 살다 보면 뜻대로 되지 않는 일이 더 많잖아?",
      "UnitTalk_JPN": "でも世の中、思い通りにならないことの方が多いでしょ？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_009.wav"
    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이번 일도 그런 일이라고 생각하면 받아들이기 쉬울 거야. ",
      "UnitTalk_JPN": "今回もそういうことだったって思えば、納得できるはず！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_010.wav"
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그리고 점괘를 해석해 주는 일은 원래 따로 요금을 받거든.",
      "UnitTalk_JPN": "あ、それと占いの解釈を説明するのって、本当なら追加料金がかかるんだよね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_011.wav"
    },
    {
      "Uid": 28,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그래도… 이번엔 처음이니까 뭐, 특별히 공짜로 해 줄게!",
      "UnitTalk_JPN": "でも…今回は初めてのお客さんだし、特別にタダにしてあげちゃうね！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_012.wav"
    },
    {
      "Uid": 29,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아, 고맙다는 말은 괜찮아! ",
      "UnitTalk_JPN": "も～、感謝の言葉とかいらないったら！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_013.wav"
    },
    {
      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그럼 언젠가 달이 인도하는 곳에서 다시 만나~!",
      "UnitTalk_JPN": "じゃ、いつか月が導く場所でまた会おうね～っ！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_ORACLE_014.wav"
    },
    {
      "Uid": 107,
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 106,
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_STORE_GENERAL.png"
    },
    {
      "Uid": 105,
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 31,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…우와, 진짜냐.",
          "JumpAnchorStringId_JPN": "…うわぁ。"
        }
      ]
    },
    {
      "Uid": 32,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "완전히 사기꾼이잖아!",
      "UnitTalk_JPN": "完全に詐欺じゃない！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_STRANIS_002.wav"
    },
    {
      "Uid": 33,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "어쩌다 이런 사람을 만나게 된 거야?",
      "UnitTalk_JPN": "なんでこんな人に依頼したの？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_STRANIS_003.wav"
    },
    {
      "Uid": 34,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SAD",
      "UnitPos": "POS3",
      "UnitTalk_KOR": "지금까지 과학적인 방법으로 언니의 행방을 탐색했지만 약간의 단서도 찾을 수 없었음.",
      "UnitTalk_JPN": "今まで科学的な方法で姉さんの行方を探したけど、手掛かりゼロ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_004.wav"
    },
    {
      "Uid": 35,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래서 이번에는 조금 더 인간적인 방법을 시도해 보기로 함.",
      "UnitTalk_JPN": "だから、今回は人間らしい方法を試した。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_005.wav"
    },
    {
      "Uid": 36,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "인간적인 방법?",
          "JumpAnchorStringId_JPN": "人間らしい方法？"
        }
      ]
    },
    {
      "Uid": 37,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "문제 해결을 위해 비이성적, 비논리적, 비과학적인 접근을 시도해 보는 것.",
      "UnitTalk_JPN": "問題解決のため、非・理性的、非・論理的、非・科学的なアプローチを試みること。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_006.wav"
    },
    {
      "Uid": 38,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "예를 들어…",
      "UnitTalk_JPN": "例えば…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_007.wav"
    },
    {
      "Uid": 39,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_ITEM_OUT.wav",
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "<color=#F7BE45>[우연]</color> 이라는 것의 효과를 확인하고자, 가게 문틈에 꽂혀 있던 전단지를 참고한다든가.",
      "UnitTalk_JPN": "<color=#F7BE45>「巡り合わせ」</color>というものの効果に期待して、偶然工房のドアに挟まっていたチラシを参考にするとか。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_008.wav"
    },
    {
      "Uid": 40,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "스마일이 꺼낸 전단지에는 화려한 광고 문구들이 적혀 있었다.",
      "UnitTalk_JPN": "スマイルが取り出したチラシには、華やかな宣伝文句が書かれていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 41,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "라비스타 최고의 적중률! 당신의 미래를 알아보세요!",
      "UnitTalk_JPN": "ラビスターいちの的中率！あなたの未来を覗いてみましょう！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 42,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "학업, 사업, 연애, 가족, 건강, 그 어떤 것이라도 답해드립니다!",
      "UnitTalk_JPN": "学業、仕事、恋愛、家庭、健康、どんなことでもお答えします！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 43,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "하지만 실패.",
      "UnitTalk_JPN": "でも、失敗。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_009.wav"
    },
    {
      "Uid": 44,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "과장된 광고 문구를 함부로 신뢰하면 안 된다는 교훈을 얻음.",
      "UnitTalk_JPN": "誇張された広告を、鵜呑みにしてはいけないという教訓を得た。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_010.wav"
    },
    {
      "Uid": 45,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "언젠가 인간이 되기 위해 해당 교훈이 유용하게 사용될 것으로 기대.",
      "UnitTalk_JPN": "いつか人間になるために、この教訓が役立つことを期待。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_011.wav"
    },
    {
      "Uid": 46,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "꼭 인간이 아닌 것처럼 이야기하네.",
          "JumpAnchorStringId_JPN": "まるで自分が人間じゃないような言い方だな。"
        }
      ]
    },
    {
      "Uid": 47,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "긍정. 나는 인간이 아님.",
      "UnitTalk_JPN": "肯定。私は人間ではない。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_4_UNIT_S_VOYAGER_SMILE_012.wav"
