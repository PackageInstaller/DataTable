      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT1_MALE_N",
      "UnitNameString": [
        "SI_PERSON_A"
      ],
      "UnitTalk_KOR": "하하하, 그거 좋구만! 하지만… 그거 조심하라고.",
