      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_RICH_MALE_F",
      "UnitNameString": [
        "SI_PERSON_B"
      ],
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "푹 자고 일어나니까 아침마다 기운이 넘쳐!",
