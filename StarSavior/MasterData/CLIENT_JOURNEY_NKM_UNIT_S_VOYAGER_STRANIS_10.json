      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "우리의 <color=#F7BE45>[진짜 여정]</color>은 지금부터니까…",
      "UnitTalk_JPN": "わたしたちの<color=#F7BE45>「本当の旅」</color>はこれからだから…",
      "TalkTime": 0.03
    },
    {
