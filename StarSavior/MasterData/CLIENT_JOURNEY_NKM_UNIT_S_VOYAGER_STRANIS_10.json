      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "우리의 <color=#F7BE45>[여정]</color>은 실패하지 않았어.",
      "UnitTalk_JPN": "わたしたちの<color=#F7BE45>「救援の旅」</color>は成功した。",
      "TalkTime": 0.03
    },
    {
