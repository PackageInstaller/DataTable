      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "그렇게 <color=#F7BE45>[별의 구원자]</color>가 되겠다는 꿈을 이루기 위한 길은… ",
      "UnitTalk_JPN": "<color=#F7BE45>「星の救援者」</color>になる夢を叶えるための道を… ",
      "TalkTime": 0.03
    },
    {
