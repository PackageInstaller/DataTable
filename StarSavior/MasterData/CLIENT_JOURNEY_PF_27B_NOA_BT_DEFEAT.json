      "UnitTalk_JPN": "臨界点への到達に失敗",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "스텔라 아카이브 기록 보존 절차 진행",
      "UnitTalk_JPN": "ステラーアーカイブに記録を保存",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_DEFEAT",
      "WaitClick": false,
      "WaitTime": 0.5,
      "BgFlashBang": 0.5,
      "EndBgmFileName": "MUSIC_CUTSCENE_03.mp3",
      "CutsceneClear": "CLEARTEXT"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_DEFEAT",
      "WaitClick": false,
      "WaitTime": 1.5,
      "BgFadeOutCol": [
        "0",
        "0",
