        "0"
      ],
      "BgFadeOutTime": 1.5
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "역시… 너무 어려운 시험이었던 것 같네.",
      "UnitTalk_JPN": "やはり…難しすぎる試験だったようだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 너도 알고 있을 거야.",
      "UnitTalk_JPN": "でも君も分かっているだろう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이 정도도 해내지 못한다면… 그다음은 기대할 필요조차 없다는 걸.",
      "UnitTalk_JPN": "これすら成し遂げられないなら…その先は期待する価値すらないということを。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "너와, 네가 선택한 아이와, 식어가는 이 세계를 위해.",
      "UnitTalk_JPN": "君と、君が選んだ子と、冷めゆくこの世界のために。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "다음에는 좀 더 나은 결과를 기대할게.",
      "UnitTalk_JPN": "次は、良い結果を期待しているわ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그럼 그때까지 잠시나마 편히 쉬렴.",
      "UnitTalk_JPN": "それまで、少し休むことね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "나의 벗, 나의 계약자…",
      "UnitTalk_JPN": "私の友、私の契約者…",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그리고 나의… 구원자님.",
      "UnitTalk_JPN": "そして私の…救援者さま。",
      "TalkTime": 0.03
    }
  ]
