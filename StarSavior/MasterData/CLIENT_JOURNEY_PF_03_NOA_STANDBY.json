    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_SHOP",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그리고… 우웅… 그러니까…",
      "UnitTalk_JPN": "あとは…えーっと…うーん…",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_SHOP",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "아! 맞다!",
      "UnitTalk_JPN": "あっ、そうだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_SHOP",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "<color=#F7BE45>[여정]</color> 관련 상품은 평가전 일정에 맞춰서 입고되고 있어요.",
      "UnitTalk_JPN": "<color=#F7BE45>「救援の旅」</color>関連の商品は、試験の日程に合わせて入荷しています。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_SHOP",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그러니까 잊지 말고 꼭 들러 주세요!",
      "UnitTalk_JPN": "ですので、お忘れなくぜひお立ち寄りくださいね！",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "알겠어. 고마워.",
          "JumpAnchorStringId_JPN": "うん、ありがとう。"
        }
      ]
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_SHOP",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "헤헤, 감사합니다!",
      "UnitTalk_JPN": "エヘヘ、ありがとうございます！",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_CLOTH_WHOOSH_11.wav",
      "UnitStrId": "NKM_UNIT_S_NOA_SHOP",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "여기, 약속해 주신 보답으로 창고에서 찾은 <color=#F7BE45>[아르카나]</color>를 드릴게요.",
      "UnitTalk_JPN": "約束してくださったお礼に、倉庫で見つけた<color=#F7BE45>「アルカナ」</color>を差しあげます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_SHOP",
      "UnitTalk_KOR": "저한테는 평범한 수집품이지만, <color=#F7BE45>[여정]</color> 중인 단장님께는 도움이 될 거예요!",
      "UnitTalk_JPN": "わたしにとってはガラクタでも…<color=#F7BE45>「救援の旅」</color>に参加中の団長さんなら、きっと役立つと思うんです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "<color=#F7BE45>[여정]</color>에 도움이 되는 물건이 있다면 들러 볼 필요가 있겠지.",
      "UnitTalk_JPN": "<color=#F7BE45>「救援の旅」</color>に役立つ物があるなら、足を運んだ方が良さそうだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "평가전이 열리기 전까지 <color=#F7BE45>[의뢰]</color>로 충분한 자금을 확보해 두자!",
      "UnitTalk_JPN": "試験が始まるまで、<color=#F7BE45>「依頼」</color>で十分な資金を確保しておこう！",
      "TalkTime": 0.03,
      "AutoHighlight": "LIGHT"
    }
