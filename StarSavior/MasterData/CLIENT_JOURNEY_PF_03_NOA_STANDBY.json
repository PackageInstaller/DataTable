      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_SHOP",
      "UnitTalk_KOR": "이곳 성운도시의 <color=#F7BE45>[아포칼립스 상단]</color> 지부를 맡고 있어요.",
      "UnitTalk_JPN": "<color=#F7BE45>「アポカリプス商会」</color>のNOA店を担当しています。",
      "TalkTime": 0.03
    },
    {
