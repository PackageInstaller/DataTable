    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_LANCER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": "평소처럼 망원경을 들고 나왔는데 베스타 양과 만나게 됐답니다.",
      "UnitTalk_JPN": "いつものように望遠鏡を持って出かけたところ、ベスタさんに偶然お会いしたのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_LANCER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_LANCER",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "인기척을 숨길 수 있는 장소, 고배율의 망원경 렌즈.",
      "UnitTalk_JPN": "身を潜められる場所、高倍率の望遠鏡レンズ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_LANCER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_LANCER",
      "UnitTalk_KOR": "돈으로 살 수 없는 귀중한 것들을 에핀델님에게 잔뜩 받았습니다.",
      "UnitTalk_JPN": "お金では買えない貴重なことを、エピンデル様からたくさん教わりました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_LANCER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_LANCER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "서부 탈환대의 전사로서 이 은혜는 언젠가 반드시 갚겠습니다, 에핀델 님.",
      "UnitTalk_JPN": "西部奪還隊の戦士として、このご恩はいつか必ずお返しします。",
      "TalkTime": 0.03
    },
