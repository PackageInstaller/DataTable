      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NOA_KNIGHT_RED",
      "UnitNameString": [
        "SI_NPC_TOWNGUARD"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "두 분 덕분에 퇴치가 수월하게 끝났습니다. 정말 감사드립니다.",
