      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "키라는 불안한 표정으로 내 몸을 구석구석 살폈다.",
      "UnitTalk_JPN": "キラは不安そうな表情で、私の体を隅々までチェックした。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "다치진 않았어? 불편한 곳은?",
      "UnitTalk_JPN": "怪我はない？具合はどう？",
      "TalkTime": 0.03
    },
