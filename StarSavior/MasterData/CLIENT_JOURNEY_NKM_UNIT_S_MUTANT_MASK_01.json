    },
    {
      "Uid": 80,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "응. <color=#F7BE45>말</color>에 힘이 담기는 능력.",
      "UnitTalk_JPN": "うん。<color=#F7BE45>言葉</color>に力を宿らせる能力。",
      "TalkTime": 0.03
    },
    {
      "Uid": 81,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "키라가 가지고 있는 능력이야.",
      "UnitTalk_JPN": "キラが持ってる能力なの。",
      "TalkTime": 0.03
    },
