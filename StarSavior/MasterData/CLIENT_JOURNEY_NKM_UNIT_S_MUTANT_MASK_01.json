      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "어렸을 적부터 쭉 그랬어. ",
      "UnitTalk_JPN": "小さい頃からずっとそうだったんだよ。",
      "TalkTime": 0.03
    },
