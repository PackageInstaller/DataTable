      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "…단장은 <color=#F7BE45>언령</color>이라는 말, 들어본 적 있어? ",
      "UnitTalk_JPN": "…団長は、<color=#F7BE45>言霊</color>って聞いたことある？",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "언령?",
