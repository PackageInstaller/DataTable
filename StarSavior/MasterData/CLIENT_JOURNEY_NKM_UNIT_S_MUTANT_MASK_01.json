      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "…응. 단장에게 미움받아도 어쩔 수 없네. ",
      "UnitTalk_JPN": "…うん。団長に嫌われても仕方ないよね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 99,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "전부 내 능력 탓이니까. ",
      "UnitTalk_JPN": "全部、キラの能力が悪いの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 100,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "걱정 마!",
          "JumpAnchorStringId_JPN": "心配しないで！"
        }
      ]
    },
    {
      "Uid": 101,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "으응…? ",
      "UnitTalk_JPN": "うん…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 102,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "여정 단장으로서 어떻게든 방법을 찾아볼 테니까.",
          "JumpAnchorStringId_JPN": "旅の団長として、どうにか方法を見つけてみせるから。"
        }
      ]
    },
    {
      "Uid": 103,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "…아하하. ",
      "UnitTalk_JPN": "…あはは。",
      "TalkTime": 0.03
    },
    {
      "Uid": 104,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "고마워. 단장. ",
      "UnitTalk_JPN": "ありがとう、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 105,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "말 뿐이라고 해도… 키라, 힘이 조금 날지도. ",
      "UnitTalk_JPN": "そう言ってくれただけでも…キラ、ちょっと元気出たかも。",
      "TalkTime": 0.03
    },
    {
      "Uid": 106,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "어두웠던 키라의 표정이 조금이나마 밝아지는 것이 느껴졌다. ",
      "UnitTalk_JPN": "暗かったキラの表情が、少し明るくなったのが感じられた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 107,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "<color=#F7BE45>언령</color>이라는 특수한 능력을 가진 여정 단원이라… ",
      "UnitTalk_JPN": "<color=#F7BE45>言霊</color>という特殊な能力を持つ旅の団員か…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 108,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "어떤 방법으로 훈련하는 것이 좋을지 고민해봐야겠다. ",
      "UnitTalk_JPN": "どうトレーニングすべきか、考えてみよう。",
