      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…방금 내가 다쳤어야 되는 거야?",
          "JumpAnchorStringId_JPN": "…私が怪我をすべきだったってこと？"
        }
