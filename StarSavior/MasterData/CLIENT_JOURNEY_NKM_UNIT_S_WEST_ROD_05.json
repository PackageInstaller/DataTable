      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>상냥하고</color>… <color=#F7BE45>마음씨 따뜻한</color>이라…",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>優しくて</color>…<color=#F7BE45>心温かい</color>か…"
        }
