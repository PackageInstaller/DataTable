    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "훈련 계획에 참고할 만한 책을 찾기 위해 도서관에 방문했을 때였다. ",
      "UnitTalk_JPN": "トレーニングに役立ちそうな本を読もうと、図書館を訪れた時のことだった。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "한창 책을 찾던 와중, 책장 너머로 익숙한 목소리가 들려왔다. ",
      "UnitTalk_JPN": "本を探していると、本棚の向こうから聞き覚えのある声がした。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_UNKNOWN"
      ],
      "UnitTalk_KOR": "흐응~ 이건 아니고… ",
      "UnitTalk_JPN": "う～ん。これでもないし… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_UNKNOWN"
      ],
      "UnitTalk_KOR": "이건 별로 의미 없는 내용만 있고… 다른 건… 어느 칸에 있다고 했더라?",
      "UnitTalk_JPN": "これは大したことが書かれてないし…他には…どこにあるんだっけ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "급히 책장 너머를 확인해 봤지만, 그곳엔 아무도 없었다. ",
      "UnitTalk_JPN": "慌てて本棚の向こうを確認してみたが、そこには誰もいなかった。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_TEENAGER_FEMALE",
      "UnitNameString": [
        "SI_LIBRARIAN"
      ],
      "UnitMotion": "SMILE",
      "UnitPos": "POS6",
      "UnitTalk_KOR": "뭔가 찾으시는 책이라도 있나요?",
      "UnitTalk_JPN": "何かお探しですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그건 아닙니다만…",
          "JumpAnchorStringId_JPN": "本を探している訳ではないんですが…"
        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "방금 분명 리디아 목소리가…",
          "JumpAnchorStringId_JPN": "確かにリディアの声が…"
        }
      ]
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_TEENAGER_FEMALE",
      "UnitNameString": [
        "SI_LIBRARIAN"
      ],
      "CameraOffset": "ONE_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "리디아요…? 아! ",
      "UnitTalk_JPN": "リディアですか…？あっ！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_TEENAGER_FEMALE",
      "UnitNameString": [
        "SI_LIBRARIAN"
      ],
      "UnitTalk_KOR": "그 특이하게 생긴 가방을 멘 분 말이죠? ",
      "UnitTalk_JPN": "あの、変わったリュックの方でしょう？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "알고 계십니까?",
          "JumpAnchorStringId_JPN": "ご存じですか？"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_TEENAGER_FEMALE",
      "UnitNameString": [
        "SI_LIBRARIAN"
      ],
      "CameraOffset": "TWIN_1",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그럼요, 그저께부터였나…? ",
      "UnitTalk_JPN": "もちろんです。いつからだったかしら…？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_TEENAGER_FEMALE",
      "UnitNameString": [
        "SI_LIBRARIAN"
      ],
      "UnitTalk_KOR": "도서관에 가장 먼저 찾아와서 가장 늦게 돌아가시는 손님인데, 모를 리가 없죠.",
      "UnitTalk_JPN": "一番乗りで来て、一番遅くまで残っていらっしゃいますから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_TEENAGER_FEMALE",
      "UnitNameString": [
        "SI_LIBRARIAN"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "후후, 얼마나 상냥하시고 마음씨 따뜻하신지… ",
      "UnitTalk_JPN": "ふふっ。すごく優しくて、心温かい方ですよね… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_TEENAGER_FEMALE",
      "UnitNameString": [
        "SI_LIBRARIAN"
      ],
      "UnitTalk_KOR": "눈을 마주칠 때마다 밝게 인사해 주시고, 매번 작은 간식거리도 가져주신답니다. ",
      "UnitTalk_JPN": "目が合うたびに、にこっと微笑んで挨拶してくれるんです。それに、いつもちょっとしたお菓子までくださるんですよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitPos": "POS9"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_TEENAGER_FEMALE",
      "UnitNameString": [
        "SI_LIBRARIAN"
      ],
      "UnitTalk_KOR": "지금쯤 저쪽 책상에 계실 것 같은데…",
      "UnitTalk_JPN": "さっきまで、あの机にいらっしゃったと思うんですが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_TEENAGER_FEMALE",
      "UnitNameString": [
        "SI_LIBRARIAN"
      ],
      "UnitTalk_KOR": "마침 저기 계시네요. ",
      "UnitTalk_JPN": "あっ、ちょうどいらっしゃいましたね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "TWIN_4",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "음…? 앗, 단장님! 여기서 뵙네요? ",
      "UnitTalk_JPN": "うん…？あっ、団長さん。こんなところでお会いするなんて。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "책 빌리러 오셨나봐요? ",
      "UnitTalk_JPN": "本を借りに来られたんですか？ ",
      "TalkTime": 0.03
    },
