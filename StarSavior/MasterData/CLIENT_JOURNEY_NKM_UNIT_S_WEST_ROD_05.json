    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "에이에이~ 그렇게까지 전력을 다해서 부정하실 필요는 없잖아요?",
      "UnitTalk_JPN": "もぉ～、そんな必死に否定しなくてもいいじゃないですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "그러다가는 저, 상처받아 버릴지도 모른다구요? ",
      "UnitTalk_JPN": "私、傷ついちゃいますよ？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이 책은 다 뭐야?",
          "JumpAnchorStringId_JPN": "この本は？"
        }
      ]
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아아, 알아볼 게 좀 있어서요. ",
      "UnitTalk_JPN": "あぁ、調べたいことがあって。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "알아볼 거라면…?",
          "JumpAnchorStringId_JPN": "調べたいこと…？"
        }
      ]
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "저번에 그 도둑 아저씨한테 받은 돌 때문에요. ",
      "UnitTalk_JPN": "この前、泥棒のおじさんにもらった石のことです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "<color=#F7BE45>돌은 나훔 광산에서 나온 것이라고 들었다.</color>",
      "UnitTalk_JPN": "<color=#F7BE45>石はナホム鉱山で採掘されたものだ</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "그때 그 아저씨가 그렇게 말했었죠?",
      "UnitTalk_JPN": "あのおじさん、そう言ってましたよね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그런데 그 광산 말이에요. ",
      "UnitTalk_JPN": "でも、その鉱山がですね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "아무래도 망해버린 것 같더라구요. ",
      "UnitTalk_JPN": "どうやら、ダメになっちゃったみたいです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그것도 완전 폭삭.",
      "UnitTalk_JPN": "それも、完全に。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "흔적도 없이!",
      "UnitTalk_JPN": "跡形もなく！",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "사실 직접 찾아가 볼까 했거든요.",
      "UnitTalk_JPN": "実を言うと、行ってみようかなって思ってたんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "그래서 거기까지 가는 행상인이나 마부를 좀 물색해봤는데…",
      "UnitTalk_JPN": "鉱山に向かうための、行商人や御者も調べてみたんですけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "하나같이 질색을 하면서 내쫓던 거 있죠? ",
      "UnitTalk_JPN": "全員に嫌な顔をされて、追い返されちゃったんですよ？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "내쫓았다고?",
          "JumpAnchorStringId_JPN": "追い返されたって？"
        }
      ]
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "네. 그 근방만 가면 <color=#F7BE45>이상한 일</color>이 일어난다면서 절대 가지 않을 거래요. ",
      "UnitTalk_JPN": "鉱山に近づけば<color=#F7BE45>奇妙なこと</color>が起こるので、絶対に行かないそうです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "벌써 요 몇 달간 증발하듯 사라진 사람이 한둘이 아니라는 소문도 있던데요?",
      "UnitTalk_JPN": "ここ数か月間の行方不明者も、一人や二人じゃないそうですよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "그래서 그 <color=#F7BE45>나훔 광산</color>이라는 곳에 대해서 좀 알아보던 중이었죠. ",
      "UnitTalk_JPN": "それで、<color=#F7BE45>ナホム鉱山</color>について調べていたんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "자료를 뒤지다 보면, 뭔가 건질만한 단서가 나오지 않을까요?",
      "UnitTalk_JPN": "資料を漁れば、何か役立つ手掛かりが見つかると思いませんか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "아직까진… 별로 특이한 점은 발견되지 않았지만요.",
      "UnitTalk_JPN": "今のところ…まだ大した情報は見つかっていませんけどね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "기껏해야… 꽤 오래된 광산이라는 것 정도?",
      "UnitTalk_JPN": "分かったのは…かなり古い鉱山だってことぐらいです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": false,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_DOOR_OPEN_1.wav"
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "어? ",
      "UnitTalk_JPN": "あら？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": false,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_MOVEMENT_FOOT_STEP_05.wav"
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_OBSERVER_FEMALE_1",
      "UnitNameString": [
        "SI_ORBITAL_RECONMEM"
      ],
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitPos": "POS2",
      "UnitTalk_KOR": "<color=#F7BE45>궤도 수색대</color>에서 나왔습니다. 잠시 실례하겠습니다. ",
      "UnitTalk_JPN": "<color=#F7BE45>軌道捜索隊</color>の者です。少しお時間よろしいですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_OBSERVER_FEMALE_1",
      "UnitNameString": [
        "SI_ORBITAL_RECONMEM"
      ],
      "UnitTalk_KOR": "<color=#F7BE45>서부 탈환대원</color>이자 <color=#F7BE45>여정 단원</color>이신 리디아 씨, 본인 맞으십니까?",
      "UnitTalk_JPN": "<color=#F7BE45>西部奪還隊の隊員</color>であり、<color=#F7BE45>旅の団員</color>であるリディアさんでお間違いありませんね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "아…? 네…! 제가 리디아에요. ",
      "UnitTalk_JPN": "えっ…？はい…！私がリディアです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_OBSERVER_FEMALE_1",
      "UnitNameString": [
        "SI_ORBITAL_RECONMEM"
      ],
      "UnitTalk_KOR": "다름이 아니라, 최근 <color=#F7BE45>나훔 광산</color>에 대해 알아보고 다니셨다고…? ",
      "UnitTalk_JPN": "最近、<color=#F7BE45>ナホム鉱山</color>について調べられているそうですが… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_OBSERVER_FEMALE_1",
      "UnitNameString": [
        "SI_ORBITAL_RECONMEM"
      ],
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "혹시, 따로 그 광산에 대해 조사하시는 이유가 있습니까?",
      "UnitTalk_JPN": "理由をお伺いできますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "헛… 혹시 제가 뭔가 잘못한 건가요…? ",
      "UnitTalk_JPN": "はっ…私、何かいけないことをしてしまいましたか…？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_OBSERVER_FEMALE_1",
      "UnitNameString": [
        "SI_ORBITAL_RECONMEM"
      ],
      "UnitTalk_KOR": "…그건 리디아 씨의 답변에 따라 달라질 수도 있다고만 말씀드리죠. ",
      "UnitTalk_JPN": "…それは、リディアさんのご返答次第とだけお伝えしておきましょう。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "ONE_7",
      "CameraOffsetTime": "NR",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "그게 사실… ",
      "UnitTalk_JPN": "それが、実は… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "저희 <color=#F7BE45>서부 탈환대</color>의 대원 한 명이 부탁한 게 있거든요.",
      "UnitTalk_JPN": "<color=#F7BE45>西部奪還隊</color>の隊員に、頼まれていることがあるんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "서부가 황폐화되고 나서 떨어져 지내게 된 친척이 있다고-",
      "UnitTalk_JPN": "西部が荒廃してから、離れ離れになってしまった親戚がいて──",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "그 친척이 <color=#F7BE45>나훔 광산</color> 근처에서 살고 있으니까 안부 좀 전해달라고 그했어요. ",
      "UnitTalk_JPN": "その親戚が<color=#F7BE45>ナホム鉱山</color>の近くに住んでいるため、近況を伝えてほしいと言われたんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그래서 그냥 알아본 거예요! 다른 이유는 정말 없었어요.",
      "UnitTalk_JPN": "それで、調べていました！他に理由はありませんよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_OBSERVER_FEMALE_1",
      "UnitNameString": [
        "SI_ORBITAL_RECONMEM"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…하하. 그렇습니까?",
      "UnitTalk_JPN": "…ははっ、そうですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_OBSERVER_FEMALE_1",
      "UnitNameString": [
        "SI_ORBITAL_RECONMEM"
      ],
      "UnitTalk_KOR": "사실 얼마전에 그 폐광산에서 조금… 불미스러운 사고가 벌어졌습니다.",
      "UnitTalk_JPN": "実は少し前に、あの廃鉱山で…忌まわしい事故が起こったのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_OBSERVER_FEMALE_1",
      "UnitNameString": [
        "SI_ORBITAL_RECONMEM"
      ],
      "UnitTalk_KOR": "그 과정에서 광산 내 유독한 가스가 밖으로 새어 나왔구요. ",
      "UnitTalk_JPN": "そして、鉱山内の有毒なガスが外に漏れ出してしまいました。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "저, 정말요?",
      "UnitTalk_JPN": "ほ、本当ですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_OBSERVER_FEMALE_1",
      "UnitNameString": [
        "SI_ORBITAL_RECONMEM"
      ],
      "CameraOffset": "ONE_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "네. 안전을 위해 그 근방은 출입 금지 조치가 되어있습니다.  ",
      "UnitTalk_JPN": "はい。安全確保のため、鉱山の付近は立ち入り禁止となっています。  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_OBSERVER_FEMALE_1",
      "UnitNameString": [
        "SI_ORBITAL_RECONMEM"
      ],
      "UnitTalk_KOR": "그러니… <color=#F7BE45>나훔 광산</color> 근방에는 접근하지 않는 편이 좋습니다. ",
      "UnitTalk_JPN": "ですので…<color=#F7BE45>ナホム鉱山</color>の辺りには、お近づきにならない方が良いかと。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_05",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "IN"
    },
    {
