    {
      "Uid": 84,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "한결 부드러워진 목소리에 의아함이 들었다.",
      "UnitTalk_JPN": "一段と柔らかくなった声に、いぶかしさを覚えた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 85,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_UNKNOWN"
      ],
      "UnitTalk_KOR": "눈을 뜨세요, 단장님.",
      "UnitTalk_JPN": "目を開けてください、団長さま。",
      "TalkTime": 0.03
    },
    {
      "Uid": 86,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이 목소리는… 리사가 아니라…",
