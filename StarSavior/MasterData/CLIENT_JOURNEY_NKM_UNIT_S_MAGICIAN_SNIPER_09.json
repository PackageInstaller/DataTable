      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하핫! 그럴 리 없잖아.",
      "UnitTalk_JPN": "あははっ！そんなわけないじゃん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "그냥, 언제 말할지 고민하고 있었어.",
      "UnitTalk_JPN": "ただ、いつ話そうかなって迷ってたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "저번에 <color=#F7BE45>고양이의 최후</color>가 속설이라고 말해줬잖아?",
      "UnitTalk_JPN": "この前、<color=#F7BE45>猫の最期</color>は根拠のない迷信だって教えてくれたでしょ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "단장의 말이 맞았어.",
      "UnitTalk_JPN": "団長さんが正しかったよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "고향에 편지를 보냈는데 옆집 아저씨가 소식을 보내주셨거든.",
      "UnitTalk_JPN": "故郷に手紙を送ったらね、隣の家のおじさんから連絡があったの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아버지가 다시 사냥을 시작했어.",
      "UnitTalk_JPN": "パパ、また狩りを始めたんだって。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "옛날처럼 총은 쓰지 않지만 함정을 설치하고 다니신다고 해.",
      "UnitTalk_JPN": "昔みたいに銃は使わないけど、罠を仕掛けたりしてるんだってさ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "위대한 사냥꾼이 곧 돌아올 것 같아.",
      "UnitTalk_JPN": "もうすぐ偉大なハンターが戻ってくるよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "좋은 소식이네.",
          "JumpAnchorStringId_JPN": "いい知らせだね。"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "아하핫! 그렇지. 하지만 해결되지 않은 일이 많이 남아있어.",
      "UnitTalk_JPN": "あははっ！そうだよね？でも、まだやるべきことは山積みなんだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "<color=#F7BE45>시험</color>도 통과해야 하고, <color=#F7BE45>여정</color>도 완주해야 하고.",
      "UnitTalk_JPN": "<color=#F7BE45>試験</color>を通過して、<color=#F7BE45>旅</color>を成し遂げて…",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "우리 부족의 숙명…",
      "UnitTalk_JPN": "それに、アルク族の運命…",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "그리고 이미 빛을 잃은 사람들의 시력을 회복할 방법도 찾아야 하지.",
      "UnitTalk_JPN": "すでに光を失ってしまった人たちの、視力を取り戻す方法も見つけないと。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "갈 길이 멀어.",
      "UnitTalk_JPN": "長い道のりになりそうだね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "하지만 괜찮아.",
      "UnitTalk_JPN": "でも、大丈夫。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "단장이 그랬지? 해결책을 찾을 때까지 같이 있어주겠다고.",
      "UnitTalk_JPN": "団長さんが言ってくれたでしょ？解決策が見つかるまで一緒にいてくれるって。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "외롭지는 않을 것 같아서 다행이네~",
      "UnitTalk_JPN": "おかげで寂しくないよ、助かっちゃうな～。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "찾을 때까지 같이 있을게.",
