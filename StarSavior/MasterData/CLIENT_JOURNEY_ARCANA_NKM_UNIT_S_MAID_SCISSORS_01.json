    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CHILD_MALE",
      "UnitNameString": [
        "SI_BOY"
      ],
      "UnitTalk_KOR": "내 카드가 제일 강한 카드였는데…!",
      "UnitTalk_JPN": "オレのカードが最強だったのに…！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "CameraOffset": "TWIN_2",
      "UnitMotion": "SMILE",
      "UnitPos": "POS7",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "크하하하! 위대한 용족 앞에 무릎 꿇어라 인간 꼬마들!",
      "UnitTalk_JPN": "フハハハ！偉大なる竜族の前にひれ伏すのだ！人間の小童ども！",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CHILD_MALE",
      "UnitNameString": [
        "SI_BOY"
      ],
      "CameraOffset": "TWIN_5",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitPos": "POS6",
      "UnitTalk_KOR": "누나, 주사위에 속임수 쓴 거 아니야? 아니면 카드를 몰래 한 장 숨겼다든가!",
      "UnitTalk_JPN": "おねえちゃん、サイコロにイカサマとかしてない？まさか、カードを1枚、こっそり隠しているとか！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CHILD_FEMALE",
      "UnitNameString": [
        "SI_GIRL"
      ],
      "CameraOffset": "TRIPLE_4",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitPos": "POS8",
      "UnitTalk_KOR": "바보야. 상대는 스칼렛 언니라고. 그런 머리 아프고 복잡한 짓을 할 수 있겠어?",
      "UnitTalk_JPN": "バカね。相手はスカーレットおねえちゃんなのよ。そんな手の込んだこと、できるはずないでしょう？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CHILD_MALE",
      "UnitNameString": [
        "SI_BOY"
      ],
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아… 미안 누나! ",
      "UnitTalk_JPN": "そっか、ごめん！ねえちゃん！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "흐하하! 그래그래. 나처럼 고귀한 용족이 속임수 따위를 쓸 리가!",
      "UnitTalk_JPN": "ワッハッハー！わかれば良い。わがはいのような高貴な竜族はイカサマなどしないのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "그런데 기분이 이상하다…! 그거 칭찬 맞지?",
      "UnitTalk_JPN": "しかし変だな…！褒められた気がしないのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
