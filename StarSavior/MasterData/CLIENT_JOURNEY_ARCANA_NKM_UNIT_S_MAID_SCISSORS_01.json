      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitTalk_KOR": "음! 날개를 보여주려면 준비가 필요하다는 말씀.",
      "UnitTalk_JPN": "うむ！翼をみせるには、その準備をしないとな。",
      "TalkTime": 0.03
    },
    {
