      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "크, 크흠! 어리석은 인간 꼬마들!",
      "UnitTalk_JPN": "こ、コホン！おろかな人間の小童どもよ！",
      "TalkTime": 0.03
    },
    {
