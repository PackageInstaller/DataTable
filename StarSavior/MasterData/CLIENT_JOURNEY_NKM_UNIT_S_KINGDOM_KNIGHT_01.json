    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "이번 <color=#F7BE45>여정</color>에 여정 단원으로 초대된 모나스티르 공국 기사단의 기사단장, 샤를이라고 하는데요…",
      "UnitTalk_JPN": "この度<color=#F7BE45>「救援の旅」</color>に団員として招かれた、モナスティル公国騎士団の団長を務める、シャルルという者ですが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 4.0,
      "BgCrashTime": 0.4,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…윽.",
      "UnitTalk_JPN": "…うっ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "아, 아니 샤를이라 합니다!",
      "UnitTalk_JPN": "い、いえシャルルと申します！",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "여정 기간 동안 많은 지도 편달 부탁드립니다.",
      "UnitTalk_JPN": "旅の間、ご指導ご鞭撻のほどよろしくお願いいたします。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "공국 기사단을 대표하는 사람으로서 모범적인 모습을 보여드리고 싶었습니다만…",
      "UnitTalk_JPN": "公国騎士団の代表として、模範的な姿をお見せしようとしましたが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "마음만 너무 앞서 나간 것 같습니다.",
      "UnitTalk_JPN": "つい先走ってしまったようです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "괜찮아, 인상 깊은 자기소개였어.",
          "JumpAnchorStringId_JPN": "大丈夫、心に残る自己紹介だった"
        }
      ]
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그, 그런가요? 그렇다면 다행이네요!",
      "UnitTalk_JPN": "そ、そうですか？それなら良かった！",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "아, 아니, 다행입니다!",
      "UnitTalk_JPN": "い、いえ、良かったです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "제가 일반 기사단원에서 기사단장으로 임명된 지 오래되지 않아서…",
      "UnitTalk_JPN": "私がまだ一般団員から、団長に任命されて間もないせいか…",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "아직도 기사단원일 때의 말투가 잘 고쳐지지 않습니다.",
      "UnitTalk_JPN": "まだ団員の頃の口癖が直らないのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "게다가 기사단장이 된 후로는 높으신 분들을 뵙거나 공적인 자리에도 참석하게 되었는데…",
      "UnitTalk_JPN": "しかも騎士団長になってからは、高貴な方たちと謁見したり、公の行事に参加するようになりましたのに…",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "그럴 때의 몸가짐이나 예법에 대해서는 아직도 배워 나가고 있는 중입니다.",
      "UnitTalk_JPN": "そのための立ち振る舞いや作法については、まだ学んでいる最中なのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "우우… 어쩌다 내가 기사단장이 된 거지…",
      "UnitTalk_JPN": "うぅ…どうしてあたしなんかを騎士団長に任命したんだろう…",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "여정 훈련 중에는 말투에 크게 신경 쓰지 마.",
          "JumpAnchorStringId_JPN": "旅の訓練中は、話し方に気を付けなくてもいいよ"
        }
      ]
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "저, 정말요? 하, 하지만…",
      "UnitTalk_JPN": "ほ、本当ですか？し、しかし…",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "그… 기사단장으로서의 품위 있는 모습을…",
