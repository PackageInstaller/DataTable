    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 1.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_EARTHQUAKE_03.wav",
      "UnitTalk_KOR": "이어서 당황해 내가 움츠러든 순간, 피한 줄 알았던 용들이 등 뒤에서 덮쳐오는…",
      "UnitTalk_JPN": "続いて、私がひるんだ瞬間…避けたはずの龍が、背後から襲い掛かってくる。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아직 일어나지 않은 일들에 대한 너무나도 생생한 기억.",
      "UnitTalk_JPN": "経験したことのない記憶にしては、あまりにも鮮明だ。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
