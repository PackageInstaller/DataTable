        }
      ]
    },
    {
      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgFlashBang": 0.3,
      "BgCrash": 0.5,
      "BgCrashTime": 1.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_SWORD_SHIMMER_03.wav",
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "손에 무언가 충돌하는 느낌과 함께, 등을 노리고 날아들던 용들이 검에 베이며 소멸한다.",
      "UnitTalk_JPN": "手に何かがぶつかる感触とともに、背後を狙っていた龍は消滅した。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 31,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "하아… 하아…!!",
          "JumpAnchorStringId_JPN": "はぁ…はぁ…！！"
        }
      ]
    },
    {
      "Uid": 32,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "CameraOffset": "DEFAULT",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "…아해야 방금 뭘 한 것이냐?",
      "UnitTalk_JPN": "…童よ。今、何をしたのじゃ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "레이시의 눈에는 조금 전의 내 행동이 등 뒤에 눈이라도 달린 것처럼 보였을 것이다.",
      "UnitTalk_JPN": "レイシーの目には…今の私の行動が、背中に目でも付いているように見えただろう。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 34,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이걸 어떻게 설명해야 할지 모르겠다.",
      "UnitTalk_JPN": "どう説明すべきなんだ？",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 35,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…모르겠어.",
          "JumpAnchorStringId_JPN": "…分からない。"
        }
      ]
    },
    {
      "Uid": 36,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "모르겠다고?",
      "UnitTalk_JPN": "分からない、じゃと？",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그냥, 이렇게 될 줄 알고 있었어.",
          "JumpAnchorStringId_JPN": "ただ、こうなると思って。"
        }
      ]
    },
    {
      "Uid": 38,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "미래를 보기라도 했다는 말이냐?",
      "UnitTalk_JPN": "未来を見通したという訳か？",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "조금 다르다. 이건 예지보다는… 그래, 경험이다.",
      "UnitTalk_JPN": "少し違う。これは予知というより…そう、経験だ。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 40,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "나는 이 일을 이미 경험했던 것 같은 기분이 드는…",
      "UnitTalk_JPN": "すでに経験したことがあるような感覚…",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 41,
      "WaitClick": false,
      "WaitTime": 1.0,
