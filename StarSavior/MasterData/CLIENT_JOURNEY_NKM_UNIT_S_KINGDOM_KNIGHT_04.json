      "RewardAnchor": "REWARD_ANCHOR_1",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_CANDLE_GROUND.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_02.mp3",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SMILE",
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "훈련장에 도착해 보니, 샤를이 뭔가를 읽고 있었다.",
      "UnitTalk_JPN": "訓練場に着くと、シャルルが何かを読んでいた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "내가 온 것도 모를 정도로 집중해 있는 모습이지만, 표정에는 미소가 가득했다.",
      "UnitTalk_JPN": "こちらが来たことも気づかないほど集中している様子だが、なんとも幸せそうな表情をしていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아, 단장님!",
      "UnitTalk_JPN": "あっ、団長！",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "오셨습니까! 바로 훈련에 들어갈 수 있도록 준비 완료입니다!",
      "UnitTalk_JPN": "いらっしゃったのですか！すぐに訓練を開始できるよう準備は済ましております！",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아, 제가 읽고 있던 거요?",
      "UnitTalk_JPN": "あ、私が読んでいたものですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "헤헤, 모나스티르 기사단의 친구들이 안부 편지를 보내줬어요.",
      "UnitTalk_JPN": "あはは、モナスティル騎士団の友人たちが手紙を送ってくれたのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "앗… 친구들이라고 표현하면 좀 그렇죠? 제가 기사단장인데… 으음…",
      "UnitTalk_JPN": "おっと…友人と言えば変でしょうか？私が騎士団長なのに…ふむ—",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그럼… 동료들?",
      "UnitTalk_JPN": "では…仲間たち？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "부하라는 생각은 잘 안 들어요. 일반 기사단원 시절부터 함께 해온 사람들인걸요.",
      "UnitTalk_JPN": "部下という認識はないですね。一般団員の頃から共に頑張ってきた人たちですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "으으… 역시 아직 기사단장으로서의 자각이 부족하다는 생각이 드네요…",
      "UnitTalk_JPN": "うぅ…まだ騎士団長としての自覚が足りない気がしますね…",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "편지를 보면서 웃고 있던데.",
          "JumpAnchorStringId_JPN": "手紙を見て笑顔を浮かべていたね。"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "헤헤헤… 다들 응원의 한마디씩을 적어서 보내줬어요.",
      "UnitTalk_JPN": "あはは…みんなで応援の言葉を書いてくれたのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "프레이 님… 아니, 프레이 보급관이 또 조금 말썽을 부리고 있는 것 같지만…",
      "UnitTalk_JPN": "フレイ様…いえ、フレイ補給官が多少トラブルを起こしているようですが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그 외에는 별일 없이 다들 잘 지내고 있는 것 같아요.",
      "UnitTalk_JPN": "それ以外は、みんな問題なく過ごしているようです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "솔직히 말씀드리자면!",
      "UnitTalk_JPN": "正直に申し上げますと！",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "내가 없는데도 다들 잘 지내는 거면 난 필요 없는 기사단장이 아닐까… 하고 잠시 생각했습니다만!",
      "UnitTalk_JPN": "私がいなくても、みんな上手くやっているのであれば、私は騎士団長として失格かな…と考えてしまったのですが！",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "다들 이렇게! 편지 가득 응원의 말을 남겨줬어요!",
      "UnitTalk_JPN": "みんなでこう！紙面いっぱいに応援の言葉を残してくれました！",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "샤를이 훌륭한 기사단장이라는 증거로군.",
          "JumpAnchorStringId_JPN": "シャルルが立派な騎士団長という証拠だな"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "아니, 그건 아직이라고 생각하는데요…",
      "UnitTalk_JPN": "いえ、それは、まだとは思いますけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "USN_UI_TOUCH",
      "UnitTalk_KOR": "하지만! 이렇게 응원해 주는 모두를 위해서!",
      "UnitTalk_JPN": "しかし！応援してくれる、みんなのために！",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.8,
      "BgCrashTime": 0.5,
      "StartFxSoundName": "SFX_BATTLE_COMMON_POP.wav",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "힘내서 정진하고 훈련해서 멋진 모습으로 돌아갈 생각입니다!",
      "UnitTalk_JPN": "訓練を積み重ね、更なる成長を遂げて戻るつもりです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "으음! 좋은 마음가짐!",
          "JumpAnchorStringId_JPN": "うむ！その意気やよし！"
        }
      ]
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "다행히 요새는 국경 외각의 마수들도 조용하다고 하네요.",
      "UnitTalk_JPN": "幸いなことに、近頃は国境付近の魔獣たちも大人しいとの事です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "마수들?",
          "JumpAnchorStringId_JPN": "魔獣たち？"
        }
      ]
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "네, 모나스티르 공국은 산맥 하나를 사이에 두고 마수들의 터전이라고 불리는 북부 지방과 맞닿아 있거든요.",
      "UnitTalk_JPN": "はい、モナスティル公国は山脈を境に、魔獣の拠点と呼ばれる北部地方と接していますので。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "때때로 마수들의 무리가 사람들이 사는 곳으로 침공해 오는 경우도 종종 있어요.",
      "UnitTalk_JPN": "たまに魔獣の群れが、人の住む場所にまで侵攻してくるのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "확실치는 않지만 아직도 라비스타 곳곳에 영향을 끼치는 공허의 힘 때문에 그런 일이 생긴다고 합니다.",
      "UnitTalk_JPN": "定かではありませんが、ラビスターの随所で影響を及ぼしている空虚の力のせいとの説があります。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래서 그런 일이 있을 때 마수들을 막거나 대응하기 위해서 기사를 양성하고, 방벽을 쌓아 올리고…",
      "UnitTalk_JPN": "そのような事を防ぐか対応すべく騎士を養成し、防壁を築き上げ—",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "구원자들을 고용하거나 NOA에 도움을 청하는 일도 자주 있었죠.",
      "UnitTalk_JPN": "救援者たちを雇ったり、NOAに助けを要請することも多々ありました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그러다 보니 여러모로… 힘든 부분이 많아요.",
      "UnitTalk_JPN": "そのような経緯で、色々と難点が多いのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "마수들에게 부서진 마을이나 시설의 보수가 몇 년씩 걸리기도 하죠.",
      "UnitTalk_JPN": "空虚体や魔獣たちに破壊された、町や施設の補修工事に何年もかかったりします。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "제가 기사단장의 자리를 잠시 비우고 여정에 참가할 수 있었던 것도…",
      "UnitTalk_JPN": "私が騎士団長の席を不在にして、「救援の旅」に参加できる事も—",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "여정을 완수하고 별의 구원자의 힘을 계승 받는다면… 이런 일들을 해결할 수 있을 거라고 믿으니까요.",
      "UnitTalk_JPN": "「救援の旅」を成し遂げて、星の救援者の力を継承できたら…このような問題も解決できると信じてますので。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "다들 고생이 많겠네.",
          "JumpAnchorStringId_JPN": "みんな苦労してるんだね"
        }
      ]
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "하지만 그래서인지 모나스티르 공국 출신은 강인하다는 이야기를 자주 듣죠!",
      "UnitTalk_JPN": "それ故にモナスティル公国出身は、逞しいとの話をよく聞きます！",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_04",
      "WaitClick": true,
      "WaitTime": 0.0,
