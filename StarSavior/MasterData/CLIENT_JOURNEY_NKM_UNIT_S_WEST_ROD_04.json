      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "…어라? ",
      "UnitTalk_JPN": "…あら？ ",
      "TalkTime": 0.03
    },
    {
