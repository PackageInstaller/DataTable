      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "…단장님.  ",
      "UnitTalk_JPN": "…団長さん。  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "찾은 것 같아요. ",
