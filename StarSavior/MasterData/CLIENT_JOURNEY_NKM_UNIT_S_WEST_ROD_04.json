      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "조만간 찾아볼 테니까 평소엔 얌전히 있으라고 말-",
      "UnitTalk_JPN": "あとで探してあげるから、大人しく──",
