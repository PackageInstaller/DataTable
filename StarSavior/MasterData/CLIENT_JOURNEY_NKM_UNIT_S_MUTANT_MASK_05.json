      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_4",
      "UnitPos": "POS2"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "공원을 산책하던 중, 길가의 수풀이 부스럭거리는 것을 발견했다.",
      "UnitTalk_JPN": "公園を散歩していると、道端の茂みからガサガサと音がすることに気づいた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "뭐지…?",
          "JumpAnchorStringId_JPN": "なんだ…？"
        }
      ]
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이따금씩 흔들리는 수상한 수풀을 들춰보니… ",
      "UnitTalk_JPN": "ガサガサと揺れる茂みを探ってみると…",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": false,
      "WaitTime": 1.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_5",
      "CameraOffsetTime": "SL",
      "UnitMotion": "ANGRY"
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "키라가 수풀 속에 쪼그려 앉아 무서운 눈빛으로 노려보고 있었다. ",
      "UnitTalk_JPN": "キラが茂みの中にしゃがみ込み、怖い目つきで睨んできた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "…단장.",
      "UnitTalk_JPN": "…団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…키라? 거기서 뭐해?",
          "JumpAnchorStringId_JPN": "…キラ？そこで何してるんだ？"
        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_13.mp3",
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "뭐야? 누구랑 그렇게 다정하게 대화해?",
      "UnitTalk_JPN": "なんなの？誰とそんなに仲良く話してるの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "단장, 기분이 좋아 보이던데?",
      "UnitTalk_JPN": "団長、すごくご機嫌なの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "ONE_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "…아까 누군가한테 ‘귀여워’라고 말하지 않았어?",
      "UnitTalk_JPN": "…さっき誰かに「可愛い」って言ってなかった？",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "누가? 누가 그렇게 귀여워?",
      "UnitTalk_JPN": "誰なの？誰がそんなに可愛いの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "누구한테 한 소리야?  ",
      "UnitTalk_JPN": "誰に向かって言ってたの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장, 설마 키라 말고 다른 여자한테 한눈판 거야?",
      "UnitTalk_JPN": "団長、まさかキラじゃなくて他の女を見てたの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "오해가 있는 것 같은데…",
          "JumpAnchorStringId_JPN": "誤解しているようだけど…"
        }
      ]
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "응? 오해? ",
      "UnitTalk_JPN": "うん？誤解？",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_5",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "…아하하. 그렇지. 오해였지?",
      "UnitTalk_JPN": "…あはは。そうだよね。誤解だよね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "단장이 그런 짓을 할 리가 없잖아?",
      "UnitTalk_JPN": "団長がそんなことするわけないよね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "…아니면…",
      "UnitTalk_JPN": "…それとも…",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "저기 지나가는 저 여자에게 귀엽다고 했던 거야?",
      "UnitTalk_JPN": "あそこの通り過ぎているあの女に向かって可愛いって言ったの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그건 아니지? 그렇지?",
      "UnitTalk_JPN": "違うよね？そうだよね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "단장은 관심도 없는데 질척거려서 맞춰서 대답해 준 거지? ",
      "UnitTalk_JPN": "団長は興味がないのに、べたべたしてきたから仕方なく返事してあげたんだよね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그럼 그렇지. ",
      "UnitTalk_JPN": "そうだと思ったの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "단장, 귀찮았지? 이제 괜찮아. ",
      "UnitTalk_JPN": "団長、面倒くさかったでしょ？でも、もう大丈夫なの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "내가 치워줄게. ",
      "UnitTalk_JPN": "キラが片付けてあげる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "어떻게 해줬으면 해? ",
      "UnitTalk_JPN": "どうして欲しい？",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "지…진정해.",
          "JumpAnchorStringId_JPN": "お…落ち着いて。"
        }
      ]
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "ONE_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "따끔하게 혼쭐을 내줄까? ",
      "UnitTalk_JPN": "お仕置きがいい？",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "짓궂은 장난이라도 쳐주는 건 어때? ",
      "UnitTalk_JPN": "それとも、意地悪なイタズラでもしちゃうのはどうかな？",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…감히 내 소중한 단장을 빼앗아 가려고 했어. ",
      "UnitTalk_JPN": "…キラの大切な団長を奪おうとしたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "그러니까 나도 소중한 걸 빼앗는 거야. 딱 좋은 벌이지?",
      "UnitTalk_JPN": "だから、キラも大切なものを奪うの。ぴったりな罰だと思わない？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "그게 아니라면…",
      "UnitTalk_JPN": "それとも…",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_5",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "흐음. 말 그대로 <color=#F7BE45>치워</color>버릴까?",
      "UnitTalk_JPN": "ふむ…文字どおり<color=#F7BE45>片付け</color>ちゃおうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "단장 눈앞에 보이지 않도록 어딘가 멀리 보내버리는 거야.",
      "UnitTalk_JPN": "団長の目に入らないように、どこか遠くに飛ばしちゃうの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "영영 볼 수 없도록 멀리 말이야. ",
      "UnitTalk_JPN": "永遠に見ることができないように、遠く。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "응응. 그게 좋겠네. ",
      "UnitTalk_JPN": "うん、うん。それがいい。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "단장도 그렇게 생각하지? ",
      "UnitTalk_JPN": "団長もそう思うでしょ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…단장과 대화할 수 있는 건 나뿐이야… ",
      "UnitTalk_JPN": "…団長と話していいのは、キラだけなの…",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "다른 바보 같은 여자가 엉겨 붙는 건 용서 못 해. ",
      "UnitTalk_JPN": "他のバカ女が、団長に近づくのは許せないの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "우린 운명으로 이어진 사이인데… ",
      "UnitTalk_JPN": "キラたちは運命で結ばれているのに…",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "남들과 다르단 말이야. ",
      "UnitTalk_JPN": "他の人たちとは違うの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그만…!",
          "JumpAnchorStringId_JPN": "やめて…！"
        }
      ]
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_05",
      "WaitClick": false,
