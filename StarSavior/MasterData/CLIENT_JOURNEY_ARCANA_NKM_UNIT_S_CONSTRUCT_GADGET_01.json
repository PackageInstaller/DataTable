    {
      "Uid": 100,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitTalk_KOR": "네가 봐주면 실수 줄어들어.",
