    {
      "Uid": 98,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "난 그냥 구경꾼이야. 쓸데없이 참견했네.",
