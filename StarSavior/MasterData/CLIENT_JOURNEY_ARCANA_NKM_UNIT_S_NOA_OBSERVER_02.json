    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_NOA_OBSERVER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NOA_OBSERVER",
      "UnitTalk_KOR": "다른 사람에게 자신을 각인시키려면 얼마나 많은 노력이 필요한데요.",
      "UnitTalk_JPN": "印象づけるためには、努力が必要ですから！",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_NOA_OBSERVER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NOA_OBSERVER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "단장님은 알리시아 님에게 총애를 받는 인재…!",
      "UnitTalk_JPN": "団長は、アリシア様の寵愛を受ける人物…！",
