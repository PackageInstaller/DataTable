    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_NOA_OBSERVER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NOA_OBSERVER",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "초천재 엘리트! 나루라고 합니다!",
      "UnitTalk_JPN": "超天才エリートのナルです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_NOA_OBSERVER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
