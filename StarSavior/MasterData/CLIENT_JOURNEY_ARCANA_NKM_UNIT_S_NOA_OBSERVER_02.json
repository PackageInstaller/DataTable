      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_NOA_OBSERVER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "터무니없이 솔직하구나.",
          "JumpAnchorStringId_JPN": "とんでもなく正直だな。"
