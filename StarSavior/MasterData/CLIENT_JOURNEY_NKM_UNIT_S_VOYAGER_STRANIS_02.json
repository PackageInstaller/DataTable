      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "굉장하다, 단장. 훈련뿐 아니라 이런 것도 잘 아는구나!",
      "UnitTalk_JPN": "すごいよ、団長。訓練だけじゃなくて、料理にも詳しいんだ！",
      "TalkTime": 0.03
    },
