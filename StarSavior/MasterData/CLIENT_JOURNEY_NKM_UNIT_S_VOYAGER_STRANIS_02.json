      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "그, 그래?",
      "UnitTalk_JPN": "そ、そう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "하하, 오늘따라 유난히 시간이 안 가는 것 같네.",
      "UnitTalk_JPN": "ははっ、今日はなんだか時間が経つのが遅い気がするね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그럼… 다시 힘을 내서…",
      "UnitTalk_JPN": "じゃあ…気を取り直して…",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "잠깐.",
          "JumpAnchorStringId_JPN": "待て。"
        }
      ]
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "응? 왜 그래 단장.",
      "UnitTalk_JPN": "うん？どうしたの、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "요즘 컨디션이 계속 안 좋아 보이는데.",
          "JumpAnchorStringId_JPN": "最近、ずっと調子が悪いみたいだけど？"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "아… 그건…",
      "UnitTalk_JPN": "あ…それは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "하하, 티 내기는 싫었는데 단장에겐 다 보였나 보네.",
      "UnitTalk_JPN": "ははっ。隠そうと思ってたけど、団長にはお見通しかぁ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "너무 걱정할 필요는 없어. 어디가 아프거나 한 건 아니니까.",
      "UnitTalk_JPN": "心配いらないわ。どこか痛めたりしていないわ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그냥… 최근에 식사를 제대로 못 했거든.",
      "UnitTalk_JPN": "ただ…最近食事をちゃんと取れてなくて。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "그러다 보니 자꾸 배가 고파서 힘이 안 나네.",
      "UnitTalk_JPN": "だから、お腹が空いて力が出ないみたい。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "식사를 못했다고? 왜?",
          "JumpAnchorStringId_JPN": "食事を取れていない？どうして？"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그게… 으… 말하자니 좀 부끄럽네.",
      "UnitTalk_JPN": "それが…うぅ…話すには少し恥ずかしいんだけど。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "우리 집은 NOA에서 좀 떨어진 곳에 있거든.",
      "UnitTalk_JPN": "わたしの家ってNOAから少し離れたところにあるの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "여정의 참가자는 캔들 스퀘어를 통해 숙소가 주어지잖아?",
      "UnitTalk_JPN": "旅に参加するとキャンドル・スクエアから寮を提供してくれるでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "그래서 여정을 시작한 후로는 집에서 나와서 숙소에서 살고 있는데…",
      "UnitTalk_JPN": "だから旅を始めてからは、家を出てそこで暮らしてるんだけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "그…뭐랄까.",
      "UnitTalk_JPN": "その…何て言うか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "혼자 사는 건… 처음이라서 어렵다고나 할까…",
      "UnitTalk_JPN": "一人暮らしは…初めてだからよく分からなくて…",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "식사를 스스로 챙겨 먹는 게 어려웠다고나 할까…",
      "UnitTalk_JPN": "食事を自分で準備するのが難しかったっていうか…",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아아… 뭔지 알겠어.",
          "JumpAnchorStringId_JPN": "ああ…そうか。"
        }
      ]
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "혼자 사는 건 처음이라 나도 뭔가 만들어 보려고 했었는데…",
      "UnitTalk_JPN": "一人暮らしは初めてで、わたしも何か作ろうとは試みたんだけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그… 결과물이 좀… ",
      "UnitTalk_JPN": "その…出来上がったものがちょっと… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "시커멓거나 녹색으로 끈적이거나 바싹 오그라든 것밖에 안 나오더라고.",
      "UnitTalk_JPN": "真っ黒だったり、緑色で粘ついたり、ひどく縮んだりしてね…",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "심지어 지난주에는 요리하다가 불까지 났지 뭐야…",
      "UnitTalk_JPN": "しかも、先週は料理中に火事になっちゃって…",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아, 불은 잘 껐으니까 걱정하지 마.",
      "UnitTalk_JPN": "あ、火はちゃんと消したから心配しないで。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "환하게 웃으며 말하고 있지만, 표정에 드리운 피로감은 감춰지지 않았다.",
      "UnitTalk_JPN": "明るく笑いながら話しているが、疲れが顔に滲み出ていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "음식을 매번 사 먹기도 좀 그래서… 요새 식사가 조금 불규칙했어.",
      "UnitTalk_JPN": "毎回買って食べるのもあれだし…最近、食生活が不規則だったのよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "그래서 그런지 배도 고프고 힘도 안 나는 것 같긴 한데…",
      "UnitTalk_JPN": "そのせいで、お腹が空いて力が出なかったのかも…",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "…으음!",
      "UnitTalk_JPN": "…うぅむ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "괜찮아! 집을 나올 때 이 정도 시련은 각오했으니까!",
      "UnitTalk_JPN": "このくらい平気！家を出るとき、覚悟したんだから！",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "강인한 정신력이 있다면 이런 허기 따위!",
      "UnitTalk_JPN": "強い精神力があれば、こんな空腹なんて！",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "그러니까 하던 훈련이나 계속하자!",
      "UnitTalk_JPN": "だから訓練の続きをお願い！",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아니… 전혀 괜찮지 않아…",
          "JumpAnchorStringId_JPN": "いいや…平気なわけないだろう…"
        }
      ]
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "보급이 부족한 군대는 패할 수밖에 없다.",
      "UnitTalk_JPN": "補給が整っていない軍隊は必ず敗北する。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "영양이 부족한 상태에서 훈련은 몸이 망가지는 것이 당연하다.",
      "UnitTalk_JPN": "栄養が足りないまま訓練を続けると、体を壊してしまう。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 43,
