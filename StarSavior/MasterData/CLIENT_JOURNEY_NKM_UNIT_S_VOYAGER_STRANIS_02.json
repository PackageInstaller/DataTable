      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "분명 그랬다. 그랬는데…",
      "UnitTalk_JPN": "確かにそうだった。はずだが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "헉… 헉…",
