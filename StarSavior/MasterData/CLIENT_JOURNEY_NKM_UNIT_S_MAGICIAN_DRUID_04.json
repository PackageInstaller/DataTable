      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "아하하! 맞아요.",
      "UnitTalk_JPN": "あはは！そうなんです。",
      "UnitTalk_TWN": "啊哈哈！沒錯。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_04_DRUID_26.ogg"
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…지금도 <color=#F7BE45>로로카</color>는 끝나지 않았어요.",
      "UnitTalk_JPN": "…今でも、<color=#F7BE45>ロロカ</color>は続いています。",
