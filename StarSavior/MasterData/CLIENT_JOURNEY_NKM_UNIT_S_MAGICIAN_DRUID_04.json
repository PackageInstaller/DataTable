      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "마음씨가 고운 분들이구나.",
      "UnitTalk_JPN": "優しい方たちだったのね。",
      "UnitTalk_TWN": "大家心地都很好呢。",
      "TalkTime": 0.03
    },
