      "TalkVoice": "JOURNEY_1021_JOURNEY_04_DRUID_19.ogg"
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "저는 할머니 손에서 자랐거든요.",
      "UnitTalk_JPN": "わたし、おばあちゃんに育ててもらったんです。",
      "UnitTalk_TWN": "我是在奶奶的扶養下長大的。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_04_DRUID_20.ogg"
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "그래서 할머니가 남 같지 않아요. 고향에 우리 할머니 같아요.",
      "UnitTalk_JPN": "だから、おばあさんのことも見過ごせません。故郷のおばあちゃんを思い出しちゃって。",
      "UnitTalk_TWN": "所以奶奶對我來說不是外人，就像家鄉的奶奶。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_04_DRUID_21.ogg"
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "할머니 말고 마을 사람들도 저를 보살펴 주셨어요.",
      "UnitTalk_JPN": "おばあちゃん以外の村の人たちも、わたしの面倒を見てくれました。",
      "UnitTalk_TWN": "除了奶奶，村裡的人也會照顧我。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_04_DRUID_22.ogg"
    },
    {
