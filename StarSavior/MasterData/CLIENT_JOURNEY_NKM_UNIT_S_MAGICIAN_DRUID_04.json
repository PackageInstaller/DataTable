      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "사실 제가 <color=#F7BE45>여정 단원</color>이거든요?",
      "UnitTalk_JPN": "実はわたし、<color=#F7BE45>旅の団員</color>なのですが…",
