      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "실제로 카넬리아 님은 단 한 번도 진심으로 화를 내신 적이 없습니다.",
