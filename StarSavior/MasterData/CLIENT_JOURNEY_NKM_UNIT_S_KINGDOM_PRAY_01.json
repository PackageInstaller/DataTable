      "RewardAnchor": "REWARD_ANCHOR_1",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_NOA_DOWNTOWN.png",
      "StartBgmFileName": "MUSIC_MONASTIR.mp3",
      "CameraOffset": "TWIN_1"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "광장에서 자기 키보다 더 큰 스태프를 들고 서 있는 소녀를 발견했다. ",
      "UnitTalk_JPN": "広場で、自分より大きなスタッフを持った少女を発見した。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그녀가 사뭇 진지한 표정으로 다가와서 말을 걸어온다. ",
      "UnitTalk_JPN": "彼女は真剣な表情で近づいて来ると、私に声をかけた。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitPos": "POS6",
      "UnitTalk_KOR": "그대가 제 <color=#F7BE45>[여정]</color>을 담당할 여정 단장인가요?",
      "UnitTalk_JPN": "あなたが<color=#F7BE45>「救援の旅」</color>を担当する団長でしょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그런데?",
          "JumpAnchorStringId_JPN": "そうだよ。"
        }
      ]
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "제대로 찾아왔군요.",
      "UnitTalk_JPN": "よくいらっしゃいました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "소개하죠.",
      "UnitTalk_JPN": "自己紹介をしましょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "ONE_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "저로 말할 것 같으면 대 모나스티르 공국의 정통성 있는…",
      "UnitTalk_JPN": "このわたくしこそ、大・モナスティル公国の由緒正しき…",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "정통성?",
          "JumpAnchorStringId_JPN": "由緒正しき？"
        }
      ]
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_1",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "기사단 보급관 프레이라고 해요.",
      "UnitTalk_JPN": "騎士団所属の補給官、フレイです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…보통 보급관에 정통성이랄 게 있나?",
          "JumpAnchorStringId_JPN": "…補給官にも血筋とかあるの？"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "StartFxSoundName": "SFX_CUTSCENE_EMOTION_UPSET.wav",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "아무튼! 제가 그렇다면 그런 겁니다!",
      "UnitTalk_JPN": "とにかく！私がそういえば、そうなのです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "함부로 제 말에 토 달지 마시죠.",
      "UnitTalk_JPN": "わたくしの言うことに、口を挟まないでくださいっ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "자, 시시한 이야기는 이쯤하고, 더 중요한 용건이 있습니다.",
      "UnitTalk_JPN": "さぁ、つまらない話はこれぐらいにして…大事な要件があるんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "혹시나 해서 말인데…",
      "UnitTalk_JPN": "あのですね…",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "ONE_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "당신, 돈 좀 벌어볼 생각 없습니까?",
      "UnitTalk_JPN": "いい儲け話があるのですが、興味ありませんか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "돈? 딱히 필요하진 않은데…",
          "JumpAnchorStringId_JPN": "お金？特に困ってないけど…"
        }
      ]
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "참으로 한심한 소리를 하시는군요! ",
      "UnitTalk_JPN": "情けないことをおっしゃるのですね！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "자고로 돈이란 다다익선! 많을수록 좋은 것.",
      "UnitTalk_JPN": "やはり、お金は多いに越したことはありません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "POS6_2X",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "인류 최고의 발명품인 돈을 싫어하는 사람은 세상에 없습니다!",
      "UnitTalk_JPN": "人類最高の発明品であるお金を嫌う人など、この世にはいないのです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgFlashBang": 0.4,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "StartFxSoundName": "SFX_CUTSCENE_EMOTION_UPSET.wav",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "돈이 없었다면 당신도 아직 조개껍데기로 물물교환이나 하고 있었겠죠.",
      "UnitTalk_JPN": "お金がなければ、あなたは今も貝殻で物々交換をしていたことでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "알았으니까 진정해.",
          "JumpAnchorStringId_JPN": "分かったから、落ち着いて。"
        }
      ]
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_1",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…후우, 조금 흥분했던 것 같군요. ",
      "UnitTalk_JPN": "…ふぅ。ちょっと興奮してしまったようです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "한 가지만 더 물어보죠. ",
      "UnitTalk_JPN": "もう一つお聞きしましょう。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "혹시 재테크는 어떻게 하고 계십니까?",
      "UnitTalk_JPN": "資産運用は、どのようにされていますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "설마 급료로 받은 돈을 은행에 쌓아 두기만 하는 건 아니겠죠?",
      "UnitTalk_JPN": "まさか給料として受け取ったお金を、銀行に預けたままということはないでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "맞는데…",
          "JumpAnchorStringId_JPN": "その通りだけど…"
        }
      ]
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "하아!",
      "UnitTalk_JPN": "ふっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "안타깝기 짝이 없군요.",
      "UnitTalk_JPN": "残念極まりないですわね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "멀쩡한 자금을 굴리지 않고 묵혀 두는 건 범죄나 다름없는 일입니다.",
      "UnitTalk_JPN": "使える資金を運用せず眠らせておくのは、犯罪のようなものです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "하지만 걱정 마시죠.",
      "UnitTalk_JPN": "ですが、ご心配なく。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "공국 최고, 아니 라비스타 최고의 경제 전문가인 제가 여기에 왔으니까요.",
      "UnitTalk_JPN": "公国最高…いえ、ラビスター最高の経済専門家であるわたくしがいるのですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "자, 제가 당신께 딱 맞는 최고의 투자처를 만들어 왔습니다.",
      "UnitTalk_JPN": "さぁ、あなたにピッタリな最高の投資先を準備しておきましたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "최고의 투자처?",
          "JumpAnchorStringId_JPN": "最高の投資先？"
        }
      ]
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "혹시 <color=#F7BE45>증권</color>이란 걸 들어 보셨습니까?",
      "UnitTalk_JPN": "<color=#F7BE45>証券</color>というものをご存じですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "증권?",
          "JumpAnchorStringId_JPN": "証券？"
        }
      ]
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "흠. 쉽게 말하면 <color=#F7BE45>권리</color>를 증명하는 증명서라고 할 수 있죠. ",
      "UnitTalk_JPN": "ふむ。簡単に言えば、<color=#F7BE45>権利</color>を証明する証明書のことです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "이번 사업의 요지는 구원자들의 <color=#F7BE45>미래</color>를 <color=#F7BE45>증권</color>으로 발행해 파는 겁니다.",
      "UnitTalk_JPN": "今回のビジネスの趣旨は、救援者たちの<color=#F7BE45>未来</color>を<color=#F7BE45>証券</color>として発行し、売ることです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "촉망받는 유망주들의 이름을 딴 <color=#F7BE45>증권</color>을 만들면 사람들이 그들의 <color=#F7BE45>미래</color>에 베팅하는 거죠!",
      "UnitTalk_JPN": "期待の新星たちの名前がついた<color=#F7BE45>証券</color>を作れば、皆が救援者の<color=#F7BE45>未来</color>にベッティングするはずですっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_01",
      "WaitClick": true,
      "WaitTime": 0.0,
