      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "원하시면 제가 직접 먹여드릴 수도 있답니다. 후후.",
      "UnitTalk_JPN": "お望みであれば、私が飲ませてあげますよ。ふふっ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "사양할게…",
          "JumpAnchorStringId_JPN": "遠慮しとくよ…"
