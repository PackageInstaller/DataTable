      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "여정 단장으로서 여정 단원이 숨기고 있는 게 무엇인지 조사하는 건 당연한 일이라고.",
          "JumpAnchorStringId_JPN": "旅の団長として、団員が何を隠してるのか調査するのは当然のことだし。"
        }
      ]
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "후후. 당황하시긴. 정곡을 찔리셨나봐요? ",
      "UnitTalk_JPN": "ふふっ。慌てるなんて、図星なのでしょう？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그런데, 숨기다니요?",
      "UnitTalk_JPN": "でも、隠し事だなんて。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이렇게 밤에 몰래 훈련하러 나온 것 말이야.",
          "JumpAnchorStringId_JPN": "夜遅くにこっそり訓練してることだ。"
        }
      ]
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "EmotionEffect": "THINK2"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "후후. 오해랍니다. ",
      "UnitTalk_JPN": "ふふっ。誤解ですよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "저는 그저 잠이 오지 않아서 가볍게 몸을 움직이러 왔을 뿐이거든요. ",
      "UnitTalk_JPN": "私はただ眠れなくて、軽く体を動かしに来ただけなのですから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…오늘 낮에 했던 훈련도 충분히 힘든 훈련이었어.",
          "JumpAnchorStringId_JPN": "…昼のトレーニングも、十分きついメニューだったのに。"
        }
      ]
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "몸을 너무 혹사시키는 건 아무것도 하지 않는 것만 못할 때가 많아.",
          "JumpAnchorStringId_JPN": "体を酷使しすぎるよりも、休んだ方が良いこともあるんだぞ。"
        }
      ]
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "걱정해 주시는 건 감사해요. ",
      "UnitTalk_JPN": "心配してくださって、ありがとうございます。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "하지만 전 정말 괜찮은걸요. ",
      "UnitTalk_JPN": "でも、私は本当に大丈夫なんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "기사단의 <color=#F7BE45>극기 주간 훈련</color>에는 사흘 밤낮을 자지 않고 행군하는 훈련도 있답니다. ",
      "UnitTalk_JPN": "騎士団の<color=#F7BE45>猛特訓週間</color>では、三日三晩寝ずに歩き続けることもあるのですよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그건 매일 하는 게 아니잖아…",
          "JumpAnchorStringId_JPN": "でも、それは毎日するものじゃないし…"
        }
      ]
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "게다가 아무리 짙게 쌓인 피로도 이 전투 광기 수프… ",
      "UnitTalk_JPN": "それに…どんなに疲れていても、この戦闘狂スープ… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "아, 아니 <color=#F7BE45>피로 회복 수프</color> 한 잔이면 말끔히 사라진답니다. ",
      "UnitTalk_JPN": "じ、じゃなくて、<color=#F7BE45>疲労回復スープ</color>を一杯飲めば、疲れも消え去るんです。 ",
      "TalkTime": 0.03
    },
    {
