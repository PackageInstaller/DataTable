    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "네. 모나스티르 공국 기사단 전통의 비방으로 만든 약재 수프죠.",
      "UnitTalk_JPN": "はい。モナスティル公国の騎士団に代々伝わる、秘伝の薬膳スープです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_BATTLE_COMMON_CHIME_02.wav",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "사흘 동안 전력 행군을 해서 쓰러진 병사도 이거 한 입이면 단숨에 전투태세로 만들 수 있답니다.",
      "UnitTalk_JPN": "三日間、全力で行軍して倒れた兵士も…一口飲めば、一瞬にして戦闘態勢を取ることもできるんですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "설명을 들으니까 처음 들은 이름이 더 어울리는 것 같아.",
          "JumpAnchorStringId_JPN": "やっぱり、最初に聞いたスープ名の方が合ってそうだけど。"
        }
      ]
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아뇨. <color=#F7BE45>피로 회복 수프</color>예요.",
      "UnitTalk_JPN": "いえ。<color=#F7BE45>疲労回復スープ</color>です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "한번 드셔보시겠어요? ",
      "UnitTalk_JPN": "一度飲まれてみますか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "부담가지실 필요 없어요. 저희 기사단 보급품 중에는 가장 남아도는 물건이니까요.",
      "UnitTalk_JPN": "遠慮なさらないでくださいね。騎士団の補給品の中でも、最も余っているものですから。",
      "TalkTime": 0.03
    },
