      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이게…",
          "JumpAnchorStringId_JPN": "これが…"
        }
      ]
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitTalk_KOR": "그래. 이게 바로 <color=#F7BE45>벨라</color> 꽃잎이다. ",
      "UnitTalk_JPN": "そう、これこそ、<color=#F7BE45>ベラ</color>の花びらだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "전설에서 전해지는 <color=#F7BE45>벨라</color>의 특징과 완벽히 일치!",
      "UnitTalk_JPN": "伝説で語られる<color=#F7BE45>ベラ</color>の特徴と完璧に一致！",
      "TalkTime": 0.03
    },
