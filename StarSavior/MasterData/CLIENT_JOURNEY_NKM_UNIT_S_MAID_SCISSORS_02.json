      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "게다가 한 귀퉁이에는 큼직한 상처까지 나 있다. ",
      "UnitTalk_JPN": "しかも隅の一部には大きな傷があった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
