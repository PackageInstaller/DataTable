      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "산 거야?",
          "JumpAnchorStringId_JPN": "買ったの？"
        }
      ]
    },
    {
