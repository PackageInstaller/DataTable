      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "안에 들어있는 건 손바닥만한 꽃잎 한 장.",
      "UnitTalk_JPN": "中に入っているのは手のひらほどの花びら一枚",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
