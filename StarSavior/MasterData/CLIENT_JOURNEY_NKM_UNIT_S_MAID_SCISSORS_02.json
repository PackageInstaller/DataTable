      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그래. <color=#F7BE45>벨라</color>다. ",
      "UnitTalk_JPN": "そう、<color=#F7BE45>ベラ</color>だ。",
      "TalkTime": 0.03
    },
    {
