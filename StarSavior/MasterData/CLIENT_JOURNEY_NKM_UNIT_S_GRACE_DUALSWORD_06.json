    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "대련에서 패배는 성장으로 이어진다.",
      "UnitTalk_JPN": "手合わせでの敗北は、成長につながる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "상대는 내 기술의 약점을 간파하고, 파훼법을 내놓는다.",
      "UnitTalk_JPN": "相手はこちらの技の弱点を見抜き、打ち破ろうとしてくる。",
