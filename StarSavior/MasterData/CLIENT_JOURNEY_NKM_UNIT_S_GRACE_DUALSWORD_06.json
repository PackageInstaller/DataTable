    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그럼 나는 기술을 발전시켜 그 파훼법을 깨뜨린다.",
      "UnitTalk_JPN": "そしてこちらは技を磨き、その打ち破る方法を打破するのだ。",
