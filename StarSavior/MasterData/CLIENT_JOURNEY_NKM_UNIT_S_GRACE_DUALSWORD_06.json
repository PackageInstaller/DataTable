      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "상대가 대처할 줄 모른다고 확신했을 때만 발톱을 드러냈다.",
