    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "에핀델은 <color=#F7BE45>대련</color>은 많이 해보지 않았다. 오로지 <color=#F7BE45>전투</color>만 했을 뿐.",
