    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "무술은 그렇게 발전한다.",
      "UnitTalk_JPN": "武術はこうして成長していく。",
      "TalkTime": 0.03
    },
    {
