      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "<color=#F7BE45>다음 기회에</color> 같은 건 없다.",
