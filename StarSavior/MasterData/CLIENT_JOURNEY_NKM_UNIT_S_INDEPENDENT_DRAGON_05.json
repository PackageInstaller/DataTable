    {
      "Uid": 4,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_MOVEMENT_FOOT_STEP_02.wav",
      "UnitTalk_KOR": "데이트 당일, 레이시와 함께 거리를 걸었다.",
      "UnitTalk_JPN": "デート当日。レイシーと街を歩いた。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 78,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SERIOUS"
    },
    {
      "Uid": 5,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "오늘의 목표는 레이시에게 최대한 다양한 경험을 시키는 것이다.",
      "UnitTalk_JPN": "今日の目標は、レイシーに色んな経験をしてもらうことだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 6,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "창작을 해 본 적은 없지만, 듣기로는 이런 사소한 경험을 통해 슬럼프를 극복한 사례가 많다고 한다.",
      "UnitTalk_JPN": "創作をしたことはないけど…些細な経験が、スランプを乗り越えるきっかけになることも多いらしい。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 7,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "그러니 아해의 말은… 여의 슬럼프 극복을 위해 그러한 제안을 했다는 말이렸다?",
      "UnitTalk_JPN": "つまり童は…余のスランプ克服のために、デートを提案したということじゃな？",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "맞아.",
          "JumpAnchorStringId_JPN": "その通り。"
        }
      ]
    },
    {
      "Uid": 9,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…그렇구나.",
      "UnitTalk_JPN": "…理解したぞ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "아해의 뜻, 자~알 알았느니라.",
      "UnitTalk_JPN": "童の意図、よ～く理解したのじゃ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "글을 쓸 시간에 밖으로 불러낸 게 마음에 들지 않았던 걸까, 레이시의 표정이 어딘가 뾰로퉁해 보인다.",
      "UnitTalk_JPN": "執筆の時間に連れ出されたのが気に入らなかったのか、レイシーはどこか不機嫌そうだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "가보고 싶은 곳 있어?",
          "JumpAnchorStringId_JPN": "行きたい場所とかある？"
        }
      ]
    },
    {
      "Uid": 13,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "가보고 싶은 곳?",
      "UnitTalk_JPN": "行きたい場所？",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitTalk_KOR": "흐음… 있노라. ",
      "UnitTalk_JPN": "ふうむ…あるのじゃ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 82,
      "WaitClick": true,
      "WaitTime": 0.9,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "딱 한 곳.",
      "UnitTalk_JPN": "一つだけのう。",
      "TalkTime": 0.03,
      "TalkAppend": true
    },
    {
      "Uid": 72,
