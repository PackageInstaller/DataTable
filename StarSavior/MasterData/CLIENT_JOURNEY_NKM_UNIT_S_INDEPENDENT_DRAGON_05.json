    },
    {
      "Uid": 73,
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_LIBRARY.png",
      "CutsceneClear": "CLEARALL"
    },
    {
      "Uid": 75,
      "WaitClick": false,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_16.mp3",
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "NORMAL_LOOP",
