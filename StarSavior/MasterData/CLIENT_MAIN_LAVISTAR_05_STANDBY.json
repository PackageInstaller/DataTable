    {
      "Uid": 29,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_ASTRO_SANCTUM.mp3",
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "후후, 여러 가지 일을 겪은 탓에 혼란스러우신 것 같군요.",
      "UnitTalk_JPN": "ふふっ。アクシデントが重なって、記憶が混乱しているようですね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_017.wav"
    },
    {
      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "하지만 전 거짓말은 하지 않아요.",
      "UnitTalk_JPN": "しかし、私は嘘をつきません。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_018.wav"
    },
    {
      "Uid": 31,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "당신은 분명, 저와 계약했습니다. 온전한 당신의 의지로 말이죠.",
      "UnitTalk_JPN": "あなたは確かに、私と契約しました。それもあなた自身の意志で。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_019.wav"
    },
    {
      "Uid": 32,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…",
          "JumpAnchorStringId_JPN": "…"
        }
      ]
    },
    {
      "Uid": 33,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "조금 여유를 가지시는 게 도움이 될 거예요.",
      "UnitTalk_JPN": "少し肩の力を抜くことも大切ですよ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_020.wav"
    },
    {
      "Uid": 34,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "그렇게 이곳에서 시간을 보내시다 보면…",
      "UnitTalk_JPN": "そうして、ここで過ごしているうちに…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_021.wav"
    },
    {
      "Uid": 35,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "…여러 가지 기억이 떠오를지도 모르니까요.",
      "UnitTalk_JPN": "…様々な記憶を思い出すかもしれませんから。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_022.wav"
    },
    {
      "Uid": 36,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "계시는 동안의 편의는 최대한 지원해 드리겠습니다.",
      "UnitTalk_JPN": "NOAに滞在される間、快適に過ごせるようにサポートいたします。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_023.wav"
    },
    {
      "Uid": 37,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "그러니 그동안은, <color=#F7BE45>[단장님의 일]</color>을 해 주시면 고맙겠군요.",
      "UnitTalk_JPN": "そのかわりと言ってはなんですが、<color=#F7BE45>「団長の仕事」</color>をしていただければと思います。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_024.wav"
    },
    {
      "Uid": 38,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "내 일…?",
          "JumpAnchorStringId_JPN": "仕事…？"
        }
      ]
    },
    {
      "Uid": 39,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "네, 아까 말씀드렸죠.",
      "UnitTalk_JPN": "はい、先ほどお伝えした通りです。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_025.wav"
    },
    {
      "Uid": 40,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "당신은 이제부터 NOA의 <color=#F7BE45>[여정 단장]</color>입니다.",
      "UnitTalk_JPN": "あなたはこれから、NOAの<color=#F7BE45>「旅の団長」</color>となります。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_026.wav"
    },
    {
      "Uid": 41,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "그리고 재능 있는 구원자들을 찾아 <color=#F7BE45>[여정]</color>을 마칠 수 있게 도와야 하죠.",
