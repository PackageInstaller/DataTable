    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_ASTRO_SANCTUM.mp3",
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "아, 드디어 도착했군요.",
      "UnitTalk_JPN": "あぁ、ようやくお会いすることができました。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_001.wav"
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "이미 보고는 들었답니다.",
      "UnitTalk_JPN": "報告は受けています。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_002.wav"
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "이곳에 오자마자 여러 가지 문제에 휘말리셨다고요.",
      "UnitTalk_JPN": "NOAに到着してすぐ、様々なトラブルに巻き込まれてしまったと…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_003.wav"
    },
    {
      "Uid": 13,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "후후… 어쩐지 제가 아는 어떤 <color=#F7BE45>[지인]</color>을 떠올리게 하는군요.",
      "UnitTalk_JPN": "ふふっ…何だか、私の<color=#F7BE45>「知人」</color>を思い出しますね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_004.wav"
    },
    {
      "Uid": 14,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "그 사람도 당신처럼 사건과 사고를 몰고 다니곤 했었죠.",
      "UnitTalk_JPN": "その人も多くの事件や事故に巻き込まれていましたから。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_005.wav"
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "하지만 이번 일만큼은 당신의 탓이 아니군요.",
      "UnitTalk_JPN": "もちろん、今回の件はあなたのせいではありません。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_006.wav"
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "손님을 초대하고도 제대로 준비하지 못한 점, 정중히 사과드리겠습니다.",
      "UnitTalk_JPN": "こちらがお招きしたにもかかわらず、しっかりと準備ができていなかったこと…深くお詫び申し上げます。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_007.wav"
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "당신이…?",
          "JumpAnchorStringId_JPN": "あなたが、私を探していた…？"
        }
      ]
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "이런, 아직 제 소개도 하지 않았네요.",
      "UnitTalk_JPN": "あら、自己紹介がまだでしたね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_008.wav"
    },
    {
      "Uid": 19,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "제 이름은 <color=#F7BE45>[알리시아 레메게톤]</color>.",
      "UnitTalk_JPN": "私は<color=#F7BE45>「アリシア・レメゲトン」</color>。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_009.wav"
    },
    {
      "Uid": 20,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "이곳 <color=#F7BE45>[성운 관측 기관]</color>의 설립자이자 <color=#F7BE45>[제1관측사]</color>로서 별들의 궤적을 읽는…",
      "UnitTalk_JPN": "ここ<color=#F7BE45>「星雲観測機関」</color>の設立者であり、<color=#F7BE45>「第一観測士」</color>として星々の軌跡を観測する…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_010.wav"
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "한낱 하찮은 마녀랍니다.",
      "UnitTalk_JPN": "ただのしがない魔女です。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_011.wav"
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "성운 관측 기관에 오신 걸 환영합니다.",
      "UnitTalk_JPN": "星雲観測機関へようこそ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_012.wav"
    },
    {
      "Uid": 23,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "<color=#F7BE45>[단장님]</color>.",
      "UnitTalk_JPN": "<color=#F7BE45>「団長」</color>。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_013.wav"
    },
    {
      "Uid": 24,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…왜 나를 단장이라고 부르지?",
          "JumpAnchorStringId_JPN": "…どうして私を団長と呼ぶんだ？"
        }
      ]
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "기억나지 않으시나요?",
      "UnitTalk_JPN": "覚えていませんか？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_014.wav"
    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "당신은 저와 계약을 맺었답니다.",
      "UnitTalk_JPN": "あなたは、私と契約を結びました。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_015.wav"
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_ALICIA",
      "UnitTalk_KOR": "이곳 NOA의 <color=#F7BE45>[여정]</color>을 이끄는 단장이 되어 별의 구원자의 힘을 계승하겠다고요.",
      "UnitTalk_JPN": "あなたが<color=#F7BE45>「救援の旅」</color>を導く団長となり、星の救援者の力を継承するという契約内容です。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_LAVISTAR_05_NPC_NOA_ALICIA_016.wav"
    },
    {
      "Uid": 28,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그런 기억은 없어…",
          "JumpAnchorStringId_JPN": "そんな契約をした覚えはないが…"
        }
      ]
    },
