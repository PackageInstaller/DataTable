    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "물건을 사러 시내를 돌아다니던 중이었다.",
      "UnitTalk_JPN": "買い物をしようと、街を歩いていた時のことだった。",
      "UnitTalk_TWN": "我正在市區裡逛街購物。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": false,
      "WaitTime": -1.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitPos": "POS8",
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitPos": "POS7",
      "UnitTalk_KOR": "…진짜인가요? 여기 투자하면 부자가 될 수 있나요?",
      "UnitTalk_JPN": "…本当ですか？投資をするだけで、お金持ちになれるんですか？",
      "UnitTalk_TWN": "…這是真的嗎？在這裡投資真的能變成富翁嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_1.ogg"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "물론입니다! 모나스티르 공국의 정통성 있는…",
      "UnitTalk_JPN": "もちろんですっ！モナスティル公国の由緒正しき…",
      "UnitTalk_TWN": "當然！我們可是莫納斯提爾公國的正統…",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "크흠! 기사단의 보급관으로서 진실만을 얘기하죠.",
      "UnitTalk_JPN": "こほん！騎士団の補給官として、真実のみをお話しましょう。",
      "UnitTalk_TWN": "咳咳！身為騎士團的補給官，我只說實話。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "평소에 재테크에 관심이 많으십니까?",
      "UnitTalk_JPN": "資産運用に興味はおありですか？",
      "UnitTalk_TWN": "您平常對理財有興趣嗎？",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "재테크…?",
      "UnitTalk_JPN": "資産運用…？",
      "UnitTalk_TWN": "理財…？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_2.ogg"
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 죄송해요.",
      "UnitTalk_JPN": "あはは！すみません。",
      "UnitTalk_TWN": "啊哈哈！抱歉。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_3.ogg"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "제가 최근에 도시로 올라왔거든요. 도시 사람들이 쓰는 말은 잘 몰라요.",
      "UnitTalk_JPN": "わたし、都会に来たばかりなんです。都会の人たちが使う言葉は、よく分からなくて。",
      "UnitTalk_TWN": "我最近才搬到城市來，還不太懂城市人使用的詞彙。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_4.ogg"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "재테크라는 게 뭔가요?",
      "UnitTalk_JPN": "資産運用とは、何でしょうか？",
      "UnitTalk_TWN": "理財是什麼意思？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_5.ogg"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "도시?",
      "UnitTalk_JPN": "都会？",
      "UnitTalk_TWN": "城市？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "흐음… 외진 곳에서 상경했나보군요.",
      "UnitTalk_JPN": "ふむ…辺境の地から来られたのですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "뭐, 좋습니다! 재테크란 자산 운용 기법을 뜻합니다.",
      "UnitTalk_JPN": "まぁ、良いでしょう！資産運用とは、手持ちの資産を効率的に増やしていく方法のことです。",
      "UnitTalk_TWN": "沒關係！理財就是運用資產的方法。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "지금 당신에게 빵이 하나 있다면 2개. 아니, 10개까지도 늘릴 수 있죠!",
      "UnitTalk_JPN": "今あなたがパンを1つ持っているとすれば、それを2つ、いえ、10つにも増やせるという訳なのです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "와! 대단해요!",
      "UnitTalk_JPN": "わぁ！すごいです！",
      "UnitTalk_TWN": "哇！好厲害！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_6.ogg"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "그만큼 빵이 많으면 마을 사람들에게 하나씩 나눠줘도 남겠어요!",
      "UnitTalk_JPN": "それほどのパンがあれば、村の人たちにも分けてあげられますね！",
      "UnitTalk_TWN": "有這麼多麵包，就算分給村民們每人一個也還會剩呢！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_7.ogg"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "후후, 그렇습니다. 재테크는 굉장하죠.",
      "UnitTalk_JPN": "ふふ、そうなのです。資産運用はすごいのです。",
      "UnitTalk_TWN": "呵呵，沒錯，理財很了不起。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "하지만 아까 말씀드린 <color=#F7BE45>피라미드 판매법</color>은 더욱 굉장합니다!",
      "UnitTalk_JPN": "しかし、先ほど申し上げた<color=#F7BE45>ピラミッド商法</color>は、もっとすごいんです！",
      "UnitTalk_TWN": "但我剛才提到的<color=#F7BE45>金字塔銷售法</color>就更驚人了！",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "자그마치 빵을 1000개까지도 늘릴 수 있죠!",
      "UnitTalk_JPN": "なんと、パンを1,000個まで増やすことができるのですっ！",
      "UnitTalk_TWN": "最多能讓麵包增加到1000個喔！",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "1000개?! 정말인가요?",
      "UnitTalk_JPN": "1,000個！？本当ですか？",
      "UnitTalk_TWN": "1000個？！真的嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_8.ogg"
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "역시 도시 사람들은 굉장하군요! 제가 모르는 걸 잔뜩 알고 계세요.",
      "UnitTalk_JPN": "やっぱり、都会の人たちはすごいです！わたしが知らないことも、よく知っていらっしゃいます。",
      "UnitTalk_TWN": "城市人果然很厲害！你們知道好多我不懂的事情。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_9.ogg"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후. 어떻습니까? 관심이 생겼습니까?",
      "UnitTalk_JPN": "ふふ、いかがです？興味が湧いてきましたか？",
      "UnitTalk_TWN": "呵呵，怎麼樣？有興趣了嗎？",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "필요하다면 지금부터 간이 설명회를 시작하죠.",
      "UnitTalk_JPN": "必要でしたら、これから簡単な説明会を開きますわよ。",
      "UnitTalk_TWN": "如果你需要的話，我們可以立刻開始簡易說明會。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SURPRISE",
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "투자할게요!",
      "UnitTalk_JPN": "投資しますっ！",
      "UnitTalk_TWN": "我要投資！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_10.ogg"
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "…적어도 설명은 들어볼 줄 알았습니다만?",
      "UnitTalk_JPN": "…少なくとも、説明を聞いてから投資されると思いましたが。",
      "UnitTalk_TWN": "…我以為你至少會先聽解說。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_TOUCH",
      "UnitTalk_KOR": "아하하! 저는 도시는 잘 몰라도 사람 보는 눈은 있다고 믿거든요.",
      "UnitTalk_JPN": "あはは！都会のことはよく分かりませんが…わたし、人を見る目はあると思うんです。",
      "UnitTalk_TWN": "啊哈哈！雖然我對城市不太了解，但我相信自己看人的眼光不錯。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_11.ogg"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "제 앞에 있는 분은 착한 사람이 틀림없어요.",
      "UnitTalk_JPN": "目の前にいらっしゃるあなたは、優しい人に違いありません。",
      "UnitTalk_TWN": "我面前的這位一定是個好人。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_12.ogg"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그렇지 않았다면 재테크란 걸 제안해주시지도 않았겠죠!",
      "UnitTalk_JPN": "そうでなければ、資産運用というものを提案してくださらなかったはずですから！",
      "UnitTalk_TWN": "如果不是的話，你也不會向我建議理財的事情了！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_01_DRUID_13.ogg"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
