      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…이겼어요! 해치웠어요…!",
      "UnitTalk_JPN": "…勝ちました！やりましたよ…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "열심히 훈련을 한 보람이 있네요. ",
      "UnitTalk_JPN": "一生懸命、訓練してきたかいがありましたね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_DETECTIVE_WATSON_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "옛날 같았으면 제대로 싸워보지도 못하고 지쳐버렸을 텐데…! ",
      "UnitTalk_JPN": "以前のわたしだったら…ちゃんと戦えずに、へたり込んでいたはずです…！ ",
      "TalkTime": 0.03
    },
