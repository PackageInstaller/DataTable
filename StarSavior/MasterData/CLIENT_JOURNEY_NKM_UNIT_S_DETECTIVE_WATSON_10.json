      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "토끼 씨… 뭘 그렇게 호들갑이냐니. ",
      "UnitTalk_JPN": "ウサギさん…騒ぎすぎだなんて。 ",
      "TalkTime": 0.03
    },
    {
