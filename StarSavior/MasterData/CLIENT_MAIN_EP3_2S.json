      "UnitTalk_KOR": "아무튼 너!",
      "UnitTalk_JPN": "とにかく、あんた！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_2_UNIT_S_SAINTESS_DEMON_012.wav"
    },
    {
      "Uid": 42,
      "WaitClick": true,
