      "BgFlashBang": 0.3,
      "BgCrash": 0.5,
      "BgCrashTime": 1.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "CameraOffset": "TWIN_3",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "바, 방금 들으셨어요? 뮤리엘 님?!",
      "UnitTalk_JPN": "き、聞きましたか？ミュリエル様！？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_2_UNIT_S_SAINTESS_ELF_019.wav"
    },
    {
      "Uid": 48,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_ELF",
      "UnitTalk_KOR": "귀, 귀귀, 귀귀귀엽다고 하셨어요…!",
