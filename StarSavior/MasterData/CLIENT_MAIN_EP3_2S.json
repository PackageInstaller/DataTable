    },
    {
      "Uid": 43,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitTalk_KOR": "그래! 방금 그 손바닥…. 키… 크흠!!",
      "UnitTalk_JPN": "そうよ！さっきの…えっと…その…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP3_2_UNIT_S_SAINTESS_DEMON_013.wav"
    },
    {
      "Uid": 44,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "엘리사의 <color=#F7BE45>[어필]</color>에 대해 해야 할 말이 있을 텐데?",
      "UnitTalk_JPN": "エリサの<color=#F7BE45>「アピール」</color>について、何か言うことがあるんじゃないの！？",
