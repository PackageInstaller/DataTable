      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "딱 단장님이 쓰고 계신 그런 후드던데...",
      "UnitTalk_JPN": "団長が被ってるのも、そういうフードですよね…",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그렇구나...?",
          "JumpAnchorStringId_JPN": "ほう…？"
        }
      ]
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "신고당한 걸 알자마자 급하게 사라졌다고 하더라고요.",
      "UnitTalk_JPN": "通報されたと分かった途端、慌ててその場から離れたんですって。",
