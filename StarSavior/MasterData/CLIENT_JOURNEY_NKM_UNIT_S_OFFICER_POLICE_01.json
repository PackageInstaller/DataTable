      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "기다리는 내내 주변의 시선이 따가웠다.",
