      "BgFadeInTime": 0.7
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_FOOL_01",
      "WaitClick": false,
      "WaitTime": 1.5,
      "BgFadeOutCol": [
        "1",
        "1",
        "1",
        "0"
      ],
      "BgFadeOutTime": 1.5
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_FOOL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "여정일지에 보관한 아르카나에 빛이 스며든다.",
      "UnitTalk_JPN": "旅の日誌に保管したアルカナに光が吸い込まれる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_FOOL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "나와 <color=#F7BE45>[CHARACTER_NAME]</color>의 인연에 별의 축복이 깃들었다.",
      "UnitTalk_JPN": "私と<color=#F7BE45>[CHARACTER_NAME]</color>の絆に、星の祝福が宿った。",
      "TalkTime": 0.03
    }
  ]
