      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_APOCALYPSE_FEMALE_1",
      "UnitNameString": [
        "SI_KALAID_PIONEER"
      ],
      "UnitTalk_KOR": "축제를 위해 준비 중이던 시설을 마수들이 몽땅 망가뜨렸거든요.",
      "UnitTalk_JPN": "祭りのために準備していた施設を魔獣たちが全部壊しちゃったんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_31B_KLD_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_APOCALYPSE_FEMALE_1",
      "UnitNameString": [
        "SI_KALAID_PIONEER"
      ],
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "산속 깊숙한 곳에서만 살던 녀석들이 왜 여기까지 몰려온 건지…",
      "UnitTalk_JPN": "山奥深くでしか暮らしていなかった奴らが、なぜここまで押し寄せたのか…",
