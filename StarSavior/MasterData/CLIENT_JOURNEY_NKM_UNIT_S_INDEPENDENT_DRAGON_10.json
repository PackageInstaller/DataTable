      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그럼 이제 다시 작가 레이시로 돌아갈 시간이니라.",
      "UnitTalk_JPN": "ならば、そろそろ作家レイシーに戻る時じゃな。",
      "TalkTime": 0.03
