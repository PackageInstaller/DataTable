      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그녀는 분명 나를 뛰어넘을…",
