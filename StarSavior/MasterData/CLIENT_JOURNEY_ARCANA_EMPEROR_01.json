    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": false,
      "WaitTime": 1.5,
      "BgFadeOutCol": [
        "1",
