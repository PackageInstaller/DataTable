    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "DRAMA_ACTIVATE_ARCANA_2.prefab",
      "StartBgmFileName": "MUSIC_CUTSCENE_06.mp3"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": false,
      "WaitTime": 2.5
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그 남자가 원하는 건 없었다. 아무것도.",
      "UnitTalk_JPN": "あの男が望んだものは何もなかった。何も。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "다만 알고 싶었을 뿐이다. 세상에 대한 모든 걸.",
      "UnitTalk_JPN": "ただ知りたかっただけだ。世界について、すべてを。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그는 궁금했다. 왜 하늘이 파란지, 왜 바닷물이 짠지.",
      "UnitTalk_JPN": "彼は疑問に思った。なぜ空は青いのか、なぜ海水は塩辛いのか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "왜 물이 위에서 아래로 흐르는지, 왜 번개는 높은 곳에 치는지.",
      "UnitTalk_JPN": "なぜ水は上から下へ流れるのか、なぜ雷は高いところに落ちるのか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "한 약소국의 왕위계승자들 중 막내였던 그는 어릴 때부터 골방에서 연구했다.",
      "UnitTalk_JPN": "ある弱小国の王位継承者たちの中で末っ子だった彼は、幼い頃から書斎で研究に没頭した。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "다른 계승자와 가신, 친부인 부왕을 비롯한 모든 이가 그를 괴짜라고 손가락질했다.",
      "UnitTalk_JPN": "他の継承者や家臣、実の父である父王を含む誰もが彼を変人だと指さした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그의 유일한 이해자는 정략결혼으로 고향을 떠나온 어머니뿐이었다.",
      "UnitTalk_JPN": "彼を理解したのは、政略結婚で故郷を離れた母だけだった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "훗날 골방에서 나온 그가 만들어낸 병기들은 전쟁의 판도를 뒤집었다.",
      "UnitTalk_JPN": "後に書斎から出てきた彼が作り出した兵器は、戦争の様相を一変させた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "손가락 하나로 대륙의 절반을 불바다로 만들었다.",
      "UnitTalk_JPN": "指一本で大陸の半分を火の海に変えた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그가 평범한 사람이었다면 절망했겠지. 자신이 만들어 낸 생지옥에 윤리를 시험 당했을 것이다.",
      "UnitTalk_JPN": "もし彼が普通の人間だったら、きっと絶望しただろう。自ら生み出した地獄で倫理を試されたはずだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 그는 평범하지 않았다.",
      "UnitTalk_JPN": "しかし彼は平凡ではなかった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "알고 싶은 것들을 알기 위해 연구에만 신경 쓸 뿐. 부산물에는 눈길조차 주지 않았다.",
      "UnitTalk_JPN": "知りたいことを知るために研究だけに神経を使うだけ。副産物には目すら向けなかった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "연구에 방해되는 것들은 모조리 제거했다.",
      "UnitTalk_JPN": "研究の妨げとなるものは全て排除した。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "가치관, 감정, 윤리, 그리고 형제와 남매, 부왕. 마지막으로는 자신의 어머니마저.",
      "UnitTalk_JPN": "価値観、感情、倫理、そして兄弟姉妹、父王。最後には自らの母さえも。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "끝내 대륙을 통일하고 황제가 된 그는 많은 것을 알게 됐지만, 단 한 가지.",
      "UnitTalk_JPN": "ついに大陸を統一し皇帝となった彼は多くのことを知ったが、ただ一つだけ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "모든 것을 알고 싶어했던 그는, 사람의 마음만큼은 끝끝내 알지 못했다.",
      "UnitTalk_JPN": "全てを知りたがった彼は、人の心だけは最後まで知ることができなかった。",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_EMPEROR_01",
      "WaitClick": false,
      "WaitTime": 0.7,
