        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "...이상한 게 들어있지 않을까?",
          "JumpAnchorStringId_JPN": "…変なものが入ってるんじゃない？",
          "JumpAnchorId": "REWARD_ANCHOR_2"
        }
