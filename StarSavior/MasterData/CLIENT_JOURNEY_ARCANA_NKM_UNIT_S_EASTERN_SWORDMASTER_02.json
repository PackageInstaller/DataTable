    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "캔들 스퀘어에서 의뢰를 받아 야산에서 약초를 채집하고 있었는데…",
      "UnitTalk_JPN": "キャンドル・スクエアの依頼を受け、野山で薬草を採取していた時のことだった…",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "여기가 어디지…?",
          "JumpAnchorStringId_JPN": "ここ、どこだっけ…？"
        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "길을 잃어버렸다.",
      "UnitTalk_JPN": "道に迷ってしまった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_UNKNOWN"
      ],
      "UnitTalk_KOR": "거기 누구 있나요? 목소리가 들렸는데…",
      "UnitTalk_JPN": "誰かいらっしゃいますか？声が聞こえたのですが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장님? 단장님이 왜 여기 계세요?",
      "UnitTalk_JPN": "団長？どうしてここにいらっしゃるのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "약초를 채집하다가 길을 잃으셨다고요?",
      "UnitTalk_JPN": "薬草を採っていたら道に迷ってしまったのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "단장님…",
      "UnitTalk_JPN": "団長…",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.8,
      "BgCrashTime": 0.5,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "떽이에요!",
      "UnitTalk_JPN": "めっ、ですよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "아무리 숲이 자연의 은혜로 가득한 곳이라 해도 숲은 숲!",
      "UnitTalk_JPN": "いくら豊かな自然に恵まれた場所だと言っても、森は森！",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "준비 없이 들어왔다가 길을 잃어버리면 위험해요? 정말로요!",
      "UnitTalk_JPN": "準備もせずに足を踏み入れて、迷ってしまったら危険でしょう？いけませんよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "죄송합니다…",
          "JumpAnchorStringId_JPN": "すみません…"
        }
      ]
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "…후후.",
      "UnitTalk_JPN": "…ふふ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "훈육은 여기까지.",
      "UnitTalk_JPN": "お説教はここまでです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "돌아가는 길을 찾고 계신 거죠? 제가 안내해 드릴게요.",
      "UnitTalk_JPN": "帰り道を探していらっしゃるのでしょう？私が案内して差し上げます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "ONE_3",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "...제가 하던 일이 있지 않냐고요?",
      "UnitTalk_JPN": "…何かしていたのではないか、ですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "약초를 채집하던 중이었지만 단장님은 한시가 바쁜 분이시니까요.",
      "UnitTalk_JPN": "薬草を採取していたところでしたが、団長はとてもお忙しい方ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "도움이 필요한 사람을 돕는 게 먼저죠.",
      "UnitTalk_JPN": "困っている方を先に助けて差し上げないと。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "…네?",
      "UnitTalk_JPN": "…はい？",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "DEFAULT",
      "UnitMotion": "SPECIAL"
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "단장님도 저처럼 약초를 채집하고 계셨다니 우연이네요.",
      "UnitTalk_JPN": "団長もちょうど薬草を採取していらっしゃったなんて、奇遇ですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "아니, 기연이라고 해야 할까요?",
      "UnitTalk_JPN": "不思議な巡り合わせとでも言いましょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "혼자 외롭지 말라고 하늘이 제게 단장님을 보내주신 걸지도 모르겠네요. 후후.",
      "UnitTalk_JPN": "一人で寂しくないようにと、天が団長と引き合わせてくださったのかもしれませんね。ふふ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "USN_UI_REST_START",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "…따로 채집 의뢰를 받았냐고요?",
      "UnitTalk_JPN": "…採取の依頼を受けたのか、ですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아니요. 순전히 개인 활동이에요.",
      "UnitTalk_JPN": "いえ、ただ薬草を採っていただけです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "이 숲에는 귀중한 약초들이 잔뜩 있거든요.",
      "UnitTalk_JPN": "この森には、貴重な薬草がたくさんあるんですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "저기 보이세요?",
      "UnitTalk_JPN": "あそこ、見えますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "린이 가리킨 곳에는 다양한 풀이 자라나 있었다.",
      "UnitTalk_JPN": "リンが指差すところには、色んな草が育っていた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "저 풀의 이름은 씀바귀예요. 소화불량에 좋답니다.",
      "UnitTalk_JPN": "あれは<r=ニガナ>苦菜</r>です。消化不良によく効くんですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 75,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "그 옆은 황기, 그 옆은 인삼.",
      "UnitTalk_JPN": "その横はキバナオウギ、そして<r=オタネニンジン>御種人蔘</r>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "주변엔 쑥과 칡이 자랐네요.",
      "UnitTalk_JPN": "周りにはヨモギと<r=クズ>葛</r>が育っていますね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나한테는 다 똑같은 풀로 보여.",
          "JumpAnchorStringId_JPN": "私には全部同じに見えるよ。"
        }
      ]
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "후후, 그럴 만도 하죠.",
      "UnitTalk_JPN": "ふふ、無理もありませんよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "하지만 단장님. 자연 만물에는 저마다의 가치가 있답니다.",
      "UnitTalk_JPN": "でも、団長。自然の万物には、それぞれの価値があるんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "바닥에 아무렇지 않게 피어난 풀도, 주변을 소란스럽게 날아다니는 벌레도…",
      "UnitTalk_JPN": "地面に生えている草も、辺りを騒がしく飛ぶ虫も…",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "누군가에게는 꼭 필요해서 없어서는 안 될 존재들이죠.",
      "UnitTalk_JPN": "誰かにとっては、なくてはならない存在なんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
