      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_LPU_POST_REST_GOOD",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_LPU_POST",
      "UnitTalk_KOR": "후후, 그러니 오늘의 베라는 무적이랍니다!",
