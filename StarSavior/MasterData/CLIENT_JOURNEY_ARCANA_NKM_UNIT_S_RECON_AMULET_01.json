    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "안녕하십니까, 단장님.",
      "UnitTalk_JPN": "こんにちは、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitPos": "POS8",
      "UnitTalk_KOR": "네? 단장님이요? 와! 안녕하세요!",
      "UnitTalk_JPN": "えっ、団長ですか！わー、こんにちはっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "어디 가고 계셨어요? 산책 중이셨나요?",
      "UnitTalk_JPN": "どこに向かってたんですか？それともお散歩中でしたか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "응. 그나저나 의외의 조합이네?",
          "JumpAnchorStringId_JPN": "散歩だよ。それにしても、意外な組み合わせだな。"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "의외의 조합…?",
      "UnitTalk_JPN": "意外な組み合わせ…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "확실히 그렇게 보일 수도 있겠군요.",
      "UnitTalk_JPN": "確かに、そう思われてもおかしくありませんね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "헤헷! 사실 이번에 안전 캠페인 행사가 있거든요.",
      "UnitTalk_JPN": "てへっ！実は、安全キャンペーンイベントを行うんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "NOA 치안국, 관측사 평의회 <color=#F7BE45>폴라리스</color>에서 공동 주관해요.",
      "UnitTalk_JPN": "NOA治安局と、<color=#F7BE45><r=ポラリス>観測士評議会</r></color>の共同主催なんですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "그래서 어떤 식으로 진행할지 루그 님과 논의하고 있었답니다!",
      "UnitTalk_JPN": "そこで…どんな風に進めようかと、ルーさんと話し合っていたんです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "본래는 팀장님이 참석해야 되지만 어제도 경위서를 작성하는 바람에…",
      "UnitTalk_JPN": "本来ならリーダーが出席しなければなりませんが、昨日も始末書を作成していたせいで…",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "부득이하게 제가 대신 오게 됐습니다.",
      "UnitTalk_JPN": "やむを得ず、私が代わりに参加することになりました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "마침 잘됐군요.",
      "UnitTalk_JPN": "しかし、ちょうど良かったです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "한 사람이 더 필요했는데 단장님이랑 만나서 정말 다행이에요!",
      "UnitTalk_JPN": "もう一人必要だったんですが、団長が来てくださって助かりました！",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_RECON_AMULET_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "도와주실 거죠? 에헷!",
      "UnitTalk_JPN": "手伝ってくれますよね？てへっ！",
      "TalkTime": 0.03
    },
    {
