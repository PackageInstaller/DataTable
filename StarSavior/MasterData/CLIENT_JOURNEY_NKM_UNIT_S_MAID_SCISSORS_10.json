      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_WELL_DIRAC.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_01.mp3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "이걸로 <color=#F7BE45>여정</color>도 끝인가… ",
      "UnitTalk_JPN": "これで<color=#F7BE45>救援の旅</color>も終わりか…",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "후후! 이 몸의 능력이면 <color=#F7BE45>여정</color> 쯤이야 간단히 통과할 줄은 알았지만 그래도 후련하구나!",
      "UnitTalk_JPN": "フフ！わがはいであれば、<color=#F7BE45>救援の旅</color>など簡単なものとは知っていたが、せーせーするのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그래도 네가 아니었다면… 조금 더 힘들었을지 모른다.",
      "UnitTalk_JPN": "だがしかし、お主がいなければ…もうちょっとだけ大変だったかも知れぬ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "어딘가에서 실수를 했을 수도 있고, <color=#F7BE45>실마리</color>를 잡지 못했을지도 모르지.",
      "UnitTalk_JPN": "どこかでしくじったかも知れないし、<color=#F7BE45>手掛かり</color>を掴めなかったかもしれないのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아마 <color=#F7BE45>대재단사</color>로 향하는 길에서 빙글빙글 헤매지 않았을까?",
      "UnitTalk_JPN": "おそらく<color=#F7BE45>大仕立屋</color>への道のりで、ぐるぐると迷っていたんだろう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "내가 없었더라도 잘 해냈을 거야.",
          "JumpAnchorStringId_JPN": "一人でも上手くやれたさ。"
        }
      ]
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "뭐, 그랬을 수도 있고! 흐하하!",
      "UnitTalk_JPN": "そうかも知れないのだ！フハハ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "그래도 중요한 건! 지금은 내 곁에 단장, 네가 있다는 사실이다.",
      "UnitTalk_JPN": "でも大切なことは！今わがはいの傍にいる団長、お主がいることだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "앞으로도 잘 부탁한다. 나의 <color=#F7BE45>필연</color>이여.",
      "UnitTalk_JPN": "これからもよろしくなのだ。わがはいの<color=#F7BE45>必然</color>よ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나도 잘 부탁해.",
          "JumpAnchorStringId_JPN": "こちらこそよろしく。"
        }
      ]
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그런 의미에서! 나중에 <color=#F7BE45>용의 계곡</color>에 함께 가보는 건 어떠냐?!",
      "UnitTalk_JPN": "そういうわけで！後で<color=#F7BE45>竜の谷</color>に一緒に行ってみないか？！",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>용의 계곡</color>을?",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>竜の谷</color>に？"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래. 인간에게는 더할 나위 없는 영광이지.",
      "UnitTalk_JPN": "そうなのだ。人間にとって、これ以上の光栄はないのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "용족의 명예로운 손님이 되어야만 초대받을 수 있는 곳이니까. ",
      "UnitTalk_JPN": "誉れ高い竜族の来賓こそが、立ち入れる場所だからな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "…그런데 <color=#F7BE45>대재단사</color>가 되기 전까지는 돌아가지 않겠다고 큰소리 쳐놨는데 어쩌지…?",
      "UnitTalk_JPN": "…しかし<color=#F7BE45>大仕立屋</color>になるまで、戻らんと大きな口を叩いておいたのだが…どうしよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>대재단사</color>가 되면 되지.",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>大仕立屋</color>になればいい。"
        }
      ]
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그게 그리 쉬운 일이 아니란 말이다…",
      "UnitTalk_JPN": "そう簡単な話ではないのだ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "<color=#F7BE45>특별한 기술</color>에 대해 아직 많이 알아봐야 하기도 하고, 무엇보다 아직 <color=#F7BE45>벨라</color>는 찾지도 못했잖으냐.",
      "UnitTalk_JPN": "<color=#F7BE45>特別な技</color>についても、まだ調べる事も多いし、何よりまだ<color=#F7BE45>ベラ</color>すらも見つからんではないか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "계획이 있어.",
          "JumpAnchorStringId_JPN": "考えがある。"
        }
      ]
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "계획?",
      "UnitTalk_JPN": "考え？",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그 <color=#F7BE45>후드 쓴 녀석</color>부터 찾아보는 거야.",
          "JumpAnchorStringId_JPN": "その<color=#F7BE45>フードを被ったやつ</color>を探すんだ。"
        }
      ]
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>벨라</color>를 구해다 줬다는 사람.",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>ベラ</color>を取ってきてくれた人。"
        }
      ]
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "…아아!",
      "UnitTalk_JPN": "…ああ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "그래. 그 녀석부터 차근차근 되짚어가면 되겠구나!",
      "UnitTalk_JPN": "そうなのだ。そいつから辿ればいいのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "천재냐? 단장은!",
      "UnitTalk_JPN": "天才か？団長は！",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "흠! 하지만 아주 기나긴 여정이 될지도 모른다. 고작 1년간의 지난 <color=#F7BE45>여정</color>과는 달리 말이야.",
      "UnitTalk_JPN": "ふむ！しかし、長い旅路になるかも知れないのだ。たった1年の<color=#F7BE45>救援の旅</color>とは違ってな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "단장은 인간인 주제에 몇 년이나 나와 함께 할 수 있을지 걱정이다!",
      "UnitTalk_JPN": "人間に過ぎない団長は、何年をわがはいと共にいられるか心配なのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그래도 몇 십 년 정도는 가능하지 않을까?",
          "JumpAnchorStringId_JPN": "おそらく何十年はいけるかな？"
        }
      ]
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "크하하! 수명이 다할 때까지 말이냐?",
      "UnitTalk_JPN": "クハハ！その寿命が尽きるまでか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "좋아! 그럼 그 안에 꼭 찾아야겠구나.",
      "UnitTalk_JPN": "良し！その間には何としても見つけるのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "나는 잠시 그녀의 환한 얼굴을 바라보았다.",
      "UnitTalk_JPN": "私は、しばらく彼女の眩しい笑顔を見つめていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "수많은 시련과 상처를 딛고 마침내 <color=#F7BE45>[여정]</color>의 끝에 도달한 자.",
      "UnitTalk_JPN": "幾多の試練と痛みを克服し、ついに<color=#F7BE45>「救援の旅」</color>の終わりに到達した者。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그녀의 앞에는 더욱 많은 고난과 어려움이 기다리고 있을 것이다.",
      "UnitTalk_JPN": "彼女には、更なる苦悩と困難が待ち受けているはずだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 나는 믿는다.",
      "UnitTalk_JPN": "しかし、私は信じている。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그녀는 분명 나를 뛰어넘을…",
      "UnitTalk_JPN": "彼女はきっと、私を超える…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "최고의 <color=#F7BE45>[구원자]</color>가 될 것이라는 걸.",
      "UnitTalk_JPN": "最高の<color=#F7BE45>「救援者」</color>になれるということを。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": false,
      "WaitTime": 1.0,
      "BgFadeInStartCol": [
        "0",
        "0",
