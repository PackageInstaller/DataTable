        "0"
      ],
      "BgFadeInCol": [
        "0",
        "0",
        "0",
        "1"
      ],
      "BgFadeInTime": 1.0,
      "StartBgmFileName": "EMPTY.mp3"
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그 눈부신 모습에… 나는 잠시 눈을 감았다.",
      "UnitTalk_JPN": "その眩しい姿に…私はそっと瞳を閉じた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_10",
