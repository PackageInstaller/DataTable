      "UnitPos": "POS3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "프레이는 여전히 기운이 없어 보인다. ",
      "UnitTalk_JPN": "フレイはまだ元気がないみたいだ。  ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "훈련 내내 축 처진 어깨가 올라올 기미가 없는 걸 보니, 무슨 고민이라도 있는 걸까. ",
      "UnitTalk_JPN": "訓練中、ずっとしょんぼりしてるけど…何かあったのかな？ ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그러고 보면 어쩐지 최근 훈련의 성과도 미비한 것 같다. ",
      "UnitTalk_JPN": "そういえば、最近は訓練の成果も芳しくなかった。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "휴우…",
      "UnitTalk_JPN": "ふぅ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "별로 기운이 없는 것 같네. 무슨 일 있어?",
          "JumpAnchorStringId_JPN": "元気なさそうだね。どうしたの？"
        }
      ]
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "음…",
      "UnitTalk_JPN": "うむ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "실은 이대로 <color=#F7BE45>여정</color>을 계속해도 될지 고민 중입니다. ",
      "UnitTalk_JPN": "このまま<color=#F7BE45>旅</color>を続けていいのか悩んでいるのです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "사실 저는 딱히 <color=#F7BE45>여정</color>을 끝마치는 데에는 별 관심이 없어요. ",
      "UnitTalk_JPN": "実は、<color=#F7BE45>旅</color>をクリアすること自体にはあまり興味がありません。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "다만 NOA에 오면 큰 사업 기회가 많을 거라고 생각했을 뿐이죠.",
      "UnitTalk_JPN": "ただ、NOAに来れば大きなビジネスチャンスがあると思っただけですの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "이렇게 훈련하는 데에 무슨 의미가 있나 싶기도 하고…",
      "UnitTalk_JPN": "こうして訓練することに、何の意味があるのかと思ったり…",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이런 마음가짐이라면 다른 지원자에게 자격이 돌아가야 하는 건 아닐까요?",
      "UnitTalk_JPN": "こんな心持ちなら、他の志願者に資格を譲るべきではないでしょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "글쎄, 어쩌면 그럴지도…",
          "JumpAnchorStringId_JPN": "うーん。確かにそうかも…"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "역시 단장님도 그렇게 생각하나요?",
      "UnitTalk_JPN": "やはり団長もそう思いますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "하지만 뭐든 해보지 않으면 모르는 거지.",
          "JumpAnchorStringId_JPN": "でも、何でもやってみないと分からないものだよ。"
        }
      ]
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "해보지 않으면 모른다…?",
      "UnitTalk_JPN": "やってみないと分からない…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그런 공허한 말로는 절 설득할 수 없습니다.",
      "UnitTalk_JPN": "そんな中身のない言葉では、わたくしを説得することはできませんよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "이런 훈련이 제 사업에 어떤 도움이 된다는 건가요?",
      "UnitTalk_JPN": "この訓練が、わたくしのビジネスにどう役立つのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "예를 들자면… 아무튼 유명해지긴 하겠지?",
          "JumpAnchorStringId_JPN": "例えば…有名になることとか？"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "유명해진다…?!",
      "UnitTalk_JPN": "有名になる…！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "과연… 그렇군요!",
      "UnitTalk_JPN": "やはり…そうなのですね！",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_MONASTIR.mp3",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아주 오래전, 공국 도서관의 고서에서 보았던 문구가 떠올랐습니다.",
      "UnitTalk_JPN": "昔、公国図書館の古書で見た言葉を思い出しました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "<color=#F7BE45>일단 유명해져라. </color>",
      "UnitTalk_JPN": "<color=#F7BE45>まずは有名になれ。</color>",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "<color=#F7BE45>그럼 당신이 무슨 짓을 해도 박수를 쳐줄 것이다!</color>",
      "UnitTalk_JPN": "<color=#F7BE45>そうすれば、何をしても賞賛の拍手を受けるだろう！</color>",
      "TalkTime": 0.03,
      "TalkAppend": true
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장님도 그 책을 본 적이 있으셨군요.",
      "UnitTalk_JPN": "団長も、その本を読まれたのですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "음… 그야 뭐…",
          "JumpAnchorStringId_JPN": "うーん…それは…"
        }
      ]
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "역시, 그 정도 교양은 있어야 여정 단장직에 낙하할 수 있는 거겠죠.",
      "UnitTalk_JPN": "やはり、このような教養があったからこそ…コネで旅の団長になれたのでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아무튼!",
      "UnitTalk_JPN": "とにかくっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "이걸로 제 <color=#F7BE45>여정</color>의 방향이 결정되었군요.",
      "UnitTalk_JPN": "これで、わたくしの<color=#F7BE45>旅</color>の方向性が定まりました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "여정을 성공적으로 마치고 저명한 구원자가 되는 것!",
      "UnitTalk_JPN": "旅をクリアして、著名な救援者になること！",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "그리고 그 유명세를 이용해 사업을 성공시키는 것!",
      "UnitTalk_JPN": "そして、知名度を利用してビジネスを成功させること！",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "그것이 바로 제 여정의 목적지 입니다!",
      "UnitTalk_JPN": "それこそが、わたくしの旅の目的ですっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "고마워요. 하마터면 패배 의식에 사로잡힐 뻔했네요.",
      "UnitTalk_JPN": "感謝します。危うく弱気になってしまうところでしたわね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "사업가로서 무엇보다 중요한 건 도전 정신! ",
      "UnitTalk_JPN": "事業家として、最も重要なのはチャレンジ精神！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "해보지도 않고 포기한다니, 안될 말이죠. ",
      "UnitTalk_JPN": "やってもいないのに諦めるなんて、ありえないのです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후! 훈련 진행하죠!",
      "UnitTalk_JPN": "ふっふっふ！訓練を続けましょう！",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "프레이는 금세 기운을 되찾았다.",
      "UnitTalk_JPN": "フレイは、あっという間に元気を取り戻した。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "목적이 조금 불순하긴 하지만 어렵지는 않을 것이다.",
      "UnitTalk_JPN": "目的がちょっと不純な気もするけど、それも難しくはないはず。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL"
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "지금도… 저 녀석은 해괴한 사업꾼으로 유명하니까.",
      "UnitTalk_JPN": "今でも…フレイは変わった事業家で有名だし。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_PRAY_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아무튼 잘 된 일이다. ",
      "UnitTalk_JPN": "とにかく、いい方向に向かったみたいで良かった。 ",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 42,
