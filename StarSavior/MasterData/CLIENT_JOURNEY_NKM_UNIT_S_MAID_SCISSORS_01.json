      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "곧 해가 지는 시간이건만.",
      "UnitTalk_JPN": "じき日が沈む時間なのだが。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
