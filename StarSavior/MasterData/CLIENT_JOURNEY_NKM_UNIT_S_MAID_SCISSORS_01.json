      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "어쨌든 대단하다니!",
      "UnitTalk_JPN": "とりあえず、すごいのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그러니 넌 나만 믿고 따라오면 된다는 말씀! ",
      "UnitTalk_JPN": "だからお主も、黙ってわがはいについてくれば良いことよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "시험 삼아 훈련장에서 몸이나 풀자꾸나! 흐하하하!",
      "UnitTalk_JPN": "物は試しだ、訓練場で準備運動でもしようではないか！フハハハ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "스칼렛은 호탕하게 웃으며 나를 잡아 이끌었다. ",
      "UnitTalk_JPN": "スカーレットは威勢よく笑いながら、手を握り引っ張って行った。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
