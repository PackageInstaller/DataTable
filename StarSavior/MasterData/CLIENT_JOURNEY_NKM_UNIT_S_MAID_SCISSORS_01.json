      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그러고 보니 어쩐지 낯이 익다.",
      "UnitTalk_JPN": "そういえば妙に見覚えがある。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그러고 보니 너, 캔들 스퀘어의…?",
          "JumpAnchorStringId_JPN": "お前、キャンドル・スクエアの…？"
        }
      ]
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_01",
