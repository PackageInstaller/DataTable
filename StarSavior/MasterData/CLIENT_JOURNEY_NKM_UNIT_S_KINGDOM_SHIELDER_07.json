    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "신년 축제를 즐기러 나온 인파로 거리가 북적거린다.",
      "UnitTalk_JPN": "新年祭を楽しむ人たちで、街は賑わっている。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "휴일을 맞아 집에서 여유롭게 휴식할 생각이었지만…",
      "UnitTalk_JPN": "休日だし、家でゆっくりしようと思っていたが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "<color=#F7BE45>그날 밤의 공터로 나와줄 수 있느냐</color>는 카르멘의 부탁을 무시할 수 없었기에 집을 나섰다. ",
      "UnitTalk_JPN": "<color=#F7BE45>夜、空き地に来てほしい</color>というカルメンの頼みを断るわけにはいかなかったため、家を出た。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitPos": "POS3"
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "공터에 도착하자 카르멘이 환한 미소로 나를 반긴다. ",
      "UnitTalk_JPN": "空き地に到着すると、カルメンは明るい笑顔で私を迎えた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "아, 오셨나요 단장님?",
      "UnitTalk_JPN": "あっ、団長さん。いらっしゃいましたね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "다들 신년 축제로 들떠 있는데 또 혼자 훈련이라니. 혹독하네.",
          "JumpAnchorStringId_JPN": "みんな新年祭で浮かれてるのに、一人でトレーニングか。ストイックだね。"
        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "후후. 뭔가 오해하시는 것 같은데요. ",
      "UnitTalk_JPN": "ふふっ。何か誤解されているようですね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "오늘은 훈련을 하려고 온 게 아니랍니다. ",
      "UnitTalk_JPN": "今日はトレーニングしに来た訳ではありませんよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "보세요. 방패와 검도 없이 훈련을 하러 왔을 리가 없잖아요? ",
      "UnitTalk_JPN": "ほら、見てください。盾と剣なしでトレーニングに来ることなんてないでしょう？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…이제 보니 그건 그렇네. 그럼 굳이 여기로 불러낸 이유는 뭔데?",
          "JumpAnchorStringId_JPN": "…そう言われてみればそうだな。じゃあ、なんでここに呼び出したの？"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "그건…",
      "UnitTalk_JPN": "それは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "카르멘이 싱긋 웃으며 고급스러워 보이는 병 하나를 꺼내 들었다.",
      "UnitTalk_JPN": "カルメンがにこっと笑うと、高そうな瓶を取り出した。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_15.mp3",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "단장님과 함께 이 최고급 <color=#F7BE45>벌꿀주</color>를 마시면서 신년 축제를 즐기기 위해서랍니다. 후후. ",
      "UnitTalk_JPN": "団長さんと一緒にこの最高級<color=#F7BE45>ハチミツ酒</color>を飲みながら、新年祭を楽しむためです。ふふっ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "모나스티르 공국 최고의 양조장에서 베테랑 양조사들이 정성스럽게 빚어낸 <color=#F7BE45>벌꿀주</color>죠.  ",
      "UnitTalk_JPN": "モナスティル公国一の醸造場で、腕利きの醸造家が真心を込めて作った<color=#F7BE45>ハチミツ酒</color>なのですよ。  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "게다가 이곳은 주변이 뻥 뚫린 데다 사람도 잘 오지 않는 공터.",
      "UnitTalk_JPN": "それに…ここは広々としている上に、人もあまり来ない空き地。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "한적하게 하늘을 올려다보기 딱 좋은 곳이죠. 후후.",
      "UnitTalk_JPN": "静かに空を見上げるのに、ちょうど良い場所でしょう？ふふっ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "어떠세요? 구미가 당기시지 않나요?",
      "UnitTalk_JPN": "どうですか？魅力的でしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "네가 훈련이 아니라 휴식에 이렇게 신경을 쓰다니. 의외네.",
          "JumpAnchorStringId_JPN": "トレーニングだけじゃなく、イベントも大事にするんだな。意外かも。"
        }
      ]
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그러게요. 저도 이런 제가 의외라고 생각해요. ",
      "UnitTalk_JPN": "そうですよね。私自身もそう思いますから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "글쎄요. 심경에 변화라도 있었나 봐요. ",
      "UnitTalk_JPN": "私の心にも、何か変化があったようです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "후후. 오늘은 복잡한 말보다 일단 한잔 마시고 시작하는 게 어떤가요?",
      "UnitTalk_JPN": "ふふっ。込み入った話は後にして、まずは一杯飲みましょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아! 혹시 <color=#F7BE45>벌꿀주</color>가 싫으시면 <color=#F7BE45>피로 회복 수프</color>도 있답니다?",
      "UnitTalk_JPN": "あっ！もし<color=#F7BE45>ハチミツ酒</color>の気分でなければ、<color=#F7BE45>疲労回復スープ</color>もありますよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>벌꿀주</color>로 부탁해.",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>ハチミツ酒</color>にするよ。"
        }
      ]
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "후후. 이건 기사단 단원들만 알고 있는 특별 비법인데 특별히 알려드릴게요.",
      "UnitTalk_JPN": "ふふっ。これは騎士団の団員だけが知っている秘伝の技なのですが…特別に教えてあげますね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "<color=#F7BE45>벌꿀주</color>에 <color=#F7BE45>피로 회복 수프</color>를 섞어 마시면 다음날 숙취가 없이 깔끔한 아침을…",
      "UnitTalk_JPN": "<color=#F7BE45>ハチミツ酒</color>に<color=#F7BE45>疲労回復スープ</color>を混ぜて飲めば、二日酔いもせずスッキリした朝を…",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아니. <color=#F7BE45>벌꿀주</color>로.",
          "JumpAnchorStringId_JPN": "ううん。<color=#F7BE45>ハチミツ酒</color>で。"
        }
      ]
    },
