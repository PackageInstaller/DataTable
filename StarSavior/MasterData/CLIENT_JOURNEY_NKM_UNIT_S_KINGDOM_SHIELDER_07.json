    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "소원, 빌었어?",
          "JumpAnchorStringId_JPN": "願い事、した？"
        }
      ]
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "그럼요. <color=#F7BE45>로켓 점화식</color>은 날아가는 로켓을 보며 소원을 비는 게 핵심이니까요. ",
      "UnitTalk_JPN": "もちろんです。<color=#F7BE45>ロケットの打ち上げ</color>では、飛び立つロケットを見ながら願い事をするのがメインですからね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "무슨 소원을 빌었는데?",
          "JumpAnchorStringId_JPN": "どんな願い事をしたの？"
        }
      ]
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "음…",
      "UnitTalk_JPN": "んー…",
      "TalkTime": 0.03
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "제 꿈이 헛된 것이 아니길 빌었어요. ",
      "UnitTalk_JPN": "私の夢が、報われますようにとお願いしました。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "그리고…",
      "UnitTalk_JPN": "あとは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "후후. 나머지 하나는 비밀이랍니다.",
      "UnitTalk_JPN": "ふふっ。もう一つは秘密です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그녀는 저 멀리 점이 되어가는 로켓을 바라보며 웃는다. ",
      "UnitTalk_JPN": "カルメンは遠い空の彼方、点のように小さくなったロケットを見つめながら笑った。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "거짓 한 점 없는 순수한 웃음이었다. ",
      "UnitTalk_JPN": "偽りのない、心からの笑顔だった。 ",
      "TalkTime": 0.03,
