    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "오이오이!",
      "UnitTalk_JPN": "おはようございます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "여정 단장님도 일찍 도착하셨네요?",
      "UnitTalk_JPN": "団長さんも、早く到着されたんですね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "아침은 드셨나요? ",
      "UnitTalk_JPN": "朝ごはんは食べられましたか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "혹시 시장하시면 이거라도 하나 드시겠어요?",
      "UnitTalk_JPN": "もしよかったら、これをどうぞ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이건…?",
          "JumpAnchorStringId_JPN": "これは…？"
        }
      ]
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": " 민트 초코 아이스크림이에요.",
      "UnitTalk_JPN": "チョコミントアイスです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": " 저도 처음 먹어보는데 <color=#F7BE45>[카페 스트레가]</color>라는 곳의 명물 메뉴라고 하더라고요.",
      "UnitTalk_JPN": "私も初めて食べたんですが、<color=#F7BE45>「カフェ・ストレガ」</color>というお店の看板メニューだそうです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": " 그곳에 일하는 아르바이트생이 개발했다나…?",
      "UnitTalk_JPN": "そこで働くアルバイトさんが開発したとか…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "민트… 아이스크림?",
          "JumpAnchorStringId_JPN": "チョコミント…アイス？"
        }
      ]
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "네, 확실히 호불호가 갈리는 맛이긴 한데…",
      "UnitTalk_JPN": "はい、確かに好き嫌いが分かれる味ではありますが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "개인적으로는 이 영혼이 뒤틀리는 듯한 자극이 아주 마음에 든달까?",
      "UnitTalk_JPN": "個人的には、魂をえぐられるような刺激がすごく気に入ったんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": " 실은 지난번에도 인사가 끝나고 제일 먼저 이걸 먹으러 가려고 했었거든요.",
      "UnitTalk_JPN": "実はこの前も、一番にこれを食べに行こうと思っていたんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": " 대장이 맛집 탐방 일정을 전부 취소하지만 않았으면 단장님도 같이 가자고 했을 텐데…",
      "UnitTalk_JPN": "隊長にグルメツアーを妨害さえされなかったら、団長さんもお誘いしたかったんですよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": " 뭐, 조금 늦었지만 이제라도 간식 정도는 나눠 먹는 사이가 되면 좋잖아요?",
      "UnitTalk_JPN": "少し遅くなりましたけど、今からでもおやつくらいは分け合える仲になれたら嬉しいなと思って。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": " 이렇게 만난 것도 인연이니까요.",
      "UnitTalk_JPN": "こうして出会えたのも縁ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "고마워.",
          "JumpAnchorStringId_JPN": "ありがとう。"
        }
      ]
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "근데 아침부터 민트 초코는 좀…",
          "JumpAnchorStringId_JPN": "でも朝からチョコミントはちょっと…"
        }
      ]
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "에이~ 사양하지 마세요.",
      "UnitTalk_JPN": "もう～、遠慮しないでくださいよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "실전이든 평가전이든 배가 고프면 제대로 싸울 수 없는 법이잖아요?",
      "UnitTalk_JPN": "実戦でも試験でも、お腹が空いていたらまともに戦えないですよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitPos": "POS2",
      "UnitTalk_KOR": "그만, 리디아.",
      "UnitTalk_JPN": "もういい、リディア。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아, 대장. 언제 왔어요?",
      "UnitTalk_JPN": "あっ、隊長。いつ来たんですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitTalk_KOR": "방금.",
      "UnitTalk_JPN": "今だ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitTalk_KOR": " 그리고 넌 새벽부터 어딜 나가나 했더니 그런 쓸데없는 걸 사러 갔었군.",
      "UnitTalk_JPN": "明け方からどこへ行ったのかと思っていたら、\nそんな無駄なものを買いに行っていたのか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitTalk_KOR": " 네가 개인 정비 시간에 뭘 하든 자유다.",
      "UnitTalk_JPN": "個人的な整備時間に何をしようと勝手だが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitTalk_KOR": "이제부터 싸워야 할 <color=#F7BE45>[적]</color>에게 쓸데없는 호의를 베풀 필요는 없어.",
      "UnitTalk_JPN": "これから戦うべき<color=#F7BE45>「敵」</color>に、無駄な好意を示す必要はない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "에, 그래봐야 아이스크림 하나 정도인데…",
      "UnitTalk_JPN": "え～、たかがアイス一つじゃないですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "대장님이 안 먹는 건 그럴 수 있지만, 여기 단장님이 먹는 건 상관없지 않아요-?",
      "UnitTalk_JPN": "隊長が食べないのはいいとして、団長さんが食べるのは関係ないでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "다들 열심히 하는 건 좋은데, 너무 긴장하면 본래 실력이 안 나온다잖아요?",
      "UnitTalk_JPN": "みんな一生懸命なのはいいですけど、緊張しすぎると本来の実力を出せませんから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "가볍게 릴렉스하자는 의미에서 가져온 간식이니 한입 드셔보세요.",
      "UnitTalk_JPN": "緊張を解く意味を込めて持ってきたんです。一口食べてみてください。",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "대장도 살짝 긴장한 거 아니에요?",
      "UnitTalk_JPN": "隊長も少し緊張してるんじゃないですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitTalk_KOR": "리디아!",
      "UnitTalk_JPN": "リディア！",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "기껏 주둔지를 떠나서 NOA에 왔는데 매일 밤까지 훈련만 하고~",
      "UnitTalk_JPN": "せっかく駐屯地を離れてNOAに来たのに、毎日夜遅くまでトレーニングばっかりして～…",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "처음 만났을 때 쉽지 않은 상대라고 생각했으니까 더 자신감을 내비치고 날을 세웠던 거잖아요?",
      "UnitTalk_JPN": "初めて会った時、手強い相手だと思ったからこそ、わざと強気な態度を取っていたんでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
