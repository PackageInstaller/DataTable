      "BgFadeInTime": 0.5
    },
    {
      "Uid": 51,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "깜짝 놀라서 떼어내려고 했지만, 미동도 하지 않는다.",
      "UnitTalk_JPN": "驚いて引き剥がそうとしたが、レイシーはびくともしない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "결국 저항하기를 포기한 채, 로비를 지나가던 메이드들의 관심을 한 몸에 받으며 서 있기를 수 분.",
      "UnitTalk_JPN": "私は抵抗を諦め…ロビーを通りかかるメイドたちの注目を浴びながら、数分間立ち尽くした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 53,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "마침내 레이시가 내 몸에서 손을 뗐다.",
      "UnitTalk_JPN": "そして、ついにレイシーが私の身体から手を離した。",
      "TalkTime": 0.03
    },
    {
      "Uid": 54,
      "WaitClick": false,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARTEXT",
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "CameraOffset": "TWIN_4",
      "UnitMotion": "SERIOUS"
    },
    {
      "Uid": 102,
      "WaitClick": false,
      "WaitTime": 0.5,
      "BgFadeOutCol": [
        "0",
