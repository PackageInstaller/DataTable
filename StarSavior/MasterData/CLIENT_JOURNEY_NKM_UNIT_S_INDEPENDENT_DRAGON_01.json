        "1"
      ],
      "BgFadeOutTime": 0.5
    },
    {
      "Uid": 55,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitTalk_KOR": "이 세계의 것 같지 않은 독특한 기운이 느껴져 흥미가 일었는데…",
      "UnitTalk_JPN": "この世の者とは思えぬ、独特な気に惹かれたのじゃが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 56,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "지금 보니 그 크기가 별 볼 일 없을 정도로 작구나.",
      "UnitTalk_JPN": "今こうしてみると、取るに足らない大きさじゃの。",
