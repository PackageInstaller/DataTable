      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "자, 작다니?!",
          "JumpAnchorStringId_JPN": "ち、小さいってこと！？"
        }
      ]
    },
    {
