      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…미안. 뭔가 큰일이 날 줄 알았어.",
          "JumpAnchorStringId_JPN": "…ごめん。大変なことになるかと思った。"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "그런데 가위는 왜?",
          "JumpAnchorStringId_JPN": "ところで、そのハサミは何に使うの？"
        }
