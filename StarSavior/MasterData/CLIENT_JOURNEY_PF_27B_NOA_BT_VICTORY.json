    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "하아, 하아…",
      "UnitTalk_JPN": "はぁ、はぁ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "져, 졌습니다…!",
      "UnitTalk_JPN": "ま、負けました…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "후우… 정말로…",
      "UnitTalk_JPN": "ふぅ…本当に…",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…강하시네요. 깜짝 놀랐어요.",
      "UnitTalk_JPN": "…お強いのですね。驚きました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그쪽이야말로.",
          "JumpAnchorStringId_JPN": "そっちこそ。"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아슬아슬했어.",
          "JumpAnchorStringId_JPN": "ギリギリだったよ。"
        }
      ]
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "전투 내내 두 명은 일심동체와 같은 공격과 방어를 선보였다.",
      "UnitTalk_JPN": "戦闘中、二人は一心同体のような攻撃と防御を見せた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "찰나의 빈틈을 찌르지 못했다면, 이 공방 일체를 격파하기는 쉽지 않았을 것이다.",
      "UnitTalk_JPN": "一瞬の隙を突けなかったなら、この攻防一体を打ち破るのは難しかっただろう。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이것이 모나스티르의 힘…",
      "UnitTalk_JPN": "これがモナスティルの力…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "우우, 역시 지는 건 분해…!",
      "UnitTalk_JPN": "うぅ、やっぱり負けるのは悔しいぃ…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "1명만 더 있었어도 아까 그 빈틈까지 막을 수 있었을 텐데…!",
      "UnitTalk_JPN": "あと一人いれば、あの隙も塞げたはずなのに…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "저희는 진을 짜고 다수를 상대하는 경우가 많다 보니… 서로가 서로의 방패가 되어줘야 하거든요.",
      "UnitTalk_JPN": "私たちは陣を組み、多数を相手にする機会が多いので…お互いがお互いの盾にならなければならないのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "빈틈이라고는 했지만, 그걸 포착하는 건 쉬운 일이 아닐 텐데…",
      "UnitTalk_JPN": "隙とは言え、それを捉えるのは簡単ではありません…",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "역시 서부 탈환대 대원의 공세는 매섭군요.",
      "UnitTalk_JPN": "さすが西部奪還隊ですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "무서울 정도의 위압이 느껴졌어요.",
      "UnitTalk_JPN": "身がすくむような威圧感を感じました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "덕분에 큰 도움이 되었어.",
          "JumpAnchorStringId_JPN": "おかげで助かったよ。"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후… 천만에요. 저희야말로 귀중한 경험이 된 것 같네요.",
      "UnitTalk_JPN": "ふふっ…どういたしまして。こちらこそ、貴重な経験になりました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "맞아요! 오늘의 평가전 내용을 반성하고 반영해서…",
      "UnitTalk_JPN": "そうですね！今日の試験を反省して、次に活かして…",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "다음에는 더 강한! 모나스티르 기사단이 될 테니까요!",
      "UnitTalk_JPN": "もっと強いモナスティル騎士団になります！",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.5,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "…그러니 다음에도 기회가 된다면, 평가전과 상관없이 또 겨뤄보고 싶습니다!",
      "UnitTalk_JPN": "…ですからまた機会があれば、試験とは関係なく手合わせをお願いしたいです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "여정, 분명히 어렵지 않게 통과하시리라 믿어요.",
      "UnitTalk_JPN": "救援の旅も、きっと難なく通過されると思いますよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27B_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "계속 응원할게요!",
      "UnitTalk_JPN": "これからも応援しています！",
      "TalkTime": 0.03
    }
  ]
}
