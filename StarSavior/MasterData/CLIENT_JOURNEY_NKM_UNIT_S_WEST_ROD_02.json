        "SI_ICECREAMSHOP_OWNER"
      ],
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "UnitPos": "POS2",
      "UnitTalk_KOR": "어머, 우리 집을 처음 와 본다구? ",
