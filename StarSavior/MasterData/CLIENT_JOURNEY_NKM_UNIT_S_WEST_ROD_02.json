      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NPC_MODULE_MERCHANT_FEMALE_6",
      "UnitNameString": [
        "SI_ICECREAMSHOP_OWNER"
      ],
      "UnitTalk_KOR": "혹시 다른 지역에서 온 거니? ",
      "UnitTalk_JPN": "もしかして、他の地域から来たの？ ",
      "TalkTime": 0.03
    },
    {
