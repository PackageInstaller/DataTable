    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "음~! 맛있어…! ",
      "UnitTalk_JPN": "う～ん！おいしい…！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장님, 이거 진짜 맛있네요! ",
      "UnitTalk_JPN": "団長さん、本当においしいですね！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "특히 이 민트 초코! 알싸한 민트 맛이랑 달콤한 초코가 오묘하게 어우러진 맛… ",
      "UnitTalk_JPN": "特にこのチョコミント！甘いチョコと、爽やかなミントのハーモニー… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "흐응~ 역시 서부의 부실한 간식거리들이랑은 차원이 다르구나…?",
      "UnitTalk_JPN": "ふ～ん。やっぱり、西部のお粗末なものとは次元が違うのね…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "리디아는 행복한 표정으로 아이스크림을 입에 물고 우물거렸다. ",
      "UnitTalk_JPN": "リディアは幸せそうにアイスクリームを口に含み、もごもごと何か言っている。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장님도 한 입 드실래요? ",
      "UnitTalk_JPN": "団長さんも一口いかがですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "아, 하세요. 아~",
      "UnitTalk_JPN": "あーんしてくださいね。はい、あーん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아냐, 리디아. 많이 먹어.",
          "JumpAnchorStringId_JPN": "いや、リディアが食べていいよ。"
        }
      ]
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "어쩌면 나는 단편적인 모습만으로 리디아를 오해하고 있었던 게 아닐까?",
      "UnitTalk_JPN": "もしかしたら私は、断片的な部分だけを見て、リディアのことを誤解していたのかもしれない。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "척박한 서부 지대에서 처절한 투쟁을 이어왔던 그녀다. ",
      "UnitTalk_JPN": "荒れ果てた西部で、壮絶な戦いを続けてきたリディア。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "삶의 방식이 다소 거칠고 냉소적으로 보이는 건 지극히 당연한 일일지도 모른다. ",
      "UnitTalk_JPN": "荒々しく皮肉めいた生き方に見えるのも、致し方ないことなのかもしれない。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 여전히 그녀의 가슴 속에는 따뜻한 마음이-",
      "UnitTalk_JPN": "それでも、リディアには温かい心が──",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "으음~ 역시, 소문대로 NOA 사람들은 순진하다니까요. ",
      "UnitTalk_JPN": "う～ん。やっぱり、NOAの人ってお人好しなんですね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TRIPLE_2",
      "CameraOffsetTime": "FA",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…?!",
          "JumpAnchorStringId_JPN": "…！？"
        }
      ]
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_14.mp3",
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "겨우 이런 적당한 이야기 몇 마디로 아이스크림을 공짜로 얻다니! ",
      "UnitTalk_JPN": "ちょっと適当な話をしただけで、アイスクリームがタダで食べられるなんて！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "후후… 덕분에 활동 자금도 꽤 많이 아꼈네요. ",
      "UnitTalk_JPN": "ふふ…おかげで、活動資金をかなり節約できました。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "전부 거짓말이었어?!?!",
          "JumpAnchorStringId_JPN": "ぜんぶ嘘だったのか！？！？"
        }
      ]
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "음? 아, 전사한 동료 이야기 말인가요?",
      "UnitTalk_JPN": "はい？あぁ、戦死した仲間のことですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "흐응~ 그래도 아주 없는 말은 안 했다구요?",
      "UnitTalk_JPN": "ふ～ん。まぁ、まったくの嘘ではありませんよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "실제로 지난 방어전에서 전사한 대원이 있긴 했으니까.",
      "UnitTalk_JPN": "前回の防衛戦で、戦死した隊員は本当にいましたから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "딱히 친한 사이는 아니었지만요. 그 녀석, 단 거 싫어하지 않았나…?",
      "UnitTalk_JPN": "別に、仲がよかった訳ではないですけどね。あいつ、甘いもの嫌いだったっけ…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…고향을 탈환하겠다는 포부는?",
          "JumpAnchorStringId_JPN": "…故郷を奪還したいって気持ちは？"
        }
      ]
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "서부에서 태어났다고 전부 고향에 애착을 가져야 하는 건 아니잖아요?",
      "UnitTalk_JPN": "西部に生まれたからって、全員が故郷を愛さないといけない訳じゃないでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "솔직히 조금 바보 같다고 생각할 때도 있어요. ",
      "UnitTalk_JPN": "正直、ちょっと馬鹿みたいって思う時もあるんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "뭘 대단한 땅이라고 그렇게들 집착하는 걸까요?",
      "UnitTalk_JPN": "たかが土地に、あそこまで執着する必要があるんですかね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "망한 건 망한 거고, 새로운 곳에서 새 시작을 하면 될 텐데. ",
      "UnitTalk_JPN": "失敗は失敗なんです。新しい場所で、また新たに始めればいいものを。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그렇지 않아요? ",
      "UnitTalk_JPN": "そう思いませんか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "사람들을 행복하게 만들겠다는 꿈은!!!",
          "JumpAnchorStringId_JPN": "みんなを幸せにするって夢は！！"
        }
      ]
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "에에. 그런 걸 어떻게 다 신경 써요? ",
      "UnitTalk_JPN": "えぇ？そんなこと、いちいち構っていられませんよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "단장님은 이 세상의 불행을 전부 홀로 받아낼 셈인가요? ",
      "UnitTalk_JPN": "団長さんは、この世の不幸を一人で受け止めるつもりですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "라비스타 전체의 불쌍한 사람들을 구해주려면 몸이 10개가 있어도 부족할걸요?",
      "UnitTalk_JPN": "ラビスター中の哀れな人を救うには、身体がいくつあっても足りませんよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 77,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "남의 감정을 이용하다니…",
          "JumpAnchorStringId_JPN": "他人の感情を利用するなんて…"
        }
      ]
    },
    {
      "Uid": 78,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "휴우! 그게 그렇게 나쁜 짓인가요?",
      "UnitTalk_JPN": "ふぅ！そんなに悪いことですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그야 당연히-",
          "JumpAnchorStringId_JPN": "そりゃ、当然──"
        }
      ]
    },
    {
      "Uid": 80,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "저는 아이스크림을 공짜로 얻었고-",
      "UnitTalk_JPN": "私はアイスクリームをタダでもらって──",
      "TalkTime": 0.03
    },
    {
      "Uid": 81,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "저분은 본인이 베푼 상냥함에 만족했잖아요? ",
      "UnitTalk_JPN": "あの方は、自分の善行に満足してたじゃないですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 82,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "둘 다 원하는 걸 얻은 해피엔딩인걸요. ",
      "UnitTalk_JPN": "二人とも願うものが手に入って、ハッピーエンドって訳です。 ",
      "TalkTime": 0.03
