      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "친한 동료도 함께 왔다면 좋아했을 텐데…! ",
      "UnitTalk_JPN": "仲良しの仲間も連れてこれたらよかったのになぁ…！ ",
      "TalkTime": 0.03
    },
    {
