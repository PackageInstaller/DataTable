      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_ROD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "간식거리를 정말 좋아하던 친구거든요.",
      "UnitTalk_JPN": "甘いものが大好きな子なんです。",
      "TalkTime": 0.03
    },
