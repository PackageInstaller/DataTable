    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "발신인 불명의 소포?",
      "UnitTalk_JPN": "差出人不明の小包？",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "흥, 난 그런 귀찮은 장난친 적 없어. 리스 가문의 후손을 뭐라고 생각하는 거야?",
      "UnitTalk_JPN": "ふん、私がそんな面倒なイタズラする訳ないでしょ。リース家の後継者を何だと思ってるの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "보나 마나 사은품 같은 걸 받기로 해 놓고 잊어 버린 거겠지.",
      "UnitTalk_JPN": "どうせ、プレゼントをもらう約束を忘れてただけに決まってる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "…응? 아무리 생각해도 모르겠다고?",
      "UnitTalk_JPN": "…えっ？いくら考えても分からないの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "하아, 잠깐 이리 줘 봐.",
      "UnitTalk_JPN": "はぁ、ちょっと貸してみなさい。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": false,
      "WaitTime": 2.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_CLOTH_92.wav",
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "THINK"
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "흐응… 그럼 이건 아무래도 <color=#F7BE45>[부적]</color>인 모양이네.",
      "UnitTalk_JPN": "ふーん…これはどうやら、<color=#F7BE45>「<r=チャーム>呪物</r>」</color>みたいね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "어떤 물건인지 모르는 눈치니까, 이번 한 번만 내가 몸소 설명해 줄게.",
      "UnitTalk_JPN": "何か分かってないみたいだから、今回だけ特別に説明してあげる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "<color=#F7BE45>[부적]</color>은 과거 <color=#F7BE45>[별의 구원자]</color>와 관련 있다고 전해지는 물건들이야.",
      "UnitTalk_JPN": "<color=#F7BE45>「<r=チャーム>呪物</r>」</color>は、かつて<color=#F7BE45>「星の救援者」</color>に縁があった物だって伝えられてるの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "<color=#F7BE45>[별의 구원자]</color>가 가지고 다녔거나, 스쳐 지나갔거나, 인연 있는 자들의 후손이 만들었다고 알려진 것들이지.",
      "UnitTalk_JPN": "<color=#F7BE45>「星の救援者」</color>が持ち歩いてた物だとか、傍を通り過ぎた物だとか、縁ある人の子孫が作った物だとか言われてるわ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_04_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "물론 평소에는 특별할 것 없는 잡동사니에 불과해.",
      "UnitTalk_JPN": "もちろん、普段はただのガラクタに過ぎないけどね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
