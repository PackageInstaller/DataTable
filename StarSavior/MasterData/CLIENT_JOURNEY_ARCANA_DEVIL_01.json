    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "DRAMA_ACTIVATE_ARCANA_2.prefab",
      "StartBgmFileName": "MUSIC_CUTSCENE_06.mp3"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": false,
      "WaitTime": 2.5
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "오셨군요, 기다리고 있었습니다.",
      "UnitTalk_JPN": "おいでになりましたか。お待ちしておりましたよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "…아닙니다. 그렇게 오래 기다리지는 않았습니다.",
      "UnitTalk_JPN": "…いえ、それほど長くは待っていません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "재촉하는 걸로 느껴졌다면 사과드리죠. 죄송합니다.",
      "UnitTalk_JPN": "急かしているように感じたのなら謝罪します。申し訳ありません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "솔직히, 근래에 당신과 만나는 일이 가장 기대됩니다. 전날부터 설렌답니다.",
      "UnitTalk_JPN": "正直、近頃はあなたにお会いするのが一番の楽しみです。前日から胸が高鳴るのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "믿기십니까?",
      "UnitTalk_JPN": "信じられますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이곳에 의자가 있기 전부터, 아니 사람이 살기 전부터, 아니… 좀 더 거슬러 올라가면…",
      "UnitTalk_JPN": "ここに椅子が置かれる前から、いえ、人が住む以前から、いや…もう少し遡れば…",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그래.",
      "UnitTalk_JPN": "そう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "인간이 탄생하기 전부터 살아온 제게 이런 감정이 남아있을 줄은 저조차 몰랐습니다.",
      "UnitTalk_JPN": "人間が誕生する前から生きてきた私に、このような感情が残っているとは思いませんでした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "한순간의 변덕이 이토록 즐거운 유열이 될 줄이야…",
      "UnitTalk_JPN": "一瞬の気まぐれが、これほど楽しい愉悦になるとは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이 자리를 빌려 말씀드리겠습니다. 진심으로 감사드립니다.",
      "UnitTalk_JPN": "この場を借りて申し上げます。心から感謝いたします。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "자, 그럼 계약을 갱신해볼까요?",
      "UnitTalk_JPN": "さあ、それでは契約を更新しましょうか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "말씀해 주시죠. 이전에 당신이 겪은 여정을, 앞으로의 계획을.",
      "UnitTalk_JPN": "お聞かせください。これまであなたが経験した旅を、そして今後の計画を。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "합당한 대가를, 저 역시 지불하겠습니다. 이것이 우리가 맺은 계약이니까요.",
      "UnitTalk_JPN": "然るべき代償を、私も払わせていただきますよ。これは私たちが結んだ契約ですから。",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_DEVIL_01",
      "WaitClick": false,
      "WaitTime": 0.7,
