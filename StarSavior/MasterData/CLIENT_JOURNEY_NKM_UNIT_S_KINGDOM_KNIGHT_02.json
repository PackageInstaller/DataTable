    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "그, 그렇다면… 한 말씀 올리겠습니다!",
      "UnitTalk_JPN": "そ、そうであれば…一言申し上げます！",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "괜찮으시다면, 좀 더 강한 훈련을 부탁드립니다!",
      "UnitTalk_JPN": "よろしければ、もっと厳しくご指導ください！",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "TalkTime": 0.03,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "지금 하는 것도 쉬운 건 아닌데.",
          "JumpAnchorStringId_JPN": "今やってる内容も、そう簡単な内容ではないはずだけど"
        }
      ]
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그렇…죠? 헤헤…",
      "UnitTalk_JPN": "そ…そうですよね？あはは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그러고 보니, 아침부터 오후까지 이어진 훈련인 데도 샤를은 땀 한 방울 흘리지 않고 있다.",
      "UnitTalk_JPN": "そういえば、朝から午後まで続いた訓練にも関わらず、シャルルは汗一つかかずにいた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "으음, 과연 기사단장인가.",
      "UnitTalk_JPN": "ふむ、さすがは騎士団長さまか。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아, 절대 단장님의 지도가 잘못되었다는 건 아니구요!",
      "UnitTalk_JPN": "いえ、決して団長殿のご指導が間違っているというわけではなくてですね！",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "지치지 않고 훈련이 끝나면 아쉽다고나 할까!",
      "UnitTalk_JPN": "訓練が終わっても、クタクタにならないのは惜しいというか！",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "후들후들 떨리는 다리로 집에 들어가 침대에 눕는 순간이 최고라고나 할까!",
      "UnitTalk_JPN": "足がふらふらしながら、帰宅してベッドに横になった瞬間が最高というか！",
