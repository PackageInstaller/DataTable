      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "TalkTime": 0.03,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나도 그만큼 더 고생을 해야 한다는 걸…!",
          "JumpAnchorStringId_JPN": "その分、団長の仕事も増えるを意味する…！"
