    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_KNIGHT_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "TalkTime": 0.03,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "괜찮으니까 말해봐.",
          "JumpAnchorStringId_JPN": "大丈夫だから言ってみて"
