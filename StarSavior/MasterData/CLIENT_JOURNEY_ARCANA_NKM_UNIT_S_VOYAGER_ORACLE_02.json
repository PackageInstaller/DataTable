      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "잠-까-안-!",
      "UnitTalk_JPN": "ちょーっとー！",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_ORACLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…사람이 웃으면서 말을 하니까 같잖아 보이나 본데…",
      "UnitTalk_JPN": "…ニコニコしてたから、舐められたのかもしれないけどさ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_ORACLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "아까도 말했지?",
      "UnitTalk_JPN": "さっきも言ったでしょ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_VOYAGER_ORACLE_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "어중이떠중이들과 똑같이 취급하지 말라고…!",
