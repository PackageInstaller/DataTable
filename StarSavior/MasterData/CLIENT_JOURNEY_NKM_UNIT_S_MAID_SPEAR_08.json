      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "정작 중요한 걸 너무 많이 잊고 있었던 느낌입니다.",
