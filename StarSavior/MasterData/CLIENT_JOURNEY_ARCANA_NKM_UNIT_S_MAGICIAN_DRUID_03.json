      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "SERIOUS",
      "UnitPos": "POS8",
      "UnitTalk_KOR": "다나~ 이만큼 팠으면 됐지?",
      "UnitTalk_JPN": "ダーナ、これぐらい掘れば十分だよね？",
      "UnitTalk_TWN": "達娜～挖到這種程度就可以了吧？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "으음~ 조금 아쉬운데…",
      "UnitTalk_JPN": "うーん、ちょっと浅いかも…",
      "UnitTalk_TWN": "嗯～有點可惜呢…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_1.ogg"
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 조금만 더 파자.",
      "UnitTalk_JPN": "あはは！もう少しだけ掘ろう！",
      "UnitTalk_TWN": "啊哈哈！再多挖一點吧。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_2.ogg"
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "UnitTalk_TWN": "…",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "…어, 어라?",
      "UnitTalk_JPN": "…あ、あれ？",
      "UnitTalk_TWN": "…咦，怎麼了？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_3.ogg"
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "웃고 있는 표정이 무서운데, 클라리사…?",
      "UnitTalk_JPN": "クラリッサ…？笑ってるけど、何だか怖いよ…？",
      "UnitTalk_TWN": "你笑得好可怕喔，克拉麗莎…？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_4.ogg"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "때려칠래.",
      "UnitTalk_JPN": "やーめた。",
      "UnitTalk_TWN": "我要放棄了。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "안 돼!",
      "UnitTalk_JPN": "ダメッ！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_5.ogg"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "여기서 포기하면 지금까지의 노력이 아깝잖아.",
      "UnitTalk_JPN": "諦めちゃったら、今までの努力がもったいないよ。",
      "UnitTalk_TWN": "現在放棄的話，之前的努力不就白費了嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_6.ogg"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "조금만 힘내자, 응?",
      "UnitTalk_JPN": "もう少しだけ頑張ろう、ね？",
      "UnitTalk_TWN": "再撐一下吧，好嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_7.ogg"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "마법이랑 화약을 두고 왜 맨손으로 땅을 파야 되는 거야.",
      "UnitTalk_JPN": "なんで魔法とか火薬とか使わないで、素手で穴掘らないといけないのー？",
      "UnitTalk_TWN": "為什麼明明就有魔法和火藥，卻要徒手挖土啊。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "나무 심기는 나랑 안 맞아. 그만 할래.",
      "UnitTalk_JPN": "木を植えるなんて性に合わないもん。やーめた。",
      "UnitTalk_TWN": "種樹跟我不合，我不想繼續了。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_TOUCH",
      "UnitTalk_KOR": "안돼, 마법이랑 화약은 드루이드의 전통에서 어긋나.",
      "UnitTalk_JPN": "魔法と火薬は、ドルイドの伝統に反するの。",
      "UnitTalk_TWN": "不行，使用魔法和火藥違背了德魯伊的傳統。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_8.ogg"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>타파파</color>는 처음부터 끝까지 자기 힘으로 심지 않으면 안돼.",
      "UnitTalk_JPN": "<color=#F7BE45>タパパ</color>は、最初から最後まで自分の力で植えないとダメなんだよ。",
      "UnitTalk_TWN": "<color=#F7BE45>塔帕帕</color>從頭到尾都必須用自己的力量種植才行。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_9.ogg"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "후우…",
      "UnitTalk_JPN": "ふぅ…",
      "UnitTalk_TWN": "呼…",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "CameraOffset": "ONE_8",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "애초에 <color=#F7BE45>타파파</color>가 뭐야?",
      "UnitTalk_JPN": "そもそも、<color=#F7BE45>タパパ</color>って何なの？",
      "UnitTalk_TWN": "話說回來，<color=#F7BE45>塔帕帕</color>到底是什麼啊？",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "중요한 일이라고 해서 따라왔더니 왜 나무를 심고 있는 건데?",
      "UnitTalk_JPN": "大事なことだって聞いて来てみたら、なぜか木を植えようとしてるんだもん。",
      "UnitTalk_TWN": "你說有重要的事我才跟來的，結果為什麼在種樹啊？",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "클라리사 학생은 진도를 못 따라가겠는데요, 다나 선생님~",
      "UnitTalk_JPN": "ダーナせんせー、クラリッサちゃんは授業についていけませーん。",
      "UnitTalk_TWN": "克拉麗莎同學跟不上進度了，達娜老師～",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "ONE_7",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 드루이드들은 특별한 날에 나무를 심어.",
      "UnitTalk_JPN": "あはは！ドルイドは、特別な日に木を植えるんだよ。",
      "UnitTalk_TWN": "啊哈哈！德魯伊們會在特別的日子種下一棵樹。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_10.ogg"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>타파파</color>가 바로 그 나무야.",
      "UnitTalk_JPN": "<color=#F7BE45>タパパ</color>はズバリ、その木のことなの。",
      "UnitTalk_TWN": "<color=#F7BE45>塔帕帕</color>就是那棵樹。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_11.ogg"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "삶의 중요한 순간을 함께 나눈다는 의미에서 반려동물… 아니, 반려식물에 가깝지.",
      "UnitTalk_JPN": "人生の大事な瞬間を分かち合うっていう点では、ペットに近いと思うんだ。",
      "UnitTalk_TWN": "它的意義是分享生命中重要的時刻，近似於寵物…不，應該說是陪伴植物。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_12.ogg"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "USN_UI_TOUCH",
      "UnitTalk_KOR": "기쁠 일, 슬픈 일이 있을 때 찾아가서 이야기를 나누거나…",
      "UnitTalk_JPN": "嬉しいこと、悲しいことがあったらお話をしたり…",
      "UnitTalk_TWN": "有開心的事、難過的事時都可以去找它聊天…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_13.ogg"
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "해마다 서로 얼마나 성장했는지 키를 재보기도 하지.",
      "UnitTalk_JPN": "毎年どれくらい成長したか、背比べをしたりするんだ。",
      "UnitTalk_TWN": "每年還能比較彼此成長了多少，量量身高。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_14.ogg"
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그래서 클라리사와 함께 <color=#F7BE45>타파파</color>를 심고 싶었어. 드루이드의 전통을 알려주고 싶었거든!",
      "UnitTalk_JPN": "だから、クラリッサと一緒に<color=#F7BE45>タパパ</color>を植えたかったの。ドルイドの伝統を教えてあげたくて！",
      "UnitTalk_TWN": "所以我想和克拉麗莎一起種下<color=#F7BE45>塔帕帕</color>。我想告訴你德魯伊的傳統！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_03_DRUID_15.ogg"
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "나한테? 왜?",
      "UnitTalk_JPN": "あたしに？どうして？",
      "UnitTalk_TWN": "告訴我？為什麼？",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "응! 친구잖아.",
      "UnitTalk_JPN": "だって、友だちでしょう？",
      "UnitTalk_TWN": "對啊！因為我們是朋友啊。",
