    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "내가 만든 거짓말 탐지기, <color=#F7BE45>스마일 66호.</color>",
      "UnitTalk_JPN": "私が作ったウソ発見器、<color=#F7BE45>スマイル66号</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "혈압, 맥박, 뇌파를 감지. 상대가 진실을 말하는지 확인 가능.",
      "UnitTalk_JPN": "血圧、脈拍、脳波を感知。相手が本当のことを言っているのか確認可能。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "유사시에는 방범 부저, 호신용 무기로도 활용 가능.",
      "UnitTalk_JPN": "何かあった時には、防犯ブザー、護身用の武器としても活用可能。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "TWIN_1",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "본인이 26번째로 자랑스러워하는 발명품.",
      "UnitTalk_JPN": "私が26番目に誇る発明品。",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "...시작부터 거짓말 탐지기를 들이대다니.",
      "UnitTalk_JPN": "…初対面なのにウソ発見器を渡すなんて。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 62,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아무래도 평범한 단원은 아닐 것 같다. 정신 바짝 차려야지.",
      "UnitTalk_JPN": "どう考えても、普通の団員じゃなさそうだ。しっかりしないと。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 63,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "...이렇게 착용하면 되는 건가?",
          "JumpAnchorStringId_JPN": "…こうやってつければいいのかな？"
        }
      ]
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "올바른 착용 확인.",
      "UnitTalk_JPN": "正しい着用を確認。",
      "TalkTime": 0.03
    },
    {
      "Uid": 64,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "첫 번째 질문. 당신이 내 여정을 담당할 단장?",
      "UnitTalk_JPN": "一つ目の質問。君が救援の旅を担当する団長？",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "맞아. 내가 단장이야.",
          "JumpAnchorStringId_JPN": "うん。私が団長だよ。"
        }
      ]
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "혈압, 정상. 맥박, 정상.",
      "UnitTalk_JPN": "血圧、正常。脈拍、正常。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "스마일 66호 결과 추론 완료.",
      "UnitTalk_JPN": "スマイル66号、推測完了。",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "진실.",
      "UnitTalk_JPN": "真実。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "훌륭함. 다음 질문.",
      "UnitTalk_JPN": "素晴らしい。次の質問。",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "날 찾고 있었어?",
      "UnitTalk_JPN": "私を探してた？",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "...그런 것 같아.",
          "JumpAnchorStringId_JPN": "…そうだと思う。"
        }
      ]
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "…결과. 진실.",
      "UnitTalk_JPN": "…結果。真実。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "캔들 스퀘어에서 들은 정보와 대상의 외형 일치 확인.",
