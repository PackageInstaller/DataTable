      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "3회차에 걸친 테스트 통과 완료.",
      "UnitTalk_JPN": "3点に及ぶテストを通過。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "결론, 진짜 단장이 맞음.",
      "UnitTalk_JPN": "結論、本当に団長で合ってる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "반가워. ",
      "UnitTalk_JPN": "会えて嬉しい。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "다시 한번 인사하며 대상과 관계성을 쌓는데 성공.",
