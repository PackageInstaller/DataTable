      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "...확인이 철저하네.",
          "JumpAnchorStringId_JPN": "…徹底的に確認するんだね。"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "조금 귀찮을 것 같지만.",
          "JumpAnchorStringId_JPN": "ちょっとめんどくさそうだけど。"
        }
      ]
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": false,
      "WaitTime": 0.6,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "긍정. ",
      "UnitTalk_JPN": "肯定。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 70,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "진실 확인 절차는 과도한 연산 프로세스를 요구.",
      "UnitTalk_JPN": "真実の確認過程では、過度な演算プロセスを要求。",
      "TalkTime": 0.03
    },
    {
      "Uid": 71,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "하지만 인간 세상에서 살아남기 위해서는 필수적인 절차.",
      "UnitTalk_JPN": "でも、人間の世界で生き残るためには必須の過程。",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그 정도로 하지 않아도 살아남는 건 문제없지 않을까?",
          "JumpAnchorStringId_JPN": "そこまでしなくても、生き残るのには問題ないんじゃないかな？"
        }
      ]
    },
    {
      "Uid": 73,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "인간들 사이의 대화에서는 해당 명제가 유효.",
      "UnitTalk_JPN": "人間同士の会話では、肯定命題が有効。",
      "TalkTime": 0.03
    },
    {
      "Uid": 74,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "하지만 나는…",
      "UnitTalk_JPN": "でも、私は…",
      "TalkTime": 0.03
    },
    {
      "Uid": 75,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나는?",
          "JumpAnchorStringId_JPN": "うん？"
        }
      ]
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_SMILE_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "ONE_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "인간이 아니니까.",
      "UnitTalk_JPN": "人間じゃないから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…이건 또 무슨 소리야?",
          "JumpAnchorStringId_JPN": "…どういう意味？"
        }
      ]
    },
    {
      "Uid": 77,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "나는 인간이 아닌 인간을 본떠 만들어진 유기분자 기반 인공생명체.",
      "UnitTalk_JPN": "私は人間じゃなく、人間そっくりに作られた有機分子基盤の人工生命体。",
      "TalkTime": 0.03
    },
    {
      "Uid": 78,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "<color=#F7BE45>호문쿨루스</color>.",
      "UnitTalk_JPN": "<color=#F7BE45>ホムンクルス</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "인간의 감정을 파악하고 진실과 거짓을 가리는 데 능숙하지 않음.",
      "UnitTalk_JPN": "人間の感情を把握して、真実と嘘を見分けるのは得意じゃない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 80,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
