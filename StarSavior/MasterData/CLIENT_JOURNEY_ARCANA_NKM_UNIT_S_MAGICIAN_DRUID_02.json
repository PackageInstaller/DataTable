    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "다나의 개인 농장에 오신 것을 환영합니다!",
      "UnitTalk_JPN": "ダーナの農場へようこそ！",
      "UnitTalk_TWN": "歡迎來到達娜的私人農場！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_5.ogg"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.5,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": " 와아~!",
      "UnitTalk_JPN": "わああ～！",
      "UnitTalk_TWN": " 哇～！",
      "TalkTime": 0.03,
      "TalkAppend": true,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_6.ogg"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아하하! 꼭 해보고 싶은 말이었어요.",
      "UnitTalk_JPN": "あはは！一度は言ってみたかったんです。",
      "UnitTalk_TWN": "啊哈哈！我一直很想說這句話。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_7.ogg"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "이곳에 저 말고 다른 사람이 방문한 건 단장님이 처음이거든요.",
      "UnitTalk_JPN": "ここに、わたし以外の人が入るのは初めてなんですよ？",
      "UnitTalk_TWN": "除了我以外，團長是第一個參觀這裡的人呢。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_8.ogg"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "혼자 농장을 만들었어?",
          "JumpAnchorStringId_JPN": "一人で農場を作ったのか？",
          "JumpAnchorStringId_TWN": "這是你是自己建造的農場嗎？"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "네! 제가 만들었어요.",
      "UnitTalk_JPN": "はい！わたしが作りました。",
      "UnitTalk_TWN": "對！是我蓋的。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_9.ogg"
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "도시의 농작물은 맛있지만 아쉬운 점이 하나 있거든요.",
      "UnitTalk_JPN": "都会の農作物もおいしいですが、ひとつ残念な点があって…",
      "UnitTalk_TWN": "城市的農作物雖然好吃，但有一點美中不足。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_10.ogg"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "채소는 땀을 흘려 수확해서 바로 먹는 게 제일 맛있다는 사실!",
      "UnitTalk_JPN": "野菜は汗を流して、収穫したてを食べるのが一番なんです！",
      "UnitTalk_TWN": "蔬菜還是要在流汗收成後馬上吃掉才最美味！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_11.ogg"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "아니면 <color=#F7BE45>팜팜</color>도 좋아요. 신선함이 오래 가거든요.",
      "UnitTalk_JPN": "もしくは、<color=#F7BE45>パムパム</color>でもいいですよ。鮮度が長持ちしますから。",
      "UnitTalk_TWN": "或者是做成<color=#F7BE45>帕姆帕姆</color>也很棒，因為能保持新鮮狀態很久。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_12.ogg"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>팜팜</color>?",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>パムパム</color>？",
          "JumpAnchorStringId_TWN": "<color=#F7BE45>帕姆帕姆</color>？"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "USN_UI_TOUCH",
      "UnitTalk_KOR": "참, 드루이드의 전통 요리라고 설명하는 걸 깜빡했네요. 나중에 대접해드릴게요.",
      "UnitTalk_JPN": "あっ、ドルイドの伝統料理のことです。後でごちそうしますね。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_13.ogg"
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "어라? 그런데 잡초가 많네요.",
      "UnitTalk_JPN": "あれ？知らない間に、雑草が…",
      "UnitTalk_TWN": "咦？不過這裡雜草真多呢。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_14.ogg"
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SAD",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "으음~ 관리가 소홀했나 봐요.",
      "UnitTalk_JPN": "うーん、管理が行き届いていなかったようです。",
      "UnitTalk_TWN": "嗯～有點疏於管理了。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_15.ogg"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "잠시만 기다려 주시겠어요? 금방 작업하고 올게요.",
      "UnitTalk_JPN": "少しだけお待ちいただけますか？すぐに抜いてきますから。",
      "UnitTalk_TWN": "能請您稍等一下嗎？我馬上去處理。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_16.ogg"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "…풀 뽑는 걸 도와주시겠다고요?",
      "UnitTalk_JPN": "…草むしりを手伝ってくださるのですか？",
      "UnitTalk_TWN": "…您是說要幫忙拔草嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_17.ogg"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "아뇨, 아뇨, 아뇨! 괜찮아요.",
      "UnitTalk_JPN": "ううん！大丈夫です。",
      "UnitTalk_TWN": "不不不！沒關係的。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_18.ogg"
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "손님에게 일을 시킬 수는 없죠.",
      "UnitTalk_JPN": "お客様を働かせるわけにはいきません。",
      "UnitTalk_TWN": "我不能讓客人做事。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_19.ogg"
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "땀을 흘려 수확한 채소가 맛있다고 했지?",
          "JumpAnchorStringId_JPN": "汗を流して収穫した野菜こそ、おいしいんでしょ？",
          "JumpAnchorStringId_TWN": "你不是說流汗收成的蔬菜最美味嗎？"
        }
      ]
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SAD",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "그건, 그렇지만…",
      "UnitTalk_JPN": "それはそうですけど…",
      "UnitTalk_TWN": "雖然是這樣沒錯，但是…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_20.ogg"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 어쩔 수 없네요.",
      "UnitTalk_JPN": "あはは！仕方ありませんね。",
      "UnitTalk_TWN": "啊哈哈！沒辦法了。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_21.ogg"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "그렇다면 단장님의 <color=#F7BE45>로로카</color>, 감사히 받아들이겠습니다!",
      "UnitTalk_JPN": "それなら団長の<color=#F7BE45>ロロカ</color>、ありがたく受け取りますね！",
      "UnitTalk_TWN": "那我就感謝接受團長的<color=#F7BE45>洛洛卡</color>了！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_22.ogg"
    },
