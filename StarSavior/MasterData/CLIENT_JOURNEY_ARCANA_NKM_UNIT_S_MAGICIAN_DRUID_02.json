      "UnitTalk_TWN": "咦？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_1.ogg"
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "단장님이시네요. 이곳에는 어쩐 일이세요?",
      "UnitTalk_JPN": "団長！こんなところでお会いするなんて、奇遇ですね。",
      "UnitTalk_TWN": "是團長呢。您怎麼會在這裡？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_2.ogg"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "USN_UI_TOUCH",
      "UnitTalk_KOR": "아하하! 마침 잘 됐다!",
      "UnitTalk_JPN": "あはは！ちょうど良かったです！",
      "UnitTalk_TWN": "啊哈哈！太巧了！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_3.ogg"
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "괜찮으시다면 저랑 같이 가시겠어요?",
      "UnitTalk_JPN": "よければ、わたしについて来てくださいますか？",
      "UnitTalk_TWN": "如果您不介意的話，願意跟我一起去嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_ARCANA_02_DRUID_4.ogg"
    },
