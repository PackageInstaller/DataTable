      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…크게 다친 줄 알고 놀랐잖아.",
          "JumpAnchorStringId_JPN": "…大怪我したのかと思ってビックリしたよ。"
        }
      ]
