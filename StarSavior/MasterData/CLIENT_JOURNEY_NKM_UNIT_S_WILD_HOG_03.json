    },
    {
      "Uid": 3,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "할리가 오기를 기다리면서 게시판에 붙은 의뢰서들을 살펴보는 중이었다.",
      "UnitTalk_JPN": "ハーレーが来るのを待ちながら、掲示板に張られた依頼書を見ていたが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.4,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_POP.wav",
      "UnitTalk_KOR": "갑자기 굉음과 함께 건물이 흔들렸다.",
      "UnitTalk_JPN": "突然、轟音が鳴り響くと同時に建物が揺れた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "실내 공사라도 하는 중이야?",
          "JumpAnchorStringId_JPN": "館内で工事でもしてるの？"
        }
      ]
    },
    {
      "Uid": 6,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아뇨. 제가 파악하고 있는 한, 캔들 스퀘어에 보수 내지 증축 일정은 없습니다.",
      "UnitTalk_JPN": "いえ。私が知る限り、キャンドル・スクエアで補修や増築の予定はありませんが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "소리는… 밖에서 들리는 것 같군요.",
      "UnitTalk_JPN": "音は…外から鳴っているようです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "무슨 일인지 확인해 보고 오겠습니다. 잠시만 기다려 주시길.",
      "UnitTalk_JPN": "私が確認してまいりますので、少々お待ちくださいね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "같이 가자.",
          "JumpAnchorStringId_JPN": "一緒に行こう。"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "사람이 필요할지도 모르니까.",
          "JumpAnchorStringId_JPN": "人手が必要かもしれないしね。"
        }
      ]
    },
    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "캔들 스퀘어에는 평소에도 신세를 지고 있다.",
      "UnitTalk_JPN": "キャンドル・スクエアには、いつもお世話になっている。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "도울 수 있는 일이라면 성심껏 돕는 편이 좋을 것이다.",
      "UnitTalk_JPN": "私にできることなら、快く手助けしてあげる方がいいだろう。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "좋습니다. 그럼 함께 가시죠.",
      "UnitTalk_JPN": "良いでしょう。それでは、行きましょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "WaitClick": false,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_CHIME_BELL.wav",
      "TransitionEffect": "WIPE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 14,
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_CANDLE_GROUND.png",
      "CutsceneClear": "CLEARUNIT"
    },
    {
      "Uid": 15,
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "WIPE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "소음의 원인은 가까운 곳에 있었다.",
      "UnitTalk_JPN": "騒音の原因は、近いところにあった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "오, 단장! 기다리고 있었어?",
      "UnitTalk_JPN": "おっ、団長！待ってたのか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "이리 와 봐! 단장이랑 만나고 싶어 하는 녀석이 있거든!",
      "UnitTalk_JPN": "こっちに来てみろよぉ！団長に会わせたい奴がいんだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "할리 옆에는 커다란 멧돼지…",
      "UnitTalk_JPN": "ハーレーの隣には、巨大なイノシシ…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 20,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_HOG_GRUNT_2.wav",
      "UnitTalk_KOR": "그러니까 바이크 호그가 거친 숨을 몰아쉬고 있었다.",
      "UnitTalk_JPN": "えっと、バイクホッグが息を切らしていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "웬 바이크 호그야?",
          "JumpAnchorStringId_JPN": "なんでバイクホッグなの？"
        }
      ]
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "지난번에 단장이 그랬잖아. 친구 쪽이 더 좋다고.",
      "UnitTalk_JPN": "この前、団長が言っただろ？ダチの方がいいって。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitTalk_KOR": "하지만 그러려면 우선 사나이가 되어야지.",
      "UnitTalk_JPN": "そのためには、まずは漢にならねぇとな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "그러니까 바이크 호그다.",
      "UnitTalk_JPN": "だからバイクホッグだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "갑자기 논리가 사라져 버렸다.",
      "UnitTalk_JPN": "話の流れが読めない。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "바이크 호그랑 사나이…",
          "JumpAnchorStringId_JPN": "バイクホッグと、漢…"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "둘 사이에 어떤 상관관계가?",
          "JumpAnchorStringId_JPN": "この二つには、どんな関係があるの？"
        }
      ]
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_13.mp3",
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "푸하하하!",
      "UnitTalk_JPN": "ぷはははっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "재밌는 농담이었어. 사나이가 달리는 데 바이크 호그 말고 다른 선택지가 있을 리 없잖아.",
      "UnitTalk_JPN": "おもしれぇ冗談だな！漢が走るのに、バイクホッグ以外の選択肢はねぇってのに。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "부정할 수 없군요.",
      "UnitTalk_JPN": "否定できませんね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "클레어?!",
          "JumpAnchorStringId_JPN": "クレア！？"
        }
      ]
    },
    {
      "Uid": 31,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "저 말을 납득하는 거야?",
          "JumpAnchorStringId_JPN": "同じ意見なの！？"
        }
      ]
    },
    {
      "Uid": 32,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "물론입니다, 단장님.",
      "UnitTalk_JPN": "もちろんです、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "주인과 호그 사이의 굳건한 유대, 거친 진동을 이겨내고 질주하는 도전 정신.",
      "UnitTalk_JPN": "主とホッグの固い絆…そして激しい揺れに打ち勝ち、走り抜くチャレンジ精神…",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "바이크 호그는 사나이입니다.",
      "UnitTalk_JPN": "バイクホッグとは、漢です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "뭐야, 메이드면서 꽤 잘 알고 있잖아.",
      "UnitTalk_JPN": "お？メイドなのに詳しいんだな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitTalk_KOR": "혹시 폭주단 출신이야?",
      "UnitTalk_JPN": "もしかして、暴走族出身か？",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.2,
      "BgCrashTime": 0.2,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아뇨! 절대로! 그럴 리가요!",
      "UnitTalk_JPN": "いえ！絶対に！そんな訳ありませんから！",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…크흠, 여정 단원이 라이더로 활동하셨다는 소식을 듣고 공부해 뒀을 뿐입니다.",
      "UnitTalk_JPN": "…コホン。旅の団員がライダーとして活動されていたという話を聞き、勉強しておいただけです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "흐음, 그래?",
      "UnitTalk_JPN": "ほぉ、そうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "WaitClick": false,
      "WaitTime": -1.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "NORMAL",
      "UnitPos": "POS4"
    },
    {
      "Uid": 41,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "뭐, 아무튼. 메이드가 말한 대로야, 단장.",
      "UnitTalk_JPN": "ま、とにかく。メイドの言う通りだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitTalk_KOR": "진정한 사나이만이 우리 헬 세이비어의 친구가 될 수 있지.",
      "UnitTalk_JPN": "真の漢だけが、ヘルセイヴァーのダチになれんだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitTalk_KOR": "다시 말해 나랑 진심으로 친구가 되기로 각오했다면,",
      "UnitTalk_JPN": "改めて、俺と真のダチになる覚悟ができたなら…",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "SPECIAL",
      "UnitPos": "POS3",
      "UnitTalk_KOR": "적어도 어깨를 나란히 하고 달릴 정도는 돼야 해.",
      "UnitTalk_JPN": "少なくとも、肩を並べて走れるぐらいにはならねぇとな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "과격한 논리에 혼란스러웠지만… ",
      "UnitTalk_JPN": "論理が飛躍してて、理解が追いつかなかったけど… ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 46,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "바이크 호그를 몬다는 건 폭주단의 통과 의례인 모양이다.",
      "UnitTalk_JPN": "バイクホッグに乗るのが、暴走族の通過儀礼のようなものらしい。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 47,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래서 단장을 위해 이 녀석을 특별히 찾아 왔어.",
      "UnitTalk_JPN": "だから、団長のためにコイツを特別に用意したんだぞ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitTalk_KOR": "자, 인사해.",
      "UnitTalk_JPN": "さぁ、挨拶しろよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "잘 부탁해…?",
          "JumpAnchorStringId_JPN": "よろしくね…？"
        }
      ]
    },
    {
      "Uid": 50,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_HOG_GRUNT_1.wav",
      "UnitNameString": [
        "SI_BIKEHOG"
      ],
      "UnitTalk_KOR": "크르릉…!",
      "UnitTalk_JPN": "グルルル…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "오오, 되게 좋아하네. 단장이랑 죽이 잘 맞을 것 같더라니.",
      "UnitTalk_JPN": "おっ、喜んでんなぁ。団長と相性が合いそうだと思ってたんだよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "돼지가 아니라 맹수 아냐?",
          "JumpAnchorStringId_JPN": "イノシシじゃなくて、猛獣じゃないの？"
        }
      ]
    },
    {
      "Uid": 53,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "울음소리가 전혀 다른데?",
          "JumpAnchorStringId_JPN": "鳴き声が全然違うけど。"
        }
      ]
    },
    {
      "Uid": 54,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그렇지. 그게 바로 <color=#F7BE45>카바노치</color>의 매력이야.",
      "UnitTalk_JPN": "そうだ。これこそがまさに<color=#F7BE45>カバノス</color>の魅力だからな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitTalk_KOR": "어때, 듣기만 해도 가슴 떨리는 배기음이? 죽여 주지?",
      "UnitTalk_JPN": "どうだ、排気音を聞いてるだけで胸が高ぶるだろ？たまんねぇよな？",
      "TalkTime": 0.03
    },
    {
