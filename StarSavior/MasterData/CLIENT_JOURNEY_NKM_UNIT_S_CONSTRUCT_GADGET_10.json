      "AutoHighlight": "OFF"
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그녀의 앞에는 더욱 많은 고난과 어려움이 기다리고 있을 것이다.",
      "UnitTalk_JPN": "彼女には、更なる苦悩と困難が待ち受けているはずだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
