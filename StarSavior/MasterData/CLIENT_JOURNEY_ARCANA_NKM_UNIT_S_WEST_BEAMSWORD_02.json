      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_BEAMSWORD_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_SAD_MERCHANT"
      ],
      "UnitTalk_KOR": "이런 건 비옷으로도 쓸 수 없다고 했어요!",
      "UnitTalk_JPN": "こんなもの…レインコートとしても使えないと言われたんですよ！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
