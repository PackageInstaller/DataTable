        }
      ]
    },
    {
      "Uid": 41,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "생각보다 더 민감한 부위인가 보네.",
          "JumpAnchorStringId_JPN": "思ったより敏感なところだったんだな。"
        }
      ]
    },
    {
      "Uid": 42,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "크흠! 노, 놀라다니!",
      "UnitTalk_JPN": "こほん！び、びっくりなどしていない！",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "꼬… 꼬리를 건드린다고 호들갑 떠는 건 해츨링들이나 하는 짓이지.",
      "UnitTalk_JPN": "シ…シッポを触られたくらいで大騒ぎするのは、孵化したてのやつらがやることなのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitTalk_KOR": "이 몸은 성숙하니까… 아무렇지 않은 것이다!",
      "UnitTalk_JPN": "わがはいは成熟している…だから、何ともないのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그래…?",
          "JumpAnchorStringId_JPN": "そう…？"
        }
      ]
    },
    {
      "Uid": 46,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitMotion": "SAD",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "……!?",
      "UnitTalk_JPN": "……！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "꼬리 끝에 달린 리본을 잡아당기자, 스칼렛의 맨어깨가 흠칫 떨린다.",
      "UnitTalk_JPN": "尻尾の先についたリボンを引っ張ると、スカーレットの肩がぴくっと震える。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 48,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "흐하, 하하하하…!",
      "UnitTalk_JPN": "ふ、ふははははは…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitTalk_KOR": "이제 알겠느냐, 단장! 그 정도로 이 몸은 놀라지 않는다!",
      "UnitTalk_JPN": "分かったか、人間の団長よ！その程度のことで、わがはいは動じないのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 50,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_BUNNY_SCISSORS",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "자, 이만하면 충분히 감상했겠지?",
      "UnitTalk_JPN": "さあ、もう十分堪能したであろう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아무렇지 않은척 하는 스칼렛의 태도에, 조금 장난을 치고 싶어졌다.",
      "UnitTalk_JPN": "平気なふりをするスカーレットの態度に、少しいたずらをしたくなった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 52,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "내 손길에서 도망치려는 듯이 말려 들어가는 스칼렛의 통통한 꼬리를, 강하게 쥔 순간─",
      "UnitTalk_JPN": "私の手から逃れるかのように巻かれる、スカーレットのふっくらとした尻尾を強く握りしめた瞬間──",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 53,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgFlashBang": 0.15,
      "BgCrash": 0.2,
