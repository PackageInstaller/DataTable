      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_LPU_POST_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_LPU_POST",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 사실 저도 전에는 험지 배달부였거든요.",
      "UnitTalk_JPN": "実は私、昔は荒地の配達屋だったんですよ。",
      "TalkTime": 0.03
    },
