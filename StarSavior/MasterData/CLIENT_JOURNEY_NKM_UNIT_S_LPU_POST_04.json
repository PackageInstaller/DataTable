      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_LPU_POST_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_LPU_POST",
      "UnitTalk_KOR": " 물론 정식은 아니고 조수였지만!",
      "UnitTalk_JPN": "もちろん正式な配達屋ではなく、助手でしたけど！",
      "TalkTime": 0.03
    },
    {
