    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO_2",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아스트로 생텀을 나와 훈련장에 도착하자 한 소녀가 나를 기다리고 있었다.",
      "UnitTalk_JPN": "アストロ・サンクタムを出て訓練場に着くと、1人の少女が待っていた。  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO_2",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "소녀는 내 쪽으로 망설임 없이 다가와 악수를 청하는 손을 내밀었다.",
      "UnitTalk_JPN": "彼女は私を見つけるなり、迷うことなく手を差し出した。  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO_2",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그녀의 얼굴이 왠지 모르게 익숙하게 느껴지는건…기분 탓인가?",
      "UnitTalk_JPN": "彼女に見覚えがあるような気がするのは…気のせいだろうか？  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO_2",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "안녕? 당신이 이번에 새로 왔다는 <color=#F7BE45>[여정 단장]</color>이지?",
      "UnitTalk_JPN": "こんにちは。あなたが新しく就任した<color=#F7BE45>「旅の団長」</color>よね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO_2",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "반가워, 정식으로 소개할게. ",
      "UnitTalk_JPN": "会えてうれしいわ。早速だけど、自己紹介させてもらうね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO_2",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "난 아세라라고 해.",
      "UnitTalk_JPN": "わたしはアセラ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO_2",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그녀가 내민 손을 잡고 인사를 하려는 순간-",
      "UnitTalk_JPN": "彼女が差し出した手を取って、挨拶をしようとした瞬間—",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_01_TUTO_2",
