      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "저도 모르는 저의 부족한 부분을 파악하셨을 거라 생각합니다.",
