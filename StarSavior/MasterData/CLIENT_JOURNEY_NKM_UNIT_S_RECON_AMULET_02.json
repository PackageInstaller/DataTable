        }
      ]
    },
    {
      "Uid": 105,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "미리 부적으로 만든 함정을 여러 개 만들어 대비를 해두는 것도 그렇고…",
      "UnitTalk_JPN": "あらかじめ守護符で罠をいくつも作っておいたのもそうだが…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 106,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "일체의 군더더기 없이 전투를 진행한 루그의 모습은 지금까지 꽤 많은 실전 경험을 거쳤음을 느끼게 했다.",
      "UnitTalk_JPN": "無駄のない動きで戦うルーの姿から、数々の実践を潜り抜けてきたことが見て取れた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
