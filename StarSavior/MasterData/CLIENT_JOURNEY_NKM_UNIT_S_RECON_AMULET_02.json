      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…그렇습니까?",
      "UnitTalk_JPN": "…そうでしたか？",
      "TalkTime": 0.03
    },
    {
