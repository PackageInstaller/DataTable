    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "나는 돌아서는 리사의 목덜미를 잡아끌었다.",
      "UnitTalk_JPN": "私は背を向けたリサの首筋を掴んで引き寄せた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "리사는 버둥거리면서 끔찍한 단어들을 외쳐댔지만 굳이 귀담아듣진 않았다.",
      "UnitTalk_JPN": "リサはもがきながら恐ろしい言葉を叫び続けたが、わざわざ耳を傾けはしなかった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.8,
      "BgCrashTime": 0.3,
      "UnitTalk_KOR": "화물칸에 리사를 던져 넣은 후 문을 잠갔다.",
      "UnitTalk_JPN": "貨物室にリサを放り込んだ後、扉を閉めた。",
