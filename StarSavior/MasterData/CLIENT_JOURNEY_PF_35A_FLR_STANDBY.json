    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_SWIM_LISA",
      "UnitTalk_KOR": "해변에서 수영이나 하면서 놀고 싶어…",
      "UnitTalk_JPN": "海辺で泳いだりしながら遊びたい…",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그… 현실로 돌아와야지?",
          "JumpAnchorStringId_JPN": "あの…現実に戻らなきゃいけないよね？"
        }
      ]
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_SWIM_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "저, 생각을 해 봤어요 단장님.",
      "UnitTalk_JPN": "あの、考えてみたんです、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_SWIM_LISA",
      "UnitTalk_KOR": "받아들일 수 없는 현실이 있다면, 그 현실을 바꾸는 것도 구원자의 일 아닐까요?",
      "UnitTalk_JPN": "受け入れがたい現実があるなら、その現実を変えることも救援者の仕事ではないでしょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…",
          "JumpAnchorStringId_JPN": "…"
        }
      ]
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.8,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_S_SWIM_LISA",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "그런 의미에서 전 제 운명을 스스로 결정하기로 했습니다!",
      "UnitTalk_JPN": "そういう意味で、私は自分の運命を自分で決めることにしました！",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_SWIM_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "안타깝지만 저와 단장님의 인연은 여기까지인 것 같아요.",
      "UnitTalk_JPN": "残念ながら、私と団長の縁はここまでだったようです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_SWIM_LISA",
      "UnitTalk_KOR": "전 이곳, 파도가 몰아치는 플로라 시티에 남기로 했습니다!",
      "UnitTalk_JPN": "私はこの場所、波が押し寄せるフローラシティに残ることにしました！",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_SWIM_LISA",
      "UnitTalk_KOR": "관측사 따위가 아닌, 셀럽으로서 제2의 인생을 설계하는 거죠.",
      "UnitTalk_JPN": "観測士などではなく、セレブとして第二の人生を設計するのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_SWIM_LISA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "두 분은 NOA로 돌아가 부디 제 몫까지 훌륭히 <color=#F7BE45>[여정]</color>을 완료해 주세요!",
      "UnitTalk_JPN": "お二人はNOAに戻り、どうか私の分まで立派に<color=#F7BE45>「救援の旅」</color>を完遂してください！",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.3,
      "UnitStrId": "NKM_UNIT_S_SWIM_LISA",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "그럼 이만!",
      "UnitTalk_JPN": "それでは！",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_35A_FLR_STANDBY",
      "WaitClick": false,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARUNIT",
