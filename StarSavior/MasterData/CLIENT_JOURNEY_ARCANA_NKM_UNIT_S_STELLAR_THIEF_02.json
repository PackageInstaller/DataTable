      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "트리쉬랑 프레이?",
          "JumpAnchorStringId_JPN": "トリッシュとフレイ？"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": false,
      "WaitTime": 0.0,
