      "UnitPos": "POS7"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SMILE",
      "UnitQuickSet": true,
      "UnitPos": "POS8",
      "UnitTalk_KOR": "으응? 아, 단장이구나? 안녕!",
      "UnitTalk_JPN": "んん？おっ、団長か？うぃーっす！",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "단장님, 오랜만에 뵙네요. ",
      "UnitTalk_JPN": "団長、お久しぶりですわね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "뭐하고 있어?",
          "JumpAnchorStringId_JPN": "何してたの？"
        }
      ]
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "여기 프레이랑 같이 <color=#F7BE45>사업</color>을 하나 시작하기로 해서 말이야! ",
      "UnitTalk_JPN": "ここでフレイと一緒に、<color=#F7BE45>ビジネス</color>を始めることにしたんだよ！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitTalk_KOR": "이 건물 2층에 사무실을 오픈하기로 해서, 간판을 달고 있었어.",
      "UnitTalk_JPN": "ここの2階に事務所をオープンすることになって、看板を設置してたとこだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그렇습니다! 저희의 야심찬 새 사업이죠.",
      "UnitTalk_JPN": "そうなのです！まさに、わたくしたちの野心が詰まったビジネスです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "둘이 원래 알던 사이야?",
          "JumpAnchorStringId_JPN": "二人って、知り合いだったの？"
        }
      ]
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "흠… 그날의 만남은, 운명과도 같은 만남이었달까요. ",
      "UnitTalk_JPN": "ふむ…あの日の出会いは、運命的なものでしたわ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "언제나와 같이 막대한 부를 가져다줄 새 사업 아이템을 궁리하던 날이었습니다.",
      "UnitTalk_JPN": "いつものように、膨大な富をもたらす新しい事業アイデアを練っていた日のことでした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "명민한 사업가란 항상 시류에 민감한 법.  ",
      "UnitTalk_JPN": "敏腕な事業家は、常にトレンドに目を光らせるもの。  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "최신 유행을 몸소 파악하기 위해 백화점에 방문했었죠. ",
      "UnitTalk_JPN": "最新の流行を把握すべく、デパートを訪れましたわ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그냥 쇼핑하러 간 거 아니고?",
          "JumpAnchorStringId_JPN": "それってただのショッピングじゃないの？"
        }
      ]
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "ONE_7",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "이 세상에 완전한 창조는 없는 법입니다! ",
      "UnitTalk_JPN": "この世に、完全な創造などないのですっ！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "새 사업 아이템을 구상하려면 다른 아이템들을 직접 이용해보며 영감을 얻어야 한다구요!",
      "UnitTalk_JPN": "新しい事業アイデアを構想するためには、他のものを利用してインスピレーションを得ないといけないんですってば！",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "큼! 크흠…! 아무튼! 그곳에서 전 운명과 같이 만나고 말았습니다.",
      "UnitTalk_JPN": "こ、こほん…！とにかくっ！そこでわたくしは、運命的な出会いを果たしてしまったのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "<color=#F7BE45>아셀루스 협회</color>의 초일류 헌터! 트리쉬를 말이죠!",
      "UnitTalk_JPN": "そのお相手こそ、<color=#F7BE45>アセルス協会</color>の超一流ハンター！トリッシュです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "음음. 그렇지. 이 몸이 바로 초 일류 헌터란 말씀. ",
      "UnitTalk_JPN": "うんうん、その通りだ。俺こそが超一流ハンターってわけだぜ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "그때! 머릿속에 번쩍하고 떠오르고 만 것입니다. 획기적인 아이디어가!",
      "UnitTalk_JPN": "その時！ひらめいてしまったのです。画期的なアイデアを！",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "제 사업 재능과 트리쉬의 <color=#F7BE45>헌터</color>로서의 능력! ",
      "UnitTalk_JPN": "わたくしのビジネスにおける才能と、トリッシュの<color=#F7BE45>ハンター</color>としての能力！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그 둘을 합치면 대단한 사업이 나올 거란 걸 말이예요.",
      "UnitTalk_JPN": "この2つが合わされば、とてつもないビジネスが生まれるという訳です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
