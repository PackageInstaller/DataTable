      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "소정의 의뢰비를 받고 말이죠. ",
      "UnitTalk_JPN": "もちろん、依頼費はいただきますよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "그러니 <color=#F7BE45>심부름센터</color>라는 이름이 딱 알맞지 않습니까?",
      "UnitTalk_JPN": "まさに、<color=#F7BE45>便利屋</color>という名前がピッタリでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "어떠신가요, 단장님. 관심이 조금 생겼나요?",
      "UnitTalk_JPN": "いかがですか、団長？少し興味が湧いてきましたか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "심부름이라고?",
          "JumpAnchorStringId_JPN": "便利屋って？"
        }
      ]
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "후후… 저희 <color=#F7BE45>프리쉬 특급 심부름센터</color>가 주력으로 삼고 있는 심부름은… ",
      "UnitTalk_JPN": "ふふ…<color=#F7BE45>フレッシュ・スぺシャル便利屋</color>のメインとなる仕事は… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "그러니까, 공공기관에서는 해결해주지 못하는 문제들이랄까요?",
      "UnitTalk_JPN": "公共機関では解決できないようなこと、とでも言いましょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "훗. 말하자면 어둠 속에서 사람들을 돕는 다크 히어로…!",
      "UnitTalk_JPN": "ふっ。言うならば、裏で人助けをするダークヒーロー…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "어떻게 해야 할지 몰라서 발만 동동 구르고 있을 때-",
      "UnitTalk_JPN": "どうすればいいのか分からなくて、途方に暮れたとき──",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "각종 방안을 동원해 문제를 해결해주는 해결사! 란 겁니다.",
      "UnitTalk_JPN": "様々な方法で問題を解決してくれる、解決屋！ということです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "CameraOffset": "ONE_8",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "일류 헌터 특… 수단과 방법 가리지 않음.",
      "UnitTalk_JPN": "一流ハンターたる者…手段と方法は選ばねぇ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…수상한데.",
          "JumpAnchorStringId_JPN": "…怪しいな。"
        }
      ]
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "수상하다니! 실례입니다!",
      "UnitTalk_JPN": "怪しいだなんて！失礼ですわね！",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그래서, 정확히 무슨 일을 하는 건데?",
          "JumpAnchorStringId_JPN": "で、正確には何をする仕事なの？"
        }
      ]
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "말씀드렸다시피, <color=#F7BE45>곤란한 문제</color>를 해결해 주는 일입니다.",
      "UnitTalk_JPN": "お伝えした通り、<color=#F7BE45>困り事</color>を解決して差し上げるのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "예를 들면… 오래전 헤어진, 보고 싶은 사람이 있는데 찾아달라던가?",
      "UnitTalk_JPN": "例えば…長い間、会えていない人を探してほしいとか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "사람 찾는 건 내 전문이니까. 악명높은 현상 수배범부터 도피한 범죄자까지 가능하지!",
      "UnitTalk_JPN": "人探しはオレの専門だぜ。悪名高い指名手配犯から、逃亡中の犯罪者まで可能だからな！",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "새로 들어온 의뢰 중에는… ",
      "UnitTalk_JPN": "新たに入ってきた依頼の中には…　 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "학창 시절 옆자리 짝을 찾아달라거나 첫사랑을 찾아달라는 정도가 있군요.",
      "UnitTalk_JPN": "学生時代に隣の席だったクラスメイトや、初恋の人を探してほしいという内容のものがありますわね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "음! 조금 시시한데… 짐승이나 마물을 찾아 달라는 의뢰는 없었어?",
      "UnitTalk_JPN": "うーん！ちょっと物足りねぇなぁ…野獣とか魔獣を探してほしいって依頼はないのか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "짐승… 이라기보단 집 나간 고양이를 찾아달라는 의뢰는 세 건 있네요.",
      "UnitTalk_JPN": "野獣…ではなく、家から脱走した猫を探してほしいという依頼が3件入っています。",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아, 자극적인 맛을 원한다면… 이런 것도 있네요!",
      "UnitTalk_JPN": "あっ、刺激をお求めなら…こんな依頼もありますの！",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "뭔데? 위험천만하고 멋있는 의뢰야?",
      "UnitTalk_JPN": "なんだ？危険でクールな依頼か？",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "<color=#F7BE45>바람을 피우는 애인의 뒷조사를 해달라</color>는 내용입니다. ",
      "UnitTalk_JPN": "<color=#F7BE45>浮気中の恋人の身辺調査をしてほしい</color>という内容です。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "흠… 이 의뢰인은 엄청난 부자인가 보네요. 보상으로 적어 보낸 금액이 무려-",
      "UnitTalk_JPN": "ふむ…この依頼人はかなりの富豪なのでしょうね。報酬として書かれている金額はなんとー",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.8,
      "BgCrashTime": 0.8,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "CameraOffset": "ONE_8",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "뭐야 그게!!! 죄다 멋없는 의뢰뿐이잖아! ",
      "UnitTalk_JPN": "何だよそれ！！！クールとはほど遠い依頼しかないじゃねぇか！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "내가 아니면 할 수 없는 멋있는 거! 뭐 그런 의뢰는 없는 거야? ",
      "UnitTalk_JPN": "オレにしかできないような、クールな依頼！そんなのはないのか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "<color=#F7BE45>도시에 숨어있는 엄청난 음모의 배후를 밝혀달라!</color> 뭐 그런 거 말이야.",
      "UnitTalk_JPN": "<color=#F7BE45>街に隠された巨大な陰謀の黒幕を暴いてくれ！</color>とかさ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…아쉽지만 그런 건 없네요. ",
      "UnitTalk_JPN": "…残念ですが、そのようなものはありません。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "트리쉬, 아직 사업이 본격적으로 시작하지도 않은 이상, 의뢰를 가릴 처지가 아닙니다!",
      "UnitTalk_JPN": "トリッシュ。ビジネスが軌道に乗るまでは、依頼を選り好みするものではありませんのよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 77,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "분명히 <color=#F7BE45>남들에게 말하기 어려운 곤란한 문제들</color>을 처리하는 사업이라고 했잖아? ",
      "UnitTalk_JPN": "はっきりと<color=#F7BE45>他人に言えないような困り事</color>を処理するビジネスだって言っただろ？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 78,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "확실히 몇 개는 곤란하긴 한데…",
          "JumpAnchorStringId_JPN": "さっき言ってた中に、一応そういう依頼もあったけどね…"
        }
      ]
    },
    {
      "Uid": 79,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "CameraOffset": "ONE_8",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "당연히 <color=#F7BE45>비밀스럽고 멋있는 일</color>일 거라고 생각해서 수락한 거라구!",
      "UnitTalk_JPN": "当然、<color=#F7BE45>秘密めいたクールな仕事</color>だと思ってオッケー出したんだよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 81,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "고양이 찾기 같은 의뢰는 안 할 거니까 그렇게 알아둬!",
      "UnitTalk_JPN": "猫を探すような依頼は絶対に受けないからな！",
      "TalkTime": 0.03
    },
    {
      "Uid": 82,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "크읏…! 트리쉬, 잘 생각해보시죠! ",
      "UnitTalk_JPN": "くぅっ…！トリッシュ、よく考えるのです！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 83,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "그래! 여기 적힌 보상금! 자그마치 이 액수라구요? 탐나지 않나요?",
      "UnitTalk_JPN": "そうだわ、ここに書かれてる報酬金よ！この大金、手に入れたくありませんの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 84,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_STELLAR_THIEF_02",
      "WaitClick": true,
