      "BgFileName": "ILLUST_BG_OFFICE_01.png"
    },
    {
      "Uid": 231,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "SMILE",
      "UnitPos": "POS8"
    },
    {
      "Uid": 232,
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "NORMAL",
      "UnitPos": "POS7"
    },
    {
      "Uid": 219,
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 155,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitTalk_KOR": "축하해, 루그.",
      "UnitTalk_JPN": "おめでとう、ルー。",
      "TalkTime": 0.03
    },
    {
      "Uid": 156,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "……",
      "UnitTalk_JPN": "……",
      "TalkTime": 0.03
    },
    {
      "Uid": 157,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…혹시 또 사고 치셨습니까?",
      "UnitTalk_JPN": "…また何か問題を起こされたのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 158,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "응? 가, 갑자기?",
      "UnitTalk_JPN": "えっ？と、突然どうしたのよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 159,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "팀장님이 웃으며 말을 걸 때는 높은 확률로 경위서 작성을 도와달라고 하시니까요.",
      "UnitTalk_JPN": "リーダーが笑顔で声を掛けてくるのは、たいてい始末書の作成を手伝ってほしいという時ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 160,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "전에도 말씀드렸지만 도와드리지 않을 겁니다. 스스로 작성하면서 반성하십시오.",
      "UnitTalk_JPN": "以前もお伝えしましたが、お手伝いはできません。自ら作成し、反省なさってください。",
      "TalkTime": 0.03
    },
    {
      "Uid": 161,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "윽…! 우리 부팀장은 융통성이 없어서 큰일이란 말이야…",
      "UnitTalk_JPN": "うっ…！チーフったら、頭が固くて困っちゃうわ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 162,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "큰일은 주로 팀장님이 치고 다닙니다만.",
      "UnitTalk_JPN": "困ったことは、主にリーダーが起こしていますが。",
      "TalkTime": 0.03
    },
    {
      "Uid": 163,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "이런 부분까지 포함해서!",
      "UnitTalk_JPN": "こういうところまで含めてよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 164,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아무튼 축하해, 루그.",
      "UnitTalk_JPN": "とにかくおめでとう、ルー。",
      "TalkTime": 0.03
    },
    {
      "Uid": 165,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitTalk_KOR": "내일부터 사무실에 나오지 않아도 돼.",
      "UnitTalk_JPN": "明日から出勤しなくていいわ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 166,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "…예?",
      "UnitTalk_JPN": "…はい？",
      "TalkTime": 0.03
    },
    {
      "Uid": 167,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "상부랑 담판 짓고 왔어.",
      "UnitTalk_JPN": "上に直談判してきたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 168,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitTalk_KOR": "여정에 집중할 수 있도록 여정이 끝날 때까지 너는 장기 휴가야. 어때? 팀장의 배려.",
      "UnitTalk_JPN": "旅に集中できるよう、クリアするまで長期休暇よ。リーダーの気遣いってものね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 169,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아닙니다, 괜찮습니다.",
      "UnitTalk_JPN": "いえ、大丈夫です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 170,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "아아~ 루그라면 그렇게 말할 줄 알았어.",
      "UnitTalk_JPN": "もう、ルーはそう言うと思ってたわ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 171,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitTalk_KOR": "하지만 루그는 안 괜찮을 때도 <color=#F7BE45>괜찮습니다</color>라고 한단 말이지.",
      "UnitTalk_JPN": "でも、大丈夫じゃない時も<color=#F7BE45>大丈夫です</color>って言うのよね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 172,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "정말… 괜찮습니다.",
      "UnitTalk_JPN": "本当に…大丈夫です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 173,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "루그, 어제도 사무실에서 밤새웠지?",
      "UnitTalk_JPN": "ルー、昨日も事務所で徹夜したでしょ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 174,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그건… 오늘까지 끝내야 하는 서류 작업이 조금 있었기 때문에…",
      "UnitTalk_JPN": "それは…今日までに終わらせなければならない事務作業があったため…",
      "TalkTime": 0.03
    },
    {
      "Uid": 175,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitTalk_KOR": "내가 다음 주까지 줘도 된다고 하지 않았어?",
      "UnitTalk_JPN": "期限は来週までって言ったじゃない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 176,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "조금 더 빨리 끝내면 그만큼 일이 줄 테니까요.",
      "UnitTalk_JPN": "早く終わらせれば、その分仕事が減りますから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 177,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "CameraOffset": "ONE_8",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "그럼 이건?",
      "UnitTalk_JPN": "じゃあ、これは？",
      "TalkTime": 0.03
    },
    {
      "Uid": 178,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "로베르타는 루그의 책상과 책상 옆에 산처럼 쌓여있는 대량의 에너지 드링크 병을 가리키며 물었다.",
      "UnitTalk_JPN": "ロベルタは、ルーの机の横に山積みになったエナジードリンクの空き瓶を指差しながら言った。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 179,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "그건… 평소에도 자주…",
      "UnitTalk_JPN": "それは…普段からよく…",
      "TalkTime": 0.03
    },
    {
      "Uid": 180,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "루그. 보통 사람이라면 육체적으로 괴로움을 느낄 게 분명한 상황까지 과로하고 있다는 거, 본인도 알고는 있지?",
      "UnitTalk_JPN": "ルー。普通の人だったら、体が悲鳴を上げるような状態まで働いてるってこと…自分でも分かってるでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 181,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_KNUCKLE",
      "UnitTalk_KOR": "그러니 여정을 통과할 때까지는 궤도 수색대의 일은 조금 내려놓도록 해.",
      "UnitTalk_JPN": "だから…旅をクリアするまでは、軌道捜索隊の仕事は少し休みなさい。",
      "TalkTime": 0.03
    },
    {
      "Uid": 182,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "하지만 팀장님, 그렇게 된다고 해도 따로 충원은 없지 않습니까?",
      "UnitTalk_JPN": "しかしリーダー。だからと言って、増員はないのではありませんか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 183,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "제가 업무를 줄이면 다른 팀원들의 업무량이 너무 많아집니다. 저는 정말로 괜찮-",
      "UnitTalk_JPN": "私の業務をチームメンバーに分ければ、仕事量が激増してしまいます。私は本当に大丈ー",
      "TalkTime": 0.03
    },
    {
      "Uid": 184,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NOA_OBSERVER",
      "CameraOffset": "TWIN_5",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitPos": "POS6",
      "UnitTalk_KOR": "걱정 마세요, 루그 선배! 선배에게는 이 <color=#F7BE45>시대가 낳은 천재</color>, 나루가 있으니까요!",
      "UnitTalk_JPN": "心配いりませんよ、ルー先輩！この<color=#F7BE45>時代が生んだ天才</color>こと、ナルがいるんですからっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 185,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NOA_OBSERVER",
      "UnitTalk_KOR": "선배님이 안 계신 동안 선배의 밀린 업무는 제가 개발한 새로운 방정식을 도입해서!",
      "UnitTalk_JPN": "先輩がいない間、溜まった仕事は私が編み出した方程式を導入して！",
      "TalkTime": 0.03
    },
    {
      "Uid": 186,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_NOA_OBSERVER",
      "UnitMotion": "SERIOUS",
