    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "어느 날, 광장을 걷고 있는데 낯익은 얼굴들이 보였다.",
      "UnitTalk_JPN": "ある日…広場を歩いていると、見慣れた顔を見かけた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "프레이랑… 스마일?",
          "JumpAnchorStringId_JPN": "フレイと…スマイル？"
        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": false,
      "WaitTime": -1.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitPos": "POS8"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "UnitPos": "POS7",
      "UnitTalk_KOR": "안녕하신가요, NOA의 단장님.",
      "UnitTalk_JPN": "NOAの団長ね、ごきげんよう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "이렇게 만난 것도 인연인데, 하나 사시죠.",
      "UnitTalk_JPN": "こうして会ったのも何かの縁ですし、ひとつ買ってください。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "프레이가 뭔가를 쓱 내밀었다.",
      "UnitTalk_JPN": "フレイが何かを差し出した。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이건… 고양이 인형?",
          "JumpAnchorStringId_JPN": "これは…猫のぬいぐるみ？"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "단순한 고양이 인형이 아닙니다.  배 부분을 손으로 눌러 보시지요",
      "UnitTalk_JPN": "単純な猫のぬいぐるみじゃありませんわよ。お腹のところを押してみてくださいな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_BATTLE_COMMON_ANIMAL_CAT.wav",
      "UnitTalk_KOR": "배 부분을 손으로 눌러보니, 야옹 하는 귀여운 울음 소리와 함께 고양이 인형이 움직였다.",
      "UnitTalk_JPN": "手でお腹を押してみると、ニャーンというかわいい鳴き声と共に猫のぬいぐるみが動き始めた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "우왓, 움직이잖아?",
          "JumpAnchorStringId_JPN": "おおっ、動くんだ。"
        }
      ]
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "고양이 인형이 아니라 <color=#F7BE45>냐옹봇</color>.",
      "UnitTalk_JPN": "猫のぬいぐるみじゃなく、<color=#F7BE45>ネコロボ</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "좀 더 복잡한 움직임 구현 가능.  하지만 코스트 다운을 위해 심플한 구성.",
      "UnitTalk_JPN": "もう少し複雑な動きを具現可能。でも、コストダウンのためにシンプルな構成。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "둘이서 이걸 팔고 있는거야?",
          "JumpAnchorStringId_JPN": "二人でこれを売ってるの？"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그렇습니다.  스마일님과 저의 합동 프로젝트예요.",
      "UnitTalk_JPN": "そうなのです。スマイル様とわたくしの共同プロジェクトなのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitTalk_KOR": "길을 걷다가 스마일님이 이 냐옹봇을 테스트하고 있는걸 보고 말을 걸었죠.",
      "UnitTalk_JPN": "道を歩いていたら…スマイル様がこのネコロボをテストしていて、声を掛けました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "팔면 돈이 될거라고 했는데, 처음에는 관심을 안 가지지 뭐예요.",
      "UnitTalk_JPN": "売ればお金になると言っても、最初は興味を持ってくれなかったのですよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "실험에서 원하는 건 결과와 개선 방향 모색이 전부.  그 외에는 부가적이고 무의미.",
      "UnitTalk_JPN": "実験で望むことは、結果と改善策の模索のみ。それ以外は無意味で取るに足りない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "하지만 이걸 많이 팔면 더 비싼 실험을 할 수 있는 자금을 가질 수 있다고 말씀드렸죠!",
      "UnitTalk_JPN": "でも…これをたくさん売れば、お金の掛かる実験に必要な資金も手に入るとお伝えしましたわ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "긍정. 더 많은 연구 자금이 있으면 지금까지 못했던 규모의 실험을 할 수 있어.",
      "UnitTalk_JPN": "肯定。研究資金が多くあれば、今までできなかった規模の実験もできる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "돈을 버는 것에는 흥미가 없지만, 돈의 중요성에 대해서는 인식.",
      "UnitTalk_JPN": "お金を稼ぐことには興味なし。でも、お金の重要性については認識。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "스마일님은 좀 더 진짜 같이 움직이는 물건을 만들려고 했지만 시작품은 이 정도가 적당하다고 말씀드렸어요.",
      "UnitTalk_JPN": "スマイル様はもっとリアルに動くものを作ろうとしましたが、試作品はこの程度が良いとお伝えしました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SMILE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "기능의 선택과 집중, 그리고 코스트 다운을 통한 최소 마진으로 박리다매 전략을 노려서 충성 고객을 확보한다!",
      "UnitTalk_JPN": "機能の選択と集中…そしてコストダウンを通じた最低限のマージンで、薄利多売を狙い、ロイヤルカスタマーを確保するっ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…라고, 어제 본 책에 쓰여 있었습니다.",
      "UnitTalk_JPN": "…と、昨日見た本に書かれていましたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그러니, 단장님도 어서 저희의 충성 고객이 되시죠!",
      "UnitTalk_JPN": "ということで、団長も早くロイヤルカスタマーになってくださいまし！",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "강매당한 기분이었지만, 얼마 비싸지 않은 인형이었기에 하나 사주고 말았다.",
      "UnitTalk_JPN": "押し売りされた気分だったけど…ぬいぐるみはそんなに高くなかったし、ひとつ買ってあげた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그냥 그 정도의 일인 줄 알았는데…",
      "UnitTalk_JPN": "ほんのちょっとしたことだと思ってたのに…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_BLACK.png",
      "StartBgmFileName": "EMPTY.mp3",
      "CutsceneClear": "CLEARUNIT"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "일주일 뒤, 믿을 수 없게도 NOA 전체에 <color=#F7BE45>냐옹봇</color>의 붐이 일어났다.",
      "UnitTalk_JPN": "一週間後…信じられないことに、NOA中で<color=#F7BE45>ネコロボ</color>ブームが巻き起こった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "종래에 없던 <color=#F7BE45>누르면 반응하는 인형</color>이라는 점과 귀여운 외모가 사람들의 관심을 끌었고,",
      "UnitTalk_JPN": "従来はなかった<color=#F7BE45>押すと反応するぬいぐるみ</color>という点、そしてかわいい見た目で人々の注目を集め…",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "NOA의 아이가 있는 집은 모두 냐옹봇을 손에 넣기 위해 어른들끼리 주먹다짐을 했다는 믿기 힘든 이야기까지 들려왔다.",
      "UnitTalk_JPN": "NOAの子持ち家庭は皆、ネコロボを手に入れようとした。そして、大人同士が取っ組み合いの争いをしたという信じがたい話まで耳に入ってきた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_PARK_PUBLIC.png"
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_PRAY_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그리고 프레이와 스마일이 어마어마한 돈을 벌어 공장을 세웠다는 이야기를 들은 다음날, 산책길에 다시 두 사람을 만날 수 있었다.",
