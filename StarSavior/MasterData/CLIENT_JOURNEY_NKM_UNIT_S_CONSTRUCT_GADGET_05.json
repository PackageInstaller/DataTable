    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitTalk_KOR": "이 수도꼭지를 고치면 돼?",
      "UnitTalk_JPN": "この蛇口を直せばいいの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "맞아! 뻑뻑해서 잘 안 돌아가.",
          "JumpAnchorStringId_JPN": "そうそう！固いから回しにくくて。"
        }
      ]
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "타냐의 마음은 기특했지만 딱히 도움받을 만한 일이 생각나지 않았다.",
      "UnitTalk_JPN": "ターニャの気持ちは嬉しかったが、特に手伝ってほしいことはなかった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "한참을 고민하다 떠오른 게 숙소의 수도꼭지였다. 타냐는 페트라 조합 소속, 건설의 전문가이니까.",
      "UnitTalk_JPN": "しばらく悩んだ末に思いついたのが、部屋の蛇口だった。ターニャはペトラ組合所属の、建設の専門家だから。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "뻑뻑한 수도꼭지 정도는 간단히 고쳐주겠지.",
      "UnitTalk_JPN": "固くて回りにくい蛇口くらいなら、簡単に直してくれるだろう。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "응. 나한테 맡겨, 단장. 금방 고쳐 줄게.",
      "UnitTalk_JPN": "うん。わたしにまかせて、団長。すぐに直してあげる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "일단 준비물부터 확인할게. 먼저 과자.",
      "UnitTalk_JPN": "とりあえず、持ち物の確認から。まずはお菓子。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "타냐가 늘 들고 다니는 공구함, 페트라 툴즈에서 간식을 꺼내 바닥에 늘어놨다.",
      "UnitTalk_JPN": "ターニャはいつも持っている工具箱、ペトラツールズからお菓子を取り出して床に並べた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "DEFAULT",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "과자?",
          "JumpAnchorStringId_JPN": "お菓子？"
        }
      ]
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "응. 과자.",
      "UnitTalk_JPN": "うん、お菓子。",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "과자는 중요해. 틈틈이 먹어줘야 하니까.",
      "UnitTalk_JPN": "お菓子は大事。作業しながら食べないといけないから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "UnitTalk_KOR": "먹고 살자고 하는 일인데 배고프면 일하기 싫다고 페트라가 그랬어.",
      "UnitTalk_JPN": "生きていくための仕事なのに、お腹すいたら仕事したくなくなるってペトラが言ってた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_CONSTRUCT_GADGET",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "다음은 튀김.",
      "UnitTalk_JPN": "次は天ぷら。",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "타냐가 늘 들고 다니는 공구함, 페트라 툴즈를 조작해서 안에 있던 튀김기를 꺼냈다.",
      "UnitTalk_JPN": "ターニャはいつも持ち歩いている工具箱、ペトラツールズをいじくると、フライヤーを取り出した。",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "DEFAULT",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…튀김이요?",
          "JumpAnchorStringId_JPN": "…天ぷら？"
        }
      ]
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_05",
      "WaitClick": true,
      "WaitTime": 0.0,
