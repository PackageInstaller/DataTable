  "Data": [
    {
      "Uid": 1,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_WELL_DIRAC.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_01.mp3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "CameraOffset": "DEFAULT",
      "UnitMotion": "SERIOUS",
      "UnitPos": "POS3",
      "UnitTalk_KOR": "드디어 마지막 평가전이군요. ",
      "UnitTalk_JPN": "いよいよ最終試験ですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "이런저런 일들이 많이 있었지만… ",
      "UnitTalk_JPN": "色んなことがありましたが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장님 덕분에 여기까지 올 수 있었습니다. ",
      "UnitTalk_JPN": "団長のおかげでここまで来ることができました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "옆에서 거들었을 뿐이야.",
          "JumpAnchorStringId_JPN": "私はちょっと手伝っただけだよ。"
        }
      ]
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아뇨. ",
      "UnitTalk_JPN": "いえ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "그때 단장님이 아니었다면 저는 도망쳤을 겁니다.",
      "UnitTalk_JPN": "あの時、団長がいなければ私は逃げていたはずです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "카넬리아 님과 똑같은 사람이 되어야만 한다는 강박에서 벗어나지 못한 채.",
      "UnitTalk_JPN": "カーネリア様とまったく同じ人にならなければならないという、強迫観念にとらわれたまま。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "모두의 진심에도 귀를 닫고 고향으로 돌아갔을 테죠.",
      "UnitTalk_JPN": "皆の思いにも耳を貸さず、故郷へと戻っていたことでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "카넬리아 님을 진심으로 존경한다면, 그래서는 안 되는 겁니다.",
      "UnitTalk_JPN": "カーネリア様を心から尊敬しているならば、そのようなことをしてはいけませんよね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "과거의 볼품없는 저마저 모두 인정하고서, 저만의 길을 따라 카넬리아 님의 뒤를 쫓아야 합니다.",
      "UnitTalk_JPN": "過去の未熟な自分自身も受け入れ、私だけの道を歩み…カーネリア様の背中を追いかけるべきなのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그렇게 <color=#F7BE45>저</color>로서 부끄러움 없는 메이드장이 되었을 때…",
      "UnitTalk_JPN": "そうして<color=#F7BE45>私</color>自身が胸を張れるメイド長になれた時…",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "비로소 카넬리아 님을 마주할 수 있겠죠.",
      "UnitTalk_JPN": "やっとカーネリア様と向き合うことができるでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "성장했구나.",
          "JumpAnchorStringId_JPN": "成長したね。"
        }
      ]
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "후후. 그럼요.",
      "UnitTalk_JPN": "ふふ、もちろんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "사담이지만 <color=#F7BE45>헬 세이비어</color>의 리더가 서부 산맥에서 붙잡혔다고 하더군요. ",
      "UnitTalk_JPN": "そういえば、<color=#F7BE45>ヘルセイヴァー</color>のリーダーが西部山脈で捕まったそうです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "잘된 일이긴 한데… ",
      "UnitTalk_JPN": "喜ばしいことですが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "그 녀석이 제 과거에 대해 떠들어대면…",
      "UnitTalk_JPN": "私の過去について騒ぎ立てた際には…",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "흠. 대책을 모색해 봐야겠습니다. ",
      "UnitTalk_JPN": "ふむ。対策を練る必要がありそうですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "아, 과거가 밝혀진다고 도망칠 생각은 없습니다.",
      "UnitTalk_JPN": "あっ。周囲に過去を知られたとしても、逃げることはありませんよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "다만… ",
      "UnitTalk_JPN": "ただ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "스칼렛이나 벨 님이 그 사실을 알게 된다면…",
      "UnitTalk_JPN": "スカーレットやベル様がその事実を知った際には…",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "기분만큼은 죽고 싶어질 것 같군요. ",
      "UnitTalk_JPN": "死んだも同然の気分になりそうですが。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "분명 놀릴 테니까…",
          "JumpAnchorStringId_JPN": "きっと、からかってくるだろうね…"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…일단 그 부분은 나중에 생각하도록 하죠.",
      "UnitTalk_JPN": "…とにかく、その件に関しては後々考えることにしましょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "CameraOffset": "TWIN_6",
      "UnitTalk_KOR": "지금은 평가전에 집중하겠습니다.",
      "UnitTalk_JPN": "今は試験に集中します。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "가시죠. <color=#F7BE45>[여정]</color>의 끝을 향해.",
      "UnitTalk_JPN": "さぁ、行きましょう。<color=#F7BE45>「救援の旅」</color>の終わりに向かって。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "준비되셨나요?",
      "UnitTalk_JPN": "準備はできましたか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그럼 지금부터 별의 구원자 계승 시험 <color=#F7BE45>[여정]</color>.",
      "UnitTalk_JPN": "では、これより星の救援者・継承試験<color=#F7BE45>「救援の旅」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그 최종시험을 시작하겠습니다.",
      "UnitTalk_JPN": "最終試験を開始します。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "시험상대는 <color=#F7BE45>[알데바란의 집행자 길레]</color>.",
      "UnitTalk_JPN": "対戦相手は<color=#F7BE45>「アルデバランの執行者・ギーレ」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "<color=#F7BE45>[디랙의 우물]</color>이 투영을 개시합니다.",
      "UnitTalk_JPN": "<color=#F7BE45>「ディラックの井戸」</color>が投影を開始します。",
      "TalkTime": 0.03
    }
  ]
}
