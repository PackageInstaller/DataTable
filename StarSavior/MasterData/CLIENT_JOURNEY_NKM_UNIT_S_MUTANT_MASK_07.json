      "CameraOffset": "TWIN_6",
      "UnitMotion": "NORMAL"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "놀이터에서 옛 친구들을 만난 이후, 키라는 눈에 띄게 기운이 없어졌다. ",
      "UnitTalk_JPN": "公園で昔の友だちと遭遇した後、キラは目に見えて元気がなくなった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "뿐만 아니라, 더 이상 내게 매달리거나 쫓아다니는 일도 사라졌다. ",
      "UnitTalk_JPN": "それだけではない。私にすがりついたり、付いて来ることもなくなった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "항상 시선을 바닥에 향한 채, 정해진 일과만을 반복할 뿐이다.",
      "UnitTalk_JPN": "いつも床に視線を落としたまま、決められた日課を繰り返すだけだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "좀 더 빠르게, 키라!",
          "JumpAnchorStringId_JPN": "もっと早く、キラ！"
        }
      ]
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "…응? 아, 응. ",
      "UnitTalk_JPN": "…うん？あ、うん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "…알겠어. ",
      "UnitTalk_JPN": "…わかった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "단장 말 대로 해볼게.",
      "UnitTalk_JPN": "団長の言うとおりにしてみる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "훈련에 참여하는 키라의 상태가 오늘따라 영 좋지 않다. ",
      "UnitTalk_JPN": "トレーニングをするキラの様子がなんだか変だ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…훈련, 수고했어. ",
      "UnitTalk_JPN": "…トレーニング、お疲れ様。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "먼저 가볼게. ",
      "UnitTalk_JPN": "キラ、先に帰るの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "안녕… 단장. ",
      "UnitTalk_JPN": "じゃあね…団長！",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "요즘… 괜찮아?",
          "JumpAnchorStringId_JPN": "最近…大丈夫か？"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": false,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_CLOCK_TICKING_03.wav",
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "응? 아… 아니야. ",
      "UnitTalk_JPN": "うん？あ…えっと…",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "괜찮아. 아무 일도 없어. ",
      "UnitTalk_JPN": "大丈夫なの。なんでもないの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "거짓말이다. ",
      "UnitTalk_JPN": "嘘だ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "키라의 얼굴에는 짙은 그림자가 드리워져 있다.",
      "UnitTalk_JPN": "キラの顔は曇っている。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "오늘, 시내에 쇼핑이라도-",
          "JumpAnchorStringId_JPN": "この後、一緒に買い物でも…"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "단장.",
      "UnitTalk_JPN": "団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "일부러 그러지 않아도 돼. ",
      "UnitTalk_JPN": "わざわざそんなことしなくてもいいの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "키라는… 괜찮으니까. ",
      "UnitTalk_JPN": "キラは…大丈夫なの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "일부러라니, 그게 무슨 소리야?",
          "JumpAnchorStringId_JPN": "わざわざって、どういうことだ？"
        }
      ]
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "…단장. ",
      "UnitTalk_JPN": "…団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "단장도 역시 키라가 귀찮고 싫었지? ",
      "UnitTalk_JPN": "団長も、やっぱりキラのことが面倒でイヤだったんでしょ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "키라가 같이 놀러가자고 해도 바쁘다고 하고… ",
      "UnitTalk_JPN": "キラが一緒に遊びに行こうって誘っても忙しいって言うし…",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "훈련이 끝나면 다른 일이 있다고 먼저 가버리잖아. ",
      "UnitTalk_JPN": "トレーニングが終わると、やることがあるって先に行っちゃうの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "키라는 바보지만… 그 정도로 눈치가 없진 않아.",
      "UnitTalk_JPN": "キラはバカだけど…そのくらいはわかるの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…저번에 그 아이들을 보고 다시 기억났어.",
      "UnitTalk_JPN": "…この前、あの子たちを見てまた思い出したの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "키라는 친하게 놀고 싶었을 뿐인데 결국 상처만 줬어.",
      "UnitTalk_JPN": "キラは仲良く遊びたかっただけなのに、結局傷つけてばかりだったの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "솔직하게 말해도 괜찮아. ",
      "UnitTalk_JPN": "はっきり言ってくれてかまわないの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "미움 받는 건 익숙하니까. ",
      "UnitTalk_JPN": "嫌われるのは慣れてるの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "나도 알고 있어. ",
      "UnitTalk_JPN": "キラもわかってるの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "역시 키라 같은 건 사랑받기 힘들겠지? ",
      "UnitTalk_JPN": "やっぱりキラなんかが愛されるなんて難しいことだよね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "응. 음침하고, 기분 나쁜 능력에 멍청하고 제멋대로 구는 아이인걸. ",
      "UnitTalk_JPN": "うん。陰湿で気持ち悪い能力を持ってる、バカで自分勝手な子どもだもん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "키라…",
          "JumpAnchorStringId_JPN": "キラ…"
        }
      ]
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "기껏 단장이 힘내서 다가와 줬는데, 또 키라가 못살게 굴어버렸어. ",
      "UnitTalk_JPN": "せっかく団長が頑張って近づいてきてくれたのに、またキラが台無しにしちゃったの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "그래서 단장도 결국 키라한테 질려버린 거야. 그렇지?",
      "UnitTalk_JPN": "だから団長も結局キラに嫌気がさしちゃったの。そうでしょ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "미안해 단장.",
      "UnitTalk_JPN": "ごめんね、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "단장은 그냥 특이한 체질이라 키라의 능력이 닿지 않을 뿐인데… ",
      "UnitTalk_JPN": "団長は、ただ特異体質でキラの能力が届かないだけなのに…",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "그걸 운명이니 뭐니 잘난 듯이 떠들고 귀찮게 해서 미안해. ",
      "UnitTalk_JPN": "それを運命だって、偉そうに喋って困らせちゃってごめん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "미워해도 좋아. 어쩔 수 없어. 전부 키라 잘못이니까. ",
      "UnitTalk_JPN": "嫌いになってもいいよ。仕方ないの。全部キラのせいなの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "그치만… ",
      "UnitTalk_JPN": "だけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "키라, 버리지 않으면 안 돼…?",
      "UnitTalk_JPN": "キラのこと、捨てないでほしいの…",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "이제 더 이상 귀찮게 안 할게. 키라가 잘못했어. ",
      "UnitTalk_JPN": "これ以上困らせたりしないから。全部キラが悪いの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그러니까 그냥 예전 같이 나랑 같이 있어 주기만 해줘. ",
      "UnitTalk_JPN": "だから、ただ昔みたいにキラと一緒にいてくれるだけでいいの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "…떠나가지 말아줘. ",
      "UnitTalk_JPN": "…いなくならないで。",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "단장이 없으면… 나는 다시 아무것도 아닌 사람이 되어버려. ",
      "UnitTalk_JPN": "団長がいないと…キラはまた昔の自分に戻っちゃうの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "키라 같은 거랑은… ",
      "UnitTalk_JPN": "キラなんかとは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "아무도 같이 이야기해주지 않아.",
      "UnitTalk_JPN": "誰も一緒に話してくれない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "옆에 있으려고 하지도 않아. ",
      "UnitTalk_JPN": "そばにいようともしない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "이제 싫어… ",
      "UnitTalk_JPN": "もうイヤなの…",
      "TalkTime": 0.03
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "혼자는 외롭단 말이야… ",
      "UnitTalk_JPN": "一人は寂しいの…",
      "TalkTime": 0.03
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "키라는 거의 주저 앉을듯한 느낌으로 울먹이고 있었다.",
      "UnitTalk_JPN": "キラは今にも泣き出しそうな顔をしていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "나를 특별하게 여기는 이유에 대해서는 이해했다. ",
      "UnitTalk_JPN": "私を特別に思っている理由については納得した。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 맹목적인 집착과 의존만으로는 키라는 영원히 성장하지 못한다.",
      "UnitTalk_JPN": "しかし、盲目的な執着と依存だけでは、キラは永遠に成長できないままだろう。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "넌 나에게 소중한 단원이야.",
          "JumpAnchorStringId_JPN": "君は私にとって大事な団員だよ。"
        }
      ]
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "미워하거나 버리지 않아.",
          "JumpAnchorStringId_JPN": "嫌ったり、捨てたりなんてしない。"
        }
      ]
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "…진짜로?",
      "UnitTalk_JPN": "…本当に？",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "키라가 나한테 의지해주는 것도 기뻐.",
          "JumpAnchorStringId_JPN": "キラが私を頼ってくれることも嬉しい。"
        }
      ]
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…그게 진심이야? ",
      "UnitTalk_JPN": "…それは本心なの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "그럼 왜-",
      "UnitTalk_JPN": "じゃあ、どうして…",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "하지만.",
          "JumpAnchorStringId_JPN": "だけど。"
        }
      ]
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "응…?",
      "UnitTalk_JPN": "うん…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "방법이 틀렸어.",
          "JumpAnchorStringId_JPN": "やり方が間違っている。"
        }
      ]
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "방법이… 틀렸다니. ",
      "UnitTalk_JPN": "やり方が…間違ってる？",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "키라, 단장이 하는 말 어려워서 잘 모르겠어… ",
      "UnitTalk_JPN": "キラ、団長の話が難しくてよくわからないの…",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "의지와 의존은 다른 거야.",
          "JumpAnchorStringId_JPN": "頼ることと依存することは別ものだ。"
        }
      ]
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_01.mp3",
      "UnitTalk_KOR": "어릴 적부터 항상 배척받고 미움 받던 키라다.  ",
      "UnitTalk_JPN": "小さい頃からいつも仲間外れにされ、嫌われてきたキラ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "단순한 잡담조차 마음 놓고 해본적이 없던 키라가 나에게 의지하는 건 당연한 수순. ",
      "UnitTalk_JPN": "ただの世間話すら気楽にできなかったキラが、私に頼るようになるのは当然のことだったのだろう。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "나로서도 여정 단원이 의지해 준다는 건 기쁜 일이다. ",
      "UnitTalk_JPN": "私としても旅の団員が頼ってくれるということは嬉しいことだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만, 의존은 다르다. ",
      "UnitTalk_JPN": "しかし、信頼と依存は別物だ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "내가 없이 아무것도 아니게 되는 관계는 결코 건강한 관계가 아니다. ",
      "UnitTalk_JPN": "私なしでは意味をなさない関係なんて、決して望ましい関係ではない。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그리고 지금의 키라는, 내가 없이는 금세 무너져버리는 모래성 같은 상태고. ",
      "UnitTalk_JPN": "そして今のキラは、私なしではすぐにでも崩れてしまう砂の城のような状態だ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그치만 키라는… ",
      "UnitTalk_JPN": "でも、キラは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "단장 없이는 그냥…",
      "UnitTalk_JPN": "団長がいないと、ただの…",
      "TalkTime": 0.03
    },
    {
      "Uid": 77,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "기분 나쁜 아이일 뿐이야. ",
      "UnitTalk_JPN": "気持ちの悪い子どもなの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 78,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "아무도 키라 같은 건 좋아해주지 않고… ",
      "UnitTalk_JPN": "誰もキラなんか好きになってくれないの…",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "나는 그냥… 그냥 단장만 있으면 되는데…",
      "UnitTalk_JPN": "キラはただ…ただ団長がいてくれればいいだけなの…",
      "TalkTime": 0.03
    },
    {
      "Uid": 80,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "키라는, 스스로를 사랑해?",
          "JumpAnchorStringId_JPN": "キラは、自分のことが好きか？"
        }
      ]
    },
    {
      "Uid": 81,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "스스로…?",
      "UnitTalk_JPN": "自分のこと…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 82,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "그런 건 생각해본 적 없는데… ",
      "UnitTalk_JPN": "そんなこと、考えたことない…",
      "TalkTime": 0.03
    },
    {
      "Uid": 83,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "스스로를 사랑할 줄 알아야…",
      "UnitTalk_JPN": "自分を好きになってこそ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 84,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "다른 사람도 키라를 사랑할 수 있는 거라고?",
      "UnitTalk_JPN": "他の人もキラのことを好きになってくれるって？",
      "TalkTime": 0.03
    },
    {
      "Uid": 85,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03
    },
    {
      "Uid": 86,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "…! ",
      "UnitTalk_JPN": "…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 87,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "단장은… ",
      "UnitTalk_JPN": "団長は…",
      "TalkTime": 0.03
    },
    {
