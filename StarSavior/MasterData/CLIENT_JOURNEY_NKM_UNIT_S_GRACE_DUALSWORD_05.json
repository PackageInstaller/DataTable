      "BgFadeOutTime": 0.8
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "손수 만든 요리라고 했을 때는 조금 걱정했는데, 의외로 잘 만든 포토푀였다.",
      "UnitTalk_JPN": "手作りだと聞いて少し心配していたが、意外とよくできたポトフだった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 감상…은 굳이 여쭤보지 않아도 될 것 같네요.",
      "UnitTalk_JPN": "感想…は、あえて聞かなくてもよさそうですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "생각보다 맛있어서 깜짝 놀랐어.",
          "JumpAnchorStringId_JPN": "思ったよりも美味しくてビックリしたよ。"
        }
      ]
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": " 과찬이세요.",
      "UnitTalk_JPN": "大したことありません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " …생각보다요?",
      "UnitTalk_JPN": "…思ったよりも？",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…각오한 것보다?",
          "JumpAnchorStringId_JPN": "…覚悟してた割に…？"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": " 숨 쉬듯이 무례하시기는.",
      "UnitTalk_JPN": "本当に失礼な方ですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "귀족 아가씨가 요리를 잘 할 것 같진 않아서…",
          "JumpAnchorStringId_JPN": "貴族のお嬢様が、料理上手とは思えなくて…"
        }
      ]
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": " …어려서부터 이런 건 스스로 준비해야 했거든요.",
      "UnitTalk_JPN": "…幼い頃から、自分で用意しなければならなかったのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": " 오를랑 가문은 뒤떨어지는 아이에게 많은 걸 베풀지 않아요.",
      "UnitTalk_JPN": "オルラン家は、劣った子に多くのものを与えません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": " 그리고 저는 보통 뒤처지는 쪽이었죠.",
      "UnitTalk_JPN": "…そして、まさにその劣った子こそ私だったのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 그러다 보니 배울 기회가 생겼을 뿐입니다.",
      "UnitTalk_JPN": "そのため、料理を学ぶ機会があっただけのことですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "여정엔 왜 참여하게 된 거야?",
          "JumpAnchorStringId_JPN": "旅には、どうして参加したんだ？"
        }
      ]
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "...오를랑의 보라매라는 이름은 가문의 후계자, 가장 뛰어난 아이에게 주어지죠.",
      "UnitTalk_JPN": "…オルランの若鷹という名は…家門の後継者かつ、最も優れた子に与えられます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "언제든지 빼앗길 수 있는 이름이라는 뜻이에요.",
      "UnitTalk_JPN": "つまり、いつでも奪われる可能性があるということです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": " 가문의 어르신들은 둔하고 약한 제 모습을 아직 기억하고 계시죠.",
      "UnitTalk_JPN": "オルラン家のご長老方も、弱い私の姿をまだ覚えていらっしゃるでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": "제가 자기들 위에 있다는 걸 아직 인정하지 못하는 형제자매도 많고요.",
      "UnitTalk_JPN": "それに、私が上だということを認めていない兄弟姉妹も多くいるのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 전 자신을 증명해야 했어요.",
      "UnitTalk_JPN": "私は、自分自身を証明しなければなりませんでした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": " 누구보다 많은 걸 이뤄야 하고, 어떤 허점도 보여서는 안 됐죠.",
      "UnitTalk_JPN": "誰よりも多くのことを成し遂げなければならないのは当然、隙を見せることも許されませんでした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": " 여정에 참여한 것도… 그런 이기적인 동기일 뿐이에요.",
      "UnitTalk_JPN": "旅に参加したのも…そういった利己的な動機に過ぎません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": " 구원자라고 하지만, 정작 구하고 싶은 건 제 자신의 자리뿐.",
      "UnitTalk_JPN": "救援者を名乗りながらも、本当に守りたいのは自身の居場所ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": " …제일 구원자와 어울리지 않는 사람일지도 모르겠네요, 전.",
      "UnitTalk_JPN": "…私は、最も救援者にふさわしくない人間かもしれませんね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…그렇구나.",
          "JumpAnchorStringId_JPN": "そっか…"
        }
      ]
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 그러니, 귀하께 긴히 드리고 싶은 부탁이 있어요.",
      "UnitTalk_JPN": "そこで、団長にお願いしたいことがあります。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": " 저희, <color=#F7BE45>타뷸라 라사</color> 상태로 돌아갈 수 있을까요?",
      "UnitTalk_JPN": "私たち、<color=#F7BE45>タブラ・ラーサ</color>の状態に戻れないでしょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "타뷸라 라사?",
          "JumpAnchorStringId_JPN": "タブラ・ラーサ？"
        }
      ]
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": " 네, <color=#F7BE45>백지상태</color>라는 뜻이랍니다.",
      "UnitTalk_JPN": "ええ。<color=#F7BE45>白紙の状態</color>という意味です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": " 방금까지 말씀드린 내용과 서로의 조금… 칠칠치 못한 모습도 모두 잊고…",
      "UnitTalk_JPN": "先ほどお話したことも、お互いの…少し情けない姿もすべて忘れて…",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": true,
      "WaitTime": 0.0,
