      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "저녁에 에핀델의 숙소에 방문했다.",
      "UnitTalk_JPN": "夕方、エピンデルの部屋を訪れた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_05",
      "WaitClick": false,
