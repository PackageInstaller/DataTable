      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_RECON_AMULET",
      "UnitTalk_KOR": "그때는 단장님 곁을 지키겠습니다.",
      "UnitTalk_JPN": "団長のそばにいます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_RECON_AMULET_09",
      "WaitClick": true,
