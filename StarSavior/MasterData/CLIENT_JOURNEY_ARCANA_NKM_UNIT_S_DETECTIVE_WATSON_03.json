      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아. 후후후! 물론 이기심 이야기에요. ",
      "UnitTalk_JPN": "あっ。んふふっ！もちろん、エゴイズムの話よ。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
