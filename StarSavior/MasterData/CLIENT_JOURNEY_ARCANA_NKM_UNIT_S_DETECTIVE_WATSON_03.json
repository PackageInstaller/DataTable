      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_SHERIFF",
      "UnitTalk_KOR": "<color=#F7BE45>NOA 시장가 연쇄 도난 사건</color>, <color=#F7BE45>아포칼립스 상단 습격 사건</color>… ",
      "UnitTalk_JPN": "<color=#F7BE45>NOA商店街連続窃盗事件</color>、それに<color=#F7BE45>アポカリプス商会襲撃事件</color>… ",
      "TalkTime": 0.03
    },
