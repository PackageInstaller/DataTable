      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "오… 오오…! 이게 트릭이었구나…? ",
      "UnitTalk_JPN": "お…おぉ…！これがトリックだったんですね…？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_DETECTIVE_WATSON_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_DETECTIVE_WATSON",
      "UnitTalk_KOR": "주인공, 결국 해결했네…!",
      "UnitTalk_JPN": "結局、主人公が解決したんだ…！",
      "TalkTime": 0.03
    },
    {
