    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_05B_NOA_BT_READY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_STELLAR_THIEF",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…흐음, 하지만 다른 사람의 기회까지 뺏아가는 건… 그다지 멋있는 행동은 아닌 것 같기도…",
      "UnitTalk_JPN": "…うーん、でも他人のチャンスまで奪うのは…あんまりクールじゃない気も…",
      "TalkTime": 0.03
    },
    {
