    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_STAR_01",
      "WaitClick": false,
      "WaitTime": 1.5,
      "BgFadeOutCol": [
        "1",
