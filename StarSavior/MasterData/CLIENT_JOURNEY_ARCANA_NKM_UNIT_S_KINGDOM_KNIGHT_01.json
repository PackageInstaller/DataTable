      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_TRADER_CHEATER"
      ],
      "UnitTalk_KOR": "힉?",
      "UnitTalk_JPN": "ひぃ？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
