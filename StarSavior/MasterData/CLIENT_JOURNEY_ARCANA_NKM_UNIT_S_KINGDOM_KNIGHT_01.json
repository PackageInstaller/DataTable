      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "거기 상인! 잠깐 기다리시오!",
      "UnitTalk_JPN": "そこの商人！お待ちなさい！",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_TRADER_CHEATER"
      ],
      "UnitTalk_KOR": "무, 무슨 일이십니까요, 헤, 헤헤…",
      "UnitTalk_JPN": "な、何のことでしょうか、へ、へへ…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitTalk_KOR": "80% 할인이라고 하셨소?",
      "UnitTalk_JPN": "80%セールだと申したか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_TRADER_CHEATER"
      ],
      "UnitTalk_KOR": "그, 그으렇습죠오?",
      "UnitTalk_JPN": "そ、そうですねぇ、はい。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
