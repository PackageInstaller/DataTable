      "UnitMotion": "ANGRY",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "저도요!",
      "UnitTalk_JPN": "私もです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_KNIGHT",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그래서 아까 분위기를 보고 팍! 느낌이 왔죠. 저놈 사기꾼이다!",
      "UnitTalk_JPN": "おかげさまで、さっきのやり取りを見てピーンときたのです。あいつは悪徳商人だと！",
      "TalkTime": 0.03
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_KNIGHT_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "역시-!",
      "UnitTalk_JPN": "やっぱりー！",
      "TalkTime": 0.03
    },
    {
