      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MUTANT_MASK_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MUTANT_MASK",
      "UnitTalk_KOR": "단장, 차 한잔 마실래? ",
