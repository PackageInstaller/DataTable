    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아, 벌써 나와 계셨네요! 단장님!",
      "UnitTalk_JPN": "あっ、もういらしてたんですね！",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "죄송해요, 오늘은 제가 좀 늦었죠?",
      "UnitTalk_JPN": "すみません、今日は少し遅れてしまいました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그러게, 별일이네.",
          "JumpAnchorStringId_JPN": "珍しいね。"
        }
      ]
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "후후, 지난번에 말씀드린 <color=#F7BE45>[탐사꾼 협회]</color> 설립 때문에 조금 바빴거든요.",
      "UnitTalk_JPN": "ふふっ。この前お話した<color=#F7BE45>「発掘屋協会」</color>の設立で少し忙しかったんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "최하급 숙소 단체 장기계약부터 유물 판매 계약이랑 수익 배분 계약까지.",
      "UnitTalk_JPN": "最低ランクの宿の長期契約から、遺物販売契約、収益分配契約まで…",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "엄청난 서류 더미의 파도가 밀려왔었죠.",
      "UnitTalk_JPN": "とんでもない書類の山に押しつぶされそうになっていたんですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "거기다 인간 탐사꾼들에게 무슨 말을 얻어들었는지 호구… 아니, 족장인가 하는 녀석이 부당 계약이라며 항의를 하지 뭐예요?",
      "UnitTalk_JPN": "それに人間の発掘屋から何か聞いたのか、カモ…いえ、族長が不当契約だとか抗議してきて。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.1,
      "BgCrashTime": 2.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "파업을 하겠다나 뭐라나… 은혜도 모르는 놈들 같으니…",
      "UnitTalk_JPN": "ストライキだの何だの…恩知らずなんだから…",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…",
          "JumpAnchorStringId_JPN": "…"
        }
      ]
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "하지만 이제 다 끝났답니다!",
      "UnitTalk_JPN": "でも、もう終わったんです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "온수 공급을 하루 12시간까지 늘려주는 걸로 깔끔하게 협상을 마무리했죠.",
      "UnitTalk_JPN": "温水の供給を一日12時間に増やすことで、見事に交渉をまとめたんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "남은 일은 가벼운 마음으로 NOA로 돌아가는 것뿐이랍니다.",
      "UnitTalk_JPN": "あとは、身軽な気持ちでNOAに戻るだけですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "제가 생각해도 전 좀 유능한 것 같아요.",
      "UnitTalk_JPN": "自分で言うのもなんですが…私って、有能だと思うんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "단장님도 그렇게 생각하시지 않나요?",
      "UnitTalk_JPN": "団長もそう思いませんか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…좀 무서운 것 같긴 해.",
          "JumpAnchorStringId_JPN": "…ちょっと怖いけどな。"
        }
      ]
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…그렇게 무슨 악마라도 보는 듯한 표정은 짓지 말아 주시겠어요?",
      "UnitTalk_JPN": "…そんな悪魔でも見たような顔しないでくれます？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "단장님께도 나쁜 이야기가 아니라고요.",
      "UnitTalk_JPN": "団長にとっても悪い話じゃないんですよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이번 일이 성사된 건 분명 단장님과 여정 단원이 평가전을 잘 통과했기 때문이기도 하니까요.",
      "UnitTalk_JPN": "今回の件が実現したのは、お二人が試験を突破したおかげでもありますから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.1,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "짜잔! ",
      "UnitTalk_JPN": "じゃじゃーん！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "돌아가는 열차는 일등석 차표로 구매했답니다!",
      "UnitTalk_JPN": "帰りの列車は、一等車です！",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "무려 제 사비를 털어서 말이죠.",
      "UnitTalk_JPN": "なんと、自腹でチケットを買ったんですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그건… 고마운데.",
          "JumpAnchorStringId_JPN": "それは…ありがたいけど。"
        }
      ]
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "자, 그럼 돌아갈까요?",
      "UnitTalk_JPN": "では、帰りましょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_22_AGN_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "성운관측기관, NOA로요.",
      "UnitTalk_JPN": "星雲観測機関、NOAへ。",
