      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "스마일. 넌 어떻게 하고 싶어?",
          "JumpAnchorStringId_JPN": "スマイル。君はどうしたいんだ？"
        }
      ]
    },
    {
      "Uid": 38,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
