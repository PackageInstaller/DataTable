    },
    {
      "Uid": 47,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "우린 <color=#F7BE45>[인공생명체]</color> 라고.",
      "UnitTalk_JPN": "私たちは<color=#F7BE45>「人工生命体」</color>なんだって。",
