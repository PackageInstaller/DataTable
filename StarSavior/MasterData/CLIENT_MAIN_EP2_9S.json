      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "하지만 자신은 결국 실패했다고 했음.",
      "UnitTalk_JPN": "でも、姉さんは人間になることに失敗したって言ってた。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_SMILE_017.wav"
    },
