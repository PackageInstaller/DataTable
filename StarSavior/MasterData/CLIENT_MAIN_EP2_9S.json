      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "왜 그러지?",
          "JumpAnchorStringId_JPN": "どうしたんだ？"
        }
      ]
    },
    {
      "Uid": 89,
      "WaitClick": false,
      "WaitTime": -1.0,
      "CutsceneClear": "CLEARUNIT"
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "으… 그게 그러니까…",
      "UnitTalk_JPN": "うぅ…えっと、だから…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_004.wav"
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "이제 와서 내가 이런 말을 해 봐야 믿어주지 않을 건 아는데 말이지…",
      "UnitTalk_JPN": "今さらアタシがこんなこと言っても、信じてくれないだろうけど…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_005.wav"
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "저 문 안으로 들어가면 나쁜 일이 벌어진다는 점괘는 진짜라고!",
      "UnitTalk_JPN": "あの中に入れば、悪いことが起きるっていうお告げはマジなの！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_006.wav"
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "정말… 크게 후회할지도 몰라.",
      "UnitTalk_JPN": "本当に…すっごく後悔するかもしれない。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_007.wav"
    },
    {
      "Uid": 19,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "그런데도 꼭 들어가야겠어?",
      "UnitTalk_JPN": "それでも、中に入らなきゃダメ？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_008.wav"
    },
    {
      "Uid": 20,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "하지만 언니를 찾으려면…",
      "UnitTalk_JPN": "でも、姉さんを探さないと…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_SMILE_005.wav"
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "애초에 제 발로 나간 언니를 왜 찾으려는 건데?",
      "UnitTalk_JPN": "そもそも…自分から出て行ったお姉さんのこと、探す必要ある？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_009.wav"
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "거 나름대로 무슨 이유가 있으니까 나갔겠지.",
      "UnitTalk_JPN": "まぁ、それなりの理由があって姿を消したんだろうけど。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_010.wav"
    },
    {
      "Uid": 23,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "그러다 때가 되면 돌아올 거고.",
      "UnitTalk_JPN": "そのうち帰ってくるんじゃない？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_011.wav"
    },
    {
      "Uid": 24,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…안 돌아오면?",
      "UnitTalk_JPN": "…帰ってこなかったら？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_SMILE_006.wav"
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "그럼 그냥 팔자가 그렇구나~ 하고 사는 거지. 어쩌긴 뭘 어째?",
      "UnitTalk_JPN": "その時は、運命だと思うしかないでしょ？どうしようもないんだし。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_012.wav"
    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "ANGRY",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "야! 넌 말을 해도 정말…!",
      "UnitTalk_JPN": "ちょっと！そんな言い方しなくても…！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_STRANIS_006.wav"
    },
    {
      "Uid": 90,
      "WaitClick": false,
      "WaitTime": -1.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS"
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "틀린 말도 아니잖아!",
      "UnitTalk_JPN": "間違ったことは言ってないもん！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_013.wav"
    },
    {
      "Uid": 28,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "운명이란 건… 어차피 바꿀 수도 없지만 억지로 바꾸려고 하면 반드시 대가를 치르게 되어 있어.",
      "UnitTalk_JPN": "運命って…どうせ変えられないし。無理に変えようとしたら、必ず代償を払うことになるんだよ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_014.wav"
    },
    {
      "Uid": 29,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "그게 이 우울한 세계의 첫 번째 규칙이라고.",
      "UnitTalk_JPN": "それが、この憂鬱な世界における絶対のルールなの。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_015.wav"
    },
    {
      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "어차피 공허체가 떨어지건 마수들에게 습격을 받건 이 라비스타에서 가족들과 헤어진 사람은 한둘이 아니야.",
      "UnitTalk_JPN": "<r=ヴォイドボーン>空虚体</r>が落ちてきて、魔獣に襲撃されて…ラビスターで家族と離れ離れになったのは、一人や二人じゃないんだから。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_016.wav"
    },
    {
      "Uid": 31,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "그런 사람들도 다 그러려니 하고 살아.",
      "UnitTalk_JPN": "そういう人たちも、みんな受け入れて生きてる。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_017.wav"
    },
    {
      "Uid": 32,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그러니까… 꼬마 의뢰인, 스마일이라고 했지?",
      "UnitTalk_JPN": "だから…ちびっこ依頼主。スマイルって言ったよね？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_018.wav"
    },
    {
      "Uid": 33,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_ORACLE",
      "UnitTalk_KOR": "널 위해서 하는 말이야. 이쯤에서 돌아가자.",
      "UnitTalk_JPN": "キミのために言ってるの。…もう帰ろう？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_ORACLE_019.wav"
    },
    {
      "Uid": 91,
      "WaitClick": false,
