      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SAD",
      "UnitPos": "POS8",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_SMILE_007.wav"
    },
    {
      "Uid": 35,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "스마일, 더 들을 필요도 없어! 단장도 그렇게 생각하지?",
      "UnitTalk_JPN": "スマイル、これ以上耳を貸す必要はないわ！団長もそう思うでしょ？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_9_UNIT_S_VOYAGER_STRANIS_007.wav"
    },
    {
      "Uid": 36,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…그건 스마일이 결정할 문제야.",
          "JumpAnchorStringId_JPN": "…それはスマイルが決めることだ。"
        }
      ]
    },
    {
      "Uid": 37,
      "WaitClick": true,
