    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitTalk_KOR": "응…? 린인가. 무슨 일이지?",
      "UnitTalk_JPN": "ん？リンか。どうした？",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitTalk_KOR": "흐음… 평소에 입던 옷과 다르군.",
      "UnitTalk_JPN": "ふむ…普段とは服装が異なるな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "노출이 많은 옷은 부끄럽다 하지 않았나? 좋아하는 남자라도 생긴 건가! 하하하!",
      "UnitTalk_JPN": "露出の多い服は恥ずかしいと言っていなかったか？惚れた男でもできたのか？ハッハッハ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아, 아니에요! 당주님에게 조언을 받았어요.",
      "UnitTalk_JPN": "ち、違います！堂主様から助言をいただいたんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "애초에 전통 복식은 전투에 적합하지 않으니까요. 움직이기 편하게 개량했죠.",
      "UnitTalk_JPN": "そもそも、伝統衣装は戦闘に不向きですから。動きやすいように改良しました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "조금 부끄럽지만… 사저처럼 강해지기 위해서라면…!",
      "UnitTalk_JPN": "少し恥ずかしいですが…姉弟子のように強くなるためなら…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "CameraOffset": "ONE_8",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "부끄럽다?",
      "UnitTalk_JPN": "恥ずかしい？",
      "TalkTime": 0.03
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "네…?",
      "UnitTalk_JPN": "はい…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "아, 네… 등이랑 겨드랑이에 바람이 들어와서… 의식하면 할수록 얼굴이 뜨거워져요.",
      "UnitTalk_JPN": "あっ、えっと…脇や背中に風が当たって…意識すればするほど顔が熱くなります。",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "너는 멀었다.",
      "UnitTalk_JPN": "お前はまだまだだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitTalk_KOR": "노출이 많은 게 뭐가 대수라는 거냐?",
      "UnitTalk_JPN": "肌を露わにしたからと言って、それが何だというのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "강해지기 위해서라면, 깨달음을 얻기 위해서라면…",
      "UnitTalk_JPN": "強くなるためならば、悟りを得るためならば…",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.8,
      "BgCrashTime": 0.5,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "나라면 실오라기 하나 걸치지 않고 대로변도 뛰어다닐 수 있다!",
      "UnitTalk_JPN": "妾なら、一糸も纏わずに大路をも走り回れるぞ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_VAGABOND",
      "UnitTalk_KOR": "그런데 너는 피부가 조금 드러난다고 유난 떠는 건가? 강해지고 싶은 게 아니었나?",
      "UnitTalk_JPN": "だがお前は、肌が少し見えただけで大げさに振る舞うのか？強くなりたいのではなかったのか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_01",
      "WaitClick": true,
