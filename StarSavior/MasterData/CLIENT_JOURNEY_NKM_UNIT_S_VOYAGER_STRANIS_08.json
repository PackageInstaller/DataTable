      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "으응, 아, 아무것도 아냐!",
