      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "궁금하면 직접 봐.",
          "JumpAnchorStringId_JPN": "気になるなら読んでみて。"
        }
      ]
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아세라는 어리둥절한 표정으로 편지를 받아 들었다.",
      "UnitTalk_JPN": "アセラは戸惑った顔で手紙を受け取った。",
      "TalkTime": 0.03
