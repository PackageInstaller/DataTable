      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_VOYAGER_STRANIS_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_ALICIA"
      ],
      "UnitTalk_KOR": "하지만 제가 기억하는 그의 첫 모습은…",
