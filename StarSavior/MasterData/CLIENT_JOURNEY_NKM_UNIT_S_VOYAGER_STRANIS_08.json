      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "무슨… 내용이야?",
      "UnitTalk_JPN": "どんな…内容なの？",
