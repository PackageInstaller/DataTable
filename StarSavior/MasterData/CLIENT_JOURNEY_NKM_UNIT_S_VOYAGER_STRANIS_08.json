      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "마지막까지 잘 부탁해, 단장.",
      "UnitTalk_JPN": "最後までよろしくね、団長。",
      "TalkTime": 0.03
    },
