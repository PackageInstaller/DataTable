      "TalkTime": 0.03
    },
    {
      "Uid": 147,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_NOA_OBSERVER_03",
      "WaitClick": true,
