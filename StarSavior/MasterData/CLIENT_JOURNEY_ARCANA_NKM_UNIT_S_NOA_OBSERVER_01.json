      "UnitStrId": "NKM_UNIT_NPC_NOA_OBSERVER",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "네, 오해예요. 사건의 전말을 설명해 드리죠!",
