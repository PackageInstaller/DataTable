        }
      ]
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_LPU_POST_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_LPU_POST",
      "UnitTalk_KOR": " 관심이야 당연히 있어요!",
      "UnitTalk_JPN": "もちろんですよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_LPU_POST_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_LPU_POST",
      "UnitTalk_KOR": " 하지만 제가... 말하자면, 개인 사업자거든요. ",
      "UnitTalk_JPN": "でも…私って、個人事業主なんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_LPU_POST_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_LPU_POST",
      "UnitTalk_KOR": " 여정 훈련을 위해 자리를 비우면, 비운 만큼 버는 돈이 줄어들게 되니까요...",
      "UnitTalk_JPN": "だからトレーニングのために仕事を休むと、その分稼ぎが減ってしまいます…",
