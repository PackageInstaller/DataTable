    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "단장님, 돌아가면 따로 일정이 있으신가요?",
      "UnitTalk_JPN": "団長。この後、何か予定はありますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "없으시다면 캔들 스퀘어에서 간단하게 축하파티는 어떻습니까.",
      "UnitTalk_JPN": "もしなければ、キャンドル・スクエアでお祝いのパーティーを開くのはいかがですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "평가전을 대비해서 처리해야 할 업무들을 미리 끝내 두기도 했고…",
      "UnitTalk_JPN": "試験に備えて、処理すべき業務は事前に終わらせておきましたし…",
      "TalkTime": 0.03
    },
    {
