      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "가끔씩은 스트레스를 푸는 것도 좋으니까요.",
      "UnitTalk_JPN": "たまには、ストレスを発散することも大切ですしね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "…단장님이 말하셨듯이요. 후훗!",
      "UnitTalk_JPN": "…団長がおっしゃっていたように、です。ふふっ！",
      "TalkTime": 0.03
