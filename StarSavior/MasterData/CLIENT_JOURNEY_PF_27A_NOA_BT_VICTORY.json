      "CameraOffsetTime": "NR",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "…리디아, 너어…",
      "UnitTalk_JPN": "…リディア、あなた…",
      "TalkTime": 0.03
    },
    {
