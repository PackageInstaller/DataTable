    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": " 안녕! 여기서 볼 줄은 몰랐네!",
      "UnitTalk_JPN": "まさか、ここで会うとは思わなかったわ！"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "SMILE",
      "UnitPos": "POS4",
      "UnitTalk_KOR": " 반가운 존안을 뵙네요. 강녕하신지요, 단장 귀하.",
      "UnitTalk_JPN": "あら、ごきげんよう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "둘 다 와인 샵엔 어쩐 일이야?",
          "JumpAnchorStringId_JPN": "ワインショップで何してるんだ？"
        }
      ]
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "NORMAL"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 아, 에핀델은 내가 데려왔어.",
      "UnitTalk_JPN": "あっ、わたしがエピンデルを連れてきたの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": " 좋은 와인을 고르는 데 의견이 필요했거든.",
      "UnitTalk_JPN": "いいワインを選ぶのに、アドバイスしてもらおうと思って。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "와인에 취미를 붙여보려고?",
          "JumpAnchorStringId_JPN": "アセラ、ワインに興味があるの？"
        }
      ]
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": " 응?",
      "UnitTalk_JPN": "うん？",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": " 아하하! 아니, 아니. 내 게 아니라 선물용으로.",
      "UnitTalk_JPN": "あはは！そうじゃなくて、プレゼント用なの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "엄마의 생일이 다가오거든.",
      "UnitTalk_JPN": "もうすぐお母さんの誕生日だから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "비록 잠시 나온 입장이지만, 역시 딸이 엄마 생일에 아무 것도 안 할 순 없잖아?",
      "UnitTalk_JPN": "家を飛び出しちゃった身だけど、何もしない訳にはいかないでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "엄마가 와인을 좋아하는 건 아는데, 내가 아무래도 그 쪽으로는 조금 약해서 말야.",
      "UnitTalk_JPN": "お母さんがワインを好きなのは知ってるんだけど、わたしはワインなんてさっぱりだから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "USN_UI_TOUCH",
      "UnitTalk_KOR": " …하아. 스트라니스 영애. 이제 와서는 벽에다 말하는 기분이긴 합니다만.",
      "UnitTalk_JPN": "…はぁ。ストラニス嬢。今さらではありますが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": "<color=#F7BE45>귀족적 교양</color>의 결여를 그렇게 당당하게 밝혀야 할 필요가 있을까요?",
      "UnitTalk_JPN": "<color=#F7BE45>貴族の教養</color>が欠けているのを、堂々を明かすのは如何なものでしょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": " 응? 뭐 어때. 내가 즐기지 않는 것 뿐인걸.",
      "UnitTalk_JPN": "うん？まぁ、いいじゃない。わたしは興味ないんだもの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitTalk_KOR": "<color=#F7BE45>내가</color> 즐기지 않는다는 건 그렇게 중요하지 않답니다.",
      "UnitTalk_JPN": "<color=#F7BE45>自身</color>が興味があるかどうかは、重要ではありません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": " 남들이 보는 건 <color=#F7BE45>스트라니스가</color> 즐기지 않는다는 것 뿐이니까요.",
      "UnitTalk_JPN": "周囲からは、<color=#F7BE45>ストラニス家</color>の人間として見られるのですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": " 하하, 그렇게 말하는 에핀델도 옛날에 와인 한 병 슬쩍했을 때는 말이지?",
      "UnitTalk_JPN": "あはは。そういうエピンデルだって、昔ワインを一本こっそり持ち出したことがあるでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": " 귀족 아가씨는 이런 것도 마실 줄 알아야 한다면서 의기양양하게 한 잔 따르더니…",
      "UnitTalk_JPN": "貴族のお嬢様なら、こういうのも飲めるようにならないと！って、得意げに一杯注いだのに…",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": " 혀만 살짝 대고 눈물이 그렁그렁해져서는 ‘으엑, 아세라, 이거 너무 써!’ 하고~",
      "UnitTalk_JPN": "ちょっと口をつけただけで、「うえっ、アセラ、これ苦すぎ！」って涙ぐんでたわよね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": " 언제적 이야기를 하는 거예요?!",
      "UnitTalk_JPN": "いつの話をされているのですか！？",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": " 옛날엔 그렇게 귀여웠었는데 말야.",
      "UnitTalk_JPN": "昔は可愛かったのに…って話よ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "옛날엔 귀여웠구나.",
          "JumpAnchorStringId_JPN": "昔は可愛かったんだな…"
        }
      ]
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": " 훨씬 솔직하기도 했고.",
      "UnitTalk_JPN": "今よりずっと素直だったしね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "옛날엔 솔직했구나.",
          "JumpAnchorStringId_JPN": "昔は素直だったのか…"
        }
      ]
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": " …이야기 다 끝나셨으면 본론으로 돌아가도 될까요?",
      "UnitTalk_JPN": "…話が終わったなら、本題に戻りましょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 스트라니스 영애, 모친께서 즐기시는 와인의 이름을 혹시 기억하시나요?",
      "UnitTalk_JPN": "ストラニス嬢、お母上が嗜んでおられたワインの銘柄を、覚えていらっしゃいませんか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "음… 몰팅? 멜딩? 그런 이름이었던 것 같아.",
      "UnitTalk_JPN": "ん～…ミュリン？みたいな名前だったと思うんだけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": " …뮬팅엄 포도원의 와인은 드라이함과 묵직한 바디감으로 유명하죠.",
      "UnitTalk_JPN": "…ミュリンガムのワインは、辛口で重厚感のあるボディで有名です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_GRACE_DUALSWORD_01",
