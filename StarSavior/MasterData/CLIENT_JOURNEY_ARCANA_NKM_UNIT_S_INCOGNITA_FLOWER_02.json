    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INCOGNITA_FLOWER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "너.",
      "UnitTalk_JPN": "お前。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INCOGNITA_FLOWER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "만날 때마다 나한테 넘어지는 이유가 뭐야?",
      "UnitTalk_JPN": "会うたびに、私の方に倒れてくる理由は？",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_INCOGNITA_FLOWER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "다리가 저주받았어? 평형감각이 이상해?",
      "UnitTalk_JPN": "足に呪いでもかけられたのか？それとも、平衡感覚がおかしいのか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 78,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그건 아닌데…",
          "JumpAnchorStringId_JPN": "そういう訳じゃないけど…"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "우연히… 라고 할까…?",
          "JumpAnchorStringId_JPN": "偶然…っていうか…？"
        }
      ]
    },
    {
      "Uid": 80,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "하! 그러니까…",
      "UnitTalk_JPN": "ハッ！つまり…",
      "TalkTime": 0.03
    },
    {
      "Uid": 81,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "나만 만나면 이상할 정도로 <color=#F7BE45>우연히</color> 넘어져서-",
      "UnitTalk_JPN": "私に会うと、不思議なくらい<color=#F7BE45>偶然</color>転び──",
      "TalkTime": 0.03
    },
    {
      "Uid": 82,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "하필이면 <color=#F7BE45>우연히</color> 나를 덮치게 된다고?",
      "UnitTalk_JPN": "<color=#F7BE45>偶然</color>、私にのしかかってくると？",
      "TalkTime": 0.03
    },
    {
      "Uid": 83,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "세상 전체가 네 음흉한 욕구를 충족시키는 쪽으로 돌아간다…",
      "UnitTalk_JPN": "全世界が、お前の歪んだ欲求を満たすように回っている…",
      "TalkTime": 0.03
    },
    {
      "Uid": 84,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "뭐 그런거야?",
      "UnitTalk_JPN": "そういうことか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 85,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "본인이 말하면서도 이상하다고 생각하지 않아?",
      "UnitTalk_JPN": "自分で言ってて、おかしいと思わないわけ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 86,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "반복되는 우연은 우연이 아니라는 말, 못 들어봤어?",
      "UnitTalk_JPN": "繰り返される偶然は、偶然じゃないという言葉を知らないのか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 87,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그러게… 이상하네…",
          "JumpAnchorStringId_JPN": "そうだよね…おかしいよね…"
        }
      ]
    },
    {
      "Uid": 88,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "…<color=#F7BE45>그러게</color>가 아니라-",
      "UnitTalk_JPN": "…<color=#F7BE45>そうだよね</color>、じゃなく──",
      "TalkTime": 0.03
    },
    {
      "Uid": 89,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…흥. 됐어.",
      "UnitTalk_JPN": "…フン。もういい。",
      "TalkTime": 0.03
    },
    {
      "Uid": 90,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "말해봤자 내 입만 아프지.",
      "UnitTalk_JPN": "私の口が疲れるだけだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 91,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "앞으로 너. 내 반경 10미터 안쪽으로 접근하지 마.",
      "UnitTalk_JPN": "お前。これからは、私の半径10メートル以内に近づくな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 92,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "엇…?!",
          "JumpAnchorStringId_JPN": "えっ…！？"
        }
      ]
    },
    {
      "Uid": 93,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "우연을 가장해서 이상한 짓을 한 패널티야.",
      "UnitTalk_JPN": "偶然を装って、変なことをしたペナルティだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 94,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "애초에 근처로 오지 않으면 그런 일은 생길 수가 없잖아?",
      "UnitTalk_JPN": "そもそも近くに来なければ、起きないことだしな？",
      "TalkTime": 0.03
    },
    {
      "Uid": 95,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "우우…",
          "JumpAnchorStringId_JPN": "うぅ…"
        }
      ]
    },
    {
      "Uid": 96,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…하아. 그런 불쌍한 표정을 지어도 안 바꿔줄 거니까…!",
      "UnitTalk_JPN": "…はあ。そんな情けない顔をしても、変えてやらないから…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 97,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "처음부터 네가 조심했으면 되잖아?",
      "UnitTalk_JPN": "最初から、お前が気をつけていれば良かっただけの話だろう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 98,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "에데가 뒤를 돌아선 순간.",
      "UnitTalk_JPN": "エデが振り返った瞬間。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
