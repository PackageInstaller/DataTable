      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "최고야… 무릉도원이 있다면 여기겠지…",
      "UnitTalk_JPN": "最高だぁ…桃源郷があるとしたらここだね…",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "이제 좀 괜찮아지셨나요, 세르팡 사매?",
      "UnitTalk_JPN": "セルパン師妹、少しは良くなりましたか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "윽! 아야야! 아니, 아직…",
      "UnitTalk_JPN": "うっ！いたた！いや、まだみたい…",
      "TalkTime": 0.03
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래도 고마워, 린 사저… 덕분에 많이 나아졌어…",
      "UnitTalk_JPN": "でも、ありがとう…おかげでだいぶよくなったよ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "뭘요. 제가 할 수 있는 건 이런 것밖에 없는 걸요.",
      "UnitTalk_JPN": "いえ。私にできることは、これぐらいしかありませんから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "…동대륙에 있을 때가 생각나네요.",
      "UnitTalk_JPN": "…東大陸にいた頃を思い出しますね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "세르팡 사매가 몸져누울 때마다 제가 간병했잖아요? 후후, 옛날 이야기지만…",
      "UnitTalk_JPN": "セルパン師妹が寝込むたびに、私が看病していたでしょう？ふふ、昔の話ですが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그때도 제가 대신 아팠으면 좋겠다고 생각했는데… 지금도 같은 마음이네요.",
      "UnitTalk_JPN": "あの時も、私が代わってあげたいと思っていました…今も同じ気持ちです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "린 사저…",
      "UnitTalk_JPN": "リン師姉…",
      "TalkTime": 0.03
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "UnitTalk_KOR": "맞아. 어릴 때부터 내가 아플 때마다 린 사저가 돌봐줬지…",
      "UnitTalk_JPN": "小さい頃から、具合が悪くなる度にリン師姉が看病してくれたよね…",
      "TalkTime": 0.03
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "왜 그랬던 거야?",
      "UnitTalk_JPN": "なんでだったの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "네?",
      "UnitTalk_JPN": "はい？",
      "TalkTime": 0.03
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "나를 돌보느라 휴일에도 못 놀았잖아. 린 사저도 다른 애들처럼 놀고 싶었을 텐데…",
      "UnitTalk_JPN": "ボクの看病で、休みの日にも遊べなかったよね。リン師姉もみんなみたいに遊びたかったでしょ…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "UnitTalk_KOR": "누가 시킨 것도 아닌데 왜 나를 돌봐줬어?",
      "UnitTalk_JPN": "誰かに頼まれた訳でもなかったのに、なんでだったの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "사람을 돕는데 특별한 이유가 필요할까요? 도움이 필요한 사람이 있으면 돕는 게 인간의 도리죠.",
      "UnitTalk_JPN": "人助けに、特別な理由はいらないでしょう？困っている人がいれば、助けるのが人の道理ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "ONE_7",
      "UnitTalk_KOR": "그리고…",
      "UnitTalk_JPN": "そして…",
      "TalkTime": 0.03
    },
    {
      "Uid": 77,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "CameraOffset": "ONE_8",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그리고…?",
      "UnitTalk_JPN": "それに…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 78,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "세르팡 사매는 제게 소중한 사매이니까요.",
      "UnitTalk_JPN": "セルパン師妹は、私にとって大切な師妹ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "린 사저…",
      "UnitTalk_JPN": "リン師姉…",
      "TalkTime": 0.03
    },
    {
      "Uid": 80,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "응!",
      "UnitTalk_JPN": "うん！",
      "TalkTime": 0.03
    },
    {
      "Uid": 81,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "UnitTalk_KOR": "다 나았어. 이제 괜찮아.",
      "UnitTalk_JPN": "治ったよ。もう大丈夫。",
      "TalkTime": 0.03
    },
    {
      "Uid": 82,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "네? 벌써요?",
      "UnitTalk_JPN": "はい？もう治ったのですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 83,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_SWORDMASTER",
      "UnitTalk_KOR": "무리하는 거 아닌가요? 전에도 괜찮다고 했으면서 바로 쓰러지셨는데…",
      "UnitTalk_JPN": "無理をしているのではありませんか？以前も、大丈夫と言いながらすぐに倒れてしまいましたし…",
      "TalkTime": 0.03
    },
    {
      "Uid": 84,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.8,
      "BgCrashTime": 0.5,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "괜찮아! 그러니까 오늘 수련은 여기서 끝… 엣취!",
      "UnitTalk_JPN": "大丈夫！だから、今日の修練はこれでおし…クシュン！",
      "TalkTime": 0.03
    },
    {
      "Uid": 85,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_EASTERN_SWORDMASTER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_EASTERN_OWL",
      "UnitTalk_KOR": "으으… 쌀쌀해. 땀이 식어서 그런가…",
      "UnitTalk_JPN": "うぅ…寒い。汗が引いたからかな…",
      "TalkTime": 0.03
    },
    {
