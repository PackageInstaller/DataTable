  "Data": [
    {
      "Uid": 1,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "RewardAnchor": "REWARD_ANCHOR_1",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_CANDLE_GROUND.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_09.mp3",
      "CameraOffset": "TWIN_6"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "정시에 도착한 훈련장에는 카르멘의 모습이 보이지 않았다. ",
      "UnitTalk_JPN": "時間ピッタリに訓練場に着いたものの、カルメンの姿はなかった。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "항상 한발 이르게 도착해 몸을 풀곤 하던 그녀였기에 의아한 일이다. ",
      "UnitTalk_JPN": "いつもなら先に到着して、ウォーミングアップをしているのに…何かおかしい。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "약속 시간을 한참 넘겨 뒤늦게 도착한 카르멘은 급히 장비를 벗어 던지며 스트레칭을 시작했다. ",
      "UnitTalk_JPN": "約束の時間を大幅に過ぎてから到着したカルメンは、急いで装備を投げ捨てるとストレッチを始めた。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SERIOUS",
      "UnitPos": "POS3"
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "지각이라니. 너답지 않은데.",
          "JumpAnchorStringId_JPN": "遅刻だなんて、カルメンらしくないね。"
        }
      ]
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "죄송해요. 눈을 떠보니 이미 시간이 제법 늦었더라구요. ",
      "UnitTalk_JPN": "申し訳ありません。目を覚ました時点で、約束の時間をかなり過ぎてしまっていたのです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "혹시 어디 아파? 안색이 영 안 좋아 보여.",
          "JumpAnchorStringId_JPN": "体調が悪いとか？顔色も良くないよ。"
        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "아뇨. 조금 피로가 쌓였을 뿐인걸요.",
      "UnitTalk_JPN": "いえ。少し疲れが溜まっていただけですので。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후. 이 정도는 스트레칭 조금이면 금방 회복한답니다. ",
      "UnitTalk_JPN": "ふふっ。これくらい、軽いストレッチですぐに回復しますよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "훈련 일정에는 지장이 가지 않을 거예요. ",
      "UnitTalk_JPN": "トレーニングのスケジュールには、支障も出ないはずです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "훈련 일정은 아무래도 좋아.",
          "JumpAnchorStringId_JPN": "スケジュールなんて気にしなくていいよ。"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "몸 상태가 나쁠 때 제대로 쉬지 않으면 안 돼.",
          "JumpAnchorStringId_JPN": "調子が悪い時は、しっかり休まないと。"
        }
      ]
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "물론이죠. 알고 있답니다.",
      "UnitTalk_JPN": "もちろん、私も分かっていますよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "<color=#F7BE45>적절한 휴식은 효율적인 훈련에 필수적이다.</color>",
      "UnitTalk_JPN": "<color=#F7BE45>効率的なトレーニングには、適度な休息が不可欠だ</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "모나스티르 기사단의 훈련 매뉴얼을 손볼 때 확실히 적어뒀답니다.",
      "UnitTalk_JPN": "モナスティル騎士団のトレーニングマニュアルにも、追加した内容ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "제가 그걸 모를 리가 없죠. 후후.",
      "UnitTalk_JPN": "私が知らない訳がないでしょう？ふふっ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "훈련, 다시 시작할게요.",
      "UnitTalk_JPN": "さぁ、トレーニングを再開しましょうか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": false,
      "WaitTime": 0.0,
