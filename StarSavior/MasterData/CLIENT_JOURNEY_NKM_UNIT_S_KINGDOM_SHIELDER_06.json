      "TransitionControl": "OUT"
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 역시, 그녀의 모습이 평소와는 어딘가 다르다. ",
      "UnitTalk_JPN": "でもやっぱり、普段のカルメンとは様子が違った。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "가벼운 달리기에도 숨소리가 거칠고 이마에는 식은땀이 맺혀 있다. ",
      "UnitTalk_JPN": "軽いランニングでも息遣いが荒くなり、額には冷や汗が浮かんでいた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "언제나 그랬던 것처럼 여유를 부리는 모양이었지만… ",
      "UnitTalk_JPN": "いつもそうしてきた様に、余裕を見せようとしているが… ",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "몸은 거짓말을 하지 않는 법이다.",
      "UnitTalk_JPN": "体は嘘をつけないものだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFlashBang": 0.2,
      "BgCrash": 0.3,
      "BgCrashTime": 0.3,
      "StartFxSoundName": "SFX_BATTLE_COMMON_SWORD_HIT_12.wav"
    },
    {
      "Uid": 70,
      "WaitClick": false,
      "WaitTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SAD",
      "EmotionEffect": "EMARK",
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "방패를 휘두르던 카르멘이 균형을 잃고 넘어졌다. ",
      "UnitTalk_JPN": "カルメンは盾を振るうと、バランスを崩して転んでしまった。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "손에서 놓친 방패가 흙바닥에 뒹굴었다. ",
      "UnitTalk_JPN": "そして手から離れた盾が、地面に転がった。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": false,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_BATTLE_COMMON_BODYFALL_78.wav"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "읏…!",
      "UnitTalk_JPN": "うっ…！",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "괜찮아? 위험하잖아.",
          "JumpAnchorStringId_JPN": "大丈夫？危ないよ。"
        }
      ]
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…괜찮아요. 잠시 딴생각을 좀 한 것뿐이에요. ",
      "UnitTalk_JPN": "…大丈夫ですよ。少し考え事をしていただけです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "다음에는 조심할게요.",
      "UnitTalk_JPN": "次から気をつけますね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "카르멘.",
          "JumpAnchorStringId_JPN": "カルメン。"
        }
      ]
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "네?",
      "UnitTalk_JPN": "はい？",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "가끔은, 자신에게 솔직할 필요도 있는 거야.",
          "JumpAnchorStringId_JPN": "たまには、自分に正直にならないと。"
        }
      ]
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "…후후. 단장님. 갑자기 무슨 소리를 하시는 거예요. ",
      "UnitTalk_JPN": "…ふふっ。団長さん、突然どうされたのですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "전 언제나 자신에게든, 단장님에게든 솔직한걸요?",
      "UnitTalk_JPN": "私はいつでも…自分自身にも、団長さんにも正直ですよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "지금 네 모습은 누군가에 쫓기고 있는 것 같아.",
          "JumpAnchorStringId_JPN": "今のカルメンは、誰かに追われてるみたいだ。"
        }
      ]
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_05.mp3",
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "… ",
      "UnitTalk_JPN": "… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "어머, 그게 무슨 말씀이세요. ",
      "UnitTalk_JPN": "あら、何をおっしゃるのですか。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "저는 자랑스러운 모나스티르 기사단의 부단장이라구요?",
      "UnitTalk_JPN": "私は、誇り高いモナスティル騎士団の副団長なのですよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "그런 제가 누군가에게 쫓기는 것 같다니.",
      "UnitTalk_JPN": "そんな私が、誰かに追われているみたいだなんて。",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "단장님이 보시기에 제가 그 정도로 못 미더워 보이시나요? ",
      "UnitTalk_JPN": "団長には、私がそんな頼りなく見えているのですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "전 어떤 일이 일어나든 항상 여유롭게 대응할 수 있-",
      "UnitTalk_JPN": "私は何が起こっても、いつも余裕で対処し──",
      "TalkTime": 0.03
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "너도 이미 알고 있잖아. 무슨 말을 하는지.",
          "JumpAnchorStringId_JPN": "カルメンも分かってるでしょ？私が何を言ってるのか。"
        }
      ]
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "지금 너를 쫓는 건, 너 자신이야.",
          "JumpAnchorStringId_JPN": "今カルメンを追い詰めてるのは、カルメン自身だよ。"
        }
      ]
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "카르멘은 <color=#F7BE45>어떤 상황에서도 여유 있는 자신</color>이라는 틀에 자신을 가두고 있다. ",
      "UnitTalk_JPN": "カルメンは<color=#F7BE45>どんな状況でも、余裕のある自分</color>という型に、自分をはめ込んでいた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그렇기에 누구에게도 자신의 약한 모습을 보이고 싶지 않은 것이다. ",
      "UnitTalk_JPN": "だから、誰にも弱い姿を見せたがらないのだ。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "자신은 당연히 모두를 지킬 수 있는 방패로 보여야 하니까. ",
      "UnitTalk_JPN": "皆を護れる盾のように、振る舞わなければならないのだから。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "스스로에게조차 그런 최면을 걸며 자신을 채찍질하고 있다. ",
      "UnitTalk_JPN": "自分自身にまで催眠術をかけ、鞭を打ち続けている。  ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이대로는 그녀가 성장하기도 전에 스스로 무너져 내릴 것이 분명하다. ",
      "UnitTalk_JPN": "このままでは…カルメンは成長どころか、心が壊れてしまうに違いない。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "단장님…",
      "UnitTalk_JPN": "団長さん…",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그건 진짜 여유가 아니라 초조함을 감추기 위한 가면일 뿐이야.",
          "JumpAnchorStringId_JPN": "それは本当の余裕じゃなくて、焦りを隠すための仮面に過ぎないんだよ。"
        }
      ]
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "모두를 지켜야 할 방패가 먼저 부서져 버리면",
          "JumpAnchorStringId_JPN": "皆を護る盾が先に壊れたら…"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "누구도 지킬 수 없지 않을까?",
          "JumpAnchorStringId_JPN": "誰も護れないだろ？"
        }
      ]
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…후후. 네. 단장님 말이 맞아요. ",
      "UnitTalk_JPN": "…ふふっ。団長さんの言うとおりですね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "역시… 무리를 하고 있었나 봐요. ",
      "UnitTalk_JPN": "やはり…無理をしていたようです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "기사단의 부단장이라면… ",
      "UnitTalk_JPN": "騎士団の副団長なら… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "아무리 어려운 일에 부딪혀도 여유로운 모습을 보여야 한다고 생각했어요.",
      "UnitTalk_JPN": "どんな困難に直面しても、余裕溢れる姿を見せなければと思っていました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그래야 모두가 평정심을 잃지 않고 믿고 따를 수 있을 테니까 말이에요. ",
      "UnitTalk_JPN": "そうすれば皆が平常心を失わず…信じてついて来れるでしょうから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "아무에게도 들킨 적 없었는데…",
      "UnitTalk_JPN": "誰にも気づかれなかったのに…",
      "TalkTime": 0.03
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "어쩐지 단장님의 눈은 속일 수가 없네요.",
      "UnitTalk_JPN": "なぜか、団長さんの目はごまかせませんでした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "후후. 어째서일까요? 전에는 한 번도 이런 적이 없었는데. ",
      "UnitTalk_JPN": "ふふっ。どうしてでしょうね？こんなこと一度もなかったのに。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "오늘은… 이만 쉬도록 할게요. ",
      "UnitTalk_JPN": "今日は…もう休もうと思います。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitTalk_KOR": "카르멘은 전에 본 적 없는 복잡한 표정이 되어 돌아갔다. ",
      "UnitTalk_JPN": "カルメンは初めて複雑そうな顔を見せ、戻って行った。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "스스로 깨닫는 바가 있다면 좋을 텐데. ",
      "UnitTalk_JPN": "何か気づきを得られたならいいんだけど。 ",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_06",
      "WaitClick": false,
