      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "물론 그만큼 효과는 확실하지만요.",
      "UnitTalk_JPN": "もちろん、その分効果も間違いありませんが。",
      "TalkTime": 0.03
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
