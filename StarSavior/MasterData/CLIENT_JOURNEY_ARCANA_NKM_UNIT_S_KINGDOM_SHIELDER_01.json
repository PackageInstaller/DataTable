    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "최근 거리에 구호소가 여러 개 생기고 있다는 소문을 들었다.",
      "UnitTalk_JPN": "最近、街に救護所がいくつかできたという噂を聞いた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "잘은 모르지만 대륙 여기저기에서 재난이 많이 발생하고 있는 모양이다.",
      "UnitTalk_JPN": "詳しいことは分からないが、大陸のあちこちで災いが起こっているようだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "혹시 내가 도울 건 없을까 해서 그곳을 찾아가 보았다.",
      "UnitTalk_JPN": "私にも何かできることはないかと思い、救護所に向かってみた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "다들 조금만 기다려주세요! 구호품은 아직 많이 남았답니다.",
      "UnitTalk_JPN": "皆さん、少々お待ちください！救護品はまだたくさんありますので。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "카르멘?",
          "JumpAnchorStringId_JPN": "カルメン？"
        }
      ]
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아, 단장님이셨군요. ",
      "UnitTalk_JPN": "あら、団長さん？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "기사단 부단장이 직접 봉사활동 중인 거야?",
          "JumpAnchorStringId_JPN": "騎士団の副団長が、直々にボランティアしてるのか？"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "누군가를 돕는 일에는 직위나 이유가 필요 없는 법이죠.",
      "UnitTalk_JPN": "誰かを助けることに、職位や理由など必要ありませんから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "힘든 사람을 보고만 있을 수는 없으니까요.",
      "UnitTalk_JPN": "苦しんでいる人を放っておく訳にはいかないでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "자, 그럼… 거기 서 계시지만 말고…",
      "UnitTalk_JPN": "さぁ、それでは…そこに立っていらっしゃらないで…",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "여기 구호품들 좀 나눠 주시겠어요?",
      "UnitTalk_JPN": "この救護品を配ってくださいますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아, 알았어. 이걸 나눠주면 되는 건가?",
          "JumpAnchorStringId_JPN": "あっ、うん。これを配ればいいんだな？"
        }
      ]
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "네. 사람들이 생각보다 많으니까 수량 체크 확실히 하시고요.",
      "UnitTalk_JPN": "はい。たくさんの方がいらっしゃいますから、数量の確認もしっかりお願いしますね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "1인당 구호품 상자 하나에 수프 한 그릇씩이랍니다.",
      "UnitTalk_JPN": "一人につき…救護品ボックスひとつに、スープ一杯ずつです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "알겠어.",
          "JumpAnchorStringId_JPN": "分かった。"
        }
      ]
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "한동안 정신없이 구호품과 음식을 나눠주며 시간을 보냈다.",
      "UnitTalk_JPN": "しばらくの間、ひたすら救護品と食べ物を配った。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitTalk_KOR": "언니, 한 그릇 더 줘!",
      "UnitTalk_JPN": "お姉ちゃん、もう一杯ちょーだい！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_BOY"
      ],
      "UnitTalk_KOR": "나도, 나도!",
      "UnitTalk_JPN": "ぼくも、ぼくも！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "후후, 재촉하지 않아도 돼요. 아직 충분하니까.",
      "UnitTalk_JPN": "ふふっ。慌てなくても大丈夫ですよ。まだたくさんありますから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "자, 쏟아지지 않게 조심하세요.",
      "UnitTalk_JPN": "さぁ、こぼさないように気をつけるのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_BOY"
      ],
      "UnitTalk_KOR": "와~ 맛있다…! ",
      "UnitTalk_JPN": "わぁ～、おいしい…！ ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_BOY"
      ],
      "UnitTalk_KOR": "우리 엄마랑 해준 수프랑 똑같은데 전혀 달라!",
      "UnitTalk_JPN": "お母さんが作ってくれるスープとは全然違う！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitTalk_KOR": "맛의 비결이 뭐야?",
      "UnitTalk_JPN": "この美味しさの秘密はなに？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "음… 글쎄요. 딱히 특별할 건 없다고 생각하는데.",
      "UnitTalk_JPN": "んー…どうでしょう。特にないと思いますが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "굳이 말하자면 <color=#F7BE45>민간인용</color> 수프라서 그런 걸까요?",
      "UnitTalk_JPN": "しいて言えば、<color=#F7BE45>民間人用</color>のスープだからでしょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_BOY"
      ],
      "UnitTalk_KOR": "…그게 뭐야?",
      "UnitTalk_JPN": "…なにそれ？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_GIRL"
      ],
      "UnitTalk_KOR": "어려운 말은 몰라. 아무튼 맛있어!",
      "UnitTalk_JPN": "むずかしい言葉は分からないよ。でも、とにかくおいしいの！",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "민간인용이 아닌 수프도 따로 있는 거야?",
          "JumpAnchorStringId_JPN": "民間人用じゃないスープもあるの？"
        }
      ]
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "물론이죠.",
      "UnitTalk_JPN": "もちろんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "기사나 병사들을 위한 광기… 아니 <color=#F7BE45>전투 수프</color>도 있답니다.",
      "UnitTalk_JPN": "騎士や兵士のための戦闘狂…いえ、<color=#F7BE45>戦闘スープ</color>もあるんですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "맛은 조금 부족하지만 지친 병사들의 잠재된 힘을 끌어올리기엔 제격이죠.",
      "UnitTalk_JPN": "味は少し劣りますが、疲弊した兵士たちの力を引き出すのに最適なのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "마침 저쪽에 한 솥 만들어둔 게 있는데 드셔 보시겠어요?",
      "UnitTalk_JPN": "ちょうど作っておいたものがありますので、お召し上がりになりますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "좋아, 그럼 한 그릇 줄래?",
          "JumpAnchorStringId_JPN": "うん、じゃあ一杯お願いしてもいいかな？",
          "JumpAnchorId": "REWARD_ANCHOR_1"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "아니, 민간인용으로 충분한 것 같아…",
          "JumpAnchorStringId_JPN": "いや、民間人用で十分だよ…",
          "JumpAnchorId": "REWARD_ANCHOR_2"
        }
      ]
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_01",
      "JumpAnchorInfo": "JUMPANCHOR_1",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "확실히 그런 수프가 있다면 여정 단원에게도 도움이 될 것 같다.",
      "UnitTalk_JPN": "そんなスープがあるなら、旅の団員の役にも立ちそうだし。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 68,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "후후. 좋은 생각이세요.",
      "UnitTalk_JPN": "ふふっ、賢明な判断です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "잠시만 기다리세요 단장님.",
      "UnitTalk_JPN": "少しだけお待ちくださいね、団長さん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 70,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
