    },
    {
      "Uid": 466,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitTalk_KOR": "미안, 앉을 자리를 좀 만드느라.",
      "UnitTalk_JPN": "すまねぇ、座れるスペースを作ってた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 467,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "들어와도 돼.",
      "UnitTalk_JPN": "入っていいぞ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 468,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "할리의 방에 들어와 본 적은 처음이다.",
      "UnitTalk_JPN": "ハーレーの部屋に入るのは初めてだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 469,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "호그에 대한 서적, 호그 라이딩을 위한 장비, 폭신폭신한 호그 인형…",
      "UnitTalk_JPN": "ホッグに関する書籍に、ホッグ・ライディングのための装備、ふわふわなホッグのぬいぐるみまで…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 470,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "인형?",
          "JumpAnchorStringId_JPN": "…ぬいぐるみ？"
        }
      ]
    },
    {
      "Uid": 471,
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.3,
      "BgCrashTime": 0.4,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_SWOOSH_16.wav",
      "CutsceneClear": "CLEARUNIT"
    },
    {
      "Uid": 473,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "자, 잘못 본 거야, 단장.",
      "UnitTalk_JPN": "み、見間違いだ、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 474,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "잘 생각해. 상식적으로 나 같은 사나이의 방에 인형 같은 게 굴러다니겠냐고.",
      "UnitTalk_JPN": "よく考えてみろ。常識的に、俺みたいな漢の部屋にぬいぐるみなんてあるわけねえだろぉ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 475,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아니라고 하면 호그로 들이받을 기세다…",
      "UnitTalk_JPN": "違うと言えば、ホッグで突進されそうな勢いだ…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 476,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "크흠. 그만 두리번거리고 할 얘기나 말해 봐.",
      "UnitTalk_JPN": "こほん。もうキョロキョロするのはやめて、話をしようぜ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 477,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitTalk_KOR": "친구 집에 처음 초대받아 본 꼬마도 아니잖아, 단장이.",
      "UnitTalk_JPN": "ダチの家に初めて招待されたガキでもないんだしよぉ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 478,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "혼자 있을 때 어떻게 지내나 궁금했거든.",
          "JumpAnchorStringId_JPN": "一人でどう過ごしてるのかな、と思って。"
        }
      ]
    },
    {
      "Uid": 479,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "SAD",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "끄응…",
      "UnitTalk_JPN": "うーん…",
      "TalkTime": 0.03
    },
    {
      "Uid": 480,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "뭐, 보이는 대로야. 운전이 거친 편이라 장비가 상하기 쉽거든.",
      "UnitTalk_JPN": "ま、見ての通りだぜ。運転が荒い分、装備も傷みやすいからな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 481,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitTalk_KOR": "책은 그냥 장식품이고.",
      "UnitTalk_JPN": "本はただの飾りだしよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 482,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그 말과 다르게, 전공 서적처럼 두꺼운 책들은 손때가 잔뜩 묻어 있었다.",
