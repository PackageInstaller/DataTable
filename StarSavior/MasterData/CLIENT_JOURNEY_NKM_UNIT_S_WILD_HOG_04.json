      "UnitStrId": "NKM_UNIT_NPC_WILD_HOG",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "응? 다, 단장? 쉬는 날 아니었어?",
      "UnitTalk_JPN": "お？だ、団長？今日は休みじゃなかったのか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 462,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "여정 때문은 아니야.",
          "JumpAnchorStringId_JPN": "旅のことじゃなくて…"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "잠깐 얘기할 게 있어서.",
