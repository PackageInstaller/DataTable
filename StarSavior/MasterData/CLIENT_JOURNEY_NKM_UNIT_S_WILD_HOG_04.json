    {
      "Uid": 449,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "할리를 찾고 있어.",
          "JumpAnchorStringId_JPN": "ハーレーを探してるんだ。"
