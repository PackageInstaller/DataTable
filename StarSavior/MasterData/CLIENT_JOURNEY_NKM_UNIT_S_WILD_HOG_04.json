      "TalkTime": 0.03
    },
    {
      "Uid": 435,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "다들 웬일이야?",
