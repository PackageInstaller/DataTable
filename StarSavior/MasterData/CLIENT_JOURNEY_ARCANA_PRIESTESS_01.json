      "WaitTime": 0.0,
      "BgFileName": "DRAMA_ACTIVATE_ARCANA_2.prefab",
      "StartBgmFileName": "MUSIC_CUTSCENE_06.mp3"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": false,
      "WaitTime": 2.5
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그녀는 단 한 번도 선택한 적 없다.",
      "UnitTalk_JPN": "彼女は一度も選んだことがない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "성직자 가문에서 태어났기에 교인이 됐고,",
      "UnitTalk_JPN": "聖職者の家系に生まれたから信徒となり、",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "주변에서 추천하여 여교황의 자리에 올랐다.",
      "UnitTalk_JPN": "周囲の推薦で女教皇の座に就いた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "여교황은 욕심이 없다.",
      "UnitTalk_JPN": "女教皇には欲望がない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "식사부터 옷까지 교리만을 따를 뿐.",
      "UnitTalk_JPN": "食事から衣服まで教理のみに従う。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "기호나 취향이 없다. 여가 시간에는 가만히 앉아있는다. 줄 풀린 인형이나 마찬가지다.",
      "UnitTalk_JPN": "嗜好や好みはない。余暇にはじっと座っている。紐が解けた人形のようなものだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "인간과 동떨어진 존재. 인간의 형태를 한 무언가.",
      "UnitTalk_JPN": "人間から隔絶した存在。人間の形をした何か。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "인간은 이해할 수 없는 것들을 신비롭다고 생각하기에,",
      "UnitTalk_JPN": "人間は理解できないものを神秘的だと思うゆえに、",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "인간 같지 않은 인간은 그 덕에 신과 가장 가까운 자리에까지 올랐다.",
      "UnitTalk_JPN": "人間らしくない人間はそのおかげで神に最も近い地位にまで上り詰めた。",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_PRIESTESS_01",
      "WaitClick": false,
      "WaitTime": 0.7,
