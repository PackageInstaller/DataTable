    },
    {
      "Uid": 6,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_SHOP",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
