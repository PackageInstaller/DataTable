    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "혹시… 다른 사람은 없었나요?",
      "UnitTalk_JPN": "あの…他に、どなたかいらっしゃいませんでしたか？",
      "UnitTalk_TWN": "請問…你沒有看到其他人嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_10_DRUID_12.ogg"
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "이상한 소리인 건 아는데… 분명 누군가가 있었던 것 같아요.",
      "UnitTalk_JPN": "おかしな話だとは分かっているんですが…きっと、誰かいたと思うんです。",
      "UnitTalk_TWN": "我知道這聽起來很奇怪…但我總覺得剛才好像有人在。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_10_DRUID_13.ogg"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "네? 무슨 말씀이신가요?",
      "UnitTalk_JPN": "はい？どういう意味ですか？",
      "UnitTalk_TWN": "什麼？您在說什麼？",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "여기엔 처음부터 저희 외에는 아무도 없었습니다만.",
      "UnitTalk_JPN": "ここには最初から、私たち以外は誰もいませんでした。",
      "UnitTalk_TWN": "這裡從一開始就只有我們，沒有別人。",
      "TalkTime": 0.03
    },
    {
