  "_Version": 4,
  "Data": [
    {
      "Uid": 1,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_WELL_DIRAC.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_01.mp3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이걸로 마지막이군. ",
      "UnitTalk_JPN": "これで最後だな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "뭐, 이 몸이라면 가볍게 <color=#F7BE45>평가전</color>을 통과하겠지만 말이다. 크하하!",
      "UnitTalk_JPN": "まぁ、わがはいであれば、軽く<color=#F7BE45>最終試験</color>をクリアできるだろうがな。クハハ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "그 전에…",
      "UnitTalk_JPN": "そのまえに…団長",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "단장. 보여줄 게 있다.",
      "UnitTalk_JPN": "見せたい物があるのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "응?",
          "JumpAnchorStringId_JPN": "うん？"
        }
      ]
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "스칼렛은 상자에 담긴 <color=#F7BE45>벨라</color> 꽃잎을 보여주었다. ",
      "UnitTalk_JPN": "スカーレットは箱に入った<color=#F7BE45>ベラ</color>の花びらを見せた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그런데 저번과는 달리 화려한 문장이 그 위에 수놓아져 있다. ",
      "UnitTalk_JPN": "しかし前とは違い、その上には派手な刺繍が施されていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "소피아를 구했던 날 이후에, 자신감이 들어 용기를 내봤다. ",
      "UnitTalk_JPN": "ターニャを助けて以来、自信がついてやってみたのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "지금의 나라면 이걸 다룰 수 있을 것도 같다는 생각이 들었거든!",
      "UnitTalk_JPN": "今のわがはいであれば、これを扱えそうな気がしたのでな！",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "그리고 결과는 예상대로. 이번에는 바늘을 대도 부서지지는 않더군.",
      "UnitTalk_JPN": "そして結果は予想通り、今回は針を当てても壊れなかったぞ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "아직 조금만 집중이 흐트러지면 위험하지만… 그래도 시간을 충분히 들이면 괜찮아!",
      "UnitTalk_JPN": "少し集中が途切れるだけで駄目になるのだが…でも時間をかければ大丈夫なのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "그래서 부적을 하나 만들어 보고 있다. ",
      "UnitTalk_JPN": "それでお守りを一つ作ってみることにした。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "<color=#F7BE45>벨라르미니</color> 일족의 문장을 수놓은 부적이지. ",
      "UnitTalk_JPN": "<color=#F7BE45>ベラルミニ</color>一族の紋章を、刺繍として入れたお守りなのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "완성되면 단장, 네게 선물하마.",
      "UnitTalk_JPN": "完成したら団長、お主にプレゼントしよう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "어때, 기대되지? 흐하하!",
      "UnitTalk_JPN": "どうだ、楽しみだろう？フハハ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…이런 소중한 걸 날 줘도 되는 거야?",
          "JumpAnchorStringId_JPN": "こんな大事なものをもらってもいいの？"
        }
      ]
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "괜찮다. ",
      "UnitTalk_JPN": "いいのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "어차피 꽃잎 한 장으로는 옷을 만들 수도 없으니까!",
      "UnitTalk_JPN": "どうせ花びら一枚では服など作れないのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "결국 온전한 <color=#F7BE45>벨라</color>를 찾아내야 하는 건 내 몫이란 거지.",
      "UnitTalk_JPN": "結局のところ、無傷の<color=#F7BE45>ベラ</color>を見つけだすのは、わがはいの役目なのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그리고 더 중요한 건… 크흠! ",
      "UnitTalk_JPN": "そしてもっと大切なのは…コホン！",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "스칼렛은 잠시 목을 가다듬더니 입을 열었다.",
      "UnitTalk_JPN": "スカーレットは軽く咳払いをしてから、ゆっくり話した。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "<color=#F7BE45>우연은 진실의 가면이되 필연은 진실의 민낯이니</color>",
      "UnitTalk_JPN": "<color=#F7BE45>偶然は真実の仮面であり、必然は真実の素顔である。</color>",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "용족에게 널리 알려진 격언이야!",
      "UnitTalk_JPN": "竜族なら誰でも知っている格言なのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "인간 단장, 내가 <color=#F7BE45>대재단사</color>가 되겠다는 마음으로 테일리온을 가지고 <color=#F7BE45>용의 계곡</color>을 뛰쳐나온 것이 언제인지 아나?",
      "UnitTalk_JPN": "人間の団長よ、わがはいが<color=#F7BE45>大仕立屋</color>になろうと、テイリオンを持ち出し<color=#F7BE45>竜の谷</color>を出たのがいつだったか分かるか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "아마 네가 태어나기도 전이었을지도 몰라.",
      "UnitTalk_JPN": "多分お主が生まれる前だったかも知れない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "그럼에도 지금까지 어디로 가야 하는지 그 방향조차 감을 잡지 못하고 있었지.",
      "UnitTalk_JPN": "しかしながら、今だどこに行くべきかも見当さえつかなかったのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "그런데 너와 함께 <color=#F7BE45>여정</color>을 하는 이 1년. 단 1년 사이에 그 실마리를 잡았어. ",
      "UnitTalk_JPN": "しかしお主と<color=#F7BE45>救援の旅</color>をしていた1年。たった1年で手掛かりを掴めたのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "이건 절대 <color=#F7BE45>우연</color> 같은 게 아니다!",
      "UnitTalk_JPN": "これは単なる<color=#F7BE45>偶然</color>などではない！",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "네가 내 곁에 있었기에 일어난 <color=#F7BE45>필연</color>이지. ",
      "UnitTalk_JPN": "お主がわがはいの傍にいたから起きた、<color=#F7BE45>必然</color>なのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그리고… 용족에게는 <color=#F7BE45>필연은 또 다른 필연을 낳는다</color>는 격언도 있다!",
      "UnitTalk_JPN": "そして…竜族の間では<color=#F7BE45>「必然はさらなる必然を生む」</color>との格言もある！",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "어쩐지 네 녀석이랑 있으면 또 다른 <color=#F7BE45>필연</color>이 나를 <color=#F7BE45>대재단사</color>의 길로 이끌어줄 거란 예감이 드는구나.",
      "UnitTalk_JPN": "なぜだかお主といると、さらなる<color=#F7BE45>必然</color>がわがはいを<color=#F7BE45>大仕立屋</color>に導いてくれそうな予感がするのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그러니까! ",
      "UnitTalk_JPN": "だから！",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "넌 이걸 받을 자격이 있다.",
      "UnitTalk_JPN": "お主はこれを受け取る資格があるのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…",
          "JumpAnchorStringId_JPN": "…"
        }
      ]
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "…랄까! 으하하! 오랜만에 무게 좀 잡아봤더니 몸이 간질간질하구나! ",
      "UnitTalk_JPN": "…というか！ワハハ！久しぶりに真面目な話をしたら、こそばゆいな！",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "완성되면 바로 선물할 테니 기대하고 있어도 좋아!",
      "UnitTalk_JPN": "完成したら、すぐにくれてやるから期待して待っておれ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "<color=#F7BE45>평가전</color>에서 승리하면 오늘 저녁은 팬케이크 어떠냐! 물론 네가 만들어주는 걸로!",
      "UnitTalk_JPN": "<color=#F7BE45>最終試験</color>で勝利したら、今夜はパンケーキとしよう！もちろん作るのはお主だ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그래.",
          "JumpAnchorStringId_JPN": "いいよ。"
        }
      ]
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
      "UnitTalk_KOR": "음, 좋다!",
      "UnitTalk_JPN": "うむ、良し！",
      "TalkTime": 0.03
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SCISSORS_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "CURRENT_CHARACTER",
