      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_SAINTESS_DEMON_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "아앗! 설마 염치없이 나눠 달라고 할 생각은 아니겠지?!",
      "UnitTalk_JPN": "ああっ！まさか、図々しく分けてほしいとか言うんじゃないわよね！？",
      "TalkTime": 0.03
    },
    {
