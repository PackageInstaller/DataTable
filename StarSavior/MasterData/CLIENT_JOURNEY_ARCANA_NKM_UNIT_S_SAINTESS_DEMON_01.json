      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_SAINTESS_DEMON",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "깜짝이야…. 왜 그렇게 놀라.",
