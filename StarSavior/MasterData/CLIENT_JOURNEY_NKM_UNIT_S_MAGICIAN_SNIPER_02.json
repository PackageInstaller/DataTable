    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "클라리사는 흠잡을 데 없는 실력을 지녔다.",
      "UnitTalk_JPN": "クラリッサは、文句のつけようがない実力の持ち主だ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "카노푸스 경비대의 상급 저격수로 활약한 만큼 노련한 사격 실력과 초인적인 시력.",
      "UnitTalk_JPN": "カノプス警備隊でベテランスナイパーとして活躍していただけに、熟練した射撃技術と超人的な視力を誇る。",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "왜 <color=#F7BE45>여정 단원</color>으로 뽑혔는지 알 수 있는 솜씨였다.",
      "UnitTalk_JPN": "<color=#F7BE45>旅の団員</color>に選ばれたのも、納得がいく実力だった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만…",
      "UnitTalk_JPN": "だが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "그만 할래.",
      "UnitTalk_JPN": "もうやめよーっと。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "팔 아파. 지난 훈련에서 무리했나 봐.",
      "UnitTalk_JPN": "腕が傷むことだしね。この前のトレーニングで無理しちゃったみたい。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "우리 방금 왔어.",
          "JumpAnchorStringId_JPN": "今来たとこだよね。"
        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "훈련장에 들어온 지 30초도 되지 않았다.",
      "UnitTalk_JPN": "訓練場に着いてから、まだ30秒も経ってない。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "부탁이니 훈련에 진지하게 임해줘…",
          "JumpAnchorStringId_JPN": "お願いだから真剣にトレーニングしてくれ…"
        }
      ]
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이게 문제였다. 클라리사는 <color=#F7BE45>여정</color>을 통과할 실력과 잠재력이 있다.",
      "UnitTalk_JPN": "これが問題だった。クラリッサには、<color=#F7BE45>旅</color>をクリアする実力とポテンシャルがある。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 어째서인지 훈련만 시작하면 의욕을 잃고 마는 것이었다.",
      "UnitTalk_JPN": "しかし、なぜかトレーニングを始めるとやる気を失ってしまうのだった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아~ 미안. 정말 무리.",
      "UnitTalk_JPN": "あ～ゴメン。ホントにムリ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "처음에는 카노푸스 경비대의 훈련이랑 달라서 재밌었거든?",
      "UnitTalk_JPN": "最初はカノプス警備隊の訓練と違って面白かったんだけどさー。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "하지만 똑같은 것만 계속하니까 질려.",
      "UnitTalk_JPN": "同じことばっかりで飽きちゃった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그럼 오늘은 방패 훈련, 어때?",
          "JumpAnchorStringId_JPN": "だったら、今日は盾の訓練をしてみる？"
        }
      ]
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "너무해, 단장. 팔이 아프다고 했는데 무거운 걸 들라고?",
      "UnitTalk_JPN": "団長さん、ひどくなーい？腕が痛いって言ってるのに、重いものを持たせるの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그, 그럼 시약 훈련은?",
          "JumpAnchorStringId_JPN": "じ、じゃあ試薬のトレーニングは？"
        }
      ]
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하핫! 재미없을 것 같아.",
      "UnitTalk_JPN": "あははっ！絶対つまんないじゃん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…응, 응.",
      "UnitTalk_JPN": "…うんうん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "단장의 마음은 알겠어.",
      "UnitTalk_JPN": "団長さんの気持ちは分かったよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "<color=#F7BE45>여정</color>을 이끄는 책임자로서 <color=#F7BE45>여정 단원</color>을 올바른 길로 이끌어주고 싶겠지.",
      "UnitTalk_JPN": "<color=#F7BE45>旅</color>を率いる責任者として、<color=#F7BE45>団員</color>を正しい道に導きたいんだよね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "하지만 마음이 안 내키는데 어떡해야 좋을까? 음~",
      "UnitTalk_JPN": "でも、あたしは気が乗らないんだよね～。どうしようかな～？",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "좋은 생각났어!",
      "UnitTalk_JPN": "あ、いいこと思いついたよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "내기하자, 단장.",
      "UnitTalk_JPN": "団長さん、賭けしない？",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "내기?",
          "JumpAnchorStringId_JPN": "賭け？"
        }
      ]
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "맞아, 내기. 내 고향에서는 종종 내기를 걸거든.",
      "UnitTalk_JPN": "うんうん！あたしの故郷では、ときどき賭けをするの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "얼마나 잡을지, 누가 더 굉장한 사냥감을 잡을지 경쟁했지.",
      "UnitTalk_JPN": "誰が一番すごい獲物を捕まえられるかって、よく賭けてたよー。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "사격 내기는 제외. 내가 이길 게 뻔하니까.",
      "UnitTalk_JPN": "でも、射撃の賭けはしない。あたしが勝つに決まってるからね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "미안한 말이지만, 내가 사격 내기에서 져본 건 여태까지 단 1명밖에 없거든.",
      "UnitTalk_JPN": "だって…あたしが射撃で勝てなかったのは、たった一人だけなんだもん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그러니까 훈련 성적으로 내기하자!",
      "UnitTalk_JPN": "ってことで、トレーニングの成績で賭けようよ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "기록이 우수한 사람이 승리. 패자는 승자의 말에 절대 복종하기.",
      "UnitTalk_JPN": "スコアが高い人の勝ち！敗者は勝者に服従すること。",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_SNIPER",
      "UnitTalk_KOR": "예를 들어, 내가 승리하면 단장은 하루 종일…",
      "UnitTalk_JPN": "例えば、あたしが勝ったら…団長さんには一日中…",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
