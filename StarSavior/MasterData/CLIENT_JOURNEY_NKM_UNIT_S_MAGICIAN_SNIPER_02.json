        }
      ]
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
