      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "시작할까?",
      "UnitTalk_JPN": "さ、始めよっか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.3,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "설명해줘야지!",
          "JumpAnchorStringId_JPN": "説明してくれよーっ！"
        }
      ]
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아무튼 클라리사가 의욕을 내서 다행이다.",
      "UnitTalk_JPN": "何はともあれ、クラリッサがやる気になってくれてよかった。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_SNIPER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "적당히 클라리사의 승부욕을 자극하여 경쟁하면서 훈련을 시키면 되겠지.",
      "UnitTalk_JPN": "適度にクラリッサの競争心を刺激しながら、トレーニングをこなすことにしよう。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
