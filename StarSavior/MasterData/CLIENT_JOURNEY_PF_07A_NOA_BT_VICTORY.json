    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitQuickSet": true,
      "UnitTalk_KOR": "후… 후후… 후…",
      "UnitTalk_JPN": "ふ…ふふ…ふ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "흐하하하! 제법이지 않느냐! 위대한 용족인 이 몸을 넘어트리다니!",
      "UnitTalk_JPN": "ふははは！やるじゃないか！偉大なる竜族であるわがはいを転ばせるとは！",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "널! 이 몸과 대등한!",
      "UnitTalk_JPN": "お主を！わがはいと同等の！",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아, 아니… 생각해 보니 그 정도는 아니고…",
      "UnitTalk_JPN": "い、いや…そこまでではないか…",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "이 몸의 발목 양말 정도는 되는 구원자로 특별히 인정하도록 하마!",
      "UnitTalk_JPN": "わがはいの足首ソックス程度の救援者として、特別に認めてやるのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": false,
      "WaitTime": -1.0,
      "BgFlashBang": 0.2,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.5,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "TWIN_2",
      "CameraOffsetTime": "FA",
      "UnitQuickSet": true,
      "UnitPos": "POS3",
      "UnitTalk_KOR": "이제 막 여정을 시작한 단원에게 당했는데도 상당히 즐거워 보이네요, 스칼렛.",
      "UnitTalk_JPN": "旅を始めたばかりの団員に負けたというのに、ずいぶん楽しそうですね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "아, 아니 그게…",
      "UnitTalk_JPN": "あっ、いや、それは…",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "억울하다! 무덤쟁이도 진작 땅바닥을 굴러다니는데 어째서 나만 혼내는 것이냐!",
      "UnitTalk_JPN": "理不尽なのだ！墓石オタクだって地面を転げ回ってるというのに、どうしてわがはいだけが怒られるのだ！",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "CameraOffset": "TWIN_1",
      "CameraOffsetTime": "FA",
      "UnitMotion": "ANGRY",
      "UnitPos": "POS1",
      "UnitTalk_KOR": "근거 없는 음해는 그만둬 줄래?",
      "UnitTalk_JPN": "根も葉もない言いがかりはやめてくれる？",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitTalk_KOR": "너랑 다르게 난 가문의 전통을 이어받은 지성적인 저주술사야.",
      "UnitTalk_JPN": "あんたとは違って、私は家の伝統を継いだ由緒正しき呪詛師なの。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "천한 몸싸움이나 벌이는 난장판과는 근본부터 어울리지 않는다고.",
      "UnitTalk_JPN": "低俗な取っ組み合いをするような場所とは、根っから合わないんだってば。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffset": "TRIPLE_1",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "하아…",
      "UnitTalk_JPN": "はぁ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "아무래도 캔들 스퀘어의 수준 저하가 심각한 것 같군요.",
      "UnitTalk_JPN": "どうやらキャンドル・スクエアの水準も、深刻になってしまったようですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_07A_NOA_BT_VICTORY",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_BELL",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "EMARK"
    },
    {
