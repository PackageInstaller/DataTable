      "UnitStrId": "NKM_UNIT_NPC_MONOLITH_OLD_1",
      "UnitNameString": [
        "SI_PRIEST"
      ],
      "UnitTalk_KOR": "열지 않고 그대로 두는 것도 의미가 있겠지요.",
