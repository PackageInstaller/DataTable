      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…단장님? 왜 웃으시는 거예요?",
      "UnitTalk_JPN": "…団長？なんで笑ってるんですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_OFFICER_POLICE_10",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "안나는 정말 뼛속까지 타운가드구나 싶어서.",
          "JumpAnchorStringId_JPN": "生粋のタウンガードだなと思って。"
        }
