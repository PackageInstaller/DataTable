      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_OFFICER_POLICE",
      "UnitTalk_KOR": "…에헷, 그거야 뭐어! 그렇죠?",
      "UnitTalk_JPN": "…てへっ！それはまあ、もちろんですよ！",
      "TalkTime": 0.03
    },
