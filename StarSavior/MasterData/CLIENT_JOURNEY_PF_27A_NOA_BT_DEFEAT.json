    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 너도 알고 있을 거야.",
      "UnitTalk_JPN": "でも、貴方も分かっているでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이 정도도 해내지 못한다면… 그다음은 기대할 필요조차 없다는 걸.",
      "UnitTalk_JPN": "これすら成し遂げられないのであれば…その先を期待する価値すらないということを。",
