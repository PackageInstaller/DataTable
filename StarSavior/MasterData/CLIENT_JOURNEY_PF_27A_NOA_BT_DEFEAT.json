    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "너와, 네가 선택한 아이와, 식어가는 이 세계를 위해.",
      "UnitTalk_JPN": "貴方と、貴方が選んだ子と、冷えゆくこの世界のために。",
      "TalkTime": 0.03
    },
