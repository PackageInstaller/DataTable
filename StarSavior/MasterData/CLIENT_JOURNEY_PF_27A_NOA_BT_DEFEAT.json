      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_27A_NOA_BT_DEFEAT",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그럼 그때까지 잠시나마 편히 쉬렴.",
      "UnitTalk_JPN": "それまで少し休むことね。",
      "TalkTime": 0.03
