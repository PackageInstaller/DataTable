    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_GRACE_DUALSWORD_07",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_GRACE_DUALSWORD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 제게 축제란, 항상 말을 타고 지나가며 내려다보는 것이었거든요.",
      "UnitTalk_JPN": "私にとってお祭りは…馬に乗り、通り過ぎながら見下ろすものだったのです。",
