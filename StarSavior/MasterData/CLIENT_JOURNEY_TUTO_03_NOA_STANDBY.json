    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "안녕하세요, 단장님.",
      "UnitTalk_JPN": "こんにちは、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 본격적으로 <color=#F7BE45>[여정]</color>을 시작하시기 전에 <color=#F7BE45>[캔들 스퀘어]</color>에 대해 알려드리겠습니다.",
      "UnitTalk_JPN": "本格的に<color=#F7BE45>「救援の旅」</color>を始める前に、\n<color=#F7BE45>「キャンドル・スクエア」</color>についてご説明いたします。",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "TalkTime": 0.03,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "캔들 스퀘어? ",
          "JumpAnchorStringId_JPN": "キャンドル・スクエア？"
        }
      ]
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 네, 저희 NOA는 라비스타 각지의 구원자들을 지원하는 업무도 맡고 있습니다.",
      "UnitTalk_JPN": "はい、私たちNOAはラビスター各地の救援者を支援する業務も担っております。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 캔들 스퀘어는 그런 지원 업무를 담당하는 NOA의 주요 부서들 중 하나입니다.",
      "UnitTalk_JPN": "キャンドル・スクエアは、\nそういった支援業務を担当するNOAの主要部署の一つです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 부서에 소속된 메이드와 집사 분들이 구원자들을 위해 훈련장 대여, 물품 구매, 휴식처 제공 등 다양한 서비스를 제공하고 있어요.",
      "UnitTalk_JPN": "部署に所属するメイドや執事の方々が、救援者たちのために訓練場の貸し出し、\n物品の購入、休息場所の提供など、様々なサービスを提供しています。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": " 그리고 무엇보다 구원자들이 수행할 <color=#F7BE45>[의뢰]</color>를 중개하기도 하죠.",
      "UnitTalk_JPN": "そして何より、救援者たちが遂行する<color=#F7BE45>「依頼」</color>の仲介も行っています。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "TalkTime": 0.03,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "의뢰?",
          "JumpAnchorStringId_JPN": "依頼？"
        }
      ]
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 네, 캔들 스퀘어의 게시판에는 다양한 의뢰들이 공지되어 있답니다.",
      "UnitTalk_JPN": "はい、キャンドル・スクエアの掲示板には様々な依頼が掲示されています。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 그런 의뢰들을 완수하면 <color=#F7BE45>[보상]</color>을 받을 수 있어요.",
      "UnitTalk_JPN": "そうした依頼を完遂すると<color=#F7BE45>「報酬」</color>を受け取れます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 많은 보상을 받을수록 <color=#F7BE45>[여정]</color>을 위한 준비를 더 철저하게 할 수 있겠죠.",
      "UnitTalk_JPN": "報酬を得れば得るほど、<color=#F7BE45>「救援の旅」</color>の準備をより万全に整えられるでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 물론 의뢰만 지나치게 수행하다 보면 훈련에 소홀할 수도 있어요.",
      "UnitTalk_JPN": "もちろん依頼ばかりに夢中になりすぎると、\nトレーニングがおろそかになるかもしれません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 세상 일이 다 그렇지만 언제나 밸런스가 중요하답니다.",
      "UnitTalk_JPN": "世の中のことはどれもそうですが、常にバランスが大切なんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이해하셨나요?",
      "UnitTalk_JPN": "ご理解いただけましたか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "TalkTime": 0.03,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "대충 알 것 같아.",
