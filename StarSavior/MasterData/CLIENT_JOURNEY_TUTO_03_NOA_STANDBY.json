      ]
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "좋습니다.",
      "UnitTalk_JPN": "よろしいです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "더 자세한 것은 이곳 운영을 담당하시는 <color=#F7BE45>[선임 메이드]</color>님께서 설명해 주실 겁니다.",
      "UnitTalk_JPN": "より詳しいことは、こちらの運営を担当されている\n<color=#F7BE45>「ノーブルメイド」</color>が説明してくださるでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
