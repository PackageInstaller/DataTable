    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": " 네, <color=#F7BE45>[여정 단장]</color>은 전통적으로 보이저 구원단의 단장을 겸하도록 되어 있습니다.",
      "UnitTalk_JPN": "はい。<color=#F7BE45>「旅の団長」</color>は古くからの慣例でボイジャー救援団の団長も兼任しております。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": " 담당하는 여정 단원들도 보이저 구원단의 단원들로 자동 편입되죠.",
      "UnitTalk_JPN": "担当する団員たちもボイジャー救援団の団員として自動的に編入されます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_TUTO_03_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": " 행정처리를 위해서는 소속 구원단이 있는 편이 훨씬 편하니까요.",
      "UnitTalk_JPN": "行政処理のためには所属中の救援団がある方が何かしらと便利ですから。",
      "TalkTime": 0.03
    },
