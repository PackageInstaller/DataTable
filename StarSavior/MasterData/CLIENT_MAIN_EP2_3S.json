      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아무튼 너희들의 모습을 보니 남 일 같지 않구나.",
      "UnitTalk_JPN": "とにかくお主たちを見ていると、他人事とは思えないのだ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_018.wav"
    },
    {
      "Uid": 39,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "자 이리 가까이 오거라.",
      "UnitTalk_JPN": "ほら、耳を貸すのだ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_019.wav"
    },
    {
