    {
      "Uid": 32,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "역시 그런 거였냐?!",
