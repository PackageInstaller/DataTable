    },
    {
      "Uid": 5,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "오! 훈련장 말이냐?!",
      "UnitTalk_JPN": "おっ！訓練場か！？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_001.wav"
    },
    {
      "Uid": 6,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "물론 대여 가능하다! 인간!",
      "UnitTalk_JPN": "もちろん使えるのだ、人間よ！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_002.wav"
    },
    {
      "Uid": 7,
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "이 뿔 달린 소녀의 이름은 스칼렛.",
      "UnitTalk_JPN": "この角を生やした少女の名前はスカーレット。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 8,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "캔들 스퀘어에서 장비 및 장소 대여를 담당하고 있다고 한다.",
      "UnitTalk_JPN": "キャンドル・スクエアで備品や場所の貸し出しを担当しているそうだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 9,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그러면 대여를 하고 싶은데…",
          "JumpAnchorStringId_JPN": "それなら、貸し出しをお願いしたいんだが…"
        }
      ]
    },
    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "좋은 생각이구나! 인간!",
      "UnitTalk_JPN": "いい考えなのだ！人間よ！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_003.wav"
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "훌륭한 구원자가 되려면 평소에 땀을 흘리며 흙바닥을 굴러야 하는 법이지!",
      "UnitTalk_JPN": "立派な救援者になるには、普段から汗水を流して泥まみれにならないとな！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_004.wav"
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "잠시만 기다리거라. 여기 어딘가에 가격표가 있었는데…",
      "UnitTalk_JPN": "少し待つのだ。この辺に料金表があったはず…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_005.wav"
    },
    {
      "Uid": 13,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "가격표…?",
          "JumpAnchorStringId_JPN": "料金表？"
        }
      ]
    },
    {
      "Uid": 14,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "오, 여기에 있구나!",
      "UnitTalk_JPN": "おっ、あったのだ！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_006.wav"
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitTalk_KOR": "훈련장만 빌리면 대충… 이 정도.",
      "UnitTalk_JPN": "訓練場の貸し出しなら…これくらいの値段なのだ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_007.wav"
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "훈련 장비까지 한꺼번에 빌리면 할인도 가능하다는구나!",
      "UnitTalk_JPN": "訓練に必要な物を一緒に借りれば、割引もあるのだ！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_008.wav"
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "돈을 받아?!",
          "JumpAnchorStringId_JPN": "お金が必要なのか！？"
        }
      ]
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "그야 당연하지! 인간 세상에 공짜가 어디 있겠느냐?!",
      "UnitTalk_JPN": "当たり前なのだ！この世にタダで手に入るものなんて一つもないぞ！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_009.wav"
    },
    {
      "Uid": 19,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "위대한 용족인 이 몸도 그 정도는 알고 있느니라!",
      "UnitTalk_JPN": "偉大な竜族であるわがはいも、それぐらいは知っているのだ！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_010.wav"
    },
    {
      "Uid": 20,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…",
          "JumpAnchorStringId_JPN": "…"
        }
      ]
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "세상을 구하기 위한 준비를 하라면서 돈을 받는 건 무슨 생각일까?",
      "UnitTalk_JPN": "世界を救うための準備をしろと言いながら、お金を取るなんてどういうつもりだ…？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "생각할수록 부당하기 짝이 없지만 내가 빈털터리라는 사실은 변하지 않는다.",
      "UnitTalk_JPN": "どう考えても理不尽極まりないが、私が一文無しだという事実は変わらない。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 23,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그러고 보니 분명 아세라가 부잣집 딸이라고 했던 것 같은데…",
      "UnitTalk_JPN": "そういえば、確かアセラは金持ちの娘だと言ってたはずだが…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 24,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "…응? 왜 그래, 단장?",
      "UnitTalk_JPN": "…ん？どうしたの、団長？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_VOYAGER_STRANIS_001.wav"
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아니, 그런 쓰레기 같은 짓은 생각도 하지 말자.",
      "UnitTalk_JPN": "いや、アセラに頼るのは駄目だ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이 녀석은 내가 책임져야 할 단원이다.",
      "UnitTalk_JPN": "彼女は、私が面倒を見なければならない団員なのだから。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "혹시… 아르바이트 같은 건 없나?",
          "JumpAnchorStringId_JPN": "…アルバイトとかって、あるのか？"
        }
      ]
    },
    {
      "Uid": 28,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "아르바이트?",
      "UnitTalk_JPN": "アルバイト？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_011.wav"
    },
    {
      "Uid": 29,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitTalk_KOR": "글쎄, 그런 건 잘 모르겠는데…",
      "UnitTalk_JPN": "それはよく分からぬが…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_012.wav"
    },
    {
      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitTalk_KOR": "혹시 수중에 돈이 모자라는 게냐?",
      "UnitTalk_JPN": "ひょっとして、お金に困っているのか？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_013.wav"
    },
    {
      "Uid": 31,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "으음. 이제 막 창설한 구원단이다 보니…",
          "JumpAnchorStringId_JPN": "創設したばかりの救援団だからな…"
        }
