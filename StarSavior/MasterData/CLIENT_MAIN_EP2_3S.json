      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "원래 이러면 안 되긴 하지만…",
      "UnitTalk_JPN": "本来なら、こんなことしちゃいけないが…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_020.wav"
    },
    {
      "Uid": 41,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "처음이기도 하니 몰래 공짜로 처리해 주도록 하겠다.",
      "UnitTalk_JPN": "初めてだし、特別にタダで貸してやるのだ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_3_UNIT_S_MAID_SCISSORS_021.wav"
    },
    {
      "Uid": 42,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "정말이야? 고마워!",
