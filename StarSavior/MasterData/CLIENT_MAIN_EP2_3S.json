      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SCISSORS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "옛날 생각이 나는구나.",
