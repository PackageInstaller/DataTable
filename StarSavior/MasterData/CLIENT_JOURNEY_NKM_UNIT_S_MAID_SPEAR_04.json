      "AutoHighlight": "OFF"
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 어처구니없게도, 정말 한 무리의 멧돼지 떼가 쳐들어오고 있었다. ",
      "UnitTalk_JPN": "しかし信じられないことに、本当にイノシシの群れが押し寄せて来ていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
