      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "큼… 크흠! 사실 이 녀석들, 그냥 멧돼지가 아닙니다.",
      "UnitTalk_JPN": "コ…コホン！実はこの子たち、ただのイノシシではありません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "<color=#F7BE45>바이크 호그</color>라고 부르는 종류죠.",
      "UnitTalk_JPN": "<color=#F7BE45>バイクホッグ</color>という種類なんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>바이크 호그</color>?",
