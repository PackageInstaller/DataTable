      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAID_SPEAR",
      "UnitTalk_KOR": "주는 대로 잘도 받아먹네요.",
      "UnitTalk_JPN": "与えると、すぐにペロリと平らげてしまいましたよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAID_SPEAR_04",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…연료?",
