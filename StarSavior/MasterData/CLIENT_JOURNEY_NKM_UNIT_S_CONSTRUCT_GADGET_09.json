      "CameraOffset": "DEFAULT",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…준비되셨나요 단장님?",
      "UnitTalk_JPN": "…準備はできましたか、団長？",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_CONSTRUCT_GADGET_09",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
