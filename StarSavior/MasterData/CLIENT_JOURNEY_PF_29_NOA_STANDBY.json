        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "네. 힘든 <color=#F7BE45>[경쟁 평가전]</color>을 마친 단장님과 단원분에 대한 일종의 보상이기도 하죠.",
      "UnitTalk_JPN": "はい。厳しい<color=#F7BE45>「対人試験」</color>を終えた団長と団員への一種の報酬でもあります。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "합숙 훈련 장소는 두 가지가 준비되어 있어요.",
      "UnitTalk_JPN": "合宿トレーニングの場所は二つ用意されています。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "하나는 라비스타 남부의 반짝이는 해변 휴양도시 <color=#F7BE45>[플로라]</color>.",
      "UnitTalk_JPN": "一つはラビスター南部、きらめく海辺の海浜都市<color=#F7BE45>「フローラ」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "다른 하나는 눈과 온천으로 유명한 북쪽의 설원도시 <color=#F7BE45>[칼라이드]</color>.",
      "UnitTalk_JPN": "もう一つは、雪と温泉で有名な北部の雪原都市<color=#F7BE45>「カライド」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "EmotionEffect": "HEART",
      "UnitTalk_KOR": "둘 다 라비스타 최고의 휴양지들 중의 하나랍니다!",
      "UnitTalk_JPN": "どちらもラビスター最高のリゾート地の一つです！",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "물론 그저 놀기 위해 가는 건 아니에요.",
      "UnitTalk_JPN": "もちろん、ただ遊びに行くだけではありません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "각 도시에는 주변 환경을 이용한 특별한 훈련 프로그램이 준비되어 있습니다.",
      "UnitTalk_JPN": "各都市には、周辺環境を利用した特別なトレーニングプログラムが用意されています。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "훈련 방침에 따라 적절한 합숙 장소를 선택한다면 여정 단원의 성장에 큰 도움이 되겠죠.",
      "UnitTalk_JPN": "トレーニング方針に応じて適切な合宿場所を選べば、旅の団員の成長に大いに役立つでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "각 도시에 대한 자세한 내용은 NOA에서 발행하는 <color=#F7BE45>[여행신문]</color>을 참고해 주세요.",
      "UnitTalk_JPN": "各都市の詳細については、NOAが発行する<color=#F7BE45>「旅行新聞」</color>をご参照ください。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "어느 곳으로 <color=#F7BE45>[합숙 훈련]</color>을 갈지 결정하신 후 역에서 뵙도록 하겠습니다.",
      "UnitTalk_JPN": "どこへ<color=#F7BE45>「合宿トレーニング」</color>に行くか決めたら、駅で会いましょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_29_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
