      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "이렇게 바라보니까 별은 정말 높고 먼 곳에 있구나.",
      "UnitTalk_JPN": "こう見ると、星って本当に高くて遠いところにあるのね。",
      "TalkTime": 0.03
    },
