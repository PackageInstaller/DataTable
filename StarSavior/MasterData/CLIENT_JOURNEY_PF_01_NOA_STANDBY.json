      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_ASTRO_SANCTUM.png",
      "StartBgmFileName": "MUSIC_NOA.mp3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitQuickSet": true
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "안녕하세요, 단장님! 기다리고 있었습니다.",
      "UnitTalk_JPN": "こんにちは、団長！お待ちしておりました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "드디어 오늘부터 <color=#F7BE45>[여정]</color>이 시작되네요.",
      "UnitTalk_JPN": "ついに今日から<color=#F7BE45>「救援の旅」</color>が始まりますね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "단장님과 여정을 함께할 <color=#F7BE45>[여정 단원]</color>도 곧 만나게 되실 겁니다.",
      "UnitTalk_JPN": "旅を共にする<color=#F7BE45>「旅の団員」</color>にも、まもなくお会いできるはずですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "혹시 궁금하신 점이 있으실까요?",
      "UnitTalk_JPN": "何かご不明な点はございますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>[여정 단원]</color>은 어떤 사람인지 궁금한데.",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>「旅の団員」</color>って、どんな人なんだ？"
        }
      ]
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "자세한 정보는 따로 보고서를 드릴 예정입니다.",
      "UnitTalk_JPN": "詳細は、別途報告書でお伝えする予定です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "하지만 분명 장래가 기대되는 훌륭한 구원자 분이시겠죠?",
      "UnitTalk_JPN": "ですが、将来が期待される救援者であることは間違いありませんよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "<color=#F7BE45>[여정]</color> 참가 자격을 얻는 것부터 쉬운 일이 아니니까요.",
      "UnitTalk_JPN": "<color=#F7BE45>「救援の旅」</color>の参加資格を得ること自体、簡単なことではありませんから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "어떻게 뽑길래?",
          "JumpAnchorStringId_JPN": "団員はどうやって選ばれるんだ？"
        }
      ]
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "흐음… 그러니까…",
      "UnitTalk_JPN": "うーん…そうですね…",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "먼저 관측사 평의회 <color=#F7BE45>[폴라리스]</color>가 라비스타 전역의 구원자들 중 가장 적합하다고 판단되는 후보들의 리스트를 만드는 걸로 알고 있어요.",
      "UnitTalk_JPN": "まず<color=#F7BE45>「<r=ポラリス>観測士評議会</r>」</color>がラビスター全域の救援者の中から、最も適任な候補者のリストを作成するそうです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그 중 <color=#F7BE45>[알리시아]</color> 님이 최종 선정한 사람에게 초대장을 보내게 되죠.",
      "UnitTalk_JPN": "その中で、<color=#F7BE45>「アリシア」</color>様が最終的に選択された人物に招待状が送られます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "초대장을 받은 구원자가 초대를 수락하면 정식으로 <color=#F7BE45>[여정 단원]</color>으로서 등록돼요.",
      "UnitTalk_JPN": "そして救援者が招待に応じると、正式に<color=#F7BE45>「旅の団員」</color>として登録されます。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "참고로 <color=#F7BE45>[폴라리스]</color>의 보고서에 따르면 이번 단원은 유례없이 뛰어난 재능을 가진 구원자라고 하더군요.",
      "UnitTalk_JPN": "ちなみに<color=#F7BE45>「<r=ポラリス>観測士評議会</r>」</color>の報告書によると、今回の団員は桁外れの才能を持つ救援者だそうですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "물론 그 재능을 꽃피울 수 있을지는 단장님께 달려 있습니다.",
      "UnitTalk_JPN": "もちろん、その才能を開花させられるかどうかは、団長次第です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "저도 개인적으로 무척 기대하고 있어요.",
      "UnitTalk_JPN": "私も期待していますからね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그런데 왜 시험의 이름이 <color=#F7BE45>[여정]</color>이지?",
          "JumpAnchorStringId_JPN": "ところで、どうして<color=#F7BE45>「救援の旅」</color>って名前なんだ？"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": false,
      "WaitTime": 1.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK"
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "글쎄요, 잘은 모르지만 전해져 오는 이야기에 따르면…",
      "UnitTalk_JPN": "えっと、私も詳しくは知りませんが、昔から伝わる話では…",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "<color=#F7BE45>[여정]</color> 시험은 과거 <color=#F7BE45>[별의 구원자]</color>가 걸었던 여정을 모방해서 만들어졌다고 해요.",
      "UnitTalk_JPN": "<color=#F7BE45>「救援の旅」</color>試験は、かつて<color=#F7BE45>「星の救援者」</color>が歩んだ救援の旅に倣って作られたそうです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "별의 구원자가 남긴 힘을 계승하려면 그 분이 겪은 시련을 이겨낼 수 있어야 하니까요.",
      "UnitTalk_JPN": "星の救援者が遺した力を継承するには、同じ試練を乗り越えなければなりませんから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "최선을 다할게.",
          "JumpAnchorStringId_JPN": "精一杯やってみるよ。"
        }
      ]
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그런 만큼 <color=#F7BE45>[여정]</color>은 길고도 험난한 시험이에요.",
      "UnitTalk_JPN": "それだけ、<color=#F7BE45>「救援の旅」</color>は長く険しい試験ということです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "무사히 끝마치려면 싸움을 잘하는 것만으로는 부족하죠.",
      "UnitTalk_JPN": "無事に成し遂げるためには、戦闘力以外の面にも気を配らなければなりません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "체계적인 훈련은 물론, 재정 확보나 컨디션 관리 등 종합적인 운영 능력은 필수!",
      "UnitTalk_JPN": "体系的なトレーニングはもちろん、資金確保や体調管理など総合的な運用能力が必要になります！",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그리고 그 분야는 바로 단원을 이끌어 주는 단장님의 몫이에요.",
      "UnitTalk_JPN": "それこそ、団員を率いる団長の務めなんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "항상 말씀드리듯이, 중요한 건 밸런스니까요.",
      "UnitTalk_JPN": "いつもお伝えしている通り、大切なのはバランスですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "밸런스…",
          "JumpAnchorStringId_JPN": "バランス…"
        }
      ]
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "물론 단장님이라면 잘 해내실 거라고 생각합니다.",
      "UnitTalk_JPN": "もちろん団長なら、やり遂げてくださると信じていますよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "단장님은 <color=#F7BE45>[알리시아]</color> 님께서 직접 영입하신 여정 단장이니까요!",
      "UnitTalk_JPN": "だって、<color=#F7BE45>「アリシア」</color>様が直々に任命された旅の団長ですしね！",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "노력해 볼게.",
          "JumpAnchorStringId_JPN": "頑張ってみるよ。"
        }
      ]
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "좀 더 자신만만한 대사를 외쳐 주세요! 모두 단장님께 거는 기대가 크─",
      "UnitTalk_JPN": "もっと自信溢れる感じで言ってくださいよ！皆、団長のことを期待して──",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": false,
      "WaitTime": 1.5,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_CHIME_BELL_03.wav",
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SURPRISE",
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "앗, 시간이 벌써 이렇게...!",
      "UnitTalk_JPN": "あっ、もうこんな時間…！",
      "TalkTime": 0.03,
      "AutoHighlight": "LIGHT"
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "<color=#F7BE45>[여정 단원]</color>이 단장님을 오랫동안 기다리고 있을 것 같네요.",
      "UnitTalk_JPN": "<color=#F7BE45>「旅の団員」</color>が、お待ちになっているはずです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "궁금하신 점은 이후에도 제가 계속 설명드리겠습니다.",
      "UnitTalk_JPN": "他のことは、後ほど説明いたしますね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_01_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그럼 가실까요, 단장님?",
      "UnitTalk_JPN": "それでは、団長。行きましょうか？",
      "TalkTime": 0.03
    }
  ]
}
