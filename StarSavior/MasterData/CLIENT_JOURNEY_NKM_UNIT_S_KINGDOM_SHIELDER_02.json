      "BgCrashTime": 0.4,
      "StartFxSoundName": "SFX_BATTLE_COMMON_WHOOSH_SWORD_66.wav",
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "카르멘이 보란 듯이 방패와 검을 휘두르자 흙먼지가 마구 휘날렸다. ",
      "UnitTalk_JPN": "カルメンは誇らしげに盾と剣を振り回すと、土埃が激しく舞い上がった。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "과연 그녀의 동작은 군더더기 없이 깔끔했다. ",
      "UnitTalk_JPN": "やっぱりカルメンの動作は無駄がなく、洗練されている。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후. 어떤가요?",
      "UnitTalk_JPN": "ふふっ。どうですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그 해진 가죽 손잡이를 보니 얼마나 노력했는지 짐작이 가네. ",
          "JumpAnchorStringId_JPN": "革の持ち手もすり減ってるし、すごく努力したんだな。 "
        }
      ]
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나도 노력하지 않으면 안 되겠어.",
          "JumpAnchorStringId_JPN": "私も努力しないと。"
        }
      ]
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SAD",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "…",
      "UnitTalk_JPN": "…",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "어째서인지 순간 얼굴을 붉힌 그녀는 낡은 가죽 조각을 태연하게 뜯어버렸다. ",
      "UnitTalk_JPN": "なぜか一瞬顔を赤らめたカルメンは、古びた革の切れ端をあっさりと引きちぎった。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그리곤 아무것도 모른다는 표정으로 되묻는다. ",
      "UnitTalk_JPN": "そして、何もなかったかのような顔で聞き返した。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "글쎄요? 가죽 손잡이 같은 게 있었나요?",
      "UnitTalk_JPN": "えっと？革の持ち手なんてありましたっけ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…",
          "JumpAnchorStringId_JPN": "…"
        }
      ]
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그보다 단장님. 이제 보니 어깨가 너무 굳어 있으시네요. ",
      "UnitTalk_JPN": "それより、団長さん。こうして見ると、すごく肩が凝っているようですね？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "근육이 많이 뭉쳐 있어서 생기는 증상이죠. ",
      "UnitTalk_JPN": "肩こりは、筋肉が硬くなって起こる症状でしょう。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "후후. 그럴 땐 기사단 대대로 내려온 특별 스트레칭 코스가 효과적이랍니다. ",
      "UnitTalk_JPN": "ふふっ。こういう時は、騎士団に代々伝わる特別なストレッチが効果的なのですよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "이쪽으로 누워 보시겠어요?",
      "UnitTalk_JPN": "こちらに寝転がってくださるかしら？",
      "TalkTime": 0.03
    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_JOURNEY_KINGDOM_SHIELDER_01.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_16.mp3",
      "CutsceneClear": "CLEARUNIT"
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이, 이렇게?",
          "JumpAnchorStringId_JPN": "こ、こうやって？"
        }
      ]
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "적당히 자리를 잡고 엎드리자, 카르멘이 자연스럽게 내 등 위에 올라탔다. ",
      "UnitTalk_JPN": "適当な場所に寝転ぶと、カルメンが自然と私の背中の上に乗ってきた。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…?!",
          "JumpAnchorStringId_JPN": "…！？"
        }
      ]
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "으응? 왜 그러세요?",
      "UnitTalk_JPN": "んん？どうされましたか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "음? 자세 말인가요?",
      "UnitTalk_JPN": "うーん？姿勢のことでしょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "후후. 이렇게 하지 않으면 스트레칭을 제대로 해드릴 수가 없는 걸요. ",
      "UnitTalk_JPN": "ふふっ。こうしないと、ちゃんとストレッチをお手伝いできないんですもの。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "단장님… 무슨 생각을 하고 계신 거예요? 후후후. ",
      "UnitTalk_JPN": "団長さん…何を考えているのですか？ふふふっ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "딱히 아무 생각도 안 했어…!",
          "JumpAnchorStringId_JPN": "別に何も考えてないけど…！"
        }
      ]
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "후후… 정말인가요? ",
      "UnitTalk_JPN": "ふふっ…本当ですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "자자. 이상한 생각하지 마시고 힘 푸세요. ",
      "UnitTalk_JPN": "さぁさぁ。変なことは考えずに、力を抜いてくださいね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "숨 뱉으면서. 후우!",
      "UnitTalk_JPN": "息を吐きながら。ふぅー！",
      "TalkTime": 0.03
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "후읍! 그, 그만…",
          "JumpAnchorStringId_JPN": "ふぅーっ！も、もう止めよう…"
        }
      ]
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "후후. 아직 안 돼요. 조금만 더요.",
      "UnitTalk_JPN": "ふふっ。まだダメです。もうちょっとだけ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "몸이 이렇게 굳어서야 가동 범위도 좁아지고 부상의 위험도 커진답니다? ",
      "UnitTalk_JPN": "身体がこんなに凝り固まっていたら、可動域も狭まって怪我しやすくなるんですよ？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "어머, 다리 근육도 많이 뭉치셨네요.",
      "UnitTalk_JPN": "あら、脚の筋肉もすごく硬くなっていますね？",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "허벅지에 힘 푸시고 편안하게 저한테 몸을 맡겨주세요. ",
      "UnitTalk_JPN": "脚の力を抜いて、リラックスして私に身体を預けてください。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "그렇지. 좋아요. ",
      "UnitTalk_JPN": "そうそう。その調子です。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "음… 허리는 좀 어떠세요?",
      "UnitTalk_JPN": "うーん…腰はどうですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "뻐근하시다구요?",
      "UnitTalk_JPN": "凝っている、ですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "역시 이쪽도 근육이 뭉쳤네요. ",
      "UnitTalk_JPN": "やはり、こちらの筋肉も硬くなっていますね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "지금까지 했던 것처럼 숨 내쉬면서 후우…! ",
      "UnitTalk_JPN": "今まで通り、息を吐きながら…ふぅ…！ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "끄으윽…!",
          "JumpAnchorStringId_JPN": "くううっ…！"
        }
      ]
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "후후. 시원하시죠?",
      "UnitTalk_JPN": "ふふっ。気持ちいいでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 76,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "앞으로도 언제든 필요하시면 불러주세요.",
      "UnitTalk_JPN": "これから、いつでもおっしゃってくださいね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 77,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_CARMEN"
      ],
      "UnitTalk_KOR": "단장님을 위해서 제가 특별히 스트레칭 루틴을 가르쳐 드릴게요. ",
      "UnitTalk_JPN": "団長さんのためなら、私が特別なストレッチルーティーンを教えてあげますから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 78,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "카르멘의 스트레칭을 받은 후, 몸이 한결 가벼워진 것을 느낄 수 있었다. ",
      "UnitTalk_JPN": "カルメンのストレッチを受けた後、身体がずっと軽くなったのが感じられた。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 79,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "잘 배워두면 다음에는 내가 도움을 줄 수 있지 않을까? ",
      "UnitTalk_JPN": "しっかり覚えておけば、今度は私も手助けできるかも？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 80,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "기회가 되면 비법을 가르쳐달라고 해보자. ",
      "UnitTalk_JPN": "機会があれば、秘訣を教えてもらおう。 ",
      "TalkTime": 0.03,
      "DictionaryFinalCut": true
    },
    {
      "Uid": 81,
      "ContentsTag": "DEV_OPEN",
