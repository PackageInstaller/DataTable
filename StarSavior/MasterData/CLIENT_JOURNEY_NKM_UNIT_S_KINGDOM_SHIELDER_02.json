    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "꽤나 강도 높은 훈련이라고 생각했는데, 내 착각이었을까. ",
      "UnitTalk_JPN": "かなり強度の高い訓練だと思っていたが、私の勘違いだったのか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "카르멘은 마지막 공격까지 여유롭게 막아낸 뒤 방패를 내려놓았다. ",
      "UnitTalk_JPN": "カルメンは余裕そうに最後の攻撃まで防いだ後、盾を下ろした。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": false,
      "WaitTime": 0.5,
      "BgCrash": 0.5,
      "BgCrashTime": 0.5,
      "StartFxSoundName": "SFX_BATTLE_COMMON_POP.wav",
      "CameraOffset": "TWIN_6"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그 방패… 도대체 무게가 얼마나 나가는 거야?",
          "JumpAnchorStringId_JPN": "その盾…一体どれくらい重いの？"
        }
      ]
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitPos": "POS3",
      "UnitTalk_KOR": "모나스티르 기사단의 전투 방패는 튼튼한 만큼 무겁기로 유명하죠.",
      "UnitTalk_JPN": "モナスティル騎士団の盾は、丈夫で分重いことで有名なのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "궁금하시면 한번 들어보실래요? 후후.",
      "UnitTalk_JPN": "気になるようであれば、一度お持ちになってみますか？ふふっ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그렇게 말하는 것 치고는 가볍게 휘두르던데.",
          "JumpAnchorStringId_JPN": "そう言う割には、軽く扱ってるけど。"
        }
      ]
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "후후. 이 정도는 여유로워요.",
      "UnitTalk_JPN": "ふふっ。これくらい余裕ですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "전 기사단의 방어를 책임지는 역할을 맡고 있으니까요.",
      "UnitTalk_JPN": "私は、騎士団の防御を担う役割なんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단원들이 불안해하지 않도록 여유로운 모습을 보일 수밖에 없죠.",
      "UnitTalk_JPN": "団員たちが不安にならないように、余裕ある姿を見せるしかないのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "부단장인 제가 고작 이 정도 무게로 힘들어해서야 단원들이 믿고 싸울 수 있을 리 없으니까요. ",
      "UnitTalk_JPN": "副団長の私がこの程度の重さで音を上げていたら、団員たちは安心して戦うことができないでしょう？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": " 그리고 솔직히 말씀드리면 제게는 그리 무겁지도 않답니다.",
      "UnitTalk_JPN": " それに正直、私にとってはそんなに重くもないのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "이 정도로 무겁다고 불평하실 정도라면…",
      "UnitTalk_JPN": "この程度で重いと駄々をこねるほどなら…",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "단장님, 더 열심히 단련하셔야겠는걸요? ",
      "UnitTalk_JPN": "団長さん、もっと一生懸命鍛えないといけないでしょうね？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgCrash": 0.5,
      "BgCrashTime": 0.5,
      "UnitTalk_KOR": "시험 삼아 그녀의 방패를 들어 올려보았지만, 엄청난 무게에 압도당하고 말았다. ",
      "UnitTalk_JPN": "試しに盾を持ち上げようとしてみたが、あまりの重さに圧倒されてしまった。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이런 물건을 그렇게 자유자재로 다룬다고? ",
          "JumpAnchorStringId_JPN": "これを自由自在に扱ってるのか？ "
        }
      ]
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "거뜬하답니다. ",
      "UnitTalk_JPN": "容易いものですよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "필요하다면 추가로 두 사람 정도는 업고 뛸 수도 있죠. ",
      "UnitTalk_JPN": "必要であれば、さらに二人ほど背負って走ることもできます。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "전장에 선 단원들 모두를 안전하게 지켜내는 게 제가 할 일이니까요. ",
      "UnitTalk_JPN": "戦場に立つ団員を皆、護り抜くことが私の役割ですから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_02",
      "WaitClick": false,
