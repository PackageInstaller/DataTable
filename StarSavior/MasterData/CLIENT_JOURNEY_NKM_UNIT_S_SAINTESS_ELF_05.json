    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이게 뭐야?",
          "JumpAnchorStringId_JPN": "何これ？"
        }
