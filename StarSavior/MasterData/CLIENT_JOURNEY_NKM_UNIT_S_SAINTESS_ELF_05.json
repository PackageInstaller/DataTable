    {
      "Uid": 4,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "여정의 나날이 계속되던 어느 날.",
      "UnitTalk_JPN": "旅を続けていた、ある日。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
