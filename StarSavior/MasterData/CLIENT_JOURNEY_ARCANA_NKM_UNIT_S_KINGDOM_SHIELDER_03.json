      "StartBgmFileName": "MUSIC_CUTSCENE_15.mp3"
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": false,
      "WaitTime": 0.7,
      "BgFadeOutCol": [
        "1",
        "1",
        "1",
        "0"
      ],
      "BgFadeOutTime": 0.7
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "광장을 걷고 있는데, <color=#F7BE45>아포칼립스 상단</color>의 상점 입구 근처를 서성이고 있는 카르멘을 발견했다. ",
      "UnitTalk_JPN": "広場を歩いていると…<color=#F7BE45>アポカリプス商会</color>の店の入口辺りを、ウロウロしているカルメンの姿が見えた。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "남은 경비에서 돌아갈 기차푯값 빼고… 조금 모자란가?",
      "UnitTalk_JPN": "残った経費から帰りの汽車代を引くと…少し足りないかしら？",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "앗, 단장님. 안녕하셨나요?",
      "UnitTalk_JPN": "あっ、団長さん。お久しぶりです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "응. 오랜만이야. 무슨 일 있어? ",
          "JumpAnchorStringId_JPN": "うん、久しぶり。何してるの？ "
        }
      ]
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "별일 아니에요. 그냥 기념품 같은 걸 좀 살까 고민하던 중이었어요. ",
      "UnitTalk_JPN": "大したことではありませんよ。ただ、お土産を買おうかと悩んでいたところでした。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "공국으로 복귀하면 한동안은 NOA에 방문하기 어려울 테니까요.",
      "UnitTalk_JPN": "公国に復帰すれば、しばらくはNOAを訪れるのも難しいでしょうから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이제 돌아가는구나.",
          "JumpAnchorStringId_JPN": "もう帰るんだね。"
        }
      ]
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "네. 아마 다음주면 기사단으로 복귀할 예정이에요.",
      "UnitTalk_JPN": "はい。来週には、騎士団に復帰する予定なのです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "NOA에 머물고 있는 이유도 공무수행 때문이었으니까요.",
      "UnitTalk_JPN": "NOAに滞在していたのは、公務執行のためでしたから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "처리하고 있는 일이 마무리되면 다시 돌아가야죠. ",
      "UnitTalk_JPN": "業務を終えれば、戻らなければなりません。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "여유가 생기면 한번 방문해 볼게.",
          "JumpAnchorStringId_JPN": "また余裕ができたら、公国に遊びに行くよ。"
        }
      ]
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "후후. 기대할게요.",
      "UnitTalk_JPN": "ふふっ。楽しみにしていますね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그런데 왜 자꾸 상점 쪽을 힐끗거리는 거야?",
          "JumpAnchorStringId_JPN": "ところで、さっきから店の方をチラチラ見てない？"
        }
      ]
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "정말 아무 일 없는 거 맞아?",
          "JumpAnchorStringId_JPN": "本当に何もないの？"
        }
      ]
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SAD",
      "EmotionEffect": "THINK",
      "UnitTalk_KOR": "아…",
      "UnitTalk_JPN": "あっ…",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "실은 <color=#F7BE45>아포칼립스 상단</color> 상점에 신경 쓰이는 물건이 하나 있거든요. ",
      "UnitTalk_JPN": "実は…<color=#F7BE45>アポカリプス商会</color>のショップに、気になるものがあるんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "그걸 어떻게 해야 할지 고민이 돼서…",
      "UnitTalk_JPN": "それを、どうすべきかと悩んでいて…",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "신경 쓰이는 물건이라니? 그게 뭔데?",
          "JumpAnchorStringId_JPN": "気になるものって？"
        }
      ]
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "저기 있는 작은 펜던트 보이시나요?",
      "UnitTalk_JPN": "あそこに、ペンダントがあるでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "카르멘이 상점의 진열대 한구석을 가리켰다. ",
      "UnitTalk_JPN": "カルメンは、ショーケースの一角を指差した。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "반짝거리는 장신구들 사이에 투박하게 생긴 은제 펜던트 하나가 섞여 있다. ",
      "UnitTalk_JPN": "キラキラと輝くアクセサリーの間に、シルバーの素朴なペンダントが混ざっていた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "별 모양의 꽤나 흔해 빠진 디자인. 게다가 오랫동안 관리를 받지 못했는지 거뭇거뭇한 얼룩까지 졌다.  ",
      "UnitTalk_JPN": "星の形をした、よくあるデザイン。しかも長い間放置されていたのか、変色して黒ずんでいた。  ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "딱히 좋은 물건 같아 보이진 않는데.",
          "JumpAnchorStringId_JPN": "特に良いものでもなさそうだけど。"
        }
      ]
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아, 제가 쓰려고 사려는 게 아니에요.",
      "UnitTalk_JPN": "あっ、私が着けようという訳ではないのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그럼?",
          "JumpAnchorStringId_JPN": "だったら？"
        }
      ]
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "저희 기사단 옛 동료가 쓰던 물건 같아서요.",
      "UnitTalk_JPN": "あれは、騎士団の仲間のものだと思うんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "그 동료가 항상 차고 다니던 물건이라서 기억하고 있죠.",
      "UnitTalk_JPN": "その仲間がいつも着けていたものなので、覚えているのですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "혹시나 본인이 판매한 걸 수도 있지 않아?",
          "JumpAnchorStringId_JPN": "本人が売った可能性もあるんじゃない？"
        }
      ]
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "음… 그럴 일은 없어요. 그 동료는 이제 저희 곁에 없거든요. ",
      "UnitTalk_JPN": "んー…それはありえないのです。その仲間は、もう私たちの傍にはいませんから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…그런 물건이 어쩌다 여기까지 오게 된 걸까.",
          "JumpAnchorStringId_JPN": "…そんなものが、どうしてここにあるんだろう。"
        }
      ]
    },
    {
      "Uid": 49,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "글쎄요. 전장에서 잃어버렸을 수도 있고… ",
      "UnitTalk_JPN": "どうでしょうか。戦争で無くしてしまったのかもしれませんし… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "어쩌면 동료의 가족 중 누군가 상인에게 팔았을지도 모르죠. ",
      "UnitTalk_JPN": "もしかすると、仲間の家族が商人に売ったのかもしれません。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "이런 일이 아주 없는 일은 아니니까요. ",
      "UnitTalk_JPN": "こんなことも、珍しいことではありませんから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그런데 그걸 왜 사려고 하는 거야?",
          "JumpAnchorStringId_JPN": "それなら、何で買おうとしてるんだ？"
        }
      ]
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아, 공국 기사단에서는 물건에 주인의 흔적이 새겨져 있다고 생각해요. ",
      "UnitTalk_JPN": "あっ。公国騎士団では、ものには持ち主の痕跡が残っていると考えるんです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "그래서 자잘한 장비를 물려받거나 하는 일도 많아요. ",
      "UnitTalk_JPN": "そのため、細々とした装備を受け継ぐことも多く… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "동료의 잔으로 벌꿀주를 나눠 마시기도 하구요. ",
      "UnitTalk_JPN": "仲間のグラスでハチミツ酒を飲むこともあるのですよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "그 동료가 수호천사가 되어 전장에서 자신을 지켜주길 바라면서요.",
      "UnitTalk_JPN": "その仲間が守護天使となり、戦場で護ってくれることを祈りながら、です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "의미가 많은 물건이구나, 기사단원에게는.",
          "JumpAnchorStringId_JPN": "騎士団にとっては大切なものなんだね。"
        }
      ]
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "다른 사람에게 팔리기 전에 사는 게 어때?",
          "JumpAnchorStringId_JPN": "他の人が買う前に、買っておいた方がいいんじゃない？"
        }
      ]
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "사실 준비한 경비가 거의 다 떨어진 상황이라서요. ",
      "UnitTalk_JPN": "実は、手持ちの経費があまり残っていないのです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "후후. 이럴 줄 알았으면 모아둔 돈을 조금 더 가져올 걸 그랬어요. ",
      "UnitTalk_JPN": "ふふっ、こんなことになるなんて。貯金していたお金を持ってくるべきでしたね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "카르멘은 별수 없다는 듯 쓰게 웃었다. ",
      "UnitTalk_JPN": "カルメンはどうしようもないとでも言うように、苦笑いした。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "의미가 있는 물건이라면, 내가 사 줄게.",
          "JumpAnchorStringId_JPN": "意味があるものなら、私が買ってあげるよ。",
          "JumpAnchorId": "REWARD_ANCHOR_1"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "뒤늦게 후회하기보다는 마음이 가는 대로 하는 게 좋아.",
          "JumpAnchorStringId_JPN": "後になって後悔するよりも、自分の気持ちに従う方がいいよ。",
          "JumpAnchorId": "REWARD_ANCHOR_2"
        }
      ]
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "JumpAnchorInfo": "JUMPANCHOR_1",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후. 그러지 않으셔도 된답니다. ",
      "UnitTalk_JPN": "ふふっ。お気になさらないでください。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "단장님께 그런 실례를 끼쳐드릴 수는 없죠. ",
      "UnitTalk_JPN": "団長さんに、ご迷惑をおかけするわけにはいきませんから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "괜찮아. 작별 선물이라고 치자.",
          "JumpAnchorStringId_JPN": "大丈夫。お別れのプレゼントってことにしよう。"
        }
      ]
    },
    {
      "Uid": 69,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_APOCALYPSE_MALE_1",
      "UnitNameString": [
        "SI_TRADER"
      ],
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "아이고, 계산입니까? 금방 해드려야죠. 펜던트네요. 어디 보자 가격표가… 응…?",
      "UnitTalk_JPN": "お買い上げでしょうか？少々お待ちくださいね。このペンダントの値札は…あれ…？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 71,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "왜 그러시죠? 무슨 문제라도 있나요?",
      "UnitTalk_JPN": "どうされましたか？何か問題でもあるのでしょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 72,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_APOCALYPSE_MALE_1",
      "UnitNameString": [
        "SI_TRADER"
      ],
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "이거 어디에서 찾으셨습니까, 손님?",
      "UnitTalk_JPN": "お客様。この商品、どちらにありましたか？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 73,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "저기 진열대에 있던 물건인데…?",
          "JumpAnchorStringId_JPN": "そこのショーケースだけど…？"
        }
      ]
    },
    {
      "Uid": 74,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_APOCALYPSE_MALE_1",
      "UnitNameString": [
        "SI_TRADER"
      ],
      "UnitTalk_KOR": "흠… 이런 건 상품화가 덜 되어서 진열이 안 되는 물건인데.",
      "UnitTalk_JPN": "ふむ…商品として並べることのできない状態なのに…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 75,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_SHIELDER_03",
      "WaitClick": true,
