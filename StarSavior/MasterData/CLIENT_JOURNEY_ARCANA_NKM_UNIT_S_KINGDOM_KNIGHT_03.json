      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_KINGDOM_KNIGHT_03",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_PRAY",
      "UnitMotion": "ANGRY",
      "UnitPos": "POS8",
      "UnitTalk_KOR": "에…에잇! 진짜! 샤를은 그런 거 너무 신경 쓰는 거라니까!",
      "UnitTalk_JPN": "え…ええい！シャルルはちゃっちい事を気にしすぎるのよ！",
      "TalkTime": 0.03
    },
    {
