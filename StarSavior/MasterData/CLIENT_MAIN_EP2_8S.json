      "TalkVoice": "MAIN_EP2_8_UNIT_S_VOYAGER_SMILE_005.wav"
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "요약하면 꽤 중요한 시설이라는 거군.",
      "UnitTalk_JPN": "つまり、かなり重要な施設ということだな。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그런데 그런 곳에 왜 저런… 괴물들이 어슬렁거리는 걸까?",
      "UnitTalk_JPN": "しかし、そんな場所になぜ…怪物がうろついているんだ？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
