    {
      "Uid": 118,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "히익! 스, 스마일?",
          "JumpAnchorStringId_JPN": "ヒィーッ！ス、スマイル？"
        }
      ]
    },
    {
      "Uid": 119,
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "한밤중에 내 숙소에 쳐들어온 스마일이 내 몸을 흔들며 깨우고 있었다.",
      "UnitTalk_JPN": "真夜中に私の部屋へと入ってきたスマイルが、身体を揺すり起こそうとしていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 120,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "침대에서 일어난 나는 놀란 마음을 진정시키며 물었다.",
      "UnitTalk_JPN": "ベッドから起き上がった私は、心を落ち着かせて尋ねた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 121,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "이 시간에 대체 무슨 일이야?",
          "JumpAnchorStringId_JPN": "こんな時間に、一体どうしたの？"
        }
      ]
    },
    {
      "Uid": 122,
      "WaitClick": true,
      "WaitTime": 0.0,
      "EndBgmFileName": "MUSIC_CUTSCENE_10.mp3",
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "조금 전 새로운 웃음 촉매제를 완성.",
      "UnitTalk_JPN": "さっき、新しい笑いの誘発剤が完成。",
      "TalkTime": 0.03
    },
    {
      "Uid": 123,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "긴급한 테스트 필요.",
      "UnitTalk_JPN": "緊急テストが必要。",
      "TalkTime": 0.03
    },
    {
      "Uid": 124,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…한밤중인데?",
          "JumpAnchorStringId_JPN": "…真夜中なのに？"
        }
      ]
    },
    {
      "Uid": 125,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "과학의 발전은 시간에 구애되지 않음.",
      "UnitTalk_JPN": "科学の発展は、時間にとらわれない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 126,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "매우 신속한 논의가 필요하다고 판단.",
      "UnitTalk_JPN": "迅速な議論が必要だと判断。",
      "TalkTime": 0.03
    },
    {
      "Uid": 127,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…대체 뭐길래?",
          "JumpAnchorStringId_JPN": "…一体どんな発明品なの？"
        }
      ]
    },
    {
      "Uid": 128,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그동안 개인적으로 한 가지 실험을 장기간 진행.",
      "UnitTalk_JPN": "これまで、個人的にとある実験を長期間実施。",
      "TalkTime": 0.03
    },
    {
      "Uid": 129,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "매일 밤 잠들기 전 한 시간 동안 단장이 만들어 준 인형을 안고 있기.",
      "UnitTalk_JPN": "毎日寝る前に、団長が作ってくれたぬいぐるみを1時間抱っこ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 130,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "그 결과…",
      "UnitTalk_JPN": "その結果…",
      "TalkTime": 0.03
    },
    {
      "Uid": 131,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "설마?! 즐거움을 느낀 거야?",
          "JumpAnchorStringId_JPN": "まさか！？嬉しさを感じたの？"
        }
      ]
    },
    {
      "Uid": 132,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그건 아님.",
      "UnitTalk_JPN": "それは違う。",
      "TalkTime": 0.03
    },
    {
      "Uid": 133,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…",
          "JumpAnchorStringId_JPN": "…"
        }
      ]
    },
    {
      "Uid": 134,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그냥 간질간질… 정도?",
      "UnitTalk_JPN": "むずむず…ぐらい？",
      "TalkTime": 0.03
    },
    {
      "Uid": 135,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "간질간질?",
          "JumpAnchorStringId_JPN": "むずむず？"
        }
      ]
    },
    {
      "Uid": 136,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "정확히 표현이 어려운 미세한 감정 변화 발생.",
      "UnitTalk_JPN": "正確な表現が難しい、微細な感情の変化が発生。",
      "TalkTime": 0.03
    },
    {
      "Uid": 137,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "신체 내의 호르몬 조성도 일부 변화하는 것도 확인.",
      "UnitTalk_JPN": "身体のホルモンも、一部が変化したことを確認。",
      "TalkTime": 0.03
    },
    {
      "Uid": 138,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "아직 <color=#F7BE45>즐거움</color>이라고 하기엔 부족하지만…",
      "UnitTalk_JPN": "まだ<color=#F7BE45>嬉しさ</color>と言うには足りないけど…",
      "TalkTime": 0.03
    },
    {
      "Uid": 139,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "분명 변화가 발생하고 있음.",
      "UnitTalk_JPN": "確かな変化あり。",
      "TalkTime": 0.03
    },
    {
      "Uid": 140,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "긍정적!",
      "UnitTalk_JPN": "肯定的！",
      "TalkTime": 0.03
    },
    {
      "Uid": 141,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "잘됐구나! 스마일!",
          "JumpAnchorStringId_JPN": "よかったね！スマイル！"
        }
      ]
    },
    {
      "Uid": 142,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아무래도 내가 만들어준 고양이 인형이 스마일의 마음에 들었나 보다.",
      "UnitTalk_JPN": "とにかく、私が作った猫のぬいぐるみが気に入ったみたいだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 143,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그리 큰 변화는 아니겠지만 일단 변화가 있다는 것이 중요하겠지.",
      "UnitTalk_JPN": "そこまで大きい変化ではないけど、変化があったってこと自体が大切だし。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 144,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그럼 다른 인형도 만들어 줄까?",
          "JumpAnchorStringId_JPN": "じゃあ、また他のぬいぐるみを作ってあげよっか？"
        }
      ]
    },
    {
      "Uid": 145,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그것도 좋지만 더 나은 발상이 떠오름.",
      "UnitTalk_JPN": "それもいいけど、もっといいアイデアがある。",
      "TalkTime": 0.03
    },
    {
      "Uid": 146,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "그동안 우리는 기계적인 방식과 감정적인 방식을 실험함.",
      "UnitTalk_JPN": "今まで私たちは、機械的なアプローチと感情的なアプローチで実験。",
      "TalkTime": 0.03
    },
    {
      "Uid": 147,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "하지만 각각의 방식의 한계로 인해 즐거움을 느끼는 것에는 실패.",
      "UnitTalk_JPN": "でも、それぞれのアプローチには限界があって、嬉しさを感じるのに失敗。",
      "TalkTime": 0.03
    },
    {
      "Uid": 148,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "여기서 본인은 두 방식을 혼합한 실험을 설계.",
      "UnitTalk_JPN": "ここで私は、二つのアプローチを組み合わせた実験を計画。",
      "TalkTime": 0.03
    },
    {
      "Uid": 149,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "혼합…?",
          "JumpAnchorStringId_JPN": "組み合わせた…？"
        }
      ]
    },
    {
      "Uid": 150,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "고양이 인형의 내부에 기계적인 자율동작 시스템을 추가.",
      "UnitTalk_JPN": "猫のぬいぐるみの内部に、機械的な自律動作システムを追加。",
      "TalkTime": 0.03
    },
    {
      "Uid": 151,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "이렇게 하면 감정적인 인형의 틀을 유지하면서도 보다 더 <color=#F7BE45>고양이</color> 적인 움직임이 가능.",
      "UnitTalk_JPN": "そうすれば、感情的なぬいぐるみの型を維持しながら、もっと<color=#F7BE45>猫</color>らしい動きが可能になる。",
      "TalkTime": 0.03
    },
    {
      "Uid": 152,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "이 둘이 조합되면 큰 시너지를 만들어낼 것으로 예상.",
      "UnitTalk_JPN": "この二つを組み合わせれば、もっと大きいシナジーが生まれるはず。",
      "TalkTime": 0.03
    },
    {
      "Uid": 153,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "그러니까… 로봇 고양이를 만들었다는 거군.",
      "UnitTalk_JPN": "つまり…ロボット猫を作ったってことか。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 154,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "ANGRY",
      "EmotionEffect": "UPSET",
      "UnitTalk_KOR": "평범한 기계장치가 아님.",
      "UnitTalk_JPN": "平凡な機械装置じゃない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 155,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "자율적이고 고등한 사고를 하면서도 그 사고를 <color=#F7BE45>고양이적인</color> 방식으로 표현하는 회로를 탑재.",
      "UnitTalk_JPN": "自律的でレベルの高い思考を持ちながら、その思考を<color=#F7BE45>猫っぽい</color>方法で表現する回路を搭載。",
      "TalkTime": 0.03
    },
    {
      "Uid": 156,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "본인이 제작한 최고의 걸작들 중 하나.",
      "UnitTalk_JPN": "私が作った最高傑作のひとつ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 157,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "사실상 <color=#F7BE45>인공생명체</color>의 일종이라고 할 수 있음.",
      "UnitTalk_JPN": "事実上、<color=#F7BE45>人工生命体</color>の一種だって言える。",
      "TalkTime": 0.03
    },
    {
      "Uid": 158,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "작동시켜 본 거야?",
          "JumpAnchorStringId_JPN": "動かしてみたの？"
        }
      ]
    },
    {
      "Uid": 159,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "…아니.",
      "UnitTalk_JPN": "…ううん。",
      "TalkTime": 0.03
    },
    {
      "Uid": 160,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "미세하지만 실패의 가능성도 존재.",
      "UnitTalk_JPN": "少しながら、失敗の可能性もあり。",
      "TalkTime": 0.03
    },
    {
      "Uid": 161,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "하지만 단장은 그동안 실패를 통해서도 발전적 통찰력을 다수 발휘.",
      "UnitTalk_JPN": "でも団長は、失敗しても発展的な洞察力を発揮。",
      "TalkTime": 0.03
    },
    {
      "Uid": 162,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
      "UnitTalk_KOR": "그래서… 복합 웃음 촉매제 <color=#F7BE45>스마일 캣 1호</color>의 첫 가동을…",
      "UnitTalk_JPN": "だから…笑いの誘発剤、<color=#F7BE45>スマイルキャット1号</color>の初稼働を…",
      "TalkTime": 0.03
    },
    {
      "Uid": 163,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_SMILE",
