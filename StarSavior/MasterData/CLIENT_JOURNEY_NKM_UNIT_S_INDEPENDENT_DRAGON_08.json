{
  "$schema": "../../../../../DataSchema/Exported.jsonc",
  "$comment": "name: JOURNEY_NKM_UNIT_S_INDEPENDENT_DRAGON_08",
  "_Version": 4,
  "Data": [
    {
      "Uid": 4,
      "RewardAnchor": "REWARD_ANCHOR_1",
      "WaitClick": true,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_PARK_PUBLIC.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_10.mp3",
      "UnitTalk_KOR": "시계를 보니 레이시와 만나기로 약속한 시간이 지나있었다.",
      "UnitTalk_JPN": "時計を見ると、レイシーとの約束時間を過ぎていた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만 기분이 나쁘지 않았다.",
      "UnitTalk_JPN": "だが、気分は悪くなかった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "레이시가 늦는 거야 워낙 일상이기도 하고, 무엇보다 그녀가 최근 많은 변화를 보여줬기 때문이다.",
      "UnitTalk_JPN": "レイシーが遅刻するのはいつものことだ。何より、最近大きな変化を見せてくれた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "ONE_1",
      "UnitTalk_KOR": "노파가 떠난 이후, 레이시는 다시 글을 쓰기 시작하더니 순식간에 책 한 권을 출간했다.",
      "UnitTalk_JPN": "年老いた女性が旅だった後、レイシーは再び執筆を始め、あっという間に一冊の本を出版したのだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "더 놀라운 건 그러는 와중에도, 내 훈련을 열심히 따라주었다는 것이다.",
      "UnitTalk_JPN": "さらに驚くべきは、そんな中でも熱心にトレーニングに励んでくれたことだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "감개무량하네.",
          "JumpAnchorStringId_JPN": "感無量だよ。"
        }
      ]
    },
    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SMILE",
      "UnitPos": "POS9",
      "UnitTalk_KOR": "무엇이 말이냐?",
      "UnitTalk_JPN": "何のことじゃ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_4",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "등 뒤에서 들려온 목소리에 놀라서 돌아보니 레이시가 보였다.",
      "UnitTalk_JPN": "背後から聞こえてきた声に驚いて振り返ると、レイシーが立っていた。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitTalk_KOR": "뭐가 감개무량했다는 말이냐, 여가 책을 낸 것을 말하는 것이냐?",
      "UnitTalk_JPN": "何が感無量なのじゃ？余が本を出したことかの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "그거라면 여도 놀랐느니라.",
      "UnitTalk_JPN": "それなら、余も驚いたぞ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitTalk_KOR": "글을 쓰는 내내 단 한 순간도 손이 멈추지 않더구나.",
      "UnitTalk_JPN": "文を書いている間、一瞬たりとも手が止まらなかったのじゃ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "수십 년 동안 수많은 책을 집필한 여조차도 처음 겪어보는 일이었다!",
      "UnitTalk_JPN": "数十年間、数多の本を執筆してきた余でさえ、初めてのことであった！",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그건 그렇고…",
      "UnitTalk_JPN": "それはそうと…",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "크흠!",
      "UnitTalk_JPN": "コホン！",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitTalk_KOR": "…늦어서 미안하구나.",
      "UnitTalk_JPN": "…遅れてすまなかったのう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "레이시의 말대로 약속 시간은 지나있었다. 하지만, <color=#F7BE45>고작</color> 12분 정도일 뿐이다.",
      "UnitTalk_JPN": "レイシーの言う通り、約束の時間は過ぎていた。だが、<color=#F7BE45>たった</color>12分だ。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 20,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitTalk_KOR": "오래 기다렸느냐?",
      "UnitTalk_JPN": "長く待たせてしまったかの？",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나도 방금 왔어.",
          "JumpAnchorStringId_JPN": "今来たところだよ。"
        }
      ]
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "그렇다면 다행이구나.",
      "UnitTalk_JPN": "なら、良かったのじゃ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "안도한 듯 살며시 웃는 레이시의 표정을 보니, 지난번에 본 쓸쓸한 미소가 떠오른다.",
      "UnitTalk_JPN": "安堵したようにそっと微笑むレイシーの表情を見ていると、以前見た寂しげな笑顔を思い出す。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 24,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그럼 그대여, 가보도록 할까?",
      "UnitTalk_JPN": "よし、それでは行くのじゃ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "간다라… 그러고 보니 만나기로 약속은 했었지만, 무슨 이유로 만나기로 한 건지 듣지 못했다는 게 생각났다.",
      "UnitTalk_JPN": "行く…？そういえば、会う約束はしていたが…どういった用件か聞いていなかった。",
      "TalkTime": 0.03,
      "AutoHighlight": "DARK"
    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "어디를?",
          "JumpAnchorStringId_JPN": "どこに？"
        }
      ]
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "여가 신작을 발매한 지 좀 되지 않았느냐?",
      "UnitTalk_JPN": "新作を発売してから、しばらく経ったじゃろう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "지난번처럼 독자들의 반응을 확인하러 가보자꾸나.",
      "UnitTalk_JPN": "前回のように、読者の反応を確認しに参ろうではないか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "반응 같은 거 신경 안 쓴다며?",
          "JumpAnchorStringId_JPN": "反応なんて気にしないんじゃなかったの？"
        }
      ]
    },
    {
      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "STRESS",
      "UnitTalk_KOR": "그대… 이제 보니 조금 심술 맞은 면이 있구나. 다 알면서 그러는 게지?",
      "UnitTalk_JPN": "其方…ちと意地悪な面があるようじゃのう。すべて分かっていながら、そう言っているのだな？",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "이번 작품은 여에게 있어서 여러모로 뜻깊은 작품이라는 걸 알지 알고 있지 않으냐.",
      "UnitTalk_JPN": "今回の作品は、余にとって意義深い作品だということを知っているじゃろう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INDEPENDENT_DRAGON",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "그러니까 평소보다 신경이 쓰이는 건 당연한…",
      "UnitTalk_JPN": "故に、気になるのは当然のことでだな…",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "가자.",
          "JumpAnchorStringId_JPN": "行こう。"
        }
      ]
    },
    {
