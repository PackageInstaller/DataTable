    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_ARCANA_NKM_UNIT_S_WEST_LANCER_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_LANCER",
      "CameraOffset": "DEFAULT",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "하지만 저희 서부 사람들.",
