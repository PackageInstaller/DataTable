  "_Version": 4,
  "Data": [
    {
      "Uid": 1,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_CANDLE_MAIN.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_02.mp3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "TWIN_1",
      "UnitPos": "POS6",
      "UnitTalk_KOR": "안녕하세요, 단장님! 푹 쉬셨나요?",
      "UnitTalk_JPN": "こんにちは、団長！ゆっくり休まれましたか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "여행의 피로가 남아있는 건 아닌지 걱정했는데,",
      "UnitTalk_JPN": "旅の疲れが残っていないか心配でしたが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "후후, 괜찮아 보이시네요.",
      "UnitTalk_JPN": "ふふっ、お元気そうですね。",
      "TalkTime": 0.03,
      "TalkAppend": true
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "처음 <color=#F7BE45>[여정]</color>을 시작했을 때 낯설어하시던 모습이 생각나는데…",
      "UnitTalk_JPN": "<color=#F7BE45>「旅」</color>を始めた頃の、不慣れで戸惑っていた姿を思い出します…",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그때에 비하면 지금은 단장님도, 여정 단원도 훨씬 더 성장하신 것 같아요.",
      "UnitTalk_JPN": "あの頃に比べると、お二人ともずっと成長されたようです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "뭐, 저처럼 유능한 연락관이 붙어 있으니 당연한 결과겠죠.",
      "UnitTalk_JPN": "まぁ、私のような有能な連絡官がついているのですから。当然の結果でしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "하지만 방심은 금물이랍니다.",
      "UnitTalk_JPN": "ですが、油断は禁物ですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "앞으로의 <color=#F7BE45>[여정]</color>에도 최선을 다해 주세요.",
      "UnitTalk_JPN": "これからも<color=#F7BE45>「救援の旅」</color>にご尽力くださいね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "자, 그럼 다음 평가전에 대해 말씀드리겠습니다.",
      "UnitTalk_JPN": "さぁ、次の試験についてご説明します。",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "다음 평가전은 <color=#F7BE45>[경쟁 평가전]</color>입니다.",
      "UnitTalk_JPN": "次の試験は<color=#F7BE45>「対人試験」</color>です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "구원자로 활동하다 보면 때로는 다른 구원자와 싸워야 할 때도 있습니다.",
      "UnitTalk_JPN": "救援者として活動していると、時には他の救援者と戦わなければならないこともあります。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "사소한 오해일 수도, 서로의 입장 차이 때문일 수도…",
      "UnitTalk_JPN": "その理由は、些細な誤解かもしれないし、お互いの立場の違いかもしれない…",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "때로는 <color=#F7BE45>공허의 세력에 협력하는 구원자</color>들이 나타나 라비스타의 평화를 위협하는 경우도 있습니다.",
      "UnitTalk_JPN": "時には、<color=#F7BE45><r=ヴォイド>空虚</r>の勢力に協力する救援者</color>が現れ、ラビスターの平和を脅かす場合もあります。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "안타깝지만 분명 일어나는 일이에요.",
      "UnitTalk_JPN": "残念ですが、実際に起こりうることです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "경쟁 평가전은 그런 경우를 대비하여 구원자끼리의 전투 능력을 평가하는 시험입니다.",
      "UnitTalk_JPN": "対人試験は…そのような場合に備え、救援者同士の戦闘能力を評価する試験です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "당연한 이야기지만 쉽지는 않을 거예요.",
      "UnitTalk_JPN": "当然、簡単な試験ではありません。",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "인간은 마수나 공허체보다 전술적으로 훨씬 더 치밀하고 교활하니까요.",
      "UnitTalk_JPN": "人間は魔獣や<r=ヴォイドボーン>空虚体</r>よりも、戦術的にずっと緻密で狡猾ですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "상대가 수많은 실전을 거쳐온 베테랑 구원자라면 말할 것도 없겠죠.",
      "UnitTalk_JPN": "相手が数多くの実戦を経験してきたベテラン救援者なら、尚更です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그래서 이번 <color=#F7BE45>[경쟁 평가전]</color>의 상대는…",
      "UnitTalk_JPN": "という訳で、今回の<color=#F7BE45>「対人試験」</color>のお相手は…",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": false,
      "WaitTime": -1.0,
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "CameraOffset": "TWIN_4",
      "UnitPos": "POS5"
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_20.mp3",
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "…당신인가? <color=#F7BE45>[여정 단장]</color>이라는 사람이.",
      "UnitTalk_JPN": "…貴様が<color=#F7BE45>「旅の団長」</color>か？",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "어머~ 귀여운 친구들이네요. 안녕?",
      "UnitTalk_JPN": "あら〜、かわいい子たちですね。こんにちは。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "이렇게 만난 것도 인연인데 같이 아이스크림이나 먹으러 갈까요?",
      "UnitTalk_JPN": "こうして出会えたのも何かの縁ですし、一緒にアイスクリームでも食べに行きませんか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "저희가 주둔하는 <color=#F7BE45>[레이븐 월]</color>에는 아이스크림은 고사하고 얼음물도 찾기가 힘들거든요.",
      "UnitTalk_JPN": "私たちが駐屯する<color=#F7BE45>「レイヴン・ウォール」</color>では、アイスクリームどころか氷水さえ手に入れるのが難しいんですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "NOA에 온 게 얼마 만인지… 이럴 때라도 잔뜩 먹어둬야죠.",
      "UnitTalk_JPN": "NOAに来るのはいつぶりかな…こういう時にたっぷり食べておかないと。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitTalk_KOR": "놀러 온 관광객 같은 나사 빠진 소리는 삼가라, 리디아.",
      "UnitTalk_JPN": "リディア。観光客のような気の抜けたことを言うな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitTalk_KOR": "우리는 우리의 임무만 마치면 바로 서부로 귀환한다.",
      "UnitTalk_JPN": "任務を終えれば、すぐに西部へ帰還する。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "시답잖은 곳에 놀러 다닐 여유로운 시간 따윈 없다!",
      "UnitTalk_JPN": "つまらぬ場所へ遊びに行く余裕などない！",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "아이참, 우리 대장은 너무 사고방식이 딱딱하다니까요.",
      "UnitTalk_JPN": "まったく、隊長ったら頭が固すぎるんですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_ROD",
      "UnitTalk_KOR": "맛있는 걸 먹고 기분이 좋아져야 임무에도 힘을 쏟을 수 있는 거라고요.",
      "UnitTalk_JPN": "おいしいものを食べて気分が良くなってこそ、任務を頑張れるんです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "임무라고?",
          "JumpAnchorStringId_JPN": "任務って？"
        }
      ]
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "그래, 너희들 평가전의 상대가 되는 것.",
      "UnitTalk_JPN": "貴様らの試験相手になることだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_BEAMSWORD",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그게 우리에게 하달된 임무다.",
      "UnitTalk_JPN": "それが我々に下された任務だからな。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "TWIN_1",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "아… 벌써 도착해 계셨네요.",
      "UnitTalk_JPN": "あっ…もう到着されていたようですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "이분들이 바로 이번 <color=#F7BE45>[경쟁 평가전]</color>의 상대.",
      "UnitTalk_JPN": "この方々が、今回の<color=#F7BE45>「対人試験」</color>のお相手…",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " <color=#F7BE45>[서부 탈환대]</color> 입니다.",
      "UnitTalk_JPN": " <color=#F7BE45>「西部奪還隊」</color>です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "평가전의 상대를 위해 NOA로 초청했어요.",
      "UnitTalk_JPN": "試験のお相手として、NOAにご招待しました。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_23A_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "<color=#F7BE45>[서부 탈환대]</color>는 과거 공허의 별이 강림했던 장소.",
      "UnitTalk_JPN": "<color=#F7BE45>「西部奪還隊」</color>は、かつて<r=ヴォイドスター>空虚の星</r>が降臨した場所。",
      "TalkTime": 0.03
    },
    {
