  "_Version": 4,
  "Data": [
    {
      "Uid": 1,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": false,
      "WaitTime": 0.0,
      "BgFileName": "ILLUST_BG_CANDLE_MAIN.png",
      "StartBgmFileName": "MUSIC_CUTSCENE_02.mp3"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "안녕하세요 단장님.",
      "UnitTalk_JPN": "こんにちは、団長。",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "다음 평가전은 <color=#F7BE45>[최종 평가전]</color>입니다.",
      "UnitTalk_JPN": "次回の試験は<color=#F7BE45>「最終試験」</color>です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…드디어 마지막이네요.",
      "UnitTalk_JPN": "…ついに最後ですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "어때요? 지나고 보니 그리 길지는 않았죠?",
      "UnitTalk_JPN": "いかがでしたか？振り返ってみると、それほど長くはなかったでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "단장님도 조금은 아쉬우신가요?",
      "UnitTalk_JPN": "団長も少し寂しいですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "아니, 빨리 끝났으면 좋겠어.",
          "JumpAnchorStringId_JPN": "いや、早く終わってほしいよ。",
          "JumpAnchorId": "JUMPANCHOR_1"
        },
        {
          "Uid": 2,
          "JumpAnchorStringId_KOR": "확실히 조금 아쉽네.",
          "JumpAnchorStringId_JPN": "確かに少し残念だな。",
          "JumpAnchorId": "JUMPANCHOR_2"
        }
      ]
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "JumpAnchorInfo": "JUMPANCHOR_1",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "…대답이 너무 솔직하시네요.",
      "UnitTalk_JPN": "…お答えがあまりにも正直ですね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "저랑 헤어지게 되어서 아쉽다던가 그런 모범적인 답이 나올 줄 알았는데.",
      "UnitTalk_JPN": "私と別れるのが残念だとか、そういう模範的な答えが出るかと思ってたのに。",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "하지만 걱정 마세요. ",
      "UnitTalk_JPN": "でも心配しないでください。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "전 <color=#F7BE45>[여정]</color>이 끝나도 단장님의 연락관으로 남을 테니까요.",
      "UnitTalk_JPN": "私は<color=#F7BE45>「救援の旅」</color>が終わっても、団長の連絡係として残りますから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "네, 네, 말씀하지 않으셔도 기쁜 것 알고 있어요.",
      "UnitTalk_JPN": "はい、はい、おっしゃらなくても嬉しいことは分かっています。",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "JumpAnchorInfo": "JUMPANCHOR_2",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "그럼 상부에 연락해서 평가전을 몇 번 더 진행해 달라고 요청해 볼까요?",
      "UnitTalk_JPN": "では、上層部に連絡して試験をあと数回実施するようお願いしてみましょうか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "후후, 농담입니다. 그렇게 정색하지 않으셔도 돼요.",
      "UnitTalk_JPN": "ふふ、冗談ですよ。そんなに真顔にならなくても大丈夫ですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "애초에 <color=#F7BE45>[여정]</color> 프로그램은 알리시아님께서 정하신 거라 저희가 손댈 수 없으니까요.",
      "UnitTalk_JPN": "そもそも<color=#F7BE45>「救援の旅」</color>プログラムはアリシア様が決められたものなので、私たちが手を加えることはできませんから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "JumpAnchorInfo": "JUMPANCHOR_FINISH",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아무튼 아직 끝난 건 아니니까 집중하도록 하죠.",
      "UnitTalk_JPN": "とにかくまだ終わっていませんから、集中しましょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "여기까지 와서 탈락하면 얼마나 아쉽겠어요?",
      "UnitTalk_JPN": "ここまで来て脱落したら、どれほど残念でしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "EndBgmFileName": "EMPTY.mp3",
      "StartBgmFileName": "EMPTY.mp3",
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "자… <color=#F7BE45>[최종 평가전]</color>의 상대는…",
      "UnitTalk_JPN": "さあ…<color=#F7BE45>「最終試験」</color>の相手は…",
      "TalkTime": 0.03
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartBgmFileName": "MUSIC_CUTSCENE_20.mp3",
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "북십자성을 구성하는 다섯 공허의 별들 중 하나이자 서쪽 하늘의 주성인 <color=#F7BE45>[알데바란]</color>.",
      "UnitTalk_JPN": "北十字星を構成する五つの空虚の星の一つであり、西の空の主星である<color=#F7BE45>「アルデバラン」</color>。",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그녀의 파편으로 만들어진 존재이자 그 뜻을 지상에 퍼트리는 자.",
      "UnitTalk_JPN": "彼女の破片から作られた存在であり、その意志を地上に広める者。",
      "TalkTime": 0.03
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "<color=#F7BE45>[알데바란의 집행자]</color>의 투영체가 <color=#F7BE45>[최종 평가전]</color>의 상대입니다.",
      "UnitTalk_JPN": "<color=#F7BE45>「アルデバランの執行者」</color>の投影体が<color=#F7BE45>「最終試験」</color>の相手です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "얼마나 강하지?",
          "JumpAnchorStringId_JPN": "どれほど強いのか？"
        }
      ]
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…매우 강력한 존재입니다.",
      "UnitTalk_JPN": "…非常に強力な存在です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 암흑시대에 수많은 도시를 파괴하고 구원자들을 쓰러트린 악몽 같은 적이죠.",
      "UnitTalk_JPN": " 暗黒時代に無数の都市を破壊し、救援者たちを倒した悪夢のような敵です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "무섭네…",
          "JumpAnchorStringId_JPN": "怖い…"
        }
      ]
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 두려움을 느끼는 건 당연해요.",
      "UnitTalk_JPN": " 恐怖を感じるのも当然です。",
      "TalkTime": 0.03
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 많은 도전자들이 최종 평가전을 넘지 못하고 탈락했으니까요.",
      "UnitTalk_JPN": " 多くの挑戦者が最終試験を突破できず脱落したのですから。",
      "TalkTime": 0.03
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 하지만 단장님과 여정 단원이라면 분명 시련을 넘어 여정의 끝에 도달할 수 있을 거예요.",
      "UnitTalk_JPN": " しかし、団長と旅の団員なら、きっと試練を乗り越えて旅の終わりにたどり着けるはずです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 그리고 언제나 그랬듯이… 라비스타를…",
      "UnitTalk_JPN": " そして、いつだってそうだったように…ラビスターを…",
      "TalkTime": 0.03
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": " 아니, 이 우주를 비출 빛나는 별이 되겠죠.",
      "UnitTalk_JPN": " いや、この宇宙を照らす輝く星になるでしょう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "뭐라고?",
          "JumpAnchorStringId_JPN": "何だって？"
        }
      ]
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " …",
      "UnitTalk_JPN": " …",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": " 방금 제가 무슨 말을 했었나요?",
      "UnitTalk_JPN": " 今、私が何て言ったっけ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 아무래도 조금 감상적으로 되었던 것 같아요.",
      "UnitTalk_JPN": " どうやら少し感傷的になってしまったようです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": " 아무튼 평가전 날짜까지 최선을 다해 준비를 부탁드립니다.",
      "UnitTalk_JPN": " とにかく、試験の日まで最善を尽くして準備をお願いします。",
      "TalkTime": 0.03
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_PF_39_NOA_STANDBY",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": " 그동안의 여정이 헛되지 않도록이요.",
      "UnitTalk_JPN": " これまでの道のりが無駄にならないように。",
      "TalkTime": 0.03
    }
  ]
}
