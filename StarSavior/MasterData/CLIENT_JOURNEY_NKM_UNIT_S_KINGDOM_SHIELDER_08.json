    },
    {
      "Uid": 50,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "단장님, 어떠세요?",
      "UnitTalk_JPN": "団長さん、どうですか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "요리, 괜찮았나요? ",
      "UnitTalk_JPN": "お味はいかがでしたか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>재미있는</color> 맛이었어…",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>面白い味</color>だったよ…"
        }
      ]
    },
    {
      "Uid": 53,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "이제 남은 건 이 <color=#F7BE45>별 볼 일 없는</color> 컵케이크뿐이네요. ",
      "UnitTalk_JPN": "あと残っているのは…<color=#F7BE45>平凡な</color>カップケーキだけですね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 54,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아, 그건 별로 기대는 하지 마세요. 후후.",
      "UnitTalk_JPN": "あっ、これはあまり期待しないでくださいね。ふふっ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 55,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "새로 구한 레시피를 시험해 보는 김에 만들어 본 거라 특색이 없거든요.  ",
      "UnitTalk_JPN": "新しく手に入れたレシピを試すついでに作ってみたもので、何の特徴もありませんから。  ",
      "TalkTime": 0.03
    },
    {
      "Uid": 56,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "카르멘이 가져온 바구니 안에는 의외로 먹음직스럽게 생긴 컵케이크 하나가 남아있다. ",
      "UnitTalk_JPN": "カルメンが持ってきたカゴの中には、意外と美味しそうなカップケーキがひとつ残っていた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 57,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "나는 하나 남은 컵케이크를 한입 크게 베어 물었고 그 맛은…",
      "UnitTalk_JPN": "私はカップケーキを口いっぱいに頬張った。その味は…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 58,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "평범하게 맛있는데?",
          "JumpAnchorStringId_JPN": "普通で美味しいけど？"
        }
      ]
    },
    {
      "Uid": 59,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "EmotionEffect": "QMARK",
      "UnitTalk_KOR": "어머, 그런가요? ",
      "UnitTalk_JPN": "あら、そうですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "정확히 레시피에 있는 대로만 만든 컵케이크인데…",
      "UnitTalk_JPN": "レシピ通りに作っただけのカップケーキなのですが…",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "너무 개성 없는 맛 아니었나요? ",
      "UnitTalk_JPN": "あまりにも個性のない味ではありませんか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
