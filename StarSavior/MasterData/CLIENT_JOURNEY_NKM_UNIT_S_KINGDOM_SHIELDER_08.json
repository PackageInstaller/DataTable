      "BgEase": "OutQuart"
    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "카르멘이 훈련을 지도해 준 보답이라며 간식거리를 한 바구니 가득 들고 왔다. ",
      "UnitTalk_JPN": "トレーニングで指導してくれたお礼だと、カルメンはカゴいっぱいのスイーツを持ってきた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "취미로 직접 만들곤 하는 요리들이라는데…",
      "UnitTalk_JPN": "趣味で、手作りしたものらしいが…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "가져온 것들은 하나도 빠짐없이 엄청난 비주얼과 냄새를 풍긴다. ",
      "UnitTalk_JPN": "持ってきてくれたものは…ひとつ残らず、ものすごいビジュアルと匂いを放っていた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아, 애석하게도 좋지 않은 방향으로 엄청나다.  ",
      "UnitTalk_JPN": "あっ、残念ながら悪い意味の方で。  ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후. 단장님, 제 솜씨가 어떤가요? ",
      "UnitTalk_JPN": "ふふっ、団長さん。私のセンス、いかがですか？ ",
      "TalkTime": 0.03
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "뭐든 좋으니 하나 드셔보시겠어요?",
      "UnitTalk_JPN": "好きなものをおひとつ、食べられてみますか？",
      "TalkTime": 0.03
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "어… 이 고약하게 생긴 초록색 덩어리는 뭐지?",
          "JumpAnchorStringId_JPN": "えっと…この不気味な緑の塊はなに？"
        }
      ]
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "어머. 고약하다니요. ",
      "UnitTalk_JPN": "あら。不気味だなんて。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "모나스티르 공국의 북부 산간지대에서만 자라는 로마린 허브를 넣어 만든 푸딩이랍니다. ",
      "UnitTalk_JPN": "モナスティル公国北部の山奥でしか育たない、ロマリンハーブを入れて作ったプリンです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "몸에 좋은 거예요. ",
      "UnitTalk_JPN": "身体に良いものなのですよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "타박상을 입었을 때 통증을 완화해 주는 효능이 있죠. ",
      "UnitTalk_JPN": "打撲をした際、痛みを緩和してくれる効能があるのですから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "거창한 효능이 있는 것보다는 우선 맛이 있는 걸 먹고 싶은데.",
          "JumpAnchorStringId_JPN": "すごい効能のあるものより、美味しいものを食べたいんだけど。"
        }
      ]
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "당연히 맛도 있답니다. ",
      "UnitTalk_JPN": "もちろん、味も美味しいのですよ。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "어디 한번 제가 한입 먼저 먹어 볼게요. ",
      "UnitTalk_JPN": "私が一口食べてみますね。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "과일잼이랑 달콤한 걸 잔뜩 넣었으니까 당연히… ",
      "UnitTalk_JPN": "果物のジャムと、甘いものをたっぷり入れたんですから、当然… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "POS3_2X",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "… ",
      "UnitTalk_JPN": "… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "푸르딩딩한 푸딩을 한입 가득 베어 문 카르멘의 표정이 심상치 않다. ",
      "UnitTalk_JPN": "青みがかったプリンを口いっぱいに頬張ったカルメンは、ただならぬ表情になった。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "EmotionEffect": "THINK2",
      "UnitTalk_KOR": "… ",
      "UnitTalk_JPN": "… ",
      "TalkTime": 0.03
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "역시 맛없구나!!!",
          "JumpAnchorStringId_JPN": "やっぱり不味いんだ！！！"
        }
      ]
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "맛없는 게 아니고, <color=#F7BE45>특별한 맛</color>이에요.",
      "UnitTalk_JPN": "不味い訳ではなく、<color=#F7BE45>特別な味</color>がするだけです。",
      "TalkTime": 0.03
    },
    {
      "Uid": 22,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "후후. 조금만 참으면 먹을 수 있는 맛인걸요.",
      "UnitTalk_JPN": "ふふっ。少しだけ我慢すれば、食べられる味ですよ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 23,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "음. 원래 몸에 좋은 건 입에 쓰다고 하잖아요?",
      "UnitTalk_JPN": "んー。良薬口に苦しという言葉もあるでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 24,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "자, 아 하세요. ",
      "UnitTalk_JPN": "さぁ、アーンしてください。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 25,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "한입 먹고 나면 욱씬거렸던 근육통이 단번에 사라질 거예요.   ",
      "UnitTalk_JPN": "一口食べれば、辛かった筋肉痛がすぐに治まりますよ。   ",
      "TalkTime": 0.03
    },
    {
      "Uid": 26,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…그럼 정성을 봐서 한 입만 먹을게.",
          "JumpAnchorStringId_JPN": "…せっかく作ってくれたんだし、一口だけ食べるよ。"
        }
      ]
    },
    {
      "Uid": 27,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.3,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "EmotionEffect": "FUN"
    },
    {
      "Uid": 28,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": false,
      "WaitTime": 0.3,
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA"
    },
    {
      "Uid": 29,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "눈을 딱 감고 푸딩을 한입 머금은 순간 감탄을 내뱉고 말았다. ",
      "UnitTalk_JPN": "目をぎゅっと瞑り、プリンを口の中に入れた瞬間…思わず声を出してしまった。  ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 30,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "대단한 맛이다.",
      "UnitTalk_JPN": "すごい味だ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 31,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "물론 안 좋은 방향으로.",
      "UnitTalk_JPN": "もちろん、悪い意味で。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 32,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "어떤가요? 특별한 맛이죠?",
      "UnitTalk_JPN": "どうですか？特別な味でしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 33,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "속이 안 좋아질 것 같아…",
          "JumpAnchorStringId_JPN": "気持ち悪くなってきた…"
        }
      ]
    },
    {
      "Uid": 34,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": false,
      "WaitTime": 0.8,
      "BgFadeInStartCol": [
        "0",
        "0",
        "0",
        "0"
      ],
      "BgFadeInCol": [
        "0",
        "0",
        "0",
        "1"
      ],
      "BgFadeInTime": 0.8
    },
    {
      "Uid": 35,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_6",
      "UnitTalk_KOR": "그런데 얼마 지나지 않아 훈련에서 생긴 상처들의 통증이 잦아들기 시작한다. ",
      "UnitTalk_JPN": "でも…しばらくすると、訓練でできた傷の痛みが和らぎ始めた。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 36,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "맛은 끔찍하지만 효과는 확실한 것 같으니 신기할 따름이다. ",
      "UnitTalk_JPN": "味はおぞましいものだけど、効果は確かなんだからビックリだ。 ",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 37,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "이 정도면 요리보다는 연금술에 가깝지 않을까…",
      "UnitTalk_JPN": "この程度なら、料理というよりも錬金術に近いんじゃ…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 38,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": false,
      "WaitTime": 0.8,
      "BgFadeOutCol": [
        "0",
        "0",
        "0",
        "0"
      ],
      "BgFadeOutTime": 0.8
    },
    {
      "Uid": 39,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "어떤가요? 정말 몸이 편안해졌죠?",
      "UnitTalk_JPN": "どうですか？本当に体が楽になったでしょう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…인정할게.",
          "JumpAnchorStringId_JPN": "…認めるよ。"
        }
      ]
    },
    {
      "Uid": 41,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "후후. 제가 분명히 말씀드렸잖아요. 몸에 좋은 거라고. ",
      "UnitTalk_JPN": "ふふっ、だから言ったじゃないですか。体に良いって。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "자자, 편식은 좋지 않아요.",
      "UnitTalk_JPN": "さぁさぁ、好き嫌いは良くないですよ？",
      "TalkTime": 0.03
    },
    {
      "Uid": 43,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "아직 준비해 온 게 많답니다. ",
      "UnitTalk_JPN": "まだ他にもたくさんあるんですから。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "구루구루 열매를 얇게 썰어 넣은 크레페랑 또…",
      "UnitTalk_JPN": "グルグルの実を薄く切って入れたクレープと…",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "아, 이건 밤에 수면을 도와주는 진정초가 들어간 쿠키네요. ",
      "UnitTalk_JPN": "あっ、これはよく眠れる鎮静草が入ったクッキーです。 ",
      "TalkTime": 0.03
    },
    {
      "Uid": 46,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "맛은… 조금 시큼하지만 개성 있는 맛이니까 한번 즐겨보세요.",
      "UnitTalk_JPN": "味は…少し酸っぱいですが、個性的な味を楽しんでくださいね。",
      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_KINGDOM_SHIELDER_08",
      "WaitClick": true,
