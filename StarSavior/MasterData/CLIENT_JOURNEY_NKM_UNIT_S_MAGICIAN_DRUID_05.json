      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "단장님. 물어보고 싶어요.",
      "UnitTalk_JPN": "団長。お聞きしたいことがあります。",
      "UnitTalk_TWN": "團長，我想問…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_05_DRUID_34.ogg"
    },
    {
      "Uid": 70,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "이런 제가 <color=#F7BE45>여정</color>을 계속해도 될까요?",
      "UnitTalk_JPN": "こんなわたしが、<color=#F7BE45>救援の旅</color>を続けてもいいのでしょうか？",
      "UnitTalk_TWN": "像我這樣的人可以繼續<color=#F7BE45>旅行</color>嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_05_DRUID_35.ogg"
    },
