        }
      ]
    },
    {
      "Uid": 63,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "오다가 다른 구원자분과 이야기를 나눴어요.",
      "UnitTalk_JPN": "来る途中に、他の救援者の方とお話しました。",
      "UnitTalk_TWN": "我在來的路上遇到了其他救援者，聊了幾句。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_05_DRUID_28.ogg"
    },
    {
      "Uid": 64,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "다른 사람들도 <color=#F7BE45>여정 단원</color>이 되기를 원한다고요.",
      "UnitTalk_JPN": "他の人たちも、<color=#F7BE45>旅の団員</color>になることを望んでいるそうです。",
      "UnitTalk_TWN": "他說其他人也想成為<color=#F7BE45>旅行團員</color>。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_05_DRUID_29.ogg"
    },
    {
      "Uid": 65,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "그분은 저보다 훨씬 구체적인 계획을 갖고 있었어요.",
      "UnitTalk_JPN": "その方は、わたしよりもずっと具体的な計画をお持ちで…",
      "UnitTalk_TWN": "他有比我更具體的計畫。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_05_DRUID_30.ogg"
    },
    {
      "Uid": 66,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>여정</color>을 통과하면 어떤 식으로 세계를 평화롭게 만들지 얘기하셨죠.",
      "UnitTalk_JPN": "<color=#F7BE45>救援の旅</color>を通過して、どのように世界を平和にしたいのかおっしゃっていました。",
      "UnitTalk_TWN": "說通過<color=#F7BE45>旅行</color>後要怎麼讓世界變得更和平。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_05_DRUID_31.ogg"
    },
    {
      "Uid": 67,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "하지만… 하지만, 저는….",
      "UnitTalk_JPN": "なのに…それなのに、わたしは…",
      "UnitTalk_TWN": "但是…但是，我…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_05_DRUID_32.ogg"
    },
    {
      "Uid": 68,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_05",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "<color=#F7BE45>사람들의 웃는 모습</color>이 좋아서, 라고 밖에 대답하지 못했어요…",
      "UnitTalk_JPN": "<color=#F7BE45>みんなの笑顔</color>が好きだから、としか答えられなくて…",
      "UnitTalk_TWN": "只能回答說因為喜歡看到<color=#F7BE45>人們歡笑的樣子</color>…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_05_DRUID_33.ogg"
    },
