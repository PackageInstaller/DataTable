    },
    {
      "Uid": 64,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "…그래도, 딱히 싫은 기분은 아니니까.",
      "UnitTalk_JPN": "…嫌なわけじゃない。",
      "TalkTime": 0.03
    },
    {
