    {
      "Uid": 36,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "…딱히.",
      "UnitTalk_JPN": "…別に。",
      "TalkTime": 0.03
    },
    {
      "Uid": 37,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "긴장할 일이 뭐가 있겠어.",
      "UnitTalk_JPN": "緊張する訳がない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 38,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "이제부터 해야할 일이라곤 고작 <color=#F7BE45>정해진 적과 싸워 이긴다</color>.",
      "UnitTalk_JPN": "やるべきは、たかが<color=#F7BE45>「決められた敵と戦って勝つ」</color>こと。",
      "TalkTime": 0.03
    },
    {
      "Uid": 39,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "비교적 간단한 일이잖아.",
      "UnitTalk_JPN": "簡単なことだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 40,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그렇구나.",
          "JumpAnchorStringId_JPN": "そっか。"
        }
      ]
    },
    {
      "Uid": 41,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…그런거야.",
      "UnitTalk_JPN": "…そうだ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 42,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "에데는 전부 끝나면 뭘 할 생각이야?",
          "JumpAnchorStringId_JPN": "エデは全部終わったら、何するつもり？"
        }
      ]
    },
    {
      "Uid": 43,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "당연한 걸 묻고 있네.",
      "UnitTalk_JPN": "そんな当然のことを聞くのか。",
      "TalkTime": 0.03
    },
    {
      "Uid": 44,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "당연히 <color=#F7BE45>복수</color>야.",
      "UnitTalk_JPN": "もちろん<color=#F7BE45>「復讐」</color>に決まっているだろう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 45,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "<color=#F7BE45>모르세르</color>를 찾아서 죽인다.",
      "UnitTalk_JPN": "<color=#F7BE45>「モルセル」</color>を探し出して、殺す。",
      "TalkTime": 0.03
    },
    {
      "Uid": 46,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "난 깨어난 이후로 그 목표 한가지만을 보고 살아왔어.",
      "UnitTalk_JPN": "私は目覚めてから今まで、そのために生きてきた。",
      "TalkTime": 0.03
    },
    {
      "Uid": 47,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "포기할 리가 없잖아.",
      "UnitTalk_JPN": "諦める訳がないだろう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 48,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그럼…",
          "JumpAnchorStringId_JPN": "じゃあ…"
        }
      ]
    },
    {
      "Uid": 49,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "<color=#F7BE45>복수</color>까지 끝나면?",
          "JumpAnchorStringId_JPN": "<color=#F7BE45>「復讐」</color>が終わったら？"
        }
      ]
    },
    {
      "Uid": 50,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "…글쎄.",
      "UnitTalk_JPN": "…さぁ。",
      "TalkTime": 0.03
    },
    {
      "Uid": 51,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "거기까지는 생각해본 적 없네.",
      "UnitTalk_JPN": "そこまで考えたことはなかった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 52,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그럼, 모든 게 끝나면 시간 좀 내줄래?",
          "JumpAnchorStringId_JPN": "全部終わったら、私に少し時間をくれない？"
        }
      ]
    },
    {
      "Uid": 53,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "…알았어.",
      "UnitTalk_JPN": "…分かった。",
      "TalkTime": 0.03
    },
    {
      "Uid": 54,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "세상에는 아직 즐거운 일이 많이-",
          "JumpAnchorStringId_JPN": "この世界には、楽しいことがたくさん──"
        }
      ]
    },
    {
      "Uid": 55,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "…어?",
          "JumpAnchorStringId_JPN": "…え？"
        }
      ]
    },
    {
      "Uid": 56,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "그러니까, 알았다고.",
      "UnitTalk_JPN": "分かったと言っただろう。",
      "TalkTime": 0.03
    },
    {
      "Uid": 57,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "어차피 <color=#F7BE45>같이 어딘가 놀러가자!</color>라든가, 뭔가 들고 와서는 <color=#F7BE45>같이 해보자!</color> 같은-",
      "UnitTalk_JPN": "どうせ<color=#F7BE45>「一緒に遊びに行こう」</color>だとか、<color=#F7BE45>「一緒にやってみよう」</color>だとか──",
      "TalkTime": 0.03
    },
    {
      "Uid": 58,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "해맑은 소리나 늘어놓으려던 거 아니었어?",
      "UnitTalk_JPN": "そんなことを言おうとしていただろう？",
      "TalkTime": 0.03
    },
    {
      "Uid": 59,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "…어차피 복수 이외에는 나에게 아무것도 남아있지 않아.",
      "UnitTalk_JPN": "…どうせ復讐以外、私には何も残っていない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 60,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "그러니, 모든 게 끝난 뒤라면…",
      "UnitTalk_JPN": "だから、全てが終わった後なら…",
      "TalkTime": 0.03
    },
    {
      "Uid": 61,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "조금 정도는 시간을 내어줄 수 있을지도 모르지.",
      "UnitTalk_JPN": "少しぐらいは時間を作ってやってもいい。",
      "TalkTime": 0.03
    },
    {
      "Uid": 62,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "어울려 줄게.",
