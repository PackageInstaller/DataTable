      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_KINGDOM_SHIELDER",
      "UnitTalk_KOR": "제 옆에 누군가 있지 않았나요?",
      "UnitTalk_JPN": "私の隣に、誰かいらっしゃいませんでしたか？",
      "TalkTime": 0.03
    },
    {
