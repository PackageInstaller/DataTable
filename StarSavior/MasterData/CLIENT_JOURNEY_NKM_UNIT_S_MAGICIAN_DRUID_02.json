      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "앗?",
      "UnitTalk_JPN": "あれ？",
      "UnitTalk_TWN": "啊？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_19.ogg"
    },
    {
