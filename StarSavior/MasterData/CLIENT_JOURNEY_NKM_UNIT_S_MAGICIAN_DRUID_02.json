    },
    {
      "Uid": 2,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "약속장소에 도착했지만 다나의 모습이 보이지 않았다. 오는데 시간이 걸리나?",
      "UnitTalk_JPN": "待ち合わせ場所に着いたが、ダーナの姿は見当たらなかった。",
      "UnitTalk_TWN": "抵達了約定地點卻沒看到達娜的身影。她來這裡需要很久嗎？",
      "TalkTime": 0.03
    },
    {
      "Uid": 3,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "주변에 설치된 의자에 앉아 기다렸다.",
      "UnitTalk_JPN": "私は、近くの椅子に座って待つことにした。",
      "UnitTalk_TWN": "我坐在附近的椅子上等待。",
      "TalkTime": 0.03
    },
    {
      "Uid": 4,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "IN"
    },
    {
      "Uid": 5,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "UnitPos": "POS3"
    },
    {
      "Uid": 6,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": false,
      "WaitTime": 0.0,
      "TransitionEffect": "FADE",
      "TransitionControl": "OUT"
    },
    {
      "Uid": 7,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "EmotionEffect": "EMARK",
      "UnitTalk_KOR": "으아아! 죄송해요, 단장님! 오래 기다리셨죠?",
      "UnitTalk_JPN": "うああああ！すみません、団長！待ちました？",
      "UnitTalk_TWN": "呃啊啊！對不起，團長！您久等了吧？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_1.ogg"
    },
    {
      "Uid": 8,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "오다가 무거운 짐을 든 할머니를 도와드리고 왔어요.",
      "UnitTalk_JPN": "来る途中に、重い荷物を抱えたおばあさんを見かけて…お手伝いしていたんです。",
      "UnitTalk_TWN": "我在來的路上幫了拿著沉重行李的老奶奶。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_2.ogg"
    },
    {
      "Uid": 9,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "거기까지는 문제없었는데… 돌아오는 길을 헤맸네요…",
      "UnitTalk_JPN": "そこまでは良かったんですが…道に迷ってしまって…",
      "UnitTalk_TWN": "本來沒問題的…但我在回來時迷路了…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_3.ogg"
    },
    {
      "Uid": 10,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "아으으… 죄송합니다…",
      "UnitTalk_JPN": "あうう…すみません…",
      "UnitTalk_TWN": "呃呃…真是抱歉…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_4.ogg"
    },
    {
      "Uid": 11,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "나도 방금 도착했어.",
          "JumpAnchorStringId_JPN": "大丈夫、さっき着いたとこだよ。",
          "JumpAnchorStringId_TWN": "我也才剛到。"
        }
      ]
    },
    {
      "Uid": 12,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "그, 그런가요?",
      "UnitTalk_JPN": "そ、そうですか？",
      "UnitTalk_TWN": "是、是嗎？",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_5.ogg"
    },
    {
      "Uid": 13,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "정말 방금 도착하셨나요? 그렇다면 다행이지만…",
      "UnitTalk_JPN": "本当に着いたばかりですか？それなら良いのですが…",
      "UnitTalk_TWN": "您真的剛到嗎？如果是這樣就太好了…",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_6.ogg"
    },
    {
      "Uid": 14,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아무튼, 시내에 놀러가자고 제안해 주셔서 감사합니다.",
      "UnitTalk_JPN": "とにかく、街に遊びに行こうと誘ってくださってありがとうございます。",
      "UnitTalk_TWN": "總之，謝謝您邀請我去市區玩。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_7.ogg"
    },
    {
      "Uid": 15,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "사실 도시 구경은 이번이 처음이거든요.",
      "UnitTalk_JPN": "実を言うと、都会を見て回るのは今日が初めてなんです。",
      "UnitTalk_TWN": "說實話，這是我第一次逛城市。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_8.ogg"
    },
    {
      "Uid": 16,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "고향의 할머니가 그랬어요. 도시는 아름답지만 가시가 돋친 장미 같은 곳이라고.",
      "UnitTalk_JPN": "故郷のおばあちゃんが言っていました。都会は美しいけど、薔薇のようにトゲがある場所だって。",
      "UnitTalk_TWN": "家鄉的奶奶說過，城市雖美但像帶刺的玫瑰。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_9.ogg"
    },
    {
      "Uid": 17,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "한순간이라도 방심하면 큰일난다고 하셨죠.",
      "UnitTalk_JPN": "一瞬でも油断すれば、大変なことになると言っていました。",
      "UnitTalk_TWN": "稍不注意就會惹上麻煩。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_10.ogg"
    },
    {
      "Uid": 18,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "단장님 없이 혼자 나왔다면, 지금쯤 목숨이 위태로웠을 거예요!",
      "UnitTalk_JPN": "もし一人だったら、いまごろ命の危険にさらされていたと思います！",
      "UnitTalk_TWN": "如果沒有團長陪我，我現在可能已經命在旦夕了！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_11.ogg"
    },
    {
      "Uid": 19,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그 정도는 아니라고 생각하는데…",
          "JumpAnchorStringId_JPN": "そこまでじゃないと思うけどな…",
          "JumpAnchorStringId_TWN": "我覺得不至於那麼嚴重…"
        }
      ]
    },
    {
      "Uid": 20,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "단장님과 함께 하는 도시 구경!",
      "UnitTalk_JPN": "団長との都会見物！",
      "UnitTalk_TWN": "和團長一起逛城市！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_12.ogg"
    },
    {
      "Uid": 21,
      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitTalk_KOR": "무사히 즐길 수 있도록 노력하겠습니다!",
      "UnitTalk_JPN": "無事に楽しめるよう、精一杯努力します！",
      "UnitTalk_TWN": "我會努力平安享受這趟旅行的！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_13.ogg"
    },
    {
