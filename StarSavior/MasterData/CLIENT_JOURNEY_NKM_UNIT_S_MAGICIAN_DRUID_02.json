      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitNameString": [
        "SI_PERSON_A"
      ],
      "UnitTalk_KOR": "죄송합니다. 다치시지 않았나요?",
      "UnitTalk_JPN": "すみません、お怪我はないですか？",
      "UnitTalk_TWN": "對不起，你沒受傷吧？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
