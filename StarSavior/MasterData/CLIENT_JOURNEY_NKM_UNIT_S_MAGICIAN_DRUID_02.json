      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "떨어지지 않게 주의해야겠다.",
          "JumpAnchorStringId_JPN": "はぐれないように気を付けよう。",
          "JumpAnchorStringId_TWN": "得小心別走散了。"
        }
      ]
    },
    {
