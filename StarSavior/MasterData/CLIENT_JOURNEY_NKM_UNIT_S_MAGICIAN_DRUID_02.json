      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_MAGICIAN_DRUID_02",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "네! 단장님. 주의할게요!",
      "UnitTalk_JPN": "はいっ！わたし、気をつけます！",
      "UnitTalk_TWN": "好的！團長，我會注意的！",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_18.ogg"
    },
    {
