      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_MAGICIAN_DRUID",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아하하! 여기서 단장님과 만났었죠.",
      "UnitTalk_JPN": "あはは！わたしたちが初めて出会った場所です。",
      "UnitTalk_TWN": "啊哈哈！我在這見到了團長。",
      "TalkTime": 0.03,
      "TalkVoice": "JOURNEY_1021_JOURNEY_02_DRUID_15.ogg"
    },
    {
