      "CameraOffset": "TWIN_6"
    },
    {
      "Uid": 2,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "오! 단장이다!",
      "UnitTalk_JPN": "あっ！団長！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_001.wav"
    },
    {
      "Uid": 3,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "여기야, 단장! 여기!",
      "UnitTalk_JPN": "こっちよ、こっち！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_002.wav"
    },
    {
      "Uid": 4,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "리사를 따라 캔들 스퀘어의 문을 열고 들어가자 눈앞에 손을 흔드는 금발의 소녀가 보였다.",
      "UnitTalk_JPN": "リサと一緒にキャンドル・スクエアに入ると、金髪の少女が手を振っているのが見えた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 5,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "설마 기다리고 있었던 거야?",
          "JumpAnchorStringId_JPN": "もしかして、待っていたのか？"
        }
      ]
    },
    {
      "Uid": 6,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "응! 당연하지!",
      "UnitTalk_JPN": "当然でしょ！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_003.wav"
    },
    {
      "Uid": 7,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "어제 우리가 구했던 3급 관측사… 이름이 뭐였더라?",
      "UnitTalk_JPN": "えっと…そっちのあなた。昨日わたしたちが助けた3級観測士の…名前は何だったかしら？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_004.wav"
    },
    {
      "Uid": 8,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "NR",
      "UnitMotion": "SERIOUS",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "…리사요.",
      "UnitTalk_JPN": "…リサです。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_NPC_NOA_LISA_001.wav"
    },
    {
      "Uid": 127,
      "WaitClick": false,
      "WaitTime": -1.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitQuickSet": true
    },
    {
      "Uid": 133,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "아, 맞아! 아무튼 그쪽에게 들었어.",
      "UnitTalk_JPN": "そうだったわね！…とにかく、話は聞いたわ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_005.wav"
    },
    {
      "Uid": 10,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "구원단을 창설해서 <color=#F7BE45>[여정]</color>에 도전하기로 했다면서?",
      "UnitTalk_JPN": "あなた、救援団を創設して<color=#F7BE45>「救援の旅」</color>に挑むんでしょう？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_006.wav"
    },
    {
      "Uid": 11,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "대단해!",
      "UnitTalk_JPN": "すごいわ！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_007.wav"
    },
    {
      "Uid": 12,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "그동안 수많은 강자들이 도전했지만 모두 실패했다고 들었는데…",
      "UnitTalk_JPN": "これまで数多くの強者たちが挑戦したのに、一人も成功した人はいないって聞いたんだけど…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_008.wav"
    },
    {
      "Uid": 13,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "EmotionEffect": "FUN",
      "UnitTalk_KOR": "그런 시험에 선뜻 도전하다니… 역시 우리 단장이야!",
      "UnitTalk_JPN": "そんな試験に挑もうだなんて、さすがはわたしの団長ね！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_009.wav"
    },
    {
      "Uid": 14,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "우리… 단장?",
          "JumpAnchorStringId_JPN": "わたしの…団長？"
        }
      ]
    },
    {
      "Uid": 15,
      "WaitClick": true,
      "WaitTime": 0.0,
      "StartFxSoundName": "SFX_CUTSCENE_COMMON_CARTOON_18.wav",
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "아이~ 왜 모른 척하고 그래.",
      "UnitTalk_JPN": "もう～、とぼけないでよ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_010.wav"
    },
    {
      "Uid": 16,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "ANGRY",
      "UnitTalk_KOR": "목숨이 오가는 도로에서의 그 운명적인 만남!",
      "UnitTalk_JPN": "車に轢かれて死ぬ運命を二人で回避した、あの道端での奇跡的な出会い！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_011.wav"
    },
    {
      "Uid": 17,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "USN_UI_REST_START",
      "UnitTalk_KOR": "직후 이어진 공허체의 공습에 맞서서 그… 3급 관측사…",
      "UnitTalk_JPN": "そして、<r=ヴォイドボーン>空虚体</r>の襲撃からそこの3級観測士を救出するために…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_012.wav"
    },
    {
      "Uid": 18,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "ONE_8",
      "CameraOffsetTime": "NR",
      "UnitMotion": "ANGRY",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "…리사요, 리사.",
      "UnitTalk_JPN": "リサです、リサ！3級観測士って呼ばないでください！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_NPC_NOA_LISA_002.wav"
    },
    {
      "Uid": 128,
      "WaitClick": false,
      "WaitTime": -1.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitQuickSet": true
    },
    {
      "Uid": 19,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "ONE_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "응, 아무튼 NOA의 요인을 구출하기 위한 혈전!",
      "UnitTalk_JPN": "…とにかく、NOAの重要人物を救出するための激戦！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_013.wav"
    },
    {
      "Uid": 20,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "신비로운 비밀구역에서 강대한 적에 맞서 구사일생으로 살아 나오기까지…!",
      "UnitTalk_JPN": "さらに、シークレットエリアで強大な敵に立ち向かい、力を合わせて生還したあの事件！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_014.wav"
    },
    {
      "Uid": 21,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "단장이랑 나는 이미 떼어낼 수 없는 한 <color=#F7BE45>[가족]</color>이잖아. 안 그래?",
      "UnitTalk_JPN": "団長とわたしはもう<color=#F7BE45>「家族」</color>みたいなものじゃない。そうでしょう？",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_015.wav"
    },
    {
      "Uid": 22,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "음, 분명 틀린 말은 없다. ",
      "UnitTalk_JPN": "うーむ、一つ一つの出来事は間違っていないが…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 23,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "하지만…",
      "UnitTalk_JPN": "しかし…",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 24,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "결론이 좀 지나치게 왜곡되어 있는 것 같은데…",
          "JumpAnchorStringId_JPN": "「家族」は盛りすぎな気が…"
        }
      ]
    },
    {
      "Uid": 25,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "아이~ 자꾸 섭섭한 소릴…",
      "UnitTalk_JPN": "もう～、また寂しいこと言っちゃって…",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_016.wav"
    },
    {
      "Uid": 26,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitMotion": "SMILE",
      "UnitTalk_KOR": "아무튼 내가 단장의 첫 번째 단원이니까 잘 부탁해!",
      "UnitTalk_JPN": "とにかく、わたしが団長にとっての初めての団員だから！よろしくね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_017.wav"
    },
    {
      "Uid": 27,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그렇게 쉽게 정해도 되는 거야?!",
          "JumpAnchorStringId_JPN": "そんな簡単に決めていいのか！？"
        }
      ]
    },
    {
      "Uid": 28,
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitTalk_KOR": "달라붙는 아세라를 밀쳐내며 리사에게 물었다.",
      "UnitTalk_JPN": "くっついてくるアセラを押しのけて、リサに尋ねた。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 29,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "단원이 되려면 뭔가 절차라든가 그런 게 있지 않나?",
      "UnitTalk_JPN": "団員になるには、何か手続きが必要じゃないのか？",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 30,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "으음, 원래라면 여정 단원은 관측사 평의회에서 후보들을 추천해요.",
      "UnitTalk_JPN": "う～ん…本来なら旅の団員は、観測士評議会から候補者が推薦されるんです。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_NPC_NOA_LISA_003.wav"
    },
    {
      "Uid": 31,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "그중 한 명을 골라 알리시아님이 초대장을 보내는 거죠.",
      "UnitTalk_JPN": "そしてその中から一人を選んで、アリシア様が招待状を送るというわけですね。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_NPC_NOA_LISA_004.wav"
    },
    {
      "Uid": 32,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "NORMAL",
      "UnitTalk_KOR": "하지만 이번에는… 조금 규칙이 바뀌었다고 들었어요.",
      "UnitTalk_JPN": "しかし今回は…少しルールが特殊なようです。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_NPC_NOA_LISA_005.wav"
    },
    {
      "Uid": 33,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "여정 단원 선정에 대한 모든 권한은 단장님께 일임한다고 공문에 적혀 있었어요.",
      "UnitTalk_JPN": "団員選定に関するすべての権限は、団長に一任すると公文書に書かれてありました。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_NPC_NOA_LISA_006.wav"
    },
    {
      "Uid": 34,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "인원도, 방식도 자유라고.",
      "UnitTalk_JPN": "誰を選んでも、どんな選び方をしても構わないそうで。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_NPC_NOA_LISA_007.wav"
    },
    {
      "Uid": 35,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "부담스러운데…",
          "JumpAnchorStringId_JPN": "荷が重いな…"
        }
      ]
    },
    {
      "Uid": 129,
      "WaitClick": false,
      "WaitTime": -1.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SURPRISE"
    },
    {
      "Uid": 36,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "CameraOffset": "TWIN_3",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SMILE",
      "UnitPos": "POS4",
      "UnitTalk_KOR": "그것 봐! 알리시아님도 알고 계신 거야!",
      "UnitTalk_JPN": "ほら！アリシア様もご存じだったのよ！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_018.wav"
    },
    {
      "Uid": 37,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitTalk_KOR": "단장의 곁에 이미 완벽한 여정 단원 후보가 있다는 걸!",
      "UnitTalk_JPN": "団長の隣にはもう、完璧な団員候補がいるってことをね！",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_UNIT_S_VOYAGER_STRANIS_019.wav"
    },
    {
      "Uid": 38,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "아세라는 팔을 파닥거리며 <color=#F7BE45>[뽑아 줄 거지?]</color> 라는 의미가 담긴 제스처를 취하고 있었다.",
      "UnitTalk_JPN": "アセラは<color=#F7BE45>「選んでくれるでしょ？」</color>と言わんばかりの眼差しを向けてくる。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 130,
      "WaitClick": false,
      "WaitTime": -1.0,
      "CutsceneClear": "CLEARUNIT",
      "UnitStrId": "NKM_UNIT_NPC_VOYAGER_STRANIS",
      "UnitQuickSet": true
    },
    {
      "Uid": 39,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "FA",
      "UnitMotion": "SAD",
      "UnitTalk_KOR": "하아… 거부해 봐야 소용없을걸요.",
      "UnitTalk_JPN": "はぁ…団長、たぶん断っても無駄ですよ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_NPC_NOA_LISA_008.wav"
    },
    {
      "Uid": 40,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "저 아가씨, 생긴 것과는 다르게 완전 고집불통이니까요.",
      "UnitTalk_JPN": "彼女、見かけによらず本当に頑固ですから。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_NPC_NOA_LISA_009.wav"
    },
    {
      "Uid": 41,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
      "UnitTalk_KOR": "단장님이 <color=#F7BE45>[여정 단장]</color>에 내정되었다는 말을 듣고는 어젯밤부터 기다리고 있었거든요.",
      "UnitTalk_JPN": "団長が<color=#F7BE45>「旅の団長」</color>に内定したという話を聞いて、昨日の夜から待っていたんですよ。",
      "TalkTime": 0.03,
      "TalkVoice": "MAIN_EP2_2_NPC_NOA_LISA_010.wav"
    },
    {
      "Uid": 42,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_S_NOA_LISA",
