      "ContentsTag": "DEV_OPEN",
      "CutsceneStrId": "JOURNEY_NKM_UNIT_S_WEST_LANCER_01",
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_WEST_LANCER",
      "UnitTalk_KOR": "엄벌도. 처벌도. 군벌도. 저는 달게 받을 각오가 되어 있으니까요.",
