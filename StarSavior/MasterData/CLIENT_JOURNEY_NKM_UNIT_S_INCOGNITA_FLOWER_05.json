      "CameraOffsetTime": "NR",
      "UnitMotion": "SURPRISE",
      "UnitTalk_KOR": "뭐라고…?",
      "UnitTalk_JPN": "何だと…？",
      "TalkTime": 0.03
    },
    {
      "Uid": 228,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "그러다 가끔씩은 근처 풍경도 같이 보고.",
