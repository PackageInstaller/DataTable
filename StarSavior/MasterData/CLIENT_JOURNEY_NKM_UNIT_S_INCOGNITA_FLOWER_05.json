    {
      "Uid": 211,
      "WaitClick": true,
      "WaitTime": 0.0,
      "JumpAnchorData": [
        {
          "Uid": 1,
          "JumpAnchorStringId_KOR": "농담 아니야.",
          "JumpAnchorStringId_JPN": "冗談じゃない。"
        }
      ]
    },
    {
      "Uid": 212,
      "WaitClick": true,
      "WaitTime": 0.0,
      "CameraOffset": "TWIN_6",
      "CameraOffsetTime": "NR",
      "UnitTalk_KOR": "나도 몇 년 전의 기억이나, 고향에 대해 떠올리려 하면 전혀 떠올릴 수 없다.",
      "UnitTalk_JPN": "私も数年前のことや、故郷について思い出そうとしても全く思い出せない。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 213,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "어디서부터 출발했는지, 목적지가 어디인지도, 모른 채-",
      "UnitTalk_JPN": "どこから出発したのか、目的地がどこなのかも、分からないまま──",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 214,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "뒤로 갈 수 없는 궤도 위에서 그저 달릴 뿐이다. ",
      "UnitTalk_JPN": "後戻りできない軌道の上を、ただただ走るだけだ。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 215,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitTalk_KOR": "에데와 나는, 분명히 닮아있다.",
      "UnitTalk_JPN": "エデと私は、確かに似ている。",
      "TalkTime": 0.03,
      "AutoHighlight": "OFF"
    },
    {
      "Uid": 216,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "SERIOUS",
      "UnitTalk_KOR": "…만약 그게 사실이라고 해도, 넌 내가 어떤 기분인지 이해할 수 없어.",
      "UnitTalk_JPN": "…たとえそれが事実だとしても、お前には私の気持ちを理解できない。",
      "TalkTime": 0.03
    },
    {
      "Uid": 217,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "<color=#F7BE45>그 괴물</color>은 내 모든 걸 가져가 파괴했다고.",
      "UnitTalk_JPN": "<color=#F7BE45>あの怪物</color>は私の全てを奪い、破壊した。",
      "TalkTime": 0.03
    },
    {
      "Uid": 218,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitTalk_KOR": "단순히 기억을 잃었다는 것만으로 전부 이해하는 척-",
      "UnitTalk_JPN": "単に記憶を失っただけで、全てを理解したように振る舞うのは──",
      "TalkTime": 0.03
    },
