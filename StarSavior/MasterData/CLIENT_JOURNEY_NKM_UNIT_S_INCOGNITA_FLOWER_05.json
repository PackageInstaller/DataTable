    {
      "Uid": 230,
      "WaitClick": true,
      "WaitTime": 0.0,
      "UnitStrId": "NKM_UNIT_NPC_INCOGNITA_FLOWER",
      "UnitMotion": "SPECIAL",
      "UnitTalk_KOR": "하… 무슨 소리를 하려고 하나 했더니.",
