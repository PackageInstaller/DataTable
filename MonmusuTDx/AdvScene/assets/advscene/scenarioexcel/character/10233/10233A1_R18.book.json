          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 14,
          "strings": [
            "",
            "",
            "マコモ",
            "Emt9_Est",
            "layer_中",
            "",
            "",
            "0.3",
            "",
