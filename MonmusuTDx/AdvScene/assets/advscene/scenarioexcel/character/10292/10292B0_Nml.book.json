        {
          "rowIndex": 70,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ちょっ、落ち着いてくださいっ！\n少しって言ったじゃないですかぁ！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 71,
