            "",
            "ヘディアデスワーム",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "ひぁぁ、ぁああああっ！",
            "",
            "ch_10342/R18/10342A1_10342_R18/10342A0_10342_041"
          ],
          "isEmpty": 0,
