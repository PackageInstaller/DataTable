            "",
            "主人公",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "えっ、そっ、そんなっ……！？　あっ、ああぁっ……！？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 89,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
