        {
          "rowIndex": 78,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "うっ、あっ、あひぁぁぁぁぁぁっ！！"
          ],
          "isEmpty": 0,
