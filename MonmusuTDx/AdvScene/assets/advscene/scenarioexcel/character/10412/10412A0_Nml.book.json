            "ShakePosition",
            "time=0.4 x=6 y=6",
            "",
            "",
            "",
            "NoWait"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 30,
          "strings": [
            "",
            "",
            "ルネルカ",
            "Emt9_Est",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "ふ……ふふん……っ！\n<interval=3>べ",
            "Next",
            "ch_10412/R18/10412A0_10412_Nml/10412A0_10412_006",
            "",
            ""
          ],
          "isEmpty": 0,
