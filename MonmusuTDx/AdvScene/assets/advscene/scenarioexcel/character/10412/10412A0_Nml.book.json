          "strings": [
            "",
            "",
            "ルネルカ",
            "Emt4_Enj",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "ふふん、当然よ！\n<interval=1.5>ま",
            "Next",
            "ch_10412/R18/10412A0_10412_Nml/10412A0_10412_005",
            "",
            ""
          ],
          "isEmpty": 0,
