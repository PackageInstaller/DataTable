        {
          "rowIndex": 34,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ふぁっ、ファロリエットさんっ！\nおりてっ、下りてくださいっ！"
