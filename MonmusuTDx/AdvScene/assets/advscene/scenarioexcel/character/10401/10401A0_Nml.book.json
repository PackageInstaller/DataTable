          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 82,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "ティッカさんの顔はさらに真っ赤になった。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 83,
          "strings": [
