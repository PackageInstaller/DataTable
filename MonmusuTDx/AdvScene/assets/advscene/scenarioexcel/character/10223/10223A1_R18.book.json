            "",
            "ch_10223/R18/10223A1_10223_R18/10223A0_10223_020"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 32,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
