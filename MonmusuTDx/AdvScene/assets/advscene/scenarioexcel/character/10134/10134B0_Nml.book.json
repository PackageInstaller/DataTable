          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 16,
          "strings": [
            "",
            "",
            "マズルXmas",
            "Emt8_Shy",
            "layer_中",
            "",
            "",
            "0.3",
            "",
