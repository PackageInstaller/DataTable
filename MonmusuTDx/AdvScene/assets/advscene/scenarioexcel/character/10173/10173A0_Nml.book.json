            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "……けほっ……ごほっ……。\nん？　あれ？　……なんだろう？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 63,
          "strings": [
            "",
            "",
            "ディフォーラ",
            "Emt1_Nor",
