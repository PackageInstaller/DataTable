            "Wait",
            "",
            "",
            "",
            "",
            "",
            "0.25",
            "",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 23,
          "strings": [
            "",
            "",
            "チヅ",
