          "rowIndex": 25,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "たしかにかっちんこっちんに固まっているようだ。\n……むしろこれは――。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 26,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "あの、これじゃあ、\nかき氷にはかけれないんじゃ？"
