            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "そっ、そんな……うわあああっ！？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 13,
          "strings": [
