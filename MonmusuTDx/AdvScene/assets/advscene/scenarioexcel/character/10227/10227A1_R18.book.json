          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 61,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ひっ、あっ、あ、あああぁあっ！？"
