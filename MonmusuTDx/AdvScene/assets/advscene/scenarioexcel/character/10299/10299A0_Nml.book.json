          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 10,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "そんなの気にしませんよ。\nニッドラさんは大事な仲間なんですから。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 11,
          "strings": [
