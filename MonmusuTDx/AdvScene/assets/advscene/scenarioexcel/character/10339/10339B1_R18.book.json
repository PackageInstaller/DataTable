            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "え、えええ……っ！？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 81,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
