            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "ふ、ぅにゃぁあっ！　きちゃっ、きちゃぅううっ！！\nイくのきちゃぅぅううっ！！",
            "",
            "ch_10339/R18/10339B1_10339_R18/10339B0_10339_038"
          ],
