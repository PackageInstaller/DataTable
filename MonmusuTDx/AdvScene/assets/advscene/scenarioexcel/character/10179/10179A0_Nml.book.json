          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 43,
          "strings": [
            "",
            "",
            "マシュロア",
            "Emt4_Enj",
            "layer_中",
            "",
            "",
            "0.3",
            "",
