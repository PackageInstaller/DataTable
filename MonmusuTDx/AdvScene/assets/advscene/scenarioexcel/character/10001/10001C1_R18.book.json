            "エテジア",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "ふふっ、すごい嘶いてるわねぇ。まさに雌馬って感じ。",
            "",
            "ch_10001/R18/10001C1_10001_R18/10001C0_10001_032"
          ],
