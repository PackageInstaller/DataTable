          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 47,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ティッカさんのナカ……ン、熱くて、きもちいいですっ！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 48,
          "strings": [
