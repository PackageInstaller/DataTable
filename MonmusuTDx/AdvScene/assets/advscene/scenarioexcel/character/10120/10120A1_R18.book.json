            "layer_中",
            "",
            "",
            "0.3",
            "",
            "フ……その顔、やはり誤解しているな。",
            "",
            "ch_10120/R18/10120A1_10120_R18/10120A0_10120_019",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 20,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
