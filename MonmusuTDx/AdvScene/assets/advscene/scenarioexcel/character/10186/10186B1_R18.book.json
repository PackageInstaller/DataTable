        },
        {
          "rowIndex": 77,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ひぐっ、あっ、くっ、ひああああっ！\nやっ、ああ、んっ、ううううう！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
