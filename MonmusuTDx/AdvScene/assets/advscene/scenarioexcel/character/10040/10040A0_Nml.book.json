            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "（あの声は……ニィルさん？）"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 17,
          "strings": [
