            "Emt4_Enj",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "常に、私に命令し続けて欲しい。",
            "",
            "ch_10195/R18/10195B0_10195_Nml/10195B0_10195_007",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 22,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "な、なるほど……。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
