            "",
            "",
            "",
            "",
            "",
            "",
            "ぶはっ！？\nげほっ！　ごほっ！　げほっ！　げほほほほっ！！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 74,
          "strings": [
