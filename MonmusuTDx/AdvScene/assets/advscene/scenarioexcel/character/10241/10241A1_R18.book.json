            "TRUE",
            "0.8"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 62,
          "strings": [
            "",
            "",
            "オプスカリテR18_1",
            "Fast",
            "layer_R18",
