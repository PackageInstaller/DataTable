        {
          "rowIndex": 66,
          "strings": [
            "",
            "",
            "ペロロス",
            "Emt5_Sca",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "きゃあああああぁっ！？",
            "",
            "ch_10133/R18/10133B0_10133_Nml/10133B0_10133_013",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 67,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "うわっわっわわっ！？\n大丈夫ですかペロロスさん！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 68,
          "strings": [
            "",
            "Bgm",
