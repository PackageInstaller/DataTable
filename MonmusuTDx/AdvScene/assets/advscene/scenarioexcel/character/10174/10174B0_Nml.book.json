            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "あ、あの……？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 34,
          "strings": [
            "",
            "Se",
