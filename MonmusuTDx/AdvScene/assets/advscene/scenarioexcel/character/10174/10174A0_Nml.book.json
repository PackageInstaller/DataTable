            "",
            "ch_10174/R18/10174A0_10174_Nml/10174A0_10174_011",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 51,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "それはそれでどうなんですか！？"
