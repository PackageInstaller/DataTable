            "Emt7_Ama",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "ええっ！？　いいの！？\nわたし、おさかな大好きなんだ～！",
            "",
            "ch_10141/R18/10141A0_10141_Nml/10141A0_10141_007",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 59,
