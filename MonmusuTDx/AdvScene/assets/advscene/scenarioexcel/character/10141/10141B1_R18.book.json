          "rowIndex": 63,
          "strings": [
            "",
            "",
            "主人公",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "あっ、あああっ！？\nもっ、もうだめっ、いっ、イっちゃいますっ……！"
