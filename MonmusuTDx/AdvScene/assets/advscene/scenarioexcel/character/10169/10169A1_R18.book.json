            "ch_10169/R18/10169A1_10169_R18/10169A0_10169_036"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 67,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "だ、ダメです……！　すぐにそこからどいてください。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
