        },
        {
          "rowIndex": 80,
          "strings": [
            "",
            "",
            "テナハロウィン",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "んっ、ちゅばっ！　ちゅぶっ、ちゅるるるっ！\nれるっ！　れるるっ！　ちゅっ、ちゅばっ、じゅるるるっ！！",
            "",
            "ch_10382/R18/10382A1_10382_R18/10382A0_10382_034"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 81,
          "strings": [
            "",
            "",
            "テナハロウィン",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "れるっ、んふっ！　ちゅっ、ぢゅるるるっ！\nんぶっ、ちゅっ、ちゅばっ！　んぼっ！　じゅっ、ぢゅばっ！！",
