          "strings": [
            "",
            "",
            "リンフー",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "もう、アタシだめっ、だめぇっ、イっちゃう、からぁっ！",
            "",
            "ch_10313/R18/10313B1_10313_R18/10313B0_10313_045"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
