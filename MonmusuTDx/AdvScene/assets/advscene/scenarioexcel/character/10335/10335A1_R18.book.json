            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "き、気持ちいい、です……。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 59,
          "strings": [
