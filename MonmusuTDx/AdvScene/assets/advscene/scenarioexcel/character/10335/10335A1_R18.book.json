            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "だ、だって……こんなの……！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 66,
          "strings": [
            "",
            "",
            "女子生徒",
            "",
            "",
            "",
            "",
            "",
            "",
            "あっ、ここにあった！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 67,
          "strings": [
            "",
            "Shake",
            "MessageWindow",
