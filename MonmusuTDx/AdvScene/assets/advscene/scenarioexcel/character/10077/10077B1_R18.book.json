            "ch_10077/R18/10077B1_10077_R18/10077B0_10077_026"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 41,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "に、ニホさんっ……お、男が苦手なら、ムリしなくても……っ！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 42,
