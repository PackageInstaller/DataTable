            "リンデンハート",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "ま、待って……あ～れ～！",
            "",
            "en_40293/R18/10077C0_40293_Nml/10077C0_40293_019"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 78,
          "strings": [
