          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 13,
          "strings": [
            "",
            "",
            "ココノハ",
            "Emt1_Nor",
            "layer_BU中",
            "",
            "-50",
            "0.3",
            "",
