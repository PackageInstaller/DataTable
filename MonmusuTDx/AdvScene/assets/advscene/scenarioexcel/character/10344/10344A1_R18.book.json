            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "いや、尋問って、一体なんの……。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 51,
          "strings": [
            "",
            "",
            "シュエン",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
