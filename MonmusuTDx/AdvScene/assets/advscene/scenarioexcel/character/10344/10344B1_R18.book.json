        },
        {
          "rowIndex": 87,
          "strings": [
            "",
            "",
            "シュエン",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "はあはあ、パンパンで気持ちぃぃ……んっ！",
            "",
            "ch_10344/R18/10344B1_10344_R18/10344B0_10344_051"
          ],
          "isEmpty": 0,
