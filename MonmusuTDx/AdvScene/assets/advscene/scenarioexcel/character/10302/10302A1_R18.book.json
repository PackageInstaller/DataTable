          "strings": [
            "45",
            "",
            "ラピナス",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "きゃはは、ショタちゃんのイったあとのうなじも顔も、\nすっごく真っ赤でエッチだ……♪",
            "",
            "ch_10302/R18/10302A1_10302_R18/10302A0_10302_045"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
