          "rowIndex": 64,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ふ、ぅううっ！　ううっ、くああぁっ！！\nパイシュエさん、僕、おかしくなっちゃいますぅっ……！！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
