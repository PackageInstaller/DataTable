            "Se",
            "SE動作_行為_運動激",
            "TRUE",
            "0.8"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 58,
          "strings": [
            "",
            "",
            "パイシュエR18_2",
            "Fast",
            "layer_R18",
            "",
            "",
            "0.4"
