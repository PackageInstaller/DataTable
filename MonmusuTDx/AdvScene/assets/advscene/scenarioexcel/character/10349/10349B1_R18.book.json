            "TRUE",
            "1"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 61,
          "strings": [
            "",
            "",
            "カリス花嫁R18_2",
            "Fast",
            "layer_R18",
