            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "う……はい。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 50,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
