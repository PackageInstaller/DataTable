          "strings": [
            "",
            "",
            "ペリリ水着",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "あっ、あああああ！　んっ、あああっ！\nイっちゃう、それ以上は、限界だからっ！　あっ、あああ！",
