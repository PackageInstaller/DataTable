            "ch_10198/R18/10198A1_10198_R18/10198A0_10198_024"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 53,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
