          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "うわああああ！？　げほっ、ごぼぼ……！\nぷはっ！　……あれ？　何もない？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
