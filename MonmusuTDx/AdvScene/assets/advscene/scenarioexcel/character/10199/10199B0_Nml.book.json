        },
        {
          "rowIndex": 30,
          "strings": [
            "",
            "",
            "ラゴスハロウィン",
            "Emt3_Gla",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "ほーう。そうか、そうなんだな～……♪",
            "",
            "ch_10199/R18/10199B0_10199_Nml/10199B0_10199_004",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 31,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ど、どうしたんですか？　急にニヤッとして。\nなにか悪い予感がするんですけど……。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 32,
          "strings": [
            "",
            "Bgm",
