            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ちっ、違……っ、あぁっ！　きもち、ぃ、ひぁぁっ！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 56,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
