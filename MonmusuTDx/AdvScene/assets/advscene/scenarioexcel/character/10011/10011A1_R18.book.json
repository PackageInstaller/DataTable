          "rowIndex": 18,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "えっ、なんですかこれ！？\nポデルさん、どうしちゃったんですか！？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 19,
          "strings": [
            "",
            "",
            "ポデル",
            "Emt9_Est",
            "layer_BU中",
            "",
            "-20",
            "",
            "",
