        },
        {
          "rowIndex": 27,
          "strings": [
            "",
            "",
            "マリドゥーラ",
            "Emt7_Ama",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "……っ！！",
            "",
            "ch_10125/R18/10125A0_10125_Nml/10125A0_10125_005",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 28,
          "strings": [
            "",
            "",
            "主人公",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "？　あの、マリドゥーラさん？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 29,
          "strings": [
