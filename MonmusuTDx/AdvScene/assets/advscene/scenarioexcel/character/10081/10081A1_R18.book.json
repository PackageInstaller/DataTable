          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 30,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "わ、わかりました……。\nじゃあ、ゆっくり入れてみますね……？"
          ],
          "isEmpty": 0,
