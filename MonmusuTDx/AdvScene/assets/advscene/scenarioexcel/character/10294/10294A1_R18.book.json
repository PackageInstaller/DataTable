            "Emt5_Sca",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "さっきの魔物……やっぱり毒を持っていたのね。",
            "",
            "ch_10294/R18/10294A1_10294_R18/10294A0_10294_016",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 18,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
