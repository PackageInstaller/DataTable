          "isCommentOut": 0
        },
        {
          "rowIndex": 78,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ちょ、スズさん暴れないでっ、って――うわあっ！！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 79,
          "strings": [
