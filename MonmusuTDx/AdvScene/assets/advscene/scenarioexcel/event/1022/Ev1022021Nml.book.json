        {
          "rowIndex": 88,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ざこぼると……ってもしかしてバウさんですか！？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 89,
          "strings": [
            "",
            "",
            "ヴェラートゥ",
