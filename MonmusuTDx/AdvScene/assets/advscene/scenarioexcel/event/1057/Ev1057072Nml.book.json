            "",
            "プリプリダ",
            "Emt3_Gla",
            "layer_ビビ神c_左",
            "",
            "",
            "0.3",
            "",
            "…………いいだろウ。\nピンダは、このレーダー探知機が示す場所にいるはずダ。",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 83,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
