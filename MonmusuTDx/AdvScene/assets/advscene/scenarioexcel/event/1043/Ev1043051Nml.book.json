            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 38,
          "strings": [
            "",
            "",
            "リッチ",
            "Emt7_Ama",
            "layer_右中奥",
            "",
            "",
            "0.3",
            "",
            "落ち着いてくだされ。\nもう、ウォルーザ殿を疑ったりしておりませんぞ。",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
