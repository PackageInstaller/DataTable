            "",
            "ウォルーザ",
            "Emt5_Sca",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "あ、あたしは人間だ！！\nモンスター娘じゃないから、どんなことがあっても\nご主人を危険にさらすようなマネはしねぇよ！",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 73,
          "strings": [
            "",
            "CharacterOff",
            "",
            "",
            "",
            "",
            "",
            "0.2",
            "",
            "",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 74,
          "strings": [
            "",
            "Wait",
            "",
            "",
            "",
            "",
            "",
            "0.3",
