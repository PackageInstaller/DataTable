            "",
            "",
            "",
            "",
            "0.3",
            "",
            "",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 79,
          "strings": [
