            "layer_右中",
            "",
            "",
            "0.3",
            "",
            "いつものカティナちゃんじゃないよぉ。\nこれじゃあラッシーちゃんもかわいそうだよぉ。",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
