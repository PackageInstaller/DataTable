            "Wait",
            "",
            "",
            "",
            "",
            "",
            "0.3",
            "",
            "",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 78,
          "strings": [
            "",
            "",
            "トバリ",
            "Emt1_Nor",
            "layer_右中奥",
            "",
            "",
            "0.3",
