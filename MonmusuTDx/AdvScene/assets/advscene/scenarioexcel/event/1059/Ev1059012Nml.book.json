        {
          "rowIndex": 86,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "どうしてそういう話の流れになるんですか！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 87,
          "strings": [
