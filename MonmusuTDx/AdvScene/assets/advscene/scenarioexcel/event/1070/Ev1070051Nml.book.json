        },
        {
          "rowIndex": 20,
          "strings": [
            "",
            "",
            "ネルXmas",
            "Emt10_Sad",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
