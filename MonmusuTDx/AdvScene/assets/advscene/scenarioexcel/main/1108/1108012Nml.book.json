            "",
            "",
            "セレン",
            "Emt6_Sur",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "うぇっ！？　ま、まさか皇女たちが……？",
            "",
            "ch_10023/Main/1108/1108_10023_029",
            ""
