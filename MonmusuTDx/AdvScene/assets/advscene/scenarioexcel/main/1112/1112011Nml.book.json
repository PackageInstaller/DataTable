          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 3,
          "strings": [
            "",
            "",
            "クロミ",
            "<Off>",
            "",
            "",
            "",
            "0.3",
            "",
            "何で、天悪戦争じゃないんですかね？",
            "",
            "ch_10021/Main/1112/1112_10021_001",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
