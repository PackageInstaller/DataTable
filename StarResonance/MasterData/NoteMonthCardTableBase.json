{
    "9070001": {
        "Key": 9070001,
        "Id": 9070001,
        "Name": "2025年6月典藏卡",
        "DictionaryDes": "六月，是盛夏情深意浓的序章，天空明亮，蓝得不带一丝彷徨。",
        "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_02",
        "Resources": "ui/textures/handbook_month_card/monthly_reward_card_02",
        "Episode": 9070001,
        "IsHide": false
    },
    "9070002": {
        "Key": 9070002,
        "Id": 9070002,
        "Name": "2025年7月典藏卡",
        "DictionaryDes": "荷花三百里，草木正葱茏，人间七月，与美好重逢。",
        "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_03",
        "Resources": "ui/textures/handbook_month_card/monthly_reward_card_03",
        "Episode": 9070002,
        "IsHide": false
    },
    "9070003": {
        "Key": 9070003,
        "Id": 9070003,
        "Name": "2025年8月典藏卡",
        "DictionaryDes": "八月，是星星垂眸，月亮坠入爱河，八月，是风烟俱净，尝遍人间烟火。",
        "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_04",
        "Resources": "ui/textures/handbook_month_card/monthly_reward_card_04",
        "Episode": 9070003,
        "IsHide": false
    },
    "9070004": {
        "Key": 9070004,
        "Id": 9070004,
        "Name": "2025年9月典藏卡",
        "DictionaryDes": "或许，新的故事，在这个九月，在秋风中，正悄悄酝酿。",
        "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_05",
        "Resources": "ui/textures/handbook_month_card/monthly_reward_card_05",
        "Episode": 9070004,
        "IsHide": false
    },
    "9070005": {
        "Key": 9070005,
        "Id": 9070005,
        "Name": "2025年10月典藏卡",
        "DictionaryDes": "十月，落叶翩翩，每一片都是对未来的祈愿。",
        "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_06",
        "Resources": "ui/textures/handbook_month_card/monthly_reward_card_06",
        "Episode": 9070005,
        "IsHide": false
    },
    "9070006": {
        "Key": 9070006,
        "Id": 9070006,
        "Name": "2025年11月典藏卡",
        "DictionaryDes": "十一月里，浅冬渐至，守在岁月深处，寻找爱与光，活成静与暖。",
        "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_01",
        "Resources": "ui/textures/handbook_month_card/monthly_reward_card_01",
        "Episode": 9070006,
        "IsHide": false
    },
    "9070007": {
        "Key": 9070007,
        "Id": 9070007,
        "Name": "2025年12月典藏卡",
        "DictionaryDes": "冬日的暖阳温柔地洒落，每一缕光线都像是时间的笔触，在寂静中绘出岁月的静好。",
        "ListResources": "ui/textures/handbook_month_card/monthly_reward_card_main_card_01",
        "Resources": "ui/textures/handbook_month_card/monthly_reward_card_01",
        "Episode": 9070007,
        "IsHide": true
