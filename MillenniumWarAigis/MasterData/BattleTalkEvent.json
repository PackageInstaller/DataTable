  "records": [
    {
      "Message": "（お城が、王子のお城が燃えて……）",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 2000
    },
    {
      "Message": "……いけない、泣いてる場合じゃないですよね、\n今は皆を逃さないと！\n皆さんこちらです！　中庭から外へ抜けられます！",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "ぐっ……あんたは……メイドのソーマさんだったか？\nすまない、避難誘導は警備兵の役割なのに……。",
      "Name": "警備兵Ａ",
      "FaceID": 1064,
      "RecordOffset": 0
    },
    {
      "Message": "今日は非番だったので、こんな格好ですけどね。\nさぁ立ってください、ここもすぐに戦場になります！",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "はは……メイドに叱られてたら、\n警備兵を名乗っていられなくなるな……。",
      "Name": "警備兵Ｂ",
      "FaceID": 1069,
      "RecordOffset": 0
    },
    {
      "Message": "だが、ここを捨てるわけにはいかない。\n今、王宮に救出部隊が向かっているんだ。\n中庭を魔物に明け渡したら、脱出路がなくなってしまう。",
      "Name": "警備兵Ｂ",
      "FaceID": 1069,
      "RecordOffset": 0
    },
    {
      "Message": "ギャギャ！　コロセ！　コロセ！！",
      "Name": "ゴブリン",
      "FaceID": 2,
      "RecordOffset": 0
    },
    {
      "Message": "……ちっ、来たか魔物め。\nあんたたちは逃げろ！　ここは俺たちが――",
      "Name": "警備兵Ａ",
      "FaceID": 1064,
      "RecordOffset": 0
    },
    {
      "Message": "だめです、もう囲まれて――",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "――ッ！！",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "ギャーッ！？",
      "Name": "ゴブリン",
      "FaceID": 2,
      "RecordOffset": 0
    },
    {
      "Message": "お、王子！？　どうしてここに……！？",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "……無事か、ソーマ。",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "は、はいっ！　無事です！　ぴんぴんしてます！！",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "王子、微力ながら、背中をお守りします。\n我ら警備部隊、最後の時まで王家に忠誠を！",
      "Name": "警備兵Ａ",
      "FaceID": 1064,
      "RecordOffset": 0
    },
    {
      "Message": "王子、私も戦います！\nこれでも弓の心得がありますから！",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "…………（こくり）",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "はぁ……はぁ……っ！\nま、まだ魔物が向こうから……。",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "救出部隊はまだ戻ってこないのか……！\n国王陛下、王妃様……どうか、どうかご無事で……。",
      "Name": "警備兵Ｂ",
      "FaceID": 1069,
      "RecordOffset": 0
    },
    {
      "Message": "待て、何だこの音は……。\n破城槌……いや、魔法か……？",
      "Name": "警備兵Ａ",
      "FaceID": 1064,
      "RecordOffset": 0
    },
    {
      "Message": "まずい、反対側の城壁にヒビが……。\nあちらからも魔物が来るぞ！！",
      "Name": "警備兵Ｂ",
      "FaceID": 1069,
      "RecordOffset": 0
    },
    {
      "Message": "王子、どうかあなただけでもお逃げください！\n英雄王の血筋を、ここで絶やすわけには！！",
      "Name": "警備兵Ａ",
      "FaceID": 1064,
      "RecordOffset": 0
    },
    {
      "Message": "…………（ふるふる）",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "王子……わ、わかりました。\nそれなら私が、陛下を探しにいきます！",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "……だめだ、ソーマ。",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "わがままを言っている場合ではないんです。\nもう、昔とは違うんですよ……？",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "全部を選んで、全部を救うなんて、\nそんなわがままが許される状況では――",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "くっ……王子、城壁が破られました！\n次の魔物の群れが来ます！！",
      "Name": "警備兵Ａ",
      "FaceID": 1064,
      "RecordOffset": 0
    },
    {
      "Message": "ギャギャ！　トツゲキ！　トツゲキ！！",
      "Name": "ゴブリン",
      "FaceID": 2,
      "RecordOffset": 0
    },
    {
      "Message": "はぁ……はぁ……っ、\n王子、ここにいたんですね……！",
      "Name": "アリサ",
      "FaceID": 1024,
      "RecordOffset": 0
    },
    {
      "Message": "伝令です！　王城は完全に占拠されました。\n生き延びた兵は王都の外にて、\n部隊を再編中ですが、動ける戦力は多くありません……。",
      "Name": "アリサ",
      "FaceID": 1024,
      "RecordOffset": 0
    },
    {
      "Message": "北の大国からも部隊が派遣されたそうですが、\nおそらく、もう間に合わないかと……。",
      "Name": "アリサ",
      "FaceID": 1024,
      "RecordOffset": 0
    },
    {
      "Message": "……王城が、英雄王さまの築いたお城が、\n陥ちてしまうなんて……。",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "……それでは、国王陛下は……。",
      "Name": "警備兵Ａ",
      "FaceID": 1064,
      "RecordOffset": 0
    },
    {
      "Message": "…………ッ。",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "王子、いったい何を……。\nまさか、戦うおつもりですか！？",
      "Name": "警備兵Ｂ",
      "FaceID": 1069,
      "RecordOffset": 0
    },
    {
      "Message": "……もし王子が、ここで命を捨てるつもりなら、\n私も最後まで、王子と一緒に戦います！",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "私もです！\n王子が逃げないのなら、\n皆、ここで命を捨てる覚悟です！",
      "Name": "アリサ",
      "FaceID": 1024,
      "RecordOffset": 0
    },
    {
      "Message": "無論、我々もですよ、王子。\nあなたの存在は、我らの最後の希望なのですから。",
      "Name": "警備兵Ａ",
      "FaceID": 1064,
      "RecordOffset": 0
    },
    {
      "Message": "……ソーマ、アリサ、皆。",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "――分かった、逃げ延びよう。\n生きて、反撃の時を待とう。",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "……っ！　はいっ！！",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "城壁は突破されましたが、\nまだ城下町方面への突破口は残されています。\n皆で血路を開きましょう！",
      "Name": "アリサ",
      "FaceID": 1024,
      "RecordOffset": 0
    },
    {
      "Message": "王子、魔物の攻勢が弱まりました！\n西門から抜けられそうです！",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "王子、傷を癒します。\n走れそうですか……？",
      "Name": "アリサ",
      "FaceID": 1024,
      "RecordOffset": 0
    },
    {
      "Message": "…………（こくり）",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "王子、肩を貸します。\n急いで王城を脱出しま――",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "英雄王ノ系譜……王国ノ民……。\nスベテ……スベテ死ニ至レ……。",
      "Name": "リッチ",
      "FaceID": 46,
      "RecordOffset": 0
    },
    {
      "Message": "なっ……ソーマ、危ないッ！！",
      "Name": "アリサ",
      "FaceID": 1024,
      "RecordOffset": 0
    },
    {
      "Message": "え……っ？",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "王子、どうして私なんかをかばって……。",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "ソーマ、話は後にしましょう。\nリッチがひるんでいる、今が好機です。",
      "Name": "アリサ",
      "FaceID": 1024,
      "RecordOffset": 0
    },
    {
      "Message": "……全部を選んで、全部を救う、か。",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "必ず、俺が皆の故郷を取り戻す。\n王都を、この世界を、必ず――。",
      "Name": "王子",
      "FaceID": 1001,
      "RecordOffset": 0
    },
    {
      "Message": "王城を脱出したら、\nまずは生き残った部隊との合流を目指しましょう。",
      "Name": "アリサ",
      "FaceID": 1024,
      "RecordOffset": 0
    },
    {
      "Message": "そのための移動経路確保は、\n私たちにまかせてください！\n魔物の少ない道を、先行して探してきますね。",
      "Name": "ソーマ",
      "FaceID": 1023,
      "RecordOffset": 0
    },
    {
      "Message": "城の外では、政務官のアンナさんが\n各部隊をまとめているはずです。\n王子、どうか、王国の未来をお願いします！",
      "Name": "アリサ",
      "FaceID": 1024,
      "RecordOffset": 0
    },
