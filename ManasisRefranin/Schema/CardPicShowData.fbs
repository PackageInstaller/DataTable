namespace ProjectA.Data;

table CardPicShowData {
  id:int;
  card_base_id:int;
  fashion_id:int;
  pic_name:string;
  default_size:int;
  default_pos_x:int;
  default_pos_y:int;
  min_size:int;
  max_size:int;
  offset:int;
}

table CardPicShowTable {
  datas:[CardPicShowData];
}

root_type CardPicShowTable;
