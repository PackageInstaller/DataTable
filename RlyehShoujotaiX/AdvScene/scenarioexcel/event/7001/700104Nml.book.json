                {
                    "rowIndex": 45,
                    "strings": [
                        "",
                        "",
                        "主人公",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "ここに入るのか……？"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 46,
                    "strings": [
                        "",
                        "",
                        "ウロロス",
                        "Emt10_Est",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "おや、怖気づきましたか？"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 47,
                    "strings": [
                        "",
                        "",
                        "主人公",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "いや……。"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
