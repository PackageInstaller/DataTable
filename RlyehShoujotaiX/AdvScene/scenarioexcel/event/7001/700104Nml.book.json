                    "rowIndex": 19,
                    "strings": [
                        "",
                        "",
                        "ウロロス",
                        "Emt5_Sur",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "そして、それももう、そろそろかと思います。\nあなたたち！"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 20,
                    "strings": [
                        "",
                        "",
                        "従者たち",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "<size=34>はっ！"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
