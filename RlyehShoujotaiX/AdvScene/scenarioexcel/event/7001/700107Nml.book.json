                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 43,
                    "strings": [
                        "",
                        "",
                        "主人公",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "結局は、それだけか……。"
