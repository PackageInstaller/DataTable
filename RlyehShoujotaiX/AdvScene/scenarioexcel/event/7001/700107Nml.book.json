                {
                    "rowIndex": 30,
                    "strings": [
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "そもそも、ここは地の底だ。\n隠れたところで生き埋めになってしまえば、元も子もない。"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 31,
                    "strings": [
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "だが、それ以上に――。"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 32,
                    "strings": [
                        "",
                        "FadeIn",
