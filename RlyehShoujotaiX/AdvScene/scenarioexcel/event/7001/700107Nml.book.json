                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 35,
                    "strings": [
                        "",
                        "",
                        "主人公",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "今だからこそだ！"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
