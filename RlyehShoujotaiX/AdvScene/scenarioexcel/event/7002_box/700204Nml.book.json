                        ""
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 20,
                    "strings": [
                        "",
                        "",
                        "主人公",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "メイ＝ユル！？"
                    ],
                    "isEmpty": 0,
