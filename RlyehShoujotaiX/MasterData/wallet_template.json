      "potion_eff_type": "",
      "potion_eff_val": 0,
      "text": "「軟体生物のぬいぐるみ」 ヴァイスにとって触手系の邪神＝あこがれ。幼年～成熟期、問わずウケがいい。\r\n上に乗った触手風マシュマロはプニプニ食感。４大勢力の邪神のモチーフが取り入られ、それぞれ彩られている。",
      "sort_priority": 0,
      "material_bag_time_hour": 0
    },
    {
      "id": 0,
      "category": "ugift",
      "name": "l_f2",
      "wallet_name": "深淵の香水",
      "rarity": 1397969457,
      "val_cap": 99999999,
      "exclude_from_item": 0,
      "expire_at": "9999/12/31 23:59:59",
      "revision": 1,
      "exp_point": 100,
