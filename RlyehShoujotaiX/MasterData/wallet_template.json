      "class_system_id": 0,
      "potion_type": "",
      "potion_eff_type": "",
      "potion_eff_val": 0,
      "text": "つけると甘くミステリアスな香りに包まれるが、たまに周囲の影が揺らめく。ヴァイスらの高級品。\r\n時折、影の中に\"何か\"の気配を感じるが、振り返ると何もいない。",
      "sort_priority": 0,
      "material_bag_time_hour": 0
    },
    {
      "id": 0,
      "category": "ugift",
      "name": "l_f3",
      "wallet_name": "古代の書物",
      "rarity": 1397969457,
      "val_cap": 99999999,
