        },
        {
            "Id": 15,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 17,
                    "Type": "対抗心",
                    "Text": "仕事上のライバル……になるかもしれない。\r\n相談事が減っちゃうのは嫌だから、\r\nルルイエには来ないでほしいかな。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 25,
                    "Type": "友達",
                    "Text": "真っ直ぐで可愛い。\r\n感情を素直にぶつけてくる子は好きだよ。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 33,
                    "Type": "興味",
                    "Text": "いつも街の片隅で踊っている。\r\n踊りでも心を動かすことが出来るんだね。"
                }
            ]
        },
        {
            "Id": 16,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 38,
                    "Type": "友達？",
                    "Text": "街の秩序を守ってる。\r\nもっといろいろ話してみたい。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 2,
                    "Type": "気になる",
                    "Text": "なぜか気になってしまう。\r\n近くにいると落ち着くような気がする。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 32,
                    "Type": "親近感",
                    "Text": "大切な相手に仕えてる。\r\nそれはすごく幸せなこと。"
                }
            ]
        },
        {
            "Id": 17,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 3,
                    "Type": "興味",
                    "Text": "眺めていて面白い存在。\r\nそのヒーロー活動に、\r\nやや顧客を取られている節はある。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 8,
                    "Type": "興味",
                    "Text": "交友関係が微笑ましい。\r\nずっと観ていても飽きない存在だ。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 18,
                    "Type": "協力",
                    "Text": "この間技術交換をした。\r\n引きこもり生活を続けるには、必要なこと。"
                }
            ]
        },
        {
            "Id": 18,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 39,
                    "Type": "恐怖",
                    "Text": "引きこもり生活の天敵。\r\n少女隊から足が遠のく原因のひとつ。本当に。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 26,
                    "Type": "羨望……？",
                    "Text": "ずっと眠ってられるお仕事って、正直、羨ましい。\r\n（こんなの誰にも言えないんだけども……）"
                },
                {
                    "TargetType": 1,
                    "TargetId": 36,
                    "Type": "仲間",
                    "Text": "布団派のメルファ、土派のディオネ。\r\n流派は違えどふたりはお昼寝仲間。"
                }
            ]
        },
        {
            "Id": 19,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 3,
                    "Type": "友達",
                    "Text": "いつでも元気な子。\r\n明るい声を聞くとなんだかほっとする。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 31,
                    "Type": "同胞",
                    "Text": "同胞ではあるが――ソリは少し合わない。\r\n自分勝手だし、戦うことしか頭にないし。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 33,
                    "Type": "尊敬",
                    "Text": "クトゥグア様の巫女。\r\n考えのすべてが分かるわけではないが、\r\n巫女とはそういうものなのだろう。"
                },
                {
                    "TargetType": 3,
                    "TargetId": 40003,
                    "Type": "崇拝",
                    "Text": "眩き恒星の神。\r\n圧倒的な存在の前には個の悩みなど些細なものだ。"
                }
            ]
        },
        {
            "Id": 20,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 23,
                    "Type": "尊敬",
                    "Text": "自分を重用してくれる。\r\nこの方がいなければ、今の自分はない。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 24,
                    "Type": "気まずい",
                    "Text": "目を合わしづらい。\r\n一度、うっかり刻んでしまったので……。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 29,
                    "Type": "仲間？",
                    "Text": "いつも徒歩で移動している。\r\n飛ぶのが苦手なのだとしたら親近感が湧く。"
                }
            ]
        },
        {
            "Id": 21,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 9,
                    "Type": "侮蔑",
                    "Text": "学びのないマヌケ。\r\n親しげに接してくるが相手をする気はない。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 11,
                    "Type": "厭気",
                    "Text": "なぜか幼子扱いされる。調子が狂う。"
                },
                {
                    "TargetType": 3,
                    "TargetId": 40002,
                    "Type": "興味",
                    "Text": "カルコサの大図書館に興味がある。\r\nどうにか閲覧する方法はないものか……。"
                }
            ]
        },
        {
            "Id": 22,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 11,
                    "Type": "お友達",
                    "Text": "編み物を通じて話すようになった。\r\n話も合う。人間さんの好きなところについてとか。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 34,
                    "Type": "気になる",
                    "Text": "生傷が絶えないようだ。\r\n怪我を治してあげたいのに、冷たくされてしまう。"
                }
            ]
        },
        {
            "Id": 23,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 10,
                    "Type": "お気に入り",
                    "Text": "従順で優秀、そして愛らしい魔術師。\r\nさながら蜘蛛の巣でもがく蝶々のようで。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 30,
                    "Type": "難儀な存在",
                    "Text": "正直、いちいち面倒くさい。\r\n傲慢な憐憫は統率を乱すだけなのだから。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 24,
                    "Type": "嫌悪",
                    "Text": "さかしらぶったタコ野郎。\r\n大人しく海底を這いずっていればいいのに。"
                },
                {
                    "TargetType": 3,
                    "TargetId": 40002,
                    "Type": "崇拝",
                    "Text": "カルコサの最高神。\r\nその御言葉、思し召しは絶対のもの。"
                }
            ]
        },
        {
            "Id": 24,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 12,
                    "Type": "腐れ縁",
                    "Text": "生まれた時から何かと競い合っている。\r\nなぜ彼女は認められ、自分は認められないのか。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 23,
                    "Type": "不審感",
                    "Text": "黄巾のやつらは信用に値しない。\r\nいつ、ルルイエに牙を剥くか分からない。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 34,
                    "Type": "不快",
                    "Text": "継承者にまとわりつくいけ好かないヤツ。\r\nガツンと言ってやりたいが、\r\n事を荒立てると面倒そうだ。"
                }
            ]
        },
        {
            "Id": 25,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 39,
                    "Type": "姉",
                    "Text": "これ以上強くならなくていいから、\r\nもうちょっと優しくなってほしい。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 40,
                    "Type": "妹",
                    "Text": "生きるのって楽しいのに、\r\n何をそんなに怖がっているんだろう？"
                },
                {
                    "TargetType": 1,
                    "TargetId": 12,
                    "Type": "仲間",
                    "Text": "ノーティア姉ほど口うるさくないし、\r\nたまにご飯も奢ってくれる！　好き！"
                },
                {
                    "TargetType": 3,
                    "TargetId": 40001,
                    "Type": "崇拝",
                    "Text": "一番すごい神様。少女隊の存在理由。\r\nそれ以上詳しいことは知らないけれど……。"
                }
            ]
        },
        {
            "Id": 26,
            "Datas": [
                {
                    "TargetType": 3,
                    "TargetId": 40001,
                    "Type": "奉仕",
                    "Text": "夢見の巫女として仕えるルルイエの主。\r\n邪神の言葉をみなに伝えるために生きている。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 37,
                    "Type": "弟子",
                    "Text": "夢見の館に仕える弟子兼使用人。\r\n巫女としての実力はまだまだだが、可愛い後輩。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 33,
                    "Type": "親近感",
                    "Text": "邪神クトゥグアの言葉を伝える巫女。\r\n同じ巫女として仲良くしたいと思っている。"
                }
            ]
        },
        {
            "Id": 27,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 38,
                    "Type": "苛立ち",
                    "Text": "自らのパトスを無視している姿はいただけない。\r\nせっかくナイスなプロポーションをしているのに。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 24,
                    "Type": "興味",
                    "Text": "顔立ちはグッド。ヴィヴィッドも似合いそう。\r\nモデルに興味があれば誘ってみたい。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 1,
                    "Type": "ファン",
                    "Text": "慕ってくれるのは嬉しいが、ハグはＮＧ。\r\nそんなにチープな女ではないのだから。"
                }
            ]
        },
        {
            "Id": 28,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 10,
                    "Type": "団員",
                    "Text": "魔術師団の補佐官。\r\nいつも忙しく働いているようだ。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 23,
                    "Type": "服従",
                    "Text": "黄衣の王を代行する偉大なヴァイス。\r\nなぜかよく苛立っているようだ。"
                },
                {
                    "TargetType": 3,
                    "TargetId": 40002,
                    "Type": "崇拝",
                    "Text": "カルコサの最高神。\r\nその御言葉、思し召しは絶対のもの。"
                }
            ]
        },
        {
            "Id": 29,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 23,
                    "Type": "忌避",
                    "Text": "怒らせると面倒な相手。\r\n自分に責があるということは分かっているが……。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 6,
                    "Type": "隔絶",
                    "Text": "少しだけ立場が近しいように思える。\r\n……が、越えがたい隔絶が互いの背にあるようだ。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 2,
                    "Type": "怒り",
                    "Text": "展示室を出禁にした。"
                }
            ]
        },
        {
            "Id": 30,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 23,
                    "Type": "反感",
                    "Text": "立場は理解しているが、\r\n在り様はとても相容れるものではない。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 20,
                    "Type": "憐憫",
                    "Text": "おお、なんと哀れな子。\r\n他の愛し子らも共に庇護してやりたい。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 28,
                    "Type": "憐憫",
                    "Text": "翼もなく、高く飛ぶ姿は痛ましい。\r\n神の眼差しに捉えられる前にどうか降りておいで。"
                }
            ]
        },
        {
            "Id": 31,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 19,
                    "Type": "同族",
                    "Text": "よく燃える炎を持つ。\r\nだが、ためらいのあるところが情けない。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 33,
                    "Type": "同族",
                    "Text": "巫女だというが、その立場はどうでもいい。\r\n火力を高めるのには有用な存在だ。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 28,
                    "Type": "興味",
                    "Text": "かなりの実力者らしい。\r\nその魔術を追い風とし、焼き尽くしてやりたい。"
                },
                {
                    "TargetType": 3,
                    "TargetId": 40003,
                    "Type": "憧憬",
                    "Text": "もっとも激しく燃える炎。\r\n生涯の目標。"
