        },
        {
            "Id": 14,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 4,
                    "Type": "相棒",
                    "Text": "頼もしい同胞。\r\nその力と自分の護りの前に敵はない。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 23,
                    "Type": "畏敬",
                    "Text": "威徳を感じさせる黄衣の代行者。\r\n……その微笑みには、少しだけ、背筋が冷える。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 29,
                    "Type": "不服",
                    "Text": "カルコサに属しながら与しない不敬者。\r\n厳しい処罰を与えるべきである。"
                },
                {
                    "TargetType": 3,
                    "TargetId": 40002,
                    "Type": "崇拝",
                    "Text": "カルコサの最高神。\r\nその御言葉、思し召しは絶対のもの。"
                }
