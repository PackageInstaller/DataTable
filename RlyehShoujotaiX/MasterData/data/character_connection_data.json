            ]
        },
        {
            "Id": 32,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 5,
                    "Type": "主従",
                    "Text": "仕えるべき主人。\r\n完璧な奉仕のためには、私情は捨てねばならない。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 22,
                    "Type": "対抗心",
                    "Text": "編み物仲間。\r\n早編み勝負で負けたため、リベンジを誓っている。"
