    "records": [
        {
            "Id": 1,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 7,
                    "Type": "好意",
                    "Text": "偶然見かけた”可愛い子”。\r\nもっとおしゃべりしたいな～と思っている。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 25,
                    "Type": "友達",
                    "Text": "社交的なふたり。\r\nハグ好き＆寒がりのＷＩＮ－ＷＩＮな関係。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 15,
                    "Type": "常連",
                    "Text": "「モネちのお部屋」ヘビーユーザー。\r\n推しへの課金は家賃まで。"
                }
            ]
        },
        {
            "Id": 2,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 16,
                    "Type": "ライバル？",
                    "Text": "見てるとメラメラする。\r\n本人にもその理由は分かっていない模様。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 34,
                    "Type": "フシギ",
                    "Text": "にゃー様に似てるけど似てない。\r\n遊んでやってもいいくらいには好き。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 29,
                    "Type": "トモダチ",
                    "Text": "お空を飛べない仲間。\r\nおこりんぼなのも広い心で許してやっている。"
                }
            ]
        },
        {
            "Id": 3,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 8,
                    "Type": "ライバル",
                    "Text": "意地悪なヤツ。\r\nいつか必ず改心させてやるつもり。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 19,
                    "Type": "友達",
                    "Text": "イイヤツ。\r\nいつも明るくて、人助けも手伝ってくれる。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 31,
                    "Type": "あこがれ",
                    "Text": "すごく強いヤツ。\r\nあんな風になれたら……と、ときどき考える。"
                }
            ]
        },
        {
            "Id": 4,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 14,
                    "Type": "相棒",
                    "Text": "初めて仲間と呼んでくれた子。\r\n小さいのに、その背中は勇気をくれる。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 23,
                    "Type": "畏敬",
                    "Text": "強くて綺麗。何より、いつも堂々としている。\r\n自分は本当に彼女と同種の存在なのだろうか？"
                },
                {
                    "TargetType": 3,
                    "TargetId": 40002,
                    "Type": "崇拝",
                    "Text": "カルコサの最高神。\r\nその御言葉、思し召しは絶対のもの。"
                }
            ]
        },
        {
            "Id": 5,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 32,
                    "Type": "主従",
                    "Text": "頼れるお付き。大好きなお友達。\r\nだけど……最近、口うるさくて、少し怖い。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 17,
                    "Type": "お友達",
                    "Text": "知らない場所の話をしてくれる。\r\nでも、たまに怖い話でおどかされるのは苦手。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 19,
                    "Type": "苦手",
                    "Text": "いつも強く当たられてしまう。\r\n嫌われるようなことをした覚えはないのに……。"
                }
            ]
        },
        {
            "Id": 6,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 24,
                    "Type": "嫉妬",
                    "Text": "大好きな人との距離が近い。\r\nもっと離れてほしい。馴れ馴れしくしないで。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 20,
                    "Type": "憐れみ",
                    "Text": "不憫で可愛そう。\r\n戦いに役立つ魔道具、いりませんか？"
                },
                {
                    "TargetType": 1,
                    "TargetId": 27,
                    "Type": "羨望",
                    "Text": "ルルイエで人気のファッションデザイナー。\r\n自分も服を変えたら、\r\nあの人にもっと興味を持ってもらえる？"
                }
            ]
        },
        {
            "Id": 7,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 1,
                    "Type": "通りすがり",
                    "Text": "一度話してから、妙に絡んでくる。\r\n別に嬉しいとか思ってないし。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 15,
                    "Type": "気になる",
                    "Text": "近ごろの人気者らしい。\r\n愛想よくするコツとか聞いてみたいけど、\r\nお店に行く勇気は出ない……。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 27,
                    "Type": "尊敬",
                    "Text": "言わずと知れたルルイエのカリスマ。\r\n変わってるけど、あの堂々とした態度はすごい。"
                }
            ]
        },
        {
            "Id": 8,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 3,
                    "Type": "ウザい",
                    "Text": "暑苦しいザコ。\r\nいちいち絡んでくるのがウザーい。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 31,
                    "Type": "ダサい",
                    "Text": "カワイソーなボッチ。\r\n気にしてないフリとかもっとダサーい。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 38,
                    "Type": "ニガテ",
                    "Text": "アーカムで”尊敬されてる”ヴァイスに似てる。\r\n怒るとコワそーだし関わりたくなーい……。"
                }
            ]
        },
        {
            "Id": 9,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 21,
                    "Type": "同胞",
                    "Text": "共に魔術の深淵を目指す同胞。\r\n多少の無礼な振る舞いには目を瞑りましょう。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 36,
                    "Type": "興味",
                    "Text": "信徒にふさわしいヴァイス。\r\nいつも暇そうだし、ああ見えて聡明だし。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 39,
                    "Type": "恐怖",
                    "Text": "容赦のない少女隊の中でも、特に苛烈。\r\n一流魔術師であっても死を覚悟することはある。"
                }
            ]
        },
        {
            "Id": 10,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 23,
                    "Type": "服従",
                    "Text": "黄衣の王の代行者。\r\nこの身は麗しき薫風の吹き示すままに。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 20,
                    "Type": "仲間",
                    "Text": "悪い子ではないのだけれど……。\r\nもう少し落ち着いてほしい。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 28,
                    "Type": "仲間？",
                    "Text": "何を考えているのか分からない。\r\n同じ団員のはずなのに、少し警戒してしまう。"
                },
                {
                    "TargetType": 3,
                    "TargetId": 40002,
                    "Type": "崇拝",
                    "Text": "カルコサの最高神。\r\nその御言葉、思し召しは絶対のもの。"
                }
            ]
        },
        {
            "Id": 11,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 10,
                    "Type": "庇護",
                    "Text": "可哀想な子。\r\nたくさん甘やかしたい。娘にしたい。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 21,
                    "Type": "気がかり",
                    "Text": "いつもひとりぼっちに見える。\r\n寂しがりやさんなようだから気がかりだ。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 22,
                    "Type": "お友達",
                    "Text": "たまに編み物を教わっている。\r\nいい子だけど、休憩を忘れがちなところが心配。"
                }
            ]
        },
        {
            "Id": 12,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 24,
                    "Type": "宿敵",
                    "Text": "にっくき任務泥棒。\r\nすまし顔のはみ出し者に負けるつもりはない。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 39,
                    "Type": "妹（？）",
                    "Text": "少女隊の仲間。素直じゃない妹（？）。\r\n自分は頼もしいのだから、もっと頼ってほしい。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 25,
                    "Type": "妹（？）",
                    "Text": "少女隊の仲間。素直な妹（？）。\r\nちょっとルーズだけど、それも愛嬌よね。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 40,
                    "Type": "妹（？）",
                    "Text": "少女隊の仲間。甘えんぼな妹（？）。\r\nとっても怖がりだから、守ってあげなきゃ。"
                }
            ]
        },
        {
            "Id": 13,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 38,
                    "Type": "好感",
                    "Text": "街の荒くれ者をまとめている。\r\n仲間思いないい奴だと思う。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 5,
                    "Type": "忠告",
                    "Text": "箱庭のお嬢様。\r\n自分を導いてくれる存在は大切にした方がいい。"
                },
                {
                    "TargetType": 1,
                    "TargetId": 31,
                    "Type": "興味",
                    "Text": "勝利を追求する強者。\r\nその強さの源流を知りたい。"
                }
