        },
        {
            "Id": 34,
            "Datas": [
                {
                    "TargetType": 1,
                    "TargetId": 24,
                    "Type": "対抗心",
                    "Text": "ビリッとくる継承者にまとわりつく小娘。\r\n気に喰わないがいつか奪えるしと楽観視している。"
