                    "shop_slot_min": 4,
                    "shop_slot_max": 6,
                    "shop_relic_table": 1000,
                    "shop_artifact_table": 2000,
                    "entrySkitId": 2
                },
                {
                    "stage_no": 3,
                    "name": "ステージ3/5",
                    "text": "＜眠りの大帝＞と呼ばれるカミの呪縛から解き放たれるため、継承者たちはミャウラが語るアーティファクトを探し始める。\r\nしかし、敵がそれを許すはずはなく、大帝の魔の手が継承者に迫る。",
                    "logo_image": "Theme_1/stage_logo_3",
                    "still_no": 10,
                    "event_table": 6,
                    "shop_chara_id": 1,
                    "shop_relic_min": 2,
