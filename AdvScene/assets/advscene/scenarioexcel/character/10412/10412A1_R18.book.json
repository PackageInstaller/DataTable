            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "そ、そんなぁ！？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 86,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
