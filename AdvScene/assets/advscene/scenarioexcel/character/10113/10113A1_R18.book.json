          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 89,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ううっ……こ、これ、んんっ！？　うぇぇ……！？"
