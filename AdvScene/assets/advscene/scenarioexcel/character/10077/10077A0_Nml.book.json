            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 109,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "ドスのきいた声が部屋に響き、室温がグッと下がった。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 110,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "いえ、ありがたく抱っこさせていただきます！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 111,
          "strings": [
            "",
            "",
            "ニホ",
            "Emt3_Gla",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "くるしゅうないですわ。",
            "",
            "ch_10077/R18/10077A0_10077_Nml/10077A0_10077_013",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 112,
          "strings": [
            "",
            "CharacterOff",
            "",
            "",
            "",
            "",
            "",
            "0.2",
            "",
            "",
            "",
            "",
            "",
