            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "んっ、うふふ……ふぁあっ、んっんっ、ふふ、どう？　ルカ。",
            "",
            "ch_10356/R18/10356B1_10356_R18/10356B0_10356_019"
