        {
          "rowIndex": 38,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "手がっ、いやらしい所たくさんっ、さわさわして……っ！\nぁぅ、ぁああ……っ。だめですぅ……っ！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 39,
          "strings": [
            "",
            "",
            "リコXmas",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
