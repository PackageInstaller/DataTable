          "rowIndex": 83,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ひぐっ、んああああああっ！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
