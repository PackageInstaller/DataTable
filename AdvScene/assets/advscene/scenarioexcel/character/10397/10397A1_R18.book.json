            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 96,
          "strings": [
            "",
            "",
            "リュオライ",
            "<Off>",
            "",
            "",
            "",
            "0.3",
            "",
            "ボクまで満たされちゃった気分……。\nどうするぅ……？　もう一回しよっかぁ？",
