            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ひっ……！？　そ、そんなぁ……！！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 79,
          "strings": [
