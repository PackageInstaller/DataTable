            "ch_10184/R18/10184A1_10184_R18/10184A0_10184_020"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 23,
          "strings": [
            "",
            "",
            "ユージェン",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
