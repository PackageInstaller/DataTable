          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 75,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "え……邪魔をしろってことですか？　良いんですか？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 76,
          "strings": [
