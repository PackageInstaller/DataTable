          "isCommentOut": 0
        },
        {
          "rowIndex": 13,
          "strings": [
            "",
            "",
            "シモアマヅ",
            "Emt1_Nor",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "おはよう、少年さん。\n今日はいいおねショタ日和ね。",
            "",
            "ch_10418/R18/10418B0_10418_Nml/10418B0_10418_002",
            "",
            ""
          ],
          "isEmpty": 0,
