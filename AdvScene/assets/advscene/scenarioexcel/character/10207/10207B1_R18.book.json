          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 11,
          "strings": [
            "",
            "",
            "シナツ",
            "Emt6_Sur",
            "layer_中",
            "",
            "",
            "0.3",
            "",
