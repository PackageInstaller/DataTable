            "ch_10288/R18/10288A1_10288_R18/10288A0_10288_030"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 49,
          "strings": [
            "",
            "",
            "ロトーナ水着",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "ちゅるちゅる、じゅっ！\nんほっ、ちんぽの味が広がってく……じゅるううっ！",
