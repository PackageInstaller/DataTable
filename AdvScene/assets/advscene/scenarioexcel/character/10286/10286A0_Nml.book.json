            "",
            "",
            "イェンファ",
            "Emt3_Gla",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "ちちっ！　本当に？　すごく嬉しいねっ！",
            "",
            "ch_10286/R18/10286A0_10286_Nml/10286A0_10286_010",
            "",
            ""
