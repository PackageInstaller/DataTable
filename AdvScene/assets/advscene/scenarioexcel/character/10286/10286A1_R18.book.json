            "",
            "イェンファ",
            "<Off>",
            "",
            "",
            "",
            "0.3",
            "",
            "ちちっ♪　ごしごし、ごしごし……。\n慌てずに、ゆっくり高めていくからね～。",
            "",
            "ch_10286/R18/10286A1_10286_R18/10286A0_10286_029",
            "",
            ""
          ],
          "isEmpty": 0,
