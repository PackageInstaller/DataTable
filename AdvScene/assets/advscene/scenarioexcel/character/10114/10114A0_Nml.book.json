        {
          "rowIndex": 33,
          "strings": [
            "",
            "",
            "主人公",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "ぷっ、ぷはっ！　ちょ、いきなりなんですか！？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 34,
          "strings": [
            "",
            "",
            "プテリア",
            "Emt3_Gla",
            "layer_BU中",
            "",
            "",
            "0.3",
            "",
            "ごめんなーご主人、追われてたんだよー！\n頼む！　ちょっとだけ、私と一緒に居てくれっ！",
            "",
            "ch_10114/R18/10114A0_10114_Nml/10114A0_10114_002",
            "",
            ""
          ],
          "isEmpty": 0,
