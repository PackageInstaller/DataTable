            "",
            "ch_10259/R18/10259B1_10259_R18/10259B0_10259_030"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 51,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "はぁ、はぁっ……セレンさんっ……！　セレンさんっ……！\n大好きですっ……セレンさんっ……！"
