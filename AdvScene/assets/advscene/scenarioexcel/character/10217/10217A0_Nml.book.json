            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 90,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "特別なクラッカー？\n聞いたことないですけど……。\nいったいどういう代物なんですか？"
