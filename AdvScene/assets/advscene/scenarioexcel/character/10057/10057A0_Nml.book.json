          "rowIndex": 109,
          "strings": [
            "",
            "",
            "サウラ",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "むにゃむにゃ……。\nご主人くん、大好きぃ……。",
            "",
            "ch_10057/R18/10057A0_10057_Nml/10057A0_10057_013"
          ],
          "isEmpty": 0,
