          "strings": [
            "",
            "",
            "タンタルアイドル",
            "Emt7_Ama",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "突然だけどさ。",
            "",
            "ch_10248/R18/10248A1_10248_R18/10248A0_10248_023",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 9,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "と、突然タンタルさんがミーティング中に言った。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 10,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "え……なんですかタンタルさん。\nあの……顔が真面目すぎて逆に怖いんですけど。"
