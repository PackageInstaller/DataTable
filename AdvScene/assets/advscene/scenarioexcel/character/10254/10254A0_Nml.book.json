            "",
            "",
            "シィール",
            "Emt3_Gla",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "ご主人さま～♪\nどんなモンスターが出てきても私が守るから、安心してね～♪",
            "",
            "ch_10254/R18/10254A0_10254_Nml/10254A0_10254_001",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
