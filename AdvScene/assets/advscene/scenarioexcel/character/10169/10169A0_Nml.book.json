          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 81,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "いえ……し、しかしですね……。"
