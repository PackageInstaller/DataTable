          "isCommentOut": 0
        },
        {
          "rowIndex": 78,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ぐっ、あっ、だ、ダルシーさんっ……！\nもう、もう、僕、限界が、そろそろっ……！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
