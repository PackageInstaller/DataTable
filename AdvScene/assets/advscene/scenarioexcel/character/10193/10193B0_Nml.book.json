            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ぐっ具体的にって……ちょっ！　グイグイこないでください！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 75,
          "strings": [
