            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 9,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "重々しい足音とともに玉座へ腰を下ろすと、\nゆ",
            "Next"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
