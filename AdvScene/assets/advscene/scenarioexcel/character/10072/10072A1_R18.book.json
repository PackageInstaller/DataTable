          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 38,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "くっ……くぅっ……。"
