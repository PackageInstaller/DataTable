        {
          "rowIndex": 8,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "……んんう？\nまさか、イオさん……？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 9,
          "strings": [
