            "ch_10090/R18/10090A1_10090_R18/10090A0_10090_021"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 45,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "やぁ……っ！　いじわる、言わないでくだひゃい……っ！"
