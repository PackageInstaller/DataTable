          "isCommentOut": 0
        },
        {
          "rowIndex": 12,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "わぁっ、ミィマさん！？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 13,
          "strings": [
