            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ひいいいっ……わ、分かりましたっ……。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 98,
          "strings": [
