            "ch_10216/R18/10216A1_10216_R18/10216A0_10216_027"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 48,
          "strings": [
            "",
            "",
            "リグラーナ",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "舌にオタマジャクシ、\nいっぱいこぼしちゃってるよぉ～。",
