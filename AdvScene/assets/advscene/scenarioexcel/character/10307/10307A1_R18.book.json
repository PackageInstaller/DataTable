        {
          "rowIndex": 11,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "ルイシャさんが申し訳なさそうな顔で脚をさすってくれた。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 12,
          "strings": [
            "",
