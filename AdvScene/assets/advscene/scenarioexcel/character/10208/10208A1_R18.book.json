            "",
            "",
            "チザネ",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "さあ、ご主人さんっ！\nれっつとれーにんぐ！",
            "",
            "ch_10208/R18/10208A1_10208_R18/10208A0_10208_020"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 30,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ちっ、チザネさんっ！　はっ、はひゃっ！\nあっあしっ！　足をどかしてくださいっ！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 31,
