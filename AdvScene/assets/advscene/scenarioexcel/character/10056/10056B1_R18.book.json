            "CharacterOff"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 37,
          "strings": [
            "",
            "",
            "ロトーナR18_2",
            "Normal",
            "layer_R18"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 38,
          "strings": [
            "",
            "FadeIn",
            "#ffffff",
