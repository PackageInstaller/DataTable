            "ch_10173/R18/10173B1_10173_R18/10173B0_10173_024"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 40,
          "strings": [
            "",
            "",
            "主人公",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "グウウウ……！\nムラムラ、スル……！　ハァ、ハァ……！"
