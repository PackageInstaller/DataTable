        },
        {
          "rowIndex": 59,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "うんっ！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 60,
          "strings": [
            "",
            "",
            "ミテラスXcos_R18",
