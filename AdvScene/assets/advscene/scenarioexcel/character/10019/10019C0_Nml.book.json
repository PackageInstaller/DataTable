          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 54,
          "strings": [
            "",
            "",
            "女魔法剣士",
            "Emt1_Nor",
            "layer_右中前",
            "",
            "",
            "0.3",
