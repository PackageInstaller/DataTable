        {
          "rowIndex": 70,
          "strings": [
            "",
            "Se",
            "SE動作_倒れる_人"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 71,
          "strings": [
            "",
            "Tween",
            "BG",
