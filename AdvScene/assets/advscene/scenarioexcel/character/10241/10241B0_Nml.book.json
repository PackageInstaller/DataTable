          "rowIndex": 64,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "そ、そうですか……。\nそれを聞いて安心しました……。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
