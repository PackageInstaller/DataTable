            "ch_10270/R18/10270A1_10270_R18/10270A0_10270_029"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 34,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
