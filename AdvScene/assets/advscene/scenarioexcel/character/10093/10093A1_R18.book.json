            "layer_R18"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 39,
          "strings": [
            "",
            "",
            "アテエル",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "んっ……んっ……あっ……ふふっ……どうですか……んっ……。\nご主人様……少しは……んっ、落ち着けそうです……？",
            "",
            "ch_10093/R18/10093A1_10093_R18/10093A0_10093_024"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 40,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "うっ……ああっ……！　こ、こんなの逆に……ううっ……！"
