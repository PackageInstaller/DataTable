        {
          "rowIndex": 13,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "テンミィさん……。\nまた深夜徘徊してたんですか。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 14,
          "strings": [
            "",
            "Tween",
