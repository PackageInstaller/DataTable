        },
        {
          "rowIndex": 18,
          "strings": [
            "",
            "Se",
            "SE動作_足音_ダッシュ",
            "",
            "0.5"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 19,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "これは……一体何でこんなことが……。\n誰か！　怪我した人はいませんか！？\nみなさん！　大丈夫ですか！？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 20,
          "strings": [
            "",
            "Tween",
            "全画面マスク",
