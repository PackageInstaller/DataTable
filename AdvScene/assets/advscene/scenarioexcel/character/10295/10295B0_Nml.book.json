          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 41,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "そう言ってダムストーさんは、\n高級そうな箱に入ったクッキーを丸ごと差し出してきた。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
