            "",
            "巫女Ａ",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "あぁぁぁ～っ♪　あんっ！　あんっ！\nいいっ！　すごいですぅっ！　モンスターのっ、こうびっ！",
            "",
            "en_49030/R18/10032C1_49030_R18/10032C0_49030_036"
