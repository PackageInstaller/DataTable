          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 8,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ぷ、プラチナさんっ！　もういいでしょう！\n早く服を返してください！！"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 9,
          "strings": [
            "",
            "",
