            "ch_10246/R18/10246A1_10246_R18/10246A0_10246_020"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 41,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "いやいや、あれは違うっていったじゃないですか！"
