            "StopSound",
            "Se",
            "",
            "",
            "",
            "",
            "2"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 64,
          "strings": [
            "",
            "",
            "ヴァニラもんくえR18_1",
            "Fast",
            "layer_R18"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 65,
          "strings": [
