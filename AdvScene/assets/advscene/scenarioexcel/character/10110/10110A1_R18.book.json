        },
        {
          "rowIndex": 82,
          "strings": [
            "",
            "",
            "ウシオ",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "うむっ♪　ほれほれほれ……んっ、れろぉっ！\nんっんっんっ！　ほれっ、いいぞぉっ！",
            "",
            "ch_10110/R18/10110A1_10110_R18/10110A0_10110_046"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
