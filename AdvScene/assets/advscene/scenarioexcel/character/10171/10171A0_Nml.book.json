        },
        {
          "rowIndex": 69,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "ココノハさんが手を「パン」と叩くと、大きな穴が出現した。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 70,
          "strings": [
