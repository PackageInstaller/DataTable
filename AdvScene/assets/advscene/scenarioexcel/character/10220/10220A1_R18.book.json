          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 8,
          "strings": [
            "",
            "",
            "エルタ",
            "Emt3_Gla",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "あ、ご主人さま、やっと気が付いたんですね！",
            "",
            "ch_10220/R18/10220A1_10220_R18/10220A0_10220_017",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
