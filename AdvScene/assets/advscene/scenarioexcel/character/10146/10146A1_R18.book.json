            "",
            "",
            "主人公",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "そ、そんなぁ……。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 32,
