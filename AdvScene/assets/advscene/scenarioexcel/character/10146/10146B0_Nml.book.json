            "ch_10146/R18/10146B0_10146_Nml/10146B0_10146_013",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 80,
          "strings": [
            "",
            "",
            "主人公",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "し、知らなくていいですし……ちょ、あの！\nそんなに、む、胸を押し付けてこないでください！"
