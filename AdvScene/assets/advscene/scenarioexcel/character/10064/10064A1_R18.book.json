            "ch_10064/R18/10064A1_10064_R18/10064A0_10064_022"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 54,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "きもち、よく……なんてぇ……っ！\nんあっ！　ない……ですぅっ！"
