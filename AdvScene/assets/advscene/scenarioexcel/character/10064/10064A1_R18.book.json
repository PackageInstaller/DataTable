          "isCommentOut": 0
        },
        {
          "rowIndex": 45,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "んっ、く……！\nちょっと、ラキオンさん……っ！\nだめ……ですってぇ……っ！"
