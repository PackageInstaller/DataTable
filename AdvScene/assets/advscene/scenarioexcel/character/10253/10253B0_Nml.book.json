          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 13,
          "strings": [
            "",
            "Wait",
            "",
            "",
            "",
            "",
            "",
            "0.2",
            "",
            "",
            "",
            "",
            "",
            ""
