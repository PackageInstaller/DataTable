            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "…………え？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 90,
          "strings": [
            "",
            "",
            "ブンコ学園",
            "Emt1_Nor",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "ん？　何、どうかした？",
            "",
            "ch_10264/R18/10264B0_10264_Nml/10264B0_10264_010",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 91,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "あの、聞き間違いかもしれないんですけど……\nギターを叩きつけるって聞こえたんですが……。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 92,
          "strings": [
