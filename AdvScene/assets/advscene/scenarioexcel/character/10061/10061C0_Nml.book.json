            "",
            "エリュート",
            "Emt1_Nor",
            "layer_中段_中",
            "",
            "",
            "0.3",
            "",
            "答えよ。",
            "",
            "ch_10061/R18/10061C0_10061_Nml/10061C0_10061_015",
