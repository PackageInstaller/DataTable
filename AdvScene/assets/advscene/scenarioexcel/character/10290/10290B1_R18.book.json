        {
          "rowIndex": 31,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "つっ、つめたいっ！　やっぱり普通の井戸じゃないですかぁ！"
          ],
          "isEmpty": 0,
