        {
          "rowIndex": 24,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ぴぃぃぃぃぃぃっっ！？！？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 25,
          "strings": [
            "",
            "Bgm",
