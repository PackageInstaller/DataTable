            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "やあ、ああっ、んぅ、く、ううううう！\nんっ、あっ、ああああああああああ！",
            "",
            "ch_10108/R18/10108B1_10108_R18/10108B0_10108_042"
          ],
