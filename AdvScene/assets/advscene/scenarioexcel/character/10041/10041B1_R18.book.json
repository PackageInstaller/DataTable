            "ch_10041/R18/10041B1_10041_R18/10041B0_10041_020"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 47,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "ぅあっ！？　ん……うぅっ！"
