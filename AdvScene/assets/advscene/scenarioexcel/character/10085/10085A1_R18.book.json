            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 11,
          "strings": [
            "",
            "",
            "マウロ",
            "Emt7_Ama",
            "layer_中",
            "",
            "",
            "0.3",
            "",
