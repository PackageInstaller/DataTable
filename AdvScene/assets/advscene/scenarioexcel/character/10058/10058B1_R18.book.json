            "",
            "ケィナ",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "もういくっ、いくですっ、わたひ、いっちゃうですっ！\nんぁぁっ……っく、いくっ、んくぅぅぅっ！",
            "",
            "ch_10058/R18/10058B1_10058_R18/10058B0_10058_028"
          ],
