        {
          "rowIndex": 16,
          "strings": [
            "19",
            "",
            "ラビィ",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "えへへ～、ご開帳～。",
            "",
            "ch_10379/R18/10379A1_10379_R18/10379A0_10379_019"
          ],
          "isEmpty": 0,
