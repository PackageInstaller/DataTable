            "",
            "リン(分裂体)",
            "Emt4_Enj",
            "layer_右中",
            "",
            "",
            "0.3",
            "",
            "ご主人くんが選んでくれるまで、ずーっと離さないからね♪",
            "",
            "ch_10006/R18/10006B0_10006_Nml/10006B0_10006_017",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
