            "",
            "カミラ",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "んぐっ、んぐーーっ、ぷはぁあっ！",
            "",
            "en_40114/R18/10006C1_40114_R18/10006C0_40114_013"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 10,
          "strings": [
