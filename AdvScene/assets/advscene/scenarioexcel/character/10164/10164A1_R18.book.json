          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 8,
          "strings": [
            "",
            "",
            "ローレン学園",
            "Emt1_Nor",
            "layer_中"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 9,
          "strings": [
            "",
            "Wait",
            "",
            "",
