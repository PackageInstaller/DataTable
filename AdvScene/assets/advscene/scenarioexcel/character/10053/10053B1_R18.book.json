            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "ありがとう、おにいたん。\nこれで、きせーじじつもかんぺきだね♪",
            "",
            "ch_10053/R18/10053B1_10053_R18/10053B0_10053_028"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
