            "",
            "チファ",
            "Emt1_Nor",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "フン！　ふんふんふん！　困っちゃうかしら！\n理屈っぽい子どもは嫌われるのよ！\nオトナはグダグダ言わないかしら！",
            "",
            "ch_10131/R18/10131A0_10131_Nml/10131A0_10131_008",
            ""
