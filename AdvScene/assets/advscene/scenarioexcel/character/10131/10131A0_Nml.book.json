            "Emt6_Sur",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "あいたっ！？　",
            "Br",
            "ch_10131/R18/10131A0_10131_Nml/10131A0_10131_003",
            ""
          ],
          "isEmpty": 0,
