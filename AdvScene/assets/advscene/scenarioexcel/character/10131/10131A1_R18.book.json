            "ch_10131/R18/10131A1_10131_R18/10131A0_10131_038"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 65,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
            "あっ、ああぁっ！？　だめっ、あぁっ！？　もう出ちゃいますっ！"
