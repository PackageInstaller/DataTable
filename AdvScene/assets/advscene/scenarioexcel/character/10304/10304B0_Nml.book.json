            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "ディフォーラさんが部屋にいきなり飛び込んで来た。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 13,
          "strings": [
            "",
            "",
            "主人公",
            "",
            "",
            "",
            "",
            "",
            "",
