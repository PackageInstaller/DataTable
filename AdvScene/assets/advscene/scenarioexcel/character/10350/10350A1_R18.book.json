            "0.8"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 69,
          "strings": [
            "",
            "",
            "リデル水着R18_1",
            "Fast",
            "layer_R18",
            "",
            "",
