          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 88,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "こんなことで褒められたのは初めてだった。"
