        },
        {
          "rowIndex": 13,
          "strings": [
            "",
            "Wait",
            "",
            "",
            "",
            "",
            "　",
            "0.3"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 14,
          "strings": [
            "",
            "",
            "ホヅキ",
            "Emt3_Gla",
            "layer_左中前",
            "",
            "",
            "0.3",
