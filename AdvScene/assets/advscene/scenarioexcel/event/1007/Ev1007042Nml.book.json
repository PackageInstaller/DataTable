        {
          "rowIndex": 100,
          "strings": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "主人公たちと別れ、ひとり、\n住み処へ戻ったルキュレにある魔の手が迫っていた。"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 101,
          "strings": [
            "",
            "CharacterOff",
            "",
            "",
            "",
            "",
            "",
            "0.2",
            "",
            "",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 102,
          "strings": [
            "",
            "Wait",
            "",
