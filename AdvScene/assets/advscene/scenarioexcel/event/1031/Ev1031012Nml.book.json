            "",
            "ビビ神",
            "Emt1_Nor",
            "layer_ビビ神a_中",
            "",
            "",
            "0.3",
            "",
            "まあ、それはひとまず置いておきましょう。",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
