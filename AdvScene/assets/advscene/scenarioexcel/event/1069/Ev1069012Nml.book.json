            "CharacterOff",
            "",
            "",
            "",
            "",
            "",
            "0.2",
            "",
            "",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 65,
          "strings": [
            "",
            "Wait",
            "",
            "",
            "",
            "",
            "",
            "0.3",
            "",
            "",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 66,
          "strings": [
            "",
            "",
            "ランカ",
            "Emt1_Nor",
            "layer_中",
            "",
            "",
            "0.3",
            "",
            "それは……。",
            "",
            "",
            "",
            ""
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 67,
          "strings": [
            "",
            "CharacterOff",
