        {
          "rowIndex": 11,
          "strings": [
            "",
            "",
            "主人公",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "あ、おかえりなさい。どうでしたか、現状は？"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 12,
