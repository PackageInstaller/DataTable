        {
          "rowIndex": 105,
          "strings": [
            "",
            "",
            "セレン",
            "<Off>",
            "",
            "",
            "",
            "",
            "",
            "な、ななっ、なんだあれ！？",
            "",
            "ch_10023/Main/1108/1108_10023_421"
          ],
          "isEmpty": 0,
          "isCommentOut": 0
        },
        {
          "rowIndex": 106,
          "strings": [
