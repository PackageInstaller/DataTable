                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 14,
                    "strings": [
                        "",
                        "",
                        "エルディ",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "みな……渋々と従っていただけ……？",
                        "",
                        "Character/ch_10064/Event/vo_event_10064_032"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 15,
