                },
                {
                    "rowIndex": 16,
                    "strings": [
                        "",
                        "",
                        "主人公",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "（なるほど、そういうことか）"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 17,
                    "strings": [
                        "",
                        "Tween",
