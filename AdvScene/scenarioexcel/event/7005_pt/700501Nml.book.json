                    "strings": [
                        "",
                        "",
                        "主人公",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "ここがアーカム……なのか？"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
