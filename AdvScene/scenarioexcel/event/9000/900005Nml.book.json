                },
                {
                    "rowIndex": 17,
                    "strings": [
                        "",
                        "",
                        "江戸城",
                        "Emt7_Sad",
                        "layer_中",
                        "",
                        "",
                        "0.3",
                        "",
                        "徳川家康の名を冠した巨大兜……！？\n殿たちが討ち果たしたはずのあなたが、なぜここに！？",
                        ""
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 18,
                    "strings": [
                        "",
                        "",
                        "江戸城",
                        "Emt2_Ang",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "いえ……私が感じた気配の正体こそ、あなただったのですね！"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 19,
                    "strings": [
                        "",
                        "",
                        "主人公",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "",
                        "徳川家康だって！？\nあの巨大な兜が、幕府を開いた……あの！？"
                    ],
                    "isEmpty": 0,
                    "isCommentOut": 0
                },
                {
                    "rowIndex": 20,
                    "strings": [
                        "",
                        "",
                        "江戸城",
