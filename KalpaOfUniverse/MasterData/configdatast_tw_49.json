  {
    "ID": 77742,
    "Value": "尉遲良所持。圖譜中記載了『玄機尺』的鍛造之法。玄機非人可之，賦之於尺度鬼神事。"
  },
  {
    "ID": 77743,
    "Value": "尉遲良所持。圖譜中記載了『量天尺』的鍛造之法。求一真趣，九九為規。定身田精變，上下推移。"
  },
  {
    "ID": 77744,
    "Value": "尉遲良所持。圖譜中記載了『造化尺』的鍛造之法。此是天機真造化，一比尋常假造成。"
  },
  {
    "ID": 77745,
    "Value": "虞兮所持。圖譜中記載了『星月環』的鍛造之法。白日急兮西頹，星月隨兮天回。"
  },
  {
    "ID": 77746,
    "Value": "虞兮所持。圖譜中記載了『時幻環』的鍛造之法。時幻之幻，顛來倒去不老，以解日月歲蕭疏。"
  },
  {
    "ID": 77747,
    "Value": "虞兮所持。圖譜中記載了『時輪靈環』的鍛造之法。命與此環相符契，古轍正合今時輪。"
  },
  {
    "ID": 77748,
    "Value": "鹿昭依所持。圖譜中記載了『荒古之息』的鍛造之法。太極生天地，三元更廢興，為荒古記。"
  },
  {
    "ID": 77749,
    "Value": "鹿昭依所持。圖譜中記載了『萬鈞無敵』的鍛造之法。九萬鵬程當不二，八千椿壽看逾一。"
  },
  {
    "ID": 77750,
    "Value": "？*？"
  },
  {
    "ID": 77751,
    "Value": "殷劍平所持。圖譜中記載了『飛虹劍』的鍛造之法。勢如走電，驚濤觸石。"
  },
  {
    "ID": 77752,
    "Value": "殷劍平所持。圖譜中記載了『兩儀劍』的鍛造之法。陰陽和，得兩儀。"
  },
  {
    "ID": 77753,
    "Value": "殷劍平所持。圖譜中記載了『七嶽神劍』的鍛造之法。山嶽匯元氣，玉劍臥霜鬥。"
  },
  {
    "ID": 77754,
    "Value": "上官遠所持。圖譜中記載了『鐵騎槍』的鍛造之法。千千鐵騎擁塵紅，去去平吞萬里空。"
  },
  {
    "ID": 77755,
    "Value": "上官遠所持。圖譜中記載了『虎咆槍』的鍛造之法。虎咆山月白，雲閣千萬重。"
  },
  {
    "ID": 77756,
    "Value": "上官遠所持。圖譜中記載了『碧吻蛇矛』的鍛造之法。可聞鬼聲啾啾，有攝魂喪魄之能。"
  },
  {
    "ID": 77757,
    "Value": "夏侯儀所持。圖譜中記載了『朱綸祭劍』的鍛造之法。赤玉靈文下，朱陵真氣來。"
  },
  {
    "ID": 77758,
    "Value": "夏侯儀所持。圖譜中記載了『紫金短劍』的鍛造之法。其鋒不藏，得之者或遭劫，需化之。"
  },
  {
    "ID": 77759,
    "Value": "夏侯儀所持。圖譜中記載了『陰陽幻刃』的鍛造之法。陰陽冰火，以幻通神，奧妙定中。"
  },
  {
    "ID": 77760,
    "Value": "冰璃所持。圖譜中記載了『冰刃幻劍』的鍛造之法。唯心力強盛者，方可持之。"
  },
  {
    "ID": 77761,
    "Value": "冰璃所持。圖譜中記載了『冰魄雲渺』的鍛造之法。疑將冰月為精爽，端藉瓊瑤琢劍身。"
  },
  {
    "ID": 77762,
    "Value": "冰璃所持。圖譜中記載了『冰魄幻劍』的鍛造之法。深藏冰魄，為無上力之一種。"
  },
  {
    "ID": 77763,
    "Value": "慕容璇璣所持。圖譜中記載了『冰霧寒玉』的鍛造之法。歎寒冰豔了無塵，一庭疏影聞冷香。"
  },
  {
    "ID": 77764,
    "Value": "慕容璇璣所持。圖譜中記載了『封雷淨玉』的鍛造之法。現團團金光，一舞神鬼哭。"
  },
  {
    "ID": 77765,
    "Value": "慕容璇璣所持。圖譜中記載了『鈞天瓏玉』的鍛造之法。瑤光，其溯源也。"
  },
  {
    "ID": 77766,
    "Value": "封鈴笙所持。圖譜中記載了『凝玉紗索』的鍛造之法。乃結天地合，才得凝玉色。"
  },
  {
    "ID": 77767,
    "Value": "封鈴笙所持。圖譜中記載了『銀華月緞』的鍛造之法。最愛銀華絕纖汙，手把月緞映輕素。"
  },
  {
    "ID": 77768,
    "Value": "封玲笙所持。圖譜中記載了『瓏華千紗』的鍛造之法。仙女遺紗索，化作天邊雲。"
  },
  {
    "ID": 77769,
    "Value": "阿爾泰巴所持。圖譜中記載了『烏金雙斧』的鍛造之法。雙龍蛇蟠戲缺月，吳軍破甲水光犀。"
  },
  {
    "ID": 77770,
    "Value": "阿爾泰巴所持。圖譜中記載了『蝕日巨斧』的鍛造之法。攜成霹靂勢，其威無窮盡。"
  },
  {
    "ID": 77771,
    "Value": "阿爾泰巴所持。圖譜中記載了『冥火戰斧』的鍛造之法。可震懾人心，號令蒼生。"
  },
  {
    "ID": 77772,
    "Value": "赫蘭鐵罕所持。圖譜中記載了『朱纓槍』的鍛造之法。君家赤驃畫不得，一團旋風桃花色。"
  },
  {
    "ID": 77773,
    "Value": "赫蘭鐵罕所持。圖譜中記載了『鋼戰戟』的鍛造之法。有橫掃六合，殺千軍之勢。"
  },
  {
    "ID": 77774,
    "Value": "赫蘭鐵罕所持。圖譜中記載了『毒龍戟』的鍛造之法。毒龍銜日天地昏，蕩搖五嶽崩山根。"
  },
  {
    "ID": 77775,
    "Value": "慕容箏所持。圖譜中記載了『青鋼劍』的鍛造之法。其外泛綠光，可蘊靈力。"
  },
  {
    "ID": 77776,
    "Value": "慕容箏所持。圖譜中記載了『赤霞劍』的鍛造之法。廣現森羅，遍吐霞光。"
  },
  {
    "ID": 77777,
    "Value": "慕容箏所持。圖譜中記載了『神武劍』的鍛造之法。鴻洞有真人，神武御四方。"
  },
  {
    "ID": 77778,
    "Value": "白菀所持。圖譜中記載了『琉璃長笛』的鍛造之法。霞杯傳縹葉，羽管吹琉璃。"
  },
  {
    "ID": 77779,
    "Value": "白菀所持。圖譜中記載了『神鳥鳴樂』的鍛造之法。神鳥鳴樂，無相之音，清神凝氣。"
  },
  {
    "ID": 77780,
    "Value": "白菀所持。圖譜中記載了『流光靡音』的鍛造之法。縹緲疑仙樂，嬋娟勝畫圖。"
  },
